---
// Header checklist of the job types TSS crews handle: icon tiles whose check marks draw in one by one.
const I = {
  cone: '<path d="M9.5 4h5l3.6 14H5.9z"/><path d="M8.4 9.5h7.2M7.2 14h9.6"/><path d="M3.5 20.5h17"/>',
  flag: '<path d="M8.5 3.5h7l5 5v7l-5 5h-7l-5-5v-7z"/><path d="M8 12h8"/>',
  truck: '<path d="M2.5 6.5h11v10h-11z"/><path d="M13.5 9.5h4l3.5 3.5v3.5h-7.5"/><circle cx="6.5" cy="17.5" r="2"/><circle cx="17" cy="17.5" r="2"/>',
  moon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/><path d="M16.5 3.5v3M15 5h3"/>',
  event: '<path d="M5 21V4"/><path d="M5 4h12l-2.5 4L17 12H5"/>',
  siren: '<path d="M6 18v-5a6 6 0 0 1 12 0v5"/><path d="M4 21h16M4 18h16"/><path d="M12 2.5v2M4.2 6.2l1.4 1.4M19.8 6.2l-1.4 1.4"/>'
};
const jobs = [
  ['cone', 'Lane and road closures', 'Single lanes to full detours', '/tools/lane-closure-plan?work=right'],
  ['flag', 'Flagging operations', 'ATSSA-certified flaggers', '/tools/lane-closure-plan?work=flagging'],
  ['truck', 'TMA crash truck protection', 'Certified TMA operators', '/pages/request-a-quote?type=lane-closure'],
  ['moon', 'Night and weekend work', 'Off-peak windows, fully lit', '/tools/lane-closure-plan?work=right'],
  ['event', 'Special events', 'Parades, races, game days', '/pages/request-a-quote?type=lane-closure'],
  ['siren', 'Emergency response', 'For account customers', '/pages/create-c-m-account']
];
---
<div class="jb" data-jb>
  <div class="jb__head">
    <p class="jb__title">What our crews handle</p>
    <p class="jb__tally" aria-hidden="true"><span data-tally>0</span>/{jobs.length} <em>in-house</em></p>
  </div>
  <ul class="jb__grid">
    {jobs.map(([ic, t, d, href], i) => (
      <li style={`--i:${i}`}>
        <a href={href} class="jb__tile" data-tile>
          <span class="jb__ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={I[ic as keyof typeof I]} /></span>
          <span class="jb__t"><b>{t}</b><small>{d}</small></span>
          <span class="jb__chk" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M7 12.4l3.2 3.2L17 8.8" /></svg></span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .jb { position: relative; overflow: hidden; background: #fff; color: var(--ink); border-radius: 22px; padding: 20px; box-shadow: 0 40px 70px -40px rgba(0,0,0,.65); text-align: left; }
  .jb__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .jb__title { margin: 0; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; font-variation-settings: 'wght' 760; color: var(--red); }
  .jb__tally { margin: 0; display: inline-flex; align-items: baseline; gap: 2px; padding: 5px 12px 4px; border-radius: 999px; background: var(--ink); color: #fff; font-size: .9rem; font-variation-settings: 'wght' 760; font-variant-numeric: tabular-nums; }
  .jb__tally span { color: var(--gold); }
  .jb__tally em { margin-left: 6px; font-style: normal; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; opacity: .7; }

  .jb__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .jb__tile { position: relative; overflow: hidden; display: grid; grid-template-columns: 44px 1fr 28px; align-items: center; gap: 12px; padding: 14px 14px 14px 12px; border-radius: 16px; border: 1.5px solid var(--line); background: #fff; color: inherit; text-decoration: none; transition: border-color .35s, box-shadow .35s, transform .25s, background .35s; }
  .jb__tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,.75) 50%, transparent 65%); transform: translateX(-120%); pointer-events: none; }
  .jb__tile:hover { transform: translateY(-2px); border-color: var(--line-dark); box-shadow: 0 14px 28px -18px rgba(20,23,26,.45); }
  .jb__tile:focus-visible { outline: 3px solid rgba(182,6,6,.35); outline-offset: 2px; }

  .jb__ic { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--haze); color: var(--steel); transition: background .4s, color .4s, transform .4s cubic-bezier(.2,.8,.2,1.5); }
  .jb__ic svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .jb__t { min-width: 0; }
  .jb__t b { display: block; font-size: 1rem; line-height: 1.22; letter-spacing: -.005em; font-variation-settings: 'wght' 720; }
  .jb__t small { display: block; margin-top: 3px; font-size: .82rem; line-height: 1.3; color: var(--steel); }

  .jb__chk svg { display: block; width: 28px; height: 28px; overflow: visible; }
  .jb__chk circle { fill: none; stroke: var(--line-dark); stroke-width: 2; transition: fill .3s .25s, stroke .3s; }
  .jb__chk path { fill: none; stroke: #fff; stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 16; stroke-dashoffset: 16; transition: stroke-dashoffset .35s .35s ease; }

  /* checked state */
  .jb__tile.is-ok { border-color: #cfe9d8; background: linear-gradient(180deg, #fff, #f6fbf8); }
  .jb__tile.is-ok .jb__ic { background: var(--red); color: #fff; transform: rotate(-6deg) scale(1.04); }
  .jb__tile.is-ok .jb__chk circle { fill: #1d9e4b; stroke: #1d9e4b; }
  .jb__tile.is-ok .jb__chk path { stroke-dashoffset: 0; }
  .jb__tile.is-ok .jb__chk svg { animation: jbStamp .5s .25s cubic-bezier(.2,.8,.2,1.6) both; }
  @keyframes jbStamp { 0% { transform: scale(.6); } 100% { transform: none; } }
  .jb__tile.is-ok .jb__ic { transition-delay: .1s; }
  /* spotlight that keeps moving after everything is checked */
  .jb__tile.is-spot { border-color: var(--red); box-shadow: 0 0 0 3px rgba(182,6,6,.12), 0 16px 30px -18px rgba(182,6,6,.55); }
  .jb__tile.is-spot::after { animation: jbSheen .9s ease; }
  @keyframes jbSheen { to { transform: translateX(120%); } }

  @media (max-width: 1100px) { .jb { max-width: 720px; width: 100%; justify-self: center; box-sizing: border-box; } }
  @media (max-width: 640px) {
    .jb { border-radius: 18px; padding: 16px 12px 12px; }
    .jb__head { margin: 0 4px 12px; }
    .jb__grid { grid-template-columns: 1fr; gap: 8px; }
    .jb__tile { grid-template-columns: 38px 1fr 26px; gap: 10px; padding: 11px 12px 11px 10px; border-radius: 14px; }
    .jb__ic { width: 38px; height: 38px; border-radius: 10px; }
    .jb__ic svg { width: 21px; height: 21px; }
    .jb__chk svg { width: 26px; height: 26px; }
  }
  @media (prefers-reduced-motion: reduce) { .jb__tile, .jb__ic, .jb__chk circle, .jb__chk path, .jb__chk svg { transition: none !important; animation: none !important; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-jb]').forEach((root) => {
    const tiles = [...root.querySelectorAll<HTMLElement>('[data-tile]')];
    const tally = root.querySelector<HTMLElement>('[data-tally]')!;
    const timers: number[] = [];
    let spot = 0, spotTimer = 0, started = false;
    const checkAll = () => { tiles.forEach((t) => t.classList.add('is-ok')); tally.textContent = String(tiles.length); };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { checkAll(); return; }
    const run = () => {
      tiles.forEach((t, i) => timers.push(window.setTimeout(() => { t.classList.add('is-ok'); tally.textContent = String(i + 1); }, 350 + i * 380)));
      timers.push(window.setTimeout(() => {
        spotTimer = window.setInterval(() => {
          tiles.forEach((t) => t.classList.remove('is-spot'));
          tiles[spot].classList.add('is-spot');
          spot = (spot + 1) % tiles.length;
        }, 2000);
      }, 350 + tiles.length * 380 + 600));
    };
    new IntersectionObserver(([en]) => {
      if (en.isIntersecting && !started) { started = true; run(); }
      else if (!en.isIntersecting && started) { timers.forEach(clearTimeout); clearInterval(spotTimer); tiles.forEach((t) => t.classList.remove('is-spot')); checkAll(); started = false; }
    }, { threshold: 0.3 }).observe(root);
  });
</script>
