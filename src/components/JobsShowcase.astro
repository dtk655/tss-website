---
// Header showcase: cycles through the job types TSS crews handle, each with a small animated scene.
import { scenes, W, H } from '../data/jobScenes';
---
<div class="jb" data-js>
  <div class="jb__stage">
    <svg class="jb__defs" width="0" height="0" aria-hidden="true"><defs><linearGradient id="jbBeam" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff6c9" stop-opacity=".55" /><stop offset="1" stop-color="#fff6c9" stop-opacity="0" /></linearGradient></defs></svg>
    {scenes.map((s, i) => (
      <figure class:list={['jb__scene', i === 0 && 'is-on', s.dark && 'is-dark']} data-scene={i}>
        <svg viewBox={`0 34 ${W} ${H - 34}`} aria-hidden="true" set:html={s.svg} />
        <figcaption>
          <b>{s.t}</b>
          <span>{s.d}</span>
          <a href={s.cta[1]}>{s.cta[0]}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="jb__tabs" role="tablist" aria-label="Jobs our crews handle">
    {scenes.map((s, i) => (
      <button type="button" role="tab" class="jb__tab" data-tab={i} aria-selected={i === 0 ? 'true' : 'false'}><span>{s.t}</span><i aria-hidden="true"></i></button>
    ))}
  </div>
</div>

<style>
  .jb { background: #fff; color: var(--ink); border-radius: 22px; overflow: hidden; box-shadow: 0 40px 70px -40px rgba(0,0,0,.65); text-align: left; }
  .jb__defs { position: absolute; }
  .jb__stage { position: relative; display: grid; background: linear-gradient(180deg, #e9eef2, #f6f8f9 50%); }
  .jb__scene { grid-area: 1 / 1; margin: 0; display: grid; grid-template-rows: auto 1fr; opacity: 0; visibility: hidden; transition: opacity .45s ease, visibility 0s .45s; }
  .jb__scene.is-on { opacity: 1; visibility: visible; transition: opacity .45s ease; }
  .jb__scene > svg { display: block; width: 100%; height: auto; }
  .jb__scene figcaption { position: relative; z-index: 1; display: grid; align-content: start; gap: 4px; padding: 14px 20px 16px; background: #fff; border-top: 1px solid var(--line); }
  .jb__scene figcaption b { font-size: 1.22rem; letter-spacing: -.01em; font-variation-settings: 'wght' 780; }
  .jb__scene figcaption span { font-size: .93rem; line-height: 1.45; color: var(--steel); }
  .jb__scene figcaption a { display: inline-flex; align-items: center; gap: 6px; margin-top: 6px; color: var(--red); font-size: .92rem; font-variation-settings: 'wght' 720; text-decoration: none; width: fit-content; }
  .jb__scene figcaption a svg { width: 16px; height: 16px; transition: transform .2s; }
  .jb__scene figcaption a:hover svg { transform: translateX(3px); }

  .jb__tabs { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); background: var(--haze); }
  .jb__tab { all: unset; position: relative; cursor: pointer; padding: 11px 12px 12px; font-size: .82rem; line-height: 1.25; font-variation-settings: 'wght' 660; color: var(--steel); text-align: center; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: color .2s, background .2s; }
  .jb__tab:nth-child(3n) { border-right: 0; }
  .jb__tab:nth-last-child(-n+3) { border-bottom: 0; }
  .jb__tab:hover { color: var(--ink); }
  .jb__tab:focus-visible { outline: 3px solid rgba(182,6,6,.35); outline-offset: -3px; }
  .jb__tab[aria-selected="true"] { color: var(--red); background: #fff; }
  .jb__tab i { position: absolute; left: 0; bottom: 0; height: 3px; width: 0; background: var(--red); }
  .jb__tab[aria-selected="true"] i { animation: jsBar var(--jb-t, 4200ms) linear forwards; }
  .jb.is-paused .jb__tab i { animation: none; width: 100%; }
  @keyframes jsBar { to { width: 100%; } }

  /* scene animations (only while the scene is on) */
  .jb__scene :global(.jb__pop) { opacity: 0; transform: translateY(-10px) scale(.4); transform-box: fill-box; transform-origin: center bottom; }
  .jb__scene.is-on :global(.jb__pop) { animation: jsPop .4s cubic-bezier(.2,.8,.2,1.5) both; animation-delay: calc(.2s + var(--c) * 90ms); }
  @keyframes jsPop { to { opacity: 1; transform: none; } }
  .jb__scene :global(.jb__fade) { opacity: 0; }
  .jb__scene.is-on :global(.jb__fade) { animation: jsFade .5s 1s ease both; }
  @keyframes jsFade { to { opacity: 1; } }
  .jb__scene.is-on :global(.jb__drive) { animation: jsDrive 3.6s linear infinite; }
  .jb__scene.is-on :global(.jb__drive--2) { animation-duration: 4.4s; animation-delay: -1.5s; }
  @keyframes jsDrive { from { transform: translateX(-80px); } to { transform: translateX(460px); } }
  .jb__scene.is-on :global(.jb__approach) { animation: jsApproach 3s cubic-bezier(.3,.7,.3,1) infinite; }
  @keyframes jsApproach { 0% { transform: translateX(0); } 60%, 100% { transform: translateX(200px); } }
  :global(.jb__seq) { opacity: .15; }
  .jb__scene.is-on :global(.jb__seq) { animation: jsSeq 1.2s steps(1, end) infinite; animation-delay: calc(var(--n) * .2s); }
  @keyframes jsSeq { 0%, 60% { opacity: 1; } 61%, 100% { opacity: .15; } }
  .jb__scene.is-on :global(.jb__stop) { animation: jsStop 2.4s steps(1, end) infinite; }
  .jb__scene.is-on :global(.jb__slow) { animation: jsSlow 2.4s steps(1, end) infinite; }
  :global(.jb__slow) { opacity: 0; }
  @keyframes jsStop { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes jsSlow { 0%, 49% { opacity: 0; } 50%, 100% { opacity: 1; } }
  .jb__scene.is-on :global(.jb__beam) { animation: jsBeam 2.6s ease-in-out infinite; }
  @keyframes jsBeam { 50% { opacity: .65; } }
  .jb__scene.is-on :global(.jb__star) { animation: jsTw 2s ease-in-out infinite; animation-delay: calc(var(--c) * .3s); }
  @keyframes jsTw { 50% { opacity: .2; } }
  .jb__scene.is-on :global(.jb__crowd) { animation: jsBob 1s ease-in-out infinite; animation-delay: calc(var(--c) * 70ms); }
  @keyframes jsBob { 50% { transform: translateY(-3px); } }
  .jb__scene.is-on :global(.jb__flag) { animation: jsWave 1.4s ease-in-out infinite; transform-box: fill-box; transform-origin: left center; }
  @keyframes jsWave { 50% { transform: skewY(4deg); } }
  .jb__scene.is-on :global(.jb__beacon) { animation: jsBeacon .7s steps(1, end) infinite; }
  @keyframes jsBeacon { 50% { opacity: .2; } }
  .jb__scene.is-on :global(.jb__water) { animation: jsWater 1.8s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes jsWater { 50% { transform: scale(1.12); } }

  @media (max-width: 1100px) { .jb { max-width: 720px; width: 100%; justify-self: center; box-sizing: border-box; } }
  @media (max-width: 640px) {
    .jb { border-radius: 18px; }
    .jb__scene figcaption { padding: 12px 16px 14px; }
    .jb__scene figcaption b { font-size: 1.08rem; }
    .jb__scene figcaption span { font-size: .86rem; }
    .jb__tab { font-size: .74rem; padding: 10px 6px 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .jb__scene :global(*) { animation: none !important; }
    .jb__scene :global(.jb__pop), .jb__scene :global(.jb__fade) { opacity: 1; transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-js]').forEach((root) => {
    const scenes = [...root.querySelectorAll<HTMLElement>('[data-scene]')];
    const tabs = [...root.querySelectorAll<HTMLElement>('[data-tab]')];
    const T = 4200;
    root.style.setProperty('--jb-t', T + 'ms');
    let i = 0, timer = 0, paused = false, resume = 0;
    const show = (n: number) => {
      i = n;
      scenes.forEach((s, k) => s.classList.toggle('is-on', k === n));
      tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === n)));
    };
    const start = () => { if (!timer && !paused) timer = window.setInterval(() => show((i + 1) % scenes.length), T); };
    const stop = () => { clearInterval(timer); timer = 0; };
    root.addEventListener('click', (e) => {
      const t = (e.target as Element).closest<HTMLElement>('[data-tab]');
      if (!t) return;
      paused = true; root.classList.add('is-paused'); stop(); show(Number(t.dataset.tab));
      clearTimeout(resume);
      resume = window.setTimeout(() => { paused = false; root.classList.remove('is-paused'); show(i); start(); }, 12000);
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    new IntersectionObserver(([en]) => { en.isIntersecting ? start() : stop(); }, { threshold: 0.3 }).observe(root);
  });
</script>
