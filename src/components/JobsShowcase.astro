---
// Header list of the job types TSS crews handle. A highlight sweeps through the rows.
const jobs = [
  ['Lane and road closures', 'Single lanes to full closures with detours', '/tools/lane-closure-plan?work=right'],
  ['Flagging operations', 'ATSSA-certified flaggers, one-lane two-way', '/tools/lane-closure-plan?work=flagging'],
  ['TMA crash truck protection', 'Crash trucks with certified operators', '/pages/request-a-quote?type=lane-closure'],
  ['Night and weekend work', 'Off-peak closure windows, fully lit', '/tools/lane-closure-plan?work=right'],
  ['Special events', 'Parades, races, concerts and game days', '/pages/request-a-quote?type=lane-closure'],
  ['Emergency response', 'Water main breaks, downed lines, incidents', '/pages/create-c-m-account', 'Account customers']
];
---
<div class="jb" data-jb>
  <p class="jb__head">What our crews handle</p>
  <ol class="jb__list">
    {jobs.map(([t, d, href, tag], i) => (
      <li style={`--i:${i}`}>
        <a href={href} class:list={['jb__row', i === 0 && 'is-on']} data-row>
          <span class="jb__n">{String(i + 1).padStart(2, '0')}</span>
          <span class="jb__t"><b>{t}{tag && <em>{tag}</em>}</b><small>{d}</small></span>
          <svg class="jb__go" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </li>
    ))}
  </ol>
</div>

<style>
  .jb { background: #fff; color: var(--ink); border-radius: 22px; padding: 22px 10px 10px; box-shadow: 0 40px 70px -40px rgba(0,0,0,.65); text-align: left; }
  .jb__head { margin: 0 14px 10px; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; font-variation-settings: 'wght' 760; color: var(--red); }
  .jb__list { list-style: none; margin: 0; padding: 0; }
  .jb__list li { opacity: 0; transform: translateY(8px); animation: jbIn .5s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(.15s + var(--i) * 80ms); }
  .jb__list li + li { box-shadow: 0 -1px 0 var(--line); }
  @keyframes jbIn { to { opacity: 1; transform: none; } }
  .jb__row { position: relative; display: grid; grid-template-columns: 34px 1fr 20px; align-items: center; gap: 12px; padding: 13px 14px; border-radius: 14px; color: inherit; text-decoration: none; transition: background .3s; }
  .jb__row::before { content: ''; position: absolute; left: 0; top: 12px; bottom: 12px; width: 3px; border-radius: 3px; background: var(--red); transform: scaleY(0); transition: transform .35s cubic-bezier(.2,.8,.2,1); }
  .jb__row.is-on, .jb__row:hover { background: var(--red-tint); border-color: transparent; }
  .jb__row.is-on::before, .jb__row:hover::before { transform: scaleY(1); }
  .jb__n { font-size: .82rem; font-variation-settings: 'wght' 760; color: #aab2ba; font-variant-numeric: tabular-nums; transition: color .3s; }
  .jb__row.is-on .jb__n, .jb__row:hover .jb__n { color: var(--red); }
  .jb__t { min-width: 0; }
  .jb__t b { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 10px; font-size: 1.08rem; line-height: 1.25; letter-spacing: -.005em; font-variation-settings: 'wght' 720; }
  .jb__t em { font-style: normal; font-size: .7rem; letter-spacing: .04em; text-transform: uppercase; padding: 3px 8px 2px; border-radius: 999px; background: var(--haze-2); color: var(--steel); font-variation-settings: 'wght' 720; }
  .jb__t small { display: block; margin-top: 2px; font-size: .86rem; color: var(--steel); }
  .jb__go { width: 18px; height: 18px; color: var(--red); opacity: 0; transform: translateX(-6px); transition: opacity .3s, transform .3s; }
  .jb__row.is-on .jb__go, .jb__row:hover .jb__go { opacity: 1; transform: none; }
  .jb__row:focus-visible { outline: 3px solid rgba(182,6,6,.35); outline-offset: -3px; }

  @media (max-width: 1100px) { .jb { max-width: 720px; width: 100%; justify-self: center; box-sizing: border-box; } }
  @media (max-width: 640px) {
    .jb { border-radius: 18px; padding: 16px 6px 6px; }
    .jb__head { margin: 0 12px 6px; }
    .jb__row { grid-template-columns: 26px 1fr 16px; gap: 10px; padding: 11px 12px; }
    .jb__t b { font-size: 1rem; }
    .jb__t small { font-size: .8rem; }
  }
  @media (prefers-reduced-motion: reduce) { .jb__list li { animation: none; opacity: 1; transform: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-jb]').forEach((root) => {
    const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];
    let i = 0, timer = 0, hover = false;
    const show = (n: number) => { i = n; rows.forEach((r, k) => r.classList.toggle('is-on', k === n)); };
    root.addEventListener('mouseenter', () => { hover = true; rows.forEach((r) => r.classList.remove('is-on')); });
    root.addEventListener('mouseleave', () => { hover = false; show(i); });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    new IntersectionObserver(([en]) => {
      if (en.isIntersecting && !timer) timer = window.setInterval(() => { if (!hover) show((i + 1) % rows.length); }, 2200);
      else if (!en.isIntersecting && timer) { clearInterval(timer); timer = 0; }
    }, { threshold: 0.3 }).observe(root);
  });
</script>
