---
// Custom builder: signs, stenciled cones and drums, A-frame rails. Used on the Custom Shop page (all kinds, with a picker)
// and on product pages (one kind, locked).
import { PHONE, EMAIL, FORM_WEBHOOK } from '../lib/config.js';
interface Props { kind?: 'sign' | 'cone' | 'drum' | 'aframe'; lock?: boolean; coneSize?: string; id?: string; kicker?: string; title?: string; lede?: string }
const { kind = 'sign', lock = false, coneSize = '28"', id = 'builder', kicker = 'Custom builder', title = 'Design your equipment. <em>See it live.</em>', lede = 'Pick what you want to customize, build it, and our team will price it. We confirm every detail before anything is made.' } = Astro.props;
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const COLORS = [
  ['White', '#ffffff'], ['Yellow', '#ffcd00'], ['Fluorescent Orange', '#ff6a13'], ['Red', '#c8102e'], ['Green', '#006747'],
  ['Blue', '#0047bb'], ['Brown', '#6b4226'], ['Black', '#141414'], ['Fluorescent Yellow-Green', '#c4d600']
];
const SIZES = [[12, 18], [18, 24], [24, 24], [24, 30], [30, 30], [36, 36], [48, 48], [48, 24]];
const SHAPES = [
  ['rect', 'Rectangle', '<rect x="3" y="5" width="18" height="14" rx="2"/>'],
  ['diamond', 'Diamond', '<path d="M12 2.5 21.5 12 12 21.5 2.5 12z"/>'],
  ['octagon', 'Octagon', '<path d="M8.3 3h7.4L21 8.3v7.4L15.7 21H8.3L3 15.7V8.3z"/>'],
  ['circle', 'Circle', '<circle cx="12" cy="12" r="9"/>']
];
const ARROWS = [['none', 'None'], ['left', '←'], ['up-left', '↖'], ['up', '↑'], ['up-right', '↗'], ['right', '→']];
---
  <section class={`sb${lock ? ' sb--lock' : ''}`} id={id} data-kind-init={kind} data-cone-size={coneSize}>
    <div class="wrap">
      <div class="sbh">
        <div>
          <p class="sbh__k"><span></span>{kicker}</p>
          <h2 class="sbh__h" set:html={title} />
        </div>
        <p class="sb__note">{lede}</p>
      </div>

      {!lock && (
      <div class="sbp" role="tablist" aria-label="What do you want to customize?">
        <p class="sbp__q">Which product do you want to customize?</p>
        <div class="sbp__row">
          <button type="button" role="tab" class="sbp__opt is-on" aria-selected="true" data-kind-pick="sign"><span class="sbp__img"><img src="/custom/tpl/sign-diamond-orange.webp" alt="" loading="lazy" /></span><span class="sbp__t"><b>Signs</b><small>Any size, color, legend</small></span></button>
          <button type="button" role="tab" class="sbp__opt" aria-selected="false" data-kind-pick="cone"><span class="sbp__img"><img src="/custom/tpl/cone-reflective.webp" alt="" loading="lazy" /></span><span class="sbp__t"><b>Cones</b><small>Stenciled name or logo</small></span></button>
          <button type="button" role="tab" class="sbp__opt" aria-selected="false" data-kind-pick="drum"><span class="sbp__img"><img src="/cats/alt-traffic-drums.png" alt="" loading="lazy" /></span><span class="sbp__t"><b>Drums</b><small>Stenciled name or logo</small></span></button>
          <button type="button" role="tab" class="sbp__opt" aria-selected="false" data-kind-pick="aframe"><span class="sbp__img"><img src="/custom/police-rail.webp" alt="" loading="lazy" class="is-photo" /></span><span class="sbp__t"><b>A-Frame Rails</b><small>Printed rails and striping</small></span></button>
          <a class="sbp__opt sbp__opt--link" href="/watercade/#customize"><span class="sbp__img"><img src="/custom/tpl/watercade-3.webp" alt="" loading="lazy" /></span><span class="sbp__t"><b>WATERCADE</b><small>Opens the 3D builder</small></span><svg class="sbp__ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
      )}

      <div class="sb__grid" data-sb data-webhook={FORM_WEBHOOK} data-email={EMAIL} data-phone={PHONE}>
        <!-- preview -->
        <div class="sb__stage">
          <div class="sb__canvas">
            <svg class="sb__svg" data-svg viewBox="0 0 400 300" role="img" aria-label="Live preview of your design"></svg>
          </div>
          <div class="sb__meta">
            <span class="sb__dims" data-dims>48" × 48"</span>
            <span class="sb__spec" data-spec>Diamond · Fluorescent Orange / Black · Diamond grade</span>
          </div>
          <button type="button" class="sb__dl" data-download>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Download preview
          </button>
        </div>

        <!-- controls -->
        <form class="sb__panel" data-form novalidate>
          <div data-kind="sign" hidden={kind !== 'sign'}>
          <fieldset class="sb__grp">
            <legend><span>1</span>Shape and size</legend>
            <div class="sb__shapes">
              {SHAPES.map(([v, l, ic], i) => (
                <label class="sb__shape"><input type="radio" name="shape" value={v} checked={v === 'diamond'} /><span><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic} />{l}</span></label>
              ))}
            </div>
            <div class="sb__sizes" data-sizes>
              {SIZES.map(([w, h]) => <button type="button" class="sb__chip" data-size={`${w}x${h}`}>{w}" × {h}"</button>)}
            </div>
            <div class="sb__wh">
              <label><span>Width (in.)</span><input class="sb__in" type="number" name="w" min="6" max="144" value="48" inputmode="numeric" /></label>
              <span class="sb__x" aria-hidden="true">×</span>
              <label><span>Height (in.)</span><input class="sb__in" type="number" name="h" min="6" max="144" value="48" inputmode="numeric" /></label>
            </div>
          </fieldset>

          <fieldset class="sb__grp">
            <legend><span>2</span>Colors</legend>
            <p class="sb__lab">Background <b data-bgname>Fluorescent Orange</b></p>
            <div class="sb__sw" data-sw="bg">
              {COLORS.map(([n, c]) => <button type="button" class="sb__dot" style={`--c:${c}`} data-c={c} data-n={n} aria-label={n} title={n}></button>)}
              <label class="sb__pick" title="Custom color"><input type="color" value="#ff6a13" data-custom="bg" aria-label="Custom background color" /><span>Custom</span></label>
            </div>
            <p class="sb__lab">Legend and border <b data-fgname>Black</b></p>
            <div class="sb__sw" data-sw="fg">
              {COLORS.map(([n, c]) => <button type="button" class="sb__dot" style={`--c:${c}`} data-c={c} data-n={n} aria-label={n} title={n}></button>)}
              <label class="sb__pick" title="Custom color"><input type="color" value="#141414" data-custom="fg" aria-label="Custom legend color" /><span>Custom</span></label>
            </div>
            <label class="sb__tog"><input type="checkbox" name="border" checked /><span></span>Border</label>
          </fieldset>

          <fieldset class="sb__grp">
            <legend><span>3</span>Legend</legend>
            <label class="sb__f"><span>Text <em>One line per row, up to 5 rows</em></span><textarea class="sb__in" name="legend" rows="3" maxlength="140">ROAD
WORK
500 FT</textarea></label>
            <p class="sb__lab">Arrow</p>
            <div class="sb__arrows">
              {ARROWS.map(([v, l], i) => <label class="sb__chip sb__chip--r"><input type="radio" name="arrow" value={v} checked={v === 'none'} /><span>{l}</span></label>)}
            </div>
            <label class="sb__tog"><input type="checkbox" name="artwork" /><span></span>I have a logo or artwork to add</label>
          </fieldset>

          <fieldset class="sb__grp">
            <legend><span>4</span>Material and quantity</legend>
            <div class="sb__row2">
              <label class="sb__f"><span>Sheeting</span>
                <select class="sb__in" name="sheeting">
                  <option>Engineer grade</option><option>High intensity prismatic</option><option selected>Diamond grade</option><option>Not sure, recommend one</option>
                </select>
              </label>
              <label class="sb__f"><span>Material</span>
                <select class="sb__in" name="substrate">
                  <option selected>Aluminum</option><option>Corrugated plastic</option><option>Roll-up / flexible</option><option>Not sure, recommend one</option>
                </select>
              </label>
            </div>
            <div class="sb__qty">
              <span>Quantity</span>
              <div class="sb__step"><button type="button" data-q="-1" aria-label="Fewer">−</button><input class="sb__in" type="number" name="qty" min="1" value="1" inputmode="numeric" aria-label="Quantity" /><button type="button" data-q="1" aria-label="More">+</button></div>
            </div>
          </fieldset>

          </div>

          <div data-kind="cone" hidden={kind !== 'cone'}>
            <fieldset class="sb__grp">
              <legend><span>1</span>Cone</legend>
              <p class="sb__lab">Size</p>
              <div class="sb__arrows">
                {['18"', '28"', '36"'].map((v) => <label class="sb__chip sb__chip--r sb__chip--txt"><input type="radio" name="c_size" value={v} checked={v === coneSize} /><span>{v}</span></label>)}
              </div>
              <p class="sb__lab">Style</p>
              <div class="sb__arrows">
                <label class="sb__chip sb__chip--r sb__chip--txt"><input type="radio" name="c_style" value="Reflective" checked /><span>Reflective collars</span></label>
                <label class="sb__chip sb__chip--r sb__chip--txt"><input type="radio" name="c_style" value="Plain" /><span>Plain</span></label>
              </div>
            </fieldset>
            <fieldset class="sb__grp">
              <legend><span>2</span>Stencil</legend>
              <label class="sb__f"><span>Stencil text <em>Line 1</em></span><input class="sb__in sb__in--sten" name="c_t1" maxlength="14" value="YOUR CO." autocomplete="off" /></label>
            <label class="sb__f"><span>Second line <em>Optional</em></span><input class="sb__in sb__in--sten" name="c_t2" maxlength="14" autocomplete="off" /></label>
            <p class="sb__lab">Stencil color</p>
            <div class="sb__arrows">
              <label class="sb__chip sb__chip--r sb__chip--txt"><input type="radio" name="c_color" value="Black" checked /><span><i style="--c:#141414"></i>Black</span></label>
              <label class="sb__chip sb__chip--r sb__chip--txt"><input type="radio" name="c_color" value="White" /><span><i style="--c:#ffffff"></i>White</span></label>
            </div>
            <label class="sb__tog"><input type="checkbox" name="c_logo" /><span></span>I want my logo stenciled too</label>
            </fieldset>
            <fieldset class="sb__grp">
              <legend><span>3</span>Quantity</legend>
              <div class="sb__qty"><span>Quantity</span><div class="sb__step"><button type="button" data-q="-1" aria-label="Fewer">−</button><input class="sb__in" type="number" name="c_qty" min="1" value="1" inputmode="numeric" aria-label="Quantity" /><button type="button" data-q="1" aria-label="More">+</button></div></div>
            </fieldset>
          </div>

          <div data-kind="drum" hidden={kind !== 'drum'}>
            <fieldset class="sb__grp">
              <legend><span>1</span>Stencil</legend>
              <label class="sb__f"><span>Stencil text <em>Line 1</em></span><input class="sb__in sb__in--sten" name="d_t1" maxlength="14" value="YOUR CO." autocomplete="off" /></label>
            <label class="sb__f"><span>Second line <em>Optional</em></span><input class="sb__in sb__in--sten" name="d_t2" maxlength="14" autocomplete="off" /></label>
            <p class="sb__lab">Stencil color</p>
            <div class="sb__arrows">
              <label class="sb__chip sb__chip--r sb__chip--txt"><input type="radio" name="d_color" value="Black" checked /><span><i style="--c:#141414"></i>Black</span></label>
              <label class="sb__chip sb__chip--r sb__chip--txt"><input type="radio" name="d_color" value="White" /><span><i style="--c:#ffffff"></i>White</span></label>
            </div>
            <label class="sb__tog"><input type="checkbox" name="d_logo" /><span></span>I want my logo stenciled too</label>
            </fieldset>
            <fieldset class="sb__grp">
              <legend><span>2</span>Quantity</legend>
              <div class="sb__qty"><span>Quantity</span><div class="sb__step"><button type="button" data-q="-1" aria-label="Fewer">−</button><input class="sb__in" type="number" name="d_qty" min="1" value="1" inputmode="numeric" aria-label="Quantity" /><button type="button" data-q="1" aria-label="More">+</button></div></div>
            </fieldset>
          </div>

          <div data-kind="aframe" hidden={kind !== 'aframe'}>
            <fieldset class="sb__grp">
              <legend><span>1</span>Rail colors</legend>
              <div class="sb__sw" data-rail>
                {[['Blue', '#1f45c8'], ['Orange', '#ff6a13'], ['Red', '#c8102e'], ['Black', '#141414'], ['Green', '#006747']].map(([n, c], i) => <button type="button" class:list={['sb__dot', i === 0 && 'is-on']} style={`--c:${c}`} data-c={c} data-n={n} aria-label={n} title={n}></button>)}
              </div>
              <label class="sb__tog"><input type="checkbox" name="a_stripes" checked /><span></span>Diagonal striping on the ends</label>
            </fieldset>
            <fieldset class="sb__grp">
              <legend><span>2</span>Rail text</legend>
              <label class="sb__f"><span>Top rail</span><input class="sb__in sb__in--sten" name="a_t1" maxlength="26" value="YOUR NAME HERE" autocomplete="off" /></label>
              <label class="sb__f"><span>Bottom rail <em>Optional</em></span><input class="sb__in sb__in--sten" name="a_t2" maxlength="26" value="DO NOT CROSS" autocomplete="off" /></label>
              <label class="sb__tog"><input type="checkbox" name="a_logo" /><span></span>I have a logo to add</label>
            </fieldset>
            <fieldset class="sb__grp">
              <legend><span>3</span>Quantity</legend>
              <div class="sb__qty"><span>Quantity</span><div class="sb__step"><button type="button" data-q="-1" aria-label="Fewer">−</button><input class="sb__in" type="number" name="a_qty" min="1" value="1" inputmode="numeric" aria-label="Quantity" /><button type="button" data-q="1" aria-label="More">+</button></div></div>
            </fieldset>
          </div>

          <fieldset class="sb__grp">
            <legend><span data-contact-n>{({ sign: 5, cone: 4, drum: 3, aframe: 4 })[kind]}</span>Where should we send the quote?</legend>
            <div class="sb__row2">
              <label class="sb__f"><span>Your name</span><input class="sb__in" name="name" required autocomplete="name" /></label>
              <label class="sb__f"><span>Company <em>Optional</em></span><input class="sb__in" name="company" autocomplete="organization" /></label>
            </div>
            <div class="sb__row2">
              <label class="sb__f"><span>Email</span><input class="sb__in" name="email" type="email" required autocomplete="email" /></label>
              <label class="sb__f"><span>Phone <em>Optional</em></span><input class="sb__in" name="phone" type="tel" autocomplete="tel" /></label>
            </div>
            <label class="sb__f"><span>Notes <em>Optional</em></span><textarea class="sb__in" name="notes" rows="2" placeholder="Deadline, mounting, reflective needs, anything else"></textarea></label>
          </fieldset>

          <button type="submit" class="sb__send" data-submit><span data-send-label>{({ sign: 'Get a quote for this sign', cone: 'Get a quote for these cones', drum: 'Get a quote for these drums', aframe: 'Get a quote for these rails' })[kind]}</span><Fragment set:html={ARROW} /></button>
          <p class="sb__msg sb__msg--ok" data-ok hidden>Got it. Our team will reply with pricing within 1 business day. If you have a logo or artwork, email it to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
          <p class="sb__msg sb__msg--err" data-err hidden>That didn’t go through. Your email app should have opened with the details instead, or call us at {PHONE}.</p>
        </form>
      </div>
    </div>
  </section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-sb]');
    if (!root) return;
    const form = root.querySelector('[data-form]');
    const svg = root.querySelector('[data-svg]');
    const NS = 'http://www.w3.org/2000/svg';
    const SHAPE_NAMES = { rect: 'Rectangle', diamond: 'Diamond', octagon: 'Octagon', circle: 'Circle' };
    const SQUARE = new Set(['diamond', 'octagon', 'circle']);
    const st = { bg: '#ff6a13', bgName: 'Fluorescent Orange', fg: '#141414', fgName: 'Black', rail: '#1f45c8', railName: 'Blue' };
    let kind = 'sign';
    const KIND = {
      sign: { n: 5, label: 'Get a quote for this sign', name: 'Custom sign' },
      cone: { n: 4, label: 'Get a quote for these cones', name: 'Stenciled cones' },
      drum: { n: 3, label: 'Get a quote for these drums', name: 'Stenciled drums' },
      aframe: { n: 4, label: 'Get a quote for these rails', name: 'Custom A-frame rails' }
    };
    // real product photos used as templates: where the stencil goes on each
    const TPL = {
      'cone-Reflective': { src: '/custom/tpl/cone-reflective.webp', w: 551, h: 1162, cx: 272, cy: 800, maxW: 236, maxH: 120 },
      'cone-Plain': { src: '/custom/tpl/cone-plain.webp', w: 805, h: 1400, cx: 402, cy: 900, maxW: 300, maxH: 190 },
      drum: { src: '/cats/alt-traffic-drums.png', w: 293, h: 560, cx: 146, cy: 462, maxW: 178, maxH: 74 }
    };
    const $ = (n) => form.elements[n];
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const lum = (hex) => {
      const n = parseInt(hex.slice(1), 16);
      const c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => { v /= 255; return v <= .03928 ? v / 12.92 : ((v + .055) / 1.055) ** 2.4; });
      return .2126 * c[0] + .7152 * c[1] + .0722 * c[2];
    };
    const contrast = (a, b) => { const x = lum(a), y = lum(b); return (Math.max(x, y) + .05) / (Math.min(x, y) + .05); };
    const el = (tag, attrs, parent) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); parent && parent.appendChild(e); return e; };

    const read = () => {
      const shape = form.querySelector('[name=shape]:checked').value;
      let w = clamp(+$('w').value || 24, 6, 144);
      let h = clamp(+$('h').value || 30, 6, 144);
      if (SQUARE.has(shape)) h = w;
      return {
        shape, w, h,
        border: $('border').checked,
        legend: $('legend').value.split('\n').map((s) => s.trim()).filter(Boolean).slice(0, 5),
        arrow: form.querySelector('[name=arrow]:checked').value,
        sheeting: $('sheeting').value, substrate: $('substrate').value,
        qty: Math.max(1, Math.round(+$('qty').value || 1))
      };
    };

    // Polygon points for a shape that fills the box (x, y, w, h), scaled by k about the center.
    const outline = (shape, cx, cy, w, h, k) => {
      if (shape === 'diamond') { const r = (w / 2) * k; return `M${cx} ${cy - r}L${cx + r} ${cy}L${cx} ${cy + r}L${cx - r} ${cy}Z`; }
      if (shape === 'octagon') {
        const r = (w / 2) * k, a = r * Math.tan(Math.PI / 8);
        return `M${cx - a} ${cy - r}H${cx + a}L${cx + r} ${cy - a}V${cy + a}L${cx + a} ${cy + r}H${cx - a}L${cx - r} ${cy + a}V${cy - a}Z`;
      }
      return null;
    };

    const drawSign = () => {
      const s = read();
      const U = 10;
      const sw = s.w * U, sh = s.h * U;
      const diag = s.shape === 'diamond' ? sw * Math.SQRT2 : 0;
      const bw = diag || sw, bh = diag || sh;
      const pad = Math.max(bw, bh) * .05;
      const VW = bw + pad * 2, VH = bh + pad * 2;
      const cx = VW / 2, cy = VH / 2;
      svg.setAttribute('viewBox', `0 0 ${VW} ${VH}`);
      svg.innerHTML = '';
      const minD = Math.min(sw, sh);
      el('defs', {}, svg).innerHTML = `<filter id="sbSh" x="-10%" y="-10%" width="120%" height="130%"><feDropShadow dx="0" dy="${minD * .02}" stdDeviation="${minD * .025}" flood-color="#000" flood-opacity=".28"/></filter>`;
      const g = el('g', { filter: 'url(#sbSh)' }, svg);
      const edge = { stroke: 'rgba(0,0,0,.18)', 'stroke-width': minD * .006 };
      // the classic work zone sign uses the real sign blank photo
      const photo = s.shape === 'diamond' && st.bg === '#ff6a13' && st.fg === '#141414' && s.border;
      // sign face
      if (s.shape === 'rect') {
        const r = minD * .06;
        el('rect', { x: cx - sw / 2, y: cy - sh / 2, width: sw, height: sh, rx: r, fill: st.bg, ...edge }, g);
      } else if (s.shape === 'circle') {
        el('circle', { cx, cy, r: sw / 2, fill: st.bg, ...edge }, g);
      } else if (photo) {
        const iw = diag * (901 / 849), ih = iw * (907 / 901);
        el('image', { href: '/custom/tpl/sign-diamond-orange.webp', x: cx - iw / 2, y: cy - ih / 2, width: iw, height: ih }, g);
      } else {
        const span = s.shape === 'diamond' ? diag : sw;
        el('path', { d: outline(s.shape, cx, cy, span, span, 1), fill: st.bg, 'stroke-linejoin': 'round', ...edge }, g);
      }
      // border
      if (s.border && !photo) {
        const bwid = minD * .022, inset = minD * .035;
        const common = { fill: 'none', stroke: st.fg, 'stroke-width': bwid, 'stroke-linejoin': 'round' };
        if (s.shape === 'rect') {
          const r = Math.max(0, minD * .06 - inset * .6);
          el('rect', { x: cx - sw / 2 + inset, y: cy - sh / 2 + inset, width: sw - inset * 2, height: sh - inset * 2, rx: r, ...common }, svg);
        } else if (s.shape === 'circle') {
          el('circle', { cx, cy, r: sw / 2 - inset, ...common }, svg);
        } else {
          const span = s.shape === 'diamond' ? diag : sw;
          const k = 1 - (inset * (s.shape === 'diamond' ? Math.SQRT2 : 1.08)) / (span / 2);
          el('path', { d: outline(s.shape, cx, cy, span, span, k), ...common }, svg);
        }
      }
      // content box
      const f = { rect: [.84, .8], diamond: [.62, .62], octagon: [.8, .62], circle: [.7, .62] }[s.shape];
      const boxW = sw * f[0], boxH = sh * f[1];
      const top = cy - boxH / 2;
      const hasArrow = s.arrow !== 'none';
      const textH = hasArrow ? (s.legend.length ? boxH * .58 : 0) : boxH;
      const arrowH = boxH - textH;
      // legend
      if (s.legend.length) {
        const n = s.legend.length;
        const lh = 1.08;
        let fs = Math.min(textH / (n * lh), boxW * .42);
        const tg = el('g', { fill: st.fg, 'font-family': "'Archivo Variable', 'Arial Narrow', Arial, sans-serif", 'font-weight': 800, style: "font-variation-settings: 'wght' 800", 'text-anchor': 'middle' }, svg);
        const nodes = s.legend.map((line) => { const t = el('text', { x: cx, 'font-size': fs }, tg); t.textContent = line; return t; });
        const widest = Math.max(...nodes.map((t) => t.getComputedTextLength() || 1));
        if (widest > boxW) fs *= boxW / widest;
        const block = n * fs * lh;
        const y0 = top + (textH - block) / 2;
        nodes.forEach((t, i) => {
          t.setAttribute('font-size', fs);
          t.setAttribute('y', y0 + fs * (i * lh + .86));
          const len = t.getComputedTextLength();
          if (len) { t.setAttribute('textLength', len); t.setAttribute('lengthAdjust', 'spacingAndGlyphs'); }
        });
      }
      // arrow
      if (hasArrow) {
        const size = Math.min(arrowH * .92, boxW * .7, s.legend.length ? Infinity : boxH * .9);
        const ax = cx, ay = top + textH + arrowH / 2;
        const rot = { up: 0, 'up-right': 45, right: 90, left: -90, 'up-left': -45 }[s.arrow];
        const u = size / 100;
        const d = `M0 ${-50 * u}L${38 * u} ${-8 * u}H${14 * u}V${50 * u}H${-14 * u}V${-8 * u}H${-38 * u}Z`;
        el('path', { d, fill: st.fg, 'stroke-linejoin': 'round', transform: `translate(${ax} ${ay}) rotate(${rot})` }, svg);
      }
      // labels
      root.querySelector('[data-dims]').textContent = `${s.w}" × ${s.h}"`;
      root.querySelector('[data-spec]').textContent = `${SHAPE_NAMES[s.shape]} · ${st.bgName} / ${st.fgName} · ${s.sheeting.replace(', recommend one', '')}`;
      root.querySelector('[data-bgname]').textContent = st.bgName;
      root.querySelector('[data-fgname]').textContent = st.fgName;
      root.querySelectorAll('[data-sw=bg] .sb__dot').forEach((b) => b.classList.toggle('is-on', b.dataset.c === st.bg));
      root.querySelectorAll('[data-sw=fg] .sb__dot').forEach((b) => b.classList.toggle('is-on', b.dataset.c === st.fg));
      const sq = SQUARE.has(s.shape);
      $('h').disabled = sq;
      if (sq) $('h').value = s.w;
      root.querySelectorAll('[data-size]').forEach((b) => {
        const [w, h] = b.dataset.size.split('x').map(Number);
        b.hidden = sq && w !== h;
        b.classList.toggle('is-on', w === s.w && h === s.h);
      });
    };


    // ---------- cones, drums and A-frame rails ----------
    const fitText = (g, lines, cx, cy, maxW, maxH, attrs) => {
      const n = lines.length; if (!n) return;
      const lh = 1.06;
      let fs = Math.min(maxH / (n * lh), maxW * .5);
      const nodes = lines.map((t) => { const e = el('text', { x: cx, 'font-size': fs, ...attrs }, g); e.textContent = t; return e; });
      const widest = Math.max(...nodes.map((t) => t.getComputedTextLength() || 1));
      if (widest > maxW) fs *= maxW / widest;
      const y0 = cy - (n * fs * lh) / 2;
      nodes.forEach((t, i) => {
        t.setAttribute('font-size', fs); t.setAttribute('y', y0 + fs * (i * lh + .86));
        const len = t.getComputedTextLength(); if (len) { t.setAttribute('textLength', len); t.setAttribute('lengthAdjust', 'spacingAndGlyphs'); }
      });
    };
    const FONT = { 'font-family': "'Archivo Variable', 'Arial Narrow', Arial, sans-serif", 'font-weight': 800, style: "font-variation-settings: 'wght' 820", 'text-anchor': 'middle' };
    const readProd = () => {
      const pre = { cone: 'c', drum: 'd', aframe: 'a' }[kind];
      const v = (n) => $(pre + '_' + n);
      return {
        lines: [v('t1').value, v('t2').value].map((t) => t.trim().toUpperCase()).filter(Boolean),
        color: kind === 'aframe' ? st.railName : form.querySelector(`[name=${pre}_color]:checked`).value,
        logo: v('logo').checked,
        qty: Math.max(1, Math.round(+v('qty').value || 1)),
        size: kind === 'cone' ? form.querySelector('[name=c_size]:checked').value : '',
        style: kind === 'cone' ? form.querySelector('[name=c_style]:checked').value : '',
        stripes: kind === 'aframe' ? $('a_stripes').checked : false,
        t1: v('t1').value.trim().toUpperCase(), t2: v('t2').value.trim().toUpperCase()
      };
    };
    const drawProduct = () => {
      const d = readProd();
      svg.innerHTML = '';
      const dims = root.querySelector('[data-dims]'), spec = root.querySelector('[data-spec]');
      if (kind === 'aframe') {
        const VW = 800, VH = 560;
        svg.setAttribute('viewBox', `0 0 ${VW} ${VH}`);
        el('ellipse', { cx: 400, cy: 530, rx: 330, ry: 14, fill: 'rgba(0,0,0,.14)' }, svg);
        el('path', { d: 'M150 60 L96 525 h34 L182 96z M650 60 L704 525 h-34 L618 96z', fill: '#f4f5f6', stroke: '#c9ced3', 'stroke-width': 3, 'stroke-linejoin': 'round' }, svg);
        const defs = el('defs', {}, svg);
        [[0, 100, d.t1], [1, 320, d.t2]].forEach(([i, y, text]) => {
          const cp = el('clipPath', { id: 'rail' + i }, defs); el('rect', { x: 50, y, width: 700, height: 118, rx: 8 }, cp);
          el('rect', { x: 50, y, width: 700, height: 118, rx: 8, fill: '#ffffff', stroke: '#c9ced3', 'stroke-width': 3 }, svg);
          const g = el('g', { 'clip-path': `url(#rail${i})` }, svg);
          if (d.stripes) for (const side of [0, 1]) for (let k = 0; k < 2; k++) {
            const x = side ? 800 - 78 - k * 78 : 78 + k * 78;
            el('path', { d: `M${x - 52} ${y + 118} L${x + 6} ${y} h34 L${x - 18} ${y + 118}z`, fill: st.rail, transform: side ? `translate(${2 * x - 12} 0) scale(-1 1)` : '' }, g);
          }
          if (text) fitText(svg, [text], 400, y + 59, d.stripes ? 400 : 620, 66, { ...FONT, fill: st.rail });
        });
        dims.textContent = 'A-frame rails';
        spec.textContent = `${st.railName} on white${d.stripes ? ' · Striped ends' : ''}${d.logo ? ' · Logo' : ''}`;
        return;
      }
      const t = TPL[kind === 'cone' ? 'cone-' + d.style : 'drum'];
      const pad = t.h * .04;
      svg.setAttribute('viewBox', `${-pad} ${-pad} ${t.w + pad * 2} ${t.h + pad * 2}`);
      el('ellipse', { cx: t.w / 2, cy: t.h - pad * .2, rx: t.w * .46, ry: t.h * .018, fill: 'rgba(0,0,0,.16)' }, svg);
      el('image', { href: t.src, x: 0, y: 0, width: t.w, height: t.h }, svg);
      const white = d.color === 'White';
      const g = el('g', { style: white ? '' : 'mix-blend-mode: multiply', opacity: white ? .94 : .92 }, svg);
      if (d.lines.length) fitText(g, d.lines, t.cx, t.cy, t.maxW, t.maxH, { ...FONT, fill: white ? '#ffffff' : '#141414' });
      dims.textContent = kind === 'cone' ? `${d.size} cone` : 'Traffic drum';
      spec.textContent = `${kind === 'cone' ? d.style + ' · ' : ''}${d.color} stencil${d.logo ? ' · Logo' : ''}`;
    };
    const draw = () => (kind === 'sign' ? drawSign() : drawProduct());

    // product picker
    const picks = [...document.querySelectorAll('[data-kind-pick]')];
    const setKind = (k, scroll) => {
      if (!KIND[k]) return;
      kind = k;
      picks.forEach((b) => { const on = b.dataset.kindPick === k; b.classList.toggle('is-on', on); b.setAttribute('aria-selected', String(on)); });
      form.querySelectorAll('[data-kind]').forEach((d) => { d.hidden = d.dataset.kind !== k; });
      form.querySelector('[data-contact-n]').textContent = KIND[k].n;
      form.querySelector('[data-send-label]').textContent = KIND[k].label;
      form.querySelector('[data-ok]').hidden = true;
      const stage = root.querySelector('.sb__canvas'); stage.classList.remove('is-swap'); void stage.offsetWidth; stage.classList.add('is-swap');
      draw();
      if (scroll) document.getElementById('builder').scrollIntoView({ behavior: 'smooth' });
    };
    picks.forEach((b) => b.addEventListener('click', () => setKind(b.dataset.kindPick)));
    document.querySelectorAll('[data-kind-go]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); setKind(a.dataset.kindGo, true); }));
    root.querySelector('[data-rail]').addEventListener('click', (e) => {
      const b = e.target.closest('.sb__dot'); if (!b) return;
      st.rail = b.dataset.c; st.railName = b.dataset.n;
      root.querySelectorAll('[data-rail] .sb__dot').forEach((x) => x.classList.toggle('is-on', x === b));
      draw();
    });

    // swatches
    root.querySelectorAll('[data-sw]').forEach((wrap) => {
      const key = wrap.dataset.sw;
      wrap.addEventListener('click', (e) => {
        const b = e.target.closest('.sb__dot'); if (!b) return;
        st[key] = b.dataset.c; st[key + 'Name'] = b.dataset.n;
        if (key === 'bg' && contrast(st.bg, st.fg) < 2.2) {
          const alt = contrast(st.bg, '#141414') > contrast(st.bg, '#ffffff') ? ['#141414', 'Black'] : ['#ffffff', 'White'];
          st.fg = alt[0]; st.fgName = alt[1];
        }
        draw();
      });
      wrap.querySelector('[data-custom]').addEventListener('input', (e) => { st[key] = e.target.value; st[key + 'Name'] = 'Custom ' + e.target.value.toUpperCase(); draw(); });
    });
    root.querySelectorAll('[data-size]').forEach((b) => b.addEventListener('click', () => {
      const [w, h] = b.dataset.size.split('x'); $('w').value = w; $('h').value = h; draw();
    }));
    root.querySelectorAll('[data-q]').forEach((b) => b.addEventListener('click', () => {
      const inp = b.parentElement.querySelector('input'); inp.value = Math.max(1, (+inp.value || 1) + +b.dataset.q); draw();
    }));
    form.addEventListener('input', draw);
    form.addEventListener('change', draw);
    document.fonts?.ready.then(draw);
    draw();

    // keep the sticky preview just under the site header
    const hdr = document.querySelector('header');
    const setTop = () => root.style.setProperty('--hdr-h', `${Math.round(hdr.getBoundingClientRect().height)}px`);
    if (hdr) { setTop(); if ('ResizeObserver' in window) new ResizeObserver(setTop).observe(hdr); }

    // download preview as PNG
    root.querySelector('[data-download]').addEventListener('click', async () => {
      const vb = svg.viewBox.baseVal;
      const scale = 1400 / Math.max(vb.width, vb.height);
      const clone = svg.cloneNode(true);
      // photos must be embedded for the saved image to include them
      for (const im of clone.querySelectorAll('image')) {
        try {
          const blob = await (await fetch(im.getAttribute('href'))).blob();
          im.setAttribute('href', await new Promise((res) => { const fr = new FileReader(); fr.onload = () => res(fr.result); fr.readAsDataURL(blob); }));
        } catch {}
      }
      clone.setAttribute('xmlns', NS);
      clone.setAttribute('width', Math.round(vb.width * scale));
      clone.setAttribute('height', Math.round(vb.height * scale));
      const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(clone)], { type: 'image/svg+xml' }));
      const img = new Image();
      img.onload = () => {
        const c = document.createElement('canvas');
        c.width = img.width; c.height = img.height;
        const ctx = c.getContext('2d');
        ctx.fillStyle = '#f3f4f5'; ctx.fillRect(0, 0, c.width, c.height);
        ctx.drawImage(img, 0, 0);
        URL.revokeObjectURL(url);
        const a = document.createElement('a');
        a.download = `tss-custom-${kind}.png`; a.href = c.toDataURL('image/png'); a.click();
      };
      img.src = url;
    });

    // submit
    const ARR = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const s = read();
      const pd = kind === 'sign' ? null : readProd();
      const btn = form.querySelector('[data-submit]');
      const ok = form.querySelector('[data-ok]'), err = form.querySelector('[data-err]');
      ok.hidden = err.hidden = true;
      const contact = { name: $('name').value, company: $('company').value, email: $('email').value, phone: $('phone').value, notes: $('notes').value };
      const answers = kind === 'sign' ? {
        product: 'Custom sign', shape: SHAPE_NAMES[s.shape], size: `${s.w}" x ${s.h}"`,
        background: `${st.bgName} (${st.bg})`, legendColor: `${st.fgName} (${st.fg})`, border: s.border ? 'Yes' : 'No',
        legend: s.legend.join(' / '), arrow: s.arrow, hasArtwork: $('artwork').checked ? 'Yes' : 'No',
        sheeting: s.sheeting, material: s.substrate, quantity: s.qty, ...contact
      } : kind === 'aframe' ? {
        product: KIND.aframe.name, railColor: `${st.railName} (${st.rail})`, stripedEnds: pd.stripes ? 'Yes' : 'No',
        topRail: pd.t1, bottomRail: pd.t2, hasLogo: pd.logo ? 'Yes' : 'No', quantity: pd.qty, ...contact
      } : {
        product: KIND[kind].name, ...(kind === 'cone' ? { size: pd.size, style: pd.style } : {}),
        stencilText: pd.lines.join(' / '), stencilColor: pd.color, hasLogo: pd.logo ? 'Yes' : 'No', quantity: pd.qty, ...contact
      };
      const lab = btn.querySelector('[data-send-label]');
      btn.disabled = true; lab.textContent = 'Sending';
      try {
        const hook = root.dataset.webhook;
        if (!hook) throw new Error('no webhook');
        const r = await fetch(hook, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'custom-' + kind, page: location.pathname, submittedAt: new Date().toISOString(), answers, previewSvg: svg.outerHTML.slice(0, 60000) })
        });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        ok.hidden = false;
      } catch {
        const body = Object.entries(answers).map(([k, v]) => `${k}: ${v}`).join('\n');
        location.href = `mailto:${root.dataset.email}?subject=${encodeURIComponent(answers.product + ' quote')}&body=${encodeURIComponent(body)}`;
        err.hidden = false;
      } finally {
        btn.disabled = false; lab.textContent = KIND[kind].label;
      }
    });
  })();
</script>

