---
// Truck showroom scene: bucket truck, TMA and bucket van on a dark showroom floor, lights on.
// animate: trucks drive in on load with wheels turning. Without it they are already parked.
// duo: on phones only the TMA and the bucket van show, cropped tight so they are as large as the screen allows.
// tall: taller back wall for full page heroes. band: below 1200px wide it becomes its own strip cropped to the trucks. Coordinates are in the 3000 x 760 scene.
const { animate = false, tall = false, band = false, duo = false, set = 'trucks', night = false, class: cls = '' } = Astro.props;
const EQ = set === 'equipment';
// equipment set: VMS board, arrow board and light tower (layers in /public/equip, built by the same scene script)
const ITEMS = [
  { k: 'vms', d: 0.1, on: ['vms-on', 'vms-on2'] },
  { k: 'arrow', d: 0.35, on: ['arrow-0', 'arrow-1', 'arrow-2'] },
  { k: 'tower', d: 0.6, on: ['tower-on'], pool: true }
];
const SCENE_W = 3000, SCENE_H = 760;
// drawn in this order, so each truck sits in front of the one before it (TMA over the bucket truck's rear, van over the TMA's rear)
const TRUCKS = [
  { k: 'bucket', d: 0.1, mx: 0, wheels: [[1533, 626, 33, 42], [1851, 560, 12, 26]], lamps: [[1430, 545, 66], [1408, 612, 24]], beam: [1210, 672] },
  { k: 'tma', d: 0.8, mx: -4, wheels: [[2105,  623,  38,  44],  [2411,  556,  9,  26]], lamps: [[2038,  550,  73]], beam: [1850, 675] },
  { k: 'van', d: 1.5, mx: -8, wheels: [[2627,  653,  24,  33],  [2901,  571,  11,  21]], lamps: [[2518,  565,  59],  [2518,  650,  25]], beam: [2355, 669], beacon: [2714, 346] }
];
const px = (x) => (x / SCENE_W * 100).toFixed(3) + '%';
const py = (y) => (y / SCENE_H * 100).toFixed(3) + '%';
const V = '?v=13';
---
<div class:list={['sr', night && 'sr--night', EQ ? 'sr--equip' : animate ? 'sr--drive' : 'sr--parked', EQ && animate && 'sr--rise', tall && 'sr--tall', band && 'sr--auto', duo && 'sr--duo', cls]} data-sr role="img" aria-label={EQ ? "TSS VMS message board, arrow board and light tower in a showroom" : "TSS bucket truck, TMA crash truck and bucket van lined up in a showroom"}>
  <div class="sr__cv">
    <img class="sr__bg" src={night ? `/equip/${tall ? 'night-bg-tall' : 'night-bg'}.webp${V}` : `/fleet/${tall ? 'showroom-bg-tall' : 'showroom-bg'}.webp${V}`} alt="" />
    {tall && <img class="sr__bg sr__bg--m" src={night ? '/equip/night-bg.webp' : '/fleet/showroom-bg.webp'} alt="" loading="lazy" />}
    {EQ ? (
    <div class="sr__stage">
      {ITEMS.map((t) => (
        <div class={`sr__t sr__t--${t.k}`} style={`--d:${t.d}s`}>
          <img class="sr__img" src={`/equip/${t.k}-sh.webp${V}`} alt="" />
          {t.pool && !night && <img class="sr__img sr__on sr__pool" src={`/equip/tower-pool.webp${V}`} alt="" />}
        </div>
      ))}
      {night && <img class="sr__img sr__glow" src={`/equip/night-pool.webp${V}`} alt="" />}
      {night && <img class="sr__img sr__glow" src={`/equip/night-refl.webp${V}`} alt="" />}
      {ITEMS.map((t) => (
        <div class={`sr__t sr__t--${t.k}`} style={`--d:${t.d}s`}>
          <img class="sr__img sr__base" src={`/equip/${t.k}.webp${V}`} alt="" />
          {night && <img class="sr__img" src={`/equip/${t.k}-spill.webp${V}`} alt="" />}
          {t.on.map((o, n) => <img class:list={['sr__img sr__on', `sr__on--${t.k}`]} style={`--n:${n}`} src={`/equip/${o}.webp${V}`} alt="" />)}
        </div>
      ))}
      {EQ && <canvas class="sr__vmsc" width="3000" height="760" data-vms-canvas aria-hidden="true"></canvas>}
    </div>
    ) : (
    <div class="sr__stage">
      {TRUCKS.map((t) => (
        <div class={`sr__t sr__t--${t.k}`} style={`--d:${t.d}s;--mx:${t.mx}%`}>
          <img class="sr__img" src={`/fleet/showroom-${t.k}-sh.webp${V}`} alt="" />
          <div class="sr__beam" style={`left:${px(t.beam[0])};top:${py(t.beam[1])}`}></div>
        </div>
      ))}
      {TRUCKS.map((t) => (
        <div class={`sr__t sr__t--${t.k}`} style={`--d:${t.d}s;--mx:${t.mx}%`}>
          <div class="sr__body">
            <img class="sr__img" src={`/fleet/showroom-${t.k}.webp${V}`} alt="" />
            {t.wheels.map(([cx, cy, rx, ry], n) => (
              <span class="sr__wh" style={`left:${px(cx)};top:${py(cy)};width:${px(ry * 2)};--sq:${(rx / ry).toFixed(3)};--turn:${Math.round(2250 / (2 * Math.PI * t.wheels[0][3]) * 360)}deg`}>
                <img class="sr__rim" src={`/fleet/wh-${t.k}-${n}.webp${V}`} alt="" />
                <img class="sr__blur" src={`/fleet/wh-${t.k}-${n}-b.webp${V}`} alt="" />
              </span>
            ))}
            {t.lamps.map(([cx, cy, w]) => <span class="sr__lamp" style={`left:${px(cx)};top:${py(cy)};width:${px(w * 3.2)}`}></span>)}
            {t.beacon && <span class="sr__beacon" style={`left:${px(t.beacon[0])};top:${py(t.beacon[1])}`}></span>}
          </div>
        </div>
      ))}
    </div>
    )}
  </div>
</div>

<script is:inline>
  // Equipment set: visitors can put their own message on the VMS board. The LED grid is mapped onto the
  // board's real angle with a perspective transform (corners in scene pixels), same 5x7 font as the built-in messages.
  (() => {
    const cv = document.querySelector('[data-vms-canvas]'); if (!cv) return;
    const sr = cv.closest('[data-sr]'), ctx = cv.getContext('2d');
    const Q = [[1505.6, 202.1], [1907.3, 229.4], [1907.3, 462.1], [1505.6, 467.3]];
    const COLS = 72, ROWS = 45, MAX = 12;
    const F = {"A":"01110100011000111111100011000110001","B":"11110100011000111110100011000111110","C":"01110100011000010000100001000101110","D":"11110100011000110001100011000111110","E":"11111100001000011110100001000011111","F":"11111100001000011110100001000010000","G":"01110100011000010111100011000101111","H":"10001100011000111111100011000110001","I":"01110001000010000100001000010001110","J":"00111000100001000010000101001001100","K":"10001100101010011000101001001010001","L":"10000100001000010000100001000011111","M":"10001110111010110101100011000110001","N":"10001110011010110101100111000110001","O":"01110100011000110001100011000101110","P":"11110100011000111110100001000010000","Q":"01110100011000110001101011001001101","R":"11110100011000111110101001001010001","S":"01111100001000001110000010000111110","T":"11111001000010000100001000010000100","U":"10001100011000110001100011000101110","V":"10001100011000110001100010101000100","W":"10001100011000110101101011010101010","X":"10001100010101000100010101000110001","Y":"10001100010101000100001000010000100","Z":"11111000010001000100010001000011111","0":"01110100011001110101110011000101110","1":"00100011000010000100001000010001110","2":"01110100010000100010001000100011111","3":"11110000010000101110000010000111110","4":"00010001100101010010111110001000010","5":"11111100001111000001000011000101110","6":"00110010001000011110100011000101110","7":"11111000010001000100010000100001000","8":"01110100011000101110100011000101110","9":"01110100011000101111000010001001100","-":"00000000000000011111000000000000000",".":"00000000000000000000000000110001100","!":"00100001000010000100001000000000100","?":"01110100010000100010001000000000100","'":"00100001000100000000000000000000000","/":"00001000100001000100010000100010000"};
    const H = (() => { // unit square -> quad
      const [[x0, y0], [x1, y1], [x2, y2], [x3, y3]] = Q;
      const dx1 = x1 - x2, dx2 = x3 - x2, dy1 = y1 - y2, dy2 = y3 - y2, sx = x0 - x1 + x2 - x3, sy = y0 - y1 + y2 - y3;
      const den = dx1 * dy2 - dx2 * dy1, g = (sx * dy2 - dx2 * sy) / den, h = (dx1 * sy - sx * dy1) / den;
      return [x1 - x0 + g * x1, x3 - x0 + h * x3, x0, y1 - y0 + g * y1, y3 - y0 + h * y3, y0, g, h];
    })();
    const P = (u, v) => { const [a, b, c, d, e, f, g, h] = H, w = g * u + h * v + 1; return [(a * u + b * v + c) / w, (d * u + e * v + f) / w]; };
    const wrap = (t) => {
      const words = t.toUpperCase().replace(/[^A-Z0-9 .!?'\/-]/g, '').split(/\s+/).filter(Boolean), lines = [];
      let cur = '';
      for (let w of words) {
        while (w.length > MAX) { if (cur) { lines.push(cur); cur = ''; } lines.push(w.slice(0, MAX)); w = w.slice(MAX); }
        if (!cur) cur = w; else if ((cur + ' ' + w).length <= MAX) cur += ' ' + w; else { lines.push(cur); cur = w; }
      }
      if (cur) lines.push(cur);
      return lines.slice(0, 3);
    };
    const draw = (lines) => {
      ctx.clearRect(0, 0, cv.width, cv.height);
      const rows = lines.length === 3 ? [4, 19, 34] : lines.length === 2 ? [12, 26] : [19];
      const dots = [];
      lines.forEach((ln, li) => {
        const w = ln.length * 6 - 1, c0 = Math.floor((COLS - w) / 2);
        [...ln].forEach((ch, k) => { const g = F[ch]; if (!g) return; for (let i = 0; i < 35; i++) if (g[i] === '1') dots.push([c0 + k * 6 + (i % 5), rows[li] + Math.floor(i / 5)]); });
      });
      ctx.globalCompositeOperation = 'lighter';
      for (const [pass, rad, col] of [[0, 5.2, 'rgba(255,150,40,.16)'], [1, 2.6, 'rgba(246,152,52,1)'], [2, 1.35, 'rgba(255,222,150,1)']]) {
        ctx.fillStyle = col;
        for (const [c, r] of dots) {
          const [x, y] = P((c + .5) / COLS, (r + .5) / ROWS); ctx.beginPath(); ctx.arc(x, y, rad, 0, 6.283); ctx.fill();
        }
      }
      ctx.globalCompositeOperation = 'source-over';
    };
    window.TSSVms = {
      set(t) {
        const lines = wrap(t || '');
        if (!lines.length) { sr.classList.remove('is-custom'); ctx.clearRect(0, 0, cv.width, cv.height); return []; }
        sr.classList.add('is-custom'); draw(lines); return lines;
      }
    };
  })();
  (() => {
    document.querySelectorAll('[data-sr]:not([data-sr-on])').forEach((sr) => {
      sr.setAttribute('data-sr-on', '');
      const go = () => sr.classList.add('is-go');
      const imgs = [...sr.querySelectorAll('.sr__bg, .sr__img')].filter((i) => i.offsetParent !== null);
      Promise.all(imgs.map((i) => (i.complete ? Promise.resolve() : new Promise((r) => { i.onload = i.onerror = r; })))).then(() => requestAnimationFrame(go));
      setTimeout(go, 3000);
    });
  })();
</script>

<style>
  /* The canvas (.sr__cv) keeps the scene's shape; the stage holds everything positioned in scene coordinates. */
  .sr { position: relative; overflow: hidden; pointer-events: none; background: #121416; }
  .sr__cv { position: absolute; left: 0; bottom: 0; width: 100%; aspect-ratio: 3000 / 760; }
  .sr--tall .sr__cv { aspect-ratio: 3000 / 1250; }
  .sr__stage { position: absolute; left: 0; bottom: 0; width: 100%; aspect-ratio: 3000 / 760; }
  .sr__bg, .sr__img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .sr__bg--m { display: none; }
  .sr__t { position: absolute; inset: 0; transform: translateX(var(--park, 0%)); }
  .sr--drive .sr__t { transform: translateX(78%); }
  .sr--drive.is-go .sr__t { animation: srDrive 4.2s var(--d) cubic-bezier(.14, .7, .22, 1) forwards; }
  .sr__body { position: absolute; inset: 0; transform-origin: 60% 85%; }
  .sr--drive.is-go .sr__body { animation: srBrake 1.1s calc(var(--d) + 3.2s) cubic-bezier(.3, .6, .3, 1) both; }
  .sr__wh { position: absolute; aspect-ratio: 1; transform: translate(-50%, -50%) scaleX(var(--sq)); }
  .sr__wh img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .sr__blur { opacity: 0; }
  .sr--drive .sr__rim { transform: rotate(var(--turn)); }
  .sr--drive.is-go .sr__rim { animation: srSpin 4.2s var(--d) cubic-bezier(.14, .7, .22, 1) forwards; }
  .sr--drive .sr__blur { opacity: 1; }
  .sr--drive.is-go .sr__blur { animation: srBlur 4.2s var(--d) linear forwards; }
  .sr__lamp { position: absolute; aspect-ratio: 2.1; transform: translate(-50%, -50%); border-radius: 50%; mix-blend-mode: screen; background: radial-gradient(closest-side, rgba(255, 252, 240, 1) 0%, rgba(255, 246, 214, .85) 16%, rgba(255, 236, 180, .32) 42%, rgba(255, 230, 170, 0) 100%); animation: srLamp 3.6s 3s ease-in-out infinite; }
  .sr__lamp::after { content: ''; position: absolute; left: -45%; right: -45%; top: 46%; height: 8%; border-radius: 50%; background: radial-gradient(closest-side, rgba(255, 250, 230, .8), rgba(255, 250, 230, 0)); }
  .sr__beam { position: absolute; width: 17%; aspect-ratio: 5.2; transform: translate(-50%, -50%); border-radius: 50%; mix-blend-mode: screen; background: radial-gradient(closest-side, rgba(255, 244, 210, .34), rgba(255, 244, 210, .12) 55%, rgba(255, 244, 210, 0)); }
  .sr__beacon { position: absolute; width: 2.6%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; mix-blend-mode: screen; background: radial-gradient(closest-side, rgba(255, 190, 60, 1), rgba(255, 150, 20, .6) 35%, rgba(255, 140, 0, 0)); animation: srBeacon 1.1s steps(1) infinite; }

  /* Band mode (phones, tablets, small laptops): the scene is its own strip, cropped to the trucks. */
  @media (max-width: 1199px) {
    .sr--auto { width: 100%; aspect-ratio: 1870 / 700; }
    .sr--auto .sr__cv { width: calc(3000 / 1870 * 100%); left: calc(-1130 / 1870 * 100%); aspect-ratio: 3000 / 760; }
    /* tall wall keeps its own shape and rises above the strip, so a parent can stretch the scene upward behind a headline */
    .sr--auto.sr--tall .sr__bg { inset: auto 0 0 0; height: auto; aspect-ratio: 3000 / 1250; }
    .sr--auto.sr--tall .sr__bg--m { display: none; }
  }

  /* Phones, duo mode: TMA and van only. Scene x 1780 to 3000 fills the screen (about 17px clear each side at 390 wide);
     the strip is 495 scene units tall, which leaves a small gap above the van's boom. */
  @media (max-width: 640px) {
    .sr--duo.sr--auto { aspect-ratio: 1220 / 510; }
    .sr--duo.sr--auto .sr__cv { width: calc(3000 / 1220 * 100%); left: calc(-1780 / 1220 * 100%); }
    .sr--duo .sr__t { --park: -.47%; }
    /* even vignette on both screen edges (the wall image only fades on its right) */
    .sr--duo.sr--auto::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(18, 20, 22, .85), rgba(18, 20, 22, 0) 6%, rgba(18, 20, 22, 0) 95%, rgba(18, 20, 22, .35)); }
    .sr--duo .sr__t--bucket { display: none; }
    .sr--duo .sr__t--tma { --d: .1s !important; }
    .sr--duo .sr__t--van { --d: .8s !important; }
  }

  /* Equipment set: units rise into place, then power on (light tower, VMS message, sequential arrow board). */
  /* lights are on from the first frame; units settle in quickly */
  .sr--rise .sr__t { opacity: 0; transform: translate(var(--park, 0%), 2%); animation: srRise .55s calc(var(--d) * .25) cubic-bezier(.2, .8, .2, 1) forwards; }
  @keyframes srRise { to { opacity: 1; transform: translate(var(--park, 0%), 0); } }
  .sr--equip .sr__on { opacity: 1; }
  .sr--equip .sr__on--vms[style*='--n:1'] { opacity: 0; }
  .sr--equip .sr__on--vms { animation: srPhaseA 6s 2.5s steps(1) infinite; }
  .sr--equip .sr__on--vms[style*='--n:1'] { animation: srPhaseB 6s 2.5s steps(1) infinite; }
  .sr--equip .sr__on--arrow { animation: srChev0 1.6s steps(1) infinite; }
  .sr--equip .sr__on--arrow[style*='--n:1'] { animation-name: srChev1; }
  .sr--equip .sr__on--arrow[style*='--n:2'] { animation-name: srChev2; }
  @keyframes srPhaseA { 0% { opacity: 1; } 50% { opacity: 0; } }
  @keyframes srPhaseB { 0% { opacity: 0; } 50% { opacity: 1; } }
  @keyframes srChev0 { 0% { opacity: 1; } 75% { opacity: 0; } }
  @keyframes srChev1 { 0% { opacity: 0; } 25% { opacity: 1; } 75% { opacity: 0; } }
  @keyframes srChev2 { 0% { opacity: 0; } 50% { opacity: 1; } 75% { opacity: 0; } }
  .sr--parked.sr--equip .sr__on { opacity: 1; }
  .sr--parked.sr--equip .sr__on--vms[style*='--n:1'] { opacity: 0; }
  /* phones, duo: VMS and arrow board only */
  @media (max-width: 640px) {
    .sr--equip.sr--duo.sr--auto { aspect-ratio: 1290 / 660; }
    .sr--equip.sr--duo.sr--auto .sr__cv { width: calc(3000 / 1290 * 100%); left: calc(-1277 / 1290 * 100%); }
    .sr--equip.sr--duo .sr__t--tower { display: none; }
    .sr--equip.sr--duo .sr__t { --park: 0%; }
    .sr--equip.sr--duo .sr__t--arrow { --park: 1.1%; }
  }
  /* night road: unit bodies dimmed to night light, lights stay full strength */
  .sr--night .sr__base { filter: brightness(.6) saturate(.85) hue-rotate(-4deg); }
  .sr--night .sr__t--tower .sr__base { filter: brightness(.5) saturate(.95) sepia(.18); }
  .sr__glow { mix-blend-mode: screen; }
  .sr__vmsc { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; opacity: 0; transition: opacity .25s; }
  .sr.is-custom .sr__vmsc { opacity: 1; }
  .sr.is-custom .sr__on--vms { visibility: hidden; }
  @keyframes srDrive { to { transform: translateX(var(--park, 0%)); } }
  @keyframes srSpin { to { transform: rotate(0deg); } }
  @keyframes srBlur { 0%, 45% { opacity: 1; } 78%, 100% { opacity: 0; } }
  @keyframes srBrake { 0% { transform: rotate(0); } 35% { transform: rotate(-.55deg); } 70% { transform: rotate(.15deg); } 100% { transform: rotate(0); } }
  @keyframes srLamp { 0%, 100% { opacity: 1; } 50% { opacity: .88; } }
  @keyframes srBeacon { 0%, 100% { opacity: 1; } 50% { opacity: .08; } }
  @media (prefers-reduced-motion: reduce) {
    .sr .sr__t { transform: translateX(var(--park, 0%)) !important; animation: none !important; }
    .sr .sr__rim { transform: none !important; animation: none !important; }
    .sr .sr__blur { opacity: 0 !important; animation: none !important; }
    .sr .sr__body, .sr .sr__lamp, .sr .sr__beacon { animation: none !important; }
    .sr--equip .sr__t { opacity: 1 !important; transform: translateX(var(--park, 0%)) !important; animation: none !important; }
    .sr--equip .sr__on { opacity: 1 !important; animation: none !important; }
    .sr--equip .sr__on--vms[style*='--n:1'] { opacity: 0 !important; }
  }
</style>
