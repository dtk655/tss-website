---
// Truck showroom scene: bucket truck, TMA and bucket van on a dark showroom floor, lights on.
// animate: trucks drive in on load with wheels turning. Without it they are already parked.
// tall: taller back wall for full page heroes. band: below 1200px wide it becomes its own strip cropped to the trucks. Coordinates are in the 3000 x 760 scene.
const { animate = false, tall = false, band = false, class: cls = '' } = Astro.props;
const SCENE_W = 3000, SCENE_H = 760;
const TRUCKS = [
  { k: 'van', d: 1.5, mx: -8, wheels: [[2614, 650, 25, 35], [2900, 566, 11, 22]], lamps: [[2500, 558, 62], [2500, 648, 26]], beam: [2330, 668], beacon: [2705, 330] },
  { k: 'tma', d: 0.8, mx: -4, wheels: [[2095, 626, 36, 42], [2388, 561, 9, 25]], lamps: [[2030, 556, 70]], beam: [1850, 676] },
  { k: 'bucket', d: 0.1, mx: 0, wheels: [[1533, 626, 33, 42], [1851, 560, 12, 26]], lamps: [[1430, 545, 66], [1408, 612, 24]], beam: [1210, 672] }
];
const px = (x) => (x / SCENE_W * 100).toFixed(3) + '%';
const py = (y) => (y / SCENE_H * 100).toFixed(3) + '%';
const V = '?v=4';
---
<div class:list={['sr', animate ? 'sr--drive' : 'sr--parked', tall && 'sr--tall', band && 'sr--auto', cls]} data-sr role="img" aria-label="TSS bucket truck, TMA crash truck and bucket van lined up in a showroom">
  <div class="sr__cv">
    <img class="sr__bg" src={`/fleet/${tall ? 'showroom-bg-tall' : 'showroom-bg'}.webp${V}`} alt="" />
    {tall && <img class="sr__bg sr__bg--m" src="/fleet/showroom-bg.webp" alt="" loading="lazy" />}
    <div class="sr__stage">
      {TRUCKS.map((t) => (
        <div class="sr__t" style={`--d:${t.d}s;--mx:${t.mx}%`}>
          <img class="sr__img" src={`/fleet/showroom-${t.k}-sh.webp${V}`} alt="" />
          <div class="sr__beam" style={`left:${px(t.beam[0])};top:${py(t.beam[1])}`}></div>
        </div>
      ))}
      {TRUCKS.map((t) => (
        <div class="sr__t" style={`--d:${t.d}s;--mx:${t.mx}%`}>
          <div class="sr__body">
            <img class="sr__img" src={`/fleet/showroom-${t.k}.webp${V}`} alt="" />
            {t.wheels.map(([cx, cy, rx, ry], n) => (
              <span class="sr__wh" style={`left:${px(cx)};top:${py(cy)};width:${px(ry * 2)};--sq:${(rx / ry).toFixed(3)};--turn:${Math.round(2250 / (2 * Math.PI * t.wheels[0][3]) * 360)}deg`}>
                <img class="sr__rim" src={`/fleet/wh-${t.k}-${n}.webp${V}`} alt="" />
                <img class="sr__blur" src={`/fleet/wh-${t.k}-${n}-b.webp${V}`} alt="" />
              </span>
            ))}
            {t.lamps.map(([cx, cy, w]) => <span class="sr__lamp" style={`left:${px(cx)};top:${py(cy)};width:${px(w * 3.2)}`}></span>)}
            {t.beacon && <span class="sr__beacon" style={`left:${px(t.beacon[0])};top:${py(t.beacon[1])}`}></span>}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-sr]:not([data-sr-on])').forEach((sr) => {
      sr.setAttribute('data-sr-on', '');
      const go = () => sr.classList.add('is-go');
      const imgs = [...sr.querySelectorAll('.sr__bg, .sr__img')].filter((i) => i.offsetParent !== null);
      Promise.all(imgs.map((i) => (i.complete ? Promise.resolve() : new Promise((r) => { i.onload = i.onerror = r; })))).then(() => requestAnimationFrame(go));
      setTimeout(go, 3000);
    });
  })();
</script>

<style>
  /* The canvas (.sr__cv) keeps the scene's shape; the stage holds everything positioned in scene coordinates. */
  .sr { position: relative; overflow: hidden; pointer-events: none; background: #121416; }
  .sr__cv { position: absolute; left: 0; bottom: 0; width: 100%; aspect-ratio: 3000 / 760; }
  .sr--tall .sr__cv { aspect-ratio: 3000 / 1250; }
  .sr__stage { position: absolute; left: 0; bottom: 0; width: 100%; aspect-ratio: 3000 / 760; }
  .sr__bg, .sr__img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .sr__bg--m { display: none; }
  .sr__t { position: absolute; inset: 0; transform: translateX(var(--park, 0%)); }
  .sr--drive .sr__t { transform: translateX(78%); }
  .sr--drive.is-go .sr__t { animation: srDrive 4.2s var(--d) cubic-bezier(.14, .7, .22, 1) forwards; }
  .sr__body { position: absolute; inset: 0; transform-origin: 60% 85%; }
  .sr--drive.is-go .sr__body { animation: srBrake 1.1s calc(var(--d) + 3.2s) cubic-bezier(.3, .6, .3, 1) both; }
  .sr__wh { position: absolute; aspect-ratio: 1; transform: translate(-50%, -50%) scaleX(var(--sq)); }
  .sr__wh img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .sr__blur { opacity: 0; }
  .sr--drive .sr__rim { transform: rotate(var(--turn)); }
  .sr--drive.is-go .sr__rim { animation: srSpin 4.2s var(--d) cubic-bezier(.14, .7, .22, 1) forwards; }
  .sr--drive .sr__blur { opacity: 1; }
  .sr--drive.is-go .sr__blur { animation: srBlur 4.2s var(--d) linear forwards; }
  .sr__lamp { position: absolute; aspect-ratio: 2.1; transform: translate(-50%, -50%); border-radius: 50%; mix-blend-mode: screen; background: radial-gradient(closest-side, rgba(255, 252, 240, 1) 0%, rgba(255, 246, 214, .85) 16%, rgba(255, 236, 180, .32) 42%, rgba(255, 230, 170, 0) 100%); animation: srLamp 3.6s 3s ease-in-out infinite; }
  .sr__lamp::after { content: ''; position: absolute; left: -45%; right: -45%; top: 46%; height: 8%; border-radius: 50%; background: radial-gradient(closest-side, rgba(255, 250, 230, .8), rgba(255, 250, 230, 0)); }
  .sr__beam { position: absolute; width: 17%; aspect-ratio: 5.2; transform: translate(-50%, -50%); border-radius: 50%; mix-blend-mode: screen; background: radial-gradient(closest-side, rgba(255, 244, 210, .34), rgba(255, 244, 210, .12) 55%, rgba(255, 244, 210, 0)); }
  .sr__beacon { position: absolute; width: 2.6%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; mix-blend-mode: screen; background: radial-gradient(closest-side, rgba(255, 190, 60, 1), rgba(255, 150, 20, .6) 35%, rgba(255, 140, 0, 0)); animation: srBeacon 1.1s steps(1) infinite; }

  /* Band mode (phones, tablets, small laptops): the scene is its own strip, cropped to the trucks. */
  @media (max-width: 1199px) {
    .sr--auto { width: 100%; aspect-ratio: 1870 / 700; }
    .sr--auto .sr__cv { width: calc(3000 / 1870 * 100%); left: calc(-1130 / 1870 * 100%); aspect-ratio: 3000 / 760; }
    /* tall wall keeps its own shape and rises above the strip, so a parent can stretch the scene upward behind a headline */
    .sr--auto.sr--tall .sr__bg { inset: auto 0 0 0; height: auto; aspect-ratio: 3000 / 1250; }
    .sr--auto.sr--tall .sr__bg--m { display: none; }
  }

  @keyframes srDrive { to { transform: translateX(var(--park, 0%)); } }
  @keyframes srSpin { to { transform: rotate(0deg); } }
  @keyframes srBlur { 0%, 45% { opacity: 1; } 78%, 100% { opacity: 0; } }
  @keyframes srBrake { 0% { transform: rotate(0); } 35% { transform: rotate(-.55deg); } 70% { transform: rotate(.15deg); } 100% { transform: rotate(0); } }
  @keyframes srLamp { 0%, 100% { opacity: 1; } 50% { opacity: .88; } }
  @keyframes srBeacon { 0%, 100% { opacity: 1; } 50% { opacity: .08; } }
  @media (prefers-reduced-motion: reduce) {
    .sr .sr__t { transform: translateX(var(--park, 0%)) !important; animation: none !important; }
    .sr .sr__rim { transform: none !important; animation: none !important; }
    .sr .sr__blur { opacity: 0 !important; animation: none !important; }
    .sr .sr__body, .sr .sr__lamp, .sr .sr__beacon { animation: none !important; }
  }
</style>
