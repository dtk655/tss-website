---
// Animated hero illustration for each lane closure service page. One SVG scene per slug, drawn in a
// shared top-down "plan view" language (asphalt, lane lines, cones, trucks) so the pages feel like a set.
const { slug } = Astro.props;
const W = 640, H = 440;
const d = (s) => `style="animation-delay:${s.toFixed(2)}s"`;
const cone = (x, y, t, r = 6.5) => `<g class="ss-pop" ${d(t)}><circle cx="${x}" cy="${y}" r="${r}" fill="#f26a1b"/><circle cx="${x}" cy="${y}" r="${r * .52}" fill="#fff"/><circle cx="${x}" cy="${y}" r="${r * .24}" fill="#f26a1b"/></g>`;
const car = (cls, x, y, fill, extra = '') => `<g class="${cls}" ${extra}><rect x="${x}" y="${y}" width="46" height="24" rx="7" fill="${fill}"/><rect x="${x + 27}" y="${y + 3.5}" width="9" height="17" rx="3" fill="rgba(10,12,14,.55)"/><rect x="${x + 8}" y="${y + 3.5}" width="6" height="17" rx="2.5" fill="rgba(10,12,14,.35)"/></g>`;
const diamond = (x, y, s, t, fill = '#f26a1b') => `<g class="ss-pop" ${d(t)}><rect x="${x - s / 2}" y="${y - s / 2}" width="${s}" height="${s}" rx="2.5" transform="rotate(45 ${x} ${y})" fill="${fill}" stroke="#14171a" stroke-width="1.6"/></g>`;
const label = (x, y, txt, t, anchor = 'middle') => `<text class="ss-fade ss-lab" x="${x}" y="${y}" text-anchor="${anchor}" ${d(t)}>${txt}</text>`;
const bracket = (x1, x2, y, t) => `<path class="ss-draw" pathLength="1" d="M${x1} ${y - 7}V${y}H${x2}V${y - 7}" ${d(t)}/>`;
const dashes = (y, x1 = 0, x2 = W) => `<line x1="${x1}" x2="${x2}" y1="${y}" y2="${y}" stroke="#f7f7f2" stroke-width="3" stroke-dasharray="26 22" opacity=".8"/>`;
const truck = (x, y, t, { len = 78, cab = '#c8102e', arrow = true } = {}) => `<g class="ss-pop" ${d(t)}>
  <rect x="${x}" y="${y}" width="${len}" height="30" rx="5" fill="#2b3036" stroke="#454c54"/>
  <rect x="${x + len - 24}" y="${y + 2}" width="22" height="26" rx="5" fill="${cab}"/>
  <rect x="${x + len - 12}" y="${y + 5}" width="6" height="20" rx="2" fill="rgba(10,12,14,.55)"/>
  <rect x="${x - 26}" y="${y + 3}" width="26" height="24" rx="3" fill="#f5b800"/>
  <path d="M${x - 24} ${y + 27}l8-24h5l-8 24zM${x - 13} ${y + 27}l8-24h5l-8 24z" fill="#14171a"/>
  ${arrow ? `<rect x="${x + 10}" y="${y + 5}" width="34" height="20" rx="3" fill="#0d0f11"/>` + [0, 1, 2].map((i) => `<path class="ss-chev" style="animation-delay:${i * .18}s" d="M${x + 38 - i * 9} ${y + 9}l-6 6 6 6" fill="none" stroke="#f5b800" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>`).join('') : ''}
</g>`;
const worker = (x, y, t) => `<g class="ss-pop" ${d(t)}><circle cx="${x}" cy="${y}" r="7" fill="#d6ff3d"/><circle cx="${x}" cy="${y}" r="3.2" fill="#f5b800"/></g>`;
const road = (y1, y2) => `<rect x="-10" y="${y1}" width="${W + 20}" height="${y2 - y1}" fill="#23272c"/><line x1="0" x2="${W}" y1="${y1 + 3}" y2="${y1 + 3}" stroke="#f5b800" stroke-width="3"/><line x1="0" x2="${W}" y1="${y2 - 3}" y2="${y2 - 3}" stroke="#f7f7f2" stroke-width="3"/>`;

let svg = '', cls = '';

if (slug === 'lane-and-road-closures') {
  const taper = Array.from({ length: 7 }, (_, i) => cone(150 + i * 30, 316 - i * 10.2, .5 + i * .09)).join('');
  const line = Array.from({ length: 7 }, (_, i) => cone(372 + i * 42, 255, 1.2 + i * .07)).join('');
  svg = `<g transform="translate(0 -36)">
    ${road(120, 322)}${dashes(187)}${dashes(254, 0, 150)}
    <rect class="ss-fade" ${d(1.5)} x="330" y="257" width="320" height="62" fill="url(#ss-hatch)"/>
    ${diamond(44, 352, 22, .1)}${diamond(96, 352, 22, .25)}${diamond(148, 352, 22, .4, '#f5b800')}
    ${taper}${line}
    ${truck(408, 273, 1.5)}
    ${worker(548, 280, 1.9)}${worker(578, 298, 2)}${worker(604, 276, 2.1)}
    ${car('ss-carA', -60, 141, '#e9edf1')}${car('ss-carA', -60, 141, '#8fa3b5', 'style="animation-delay:-3.1s"')}
    ${car('ss-carB', -60, 208, '#c8102e')}${car('ss-carB', -60, 208, '#e9edf1', 'style="animation-delay:-4.4s"')}
    ${car('ss-merge', -60, 275, '#f5b800')}
    ${bracket(30, 150, 398, 2.2)}${label(90, 416, 'ADVANCE WARNING', 2.3)}
    ${bracket(158, 330, 398, 2.4)}${label(244, 416, 'TAPER', 2.5)}
    ${bracket(338, 400, 398, 2.6)}${label(369, 416, 'BUFFER', 2.7)}
    ${bracket(408, 630, 398, 2.8)}${label(519, 416, 'WORK AREA', 2.9)}
    ${label(22, 104, 'RIGHT LANE CLOSURE &#183; PLAN VIEW', .2, 'start')}</g>`;
}

if (slug === 'traffic-control-plans') {
  cls = 'ss--plan';
  const cones = Array.from({ length: 7 }, (_, i) => `<circle class="ss-pop" ${d(2.3 + i * .08)} cx="${170 + i * 28}" cy="${276 - i * 9.2}" r="4.2" fill="none" stroke="#ffb27a" stroke-width="2"/>`).join('') +
    Array.from({ length: 6 }, (_, i) => `<circle class="ss-pop" ${d(2.9 + i * .07)} cx="${380 + i * 42}" cy="220" r="4.2" fill="none" stroke="#ffb27a" stroke-width="2"/>`).join('');
  const sign = (x, code, name, t) => `<g class="ss-pop" ${d(t)}><rect x="${x - 11}" y="${309}" width="22" height="22" transform="rotate(45 ${x} 320)" fill="none" stroke="#ffd166" stroke-width="2"/></g>
    <path class="ss-draw ss-thin" pathLength="1" d="M${x} 337V356" ${d(t + .15)}/>
    <text class="ss-fade ss-code" x="${x}" y="370" text-anchor="middle" ${d(t + .3)}>${code}</text>
    <text class="ss-fade ss-note" x="${x}" y="383" text-anchor="middle" ${d(t + .4)}>${name}</text>`;
  const dim = (x1, x2, y, txt, t) => `<path class="ss-draw ss-thin" pathLength="1" d="M${x1} ${y - 5}V${y + 5}M${x1} ${y}H${x2}M${x2} ${y - 5}V${y + 5}" ${d(t)}/><rect class="ss-fade" ${d(t + .25)} x="${(x1 + x2) / 2 - 15}" y="${y - 8}" width="30" height="16" fill="#0f2238"/><text class="ss-fade ss-code" x="${(x1 + x2) / 2}" y="${y + 4}" text-anchor="middle" ${d(t + .25)}>${txt}</text>`;
  svg = `
    <rect x="0" y="0" width="${W}" height="${H}" fill="#0f2238"/><rect x="0" y="0" width="${W}" height="${H}" fill="url(#ss-grid)"/>
    <rect class="ss-draw ss-frame" pathLength="1" x="14" y="14" width="${W - 28}" height="${H - 28}" ${d(0)}/>
    <path class="ss-draw ss-edge" pathLength="1" d="M26 150H614" ${d(.5)}/>
    <path class="ss-draw ss-edge" pathLength="1" d="M26 284H614" ${d(.8)}/>
    <line class="ss-fade" ${d(1.3)} x1="26" x2="614" y1="217" y2="217" stroke="#9cc4ee" stroke-width="1.6" stroke-dasharray="16 14"/>
    <path class="ss-draw ss-taper" pathLength="1" d="M170 280L338 222H614" ${d(1.6)}/>
    <rect class="ss-fade" ${d(3.3)} x="440" y="226" width="174" height="54" fill="url(#ss-bhatch)"/>
    ${cones}
    <g class="ss-pop" ${d(3.3)}><rect x="372" y="238" width="52" height="24" rx="3" fill="none" stroke="#e8f1fb" stroke-width="1.8"/><path d="M398 244l-7 6 7 6M408 244l-7 6 7 6" fill="none" stroke="#ffd166" stroke-width="1.8"/></g>
    <rect class="ss-fade" ${d(3.5)} x="492" y="246" width="70" height="16" fill="#0f2238"/><text class="ss-fade ss-note" x="527" y="257" text-anchor="middle" ${d(3.5)}>WORK AREA</text>
    ${sign(66, 'W20-1', 'ROAD WORK AHEAD', 3.6)}${sign(186, 'W20-5', 'RIGHT LANE CLOSED', 3.9)}${sign(300, 'W4-2', 'LANE ENDS', 4.2)}
    ${dim(66, 186, 126, 'A', 4.6)}${dim(186, 300, 126, 'B', 4.8)}${dim(170, 338, 104, 'L', 5)}
    <text class="ss-fade ss-note" x="402" y="108" text-anchor="middle" ${d(5.2)}>BUFFER</text><path class="ss-draw ss-thin" pathLength="1" d="M346 100V112M346 106H372M430 106H458M458 100V112" ${d(5.2)}/>
    <g class="ss-fade" ${d(5.5)}><rect x="396" y="366" width="218" height="48" fill="#0f2238" stroke="#9cc4ee" stroke-width="1.4"/><path d="M396 384H614M536 384V414" stroke="#9cc4ee" stroke-width="1"/>
      <text class="ss-code" x="406" y="379">TRAFFIC CONTROL PLAN</text><text class="ss-note" x="406" y="397">RIGHT LANE CLOSURE</text><text class="ss-note" x="406" y="408">MUTCD TYPICAL</text><text class="ss-note" x="544" y="397">SHEET 1 OF 1</text><text class="ss-note" x="544" y="408">TSS</text></g>
    <g class="ss-stamp" ${d(6.3)}><rect x="452" y="42" width="150" height="40" rx="5" fill="none" stroke="#ff5a4f" stroke-width="3"/><text x="527" y="69" text-anchor="middle">PERMIT READY</text></g>
    <g class="ss-pen"><circle r="9" fill="none" stroke="#fff" stroke-width="1.6"/><path d="M-15 0H15M0 -15V15" stroke="#fff" stroke-width="1.2"/></g>`;
}

if (slug === 'tma-protection') {
  svg = `<g transform="translate(0 -18)">
    ${road(110, 330)}${dashes(220, 0, W)}
    <rect class="ss-fade" ${d(.6)} x="180" y="224" width="470" height="102" fill="url(#ss-hatch)"/>
    ${Array.from({ length: 11 }, (_, i) => cone(190 + i * 43, 222, .3 + i * .05)).join('')}
    <g class="ss-shield">${[0, 1, 2].map((i) => `<path class="ss-ring" style="animation-delay:${i * .7}s" d="M258 236A52 52 0 0 0 258 314" fill="none" stroke="#ff5a4f" stroke-width="4" stroke-linecap="round"/>`).join('')}</g>
    ${truck(300, 260, .9, { len: 96 })}
    ${worker(498, 262, 1.4)}${worker(530, 290, 1.5)}${worker(566, 258, 1.6)}${worker(600, 286, 1.7)}
    <rect class="ss-pop" ${d(1.5)} x="470" y="300" width="44" height="16" rx="3" fill="#f5b800"/>
    ${car('ss-carA', -60, 151, '#e9edf1')}${car('ss-carA', -60, 151, '#8fa3b5', 'style="animation-delay:-3.1s"')}
    ${car('ss-swerve', -60, 262, '#c8102e')}
    ${bracket(190, 268, 368, 1.9)}${label(229, 386, 'TMA', 2)}
    ${bracket(404, 456, 368, 2.1)}${label(430, 386, 'BUFFER', 2.2)}
    ${bracket(466, 622, 368, 2.3)}${label(544, 386, 'YOUR CREW', 2.4)}
    ${label(22, 94, 'TRUCK MOUNTED ATTENUATOR &#183; PLAN VIEW', .2, 'start')}</g>`;
}

if (slug === 'flagging-operations') {
  const paddle = (x, y, a) => `<g transform="translate(${x} ${y})"><g class="ss-pad ss-pad--${a}"><path d="M-9 -22h18l13 13v18l-13 13h-18l-13 -13v-18z" fill="#c8102e" stroke="#fff" stroke-width="2.4"/><text y="5" text-anchor="middle" class="ss-padt">STOP</text></g><g class="ss-pad ss-pad--${a === 'a' ? 'b' : 'a'}"><path d="M-9 -22h18l13 13v18l-13 13h-18l-13 -13v-18z" fill="#f26a1b" stroke="#14171a" stroke-width="2.4"/><text y="5" text-anchor="middle" class="ss-padt ss-padt--d">SLOW</text></g></g>`;
  svg = `
    ${road(170, 320)}
    <line x1="0" x2="${W}" y1="245" y2="245" stroke="#f5b800" stroke-width="3" stroke-dasharray="26 22" opacity=".85"/>
    <rect class="ss-fade" ${d(.5)} x="210" y="249" width="220" height="67" fill="url(#ss-hatch)"/>
    ${Array.from({ length: 4 }, (_, i) => cone(150 + i * 20, 314 - i * 21, .2 + i * .07)).join('')}
    ${Array.from({ length: 5 }, (_, i) => cone(232 + i * 44, 248, .5 + i * .06)).join('')}
    ${Array.from({ length: 4 }, (_, i) => cone(490 - i * 20, 314 - i * 21, .8 + i * .07)).join('')}
    ${worker(300, 286, 1.1)}${worker(336, 276, 1.2)}<rect class="ss-pop" ${d(1.2)} x="352" y="288" width="42" height="16" rx="3" fill="#f5b800"/>
    ${car('ss-flagE', -70, 271, '#e9edf1')}
    <g class="ss-flagW"><rect x="700" y="196" width="46" height="24" rx="7" fill="#c8102e"/><rect x="710" y="199.5" width="9" height="17" rx="3" fill="rgba(10,12,14,.55)"/><rect x="732" y="199.5" width="6" height="17" rx="2.5" fill="rgba(10,12,14,.35)"/></g>
    ${worker(118, 340, 1.3)}${worker(522, 150, 1.4)}
    <path d="M118 249V318" stroke="#fff" stroke-width="3" opacity=".8"/><path d="M522 172V241" stroke="#fff" stroke-width="3" opacity=".8"/>
    ${paddle(118, 392, 'a')}${paddle(522, 98, 'b')}
    ${label(22, 34, 'ALTERNATING ONE-LANE TRAFFIC &#183; PLAN VIEW', .2, 'start')}
    ${label(156, 396, 'FLAGGER 1', 1.5, 'start')}${label(484, 102, 'FLAGGER 2', 1.6, 'end')}`;
}

if (slug === 'sign-and-barricade-installs') {
  const G = 330;
  const stand = (x, t, body) => `<g class="ss-rise" style="transform-origin:${x}px ${G}px;animation-delay:${t}s"><path d="M${x} ${G}V${G - 70}M${x - 16} ${G}l16-14 16 14" fill="none" stroke="#9aa5af" stroke-width="3.2" stroke-linecap="round"/>${body}</g><g class="ss-pop" ${d(t + .5)}><circle cx="${x}" cy="${G + 30}" r="10" fill="#1f7a3a"/><path d="M${x - 4.5} ${G + 30}l3.2 3.4 6-6.6" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></g>`;
  const dia = (x, fill, l1, l2) => `<rect x="${x - 34}" y="${G - 142}" width="68" height="68" rx="5" transform="rotate(45 ${x} ${G - 108})" fill="${fill}" stroke="#14171a" stroke-width="2.4"/><text class="ss-sgn" x="${x}" y="${G - 112}" text-anchor="middle">${l1}</text><text class="ss-sgn" x="${x}" y="${G - 99}" text-anchor="middle">${l2}</text>`;
  const drum = (x, t) => `<g class="ss-rise" style="transform-origin:${x}px ${G}px;animation-delay:${t}s"><path d="M${x - 11} ${G}l3-40h16l3 40z" fill="#f26a1b"/><path d="M${x - 9.6} ${G - 14}h19.2l.5 7h-20.2zM${x - 8.4} ${G - 31}h16.8l.5 7h-17.8z" fill="#fff"/><rect x="${x - 14}" y="${G - 3}" width="28" height="5" rx="2" fill="#14171a"/></g>`;
  svg = `
    <rect x="0" y="${G}" width="${W}" height="${H - G}" fill="#23272c"/><line x1="0" x2="${W}" y1="${G}" y2="${G}" stroke="#454c54" stroke-width="2"/>
    <line x1="0" x2="${W}" y1="${G + 62}" y2="${G + 62}" stroke="#f7f7f2" stroke-width="3" stroke-dasharray="26 22" opacity=".7"/>
    ${stand(78, .2, dia(78, '#f26a1b', 'ROAD WORK', 'AHEAD'))}
    ${stand(214, .7, dia(214, '#f26a1b', 'RIGHT LANE', 'CLOSED'))}
    ${drum(302, 1.2)}${drum(338, 1.3)}${drum(374, 1.4)}
    <g class="ss-rise" style="transform-origin:480px ${G}px;animation-delay:1.7s">
      <path d="M426 ${G}V${G - 96}M534 ${G}V${G - 96}M414 ${G}h24M522 ${G}h24" stroke="#9aa5af" stroke-width="4" stroke-linecap="round"/>
      ${[0, 1, 2].map((i) => `<rect x="420" y="${G - 96 + i * 30}" width="120" height="18" rx="2" fill="#fff"/><path d="${[0, 1, 2, 3, 4].map((k) => `M${428 + k * 24} ${G - 78 + i * 30}l12-18h10l-12 18z`).join('')}" fill="#f26a1b"/>`).join('')}
      <rect x="432" y="${G - 150}" width="96" height="44" rx="4" fill="#fff" stroke="#14171a" stroke-width="2.4"/><text class="ss-sgn ss-sgn--k" x="480" y="${G - 131}" text-anchor="middle">ROAD</text><text class="ss-sgn ss-sgn--k" x="480" y="${G - 115}" text-anchor="middle">CLOSED</text>
      <circle class="ss-blink" cx="426" cy="${G - 104}" r="6" fill="#f5b800"/><circle class="ss-blink" style="animation-delay:.5s" cx="534" cy="${G - 104}" r="6" fill="#f5b800"/>
    </g><g class="ss-pop" ${d(2.2)}><circle cx="480" cy="${G + 30}" r="10" fill="#1f7a3a"/><path d="M475.5 ${G + 30}l3.2 3.4 6-6.6" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></g>
    <g class="ss-rise" style="transform-origin:590px ${G}px;animation-delay:2.2s"><path d="M590 ${G}V${G - 60}M570 ${G}h40" stroke="#9aa5af" stroke-width="4" stroke-linecap="round"/><rect x="556" y="${G - 110}" width="68" height="46" rx="5" fill="#0d0f11" stroke="#454c54" stroke-width="2"/>${[0, 1, 2].map((i) => `<path class="ss-chev" style="animation-delay:${i * .18}s" d="M${612 - i * 16} ${G - 98}l-11 11 11 11" fill="none" stroke="#f5b800" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>`).join('')}</g>
    <g class="ss-pop" ${d(2.7)}><circle cx="590" cy="${G + 30}" r="10" fill="#1f7a3a"/><path d="M585.5 ${G + 30}l3.2 3.4 6-6.6" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></g>
    <g class="ss-pop" ${d(1.9)}><circle cx="338" cy="${G + 30}" r="10" fill="#1f7a3a"/><path d="M333.5 ${G + 30}l3.2 3.4 6-6.6" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></g>
    ${label(22, 34, 'DELIVERED &#183; SET &#183; CHECKED', .2, 'start')}`;
}

if (slug === 'special-events') {
  const blocks = [[20, 20, 130, 110], [176, 20, 130, 110], [332, 20, 130, 110], [488, 20, 132, 110], [20, 252, 130, 82], [176, 252, 130, 82], [332, 252, 130, 82], [488, 252, 132, 82], [20, 356, 130, 64], [176, 356, 130, 64], [332, 356, 130, 64], [488, 356, 132, 64]];
  const barr = (x, y, v, t) => `<g class="ss-pop" ${d(t)}><rect x="${v ? x - 4 : x - 12}" y="${v ? y - 12 : y - 4}" width="${v ? 8 : 24}" height="${v ? 24 : 8}" rx="2" fill="#fff"/><path d="${v ? `M${x - 4} ${y - 6}h8v5h-8zM${x - 4} ${y + 3}h8v5h-8z` : `M${x - 6} ${y - 4}h5v8h-5zM${x + 3} ${y - 4}h5v8h-5z`}" fill="#f26a1b"/></g>`;
  const crowd = Array.from({ length: 34 }, (_, i) => { const x = 30 + (i * 53) % 590, top = i % 2; return `<circle class="ss-tw" style="animation-delay:${(i % 7) * .3}s" cx="${x}" cy="${top ? 150 : 232}" r="3" fill="${['#f5b800', '#e9edf1', '#ff8a5c', '#9cc4ee'][i % 4]}"/>`; }).join('');
  svg = `
    <rect x="0" y="0" width="${W}" height="${H}" fill="#23272c"/>
    ${blocks.map(([x, y, w, h]) => `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="10" fill="#15181b" stroke="#343a40"/>`).join('')}
    <path class="ss-draw ss-route" pathLength="1" d="M-10 191H650" ${d(.4)}/>
    <path class="ss-march" d="M-10 191H650"/>
    ${crowd}
    ${barr(163, 140, 0, 1.2)}${barr(319, 140, 0, 1.3)}${barr(475, 140, 0, 1.4)}${barr(163, 242, 0, 1.5)}${barr(319, 242, 0, 1.6)}${barr(475, 242, 0, 1.7)}
    <path class="ss-fade ss-detour2" d="M-10 345H650" ${d(2)}/>
    ${[110, 270, 430, 590].map((x, i) => `<path class="ss-fade" ${d(2.2 + i * .1)} d="M${x - 7} 338l8 7-8 7" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>`).join('')}
    <g class="ss-pop" ${d(2.6)}><rect x="182" y="375" width="78" height="26" rx="4" fill="#f26a1b"/><text class="ss-sgn" x="221" y="392" text-anchor="middle">DETOUR</text></g>
    <g class="ss-pop" ${d(2.8)}><rect x="338" y="375" width="118" height="26" rx="4" fill="#fff"/><text class="ss-sgn" x="397" y="392" text-anchor="middle">ROAD CLOSED</text></g>
    <g class="ss-float">${[0, 1, 2].map((i) => `<rect x="${250 + i * 46}" y="180" width="34" height="22" rx="6" fill="${['#c8102e', '#f5b800', '#e9edf1'][i]}"/>`).join('')}</g>
    <g class="ss-pop" ${d(1)}><rect x="250" y="56" width="140" height="30" rx="6" fill="#0d0f11" stroke="#f5b800" stroke-width="1.6"/><text class="ss-lab ss-lab--g" x="320" y="76" text-anchor="middle">EVENT ROUTE</text></g>`;
}

if (slug === 'night-and-weekend-work') {
  cls = 'ss--night';
  const G = 318;
  const stars = Array.from({ length: 40 }, (_, i) => `<circle class="ss-tw" style="animation-delay:${(i % 9) * .35}s" cx="${(i * 97) % 640}" cy="${12 + (i * 53) % 190}" r="${i % 5 === 0 ? 1.8 : 1.1}" fill="#fff"/>`).join('');
  svg = `
    <rect x="0" y="0" width="${W}" height="${H}" fill="url(#ss-sky)"/><rect class="ss-dawn" x="0" y="0" width="${W}" height="${G}" fill="url(#ss-dawn)"/>
    ${stars}
    <g class="ss-moon"><circle cx="0" cy="0" r="20" fill="#fdf6d8"/><circle cx="8" cy="-6" r="17" fill="#0e1830"/></g>
    <path d="M0 ${G}l60-34 70 20 90-46 80 34 110-40 90 30 140-22V${G}z" fill="#0b1222"/>
    <rect x="0" y="${G}" width="${W}" height="${H - G}" fill="#1b1f24"/><line x1="0" x2="${W}" y1="${G + 44}" y2="${G + 44}" stroke="#f7f7f2" stroke-width="3" stroke-dasharray="26 22" opacity=".6"/>
    <g class="ss-pop" ${d(.5)}><path d="M150 ${G}V${G - 130}" stroke="#9aa5af" stroke-width="4"/><rect x="128" y="${G - 146}" width="44" height="18" rx="3" fill="#e9edf1"/><path class="ss-beam" d="M132 ${G - 128}L60 ${G}H260L168 ${G - 128}z" fill="url(#ss-beam)"/><path d="M134 ${G}h32" stroke="#9aa5af" stroke-width="5" stroke-linecap="round"/></g>
    <g class="ss-pop" ${d(.9)}><path d="M470 ${G}V${G - 54}M452 ${G}h36" stroke="#9aa5af" stroke-width="4" stroke-linecap="round"/><rect x="436" y="${G - 100}" width="68" height="46" rx="5" fill="#0d0f11" stroke="#454c54" stroke-width="2"/>${[0, 1, 2].map((i) => `<path class="ss-chev" style="animation-delay:${i * .18}s" d="M${492 - i * 16} ${G - 88}l-11 11 11 11" fill="none" stroke="#f5b800" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>`).join('')}</g>
    ${Array.from({ length: 9 }, (_, i) => `<g class="ss-rise" style="transform-origin:${230 + i * 26}px ${G + 14}px;animation-delay:${1.2 + i * .07}s"><path d="M${223 + i * 26} ${G + 14}l5-24h4l5 24z" fill="#f26a1b"/><path d="M${225.6 + i * 26} ${G + 2}h8.8l.9 4.4h-10.6z" fill="#fff"/></g>`).join('')}
    <g class="ss-pop" ${d(1.6)}><rect x="540" y="${G - 34}" width="78" height="30" rx="5" fill="#2b3036" stroke="#454c54"/><rect x="594" y="${G - 32}" width="22" height="26" rx="5" fill="#c8102e"/><circle cx="556" cy="${G}" r="7" fill="#0d0f11"/><circle cx="604" cy="${G}" r="7" fill="#0d0f11"/><circle class="ss-blink" cx="548" cy="${G - 38}" r="5" fill="#f5b800"/></g>
    <g transform="translate(60 392)"><rect x="0" y="0" width="520" height="8" rx="4" fill="rgba(255,255,255,.14)"/><rect class="ss-bar" x="0" y="0" width="520" height="8" rx="4" fill="#f5b800"/>
      ${[['SET UP', 0, 'start'], ['WORK', 260, 'middle'], ['REOPEN', 520, 'end']].map(([t, x, a]) => `<circle cx="${x}" cy="4" r="7" fill="#0e1830" stroke="#f5b800" stroke-width="2.4"/><text class="ss-lab" x="${x}" y="-12" text-anchor="${a}">${t}</text>`).join('')}</g>`;
}
---
<div class:list={['ss', cls]} data-ss>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Animated diagram of this service" preserveAspectRatio="xMidYMid slice">
    <defs>
      <pattern id="ss-hatch" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="14" height="14" fill="rgba(245,184,0,.07)"/><rect width="5" height="14" fill="rgba(245,184,0,.22)"/></pattern>
      <pattern id="ss-bhatch" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="2" height="10" fill="rgba(156,196,238,.5)"/></pattern>
      <pattern id="ss-grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" fill="none" stroke="rgba(156,196,238,.16)" stroke-width="1"/></pattern>
      <linearGradient id="ss-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#070b18"/><stop offset=".72" stop-color="#16233f"/><stop offset=".73" stop-color="#1b1f24"/></linearGradient>
      <linearGradient id="ss-dawn" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(255,150,80,0)"/><stop offset="1" stop-color="rgba(255,150,80,.7)"/></linearGradient>
      <linearGradient id="ss-beam" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(255,244,200,.55)"/><stop offset="1" stop-color="rgba(255,244,200,0)"/></linearGradient>
    </defs>
    <Fragment set:html={svg} />
  </svg>
</div>

<script is:inline>
  // scenes start when they scroll into view
  document.querySelectorAll('[data-ss]:not(.is-go)').forEach((el) => {
    if (!('IntersectionObserver' in window)) return el.classList.add('is-go');
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { el.classList.add('is-go'); io.disconnect(); } }, { threshold: .25 });
    io.observe(el);
  });
</script>

<style is:global>
  .ss { position: relative; aspect-ratio: 640 / 440; border-radius: 22px; overflow: hidden; background: #171a1e; border: 1px solid rgba(255, 255, 255, .1); box-shadow: 0 40px 80px -40px rgba(0, 0, 0, .9), inset 0 1px 0 rgba(255, 255, 255, .06); }
  .ss svg { display: block; width: 100%; height: 100%; font-family: var(--font); }
  .ss-pop, .ss-stamp, .ss-pad, .ss-ring, .ss-bar { transform-box: fill-box; }
  .ss-lab { font-size: 11px; letter-spacing: .14em; fill: rgba(255, 255, 255, .72); font-variation-settings: 'wght' 700; }
  .ss-lab--g { fill: #f5b800; }
  .ss-code { font-size: 10.5px; letter-spacing: .08em; fill: #e8f1fb; font-variation-settings: 'wght' 700; }
  .ss-note { font-size: 8.5px; letter-spacing: .1em; fill: #9cc4ee; font-variation-settings: 'wght' 600; }
  .ss-sgn { font-size: 10.5px; letter-spacing: .02em; fill: #14171a; font-variation-settings: 'wght' 800; }
  .ss-sgn--k { font-size: 14px; }
  .ss-padt { font-size: 12px; fill: #fff; font-variation-settings: 'wght' 800; }
  .ss-padt--d { fill: #14171a; }

  /* entrances wait for .is-go */
  .ss-pop { opacity: 0; transform: scale(.4); transform-origin: center; }
  .ss.is-go .ss-pop { animation: ssPop .5s cubic-bezier(.3, 1.5, .5, 1) both; }
  .ss-fade { opacity: 0; }
  .ss.is-go .ss-fade { animation: ssFade .6s ease both; }
  .ss-rise { opacity: 0; transform: scaleY(0); transform-box: view-box !important; }
  .ss.is-go .ss-rise { animation: ssRise .6s cubic-bezier(.3, 1.4, .5, 1) both; }
  .ss-draw { fill: none; stroke: rgba(255, 255, 255, .5); stroke-width: 1.6; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .ss.is-go .ss-draw { animation: ssDraw .9s cubic-bezier(.4, 0, .2, 1) both; }
  @keyframes ssPop { from { opacity: 0; transform: scale(.4); } to { opacity: 1; transform: none; } }
  @keyframes ssFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes ssRise { from { opacity: 0; transform: scaleY(0); } to { opacity: 1; transform: none; } }
  @keyframes ssDraw { to { stroke-dashoffset: 0; } }

  /* loops */
  .ss-chev { opacity: .15; animation: ssChev 1.1s linear infinite; }
  @keyframes ssChev { 0%, 100% { opacity: .15; } 30%, 60% { opacity: 1; } }
  .ss-blink { animation: ssBlink 1s steps(1) infinite; }
  @keyframes ssBlink { 50% { opacity: .15; } }
  .ss-tw { animation: ssTw 2.4s ease-in-out infinite; }
  @keyframes ssTw { 50% { opacity: .25; } }
  .ss-carA, .ss-carB, .ss-merge, .ss-swerve { transform-box: view-box !important; }
  .ss-carA { animation: ssDrive 6.2s linear infinite; }
  .ss-carB { animation: ssDrive 8.8s linear infinite; }
  @keyframes ssDrive { from { transform: translateX(0); } to { transform: translateX(780px); } }
  .ss-merge { animation: ssMerge 8.8s linear infinite; animation-delay: -1.6s; }
  @keyframes ssMerge { 0% { transform: translate(0, 0); } 22% { transform: translate(172px, 0); } 40% { transform: translate(330px, -67px); } 100% { transform: translate(860px, -67px); } }
  .ss-swerve { animation: ssSwerve 7s linear infinite; }
  @keyframes ssSwerve { 0% { transform: translate(0, 0); } 12% { transform: translate(90px, 0); } 30% { transform: translate(230px, -111px); } 100% { transform: translate(780px, -111px); } }
  .ss-ring { opacity: 0; transform-origin: 100% 50%; animation: ssRing 2.1s ease-out infinite; }
  @keyframes ssRing { 0% { opacity: .9; transform: scale(.5); } 100% { opacity: 0; transform: scale(1.5) translateX(-14px); } }

  /* flagging: 10s cycle, eastbound goes first, then westbound */
  .ss-flagE, .ss-flagW { transform-box: view-box !important; }
  .ss-flagE { animation: ssFlagE 10s linear infinite; }
  .ss-flagW { animation: ssFlagW 10s linear infinite; animation-delay: -5s; }
  @keyframes ssFlagE { 0% { transform: translate(130px, 0); } 12% { transform: translate(240px, -75px); } 30% { transform: translate(440px, -75px); } 42% { transform: translate(570px, 0); } 55% { transform: translate(800px, 0); } 55.01% { transform: translate(0, 0); } 70%, 100% { transform: translate(130px, 0); } }
  @keyframes ssFlagW { 0% { transform: translate(-140px, 0); } 40% { transform: translate(-800px, 0); } 40.01% { transform: translate(0, 0); } 60%, 100% { transform: translate(-140px, 0); } }
  .ss-pad { transform-origin: center; }
  .ss-pad--a { animation: ssPadA 10s steps(1) infinite; }
  .ss-pad--b { animation: ssPadB 10s steps(1) infinite; }
  @keyframes ssPadA { 0% { opacity: 0; } 50% { opacity: 1; } }
  @keyframes ssPadB { 0% { opacity: 1; } 50% { opacity: 0; } }

  /* events */
  .ss-route { stroke: rgba(245, 184, 0, .28); stroke-width: 46; }
  .ss-march { fill: none; stroke: #f5b800; stroke-width: 3; stroke-dasharray: 14 12; animation: ssMarch 1.2s linear infinite; }
  @keyframes ssMarch { to { stroke-dashoffset: -26; } }
  .ss-detour { stroke: #fff; stroke-width: 3; }
  .ss-detour2 { fill: none; stroke: rgba(255, 255, 255, .5); stroke-width: 2.4; stroke-dasharray: 5 9; }
  .ss-detour.ss-draw { stroke-dasharray: 1; }
  .ss-float { transform-box: view-box !important; animation: ssFloat 9s linear infinite; }
  @keyframes ssFloat { from { transform: translateX(-420px); } to { transform: translateX(420px); } }

  /* plan */
  .ss--plan { background: #0f2238; }
  .ss-frame { stroke: #9cc4ee; stroke-width: 1.4; }
  .ss-edge { stroke: #e8f1fb; stroke-width: 2.6; }
  .ss-taper { stroke: #ffb27a; stroke-width: 2; }
  .ss-thin { stroke: #9cc4ee; stroke-width: 1.2; }
  .ss-stamp { opacity: 0; transform-origin: center; }
  .ss-stamp text { font-size: 17px; letter-spacing: .12em; fill: #ff5a4f; font-variation-settings: 'wght' 800; }
  .ss.is-go .ss-stamp { animation: ssStamp .5s cubic-bezier(.3, 1.6, .5, 1) both; }
  @keyframes ssStamp { from { opacity: 0; transform: rotate(-8deg) scale(2.2); } to { opacity: 1; transform: rotate(-8deg) scale(1); } }
  .ss-pen { opacity: 0; transform-box: view-box !important; }
  .ss.is-go .ss-pen { animation: ssPen 6.4s cubic-bezier(.5, 0, .3, 1) both; }
  @keyframes ssPen {
    0% { opacity: 0; transform: translate(26px, 150px); } 6% { opacity: 1; transform: translate(26px, 150px); } 16% { transform: translate(614px, 150px); } 20% { transform: translate(614px, 284px); }
    26% { transform: translate(170px, 280px); } 36% { transform: translate(338px, 222px); } 44% { transform: translate(614px, 222px); } 56% { transform: translate(66px, 320px); }
    64% { transform: translate(300px, 320px); } 74% { transform: translate(210px, 126px); } 84% { transform: translate(505px, 390px); } 94% { opacity: 1; transform: translate(527px, 62px); } 100% { opacity: 0; transform: translate(527px, 62px); }
  }

  /* night: 14s cycle from dusk to dawn */
  .ss-moon { transform-box: view-box !important; animation: ssMoon 14s linear infinite; }
  @keyframes ssMoon { 0% { transform: translate(40px, 210px); } 50% { transform: translate(320px, 50px); } 100% { transform: translate(600px, 210px); } }
  .ss-dawn { opacity: 0; animation: ssDawn 14s linear infinite; }
  @keyframes ssDawn { 0% { opacity: .5; } 12%, 80% { opacity: 0; } 100% { opacity: .9; } }
  .ss-bar { transform-origin: 0 50%; animation: ssBar 14s linear infinite; }
  @keyframes ssBar { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .ss-beam { animation: ssTw 3s ease-in-out infinite; }

  @media (prefers-reduced-motion: reduce) {
    .ss * { animation: none !important; }
    .ss-pop, .ss-fade, .ss-rise, .ss-stamp { opacity: 1 !important; transform: none !important; }
    .ss-stamp { transform: rotate(-8deg) !important; }
    .ss-draw { stroke-dashoffset: 0 !important; }
    .ss-pen, .ss-carA, .ss-carB, .ss-merge, .ss-swerve, .ss-flagE, .ss-flagW, .ss-float { display: none; }
  }
</style>
