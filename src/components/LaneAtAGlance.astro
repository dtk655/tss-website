---
// Service explorer: numbered list on the left, a large photo panel on the right that changes with the selected service.
const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const services = [
  { t: 'Lane and road closures', s: 'Single lane to full detour', img: CDN + 'thumbnail_IMG_7041_98e15159-1e86-4b04-9da2-0308665c2a89.jpg', pos: '50% 45%',
    more: ['Single, double and full closures', 'Lane shifts and detours', 'Set to MUTCD and agency drawings'], href: '/tools/lane-closure-plan?work=right', cta: 'Plan a closure' },
  { t: 'Flagging operations', s: 'ATSSA-certified flaggers', img: CDN + 'thumbnail_IMG_0308.jpg', pos: '50% 60%',
    more: ['One-lane, two-way traffic', 'Intersections and driveways', 'STOP/SLOW paddles and radios'], href: '/tools/lane-closure-plan?work=flagging', cta: 'Plan a flagging job' },
  { t: 'TMA protection', s: 'Crash trucks and certified operators', img: CDN + 'thumbnail_IMG_1133_c2839bba-db54-470f-80d2-804e82e3fd23.jpg', pos: '50% 50%',
    more: ['Truck-mounted attenuators', 'Arrow boards on every truck', 'Certified TMA operators'], href: '/pages/request-a-quote?type=lane-closure', cta: 'Book a TMA' },
  { t: 'Night and weekend work', s: 'Off-peak closure windows', img: '/fleet/tma-dusk.jpg', pos: '50% 55%',
    more: ['Light towers and lit devices', 'Overnight setup and pickup', 'Authority closure hours met'], href: '/tools/lane-closure-plan?work=right', cta: 'Plan night work' },
  { t: 'Sign and barricade installs', s: 'Delivered, installed and maintained', img: CDN + 'thumbnail_IMG_0081_1209517d-0120-4e7d-b1dd-18ee0f120532.jpg', pos: '50% 50%',
    more: ['Work zone and detour signs', 'Type III barricades and drums', 'Maintained for the life of the job'], href: '/pages/request-a-quote?type=lane-closure', cta: 'Request an install' },
  { t: 'Traffic control plans', s: 'Permit-ready drawings', img: '/fleet/lc-hero.webp', pos: '55% 45%',
    more: ['Drawn by certified traffic experts', 'Built to MUTCD and agency standards', 'Ready for your permit submission'], href: '/tools/lane-closure-plan', cta: 'Start with a free plan' },
  { t: 'Special events', s: 'Parades, races and game days', img: CDN + 'Water-Filled-Barricades-In-Use-3-1.png', pos: '50% 50%',
    more: ['Road closures and detours', 'Barricades and crowd control', 'Planned with towns and police'], href: '/pages/request-a-quote?type=lane-closure', cta: 'Reserve a crew' },
  { t: 'Emergency response', s: 'For account customers', img: CDN + 'tss.jpg', pos: '50% 55%',
    more: ['Water main breaks', 'Downed lines and incidents', 'Rapid setup, around the clock'], href: '/pages/create-c-m-account', cta: 'Open an account' }
];
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const CHK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section class="sx" data-sx>
  <div class="wrap">
    <div class="sx__head">
      <p class="sx__k"><span></span>What our crews handle</p>
      <h2>Every kind of closure. <em>One call.</em></h2>
    </div>

    <div class="sx__grid">
      <ol class="sx__list" role="tablist" aria-label="Services">
        {services.map((s, i) => (
          <li>
            <button type="button" role="tab" class:list={['sx__item', i === 0 && 'is-on']} aria-selected={i === 0 ? 'true' : 'false'} data-i={i} style={`--d:${i}`}>
              <span class="sx__n">0{i + 1}</span>
              <span class="sx__tt"><b>{s.t}</b><small>{s.s}</small></span>
              <span class="sx__arr" set:html={ARROW} />
              <i class="sx__bar" aria-hidden="true"></i>
            </button>
            <div class="sx__m" aria-hidden="true">
              <div class="sx__min">
                <div class="sx__mimg"><img src={s.img} alt="" style={`object-position:${s.pos}`} loading="lazy" /></div>
                <ul>{s.more.map((m) => <li><i set:html={CHK} />{m}</li>)}</ul>
                <a href={s.href} class="sx__mcta" tabindex="-1">{s.cta}<Fragment set:html={ARROW} /></a>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <div class="sx__stage">
        {services.map((s, i) => (
          <article class:list={['sx__panel', i === 0 && 'is-on']} data-p={i} aria-hidden={i === 0 ? 'false' : 'true'}>
            <img src={s.img} alt="" style={`object-position:${s.pos}`} loading={i === 0 ? 'eager' : 'lazy'} />
            <span class="sx__shade" aria-hidden="true"></span>
            <div class="sx__card">
              <p class="sx__cn">0{i + 1} / 0{services.length}</p>
              <h3>{s.t}</h3>
              <ul>{s.more.map((m, k) => <li style={`--k:${k}`}><i set:html={CHK} />{m}</li>)}</ul>
              <a href={s.href} class="sx__cta" tabindex={i === 0 ? 0 : -1}>{s.cta}<Fragment set:html={ARROW} /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .sx { padding: clamp(56px, 7vw, 104px) 0; background: #fff; }
  .sx__head { margin-bottom: clamp(28px, 3.4vw, 48px); }
  .sx__k { display: flex; align-items: center; gap: 12px; margin: 0 0 14px; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; font-variation-settings: 'wght' 680; color: var(--steel); }
  .sx__k span { width: 34px; height: 3px; border-radius: 2px; background: var(--red); }
  .sx h2 { margin: 0; font-size: clamp(2.2rem, 4.6vw, 4.2rem); line-height: .98; letter-spacing: -.04em; font-variation-settings: 'wght' 780; }
  .sx h2 em { font-style: normal; color: var(--red); }

  .sx__grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.25fr); gap: clamp(24px, 3.4vw, 56px); align-items: stretch; }
  .sx__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .sx__list > li { border-bottom: 1px solid var(--line); display: flex; flex-direction: column; }
  .sx__m { display: none; }
  @media (min-width: 1001px) { .sx__list { display: flex; flex-direction: column; } .sx__list li { flex: 1; } .sx__item { height: 100%; } }
  .sx__item { all: unset; box-sizing: border-box; position: relative; cursor: pointer; width: 100%; display: grid; grid-template-columns: 42px 1fr 24px; align-items: center; gap: 10px; padding: clamp(16px, 1.6vw, 22px) 4px; opacity: 0; transform: translateY(14px); transition: opacity .6s, transform .6s cubic-bezier(.2,.8,.2,1); transition-delay: calc(var(--d) * 70ms); }
  .sx.is-in .sx__item { opacity: 1; transform: none; }
  .sx__item:focus-visible { outline: 3px solid rgba(182,6,6,.35); outline-offset: 2px; border-radius: 8px; }
  .sx__n { font-size: .8rem; letter-spacing: .1em; font-variation-settings: 'wght' 720; color: #b8bec5; transition: color .3s; }
  .sx__tt b { display: block; font-size: clamp(1.15rem, 1.6vw, 1.5rem); line-height: 1.15; letter-spacing: -.02em; font-variation-settings: 'wght' 700; color: #8a939c; transition: color .3s, transform .45s cubic-bezier(.2,.8,.2,1); }
  .sx__tt small { display: block; max-height: 0; overflow: hidden; opacity: 0; margin-top: 0; font-size: .9rem; color: var(--steel); transition: max-height .45s cubic-bezier(.2,.8,.2,1), opacity .35s, margin .35s; }
  .sx__arr { color: var(--red); opacity: 0; transform: translateX(-8px); transition: opacity .3s, transform .35s cubic-bezier(.2,.8,.2,1); }
  .sx__arr :global(svg) { width: 22px; height: 22px; display: block; }
  .sx__item:hover .sx__tt b { color: var(--ink); }
  .sx__item.is-on .sx__n { color: var(--red); }
  .sx__item.is-on .sx__tt b { color: var(--ink); transform: translateX(4px); }
  .sx__item.is-on .sx__tt small { max-height: 2em; opacity: 1; margin-top: 4px; }
  .sx__item.is-on .sx__arr { opacity: 1; transform: none; }
  .sx__bar { position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; background: var(--red); transform: scaleX(0); transform-origin: left; }
  .sx__item.is-on .sx__bar { animation: sxBar var(--sx-t, 5200ms) linear forwards; }
  .sx.is-paused .sx__item.is-on .sx__bar { animation: none; transform: scaleX(1); }
  @keyframes sxBar { to { transform: scaleX(1); } }

  .sx__stage { position: relative; min-height: clamp(440px, 40vw, 600px); border-radius: 24px; overflow: hidden; background: #111; isolation: isolate; opacity: 0; transform: translateY(20px) scale(.985); transition: opacity .8s .15s, transform .9s .15s cubic-bezier(.2,.8,.2,1); }
  .sx.is-in .sx__stage { opacity: 1; transform: none; }
  .sx__panel { position: absolute; inset: 0; visibility: hidden; }
  .sx__panel.is-on { visibility: visible; z-index: 1; }
  .sx__panel img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; clip-path: inset(0 0 0 100%); transform: scale(1.12); transition: clip-path .9s cubic-bezier(.7,0,.2,1), transform 6s ease-out; }
  .sx__panel.is-on img { clip-path: inset(0 0 0 0); transform: scale(1); }
  .sx__panel.is-out { visibility: visible; z-index: 0; }
  .sx__panel.is-out img { clip-path: inset(0 0 0 0); transform: scale(1.03); }
  .sx__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,9,11,0) 35%, rgba(8,9,11,.78) 100%); }
  .sx__card { position: absolute; left: clamp(16px, 2vw, 28px); right: clamp(16px, 2vw, 28px); bottom: clamp(16px, 2vw, 28px); max-width: 460px; padding: clamp(20px, 2vw, 28px); border-radius: 18px; color: #fff; background: rgba(12,13,15,.5); border: 1px solid rgba(255,255,255,.18); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2); opacity: 0; transform: translateY(18px); transition: opacity .5s, transform .6s cubic-bezier(.2,.8,.2,1); }
  .sx__panel.is-on .sx__card { opacity: 1; transform: none; transition-delay: .45s; }
  .sx__cn { margin: 0 0 8px; font-size: .74rem; letter-spacing: .16em; font-variation-settings: 'wght' 700; color: rgba(255,255,255,.6); }
  .sx__card h3 { margin: 0 0 14px; color: #fff; font-size: clamp(1.4rem, 2vw, 1.9rem); line-height: 1.05; letter-spacing: -.025em; font-variation-settings: 'wght' 780; }
  .sx__card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .sx__card li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: center; font-size: .97rem; color: rgba(255,255,255,.9); opacity: 0; transform: translateX(-8px); transition: opacity .4s, transform .5s cubic-bezier(.2,.8,.2,1); }
  .sx__panel.is-on .sx__card li { opacity: 1; transform: none; transition-delay: calc(.65s + var(--k) * 90ms); }
  .sx__card li i { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--red); }
  .sx__card li i :global(svg) { width: 12px; height: 12px; }
  .sx__cta { display: inline-flex; align-items: center; gap: 10px; margin-top: 18px; padding: 12px 20px 11px; border-radius: 999px; background: #fff; color: var(--ink); font-size: .96rem; font-variation-settings: 'wght' 700; text-decoration: none; transition: background .2s, color .2s; }
  .sx__cta :global(svg) { width: 17px; height: 17px; transition: transform .2s; }
  .sx__cta:hover { background: var(--red); color: #fff; }
  .sx__cta:hover :global(svg) { transform: translateX(3px); }

  @media (max-width: 1000px) {
    .sx__grid { grid-template-columns: 1fr; }
    .sx__stage { order: -1; min-height: 420px; }
  }
  @media (max-width: 640px) {
    .sx__head { text-align: center; }
    .sx__k { justify-content: center; }
    .sx h2 { font-size: 2rem; }
    .sx h2 em { display: block; }
    .sx__stage { display: none; }
    .sx__list { border-top-color: var(--line); }
    .sx__m { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .45s cubic-bezier(.2,.8,.2,1); }
    .sx__list > li:has(.sx__item.is-on) .sx__m { grid-template-rows: 1fr; }
    .sx__min { overflow: hidden; min-height: 0; }
    .sx__mimg { position: relative; aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden; background: #111; margin: 2px 0 14px; }
    .sx__mimg img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); transition: transform 1.2s cubic-bezier(.2,.8,.2,1); }
    .sx__list > li:has(.sx__item.is-on) .sx__mimg img { transform: scale(1); }
    .sx__m ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
    .sx__m li { display: grid; grid-template-columns: 20px 1fr; gap: 10px; align-items: center; font-size: .92rem; color: var(--ink-2); }
    .sx__m li i { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--red); color: #fff; }
    .sx__m li i :global(svg) { width: 11px; height: 11px; }
    .sx__mcta { display: inline-flex; align-items: center; gap: 8px; margin: 16px 0 18px; padding: 11px 18px 10px; border-radius: 999px; background: var(--ink); color: #fff; font-size: .9rem; font-variation-settings: 'wght' 700; text-decoration: none; }
    .sx__mcta :global(svg) { width: 16px; height: 16px; }
    .sx__item.is-on .sx__arr { transform: rotate(90deg); }
    .sx__bar { display: none; }
    .sx__stage { min-height: 380px; border-radius: 18px; }
    .sx__card { padding: 16px; border-radius: 14px; }
    .sx__card h3 { font-size: 1.3rem; margin-bottom: 10px; }
    .sx__card li { font-size: .88rem; }
    .sx__cta { margin-top: 14px; font-size: .9rem; }
    .sx__item { grid-template-columns: 32px 1fr 20px; padding: 14px 2px; }
    .sx__tt b { font-size: 1.08rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sx__item, .sx__stage, .sx__card, .sx__card li { opacity: 1; transform: none; transition: none; }
    .sx__panel img { transition: none; }
    .sx__bar { animation: none !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-sx]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('[data-i]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-p]')];
    const T = 5200;
    root.style.setProperty('--sx-t', T + 'ms');
    let i = 0, timer = 0, resume = 0, visible = false;
    const show = (n: number) => {
      if (n === i) return;
      panels.forEach((p) => p.classList.remove('is-out'));
      panels[i].classList.add('is-out'); panels[i].classList.remove('is-on');
      panels[i].setAttribute('aria-hidden', 'true'); panels[i].querySelector('a')?.setAttribute('tabindex', '-1');
      const old = panels[i];
      setTimeout(() => old.classList.remove('is-out'), 950);
      i = n;
      panels[i].classList.add('is-on'); panels[i].setAttribute('aria-hidden', 'false'); panels[i].querySelector('a')?.setAttribute('tabindex', '0');
      items.forEach((b, k) => { b.classList.toggle('is-on', k === i); b.setAttribute('aria-selected', String(k === i)); const m = b.parentElement?.querySelector('.sx__m'); m?.setAttribute('aria-hidden', String(k !== i)); m?.querySelector('a')?.setAttribute('tabindex', k === i ? '0' : '-1'); });
    };
    const start = () => { if (!timer && visible && !root.classList.contains('is-paused') && !matchMedia('(max-width: 640px)').matches) timer = window.setInterval(() => show((i + 1) % items.length), T); };
    const stop = () => { clearInterval(timer); timer = 0; };
    const pick = (n: number) => {
      stop(); root.classList.add('is-paused'); show(n);
      clearTimeout(resume); resume = window.setTimeout(() => { root.classList.remove('is-paused'); const b = items[i].querySelector<HTMLElement>('.sx__bar'); if (b) { b.style.animation = 'none'; void b.offsetWidth; b.style.animation = ''; } start(); }, 12000);
    };
    items.forEach((b, k) => {
      b.addEventListener('click', () => { pick(k); if (matchMedia('(max-width: 640px)').matches) setTimeout(() => b.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 470); });
      b.addEventListener('mouseenter', () => { if (matchMedia('(hover: hover) and (min-width: 1001px)').matches) pick(k); });
    });
    root.addEventListener('keydown', (e) => {
      const k = items.indexOf(document.activeElement as HTMLElement);
      if (k < 0) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); const n = (k + (e.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length; items[n].focus(); pick(n); }
    });
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    new IntersectionObserver(([en]) => {
      visible = en.isIntersecting;
      if (visible) { root.classList.add('is-in'); if (!reduce) start(); } else stop();
    }, { threshold: 0.25 }).observe(root);
  });
</script>
