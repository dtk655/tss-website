---
// "Buy it or rent it": a Buy/Rent switch that flips the same lineup of gear between the two ways to get it.
const gear = [
  { t: 'Cones', img: '/cats/cones.svg' },
  { t: 'WATERCADE', img: '/cats/water-filled-barriers.png' },
  { t: 'Message boards', img: '/cats/hero-rentals.png', big: true },
  { t: 'Drums', img: '/cats/traffic-drums.svg' },
  { t: 'Barricades', img: '/cats/barricades.png' }
];
const modes = {
  buy: { pts: [['Ships nationwide', 'Anywhere in the U.S.'], ['No minimum', 'One cone or a truckload'], ['Yours to keep', 'Stock your own yard']], cta: ['Shop products', '/collections'] },
  rent: { pts: [['Delivered from our yard', 'NJ, NY, PA and CT'], ['By the day, week or job', 'Pay only while you use it'], ['Picked up after', 'Nothing to store']], cta: ['Request a rental', '/pages/request-a-quote?type=rental'] }
};
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section class="br" data-br data-mode="buy">
  <div class="wrap">
    <div class="br__top">
      <div>
        <p class="br__k"><span></span>Buy or rent</p>
        <h2>Everything we sell, <em>we also rent.</em></h2>
      </div>
      <div class="br__switch" role="tablist" aria-label="Buy or rent">
        <i class="br__thumb" aria-hidden="true"></i>
        <button type="button" role="tab" aria-selected="true" data-set="buy">Buy</button>
        <button type="button" role="tab" aria-selected="false" data-set="rent">Rent</button>
      </div>
    </div>

    <div class="br__panel">
      <div class="br__stage" aria-hidden="true">
        <span class="br__word br__word--buy">BUY</span>
        <span class="br__word br__word--rent">RENT</span>
        <ul class="br__gear">
          {gear.map((g, i) => (
            <li class:list={[g.big && 'is-big']} style={`--i:${i}`}>
              <img src={g.img} alt="" loading="lazy" />
              <span class="br__tag"><b class="br__tag--buy">Buy</b><b class="br__tag--rent">Rent</b><span class="br__tn">{g.t}</span></span>
            </li>
          ))}
        </ul>
      </div>

      <div class="br__info">
        {Object.entries(modes).map(([k, m]) => (
          <div class={`br__mode br__mode--${k}`} data-mode-panel={k}>
            <ol>
              {m.pts.map(([b, s], j) => <li style={`--j:${j}`}><span class="br__n">0{j + 1}</span><span><b>{b}</b><small>{s}</small></span></li>)}
            </ol>
            <a href={m.cta[1]} class="br__cta">{m.cta[0]}<Fragment set:html={ARROW} /></a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .br { padding: clamp(56px, 7vw, 100px) 0; background: #fff; }
  .br__top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 40px; margin-bottom: clamp(24px, 3vw, 40px); }
  .br__k { display: flex; align-items: center; gap: 12px; margin: 0 0 14px; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; font-variation-settings: 'wght' 680; color: var(--steel); }
  .br__k span { width: 34px; height: 3px; border-radius: 2px; background: var(--red); }
  .br h2 { margin: 0; font-size: clamp(2.2rem, 4.6vw, 4.2rem); line-height: .98; letter-spacing: -.04em; font-variation-settings: 'wght' 780; }
  .br h2 em { font-style: normal; color: var(--red); }

  .br__switch { position: relative; display: grid; grid-template-columns: 1fr 1fr; padding: 6px; border-radius: 999px; background: var(--haze); border: 1px solid var(--line); min-width: 260px; }
  .br__switch button { all: unset; position: relative; z-index: 1; cursor: pointer; text-align: center; padding: 14px 28px 13px; font-size: 1.05rem; font-variation-settings: 'wght' 720; color: var(--steel); transition: color .35s; border-radius: 999px; }
  .br__switch button:focus-visible { outline: 3px solid rgba(182,6,6,.35); outline-offset: 2px; }
  .br__switch button[aria-selected="true"] { color: #fff; }
  .br__thumb { position: absolute; top: 6px; bottom: 6px; left: 6px; width: calc(50% - 6px); border-radius: 999px; background: var(--ink); box-shadow: 0 10px 20px -10px rgba(20,23,26,.6); transition: transform .5s cubic-bezier(.2,.8,.2,1), background .4s; }
  [data-mode="rent"] .br__thumb { transform: translateX(100%); background: var(--red); }

  .br__panel { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); border-radius: 26px; overflow: hidden; border: 1px solid var(--line); background: #fff; box-shadow: 0 40px 80px -60px rgba(20,23,26,.5); }

  .br__stage { position: relative; overflow: hidden; min-height: clamp(300px, 26vw, 400px); background: radial-gradient(120% 120% at 50% 100%, #ffffff 0, #f1f3f5 55%, #e7eaed 100%); transition: background .6s; }
  [data-mode="rent"] .br__stage { background: radial-gradient(120% 120% at 50% 100%, #ffffff 0, #fbefed 55%, #f6dfdb 100%); }
  .br__word { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-size: clamp(7rem, 17vw, 15rem); line-height: 1; letter-spacing: -.06em; font-variation-settings: 'wght' 860; color: rgba(20,23,26,.05); white-space: nowrap; transition: opacity .5s, transform .7s cubic-bezier(.2,.8,.2,1); pointer-events: none; }
  .br__word--rent { color: rgba(182,6,6,.07); opacity: 0; transform: translate(-50%, -30%); }
  [data-mode="rent"] .br__word--buy { opacity: 0; transform: translate(-50%, -70%); }
  [data-mode="rent"] .br__word--rent { opacity: 1; transform: translate(-50%, -50%); }

  .br__gear { position: absolute; left: 0; right: 0; bottom: 0; top: 0; align-content: center; list-style: none; margin: 0; padding: clamp(18px, 2vw, 26px) clamp(14px, 2vw, 28px); display: grid; grid-template-columns: 1fr 1.15fr 1.7fr 1fr 1.15fr; align-items: end; gap: clamp(6px, 1vw, 14px); }
  .br__gear li { position: relative; display: grid; justify-items: center; gap: 12px; opacity: 0; transform: translateY(26px); transition: opacity .7s, transform .8s cubic-bezier(.2,.8,.2,1); transition-delay: calc(var(--i) * 80ms); }
  .br.is-in .br__gear li { opacity: 1; transform: none; }
  .br__gear img { width: 100%; max-height: clamp(130px, 16.5vw, 260px); object-fit: contain; object-position: bottom; filter: drop-shadow(0 18px 14px rgba(20,23,26,.2)); }
  .br__gear li.is-big img { max-height: clamp(170px, 23vw, 340px); }
  .br__gear li { animation: brBob 5s ease-in-out infinite; animation-delay: calc(var(--i) * -.9s); }
  @keyframes brBob { 50% { translate: 0 -5px; } }
  .br__tag { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px 5px 5px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-size: .76rem; font-variation-settings: 'wght' 650; color: var(--ink-2); white-space: nowrap; box-shadow: 0 8px 18px -12px rgba(20,23,26,.4); }
  .br__tag b { display: none; padding: 3px 8px 2px; border-radius: 999px; color: #fff; font-size: .64rem; letter-spacing: .08em; text-transform: uppercase; font-variation-settings: 'wght' 780; }
  .br__tag--buy { background: var(--ink); }
  .br__tag--rent { background: var(--red); }
  [data-mode="buy"] .br__tag--buy, [data-mode="rent"] .br__tag--rent { display: inline-block; animation: brPop .45s cubic-bezier(.2,.8,.2,1.6) both; animation-delay: calc(var(--i) * 70ms); }
  @keyframes brPop { from { transform: scale(.4); opacity: 0; } to { transform: none; opacity: 1; } }

  .br__info { position: relative; display: grid; padding: clamp(24px, 2.6vw, 40px); border-left: 1px solid var(--line); }
  .br__mode { grid-area: 1 / 1; display: flex; flex-direction: column; justify-content: center; gap: 20px; visibility: hidden; }
  [data-mode="buy"] .br__mode--buy, [data-mode="rent"] .br__mode--rent { visibility: visible; }
  .br__mode ol { list-style: none; margin: 0; padding: 0; display: grid; }
  .br__mode li { display: grid; grid-template-columns: 38px 1fr; gap: 10px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--line); opacity: 0; transform: translateY(14px); transition: opacity .35s, transform .45s cubic-bezier(.2,.8,.2,1); }
  .br__mode li:first-child { border-top: 1px solid var(--line); }
  [data-mode="buy"] .br__mode--buy li, [data-mode="rent"] .br__mode--rent li { opacity: 1; transform: none; transition-delay: calc(.12s + var(--j) * 90ms); }
  .br__n { font-size: .8rem; letter-spacing: .1em; font-variation-settings: 'wght' 760; color: var(--red); }
  .br__mode b { display: block; font-size: clamp(1.15rem, 1.5vw, 1.4rem); line-height: 1.15; letter-spacing: -.02em; font-variation-settings: 'wght' 740; }
  .br__mode small { display: block; margin-top: 3px; font-size: .92rem; color: var(--steel); }
  .br__cta { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: fit-content; padding: 15px 26px 14px; border-radius: 999px; color: #fff; font-size: 1.02rem; font-variation-settings: 'wght' 700; text-decoration: none; opacity: 0; transform: translateY(10px); transition: opacity .35s, transform .45s, background .2s; }
  .br__mode--buy .br__cta { background: var(--ink); }
  .br__mode--rent .br__cta { background: var(--red); }
  [data-mode="buy"] .br__mode--buy .br__cta, [data-mode="rent"] .br__mode--rent .br__cta { opacity: 1; transform: none; transition-delay: .42s; }
  .br__cta :global(svg) { width: 18px; height: 18px; transition: transform .2s; }
  .br__cta:hover :global(svg) { transform: translateX(3px); }

  @media (max-width: 1000px) {
    .br__panel { grid-template-columns: 1fr; }
    .br__info { border-left: 0; border-top: 1px solid var(--line); }
  }
  @media (max-width: 640px) {
    .br__top { flex-direction: column; align-items: stretch; text-align: center; gap: 18px; }
    .br__k { justify-content: center; }
    .br h2 { font-size: 2rem; }
    .br h2 em { display: block; }
    .br__switch { min-width: 0; }
    .br__switch button { padding: 12px 0 11px; }
    .br__panel { border-radius: 20px; }
    .br__stage { min-height: 0; height: 205px; }
    .br__gear { grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 14px 10px; }
    .br__gear li:nth-child(3), .br__gear li:nth-child(5) { display: none; }
    .br__gear img { max-height: 130px; }
    .br__gear li.is-big img { max-height: 150px; }
    .br__tag { font-size: .7rem; padding: 3px; }
    .br__tn { display: none; }
    .br__info { padding: 18px 18px 22px; }
    .br__mode { gap: 16px; }
    .br__mode li { padding: 12px 0; grid-template-columns: 30px 1fr; }
    .br__mode b { font-size: 1.08rem; }
    .br__mode small { font-size: .85rem; }
    .br__cta { width: 100%; box-sizing: border-box; }
  }
  @media (prefers-reduced-motion: reduce) {
    .br__gear li, .br__mode li, .br__cta, .br__word { transition: none; animation: none; opacity: 1; transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-br]').forEach((root) => {
    const btns = [...root.querySelectorAll<HTMLElement>('[data-set]')];
    let timer = 0, resume = 0, visible = false;
    const set = (m: string) => {
      root.dataset.mode = m;
      btns.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.set === m)));
      root.querySelectorAll<HTMLElement>('[data-mode-panel]').forEach((p) => {
        const on = p.dataset.modePanel === m;
        p.setAttribute('aria-hidden', String(!on));
        p.querySelector('a')?.setAttribute('tabindex', on ? '0' : '-1');
      });
    };
    const start = () => { if (!timer && visible) timer = window.setInterval(() => set(root.dataset.mode === 'buy' ? 'rent' : 'buy'), 4500); };
    const stop = () => { clearInterval(timer); timer = 0; };
    btns.forEach((b) => b.addEventListener('click', () => {
      stop(); set(b.dataset.set!);
      clearTimeout(resume); resume = window.setTimeout(start, 12000);
    }));
    set('buy');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    new IntersectionObserver(([en]) => {
      visible = en.isIntersecting;
      if (visible) { root.classList.add('is-in'); if (!reduce) start(); } else stop();
    }, { threshold: 0.3 }).observe(root);
  });
</script>
