---
// "Buy it or rent it" band: rows of equipment with Buy and Rent check marks that tick on in sequence.
const rows = [
  ['Traffic cones', 'cone'],
  ['WATERCADE barriers', 'barrier'],
  ['Barricades and drums', 'drum'],
  ['Signs and stands', 'sign'],
  ['TMA crash trucks', 'truck'],
  ['VMS message boards', 'vms'],
  ['Arrow boards and light towers', 'arrow']
];
const I: Record<string, string> = {
  cone: '<path d="M9.5 4h5l3.6 14H5.9z"/><path d="M8.4 9.5h7.2M7.2 14h9.6"/><path d="M3.5 20.5h17"/>',
  barrier: '<path d="M3 17l2-8h14l2 8z"/><path d="M8 9l-1 8M16 9l1 8"/><path d="M3 17h18"/>',
  drum: '<path d="M7 4h10l1 16H6z"/><path d="M6.5 9h11M6.3 14h11.4"/>',
  sign: '<path d="M12 2.5l8 8-8 8-8-8z"/><path d="M12 18.5v3"/>',
  truck: '<path d="M2.5 6.5h11v10h-11z"/><path d="M13.5 9.5h4l3.5 3.5v3.5h-7.5"/><circle cx="6.5" cy="17.5" r="2"/><circle cx="17" cy="17.5" r="2"/>',
  vms: '<rect x="3" y="4" width="18" height="10" rx="1.5"/><path d="M7 8h4M7 11h7M12 14v4M8 21l4-3 4 3"/>',
  arrow: '<rect x="3" y="5" width="18" height="10" rx="1.5"/><path d="M8 10h8M13 7.5l3 2.5-3 2.5"/><path d="M12 15v5"/>'
};
const CHK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12.5l4 4L18 8"/></svg>';
---
<section class="br" data-br>
  <div class="wrap br__in">
    <div class="br__copy">
      <p class="br__k">Buy or rent</p>
      <h2>Everything we sell, <span>we also rent.</span></h2>
      <p class="br__lede">Own it for the long haul or rent it by the job. Same gear, same yard, one invoice.</p>
      <ul class="br__notes">
        <li><b>Buy</b> Ships nationwide</li>
        <li><b>Rent</b> <span class="br__long">Delivered in&nbsp;</span>NJ, NY, PA, CT</li>
      </ul>
    </div>

    <div class="br__card" role="table" aria-label="Products and equipment available to buy and to rent">
      <div class="br__row br__row--head" role="row">
        <span role="columnheader">Equipment</span>
        <span role="columnheader" class="br__col">Buy</span>
        <span role="columnheader" class="br__col">Rent</span>
      </div>
      {rows.map(([t, ic], i) => (
        <div class="br__row" role="row" style={`--i:${i}`}>
          <span role="cell" class="br__item"><i aria-hidden="true"><svg viewBox="0 0 24 24" set:html={I[ic]} /></i>{t}</span>
          <span role="cell" class="br__col"><span class="br__chk br__chk--buy" aria-label="Yes" set:html={CHK} /></span>
          <span role="cell" class="br__col"><span class="br__chk br__chk--rent" aria-label="Yes" set:html={CHK} /></span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .br { padding: clamp(48px, 6vw, 84px) 0; background: #fff; }
  .br__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 80px); align-items: center; }
  .br__k { margin: 0 0 10px; color: var(--red); font-size: .84rem; letter-spacing: .12em; text-transform: uppercase; font-variation-settings: 'wght' 740; }
  .br h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.04; letter-spacing: -.03em; font-variation-settings: 'wght' 800; text-wrap: balance; }
  .br h2 span { color: var(--red); }
  .br__lede { margin: 14px 0 0; max-width: 44ch; color: var(--steel); font-size: 1.06rem; line-height: 1.55; }
  .br__notes { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .br__notes li { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px 6px 7px; border-radius: 999px; background: var(--haze); border: 1px solid var(--line); font-size: .9rem; color: var(--ink-2); }
  .br__notes b { padding: 3px 10px 2px; border-radius: 999px; background: var(--ink); color: #fff; font-size: .76rem; letter-spacing: .06em; text-transform: uppercase; font-variation-settings: 'wght' 760; }
  .br__notes li + li b { background: var(--red); }

  .br__card { border-radius: 22px; border: 1px solid var(--line); background: linear-gradient(180deg, #fff, #fafbfc); box-shadow: 0 30px 60px -44px rgba(20,23,26,.5); padding: 8px 20px 12px; }
  .br__row { display: grid; grid-template-columns: 1fr 76px 76px; align-items: center; padding: 11px 0; border-top: 1px solid var(--line); }
  .br__row--head { border-top: 0; padding: 12px 0 10px; font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; font-variation-settings: 'wght' 760; color: var(--steel); }
  .br__row--head .br__col { color: var(--ink); }
  .br__col { display: grid; place-items: center; text-align: center; }
  .br__item { display: flex; align-items: center; gap: 12px; font-size: 1rem; font-variation-settings: 'wght' 650; min-width: 0; }
  .br__item i { flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; background: var(--red-tint); color: var(--red); }
  .br__item svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }

  .br__chk { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 2px solid var(--line-dark); box-sizing: border-box; transition: background .3s, border-color .3s, transform .45s cubic-bezier(.2,.8,.2,1.7); }
  .br__chk :global(svg) { width: 16px; height: 16px; fill: none; stroke: #fff; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 18; stroke-dashoffset: 18; transition: stroke-dashoffset .35s ease .1s; }
  .br__chk.is-on { border-color: transparent; transform: scale(1.08); }
  .br__chk--buy.is-on { background: var(--ink); }
  .br__chk--rent.is-on { background: var(--red); }
  .br__chk.is-on :global(svg) { stroke-dashoffset: 0; }
  .br__row.is-lit { background: linear-gradient(90deg, transparent, rgba(182,6,6,.05), transparent); }

  @media (max-width: 900px) { .br__in { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .br { padding: 30px 0 34px; }
    .br__in { gap: 18px; }
    .br__k { margin-bottom: 6px; }
    .br__lede { margin-top: 8px; font-size: .96rem; }
    .br__notes { margin-top: 12px; gap: 6px; flex-wrap: nowrap; }
    .br__notes li { gap: 5px; padding: 4px 9px 3px 4px; font-size: .74rem; white-space: nowrap; }
    .br__notes b { padding: 2px 7px 1px; font-size: .66rem; }
    .br__long { display: none; }
    .br__copy { text-align: center; }
    .br__lede { margin-inline: auto; }
    .br__notes { justify-content: center; }
    .br__card { padding: 4px 14px 8px; border-radius: 18px; }
    .br__row { grid-template-columns: 1fr 48px 48px; padding: 7px 0; }
    .br__row--head { padding: 9px 0 7px; }
    .br__item { gap: 10px; font-size: .9rem; }
    .br__item i { width: 32px; height: 32px; }
    .br__chk { width: 26px; height: 26px; }
  }
  @media (prefers-reduced-motion: reduce) { .br__chk, .br__chk :global(svg) { transition: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-br]').forEach((root) => {
    const rows = [...root.querySelectorAll<HTMLElement>('.br__row:not(.br__row--head)')];
    const all = () => root.querySelectorAll<HTMLElement>('.br__chk').forEach((c) => c.classList.add('is-on'));
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { all(); return; }
    const timers: number[] = [];
    const run = () => {
      rows.forEach((r, i) => {
        const at = 300 + i * 360;
        timers.push(window.setTimeout(() => { r.classList.add('is-lit'); r.querySelector('.br__chk--buy')!.classList.add('is-on'); }, at));
        timers.push(window.setTimeout(() => r.querySelector('.br__chk--rent')!.classList.add('is-on'), at + 170));
        timers.push(window.setTimeout(() => r.classList.remove('is-lit'), at + 650));
      });
    };
    const io = new IntersectionObserver(([en]) => { if (en.isIntersecting) { io.disconnect(); run(); } }, { threshold: 0.35 });
    io.observe(root.querySelector('.br__card')!);
  });
</script>
