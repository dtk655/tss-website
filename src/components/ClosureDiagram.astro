---
// Small plan-view diagram for each closure type card.
const { kind } = Astro.props;
const cone = (x, y) => `<circle cx="${x}" cy="${y}" r="3.4" fill="#f26a1b"/><circle cx="${x}" cy="${y}" r="1.5" fill="#fff"/>`;
const cones = (pts) => pts.map(([x, y]) => cone(x, y)).join('');
const line = (x1, y1, x2, y2, n) => Array.from({ length: n }, (_, i) => [x1 + (x2 - x1) * i / (n - 1), y1 + (y2 - y1) * i / (n - 1)]);
const base3 = `<rect x="0" y="20" width="220" height="72" fill="#23272c"/><path d="M0 44H220M0 68H220" stroke="#f7f7f2" stroke-width="1.6" stroke-dasharray="10 8" opacity=".7"/>`;
const hatch = (x, y, w, h) => `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="url(#cdh)"/>`;
const car = (x, y, c = '#e9edf1') => `<rect x="${x}" y="${y}" width="20" height="11" rx="3.5" fill="${c}"/>`;
const barr = (x, y, w, v) => `<rect x="${x}" y="${y}" width="${v ? 5 : w}" height="${v ? w : 5}" rx="1.5" fill="#fff"/><path d="${Array.from({ length: Math.floor(w / 10) }, (_, i) => v ? `M${x} ${y + 2 + i * 10}h5v5h-5z` : `M${x + 2 + i * 10} ${y}h5v5h-5z`).join('')}" fill="#f26a1b"/>`;
const flag = (x, y) => `<circle cx="${x}" cy="${y}" r="5" fill="#d6ff3d"/><path d="M${x + 7} ${y - 8}h9v9h-9z" fill="#c8102e" transform="rotate(45 ${x + 11.5} ${y - 3.5})"/>`;
const arrow = (d) => `<path d="${d}" fill="none" stroke="#f5b800" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>`;
const S = {
  single: base3 + hatch(96, 70, 124, 20) + cones([...line(40, 90, 96, 69, 5), ...line(118, 69, 212, 69, 5)]) + car(20, 27) + car(120, 50, '#c8102e') + arrow('M52 80l14-8'),
  multi: base3 + hatch(70, 46, 150, 44) + cones([...line(14, 90, 70, 45, 6), ...line(92, 45, 212, 45, 6)]) + car(110, 27) + car(24, 27, '#c8102e'),
  shoulder: `<rect x="0" y="16" width="220" height="60" fill="#23272c"/><rect x="0" y="76" width="220" height="20" fill="#2f343a"/><path d="M0 46H220" stroke="#f7f7f2" stroke-width="1.6" stroke-dasharray="10 8" opacity=".7"/><path d="M0 76H220" stroke="#f7f7f2" stroke-width="1.6"/>` + hatch(60, 78, 160, 16) + cones(line(36, 94, 60, 76, 3).concat(line(80, 76, 212, 76, 7))) + car(30, 25) + car(130, 55, '#c8102e'),
  full: base3 + barr(104, 22, 68, true) + hatch(112, 20, 108, 72) + arrow('M20 56H70C88 56 90 40 90 22V4M84 10l6-7 6 7') + car(30, 27),
  ramp: `<rect x="0" y="14" width="220" height="44" fill="#23272c"/><path d="M0 36H220" stroke="#f7f7f2" stroke-width="1.6" stroke-dasharray="10 8" opacity=".7"/><path d="M70 58L190 112H130L30 58z" fill="#23272c"/>` + `<g transform="rotate(24 96 70)">${barr(74, 68, 44, false)}</g>` + cones([[60, 58], [78, 58], [96, 58]]) + car(24, 20) + car(130, 40, '#c8102e'),
  alternating: `<rect x="0" y="26" width="220" height="56" fill="#23272c"/><path d="M0 54H220" stroke="#f5b800" stroke-width="1.6" stroke-dasharray="10 8"/>` + hatch(70, 56, 80, 24) + cones([...line(46, 80, 70, 55, 3), ...line(84, 55, 136, 55, 4), ...line(150, 55, 174, 80, 3)]) + flag(34, 96) + flag(182, 14) + car(8, 62) + car(190, 34, '#c8102e'),
  mobile: base3 + `<g class="cd-move">` + `<rect x="60" y="72" width="34" height="14" rx="3" fill="#2b3036" stroke="#555"/><rect x="50" y="74" width="10" height="10" rx="1.5" fill="#f5b800"/><rect x="112" y="72" width="34" height="14" rx="3" fill="#2b3036" stroke="#555"/><rect x="102" y="74" width="10" height="10" rx="1.5" fill="#f5b800"/><rect x="166" y="72" width="26" height="14" rx="3" fill="#f5b800"/>` + `</g>` + arrow('M28 79h14M36 74l6 5-6 5') + car(40, 27) + car(150, 50, '#c8102e'),
  intersection: `<rect x="0" y="36" width="220" height="40" fill="#23272c"/><rect x="90" y="0" width="40" height="112" fill="#23272c"/><path d="M0 56H90M130 56H220M110 0V36M110 76V112" stroke="#f7f7f2" stroke-width="1.6" stroke-dasharray="8 7" opacity=".7"/>` + hatch(112, 58, 40, 18) + cones([[112, 58], [126, 58], [140, 58], [154, 58], [154, 74]]) + flag(74, 90) + car(20, 60) + `<rect x="95" y="8" width="11" height="20" rx="3.5" fill="#c8102e"/>`
};
---
<svg class="cd" viewBox="0 0 220 112" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
  <defs><pattern id="cdh" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="8" height="8" fill="rgba(245,184,0,.1)"/><rect width="3" height="8" fill="rgba(245,184,0,.34)"/></pattern></defs>
  <rect width="220" height="112" fill="#15181b" />
  <Fragment set:html={S[kind] || S.single} />
</svg>
<style is:global>
  .cd { display: block; width: 100%; height: auto; border-radius: 12px; }
  .cd-move { animation: cdMove 5s linear infinite; }
  @keyframes cdMove { from { transform: translateX(-30px); } to { transform: translateX(30px); } }
  @media (prefers-reduced-motion: reduce) { .cd-move { animation: none; } }
</style>
