---
import { priceLabel, img } from '../lib/shopify.js';
const { p } = Astro.props;
const src = p.featuredImage?.url;
---
<a class="pcard" href={`/products/${p.handle}`}>
  <div class="pcard__img">
    {src ? <img src={img(src, 480)} alt={p.featuredImage.altText || p.title} loading="lazy" width="400" height="400" /> : <span aria-hidden="true"></span>}
  </div>
  <div class="pcard__body">
    {p.isRental && <span class="tag-rent">Rental</span>}
    <span class="pcard__title">{p.title}</span>
    <span class="pcard__price">{p.isRental ? 'Request a rental quote' : <strong>{priceLabel(p)}</strong>}</span>
  </div>
</a>
