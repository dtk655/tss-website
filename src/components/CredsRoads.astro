---
// Certifications shown in full (credential cards) + the roads our crews have worked.
const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const certs = [
  ['OSHA', 'Trained & certified', 'Every crew member completes OSHA safety training before working a closure.', 'Untitled_design_14.png'],
  ['ATSSA', 'Certified flaggers', 'Flaggers certified by the American Traffic Safety Services Association.', 'Untitled_design_18.png'],
  ['Rutgers', 'Certified traffic control captains', 'Every crew is led by a Rutgers-certified Traffic Control Captain.', 'Untitled_design_16.png'],
  ['S.W.A.C.', 'Clearance', 'Our lane closure division holds S.W.A.C. clearance.', 'Untitled_design_15.png'],
  ['MUTCD', 'Compliant setups', 'Every work zone follows the MUTCD and each state’s own standards.', 'Untitled_design_17.png'],
  ['MASH', 'Tested equipment', 'Crash trucks and barriers tested to MASH crash standards.', 'Untitled_design_22.png']
].map(([a, b, d, f]) => ({ a, b, d, src: CDN + f }));
const roads = [
  ['Garden State Parkway', 'NJ Turnpike Authority', 'Untitled_design_23.png'],
  ['New Jersey Turnpike', 'NJ Turnpike Authority', 'Untitled_design_26.png'],
  ['NJDOT highways', 'NJ Dept. of Transportation', 'Untitled_design_27.png'],
  ['George Washington Bridge', 'Port Authority of NY & NJ', 'Untitled_design_28.png'],
  ['NYS Thruway', 'NYS Thruway Authority', 'Untitled_design_24.png'],
  ['NYSDOT highways', 'NYS Dept. of Transportation', 'Untitled_design_29.png'],
  ['PennDOT roads', 'PA Dept. of Transportation', 'Untitled_design_30.png']
].map(([n, a, f]) => ({ n, a, src: CDN + f }));
---
<section class="cr" data-cr>
  <div class="wrap">
    <div class="cr__head">
      <p class="cr__kicker">Certifications</p>
      <h2>Certified to work <span>where others can’t.</span></h2>
    </div>
    <ul class="cr__certs">
      {certs.map((c, i) => (
        <li class="cr__cert" style={`--i:${i}`}>
          <div class="cr__seal"><img src={c.src} alt={`${c.a} ${c.b}`} width="96" height="96" loading="lazy" /></div>
          <p class="cr__name"><b>{c.a}</b> {c.b}</p>
          <p class="cr__desc">{c.d}</p>
          <span class="cr__ok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" /></svg>Verified</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="cr__roads">
    <div class="wrap">
      <div class="cr__rhead">
        <div>
          <p class="cr__kicker cr__kicker--gold">Proven on</p>
          <h2>Trusted on the region’s <span>toughest roads.</span></h2>
        </div>
      </div>
      <ul class="cr__rlist">
        {roads.map((r, i) => (
          <li style={`--i:${i}`}>
            <span class="cr__rlogo"><img src={r.src} alt="" width="64" height="64" loading="lazy" /></span>
            <b>{r.n}</b>
          </li>
        ))}
        <li class="cr__more" style={`--i:${roads.length}`}>
          <span class="cr__rlogo cr__rlogo--plus" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg></span>
          <b>And every road in between</b>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .cr { background: #fff; }
  .cr > .wrap { padding-block: clamp(56px, 7vw, 96px); }
  .cr__head { text-align: center; margin-bottom: clamp(28px, 3.6vw, 44px); }
  .cr__kicker { margin: 0 0 10px; color: var(--red); font-size: .84rem; letter-spacing: .12em; text-transform: uppercase; font-variation-settings: 'wght' 740; }
  .cr__kicker--gold { color: var(--gold); }
  .cr h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.04; letter-spacing: -.03em; font-variation-settings: 'wght' 800; text-wrap: balance; }
  .cr__head h2 span { color: var(--red); }

  .cr__certs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .cr__cert { position: relative; overflow: hidden; display: grid; grid-template-columns: 96px 1fr; grid-template-rows: auto 1fr auto; column-gap: 20px; padding: 22px; border-radius: 22px; border: 1px solid var(--line); background: linear-gradient(180deg, #fff, #fafbfc); opacity: 0; transform: translateY(20px); transition: opacity .6s, transform .6s cubic-bezier(.2,.8,.2,1), box-shadow .3s, border-color .3s; transition-delay: calc(var(--i) * 90ms); }
  .cr.is-in .cr__cert { opacity: 1; transform: none; }
  .cr__cert:hover { border-color: var(--line-dark); box-shadow: 0 22px 40px -28px rgba(20,23,26,.45); }
  .cr__cert::after { content: ''; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 35%, rgba(255,255,255,.9) 50%, transparent 65%); transform: translateX(-120%); pointer-events: none; }
  .cr.is-in .cr__cert::after { animation: crSheen 1.1s ease forwards; animation-delay: calc(.5s + var(--i) * 140ms); }
  @keyframes crSheen { to { transform: translateX(120%); } }
  .cr__seal { grid-row: 1 / 4; width: 96px; height: 96px; border-radius: 50%; background: #fff; border: 1px solid var(--line); box-shadow: 0 10px 22px -14px rgba(20,23,26,.4); display: grid; place-items: center; overflow: hidden; padding: 6px; box-sizing: border-box; }
  .cr__seal img { width: 100%; height: 100%; object-fit: contain; }
  .cr__name { margin: 2px 0 0; font-size: 1.12rem; line-height: 1.2; letter-spacing: -.01em; font-variation-settings: 'wght' 620; color: var(--ink-2); }
  .cr__name b { display: block; font-size: 1.5rem; letter-spacing: -.02em; color: var(--ink); font-variation-settings: 'wght' 820; }
  .cr__desc { margin: 8px 0 12px; font-size: .9rem; line-height: 1.45; color: var(--steel); }
  .cr__ok { display: inline-flex; align-items: center; gap: 6px; width: fit-content; padding: 4px 10px 3px 6px; border-radius: 999px; background: #e7f6ec; color: #157a39; font-size: .76rem; letter-spacing: .06em; text-transform: uppercase; font-variation-settings: 'wght' 760; opacity: 0; transform: scale(.7); transition: opacity .3s, transform .4s cubic-bezier(.2,.8,.2,1.6); transition-delay: calc(.7s + var(--i) * 140ms); }
  .cr.is-in .cr__ok { opacity: 1; transform: none; }
  .cr__ok svg { width: 16px; height: 16px; padding: 2px; border-radius: 50%; background: #1d9e4b; fill: none; stroke: #fff; stroke-width: 3.4; stroke-linecap: round; stroke-linejoin: round; box-sizing: border-box; }

  .cr__roads { position: relative; overflow: hidden; color: #fff; background: #111315; isolation: isolate; }
  .cr__roads::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(17,19,21,.97) 30%, rgba(17,19,21,.82)), url('/fleet/lc-hero-m.webp') center 40% / cover; }
  .cr__roads > .wrap { padding-block: clamp(52px, 6vw, 84px); }
  .cr__rhead { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 40px; margin-bottom: clamp(24px, 3vw, 36px); }
  .cr__roads h2 { color: #fff; }
  .cr__roads h2 span { color: var(--gold); }
  .cr__rlist li.cr__more { background: rgba(245,184,0,.1); border-color: rgba(245,184,0,.45); border-style: dashed; }
  .cr__rlist .cr__rlogo.cr__rlogo--plus { background: var(--gold); }
  .cr__rlogo--plus svg { width: 26px; height: 26px; fill: none; stroke: #14171a; stroke-width: 2.6; stroke-linecap: round; }
  .cr__rlede { margin: 0; max-width: 46ch; color: #c5ccd3; font-size: 1.02rem; line-height: 1.5; }
  .cr__rlist { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 12px; }
  .cr__rlist li { display: grid; justify-items: start; gap: 4px; padding: 16px 14px; border-radius: 18px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); opacity: 0; transform: translateY(16px); transition: opacity .5s, transform .5s cubic-bezier(.2,.8,.2,1), background .3s, border-color .3s; transition-delay: calc(var(--i) * 80ms); }
  .cr__roads.is-in .cr__rlist li { opacity: 1; transform: none; }
  .cr__rlist li:hover { background: rgba(255,255,255,.09); border-color: rgba(245,184,0,.6); }
  .cr__rlogo { width: 56px; height: 56px; margin-bottom: 10px; border-radius: 14px; background: #fff; display: grid; place-items: center; overflow: hidden; padding: 3px; box-sizing: border-box; }
  .cr__rlogo img { width: 100%; height: 100%; object-fit: contain; }
  .cr__rlist b { font-size: .98rem; line-height: 1.2; font-variation-settings: 'wght' 720; }
  .cr__rlist small { font-size: .76rem; line-height: 1.3; color: #9aa4ae; }

  @media (max-width: 1500px) { .cr__rlist { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 1100px) { .cr__certs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .cr__certs { grid-template-columns: 1fr; gap: 10px; }
    .cr__cert { grid-template-columns: 72px 1fr; column-gap: 14px; padding: 16px; border-radius: 18px; }
    .cr__seal { width: 72px; height: 72px; }
    .cr__name { font-size: 1rem; }
    .cr__name b { font-size: 1.3rem; }
    .cr__desc { font-size: .84rem; margin: 6px 0 10px; }
    .cr__rhead { display: block; }
    .cr__rlede { margin-top: 10px; }
    .cr__rlist { grid-template-columns: 1fr; gap: 8px; }
    .cr__rlist li { grid-template-columns: 48px 1fr; grid-template-rows: auto auto; column-gap: 12px; row-gap: 1px; align-items: center; padding: 10px 12px; border-radius: 14px; }
    .cr__rlogo { grid-row: 1 / 3; width: 48px; height: 48px; margin: 0; border-radius: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cr__cert, .cr__ok, .cr__rlist li { opacity: 1; transform: none; transition: none; }
    .cr__cert::after { display: none; }
  }

  /* road tiles: even-sized, icon + name only */
  .cr__rlist { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .cr__rlist li { display: flex; align-items: center; gap: 14px; min-height: 84px; padding: 14px 18px; border-radius: 18px; background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.16); }
  .cr__rlist .cr__rlogo { width: 54px; height: 54px; margin: 0; border-radius: 14px; flex: none; }
  .cr__rlogo--plus svg { width: 26px; height: 26px; }
  .cr__rlist b { font-size: clamp(1.02rem, 1.25vw, 1.25rem); line-height: 1.15; letter-spacing: -.01em; font-variation-settings: 'wght' 740; }
  @media (max-width: 1100px) { .cr__rlist { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .cr__rlist { grid-template-columns: 1fr; gap: 8px; }
    .cr__rlist li { display: flex; min-height: 66px; padding: 10px 14px; border-radius: 16px; }
    .cr__rlist .cr__rlogo { width: 46px; height: 46px; border-radius: 12px; }
    .cr__rlist b { font-size: 1.05rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cr]').forEach((root) => {
    const roads = root.querySelector<HTMLElement>('.cr__roads')!;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { root.classList.add('is-in'); roads.classList.add('is-in'); return; }
    const watch = (target: HTMLElement, el: HTMLElement) => {
      const io = new IntersectionObserver(([en]) => { if (en.isIntersecting) { io.disconnect(); el.classList.add('is-in'); } }, { threshold: 0.15 });
      io.observe(target);
    };
    watch(root.querySelector<HTMLElement>('.cr__certs')!, root); watch(roads, roads);
  });
</script>
