  @keyframes fadeIn { from { opacity: 0; } }
  @keyframes slideIn { from { transform: translateX(40px); opacity: 0; } }
  .drawer__head { display: flex; align-items: center; gap: 8px; padding: 14px 14px 0 18px; background: var(--asphalt); color: #fff; }
