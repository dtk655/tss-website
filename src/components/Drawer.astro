  .note { font-size: .85rem; color: var(--ink-soft); margin: 0; }
  .toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 95; background: var(--asphalt-deep); color: #fff; padding: 14px 20px 12px; border-radius: 10px; font-weight: 700; box-shadow: 0 10px 30px rgba(0,0,0,.25); animation: fadeIn .2s ease; }
</style>
