<div class="drawer" data-drawer hidden>
  <div class="drawer__scrim" data-close-drawer></div>
  <aside class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
    <div class="drawer__head">
      <h2 id="drawer-title" class="sr-only">Cart and quote list</h2>
      <div class="tabs" role="tablist">
        <button role="tab" data-tab="cart" aria-selected="true">Cart <span data-cart-count-inline></span></button>
        <button role="tab" data-tab="quote" aria-selected="false">Quote list <span data-quote-count-inline></span></button>
      </div>
      <button class="drawer__x" data-close-drawer aria-label="Close">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
      </button>
    </div>

    <section class="pane" data-pane="cart">
      <ul class="lines" data-cart-lines></ul>
      <div class="empty" data-cart-empty>
        <p><strong>Your cart is empty.</strong></p>
        <p>Products you buy online ship nationwide. For rentals, crews or bulk pricing, use the quote list.</p>
        <a href="/collections" class="btn btn--sm btn--dark">Shop products</a>
      </div>
      <div class="foot" data-cart-foot hidden>
        <div class="total"><span>Subtotal</span><strong data-cart-subtotal></strong></div>
        <p class="note">Shipping and tax are calculated at checkout.</p>
        <a class="btn" data-checkout href="#">Check out</a>
      </div>
    </section>

    <section class="pane" data-pane="quote" hidden>
      <p class="pane__intro">Build a list of what you need to rent or buy, then send it to our team. A real person replies with pricing, usually the same business day.</p>
      <ul class="lines" data-quote-lines></ul>
      <div class="empty" data-quote-empty>
        <p><strong>Your quote list is empty.</strong></p>
        <p>Add items from any product page, or plan a job with the work zone builder and add the whole equipment list at once.</p>
        <a href="/tools/work-zone-builder" class="btn btn--sm btn--dark">Open the work zone builder</a>
      </div>
      <div class="foot" data-quote-foot hidden>
        <a class="btn" href="/pages/request-a-quote">Request a quote for this list</a>
      </div>
    </section>
  </aside>
</div>
<style is:global>
