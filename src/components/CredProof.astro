---
// Big "Certified + Experienced" proof section shown right after the lane closure header.
const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const certs = [
  ['OSHA Trained & Certified', 'Untitled_design_14.png', 'Every crew member completes OSHA safety training.'],
  ['ATSSA Flagger Certified', 'Untitled_design_18.png', 'Flaggers certified by the American Traffic Safety Services Association.'],
  ['Rutgers-Certified TCCs', 'Untitled_design_16.png', 'Every crew led by a Rutgers-certified Traffic Control Captain.'],
  ['S.W.A.C. Clearance', 'Untitled_design_15.png', 'Our lane closure division holds S.W.A.C. clearance.'],
  ['MUTCD Compliant', 'Untitled_design_17.png', 'Every setup follows the MUTCD and state regulations.'],
  ['MASH Tested Equipment', 'Untitled_design_22.png', 'Crash trucks and barriers tested to MASH standards.']
].map(([t, f, d]) => [t, CDN + f, d]);
const roads = [
  ['Garden State Parkway', 'NJ Turnpike Authority', 'Untitled_design_23.png'],
  ['New Jersey Turnpike', 'NJ Turnpike Authority', 'Untitled_design_26.png'],
  ['NJDOT State Highways', 'NJ Dept. of Transportation', 'Untitled_design_27.png'],
  ['George Washington Bridge', 'Port Authority of NY & NJ', 'Untitled_design_28.png'],
  ['New York State Thruway', 'NYS Thruway Authority', 'Untitled_design_24.png'],
  ['NYSDOT State Highways', 'NYS Dept. of Transportation', 'Untitled_design_29.png'],
  ['PennDOT State Roads', 'PA Dept. of Transportation', 'Untitled_design_30.png']
].map(([n, a, f]) => [n, a, CDN + f]);
---
<section class="cp" data-cp>
  <div class="wrap">
    <div class="cp__head">
      <p class="cp__kicker">Why agencies and contractors call TSS</p>
      <h2><span>Certified.</span> <span>Experienced.</span> <span>Proven.</span></h2>
    </div>

    <div class="cp__grid">
      <article class="cp__panel cp__panel--cert">
        <p class="cp__label"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z" /><path d="M8.6 12l2.3 2.3 4.5-4.6" /></svg></i>Certified</p>
        <h3><b data-cp-count="6">6</b> certifications.<br />Every crew. Every job.</h3>
        <ul class="cp__certs">
          {certs.map(([t, src, d], i) => (
            <li style={`--i:${i}`}>
              <span class="cp__logo"><img src={src} alt="" width="64" height="64" loading="lazy" /></span>
              <span class="cp__ct"><b>{t}</b><small>{d}</small></span>
              <span class="cp__ok" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M7 12.4l3.2 3.2L17 8.8" /></svg></span>
            </li>
          ))}
        </ul>
      </article>

      <article class="cp__panel cp__panel--exp" data-rw>
        <p class="cp__label"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20L9 4M20 20L15 4M12 6v2M12 11v2M12 16v3" /></svg></i>Experienced</p>
        <h3 class="rw__h">The roads our crews work.</h3>
        <div class="rw">
          <svg class="rw__road" viewBox="0 0 600 260" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
            <defs>
              <linearGradient id="rwSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1c2228" /><stop offset="1" stop-color="#2c333a" /></linearGradient>
              <linearGradient id="rwRoad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a4047" /><stop offset="1" stop-color="#23282d" /></linearGradient>
              <linearGradient id="rwFade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1c2228" /><stop offset=".35" stop-color="#1c2228" stop-opacity="0" /></linearGradient>
            </defs>
            <rect width="600" height="260" fill="url(#rwSky)" />
            <path d="M286 92 L314 92 L620 260 L-20 260 Z" fill="url(#rwRoad)" />
            <path d="M286 92 L-20 260 M314 92 L620 260" stroke="#e8ecef" stroke-width="3" />
            <path class="rw__dash" d="M295 92 L170 260" stroke="#fff" stroke-width="4" stroke-dasharray="14 18" />
            <path class="rw__dash" d="M305 92 L430 260" stroke="#fff" stroke-width="4" stroke-dasharray="14 18" />
            <g class="rw__cones">
              <circle cx="470" cy="236" r="5" fill="#ff6a00" /><circle cx="440" cy="203" r="4" fill="#ff6a00" /><circle cx="414" cy="176" r="3.3" fill="#ff6a00" /><circle cx="394" cy="154" r="2.7" fill="#ff6a00" /><circle cx="378" cy="137" r="2.2" fill="#ff6a00" /><circle cx="366" cy="124" r="1.8" fill="#ff6a00" />
            </g>
            <rect width="600" height="260" fill="url(#rwFade)" />
            <rect x="96" y="20" width="9" height="240" fill="#5b6670" /><rect x="495" y="20" width="9" height="240" fill="#5b6670" />
            <rect x="90" y="26" width="420" height="6" fill="#7b8590" /><rect x="90" y="40" width="420" height="4" fill="#7b8590" />
          </svg>
          <div class="rw__sign" aria-live="polite">
            {roads.map(([n, a, src], i) => (
              <div class:list={['rw__face', i === 0 && 'is-on']} data-face={i}>
                <span class="rw__logo"><img src={src} alt="" width="56" height="56" loading="lazy" /></span>
                <span class="rw__txt"><b>{n}</b><small>{a}</small></span>
              </div>
            ))}
            <span class="rw__tab"><span data-rw-n>1</span> / {roads.length}</span>
          </div>
        </div>
        <ul class="rw__list">
          {roads.map(([n, , src], i) => (
            <li><button type="button" class:list={['rw__chip', i === 0 && 'is-on']} data-chip={i}><img src={src} alt="" width="28" height="28" loading="lazy" /><span>{n}</span><i aria-hidden="true"></i></button></li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .cp { padding: clamp(56px, 7vw, 100px) 0; background: var(--haze); overflow: hidden; }
  .cp__head { text-align: center; margin-bottom: clamp(26px, 3.6vw, 44px); }
  .cp__kicker { max-width: none; margin: 0 auto 10px; color: var(--red); font-size: .86rem; letter-spacing: .12em; text-transform: uppercase; font-variation-settings: 'wght' 740; }
  .cp h2 { max-width: none; margin: 0; font-size: clamp(2.2rem, 5vw, 4.4rem); line-height: 1; letter-spacing: -.035em; font-variation-settings: 'wght' 820; }
  .cp h2 span { display: inline-block; opacity: 0; transform: translateY(18px); transition: opacity .6s, transform .6s cubic-bezier(.2,.8,.2,1); }
  .cp h2 span:nth-child(2) { transition-delay: .15s; }
  .cp h2 span:nth-child(3) { transition-delay: .3s; color: var(--red); }
  .cp.is-in h2 span { opacity: 1; transform: none; }

  .cp__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; }
  .cp__panel { position: relative; border-radius: 26px; padding: clamp(24px, 3vw, 40px); overflow: hidden; opacity: 0; transform: translateY(26px); transition: opacity .7s, transform .7s cubic-bezier(.2,.8,.2,1); }
  .cp__panel--exp { transition-delay: .15s; }
  .cp.is-in .cp__panel { opacity: 1; transform: none; }
  .cp__panel--cert { background: #fff; border: 1px solid var(--line); box-shadow: 0 30px 60px -44px rgba(20,23,26,.5); }
  .cp__panel--exp { background: radial-gradient(120% 140% at 100% 0%, #2a3036 0%, #14171a 60%); color: #fff; }
  .cp__panel--exp::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(-45deg, rgba(255,255,255,.025) 0 16px, transparent 16px 32px); pointer-events: none; }
  .cp__label { position: relative; display: inline-flex; align-items: center; gap: 10px; margin: 0 0 16px; font-size: .82rem; letter-spacing: .12em; text-transform: uppercase; font-variation-settings: 'wght' 760; color: var(--red); }
  .cp__panel--exp .cp__label { color: var(--gold); }
  .cp__label i { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: var(--red-tint); }
  .cp__panel--exp .cp__label i { background: rgba(245,184,0,.14); }
  .cp__label svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  .cp__panel--cert h3 { margin: 0 0 22px; font-size: clamp(1.6rem, 2.6vw, 2.3rem); line-height: 1.1; letter-spacing: -.02em; }
  .cp__panel--cert h3 b { color: var(--red); }
  .cp__certs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .cp__certs li { display: grid; grid-template-columns: 56px 1fr 26px; gap: 12px; align-items: center; padding: 12px; border-radius: 16px; border: 1.5px solid var(--line); background: #fff; opacity: 0; transform: translateY(12px) scale(.98); transition: opacity .5s, transform .5s cubic-bezier(.2,.8,.2,1), border-color .4s, background .4s; transition-delay: calc(.35s + var(--i) * 110ms); }
  .cp.is-in .cp__certs li { opacity: 1; transform: none; }
  .cp__logo { width: 56px; height: 56px; border-radius: 14px; border: 1px solid var(--line); background: #fff; display: grid; place-items: center; overflow: hidden; }
  .cp__logo img { width: 100%; height: 100%; object-fit: contain; }
  .cp__ct { min-width: 0; }
  .cp__ct b { display: block; font-size: .98rem; line-height: 1.2; font-variation-settings: 'wght' 720; }
  .cp__ct small { display: block; margin-top: 3px; font-size: .8rem; line-height: 1.35; color: var(--steel); }
  .cp__ok svg { display: block; width: 26px; height: 26px; overflow: visible; }
  .cp__ok circle { fill: none; stroke: var(--line-dark); stroke-width: 2; transition: fill .3s .2s, stroke .3s; }
  .cp__ok path { fill: none; stroke: #fff; stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 16; stroke-dashoffset: 16; transition: stroke-dashoffset .35s .3s; }
  .cp__certs li.is-ok { border-color: #cfe9d8; background: linear-gradient(180deg, #fff, #f6fbf8); }
  .cp__certs li.is-ok .cp__ok circle { fill: #1d9e4b; stroke: #1d9e4b; }
  .cp__certs li.is-ok .cp__ok path { stroke-dashoffset: 0; }
  .cp__certs li.is-ok .cp__ok svg { animation: cpStamp .5s .2s cubic-bezier(.2,.8,.2,1.6) both; }
  @keyframes cpStamp { from { transform: scale(.5); } to { transform: none; } }


  /* experienced: roadway sign gantry */
  .cp__panel--exp { display: flex; flex-direction: column; }
  .rw__h { position: relative; margin: 0 0 18px; font-size: clamp(1.6rem, 2.6vw, 2.3rem); line-height: 1.1; letter-spacing: -.02em; color: #fff; }
  .rw { position: relative; flex: 1; min-height: 300px; border-radius: 18px; overflow: hidden; border: 1px solid rgba(255,255,255,.08); }
  .rw__road { position: absolute; inset: 0; width: 100%; height: 100%; }
  .rw__dash { stroke-dashoffset: 0; animation: rwDrive .9s linear infinite; }
  @keyframes rwDrive { to { stroke-dashoffset: -32; } }
  .rw.is-boost .rw__dash { animation-duration: .35s; }
  .rw__cones { animation: rwCones 1.8s ease-in-out infinite; }
  @keyframes rwCones { 50% { opacity: .55; } }
  .rw__sign { position: absolute; left: 50%; top: 9%; width: min(80%, 460px); transform: translateX(-50%); aspect-ratio: 440 / 130; border-radius: 12px; background: #0b6b3a; box-shadow: inset 0 0 0 3px #0b6b3a, inset 0 0 0 5px #fff, 0 18px 30px -12px rgba(0,0,0,.6); overflow: hidden; }
  .rw__sign::after { content: ''; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,.22) 48%, transparent 62%); transform: translateX(-120%); pointer-events: none; }
  .rw.is-flip .rw__sign::after { animation: rwSheen .8s ease; }
  @keyframes rwSheen { to { transform: translateX(120%); } }
  .rw__face { position: absolute; inset: 0; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 4%; padding: 0 6% 0 5%; color: #fff; opacity: 0; transform: translateY(70%); transition: opacity .45s, transform .55s cubic-bezier(.2,.8,.2,1); }
  .rw__face.is-on { opacity: 1; transform: none; }
  .rw__face.is-out { opacity: 0; transform: translateY(-70%); }
  .rw__logo { width: clamp(42px, 5vw, 64px); aspect-ratio: 1; border-radius: 12px; background: #fff; display: grid; place-items: center; overflow: hidden; padding: 3px; box-sizing: border-box; }
  .rw__logo img { width: 100%; height: 100%; object-fit: contain; }
  .rw__txt { min-width: 0; }
  .rw__txt b { display: block; font-size: clamp(1rem, 1.75vw, 1.55rem); line-height: 1.08; letter-spacing: .005em; font-variation-settings: 'wght' 760; text-wrap: balance; }
  .rw__txt small { display: block; margin-top: 4px; font-size: clamp(.72rem, .95vw, .86rem); color: rgba(255,255,255,.8); letter-spacing: .04em; text-transform: uppercase; font-variation-settings: 'wght' 640; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rw__tab { position: absolute; right: 10px; top: 8px; padding: 2px 8px 1px; border-radius: 5px; background: var(--gold); color: var(--ink); font-size: .68rem; font-variation-settings: 'wght' 800; letter-spacing: .04em; font-variant-numeric: tabular-nums; }

  .rw__list { position: relative; list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .rw__chip { all: unset; box-sizing: border-box; position: relative; overflow: hidden; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px 5px 5px; border-radius: 999px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); color: #c5ccd3; font-size: .82rem; font-variation-settings: 'wght' 620; transition: background .3s, color .3s, border-color .3s; }
  .rw__chip img { width: 26px; height: 26px; border-radius: 50%; background: #fff; object-fit: contain; }
  .rw__chip:hover { color: #fff; border-color: rgba(255,255,255,.3); }
  .rw__chip:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .rw__chip.is-on { background: #0b6b3a; border-color: #2a9a5f; color: #fff; }
  .rw__chip i { position: absolute; left: 0; bottom: 0; height: 2px; width: 0; background: var(--gold); }
  .rw__chip.is-on i { animation: rwBar var(--rw-t, 2600ms) linear forwards; }
  [data-rw].is-paused .rw__chip.is-on i { animation: none; width: 100%; }
  @keyframes rwBar { to { width: 100%; } }
  @media (max-width: 640px) {
    .rw { min-height: 230px; }
    .rw__sign { width: 88%; top: 8%; }
    .rw__list { gap: 6px; }
    .rw__chip { font-size: .74rem; padding: 4px 10px 4px 4px; }
    .rw__chip img { width: 22px; height: 22px; }
  }
  @media (prefers-reduced-motion: reduce) { .rw__dash, .rw__cones { animation: none; } .rw__face { transition: none; } }
  @media (max-width: 1100px) { .cp__grid { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .cp__kicker { font-size: .72rem; letter-spacing: .08em; }
    .cp__panel { border-radius: 20px; padding: 22px 16px; }
    .cp__certs { grid-template-columns: 1fr; gap: 8px; }
    .cp__certs li { grid-template-columns: 46px 1fr 24px; padding: 10px; }
    .cp__logo { width: 46px; height: 46px; border-radius: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cp h2 span, .cp__panel, .cp__certs li { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cp]').forEach((root) => {
    const rows = [...root.querySelectorAll<HTMLElement>('.cp__certs li')];
    const counts = [...root.querySelectorAll<HTMLElement>('[data-cp-count]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const countUp = (el: HTMLElement, delay: number) => {
      const to = Number(el.dataset.cpCount);
      setTimeout(() => {
        const t0 = performance.now(), D = to > 100 ? 1800 : 1100;
        const tick = (now: number) => { const p = Math.min(1, (now - t0) / D); el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3))).toLocaleString('en-US'); if (p < 1) requestAnimationFrame(tick); };
        requestAnimationFrame(tick);
      }, delay);
    };
    if (reduce) { root.classList.add('is-in'); rows.forEach((r) => r.classList.add('is-ok')); return; }
    counts.forEach((c) => (c.textContent = '0'));
    const io = new IntersectionObserver(([en]) => {
      if (!en.isIntersecting) return;
      io.disconnect();
      root.classList.add('is-in');
      counts.forEach((c, i) => countUp(c, 300 + i * 120));
      rows.forEach((r, i) => setTimeout(() => r.classList.add('is-ok'), 900 + i * 320));
    }, { threshold: 0.2 });
    io.observe(root);
  });
  document.querySelectorAll<HTMLElement>('[data-rw]').forEach((panel) => {
    const rw = panel.querySelector<HTMLElement>('.rw')!;
    const faces = [...panel.querySelectorAll<HTMLElement>('[data-face]')];
    const chips = [...panel.querySelectorAll<HTMLElement>('[data-chip]')];
    const num = panel.querySelector<HTMLElement>('[data-rw-n]')!;
    const T = 2600;
    panel.style.setProperty('--rw-t', T + 'ms');
    let i = 0, timer = 0, resume = 0;
    const show = (n: number) => {
      if (n === i) return;
      faces[i].classList.remove('is-on'); faces[i].classList.add('is-out');
      const old = faces[i];
      setTimeout(() => old.classList.remove('is-out'), 600);
      i = n;
      faces[i].classList.add('is-on');
      chips.forEach((c, k) => c.classList.toggle('is-on', k === i));
      num.textContent = String(i + 1);
      rw.classList.remove('is-flip', 'is-boost'); void rw.offsetWidth; rw.classList.add('is-flip', 'is-boost');
      setTimeout(() => rw.classList.remove('is-boost'), 700);
    };
    const start = () => { if (!timer) timer = window.setInterval(() => show((i + 1) % faces.length), T); };
    const stop = () => { clearInterval(timer); timer = 0; };
    panel.addEventListener('click', (e) => {
      const c = (e.target as Element).closest<HTMLElement>('[data-chip]');
      if (!c) return;
      stop(); panel.classList.add('is-paused'); show(Number(c.dataset.chip));
      clearTimeout(resume); resume = window.setTimeout(() => { panel.classList.remove('is-paused'); start(); }, 9000);
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    new IntersectionObserver(([en]) => { en.isIntersecting && !panel.classList.contains('is-paused') ? start() : stop(); }, { threshold: 0.3 }).observe(panel);
  });
</script>
