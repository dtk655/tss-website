---
// Big "Certified + Experienced" proof section shown right after the lane closure header.
const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const certs = [
  ['OSHA Trained & Certified', 'Untitled_design_14.png', 'Every crew member completes OSHA safety training.'],
  ['ATSSA Flagger Certified', 'Untitled_design_18.png', 'Flaggers certified by the American Traffic Safety Services Association.'],
  ['Rutgers-Certified TCCs', 'Untitled_design_16.png', 'Every crew led by a Rutgers-certified Traffic Control Captain.'],
  ['S.W.A.C. Clearance', 'Untitled_design_15.png', 'Our lane closure division holds S.W.A.C. clearance.'],
  ['MUTCD Compliant', 'Untitled_design_17.png', 'Every setup follows the MUTCD and state regulations.'],
  ['MASH Tested Equipment', 'Untitled_design_22.png', 'Crash trucks and barriers tested to MASH standards.']
].map(([t, f, d]) => [t, CDN + f, d]);
const agencies = [
  ['NJ Turnpike', 'Untitled_design_26.png'],
  ['Garden State Pkwy', 'Untitled_design_23.png'],
  ['NJDOT', 'Untitled_design_27.png'],
  ['NYS Thruway', 'Untitled_design_24.png'],
  ['NYSDOT', 'Untitled_design_29.png'],
  ['Port Authority', 'Untitled_design_28.png'],
  ['PennDOT', 'Untitled_design_30.png']
].map(([t, f]) => [t, CDN + f]);
---
<section class="cp" data-cp>
  <div class="wrap">
    <div class="cp__head">
      <p class="cp__kicker">Why agencies and contractors call TSS</p>
      <h2><span>Certified.</span> <span>Experienced.</span> <span>Proven.</span></h2>
    </div>

    <div class="cp__grid">
      <article class="cp__panel cp__panel--cert">
        <p class="cp__label"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z" /><path d="M8.6 12l2.3 2.3 4.5-4.6" /></svg></i>Certified</p>
        <h3><b data-cp-count="6">6</b> certifications.<br />Every crew. Every job.</h3>
        <ul class="cp__certs">
          {certs.map(([t, src, d], i) => (
            <li style={`--i:${i}`}>
              <span class="cp__logo"><img src={src} alt="" width="64" height="64" loading="lazy" /></span>
              <span class="cp__ct"><b>{t}</b><small>{d}</small></span>
              <span class="cp__ok" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M7 12.4l3.2 3.2L17 8.8" /></svg></span>
            </li>
          ))}
        </ul>
      </article>

      <article class="cp__panel cp__panel--exp">
        <p class="cp__label"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg></i>Experienced</p>
        <p class="cp__big"><b><span data-cp-count="25000">25,000</span>+</b><span>lane closures completed by our crews</span></p>
        <ul class="cp__stats">
          <li><b><span data-cp-count="25">25</span>+</b><span>years running closures</span></li>
          <li><b><span data-cp-count="7">7</span></b><span>agencies &amp; authorities</span></li>
          <li><b><span data-cp-count="5">5</span></b><span>states covered</span></li>
        </ul>
        <p class="cp__route">Trusted from the Garden State Parkway to the G.W. Bridge</p>
        <ul class="cp__ag">
          {agencies.map(([t, src], i) => <li style={`--i:${i}`} title={t}><img src={src} alt={t} width="52" height="52" loading="lazy" /><span>{t}</span></li>)}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .cp { padding: clamp(56px, 7vw, 100px) 0; background: var(--haze); overflow: hidden; }
  .cp__head { text-align: center; margin-bottom: clamp(26px, 3.6vw, 44px); }
  .cp__kicker { max-width: none; margin: 0 auto 10px; color: var(--red); font-size: .86rem; letter-spacing: .12em; text-transform: uppercase; font-variation-settings: 'wght' 740; }
  .cp h2 { max-width: none; margin: 0; font-size: clamp(2.2rem, 5vw, 4.4rem); line-height: 1; letter-spacing: -.035em; font-variation-settings: 'wght' 820; }
  .cp h2 span { display: inline-block; opacity: 0; transform: translateY(18px); transition: opacity .6s, transform .6s cubic-bezier(.2,.8,.2,1); }
  .cp h2 span:nth-child(2) { transition-delay: .15s; }
  .cp h2 span:nth-child(3) { transition-delay: .3s; color: var(--red); }
  .cp.is-in h2 span { opacity: 1; transform: none; }

  .cp__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; }
  .cp__panel { position: relative; border-radius: 26px; padding: clamp(24px, 3vw, 40px); overflow: hidden; opacity: 0; transform: translateY(26px); transition: opacity .7s, transform .7s cubic-bezier(.2,.8,.2,1); }
  .cp__panel--exp { transition-delay: .15s; }
  .cp.is-in .cp__panel { opacity: 1; transform: none; }
  .cp__panel--cert { background: #fff; border: 1px solid var(--line); box-shadow: 0 30px 60px -44px rgba(20,23,26,.5); }
  .cp__panel--exp { background: radial-gradient(120% 140% at 100% 0%, #2a3036 0%, #14171a 60%); color: #fff; }
  .cp__panel--exp::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(-45deg, rgba(255,255,255,.025) 0 16px, transparent 16px 32px); pointer-events: none; }
  .cp__label { position: relative; display: inline-flex; align-items: center; gap: 10px; margin: 0 0 16px; font-size: .82rem; letter-spacing: .12em; text-transform: uppercase; font-variation-settings: 'wght' 760; color: var(--red); }
  .cp__panel--exp .cp__label { color: var(--gold); }
  .cp__label i { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: var(--red-tint); }
  .cp__panel--exp .cp__label i { background: rgba(245,184,0,.14); }
  .cp__label svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  .cp__panel--cert h3 { margin: 0 0 22px; font-size: clamp(1.6rem, 2.6vw, 2.3rem); line-height: 1.1; letter-spacing: -.02em; }
  .cp__panel--cert h3 b { color: var(--red); }
  .cp__certs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .cp__certs li { display: grid; grid-template-columns: 56px 1fr 26px; gap: 12px; align-items: center; padding: 12px; border-radius: 16px; border: 1.5px solid var(--line); background: #fff; opacity: 0; transform: translateY(12px) scale(.98); transition: opacity .5s, transform .5s cubic-bezier(.2,.8,.2,1), border-color .4s, background .4s; transition-delay: calc(.35s + var(--i) * 110ms); }
  .cp.is-in .cp__certs li { opacity: 1; transform: none; }
  .cp__logo { width: 56px; height: 56px; border-radius: 14px; border: 1px solid var(--line); background: #fff; display: grid; place-items: center; overflow: hidden; }
  .cp__logo img { width: 100%; height: 100%; object-fit: contain; }
  .cp__ct { min-width: 0; }
  .cp__ct b { display: block; font-size: .98rem; line-height: 1.2; font-variation-settings: 'wght' 720; }
  .cp__ct small { display: block; margin-top: 3px; font-size: .8rem; line-height: 1.35; color: var(--steel); }
  .cp__ok svg { display: block; width: 26px; height: 26px; overflow: visible; }
  .cp__ok circle { fill: none; stroke: var(--line-dark); stroke-width: 2; transition: fill .3s .2s, stroke .3s; }
  .cp__ok path { fill: none; stroke: #fff; stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 16; stroke-dashoffset: 16; transition: stroke-dashoffset .35s .3s; }
  .cp__certs li.is-ok { border-color: #cfe9d8; background: linear-gradient(180deg, #fff, #f6fbf8); }
  .cp__certs li.is-ok .cp__ok circle { fill: #1d9e4b; stroke: #1d9e4b; }
  .cp__certs li.is-ok .cp__ok path { stroke-dashoffset: 0; }
  .cp__certs li.is-ok .cp__ok svg { animation: cpStamp .5s .2s cubic-bezier(.2,.8,.2,1.6) both; }
  @keyframes cpStamp { from { transform: scale(.5); } to { transform: none; } }

  .cp__big { position: relative; margin: 0; display: grid; gap: 6px; }
  .cp__big b { font-size: clamp(3.6rem, 8vw, 7rem); line-height: .92; letter-spacing: -.045em; font-variation-settings: 'wght' 840; font-variant-numeric: tabular-nums; background: linear-gradient(180deg, #fff 30%, #ffd2c9); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cp__big > span { font-size: clamp(1rem, 1.3vw, 1.2rem); color: #c5ccd3; }
  .cp__stats { position: relative; list-style: none; margin: 26px 0 0; padding: 22px 0 0; border-top: 1px solid rgba(255,255,255,.12); display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .cp__stats li { display: grid; gap: 4px; padding-left: 14px; border-left: 3px solid var(--red); }
  .cp__stats b { font-size: clamp(1.8rem, 2.8vw, 2.5rem); line-height: 1; letter-spacing: -.02em; font-variation-settings: 'wght' 800; font-variant-numeric: tabular-nums; }
  .cp__stats li > span { font-size: .84rem; color: #aeb6bf; }
  .cp__route { position: relative; margin: 26px 0 12px; font-size: .9rem; color: #d7dce1; font-variation-settings: 'wght' 620; }
  .cp__ag { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px; }
  .cp__ag li { display: grid; justify-items: center; gap: 6px; text-align: center; opacity: 0; transform: scale(1.5) rotate(-8deg); transition: opacity .35s, transform .5s cubic-bezier(.2,.9,.3,1.35); transition-delay: calc(1.1s + var(--i) * 120ms); }
  .cp.is-in .cp__ag li { opacity: 1; transform: none; }
  .cp__ag img { width: 100%; max-width: 58px; aspect-ratio: 1; border-radius: 14px; background: #fff; object-fit: contain; padding: 3px; box-sizing: border-box; }
  .cp__ag span { font-size: .68rem; line-height: 1.2; color: #aeb6bf; font-variation-settings: 'wght' 620; }

  @media (max-width: 1100px) { .cp__grid { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .cp__kicker { font-size: .72rem; letter-spacing: .08em; }
    .cp__panel { border-radius: 20px; padding: 22px 16px; }
    .cp__certs { grid-template-columns: 1fr; gap: 8px; }
    .cp__certs li { grid-template-columns: 46px 1fr 24px; padding: 10px; }
    .cp__logo { width: 46px; height: 46px; border-radius: 12px; }
    .cp__stats { grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .cp__stats li { padding-left: 10px; }
    .cp__stats li > span { font-size: .74rem; }
    .cp__ag { grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cp h2 span, .cp__panel, .cp__certs li, .cp__ag li { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cp]').forEach((root) => {
    const rows = [...root.querySelectorAll<HTMLElement>('.cp__certs li')];
    const counts = [...root.querySelectorAll<HTMLElement>('[data-cp-count]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const countUp = (el: HTMLElement, delay: number) => {
      const to = Number(el.dataset.cpCount);
      setTimeout(() => {
        const t0 = performance.now(), D = to > 100 ? 1800 : 1100;
        const tick = (now: number) => { const p = Math.min(1, (now - t0) / D); el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3))).toLocaleString('en-US'); if (p < 1) requestAnimationFrame(tick); };
        requestAnimationFrame(tick);
      }, delay);
    };
    if (reduce) { root.classList.add('is-in'); rows.forEach((r) => r.classList.add('is-ok')); return; }
    counts.forEach((c) => (c.textContent = '0'));
    const io = new IntersectionObserver(([en]) => {
      if (!en.isIntersecting) return;
      io.disconnect();
      root.classList.add('is-in');
      counts.forEach((c, i) => countUp(c, 300 + i * 120));
      rows.forEach((r, i) => setTimeout(() => r.classList.add('is-ok'), 900 + i * 320));
    }, { threshold: 0.2 });
    io.observe(root);
  });
</script>
