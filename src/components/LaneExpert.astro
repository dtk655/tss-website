---
// AI Lane Closure Expert (same look as the Fleet and Equipment Experts): describe the job, the site assistant answers.
import { PHONE, PHONE_TEL } from '../lib/config.js';
const roster = ['Lane closures', 'Flagging', 'TMA protection', 'Night work', 'Special events', 'Traffic control plans', 'NJ, NY, PA, CT and DE roads'];
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section class="eqa" data-lx id="lane-expert">
  <div class="wrap">
      <div class="eqa__shell">
      <div class="eqa__card">
        <span class="eqa__grid" aria-hidden="true"></span>
        <span class="eqa__glow eqa__glow--a" aria-hidden="true"></span>
        <span class="eqa__glow eqa__glow--b" aria-hidden="true"></span>
        <div class="eqa__copy">
          <div class="eqa__who">
            <span class="eqa__av" aria-hidden="true"><i></i><i></i><b class="eqa__avt">AI</b></span>
            <span class="eqa__name"><b>Lane Closure Expert</b><small><span class="eqa__dot"></span>Online · trained on our lane closure work</small></span>
          </div>
          <h2>Not Sure What Your Job Needs? <em>Ask Our Lane Closure Expert.</em></h2>
          <p class="eqa__lede eqa__lede--short">Describe the job. We’ll tell you what it needs.</p>
          <p class="eqa__lede eqa__lede--long">Describe the work in your own words. Our AI Lane Closure Expert reads your project and tells you the type of closure, crew, equipment and permits it will likely need.</p>
          <ol class="eqa__how">
            <li><span>1</span>Describe the job</li>
            <li><span>2</span>We check the requirements</li>
            <li><span>3</span>Get a recommended setup</li>
          </ol>
        </div>
        <form class="eqa__form" data-eqa>
          <label class="eqa__lab" for="eqa-q">Tell us about the project</label>
          <div class="eqa__box">
            <div class="eqa__field">
              <textarea id="eqa-q" rows="3" data-eqa-q aria-describedby="eqa-note"></textarea>
              <span class="eqa__type" aria-hidden="true" data-eqa-type></span>
            </div>
            <div class="eqa__bar">
              <span class="eqa__scan" data-eqa-scan>
                <span class="eqa__scan-l">Knows</span>
                <span class="eqa__roster"><span class="eqa__track">{[...roster, ...roster].map((r, i) => <span style={`--i:${i % roster.length}`} aria-hidden={i >= roster.length ? 'true' : undefined}>{r}</span>)}</span></span>
              </span>
              <button type="submit" class="eqa__send" data-eqa-send><span data-eqa-lab>Plan My Closure</span><Fragment set:html={ARROW} /></button>
            </div>
            <span class="eqa__beam" aria-hidden="true"></span>
          </div>
          <div class="eqa__chips" aria-label="Try an example">
            <span class="eqa__try">Try:</span>
            {['Right lane closure on a highway', 'Utility work at an intersection', 'Night paving on the Parkway', 'Road closed for a parade'].map((t) => <button type="button" data-eqa-chip>{t}</button>)}
          </div>
          <p class="eqa__note eqa__note--short">AI can make mistakes. For a firm answer call <a href={PHONE_TEL}>{PHONE}</a>.</p>
          <p class="eqa__note eqa__note--long" id="eqa-note">The Lane Closure Expert is an AI assistant and can make mistakes. For a firm answer and pricing, <a href="/pages/request-a-quote?type=lane-closure">get a quote</a> or call <a href={PHONE_TEL}>{PHONE}</a>.</p>
        </form>
      </div>
      </div>
    </div>
  </section>

<script>
  { const s = document.querySelector('[data-lx]'); if (s) { if (!('IntersectionObserver' in window)) s.classList.add('is-in'); else { const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { s.classList.add('is-in'); io.disconnect(); } }, { threshold: .12 }); io.observe(s); } } }
  // AI Fleet Expert: which truck fits: typed example placeholder, a short "checking the fleet" state, then the chat assistant answers.
  {
    const f = document.querySelector('[data-eqa]');
    if (f) {
      const q = f.querySelector('[data-eqa-q]'), ty = f.querySelector('[data-eqa-type]'), lab = f.querySelector('[data-eqa-lab]'), card = f.closest('.eqa__card');
      const ex = ['Gas main repair in the right lane of Route 22, two nights', 'Bridge joint work on the Turnpike, need two lanes closed overnight', 'Sewer work at a busy intersection for about a week', 'Closing a downtown street for a Saturday parade'];
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let ei = 0, ci = 0, del = false, tmr;
      const tick = () => {
        if (q.value || document.activeElement === q) { ty.textContent = ''; tmr = setTimeout(tick, 600); return; }
        const t = ex[ei];
        if (!del) { ci++; ty.textContent = t.slice(0, ci); if (ci >= t.length) { del = true; tmr = setTimeout(tick, 2200); return; } tmr = setTimeout(tick, 34 + Math.random() * 40); }
        else { ci -= 3; ty.textContent = t.slice(0, Math.max(0, ci)); if (ci <= 0) { del = false; ci = 0; ei = (ei + 1) % ex.length; tmr = setTimeout(tick, 400); return; } tmr = setTimeout(tick, 14); }
      };
      if (reduce) ty.textContent = ex[0]; else {
        const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { tick(); io.disconnect(); } }); io.observe(f);
      }
      q.addEventListener('input', () => { ty.hidden = !!q.value; });
      let busy = false;
      const ask = () => {
        const t = q.value.trim(); if (!t) { q.focus(); return; }
        if (busy) return; busy = true;
        card.classList.add('is-think'); lab.textContent = 'Checking the requirements';
        setTimeout(() => {
          const msg = 'Lane closure question: what type of closure, crew, equipment and permits would this job need, and can TSS handle it? Job: ' + t;
          if (window.TSSChat) window.TSSChat.ask(msg); else location.href = '/pages/request-a-quote?type=lane-closure';
          card.classList.remove('is-think'); lab.textContent = 'Plan My Closure'; busy = false;
        }, reduce ? 0 : 1500);
      };
      f.addEventListener('submit', (e) => { e.preventDefault(); ask(); });
      q.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); ask(); } });
      f.querySelectorAll('[data-eqa-chip]').forEach((b) => b.addEventListener('click', () => { q.value = b.textContent; ty.hidden = true; ask(); }));
    }
  }
</script>

<style>
  .eqa { padding: clamp(40px, 5vw, 84px) 0; }
  /* animated gradient frame */
  @property --eqa-a { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  .eqa__shell { position: relative; padding: 1.5px; border-radius: 30px; background: conic-gradient(from var(--eqa-a), rgba(224, 32, 28, .9), rgba(245, 184, 0, .9), rgba(90, 150, 255, .7), rgba(224, 32, 28, .1) 60%, rgba(224, 32, 28, .9)); animation: eqaSpin 7s linear infinite; opacity: 0; transform: translateY(24px); transition: opacity .8s ease, transform .9s cubic-bezier(.2, .8, .2, 1); box-shadow: 0 50px 90px -50px rgba(20, 23, 26, .9); }
  .eqa.is-in .eqa__shell { opacity: 1; transform: none; }
  .eqa__shell::after { content: ''; position: absolute; inset: -12px; z-index: -1; border-radius: 40px; background: inherit; filter: blur(28px); opacity: .32; }
  @keyframes eqaSpin { to { --eqa-a: 360deg; } }
  .eqa__card { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); align-items: center; gap: clamp(24px, 4vw, 68px); padding: clamp(28px, 4vw, 64px); border-radius: 28.5px; overflow: hidden; background: #0d0f12; color: #fff; }
  .eqa__grid { position: absolute; inset: 0; z-index: -1; background-image: radial-gradient(rgba(255, 255, 255, .09) 1px, transparent 1.2px); background-size: 22px 22px; -webkit-mask-image: radial-gradient(90% 90% at 70% 40%, #000 20%, transparent 75%); mask-image: radial-gradient(90% 90% at 70% 40%, #000 20%, transparent 75%); }
  .eqa__glow { position: absolute; z-index: -1; width: 48%; aspect-ratio: 1; border-radius: 50%; filter: blur(70px); opacity: .45; }
  .eqa__glow--a { left: -12%; top: -30%; background: #b60606; animation: eqaDrift 16s ease-in-out infinite alternate; }
  .eqa__glow--b { right: -10%; bottom: -40%; background: #1d4ed8; opacity: .3; animation: eqaDrift 19s ease-in-out infinite alternate-reverse; }
  @keyframes eqaDrift { to { transform: translate(18%, 14%) scale(1.15); } }

  .eqa__who { display: flex; align-items: center; gap: 14px; margin-bottom: 20px; }
  .eqa__av { position: relative; flex: none; display: grid; place-items: center; width: 58px; height: 58px; border-radius: 18px; background: linear-gradient(135deg, #e0201c, #f5b800); color: #fff; box-shadow: 0 12px 28px -12px rgba(224, 32, 28, .9); }
  .eqa__avt { font-size: 1.25rem; letter-spacing: .02em; font-variation-settings: 'wght' 820; font-weight: 400; color: #fff; }
  .eqa__av i { position: absolute; inset: -1px; border-radius: 18px; border: 1.5px solid rgba(245, 184, 0, .7); animation: eqaRing 2.6s ease-out infinite; }
  .eqa__av i + i { animation-delay: 1.3s; }
  @keyframes eqaRing { from { transform: scale(1); opacity: .8; } to { transform: scale(1.5); opacity: 0; } }
  .eqa__name { display: grid; grid-template-columns: max-content; justify-content: start; align-items: center; column-gap: 8px; row-gap: 2px; }
  .eqa__name b { font-size: 1.15rem; font-variation-settings: 'wght' 760; font-weight: 400; }
  .eqa__ai { justify-self: start; padding: 2px 7px; border-radius: 6px; background: linear-gradient(135deg, #e0201c, #f5b800); font-size: .7rem; letter-spacing: .08em; font-variation-settings: 'wght' 800; }
  .eqa__name small { grid-column: 1 / -1; display: inline-flex; align-items: center; gap: 7px; font-size: .84rem; color: rgba(255, 255, 255, .62); }
  .eqa__dot { width: 7px; height: 7px; border-radius: 50%; background: #3ddc84; animation: eqaPulse 2s ease-out infinite; }
  @keyframes eqaPulse { 0% { box-shadow: 0 0 0 0 rgba(61, 220, 132, .6); } 100% { box-shadow: 0 0 0 9px rgba(61, 220, 132, 0); } }
  .eqa h2 { margin: 0; font-size: clamp(1.7rem, 3vw, 2.9rem); line-height: 1.08; letter-spacing: -.028em; font-variation-settings: 'wght' 780; font-weight: 400; color: #fff; text-wrap: balance; }
  .eqa h2 em { font-style: normal; background: linear-gradient(90deg, #f5b800, #ff7a3d 55%, #f5b800); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .eqa__lede { margin: 16px 0 0; max-width: 46ch; font-size: clamp(1rem, 1.1vw, 1.12rem); line-height: 1.55; color: rgba(255, 255, 255, .74); }
  .eqa__how { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 24px 0 0; padding: 0; list-style: none; }
  .eqa__how li { display: inline-flex; align-items: center; gap: 8px; font-size: .9rem; color: rgba(255, 255, 255, .82); }
  .eqa__how span { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 7px; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .16); font-size: .74rem; font-variation-settings: 'wght' 760; color: #f5b800; }

  .eqa__lede--short, .eqa__note--short { display: none; }
  .eqa__form { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; min-width: 0; }
  .eqa__copy { min-width: 0; }
  .eqa__lab { display: inline-flex; align-items: center; gap: 9px; font-size: clamp(1.05rem, 1.3vw, 1.28rem); font-variation-settings: 'wght' 720; color: #fff; }
  .eqa__spark { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: linear-gradient(135deg, #e0201c, #f5b800); color: #fff; }
  .eqa__spark svg { width: 15px; height: 15px; }
  .eqa__box { position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; padding: 14px; border-radius: 20px; background: rgba(255, 255, 255, .04); border: 1px solid rgba(255, 255, 255, .14); backdrop-filter: blur(10px); transition: border-color .25s, box-shadow .25s, background .25s; }
  .eqa__box:focus-within { border-color: rgba(245, 184, 0, .7); background: rgba(255, 255, 255, .06); box-shadow: 0 0 0 4px rgba(245, 184, 0, .14), 0 0 40px -10px rgba(245, 184, 0, .5); }
  .eqa__field { position: relative; }
  .eqa__box textarea { position: relative; z-index: 1; width: 100%; min-height: 92px; padding: 8px 10px; border: 0; outline: none; resize: none; background: none; font: inherit; font-size: 1.08rem; line-height: 1.5; color: #fff; caret-color: #f5b800; }
  .eqa__type { position: absolute; left: 10px; right: 10px; top: 8px; font-size: 1.08rem; line-height: 1.5; color: rgba(255, 255, 255, .42); pointer-events: none; }
  .eqa__type::after { content: ''; display: inline-block; width: 2px; height: 1.15em; margin-left: 2px; vertical-align: -.2em; background: #f5b800; animation: eqaCaret 1s steps(1) infinite; }
  @keyframes eqaCaret { 50% { opacity: 0; } }
  .eqa__bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 10px; border-top: 1px solid rgba(255, 255, 255, .08); }
  .eqa__scan { flex: 1 1 auto; display: flex; align-items: center; gap: 10px; min-width: 0; overflow: hidden; font-size: .78rem; color: rgba(255, 255, 255, .5); }
  .eqa__scan-l { flex: none; letter-spacing: .08em; text-transform: uppercase; font-variation-settings: 'wght' 680; }
  .eqa__roster { position: relative; display: block; min-width: 0; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 85%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 85%, transparent); }
  .eqa__track { display: flex; gap: 6px; width: max-content; animation: eqaMarq 26s linear infinite; }
  .eqa__roster:hover .eqa__track { animation-play-state: paused; }
  @keyframes eqaMarq { to { transform: translateX(calc(-50% - 3px)); } }
  .eqa__track > span { flex: none; padding: 4px 9px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .12); color: rgba(255, 255, 255, .7); white-space: nowrap; animation: eqaChk 7s calc(var(--i) * .7s) ease-in-out infinite; }
  @keyframes eqaChk { 0%, 14%, 100% { border-color: rgba(255, 255, 255, .12); color: rgba(255, 255, 255, .7); background: transparent; } 5%, 9% { border-color: rgba(245, 184, 0, .8); color: #fff; background: rgba(245, 184, 0, .14); } }
  .eqa__send { flex: none; position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: 9px; min-height: 50px; padding: 0 24px; border: 0; border-radius: 999px; background: linear-gradient(135deg, #d0140f, #9b0505); color: #fff; font: inherit; font-size: 1rem; font-variation-settings: 'wght' 720; cursor: pointer; box-shadow: 0 12px 30px -12px rgba(224, 32, 28, .9), inset 0 1px 0 rgba(255, 255, 255, .25); transition: transform .2s, box-shadow .2s; }
  .eqa__send::before { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, .35) 50%, transparent 70%); transform: translateX(-120%); animation: eqaShine 3.6s 1s ease-in-out infinite; }
  @keyframes eqaShine { 0%, 60% { transform: translateX(-120%); } 100% { transform: translateX(120%); } }
  .eqa__send:hover { transform: translateY(-1px); box-shadow: 0 16px 36px -12px rgba(224, 32, 28, 1), inset 0 1px 0 rgba(255, 255, 255, .25); }
  .eqa__send :global(svg) { width: 17px; height: 17px; }
  .eqa__beam { position: absolute; left: 0; right: 0; top: 0; height: 40%; opacity: 0; pointer-events: none; background: linear-gradient(180deg, transparent, rgba(245, 184, 0, .18) 70%, rgba(245, 184, 0, .7) 100%); }
  /* thinking state while the AI "checks the fleet" */
  .is-think .eqa__beam { animation: eqaBeam 1s ease-in-out infinite; }
  @keyframes eqaBeam { 0% { opacity: 1; transform: translateY(-100%); } 100% { opacity: 1; transform: translateY(260%); } }
  .is-think .eqa__track { animation-duration: 4s; }
  .is-think .eqa__track > span { animation-duration: 1.2s; animation-delay: calc(var(--i) * .12s); }
  .is-think .eqa__send :global(svg) { animation: eqaNudge .6s ease-in-out infinite alternate; }
  @keyframes eqaNudge { to { transform: translateX(4px); } }

  .eqa__chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .eqa__try { font-size: .84rem; color: rgba(255, 255, 255, .5); margin-right: 2px; }
  .eqa__chips button { min-height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .16); background: rgba(255, 255, 255, .04); color: rgba(255, 255, 255, .88); font: inherit; font-size: .88rem; cursor: pointer; transition: background .2s, border-color .2s, color .2s; }
  .eqa__chips button:hover { background: rgba(245, 184, 0, .12); border-color: rgba(245, 184, 0, .7); color: #fff; }
  .eqa__note { margin: 2px 0 0; font-size: .82rem; line-height: 1.45; color: rgba(255, 255, 255, .5); }
  .eqa__note a { color: rgba(255, 255, 255, .85); }
  @media (max-width: 900px) {
    .eqa__shell { border-radius: 24px; } .eqa__card { grid-template-columns: minmax(0, 1fr); border-radius: 22.5px; }
    .eqa__copy { text-align: center; } .eqa__who, .eqa__how { justify-content: center; } .eqa__lede { margin-inline: auto; }
    .eqa__lab { justify-content: center; } .eqa__chips { justify-content: center; } .eqa__note { text-align: center; }
  }
  @media (max-width: 640px) {
    .eqa { padding: 28px 0 36px; }
    .eqa__shell { border-radius: 22px; }
    .eqa__card { gap: 20px; padding: 24px 16px 20px; border-radius: 20.5px; }
    .eqa__lede--long, .eqa__note--long, .eqa__how, .eqa__lab, .eqa__scan { display: none; }
    .eqa__lede--short, .eqa__note--short { display: block; }
    /* compact pill for the assistant */
    .eqa__who { display: inline-flex; gap: 8px; margin: 0 0 14px; padding: 5px 12px 5px 5px; border-radius: 999px; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12); }
    .eqa__av { width: 28px; height: 28px; border-radius: 50%; box-shadow: none; }
    .eqa__av i { display: none; }
    .eqa__avt { font-size: .7rem; }
    .eqa__name { display: flex; align-items: center; gap: 8px; }
    .eqa__name b { font-size: .88rem; }
    .eqa__name small { font-size: 0; gap: 0; }
    .eqa h2 { font-size: clamp(1.7rem, 8.6vw, 2.3rem); line-height: 1.08; text-wrap: balance; }
    .eqa__lede { margin: 10px auto 0; font-size: 1rem; line-height: 1.45; color: rgba(255, 255, 255, .78); }
    .eqa__form { gap: 12px; }
    .eqa__box { padding: 8px; border-radius: 16px; gap: 8px; }
    .eqa__box textarea, .eqa__type { font-size: 1rem; }
    .eqa__box textarea { min-height: 72px; }
    .eqa__bar { padding-top: 0; border-top: 0; }
    .eqa__send { justify-content: center; min-height: 48px; width: 100%; }
    .eqa__chips { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; margin: 0 -16px; padding: 2px 16px 4px; scrollbar-width: none; -webkit-mask-image: linear-gradient(90deg, transparent, #000 16px, #000 calc(100% - 16px), transparent); mask-image: linear-gradient(90deg, transparent, #000 16px, #000 calc(100% - 16px), transparent); }
    .eqa__chips::-webkit-scrollbar { display: none; }
    .eqa__chips button { flex: none; min-height: 34px; padding: 0 12px; font-size: .84rem; }
    .eqa__try { flex: none; display: inline; font-size: .8rem; }
    .eqa__note { margin: 0; font-size: .78rem; text-align: center; }
    .eqa__note a { white-space: nowrap; }
    .eqa__lede--short { max-width: none; white-space: nowrap; font-size: min(3.75vw, 1.1rem); letter-spacing: -.005em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .eqa__shell { opacity: 1; transform: none; transition: none; animation: none; }
    .eqa__dot, .eqa__av i, .eqa__glow, .eqa__track, .eqa__track > span, .eqa__send::before, .eqa__type::after { animation: none; }
  }
</style>
