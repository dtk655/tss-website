---
import rates from '../../../data/rental-rates.json';
import { loadCatalog, img } from '../../../lib/shopify.js';

const catalog = await loadCatalog();
const items = rates.map((r) => {
  const p = catalog.byHandle.get(r.handle);
  const cheapest = p?.variants?.filter((v) => v.availableForSale !== false)
    .sort((a, b) => parseFloat(a.price.amount) - parseFloat(b.price.amount))[0];
  const buy = cheapest ? parseFloat(cheapest.price.amount) : (p?.minPrice || r.fallbackBuy);
  return {
    handle: r.handle,
    title: r.title,
    fullTitle: p?.title || r.title,
    image: p?.featuredImage?.url ? img(p.featuredImage.url, 160) : '',
    variantId: cheapest?.id || null,
    variantTitle: cheapest && cheapest.title !== 'Default Title' ? cheapest.title : '',
    inCatalog: !!p,
    buy,
    daily: r.daily, weekly: r.weekly, monthly: r.monthly,
    placeholder: !!r.placeholder
  };
});
const anyPlaceholder = items.some((i) => i.placeholder);
const defaults = {
  'cone28inch': 40,
  'traffic-drum-4-6-hi-intensity-reflective-stripes-w-tire-ring': 12,
  'type-iii-breakaway-barricade-hi-intensity-left-stripes': 2,
  'roll-up-sign-36x36-with-reinforcement-ribs-black-orange-be-prepared-to-stop': 4,
  'k-stand-for-roll-up-signs-univeral-clamp-bracket': 4
};
const data = { items, defaults, anyPlaceholder };
---
<div class="rb" data-rb>
  <script type="application/json" data-rb-data set:html={JSON.stringify(data)}></script>

  <form class="rb__inputs" data-rb-form novalidate onsubmit="return false">
    <section class="rb__block" aria-labelledby="rb-items-h">
      <h2 id="rb-items-h" class="rb__h">What you need</h2>
      <ul class="rb__items" data-rb-items></ul>
      <div class="rb__add">
        <label for="rb-add" class="sr-only">Add an item</label>
        <select id="rb-add" class="input" data-rb-add></select>
        <button type="button" class="btn btn--sm btn--dark" data-rb-add-btn>Add item</button>
      </div>
    </section>

    <section class="rb__block" aria-labelledby="rb-job-h">
      <h2 id="rb-job-h" class="rb__h">Your jobs</h2>
      <div class="rb__row">
        <div class="field">
          <label for="rb-len">How long is a typical job?</label>
          <div class="rb__pair">
            <input id="rb-len" type="number" min="1" max="365" value="2" inputmode="numeric" data-rb-len />
            <select aria-label="Unit" data-rb-unit>
              <option value="1">days</option>
              <option value="7" selected>weeks</option>
              <option value="30">months</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="rb-jobs">Similar jobs per year</label>
          <input id="rb-jobs" type="number" min="1" max="100" value="4" inputmode="numeric" data-rb-jobs />
        </div>
      </div>
    </section>

    <details class="rb__block rb__own">
      <summary><span class="rb__h">Costs of owning and renting</span><span class="rb__sum-hint">Edit the assumptions</span></summary>
      <div class="rb__grid">
        <div class="field">
          <label for="rb-storage">Storage, per month</label>
          <p class="hint">Yard or warehouse space for this equipment.</p>
          <div class="rb__money"><span>$</span><input id="rb-storage" type="number" min="0" step="10" value="75" data-rb-storage /></div>
        </div>
        <div class="field">
          <label for="rb-wear">Wear and replacement, per year</label>
          <p class="hint">Share of the purchase price lost to damage, theft and wear.</p>
          <div class="rb__money rb__money--pct"><input id="rb-wear" type="number" min="0" max="100" step="1" value="20" data-rb-wear /><span>%</span></div>
        </div>
        <div class="field">
          <label for="rb-truck">Your trucking and labor, per job</label>
          <p class="hint">Hauling, setting up and picking up equipment you own.</p>
          <div class="rb__money"><span>$</span><input id="rb-truck" type="number" min="0" step="25" value="250" data-rb-truck /></div>
        </div>
        <div class="field">
          <label for="rb-deliv">Rental delivery and pickup, per job</label>
          <p class="hint">Your quote will list the exact delivery cost for your site.</p>
          <div class="rb__money"><span>$</span><input id="rb-deliv" type="number" min="0" step="25" value="150" data-rb-deliv /></div>
        </div>
      </div>
    </details>
  </form>

  <aside class="rb__out" aria-labelledby="rb-out-h">
    <div class="rb__panel">
      <h2 id="rb-out-h" class="rb__h">The numbers</h2>
      <p class="rb__verdict" data-rb-verdict aria-live="polite"></p>

      <table class="rb__table">
        <caption class="sr-only">Cost to rent compared with cost to buy</caption>
        <thead><tr><th scope="col"></th><th scope="col">Rent</th><th scope="col">Buy</th></tr></thead>
        <tbody>
          <tr><th scope="row">This job</th><td data-rb-rent-job></td><td data-rb-buy-job></td></tr>
          <tr><th scope="row">12 months</th><td data-rb-rent-yr></td><td data-rb-buy-yr></td></tr>
          <tr><th scope="row">Break-even</th><td colspan="2" data-rb-be></td></tr>
        </tbody>
      </table>

      <figure class="rb__chart">
        <div data-rb-chart></div>
        <figcaption class="rb__cap" data-rb-cap></figcaption>
      </figure>

      {anyPlaceholder && <p class="rb__est">Rental rates shown are estimates. Your quote will have exact pricing.</p>}

      <div class="rb__actions">
        <button type="button" class="btn" data-rb-quote>Get a rental quote</button>
        <button type="button" class="btn btn--ghost" data-rb-buy>Buy these online</button>
        <button type="button" class="btn btn--ghost" data-rb-ask>
          <svg viewBox="0 0 24 28" width="18" height="21" aria-hidden="true"><path d="M10 2h4l7 21H3z" fill="#f26a1b"/><path d="M8.3 9h7.4l1.4 4.2H6.9zM5.6 17h12.8l1.2 3.6H4.4z" fill="#fff"/><rect x="1" y="23" width="22" height="4" rx="1.5" fill="currentColor"/></svg>
          Ask Conner
        </button>
      </div>
      <p class="rb__fine">Rentals, delivery and setup are available in NJ, NY, PA and CT. Products you buy ship nationwide.</p>
    </div>
  </aside>
</div>

<script>
  type Item = { handle: string; title: string; fullTitle: string; image: string; variantId: string | null; variantTitle: string; inCatalog: boolean; buy: number; daily: number; weekly: number; monthly: number; placeholder: boolean };
  const root = document.querySelector<HTMLElement>('[data-rb]')!;
  const data = JSON.parse(root.querySelector('[data-rb-data]')!.textContent || '{}') as { items: Item[]; defaults: Record<string, number>; anyPlaceholder: boolean };
  const byHandle = new Map(data.items.map((i) => [i.handle, i]));
  const q = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as unknown as T;
  const usd = (n: number, cents = false) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: cents ? 2 : 0, minimumFractionDigits: cents ? 2 : 0 });
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  // selected list: handle -> qty
  const list = new Map<string, number>(Object.entries(data.defaults).filter(([h]) => byHandle.has(h)));

  // Cheapest mix of monthly / weekly / daily rates for d days of one unit.
  function rentUnit(it: Item, d: number) {
    if (d <= 0) return 0;
    const months = Math.floor(d / 30);
    const r = d - months * 30;
    const weeks = Math.floor(r / 7);
    const days = r - weeks * 7;
    const tail = Math.min(it.weekly, days * it.daily);
    return months * it.monthly + Math.min(it.monthly, weeks * it.weekly + tail);
  }

  function inputs() {
    const num = (s: string, min = 0) => Math.max(min, parseFloat((q<HTMLInputElement>(s)).value) || 0);
    const jobDays = Math.max(1, Math.round(num('[data-rb-len]', 1) * parseInt(q<HTMLSelectElement>('[data-rb-unit]').value, 10)));
    return {
      jobDays: Math.min(jobDays, 365),
      jobs: Math.max(1, Math.round(num('[data-rb-jobs]', 1))),
      storage: num('[data-rb-storage]'),
      wear: num('[data-rb-wear]') / 100,
      truck: num('[data-rb-truck]'),
      deliv: num('[data-rb-deliv]')
    };
  }

  function model() {
    const a = inputs();
    const lines = [...list].map(([h, qty]) => ({ it: byHandle.get(h)!, qty })).filter((l) => l.qty > 0);
    const purchase = lines.reduce((s, l) => s + l.it.buy * l.qty, 0);
    const rentFor = (d: number) => lines.reduce((s, l) => s + rentUnit(l.it, d) * l.qty, 0);
    const ownFixed = purchase + a.storage * 12 + purchase * a.wear;
    // Cumulative cost over x days of use in a year, used in jobs of jobDays.
    const jobsAt = (x: number) => (x <= 0 ? 0 : Math.ceil(x / a.jobDays));
    const rentAt = (x: number) => {
      const full = Math.floor(x / a.jobDays), rem = x - full * a.jobDays;
      return full * rentFor(a.jobDays) + rentFor(rem) + jobsAt(x) * a.deliv;
    };
    const buyAt = (x: number) => ownFixed + jobsAt(x) * a.truck;
    let breakEven: number | null = null;
    for (let x = 1; x <= 365; x++) if (rentAt(x) >= buyAt(x)) { breakEven = x; break; }
    const usage = Math.min(365, a.jobDays * a.jobs);
    return {
      a, lines, purchase, usage, breakEven, rentAt, buyAt,
      rentJob: rentFor(a.jobDays) + a.deliv,
      buyJob: purchase + a.truck,
      rentYr: rentAt(usage),
      buyYr: buyAt(usage)
    };
  }

  /* ---------- item list ---------- */
  function renderItems() {
    const ul = q('[data-rb-items]');
    ul.innerHTML = [...list].map(([h, qty]) => {
      const it = byHandle.get(h)!;
      return `<li class="rb__item" data-h="${esc(h)}">
        ${it.image ? `<img src="${esc(it.image)}" alt="" width="56" height="56" loading="lazy" />` : '<span class="rb__noimg" aria-hidden="true"></span>'}
        <div class="rb__it">
          <span class="rb__it-t">${esc(it.title)}</span>
          <span class="rb__it-p">Buy ${usd(it.buy, true)} each. Rent from ${usd(it.daily, true)} a day, ${usd(it.weekly, true)} a week</span>
        </div>
        <div class="rb__qty">
          <button type="button" data-dec aria-label="One fewer ${esc(it.title)}">−</button>
          <input type="number" min="0" value="${qty}" inputmode="numeric" aria-label="Quantity of ${esc(it.title)}" />
          <button type="button" data-inc aria-label="One more ${esc(it.title)}">+</button>
        </div>
        <button type="button" class="rb__rm" data-rm aria-label="Remove ${esc(it.title)}">Remove</button>
      </li>`;
    }).join('') || '<li class="rb__none">Add at least one item to compare.</li>';
    const sel = q<HTMLSelectElement>('[data-rb-add]');
    const left = data.items.filter((i) => !list.has(i.handle));
    sel.innerHTML = left.map((i) => `<option value="${esc(i.handle)}">${esc(i.title)}</option>`).join('');
    sel.disabled = q<HTMLButtonElement>('[data-rb-add-btn]').disabled = left.length === 0;
    if (!left.length) sel.innerHTML = '<option>Every item is on your list</option>';
  }

  root.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const li = t.closest<HTMLElement>('[data-h]');
    if (li) {
      const h = li.dataset.h!;
      if (t.closest('[data-inc]')) list.set(h, (list.get(h) || 0) + 1);
      else if (t.closest('[data-dec]')) list.set(h, Math.max(0, (list.get(h) || 0) - 1));
      else if (t.closest('[data-rm]')) { list.delete(h); renderItems(); update(); q<HTMLSelectElement>('[data-rb-add]').focus(); return; }
      else return;
      (li.querySelector('input') as HTMLInputElement).value = String(list.get(h));
      update();
    }
    if (t.closest('[data-rb-add-btn]')) {
      const h = q<HTMLSelectElement>('[data-rb-add]').value;
      if (byHandle.has(h)) { list.set(h, 10); renderItems(); update(); (root.querySelector(`[data-h="${CSS.escape(h)}"] input`) as HTMLInputElement)?.focus(); }
    }
  });
  root.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    const li = t.closest<HTMLElement>('[data-h]');
    if (li && t.matches('input')) list.set(li.dataset.h!, Math.max(0, parseInt(t.value, 10) || 0));
    update();
  });
  root.addEventListener('change', () => update());

  /* ---------- chart ---------- */
  function chart(m: ReturnType<typeof model>) {
    const W = 560, H = 280, L = 58, R = 64, T = 18, B = 40;
    const be = m.breakEven;
    const xMax = Math.min(365, Math.max(30, Math.ceil(Math.max(m.usage, be || 0) * 1.25 / 10) * 10));
    let yMax = 0;
    const pts = (f: (x: number) => number) => { const a: [number, number][] = []; for (let x = 0; x <= xMax; x++) { const y = f(x); yMax = Math.max(yMax, y); a.push([x, y]); } return a; };
    const rp = pts(m.rentAt), bp = pts(m.buyAt);
    yMax = niceMax(yMax || 1);
    const sx = (x: number) => L + (x / xMax) * (W - L - R);
    const sy = (y: number) => H - B - (y / yMax) * (H - T - B);
    const path = (a: [number, number][]) => a.map(([x, y], i) => `${i ? 'L' : 'M'}${sx(x).toFixed(1)},${sy(y).toFixed(1)}`).join('');
    const yt = [0, 0.25, 0.5, 0.75, 1].map((f) => f * yMax);
    const xt = ticks(xMax);
    const rEnd = rp[rp.length - 1], bEnd = bp[bp.length - 1];
    let ry = sy(rEnd[1]), by = sy(bEnd[1]);
    if (Math.abs(ry - by) < 16) { if (ry < by) { ry -= 8; by += 8; } else { ry += 8; by -= 8; } }
    const usageX = sx(Math.min(m.usage, xMax));
    const summary = be
      ? `Cumulative cost over days of use per year. Renting and buying cross at ${be} days. You use this equipment about ${m.usage} days a year.`
      : `Cumulative cost over days of use per year. Renting stays below buying for the whole year.`;
    return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(summary)}" class="rb__svg">
      ${yt.map((v) => `<line x1="${L}" x2="${W - R}" y1="${sy(v)}" y2="${sy(v)}" class="g"/><text x="${L - 8}" y="${sy(v) + 4}" text-anchor="end" class="t">${short(v)}</text>`).join('')}
      ${xt.map((v) => `<text x="${sx(v)}" y="${H - B + 18}" text-anchor="middle" class="t">${v}</text>`).join('')}
      <text x="${(L + W - R) / 2}" y="${H - 6}" text-anchor="middle" class="t">Days of use per year</text>
      <line x1="${usageX}" x2="${usageX}" y1="${T}" y2="${H - B}" class="use"/>
      <text x="${usageX + 5}" y="${T + 10}" class="t t--use">You: ${m.usage} days</text>
      ${be && be <= xMax ? `<line x1="${sx(be)}" x2="${sx(be)}" y1="${sy(m.buyAt(be))}" y2="${H - B}" class="be"/><circle cx="${sx(be)}" cy="${sy(m.buyAt(be))}" r="5" class="bed"/><text x="${sx(be) - 8}" y="${sy(m.buyAt(be)) + 22}" text-anchor="end" class="t t--be">Break-even ${be} days</text>` : ''}
      <path d="${path(bp)}" class="l l--buy"/>
      <path d="${path(rp)}" class="l l--rent"/>
      <text x="${W - R + 6}" y="${by + 4}" class="lab lab--buy">Buy</text>
      <text x="${W - R + 6}" y="${ry + 4}" class="lab lab--rent">Rent</text>
    </svg>`;
  }
  function niceMax(v: number) { const p = Math.pow(10, Math.floor(Math.log10(v))); const n = v / p; return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5 ? 2.5 : n <= 5 ? 5 : 10) * p; }
  function ticks(max: number) { const step = max <= 60 ? 10 : max <= 150 ? 30 : 60; const a = []; for (let v = 0; v <= max; v += step) a.push(v); return a; }
  function short(v: number) { return v >= 1000 ? '$' + (v / 1000).toFixed(v % 1000 ? 1 : 0).replace(/\.0$/, '') + 'k' : '$' + Math.round(v); }

  /* ---------- results ---------- */
  let last: ReturnType<typeof model>;
  function update() {
    const m = (last = model());
    const set = (s: string, v: string) => { q(s).textContent = v; };
    const empty = m.lines.length === 0;
    root.classList.toggle('is-empty', empty);
    if (empty) {
      q('[data-rb-verdict]').textContent = 'Add equipment to see what renting and buying would cost.';
      ['[data-rb-rent-job]', '[data-rb-buy-job]', '[data-rb-rent-yr]', '[data-rb-buy-yr]', '[data-rb-be]'].forEach((s) => set(s, '–'));
      q('[data-rb-chart]').innerHTML = ''; set('[data-rb-cap]', '');
      return;
    }
    set('[data-rb-rent-job]', usd(m.rentJob));
    set('[data-rb-buy-job]', usd(m.buyJob));
    set('[data-rb-rent-yr]', usd(m.rentYr));
    set('[data-rb-buy-yr]', usd(m.buyYr));
    set('[data-rb-be]', m.breakEven ? `${m.breakEven} days of use per year` : 'Renting stays cheaper all year');
    let verdict: string;
    if (!m.breakEven) verdict = 'Renting is cheaper, even if you used this equipment every day of the year.';
    else if (m.usage < m.breakEven) verdict = `Renting is cheaper unless you use these more than ${m.breakEven} days a year. You're at about ${m.usage}.`;
    else verdict = `Buying pays off. You use these about ${m.usage} days a year, and owning beats renting after ${m.breakEven}.`;
    const v = q('[data-rb-verdict]');
    v.textContent = verdict;
    v.dataset.win = !m.breakEven || m.usage < m.breakEven ? 'rent' : 'buy';
    q('[data-rb-chart]').innerHTML = chart(m);
    const diff = Math.abs(m.rentYr - m.buyYr);
    set('[data-rb-cap]', `Over 12 months at ${m.a.jobs} job${m.a.jobs > 1 ? 's' : ''} of ${m.a.jobDays} days, ${m.rentYr <= m.buyYr ? 'renting' : 'buying'} saves about ${usd(diff)}.`);
  }

  /* ---------- actions ---------- */
  function summaryText(m: ReturnType<typeof model>) {
    const items = m.lines.map((l) => `${l.qty} × ${l.it.title}`).join(', ');
    return `I'm comparing renting vs buying: ${items}. Jobs run about ${m.a.jobDays} days, ${m.a.jobs} times a year (${m.usage} days of use). The calculator says renting costs about ${usd(m.rentYr)} a year and buying about ${usd(m.buyYr)}${m.breakEven ? `, with break-even at ${m.breakEven} days` : ''}. Which makes more sense for me, and can you help me get a quote?`;
  }
  q('[data-rb-quote]').addEventListener('click', () => {
    const m = last; if (!m.lines.length) return;
    const w = (window as any).TSSQuote;
    const note = `About ${m.a.jobDays} days per job, ${m.a.jobs} jobs a year`;
    w?.add(m.lines.map((l) => ({ title: l.it.fullTitle, handle: l.it.inCatalog ? l.it.handle : '', image: l.it.image, qty: l.qty, mode: 'rent', note })));
  });
  q('[data-rb-buy]').addEventListener('click', async (e) => {
    const m = last; if (!m.lines.length) return;
    const btn = e.currentTarget as HTMLButtonElement;
    const cart = (window as any).TSSCart;
    const buyable = m.lines.filter((l) => l.it.variantId);
    if (!cart || !buyable.length) { (window as any).TSSToast?.('These items need a quote. Use Get a rental quote instead.'); return; }
    btn.disabled = true; const label = btn.textContent; btn.textContent = 'Adding to cart…';
    try { for (const l of buyable) await cart.add(l.it.variantId, l.qty); }
    catch { /* TSSCart shows its own error */ }
    finally { btn.disabled = false; btn.textContent = label; }
  });
  q('[data-rb-ask]').addEventListener('click', () => {
    const m = last; if (!m.lines.length) return;
    const chat = (window as any).TSSChat;
    if (chat) chat.ask(summaryText(m));
    else (window as any).TSSToast?.('Conner is still loading. Try again in a moment.');
  });

  renderItems();
  update();
</script>

<style is:global>
  .rb { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 520px); gap: 28px; align-items: start; }
  .rb__inputs { display: grid; gap: 20px; }
  .rb__block { background: var(--paper); border-radius: var(--sign-r); padding: 22px 22px 24px; border: 1px solid var(--concrete-dark); }
  .rb__h { font-size: var(--fs-2); font-weight: 900; margin: 0 0 14px; display: block; }
  .rb__items { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 8px; }
  .rb__item { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto auto; gap: 12px; align-items: center; padding: 8px; border-radius: var(--r-s); background: var(--haze); }
  .rb__item img, .rb__noimg { width: 56px; height: 56px; object-fit: contain; background: #fff; border-radius: 6px; }
  .rb__it { display: grid; gap: 2px; min-width: 0; }
  .rb__it-t { font-weight: 800; line-height: 1.2; }
  .rb__it-p { font-size: .85rem; color: var(--ink-soft); line-height: 1.3; }
  .rb__qty { display: flex; align-items: center; gap: 4px; }
  .rb__qty button { width: 36px; height: 36px; border: 1.5px solid var(--line-dark); background: #fff; border-radius: 7px; font-weight: 900; font-size: 1.1rem; cursor: pointer; }
  .rb__qty button:hover { border-color: var(--steel); }
  .rb__qty input { width: 62px; height: 36px; text-align: center; border: 1.5px solid var(--line-dark); border-radius: 7px; font-weight: 800; }
  .rb__rm { background: none; border: 0; color: var(--ink-soft); text-decoration: underline; cursor: pointer; font-size: .88rem; padding: 6px; }
  .rb__none { color: var(--ink-soft); padding: 8px 0; }
  .rb__add { display: flex; gap: 8px; }
  .rb__add select { flex: 1; min-height: 42px; padding: 8px 12px; border: 1.5px solid var(--line-dark); border-radius: var(--r-s); background: #fff; }
  .rb__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .rb__pair { display: grid; grid-template-columns: 1fr 1.1fr; gap: 8px; }
  .rb__own summary { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; cursor: pointer; list-style: none; }
  .rb__own summary::-webkit-details-marker { display: none; }
  .rb__own summary .rb__h { margin: 0; }
  .rb__own summary .rb__h::before { content: '+'; display: inline-block; width: 1.1em; color: var(--red); }
  .rb__own[open] summary .rb__h::before { content: '−'; }
  .rb__sum-hint { color: var(--ink-soft); font-size: .92rem; }
  .rb__own[open] summary { margin-bottom: 16px; }
  .rb__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 16px; }
  .rb__money { display: flex; align-items: center; gap: 6px; }
