---
// Full page for a rental unit (equipment and fleet): big media hero, overview, gallery, specs,
// uses, how renting works, other units and questions. Every number shown comes from the product's own data.
import { img } from '../lib/shopify.js';
import { cutouts } from '../lib/cutouts.js';
import { mediaFor } from '../lib/unitMedia.js';
import { parseDescription, deriveSpecs, deriveBadges, USES } from '../lib/productInfo.js';
import { PHONE, PHONE_TEL, EMAIL } from '../lib/config.js';

const { p, crumbCol, related = [], sellable = false } = Astro.props;
const isFleet = p.collections.includes('truck-rentals');
const kind = isFleet ? 'Truck Fleet' : 'Equipment';
const backHref = isFleet ? '/pages/fleet' : '/pages/equipment';
const media = mediaFor(p.handle);
const cut = cutouts[p.handle];
const shopImgs = (p.images || []).map((i) => ({ src: img(i.url, 1400), alt: i.altText || p.title, product: true }));

const info = parseDescription(p.descriptionHtml || p.description);
const specs = deriveSpecs({ title: p.title, handle: p.handle, text: info.text, options: p.options || [], specLines: info.specLines });
const badges = deriveBadges(`${p.title} ${info.text}`);
const lead = info.lead.slice(0, 2);
const leadText = lead.length ? lead : [isFleet ? 'Ready for your crew, maintained in our own yard and available by the day, week or month.' : 'Delivered to your site, set up and picked up when the job is done.'];
const benefits = info.features.filter((f) => f.label).slice(0, 6);
const points = info.features.filter((f) => !f.label).slice(0, 6);
const uses = (info.uses.length ? info.uses : USES[isFleet ? 'truck-rentals' : 'equipment-rentals'] || []).slice(0, 6);
const sizes = (p.options || []).find((o) => !/title/i.test(o.name) && o.values.length > 1);
const allSpecs = [
  ...specs,
  sizes && [sizes.name.charAt(0).toUpperCase() + sizes.name.slice(1), sizes.values.join(', ')],
  ['Rental terms', 'Daily, weekly, monthly or long-term'],
  ['Service area', 'New Jersey, New York, Pennsylvania and Connecticut'],
  sellable && ['Buy it', 'Also available to purchase'],
  ['Yard', '448 Hollywood Avenue, South Plainfield, NJ']
].filter(Boolean);

// hero: real video/photo when we have one, otherwise the cut-out on a stage
const hero = media.hero || null;
const stageImg = cut || shopImgs[0]?.src;
// Real photos lead; the store's product shots only fill in when a unit has fewer than 3 real photos.
const realG = media.gallery || [];
const gallery = (realG.length >= 3 ? realG : realG.length ? [...realG, ...shopImgs] : shopImgs.length >= 2 ? shopImgs : []).slice(0, 9);

const quote = `/pages/request-a-quote?${new URLSearchParams({ type: 'rental', add: p.handle, t: p.title }).toString()}`;
const buyQuote = `/pages/request-a-quote?${new URLSearchParams({ type: 'products', add: p.handle, t: p.title }).toString()}`;
const short = p.title.replace(/\s*\(.*?\)\s*/g, ' ').replace(/\s+-\s+.*$/, '').trim();
const tagline = info.kicker || info.tagline[0] || (isFleet ? 'Rent it with or without our crew.' : 'Delivered, set up and picked up.');
const steps = [
  ['Tell Us The Job', 'Dates, location and what the work needs. Online or by phone.'],
  ['We Confirm And Schedule', 'Availability and rates for your dates, usually the same day.'],
  [isFleet ? 'Ready For Your Job' : 'Delivered And Set Up', isFleet ? 'Inspected and ready from our South Plainfield yard.' : 'Dropped at your site and set up the way the job needs it.'],
  ['Picked Up When You’re Done', 'Extend any time. We collect it when the job wraps.']
];
const faqs = [
  ['Where do you deliver?', 'Anywhere in New Jersey, New York, Pennsylvania and Connecticut.'],
  ['How long can I rent it?', 'Daily, weekly, monthly or long-term. Tell us your dates and we’ll quote the rate that fits.'],
  isFleet ? ['Can your crew run it for us?', 'Yes. Our certified, experienced crews can run it as part of a lane closure, or you can rent it on its own.'] : ['Do you set it up?', 'Yes. We deliver it, set it up and pick it up. Our certified, experienced crews can also run the whole closure.'],
  sellable && ['Can I buy one?', 'Yes. It’s also available to purchase. Request a quote and choose Buy.'],
  ['How do I get pricing?', 'Request a quote online or call us. Rates depend on the dates, location and length of the rental.']
].filter(Boolean);
const nav = [['overview', 'Overview'], gallery.length > 0 && ['gallery', 'Gallery'], ['specs', 'Specs'], ['how', 'How It Works'], ['faq', 'Questions']].filter(Boolean);
const AR = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const DOC = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5 M12 11v6 M9.5 14.5 12 17l2.5-2.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const USE_IC = ['M12 3l9 16H3z M12 10v4 M12 17v.01', 'M4 17l5-5 4 4 7-8', 'M12 21s-7-6.2-7-11.5a7 7 0 1 1 14 0C19 14.8 12 21 12 21z', 'M3 12h4l3 8 4-16 3 8h4', 'M12 3v4 M12 17v4 M3 12h4 M17 12h4 M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z', 'M5 21V5l7-2 7 2v16'];
---
<div class="un" data-unit data-title={p.title} data-handle={p.handle}>
  <!-- ============ HERO ============ -->
  <section class={`un__hero${hero ? ' un__hero--bleed' : ''}`}>
    <div class="wrap un__hin">
      <div class="un__copy">
        <nav class="un__crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={backHref}>{kind}</a><span>/</span><b aria-current="page">{short}</b></nav>
        <p class="un__k"><span></span>{kind} rental</p>
        <h1 class="un__h">{p.title}</h1>
        <p class="un__lede"><span>{isFleet ? 'Available to rent, with or without our crew.' : 'Available to rent or buy.'}</span></p>
        <ul class="un__chips">
          <li>Daily, weekly or monthly</li>
          <li>{isFleet ? 'Maintained in our own yard' : 'Delivered and set up'}</li>
          <li>NJ, NY, PA and CT</li>
          {sellable && <li>Also for sale</li>}
          {badges.map((b) => <li class="un__std">{b.k}</li>)}
        </ul>
        <div class="un__ctas">
          <a href={quote} class="ub ub--red">Request a Quote<Fragment set:html={AR} /></a>
          <button type="button" class="ub ub--glass" data-print><Fragment set:html={DOC} />Spec Sheet</button>
          <button type="button" class="ub ub--glass" data-ask><span class="ub__ai">AI</span>Ask a Question</button>
        </div>
        <p class="un__call">Rather talk? Call <a href={PHONE_TEL}>{PHONE}</a></p>
      </div>
      <div class={`un__media${hero ? ' un__media--photo' : ''}${hero?.ar ? ' un__media--ar' : ''}`} style={hero?.ar ? `--ar:${hero.ar}` : undefined}>
        {hero?.video ? (
          <video class="un__vid" style={hero.pos ? `object-position:${hero.pos}` : undefined} muted loop playsinline autoplay preload="auto" poster={hero.src} data-src={hero.video} data-src-sm={media.heroSm} aria-label={hero.alt}></video>
        ) : hero ? (
          <img class="un__photo" style={hero.pos ? `object-position:${hero.pos}` : undefined} src={hero.src} alt={hero.alt} fetchpriority="high" />
        ) : null}
        {hero && <span class="un__fade" aria-hidden="true"></span>}
        {!hero && (
          <div class="un__stage"><img src={stageImg} alt={p.title} fetchpriority="high" /><span class="un__floor" aria-hidden="true"></span></div>
        )}
      </div>
    </div>
  </section>

  <nav class="un__nav" aria-label="On this page" data-unav>
    <div class="wrap un__navin">
      <div class="un__navl">{nav.map(([id, l]) => <a href={`#${id}`} data-unav-a={id}>{l}</a>)}</div>
      <a href={quote} class="ub ub--red ub--sm">Request a Quote</a>
    </div>
  </nav>

  <!-- ============ OVERVIEW ============ -->
  <section class="us" id="overview">
    <div class="wrap">
      <div class="us__h">
        <p class="un__k un__k--dk"><span></span>Overview</p>
        <h2>{short}, <em>ready for your job.</em></h2>
      </div>
      <div class="ov">
        <div class="ov__txt">
          {leadText.map((l) => <p>{l}</p>)}
          {points.length > 0 && <ul class="ov__pts">{points.map((x) => <li>{x.text}</li>)}</ul>}
        </div>
        {benefits.length > 0 && (
          <ul class="ov__ben">
            {benefits.map((b, i) => (
              <li><span class="ov__n">{String(i + 1).padStart(2, '0')}</span><b>{b.label}</b><span>{b.text}</span></li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>

  <slot name="after-overview" />

  <!-- ============ GALLERY ============ -->
  {gallery.length > 0 && (
    <section class="us us--dark" id="gallery">
      <div class="wrap">
        <div class="us__h">
          <p class="un__k"><span></span>Gallery</p>
          <h2>See it <em>on the job.</em></h2>
        </div>
        <ul class={`gl gl--${gallery.length}`}>
          {gallery.map((g, i) => (
            <li class={g.product ? 'gl--prod' : ''}>
              <button type="button" data-gl={i} aria-label={`Open ${g.alt}`}>
                {g.video ? <video src={g.video} poster={g.src} muted loop playsinline autoplay preload="metadata"></video> : <img src={g.src} alt={g.alt} loading="lazy" />}
                {g.video && <span class="gl__play" aria-hidden="true">Video</span>}
              </button>
            </li>
          ))}
        </ul>
      </div>
      <dialog class="glb" data-glb aria-label="Gallery">
        <button type="button" class="glb__x" data-glb-x aria-label="Close">×</button>
        <button type="button" class="glb__nv glb__nv--p" data-glb-p aria-label="Previous">‹</button>
        <div class="glb__v" data-glb-v></div>
        <button type="button" class="glb__nv glb__nv--n" data-glb-n aria-label="Next">›</button>
        <script type="application/json" data-glb-list set:html={JSON.stringify(gallery)} />
      </dialog>
    </section>
  )}

  <!-- ============ SPECS ============ -->
  <section class="us" id="specs">
    <div class="wrap sp2">
      <div>
        <div class="us__h">
          <p class="un__k un__k--dk"><span></span>Specifications</p>
          <h2>The <em>details.</em></h2>
        </div>
        <table class="spt"><tbody>{allSpecs.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}</tbody></table>
      </div>
      <aside class="sp2__card">
        <p class="sp2__k">For bids and submittals</p>
        <h3>Get the spec sheet</h3>
        <p>A one-page sheet with the photo, specs and rental details. Need certification documents or manufacturer data? Our team will send them over.</p>
        <button type="button" class="ub ub--red" data-print><Fragment set:html={DOC} />Download Spec Sheet</button>
        <a href={quote} class="ub ub--line">Request Documents</a>
        {uses.length > 0 && (
          <>
            <p class="sp2__k sp2__k--u">Common uses</p>
            <ul class="sp2__uses">{uses.map((u, i) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d={USE_IC[i % USE_IC.length]} /></svg>{u}</li>)}</ul>
          </>
        )}
      </aside>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="us us--haze" id="how">
    <div class="wrap">
      <div class="us__h us__h--row">
        <div>
          <p class="un__k un__k--dk"><span></span>How renting works</p>
          <h2>From quote <em>to job site.</em></h2>
        </div>
        <a href={quote} class="ub ub--red">Start Your Quote<Fragment set:html={AR} /></a>
      </div>
      <ol class="hw">
        {steps.map(([t, d], i) => <li><span>{i + 1}</span><b>{t}</b><p>{d}</p></li>)}
      </ol>
      {sellable && <p class="hw__buy">Want to own one? <a href={buyQuote}>Request a purchase quote</a>.</p>}
    </div>
  </section>

  <!-- ============ MORE ============ -->
  {related.length > 0 && (
    <section class="us">
      <div class="wrap">
        <div class="us__h us__h--row">
          <div>
            <p class="un__k un__k--dk"><span></span>More {kind.toLowerCase()}</p>
            <h2>Complete <em>the setup.</em></h2>
          </div>
          <a href={backHref} class="ub ub--line">See All {kind}<Fragment set:html={AR} /></a>
        </div>
        <ul class="mr">
          {related.slice(0, 4).map((r) => (
            <li><a href={`/products/${r.handle}`}><span class="mr__i"><img src={cutouts[r.handle] || img(r.featuredImage?.url, 500)} alt="" loading="lazy" /></span><b>{r.title.replace(/\s*\(.*?\)\s*/g, ' ').trim()}</b><span class="mr__go">View<Fragment set:html={AR} /></span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ============ QUESTIONS ============ -->
  <section class="us us--haze" id="faq">
    <div class="wrap fq">
      <div>
        <p class="un__k un__k--dk"><span></span>Questions</p>
        <h2 class="fq__h">Good <em>questions.</em></h2>
        <p class="fq__p">Ask our AI assistant anything about the {short.toLowerCase()}, or call <a href={PHONE_TEL}>{PHONE}</a>.</p>
        <button type="button" class="ub ub--dark" data-ask><span class="ub__ai">AI</span>Ask a Question</button>
      </div>
      <div class="fq__list">{faqs.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}</div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="ucta">
    <div class="wrap ucta__in">
      <div><h2>Need {short.toLowerCase().startsWith('a') ? 'an' : 'a'} {short} <em>on your job?</em></h2><p>Delivered across NJ, NY, PA and CT. Daily, weekly and monthly rates.</p></div>
      <div class="ucta__b"><a href={quote} class="ub ub--red">Request a Quote<Fragment set:html={AR} /></a><a href={PHONE_TEL} class="ub ub--glass">Call {PHONE}</a></div>
    </div>
  </section>

  <!-- printable spec sheet -->
  <div class="usheet" aria-hidden="true">
    <div class="usheet__top"><img src="/brand/tss-logo.webp" alt="" width="200" /><span>Traffic Safety Service · South Plainfield, NJ · {PHONE} · {EMAIL}</span></div>
    <div class="usheet__main">
      <img class="usheet__img" src={hero && !hero.video ? hero.src : stageImg} alt="" />
      <div><p class="usheet__cat">{kind} rental</p><h2>{p.title}</h2>{badges.length > 0 && <p class="usheet__std">{badges.map((b) => b.k).join(' · ')}</p>}<p>{leadText[0]}</p></div>
    </div>
    <table><tbody>{allSpecs.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}</tbody></table>
    {benefits.length > 0 && <ul>{benefits.map((b) => <li>{b.label}: {b.text}</li>)}</ul>}
    <p class="usheet__foot">trafficsafetyservice.com/products/{p.handle} · Request a quote at {PHONE}. Specifications subject to change.</p>
  </div>
</div>

<script>
  {
    const u = document.querySelector('[data-unit]');
    if (u) {
      const title = u.dataset.title;
      document.querySelectorAll('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));
      document.querySelectorAll('[data-ask]').forEach((b) => b.addEventListener('click', () => window.TSSChat?.ask(`I'm looking at the ${title}. Can you tell me more about it and how renting it works?`)));
      // hero video: phones get the smaller file
      const v = u.querySelector('.un__vid');
      if (v && v.dataset.srcSm && innerWidth < 900) { v.src = v.dataset.srcSm; } else if (v) { v.src = v.dataset.src; }
      if (v) { if (matchMedia('(prefers-reduced-motion: reduce)').matches) v.removeAttribute('autoplay'); else v.play().catch(() => {}); }
      // section nav highlight
      const links = [...u.querySelectorAll('[data-unav-a]')];
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a) => a.classList.toggle('is-on', a.dataset.unavA === e.target.id)); }), { rootMargin: '-45% 0px -50% 0px' });
        links.forEach((a) => { const s = document.getElementById(a.dataset.unavA); if (s) io.observe(s); });
        const first = document.getElementById('overview');
        addEventListener('scroll', () => { if (first && first.getBoundingClientRect().top > innerHeight * .5) links.forEach((a) => a.classList.remove('is-on')); }, { passive: true });
      }
      // gallery lightbox
      const dlg = u.querySelector('[data-glb]');
      if (dlg) {
        const list = JSON.parse(dlg.querySelector('[data-glb-list]').textContent);
        const view = dlg.querySelector('[data-glb-v]');
        let i = 0;
        const show = (n) => { i = (n + list.length) % list.length; const g = list[i]; view.innerHTML = g.video ? `<video src="${g.video}" poster="${g.src}" autoplay muted loop playsinline controls></video>` : `<img src="${g.src}" alt="">`; };
        u.querySelectorAll('[data-gl]').forEach((b) => b.addEventListener('click', () => { show(+b.dataset.gl); dlg.showModal(); }));
        dlg.querySelector('[data-glb-x]').addEventListener('click', () => dlg.close());
        dlg.querySelector('[data-glb-p]').addEventListener('click', () => show(i - 1));
        dlg.querySelector('[data-glb-n]').addEventListener('click', () => show(i + 1));
        dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
        dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(i + 1); if (e.key === 'ArrowLeft') show(i - 1); });
        dlg.addEventListener('close', () => { view.innerHTML = ''; });
      }
    }
  }
</script>

<style>
  .un { background: #fff; }
  .un__k { display: flex; align-items: center; gap: 12px; margin: 0 0 14px; color: var(--gold); font-size: .78rem; letter-spacing: .18em; text-transform: uppercase; font-variation-settings: 'wght' 720; }
  .un__k span { width: 30px; height: 3px; border-radius: 2px; background: var(--red); }
  .un__k--dk { color: var(--steel); }
  .ub { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 50px; padding: 0 22px; border-radius: 999px; border: 1.5px solid transparent; font: inherit; font-size: .98rem; font-variation-settings: 'wght' 690; text-decoration: none; white-space: nowrap; cursor: pointer; transition: background .2s, color .2s, border-color .2s, transform .2s; }
  .ub :global(svg) { width: 18px; height: 18px; flex: none; }
  .ub:hover { transform: translateY(-1px); }
  .ub--red { background: var(--red); color: #fff; box-shadow: 0 14px 28px -16px rgba(182, 6, 6, .9); }
  .ub--red:hover { background: var(--red-press); }
  .ub--glass { border-color: rgba(255, 255, 255, .28); background: rgba(255, 255, 255, .06); color: #fff; }
  .ub--glass:hover { border-color: #fff; background: rgba(255, 255, 255, .14); }
  .ub--line { border-color: var(--line-dark); background: #fff; color: var(--ink); }
  .ub--line:hover { border-color: var(--ink); }
  .ub--dark { background: var(--ink); color: #fff; }
  .ub--sm { min-height: 40px; padding: 0 16px; font-size: .9rem; }
  .ub__ai { display: inline-grid; place-items: center; height: 20px; padding: 0 6px; border-radius: 6px; background: var(--gold); color: var(--ink); font-size: .68rem; letter-spacing: .04em; font-variation-settings: 'wght' 800; }

  /* hero */
  .un__hero { position: relative; overflow: hidden; background: radial-gradient(110% 120% at 80% 30%, #26292e 0%, #141619 60%); color: #fff; }
  .un__hin { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(24px, 4vw, 64px); align-items: center; min-height: clamp(520px, calc(100svh - var(--hdr-h, 150px) - 60px), 760px); padding-block: clamp(30px, 4vw, 56px); }
  .un__crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; font-size: .86rem; color: rgba(255, 255, 255, .55); }
  .un__crumbs a { color: rgba(255, 255, 255, .7); text-decoration: none; }
  .un__crumbs a:hover { color: #fff; }
  .un__crumbs b { color: var(--gold); font-weight: 400; }
  .un__h { margin: 0 0 14px; font-size: clamp(2.3rem, 4.4vw, 4.2rem); line-height: 1; letter-spacing: -.035em; font-variation-settings: 'wght' 790; font-weight: 400; text-wrap: balance; }
  .un__lede { margin: 0 0 22px; max-width: 46ch; color: rgba(255, 255, 255, .78); font-size: clamp(1.05rem, 1.3vw, 1.2rem); line-height: 1.55; }
  .un__chips { list-style: none; margin: 0 0 28px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .un__chips li { padding: 7px 14px; border-radius: 999px; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .12); font-size: .86rem; color: rgba(255, 255, 255, .88); }
  .un__chips .un__std { background: var(--gold); border-color: var(--gold); color: var(--ink); font-variation-settings: 'wght' 720; }
  .un__ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  .un__call { margin: 18px 0 0; color: rgba(255, 255, 255, .6); font-size: .92rem; }
  .un__call a { color: #fff; font-variation-settings: 'wght' 680; }
  .un__media { position: relative; align-self: stretch; display: grid; place-items: center; min-height: 360px; }
  .un__media--photo { border-radius: 26px; overflow: hidden; box-shadow: 0 40px 80px -40px rgba(0, 0, 0, .9); max-height: 640px; }
  .un__vid, .un__photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .un__media--ar { align-self: center; aspect-ratio: var(--ar); min-height: 0; }
  /* full-bleed media: the photo or video fills the right side of the header, edge to edge (like the service pages) */
  .un__hero--bleed { background: #141619; }
  .un__hero--bleed .un__hin { position: static; }
  .un__hero--bleed .un__copy { position: relative; z-index: 2; }
  .un__hero--bleed .un__media { position: absolute; top: 0; right: 0; bottom: 0; width: 54%; max-height: none; aspect-ratio: auto; border-radius: 0; box-shadow: none; align-self: auto; }
  .un__fade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, #141619 0%, rgba(20, 22, 25, .78) 12%, rgba(20, 22, 25, .2) 32%, rgba(20, 22, 25, 0) 48%), linear-gradient(180deg, rgba(20, 22, 25, .35) 0%, rgba(20, 22, 25, 0) 18%, rgba(20, 22, 25, 0) 86%, rgba(20, 22, 25, .7) 100%); }
  .un__chips, .un__call { display: none; }
  .un__stage { position: relative; width: 100%; height: 100%; display: grid; place-items: center; }
