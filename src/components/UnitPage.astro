  .gl button:hover img, .gl button:hover video { transform: scale(1.04); }
  .gl .gl--prod button { background: radial-gradient(closest-side, #fff, #e9ecef); }
  .gl .gl--prod img { object-fit: contain; padding: 8%; }
  .gl__play { position: absolute; left: 14px; top: 14px; padding: 5px 11px; border-radius: 999px; background: rgba(0, 0, 0, .55); color: #fff; font-size: .76rem; letter-spacing: .08em; text-transform: uppercase; }
  .glb { width: min(1200px, 94vw); max-height: 92vh; padding: 0; border: 0; border-radius: 20px; background: #0d0e10; overflow: visible; }
  .glb::backdrop { background: rgba(8, 9, 10, .86); backdrop-filter: blur(6px); }
  .glb__v { display: grid; place-items: center; }
  .glb__v :global(img), .glb__v :global(video) { max-width: 100%; max-height: 88vh; border-radius: 20px; display: block; }
  .glb__x, .glb__nv { position: absolute; z-index: 2; width: 46px; height: 46px; border: 0; border-radius: 50%; background: #fff; color: var(--ink); font-size: 1.6rem; line-height: 1; cursor: pointer; }
  .glb__x { right: -12px; top: -12px; }
  .glb__nv { top: 50%; translate: 0 -50%; }
  .glb__nv--p { left: 12px; } .glb__nv--n { right: 12px; }

  /* specs */
  .sp2 { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: clamp(26px, 4vw, 64px); align-items: start; }
  .spt { width: 100%; border-collapse: separate; border-spacing: 0; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; }
  .spt th, .spt td { padding: 15px 20px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .spt tr:last-child th, .spt tr:last-child td { border-bottom: 0; }
  .spt tr:nth-child(odd) { background: var(--haze); }
  .spt th { width: 38%; color: var(--steel); font-weight: 400; }
  .spt td { font-variation-settings: 'wght' 640; }
  .sp2__card { position: sticky; top: calc(var(--hdr-h, 120px) + 84px); display: grid; gap: 12px; padding: clamp(22px, 2.4vw, 32px); border-radius: 24px; background: #141619; color: #fff; }
  .sp2__k { margin: 0; color: var(--gold); font-size: .76rem; letter-spacing: .16em; text-transform: uppercase; font-variation-settings: 'wght' 720; }
  .sp2__k--u { margin-top: 12px; }
  .sp2__card h3 { margin: 0; font-size: 1.5rem; letter-spacing: -.02em; font-variation-settings: 'wght' 740; }
  .sp2__card > p:not(.sp2__k) { margin: 0 0 6px; color: rgba(255, 255, 255, .72); line-height: 1.55; }
  .sp2__card .ub--line { background: transparent; color: #fff; border-color: rgba(255, 255, 255, .3); }
  .sp2__uses { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .sp2__uses li { display: flex; align-items: center; gap: 10px; color: rgba(255, 255, 255, .88); font-size: .95rem; }
  .sp2__uses svg { width: 18px; height: 18px; flex: none; fill: none; stroke: var(--gold); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* how */
  .hw { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; counter-reset: s; }
  .hw li { position: relative; display: grid; gap: 8px; align-content: start; padding: 26px 22px; border-radius: 22px; background: #fff; border: 1px solid var(--line); }
  .hw li span { display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 6px; border-radius: 50%; background: var(--red); color: #fff; font-variation-settings: 'wght' 780; }
  .hw b { font-size: 1.1rem; font-variation-settings: 'wght' 720; }
  .hw p { margin: 0; color: var(--ink-2); line-height: 1.5; font-size: .95rem; }
  .hw li:not(:last-child)::after { content: ''; position: absolute; top: 46px; right: -12px; width: 12px; height: 2px; background: var(--line-dark); }
  .hw__buy { margin: 22px 0 0; color: var(--ink-2); }
  .hw__buy a { color: var(--red); font-variation-settings: 'wght' 680; }

  /* more */
  .mr { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .mr li { min-width: 0; }
  .mr a { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; height: 100%; padding: 14px 14px 18px; border-radius: 22px; background: var(--haze); color: var(--ink); text-decoration: none; transition: background .2s, transform .3s; }
  .mr a:hover { background: #eceef0; transform: translateY(-3px); }
  .mr__i { display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: 16px; background: radial-gradient(closest-side, #fff, #f1f2f4); }
  .mr__i { overflow: hidden; }
  .mr__i img { width: 86%; height: 86%; max-width: 100%; min-width: 0; object-fit: contain; }
  .mr b { font-variation-settings: 'wght' 700; line-height: 1.25; }
  .mr__go { display: inline-flex; align-items: center; gap: 6px; color: var(--red); font-size: .9rem; font-variation-settings: 'wght' 680; }
  .mr__go :global(svg) { width: 15px; height: 15px; }

  /* faq */
  .fq { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(26px, 4vw, 64px); align-items: start; }
  .fq__h { margin-bottom: 14px; }
  .fq__p { margin: 0 0 20px; color: var(--steel); line-height: 1.6; }
  .fq__p a { color: var(--ink); font-variation-settings: 'wght' 680; }
  .fq__list { display: grid; gap: 10px; }
  .fq__list details { border-radius: 18px; background: #fff; border: 1px solid var(--line); }
  .fq__list summary { list-style: none; display: flex; justify-content: space-between; gap: 16px; padding: 18px 22px; font-size: 1.04rem; font-variation-settings: 'wght' 690; cursor: pointer; }
  .fq__list summary::-webkit-details-marker { display: none; }
  .fq__list summary::after { content: '+'; color: var(--red); font-size: 1.4rem; line-height: 1; }
  .fq__list details[open] summary::after { content: '−'; }
  .fq__list p { margin: 0; padding: 0 22px 20px; color: var(--ink-2); line-height: 1.6; }

  /* cta */
  .ucta { padding: clamp(48px, 6vw, 84px) 0; background: radial-gradient(120% 140% at 90% 0%, #3a0505 0%, #141619 60%); color: #fff; }
  .ucta__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 22px 40px; }
  .ucta h2 { margin: 0 0 8px; font-size: clamp(1.8rem, 3.4vw, 3rem); line-height: 1.02; letter-spacing: -.03em; font-variation-settings: 'wght' 780; font-weight: 400; }
  .ucta h2 em { color: var(--gold); }
  .ucta p { margin: 0; color: rgba(255, 255, 255, .72); }
  .ucta__b { display: flex; flex-wrap: wrap; gap: 10px; }

  /* spec sheet (print) */
  .usheet { display: none; }
  @media print {
    @page { margin: .5in; }
    :global(body > *:not(main)), :global(main > *:not(.un)), .un > *:not(.usheet) { display: none !important; }
    .usheet { display: block; color: #111; font-size: 10.5pt; }
    .usheet__top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-bottom: 12px; border-bottom: 3px solid #b60606; font-size: 9pt; color: #444; }
    .usheet__top img { width: 150px; height: auto; }
    .usheet__main { display: grid; grid-template-columns: 200px 1fr; gap: 22px; align-items: center; margin: 16px 0; }
    .usheet__img { width: 200px; height: 170px; object-fit: contain; }
    .usheet__cat { margin: 0 0 4px; font-size: 9pt; letter-spacing: .14em; text-transform: uppercase; color: #b60606; }
    .usheet h2 { margin: 0 0 8px; font-size: 20pt; }
    .usheet__std { font-weight: 700; color: #1b4f9c; }
    .usheet table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
    .usheet th, .usheet td { text-align: left; padding: 6px 10px; border-bottom: 1px solid #ddd; vertical-align: top; }
    .usheet th { width: 32%; color: #555; font-weight: 600; }
    .usheet ul { padding-left: 1.1em; columns: 2; column-gap: 24px; }
    .usheet__foot { margin-top: 14px; padding-top: 10px; border-top: 1px solid #ddd; font-size: 8.5pt; color: #666; }
  }

  @media (max-width: 1000px) {
    .un__hin, .ov, .sp2, .fq { grid-template-columns: minmax(0, 1fr); }
    .un__hin { min-height: 0; }
    .un__media { order: -1; min-height: 0; }
    .un__media--photo { aspect-ratio: 4 / 3; }
    .un__media--ar { aspect-ratio: var(--ar); }
    .un__stage img { max-height: 320px; }
    .un__hero--bleed .un__hin { padding-top: 0; }
    .un__hero--bleed .un__media { position: relative; inset: auto; width: 100vw; margin-inline: calc(50% - 50vw); aspect-ratio: var(--ar, 4 / 3); }
    .un__fade { background: linear-gradient(180deg, rgba(20, 22, 25, 0) 55%, rgba(20, 22, 25, .6) 82%, #141619 100%); }

    .sp2__card { position: static; }
    .hw { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hw li::after { display: none; }
    .mr { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .un__hin { padding-block: 16px 34px; gap: 22px; }
    .un__copy { text-align: center; }
    .un__crumbs, .un__k, .un__chips, .un__ctas { justify-content: center; }
    .un__lede { margin-inline: auto; }
    /* phones: name, one line and the buttons, all on the first screen */
    .un__crumbs, .un__k { display: none; }
    .un__hero--bleed .un__media { aspect-ratio: auto; height: clamp(210px, calc(100svh - var(--hdr-h, 150px) - 330px), 46svh); }
    .un__hin { padding-block: 0 24px; gap: 14px; }
    .un__h { font-size: clamp(1.9rem, 8.4vw, 2.4rem); margin-bottom: 8px; }
    .un__lede { margin-bottom: 18px; font-size: 1rem; }
    .un__ctas { gap: 8px; }
    .un__ctas .ub { flex: 1 1 calc(50% - 5px); }
    .un__ctas .ub--red { flex-basis: 100%; }
    .un__nav .ub { display: none; }
    .ov__ben { grid-template-columns: 1fr; }
    .gl { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 140px; gap: 8px; }
    .gl button { border-radius: 14px; }
    .gl li:nth-child(n+2) { grid-column: auto; }
    .gl--2 li:last-child, .gl--4 li:last-child, .gl--6 li:last-child, .gl--8 li:last-child { grid-column: span 2; }
    .hw { grid-template-columns: 1fr; }
    .ucta__b .ub { flex: 1 1 100%; }
  }

  /* ---- refined finish: quieter, more editorial ---- */
  .un__k { gap: 0; font-size: .74rem; letter-spacing: .26em; font-variation-settings: 'wght' 620; }
  .un__k span { display: none; }
  .un__hero .un__h { font-variation-settings: 'wght' 740; letter-spacing: -.042em; }
  .un__hero .un__lede { color: rgba(255, 255, 255, .7); }
  .un__crumbs { letter-spacing: .01em; }
  .un__hero .ub--red { box-shadow: none; }
  .un__hero .ub--red:hover { transform: translateY(-1px); }
  .un__hero .ub--glass { background: transparent; border-width: 1px; border-color: rgba(255, 255, 255, .24); }
  .un__hero .ub--glass:hover { background: rgba(255, 255, 255, .08); border-color: rgba(255, 255, 255, .6); }
  .un__hero .ub__ai { background: transparent; border: 1px solid rgba(240, 192, 64, .7); color: var(--gold); height: 19px; }
  .un__hl { margin-top: 38px; padding-top: 24px; border: 0; border-top: 1px solid rgba(255, 255, 255, .14); border-radius: 0; background: none; overflow: visible; }
  .un__hl li { padding: 0 20px; gap: 5px; }
  .un__hl li + li { border-left: 1px solid rgba(255, 255, 255, .12); }
  .un__hli { display: none; }
  .un__hl b { font-size: .96rem; letter-spacing: -.01em; font-variation-settings: 'wght' 650; }
  .un__hl small { font-size: .8rem; color: rgba(255, 255, 255, .52); }
  .un__navl a { box-shadow: none; border-color: rgba(20, 22, 25, .12); }
  .un__navl a:hover { box-shadow: none; transform: none; border-color: rgba(20, 22, 25, .35); }
  .vm__card, .vm__card:hover { transform: none; box-shadow: 0 1px 2px rgba(20, 22, 25, .04); }
  .vm__card:hover { border-color: rgba(20, 22, 25, .22); }
  @media (max-width: 640px) {
    .un__hl { margin-top: 20px; padding-top: 16px; }
    .un__hl li { padding: 0 6px; }
    .un__hl b { font-size: .8rem; }
  }

  /* manufacturer detail */
  .ovs { list-style: none; margin: clamp(30px, 4vw, 48px) 0 0; padding: 26px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .ovs li { display: flex; flex-direction: column; gap: 6px; padding: 0 22px; }
  .ovs li:first-child { padding-left: 0; }
  .ovs li + li { border-left: 1px solid var(--line); }
  .ovs b { font-size: clamp(1.7rem, 2.6vw, 2.4rem); line-height: 1; letter-spacing: -.035em; color: var(--ink); font-variation-settings: 'wght' 740; }
  .ovs span { color: var(--muted, #5b6068); font-size: .9rem; line-height: 1.4; }
  .ft { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--line); }
  .ft__g { padding: 26px 24px 8px 0; }
  .ft__g + .ft__g { padding-left: 24px; border-left: 1px solid var(--line); }
  .ft__g h3 { margin: 0 0 14px; font-size: 1.05rem; letter-spacing: -.01em; }
  .ft__g ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ft__g li { position: relative; padding-left: 16px; color: #3c4047; font-size: .93rem; line-height: 1.45; }
  .ft__g li::before { content: ''; position: absolute; left: 0; top: .62em; width: 6px; height: 1.5px; background: var(--red); }
  .ftp { margin-top: clamp(36px, 5vw, 64px); display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(24px, 4vw, 64px); align-items: center; background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: clamp(20px, 3vw, 40px); }
  .ftp__img img { width: 100%; height: auto; display: block; }
  .ftp__txt h3 { margin: 0 0 18px; font-size: clamp(1.4rem, 2vw, 1.9rem); letter-spacing: -.03em; line-height: 1.1; }
  .ftp__txt dl { margin: 0 0 22px; border-top: 1px solid var(--line); }
  .ftp__txt dl div { display: flex; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .ftp__txt dt { font-variation-settings: 'wght' 680; }
  .ftp__txt dd { margin: 0; color: var(--muted, #5b6068); }
  .ftp__k { margin: 0 0 10px; font-size: .74rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted, #5b6068); font-variation-settings: 'wght' 650; }
  .ftp__opts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .ftp__opts li { padding: 6px 11px; border: 1px solid var(--line); border-radius: 999px; font-size: .82rem; color: #3c4047; }
  .sp2__docs { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 8px; }
  .sp2__docs a { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid rgba(255, 255, 255, .18); border-radius: 12px; color: #fff; text-decoration: none; font-size: .92rem; transition: border-color .2s, background .2s; }
  .sp2__docs a:hover { border-color: rgba(255, 255, 255, .5); background: rgba(255, 255, 255, .05); }
  .sp2__docs a :global(svg) { width: 17px; height: 17px; flex: none; }
  .sp2__docs span { margin-left: auto; font-size: .7rem; letter-spacing: .12em; color: rgba(255, 255, 255, .5); }
  @media (max-width: 980px) {
    .ovs { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 22px; }
    .ovs li:nth-child(3) { padding-left: 0; border-left: 0; }
    .ft { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ft__g:nth-child(3) { padding-left: 0; border-left: 0; }
    .ftp { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .ft { grid-template-columns: minmax(0, 1fr); }
    .ft__g, .ft__g + .ft__g { padding: 20px 0 6px; border-left: 0; border-top: 1px solid var(--line); }
    .ft__g:first-child { border-top: 0; }
  }

  /* single-product card (arrow board) */
  .vm__card--wide { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); }
  .vm__card--wide { align-items: start; overflow: visible; }
  .vm__card--wide .vm__img { aspect-ratio: auto; height: min(460px, calc(100svh - var(--hdr-h, 144px) - 160px)); position: sticky; top: calc(var(--hdr-h, 144px) + 24px); margin: clamp(16px, 2vw, 28px); border-radius: 18px; }
  .vm__card--wide .vm__img img { position: absolute; inset: 8%; width: 84%; height: 84%; object-fit: contain; }
  .vm__card--wide .vm__body { padding: clamp(24px, 3vw, 44px); }
  .vm__card--wide h3 { font-size: clamp(1.5rem, 2.2vw, 2.1rem); letter-spacing: -.03em; }
  .vm__cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(20px, 2.6vw, 36px); margin-bottom: 22px; }
  .vm__sub { margin: 0 0 10px; font-size: .74rem; letter-spacing: .2em; text-transform: uppercase; color: var(--steel); font-variation-settings: 'wght' 650; }
  .vm__feat { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .vm__feat li { display: grid; gap: 3px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: .9rem; line-height: 1.4; }
  .vm__feat b { font-variation-settings: 'wght' 680; }
  .vm__feat span { color: var(--steel); }
  .vm__cols .vm__specs { margin: 0; }
  .vm__cols .vm__specs div { grid-template-columns: 104px minmax(0, 1fr); }
  .vm__card--wide .vm__btns .ub { flex: 0 1 auto; padding: 0 22px; }
  .vm__docs { margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: .86rem; max-width: none; }
  .vm__docs a { color: var(--ink); text-underline-offset: 3px; }
  @media (max-width: 1100px) { .vm__cols { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 860px) {
    .vm__card--wide { grid-template-columns: minmax(0, 1fr); }
    .vm__card--wide .vm__img { aspect-ratio: 4 / 3; height: auto; position: relative; top: auto; margin: 0; border-radius: 0; }
    .vm__card--wide .vm__btns { flex-wrap: wrap; }
    .vm__card--wide .vm__btns .ub { flex: 1 1 100%; }
  }

  /* desktop and laptop: header plus the section buttons always fit the first screen */
  @media (min-width: 1001px) {
    .un__hin, .un__hero--bleed .un__hin { min-height: 0; height: max(380px, calc(100svh - var(--hdr-h, 144px))); max-height: 880px; padding-block: clamp(18px, 3.2vh, 48px); }
    .un__hero .un__crumbs { margin-bottom: clamp(10px, 2.2vh, 26px); }
    .un__hero .un__k { margin-bottom: clamp(8px, 1.4vh, 14px); }
    .un__hero .un__h, .un__hero--bleed .un__h { font-size: clamp(2.3rem, min(4.6vw, 7.4vh), 5rem); margin-bottom: clamp(8px, 1.6vh, 18px); }
    .un__hero .un__lede, .un__hero--bleed .un__lede { margin-bottom: clamp(14px, 3vh, 34px); font-size: clamp(1rem, min(1.45vw, 2.3vh), 1.45rem); }
    .un__hero--bleed .un__ctas .ub { min-height: clamp(46px, 6.6vh, 56px); }
    .un__hl { margin-top: clamp(16px, 3.6vh, 38px); padding-top: clamp(12px, 2.4vh, 24px); }
  }
  @media (min-width: 1001px) and (max-height: 820px) {
    .un__hl small { font-size: .74rem; line-height: 1.3; }
    .un__hl li { gap: 3px; }
  }

  /* desktop: everything in the header is sized from one base (set by script to fill the space) */
  @media (min-width: 1001px) {
    .un .un__hero .un__copy { font-size: var(--ufs, 16px); }
    .un .un__hero .un__crumbs { font-size: 1.15em; margin-bottom: 1.1em; gap: .5em; }
    .un .un__hero .un__k { font-size: .98em; margin-bottom: .8em; }
    .un .un__hero .un__h { font-size: 4.5em; line-height: .98; margin-bottom: .2em; }
    .un .un__hero .un__lede { font-size: 1.62em; margin-bottom: 1.1em; max-width: none; }
    .un .un__hero .un__ctas { gap: .65em; flex-wrap: nowrap; justify-content: center; }
    .un .un__hero .un__ctas .ub { min-height: 3.2em; padding: 0 1.1em; font-size: 1.24em; gap: .45em; }
    .un .un__hero .un__ctas .ub :global(svg) { width: 1.1em; height: 1.1em; }
    .un .un__hero .un__hl { margin-top: 2.3em; padding-top: 1.6em; max-width: none; }
    .un .un__hero .un__hl li { padding: 0 1.2em; gap: .3em; }
    .un .un__hero .un__hl b { font-size: 1.38em; }
    .un .un__hero .un__hl small { font-size: 1.05em; line-height: 1.35; }
  }

  /* desktop: let the photo or video melt into the dark side instead of stopping at an edge */
