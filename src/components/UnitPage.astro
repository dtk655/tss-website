<script>
  document.querySelectorAll('[data-pctabs]').forEach((tabs) => {
    const card = tabs.closest('.pc');
    tabs.querySelectorAll('[data-pct]').forEach((b) => b.addEventListener('click', () => {
      tabs.querySelectorAll('[data-pct]').forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-selected', x === b ? 'true' : 'false'); });
      card.querySelectorAll('[data-pcp]').forEach((p) => p.classList.toggle('is-on', p.dataset.pcp === b.dataset.pct));
    }));
  });
</script>
<script>
  // Desktop header: pick the largest base size that still fits the first screen with room to spare.
  (() => {
    const copy = document.querySelector('.un__hero .un__copy');
    const hin = document.querySelector('.un__hero .un__hin');
    if (!copy || !hin) return;
    const fit = () => {
      if (innerWidth <= 1000) { copy.style.removeProperty('--ufs'); return; }
      const cs = getComputedStyle(hin);
      const avail = (hin.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom)) * .94;
      const ctas = copy.querySelector('.un__ctas');
      const h = copy.querySelector('.un__h');
      const ok = () => copy.scrollHeight <= avail && (!ctas || ctas.scrollWidth <= copy.clientWidth + 1) && (!h || h.getBoundingClientRect().height <= parseFloat(getComputedStyle(h).fontSize) * 2.1);
      let lo = 12, hi = 30;
      for (let k = 0; k < 9; k++) {
        const mid = (lo + hi) / 2;
        copy.style.setProperty('--ufs', mid + 'px');
        if (ok()) lo = mid; else hi = mid;
      }
      copy.style.setProperty('--ufs', lo.toFixed(2) + 'px');
    };
    fit();
    addEventListener('resize', fit);
    document.fonts?.ready.then(fit);
  })();
</script>
<script>
  {
    const u = document.querySelector('[data-unit]');
    if (u) {
      const title = u.dataset.title;
      document.querySelectorAll('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));
      document.querySelectorAll('[data-ask]').forEach((b) => b.addEventListener('click', () => window.TSSChat?.ask(`I'm looking at the ${title}. Can you tell me more about it and how renting it works?`)));
      // hero video: phones get the smaller file
      const v = u.querySelector('.un__vid');
      if (v && v.dataset.srcSm && innerWidth < 900) { v.src = v.dataset.srcSm; } else if (v) { v.src = v.dataset.src; }
      if (v) { if (matchMedia('(prefers-reduced-motion: reduce)').matches) v.removeAttribute('autoplay'); else v.play().catch(() => {}); }
      // section nav highlight
      const links = [...u.querySelectorAll('[data-unav-a]')];
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (!e.isIntersecting) return; links.forEach((a) => a.classList.toggle('is-on', a.dataset.unavA === e.target.id)); const on = links.find((a) => a.dataset.unavA === e.target.id), bar = on && on.parentElement; if (bar && bar.scrollWidth > bar.clientWidth) bar.scrollTo({ left: on.offsetLeft - (bar.clientWidth - on.offsetWidth) / 2, behavior: 'smooth' }); }), { rootMargin: '-45% 0px -50% 0px' });
        links.forEach((a) => { const s = document.getElementById(a.dataset.unavA); if (s) io.observe(s); });
        const first = document.getElementById('overview');
        addEventListener('scroll', () => { if (first && first.getBoundingClientRect().top > innerHeight * .5) links.forEach((a) => a.classList.remove('is-on')); }, { passive: true });
      }
      // gallery lightbox
      const dlg = u.querySelector('[data-glb]');
      if (dlg) {
        const list = JSON.parse(dlg.querySelector('[data-glb-list]').textContent);
        const view = dlg.querySelector('[data-glb-v]');
        let i = 0;
        const show = (n) => { i = (n + list.length) % list.length; const g = list[i]; view.innerHTML = g.video ? `<video src="${g.video}" poster="${g.src}" autoplay muted loop playsinline controls></video>` : `<img src="${g.src}" alt="">`; };
        u.querySelectorAll('[data-gl]').forEach((b) => b.addEventListener('click', () => { show(+b.dataset.gl); dlg.showModal(); }));
        dlg.querySelector('[data-glb-x]').addEventListener('click', () => dlg.close());
        dlg.querySelector('[data-glb-p]').addEventListener('click', () => show(i - 1));
        dlg.querySelector('[data-glb-n]').addEventListener('click', () => show(i + 1));
        dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
        dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(i + 1); if (e.key === 'ArrowLeft') show(i - 1); });
        dlg.addEventListener('close', () => { view.innerHTML = ''; });
      }
    }
  }
</script>

