---
// Homepage header: slim slogan banner, then all three businesses as photo cards with one highlighted at a time.
const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const cards = [
  {
    t: 'Products', h: 'Cones, barriers, signs and drums.', d: 'In stock and shipped anywhere in the U.S. No minimum order.',
    img: CDN + 'thumbnail_IMG_0141_f25c7165-4733-4438-9391-0687acaa7c46.jpg', pos: '50% 50%',
    href: '/collections', cta: 'Shop products'
  },
  {
    t: 'Rentals', h: 'TMAs, VMS boards and more.', d: 'Everything we sell, rented by the job in NJ, NY, PA and CT.',
    img: '/fleet/tma-rear-2.jpg', pos: '50% 40%',
    href: '/collections/equipment-rentals', cta: 'See rentals'
  },
  {
    t: 'Lane closures', h: 'Certified, experienced crews.', d: 'MUTCD-compliant closures across NJ, NY, PA, CT and DE.',
    img: '/fleet/lc-hero.webp', pos: '62% 45%',
    href: '/pages/lane-closure', cta: 'Book a crew'
  }
];
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section class="hb">
  <div class="wrap hb__in">
    <div>
      <p class="hb__k">Traffic Safety Service · Since 1971</p>
      <h1>The trusted leader in <span>traffic safety.</span></h1>
    </div>
    <div class="hb__cta">
      <a href="/pages/request-a-quote" class="hb__btn hb__btn--solid">Build a quote</a>
      <a href="tel:+19085614800" class="hb__btn hb__btn--line">908-561-4800</a>
    </div>
  </div>
</section>

<section class="hc" data-hc>
  <div class="wrap">
    <ul class="hc__grid">
      {cards.map((c, i) => (
        <li>
          <a href={c.href} class:list={['hc__card', i === 0 && 'is-on']} data-card style={`--i:${i}`}>
            <span class="hc__photo"><img src={c.img} alt="" style={`object-position:${c.pos}`} loading="eager" /></span>
            <span class="hc__body">
              <span class="hc__top"><span class="hc__n">0{i + 1}</span><span class="hc__t">{c.t}</span></span>
              <span class="hc__h">{c.h}</span>
              <span class="hc__d">{c.d}</span>
              <span class="hc__go">{c.cta}<Fragment set:html={ARROW} /></span>
            </span>
            <i class="hc__bar" aria-hidden="true"></i>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hb { position: relative; overflow: hidden; color: #fff; background: radial-gradient(120% 170% at 88% -30%, #e13a1a, #b60606 42%, #8a0404); }
  .hb::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(-45deg, rgba(255,255,255,.035) 0 18px, transparent 18px 36px); pointer-events: none; }
  .hb__in { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 40px; padding-block: clamp(28px, 3.4vw, 46px); }
  .hb__k { margin: 0 0 8px; color: var(--gold); font-size: clamp(.8rem, .95vw, .94rem); letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 720; }
  .hb h1 { margin: 0; color: #fff; font-size: clamp(2rem, 4vw, 3.8rem); line-height: 1.02; letter-spacing: -.035em; font-variation-settings: 'wght' 800; text-wrap: balance; }
  .hb h1 span { color: #ffd9d2; }
  .hb__cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .hb__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 14px 24px 13px; border-radius: 12px; font-size: 1.02rem; font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .15s, transform .15s; }
  .hb__btn:hover { transform: translateY(-1px); }
  .hb__btn--solid { background: #fff; color: var(--red); box-shadow: 0 14px 30px -14px rgba(0,0,0,.5); }
  .hb__btn--solid:hover { background: var(--haze); }
  .hb__btn--line { border: 1.5px solid rgba(255,255,255,.6); color: #fff; }
  .hb__btn--line:hover { background: rgba(255,255,255,.1); }

  .hc { padding: clamp(22px, 2.8vw, 36px) 0 clamp(36px, 4vw, 56px); background: var(--haze); }
  .hc__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 20px); }
  .hc__card { position: relative; overflow: hidden; display: flex; flex-direction: column; height: 100%; border-radius: 22px; background: #fff; border: 1px solid var(--line); color: var(--ink); text-decoration: none; transition: transform .5s cubic-bezier(.2,.8,.2,1), box-shadow .5s, border-color .4s, opacity .4s; opacity: .72; }
  .hc__card.is-on { opacity: 1; transform: translateY(-6px); border-color: var(--red); box-shadow: 0 0 0 3px rgba(182,6,6,.14), 0 30px 50px -30px rgba(20,23,26,.55); }
  .hc__card:focus-visible { outline: 3px solid rgba(182,6,6,.4); outline-offset: 3px; }
  .hc__photo { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #222; }
  .hc__photo img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.85) brightness(.9); transform: scale(1.04); transition: filter .6s, transform 1.2s cubic-bezier(.2,.8,.2,1); }
  .hc__card.is-on .hc__photo img { filter: none; transform: scale(1); }
  .hc__body { display: flex; flex-direction: column; gap: 6px; padding: clamp(16px, 1.8vw, 24px); flex: 1; }
  .hc__top { display: flex; align-items: baseline; gap: 10px; }
  .hc__n { font-size: .8rem; font-variation-settings: 'wght' 780; color: var(--steel); letter-spacing: .06em; transition: color .3s; }
  .hc__card.is-on .hc__n { color: var(--red); }
  .hc__t { font-size: clamp(1.4rem, 2vw, 1.85rem); line-height: 1.05; letter-spacing: -.025em; font-variation-settings: 'wght' 800; }
  .hc__h { font-size: 1rem; font-variation-settings: 'wght' 680; color: var(--ink-2); }
  .hc__d { font-size: .9rem; line-height: 1.45; color: var(--steel); }
  .hc__go { display: inline-flex; align-items: center; gap: 7px; width: fit-content; margin-top: auto; padding-top: 12px; color: var(--steel); font-size: .95rem; font-variation-settings: 'wght' 720; transition: color .3s; }
  .hc__go :global(svg) { width: 17px; height: 17px; transition: transform .2s; }
  .hc__card.is-on .hc__go { color: var(--red); }
  .hc__card:hover .hc__go :global(svg) { transform: translateX(3px); }
  .hc__bar { position: absolute; left: 0; bottom: 0; height: 4px; width: 0; background: var(--red); }
  .hc__card.is-on .hc__bar { animation: hcBar var(--hc-t, 3800ms) linear forwards; }
  .hc.is-paused .hc__card.is-on .hc__bar { animation: none; width: 100%; }
  @keyframes hcBar { to { width: 100%; } }

  @media (max-width: 760px) {
    .hb__in { flex-direction: column; text-align: center; padding-block: 24px 26px; gap: 16px; }
    .hb h1 { font-size: 2rem; }
    .hb__cta { width: 100%; }
    .hb__btn { flex: 1; min-height: 50px; padding-inline: 14px; }
    .hc { padding-top: 16px; }
    .hc__grid { grid-template-columns: 1fr; gap: 10px; }
    .hc__card { flex-direction: row; border-radius: 18px; }
    .hc__card.is-on { transform: none; }
    .hc__photo { flex: 0 0 34%; aspect-ratio: auto; }
    .hc__body { gap: 3px; padding: 13px 14px; }
    .hc__t { font-size: 1.25rem; }
    .hc__h { font-size: .88rem; }
    .hc__d { display: none; }
    .hc__go { padding-top: 6px; font-size: .86rem; }
  }
  @media (prefers-reduced-motion: reduce) { .hc__card, .hc__photo img { transition: none; } .hc__bar { animation: none !important; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hc]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const T = 3800;
    root.style.setProperty('--hc-t', T + 'ms');
    let i = 0, hover = false;
    const show = (n: number) => {
      i = n;
      cards.forEach((c, k) => {
        c.classList.toggle('is-on', k === n);
        const bar = c.querySelector<HTMLElement>('.hc__bar');
        if (bar && k === n) { bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = ''; }
      });
    };
    cards.forEach((c, k) => {
      c.addEventListener('mouseenter', () => { if (matchMedia('(hover: hover)').matches) { hover = true; root.classList.add('is-paused'); show(k); } });
      c.addEventListener('focus', () => show(k));
    });
    root.addEventListener('mouseleave', () => { hover = false; root.classList.remove('is-paused'); show(i); });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    window.setInterval(() => { if (!hover && document.visibilityState === 'visible') show((i + 1) % cards.length); }, T);
  });
</script>
