---
// Cinematic homepage header: full-screen photo loop with slow motion, one bold headline, then a slim three-business bar.
const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const shots = [
  { img: '/fleet/lc-hero.webp', pos: '58% 45%', cap: 'Overnight bridge work, lanes closed by TSS crews' },
  { img: '/fleet/tma-rear-2.jpg', pos: '50% 40%', cap: 'TMA crash truck from the TSS fleet' },
  { img: CDN + 'thumbnail_IMG_0141_f25c7165-4733-4438-9391-0687acaa7c46.jpg', pos: '50% 50%', cap: 'Reflective cones, in stock and ready to ship' }
];
const lines = [
  { t: 'Products', d: 'Cones, barriers, signs and drums. Shipped nationwide.', href: '/collections' },
  { t: 'Rentals', d: 'TMAs, message boards and more. NJ, NY, PA and CT.', href: '/collections/equipment-rentals' },
  { t: 'Lane closures', d: 'Certified, experienced crews. NJ, NY, PA, CT and DE.', href: '/pages/lane-closure' }
];
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section class="cx" data-cx>
  <div class="cx__media" aria-hidden="true">
    {shots.map((s, i) => <img class:list={['cx__img', i === 0 && 'is-on']} src={s.img} alt="" style={`object-position:${s.pos}`} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} data-shot={i} />)}
    <span class="cx__shade"></span>
  </div>

  <div class="wrap cx__in">
    <p class="cx__k"><span></span>Products · Rentals · Lane closures</p>
    <h1 class="cx__h"><span><span>The trusted leader</span></span><span><span>in traffic safety.</span></span></h1>
    <div class="cx__row">
      <p class="cx__lede">Serving contractors, agencies and venues since 1971.</p>
      <div class="cx__cta">
        <a href="/pages/request-a-quote" class="cx__btn cx__btn--solid">Request a quote<Fragment set:html={ARROW} /></a>
        <a href="tel:+19085614800" class="cx__btn cx__btn--ghost">908-561-4800</a>
      </div>
    </div>
  </div>

  <div class="wrap cx__foot">
    <p class="cx__cap" aria-live="polite">
      {shots.map((s, i) => <span class:list={[i === 0 && 'is-on']} data-cap={i}>{s.cap}</span>)}
    </p>
    <div class="cx__dots" role="tablist" aria-label="Photos">
      {shots.map((_, i) => <button type="button" role="tab" aria-label={`Photo ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'} data-dot={i}><i></i></button>)}
    </div>
  </div>
</section>

<nav class="cx-bar" aria-label="What we do">
  <ul class="wrap cx-bar__in">
    {lines.map((l) => (
      <li><a href={l.href}><span><b>{l.t}</b><small>{l.d}</small></span><Fragment set:html={ARROW} /></a></li>
    ))}
  </ul>
</nav>

<style>
  .cx { position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: clamp(560px, calc(100svh - 144px), 860px); color: #fff; background: #0b0c0e; overflow: hidden; isolation: isolate; }
  .cx__media { position: absolute; inset: 0; z-index: -1; }
  .cx__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.1); transition: opacity 1.6s ease; }
  .cx__img.is-on { opacity: 1; animation: cxDrift 9s linear forwards; }
  @keyframes cxDrift { from { transform: scale(1.1) translateX(1%); } to { transform: scale(1.02) translateX(-1%); } }
  .cx__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,9,11,.35) 0%, rgba(8,9,11,0) 28%, rgba(8,9,11,.15) 50%, rgba(8,9,11,.88) 100%), linear-gradient(90deg, rgba(8,9,11,.55) 0%, rgba(8,9,11,0) 60%); }

  .cx > .wrap { width: 100%; box-sizing: border-box; }
  .cx__in { padding-bottom: clamp(26px, 3vw, 40px); }
  .cx__k { display: flex; align-items: center; gap: 12px; margin: 0 0 18px; font-size: .82rem; letter-spacing: .18em; text-transform: uppercase; font-variation-settings: 'wght' 650; color: rgba(255,255,255,.85); opacity: 0; animation: cxFade .8s .2s ease forwards; }
  .cx__k span { width: 34px; height: 3px; background: var(--red); border-radius: 2px; }
  .cx__h { margin: 0; color: #fff; font-size: clamp(2.8rem, 7.4vw, 7.6rem); line-height: .94; letter-spacing: -.045em; font-variation-settings: 'wght' 780; }
  .cx__h > span { display: block; overflow: hidden; padding-bottom: .04em; white-space: nowrap; }
  .cx__h > span > span { display: inline-block; transform: translateY(105%); animation: cxRise 1s cubic-bezier(.2,.8,.2,1) forwards; }
  .cx__h > span:nth-child(2) > span { animation-delay: .12s; }
  @keyframes cxRise { to { transform: none; } }
  @keyframes cxFade { to { opacity: 1; } }
  .cx__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 40px; margin-top: clamp(22px, 2.6vw, 34px); opacity: 0; animation: cxFade .8s .55s ease forwards; }
  .cx__lede { margin: 0; font-size: clamp(1.02rem, 1.3vw, 1.25rem); color: rgba(255,255,255,.82); }
  .cx__cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .cx__btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 14px 26px 13px; border-radius: 999px; font-size: 1rem; font-variation-settings: 'wght' 680; text-decoration: none; white-space: nowrap; transition: background .2s, color .2s, border-color .2s; }
  .cx__btn :global(svg) { flex: none; width: 17px; height: 17px; transition: transform .2s; }
  .cx__btn:hover :global(svg) { transform: translateX(3px); }
  .cx__btn--solid { background: var(--red); color: #fff; }
  .cx__btn--solid:hover { background: #d10a0a; }
  .cx__btn--ghost { border: 1px solid rgba(255,255,255,.45); color: #fff; backdrop-filter: blur(8px); background: rgba(255,255,255,.06); }
  .cx__btn--ghost:hover { border-color: #fff; background: rgba(255,255,255,.14); }

  .cx__foot { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-block: 16px 22px; border-top: 1px solid rgba(255,255,255,.16); }
  .cx__cap { position: relative; margin: 0; flex: 1; min-height: 1.4em; font-size: .84rem; color: rgba(255,255,255,.6); }
  .cx__cap span { position: absolute; left: 0; top: 0; opacity: 0; transition: opacity .8s; white-space: nowrap; }
  .cx__cap span.is-on { opacity: 1; }
  .cx__dots { display: flex; gap: 8px; }
  .cx__dots button { all: unset; cursor: pointer; padding: 8px 0; }
  .cx__dots i { display: block; position: relative; width: 44px; height: 3px; border-radius: 3px; background: rgba(255,255,255,.28); overflow: hidden; }
  .cx__dots i::after { content: ''; position: absolute; inset: 0; width: 0; background: #fff; }
  .cx__dots [aria-selected="true"] i::after { animation: cxBar var(--cx-t, 7000ms) linear forwards; }
  .cx.is-paused .cx__dots [aria-selected="true"] i::after { animation: none; width: 100%; }
  .cx__dots button:focus-visible i { outline: 2px solid #fff; outline-offset: 3px; }
  @keyframes cxBar { to { width: 100%; } }

  .cx-bar { background: #0b0c0e; color: #fff; border-top: 1px solid rgba(255,255,255,.08); }
  .cx-bar__in { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cx-bar__in li + li { border-left: 1px solid rgba(255,255,255,.1); }
  .cx-bar a { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 24px clamp(16px, 2vw, 30px); color: inherit; text-decoration: none; transition: background .25s; }
  .cx-bar li:first-child a { padding-left: 0; }
  .cx-bar a:hover { background: rgba(255,255,255,.04); }
  .cx-bar b { display: block; font-size: 1.2rem; letter-spacing: -.015em; font-variation-settings: 'wght' 720; }
  .cx-bar small { display: block; margin-top: 3px; font-size: .86rem; color: rgba(255,255,255,.6); }
  .cx-bar :global(svg) { flex: none; width: 20px; height: 20px; color: var(--red); transition: transform .25s; }
  .cx-bar a:hover :global(svg) { transform: translateX(4px); }

  @media (max-width: 900px) {
    .cx-bar__in { grid-template-columns: 1fr; }
    .cx-bar__in li + li { border-left: 0; border-top: 1px solid rgba(255,255,255,.1); }
    .cx-bar a, .cx-bar li:first-child a { padding: 18px 0; }
  }
  @media (max-width: 640px) {
    .cx { min-height: clamp(520px, calc(100svh - 150px), 680px); }
    .cx__shade { background: linear-gradient(180deg, rgba(8,9,11,.3) 0%, rgba(8,9,11,0) 25%, rgba(8,9,11,.3) 50%, rgba(8,9,11,.92) 100%); }
    .cx__k { font-size: .7rem; letter-spacing: .14em; margin-bottom: 14px; }
    .cx__h { font-size: clamp(1.9rem, 10.2vw, 3.4rem); }
    .cx__row { margin-top: 18px; gap: 16px; }
    .cx__lede { font-size: .98rem; }
    .cx__cta { width: 100%; }
    .cx__btn { flex: 1; min-height: 50px; padding-inline: 16px; font-size: .95rem; }
    .cx__cap { display: none; }
    .cx__foot { justify-content: flex-start; padding-block: 12px 16px; }
    .cx__dots i { width: 36px; }
    .cx-bar b { font-size: 1.08rem; }
    .cx-bar small { font-size: .8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cx__img.is-on, .cx__h > span > span, .cx__k, .cx__row { animation: none; opacity: 1; transform: none; }
    .cx__dots i::after { animation: none !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cx]').forEach((root) => {
    const imgs = [...root.querySelectorAll<HTMLElement>('[data-shot]')];
    const caps = [...root.querySelectorAll<HTMLElement>('[data-cap]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const T = 7000;
    root.style.setProperty('--cx-t', T + 'ms');
    let i = 0, timer = 0, resume = 0;
    const show = (n: number) => {
      i = n;
      imgs.forEach((im, k) => { if (k === n) { im.classList.remove('is-on'); void im.offsetWidth; } im.classList.toggle('is-on', k === n); });
      caps.forEach((c, k) => c.classList.toggle('is-on', k === n));
      dots.forEach((d, k) => d.setAttribute('aria-selected', String(k === n)));
    };
    const start = () => { if (!timer) timer = window.setInterval(() => { if (document.visibilityState === 'visible') show((i + 1) % imgs.length); }, T); };
    root.addEventListener('click', (e) => {
      const d = (e.target as Element).closest<HTMLElement>('[data-dot]');
      if (!d) return;
      clearInterval(timer); timer = 0; root.classList.add('is-paused'); show(Number(d.dataset.dot));
      clearTimeout(resume); resume = window.setTimeout(() => { root.classList.remove('is-paused'); start(); }, 14000);
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    start();
  });
</script>
