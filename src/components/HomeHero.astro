---
// Homepage header: full-bleed photo that crossfades between TSS's three businesses, with tabs along the bottom.
const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const slides = [
  {
    tab: 'Products', tabSub: 'Cones, barriers, signs, drums',
    h: ['Traffic control gear,', 'in stock and shipped.'],
    d: 'Cones, WATERCADE barriers, barricades, drums and signs. No minimum order, shipped anywhere in the U.S.',
    img: CDN + 'thumbnail_IMG_0141_f25c7165-4733-4438-9391-0687acaa7c46.jpg', pos: '50% 50%',
    a: ['Shop products', '/collections'], b: ['Build a quote', '/pages/request-a-quote?type=products']
  },
  {
    tab: 'Rentals', tabSub: 'TMAs, VMS boards, arrow boards',
    h: ['Rent it by the job.', 'Delivered from our yard.'],
    d: 'TMA crash trucks, message boards, arrow boards, light towers and every product we sell. NJ, NY, PA and CT.',
    img: '/fleet/tma-rear-2.jpg', pos: '50% 42%',
    a: ['See rentals', '/collections/equipment-rentals'], b: ['Request a rental', '/pages/request-a-quote?type=rental']
  },
  {
    tab: 'Lane closures', tabSub: 'Certified, experienced crews',
    h: ['Lane closures,', 'set up right.'],
    d: 'Certified, experienced crews running MUTCD-compliant closures across NJ, NY, PA, CT and DE.',
    img: '/fleet/lc-hero.webp', pos: '62% 45%',
    a: ['Book a crew', '/pages/request-a-quote?type=lane-closure'], b: ['Free closure plan', '/tools/lane-closure-plan']
  }
];
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section class="hh" data-hh>
  <div class="hh__bg" aria-hidden="true">
    {slides.map((s, i) => <img class:list={['hh__img', i === 0 && 'is-on']} src={s.img} alt="" style={`object-position:${s.pos}`} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} data-img={i} />)}
    <span class="hh__scrim"></span>
  </div>

  <div class="wrap hh__in">
    <p class="hh__k">Traffic Safety Service · Since 1971</p>
    <div class="hh__stage" aria-live="polite">
      {slides.map((s, i) => (
        <div class:list={['hh__slide', i === 0 && 'is-on']} data-slide={i}>
          <h1 class="hh__h">{s.h.map((l, k) => <span class="hh__line" style={`--k:${k}`}><span>{l}</span></span>)}</h1>
          <p class="hh__d">{s.d}</p>
          <div class="hh__cta">
            <a href={s.a[1]} class="hh__btn hh__btn--solid">{s.a[0]}<Fragment set:html={ARROW} /></a>
            <a href={s.b[1]} class="hh__btn hh__btn--line">{s.b[0]}</a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="wrap hh__tabs-wrap">
    <div class="hh__tabs" role="tablist" aria-label="What we do">
      {slides.map((s, i) => (
        <button type="button" role="tab" class="hh__tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>
          <span class="hh__tn">0{i + 1}</span>
          <span class="hh__tt"><b>{s.tab}</b><small>{s.tabSub}</small></span>
          <i class="hh__bar" aria-hidden="true"></i>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  .hh { position: relative; color: #fff; background: #111; isolation: isolate; overflow: hidden; }
  .hh__bg { position: absolute; inset: 0; z-index: -1; }
  .hh__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.08); transition: opacity 1.1s ease, transform 7s ease-out; }
  .hh__img.is-on { opacity: 1; transform: scale(1); }
  .hh__scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(122,4,4,.94) 0%, rgba(140,5,5,.8) 34%, rgba(90,4,4,.35) 62%, rgba(12,12,14,.1) 85%), linear-gradient(0deg, rgba(10,10,12,.7), transparent 38%); }
  .hh__in { min-height: clamp(440px, 46vw, 620px); display: flex; flex-direction: column; justify-content: center; padding-block: clamp(36px, 4.5vw, 64px) clamp(120px, 11vw, 150px); }
  .hh__k { margin: 0 0 16px; color: var(--gold); font-size: clamp(.82rem, 1vw, .98rem); letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 720; }
  .hh__stage { display: grid; max-width: 900px; }
  .hh__slide { grid-area: 1 / 1; pointer-events: none; }
  .hh__slide.is-on { pointer-events: auto; }
  .hh__h { margin: 0; color: #fff; font-size: clamp(2.4rem, 4.8vw, 4.6rem); line-height: 1.02; letter-spacing: -.035em; font-variation-settings: 'wght' 800; }
  .hh__line { display: block; overflow: hidden; padding-bottom: .06em; white-space: nowrap; }
  .hh__line > span { display: inline-block; transform: translateY(105%); transition: transform .7s cubic-bezier(.2,.8,.2,1); }
  .hh__slide.is-on .hh__line > span { transform: none; transition-delay: calc(.15s + var(--k) * 90ms); }
  .hh__slide.is-out .hh__line > span { transform: translateY(-105%); transition-duration: .45s; transition-delay: 0s; }
  .hh__d, .hh__cta { opacity: 0; transform: translateY(10px); transition: opacity .45s, transform .45s; }
  .hh__slide.is-on .hh__d, .hh__slide.is-on .hh__cta { opacity: 1; transform: none; transition-delay: .4s; }
  .hh__slide.is-on .hh__cta { transition-delay: .5s; }
  .hh__d { margin: 18px 0 0; max-width: 52ch; font-size: clamp(1.02rem, 1.3vw, 1.22rem); line-height: 1.55; color: #fde0db; }
  .hh__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .hh__btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 54px; padding: 14px 24px 13px; border-radius: 12px; font-size: 1.04rem; font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .15s, transform .15s; }
  .hh__btn :global(svg) { width: 18px; height: 18px; transition: transform .2s; }
  .hh__btn:hover { transform: translateY(-1px); }
  .hh__btn:hover :global(svg) { transform: translateX(3px); }
  .hh__btn--solid { background: #fff; color: var(--red); box-shadow: 0 14px 30px -14px rgba(0,0,0,.5); }
  .hh__btn--solid:hover { background: var(--haze); }
  .hh__btn--line { border: 1.5px solid rgba(255,255,255,.65); color: #fff; }
  .hh__btn--line:hover { background: rgba(255,255,255,.12); }

  .hh__tabs-wrap { position: absolute; left: 0; right: 0; bottom: clamp(18px, 2.4vw, 32px); }
  .hh__tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .hh__tab { all: unset; box-sizing: border-box; position: relative; overflow: hidden; cursor: pointer; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 14px; padding: 16px 18px; border-radius: 16px; background: rgba(15,15,18,.45); border: 1px solid rgba(255,255,255,.16); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: background .3s, border-color .3s, transform .3s; }
  .hh__tab:hover { background: rgba(15,15,18,.6); border-color: rgba(255,255,255,.3); }
  .hh__tab:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
  .hh__tab[aria-selected="true"] { background: #fff; color: var(--ink); border-color: #fff; }
  .hh__tn { font-size: .82rem; font-variation-settings: 'wght' 780; color: var(--gold); letter-spacing: .06em; }
  .hh__tab[aria-selected="true"] .hh__tn { color: var(--red); }
  .hh__tt { min-width: 0; }
  .hh__tt b { display: block; font-size: 1.12rem; line-height: 1.15; font-variation-settings: 'wght' 760; }
  .hh__tt small { display: block; margin-top: 2px; font-size: .84rem; opacity: .72; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hh__bar { position: absolute; left: 0; bottom: 0; height: 3px; width: 0; background: var(--red); }
  .hh__tab[aria-selected="true"] .hh__bar { animation: hhBar var(--hh-t, 6000ms) linear forwards; }
  .hh.is-paused .hh__tab[aria-selected="true"] .hh__bar { animation: none; width: 100%; }
  @keyframes hhBar { to { width: 100%; } }

  @media (max-width: 1100px) {
    .hh__in { padding-bottom: 150px; }
    .hh__scrim { background: linear-gradient(180deg, rgba(122,4,4,.9) 0%, rgba(122,4,4,.72) 50%, rgba(15,10,10,.6) 100%); }
  }
  @media (max-width: 760px) {
    .hh__in { min-height: 0; padding-block: 30px 26px; text-align: center; align-items: center; }
    .hh__k { margin-bottom: 12px; font-size: .78rem; }
    .hh__stage { width: 100%; }
    .hh__h { font-size: clamp(1.7rem, 7.6vw, 2.5rem); }
    .hh__d { margin: 12px auto 0; font-size: .98rem; }
    .hh__cta { justify-content: center; margin-top: 18px; }
    .hh__btn { flex: 1; min-height: 50px; padding-inline: 14px; font-size: .96rem; }
    .hh__tabs-wrap { position: static; padding-bottom: 20px; }
    .hh__tabs { gap: 6px; }
    .hh__tab { grid-template-columns: 1fr; gap: 2px; padding: 12px 6px 13px; text-align: center; border-radius: 12px; }
    .hh__tn { display: none; }
    .hh__tt b { font-size: .8rem; white-space: nowrap; }
    .hh__tt small { display: none; }
  }
  @media (max-width: 360px) { .hh__tt b { font-size: .72rem; } }
  @media (prefers-reduced-motion: reduce) {
    .hh__img, .hh__line > span, .hh__d, .hh__cta { transition: none; }
    .hh__tab .hh__bar { animation: none !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hh]').forEach((root) => {
    const imgs = [...root.querySelectorAll<HTMLElement>('[data-img]')];
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const tabs = [...root.querySelectorAll<HTMLElement>('[data-tab]')];
    const T = 6000;
    root.style.setProperty('--hh-t', T + 'ms');
    let i = 0, timer = 0, resume = 0;
    const show = (n: number) => {
      if (n === i) return;
      const old = slides[i];
      old.classList.remove('is-on'); old.classList.add('is-out');
      setTimeout(() => old.classList.remove('is-out'), 700);
      i = n;
      slides[i].classList.add('is-on');
      imgs.forEach((im, k) => im.classList.toggle('is-on', k === i));
      tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
      // restart progress bar
      const bar = tabs[i].querySelector<HTMLElement>('.hh__bar');
      if (bar) { bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = ''; }
    };
    const start = () => { if (!timer) timer = window.setInterval(() => { if (document.visibilityState === 'visible') show((i + 1) % slides.length); }, T); };
    const stop = () => { clearInterval(timer); timer = 0; };
    root.addEventListener('click', (e) => {
      const t = (e.target as Element).closest<HTMLElement>('[data-tab]');
      if (!t) return;
      stop(); root.classList.add('is-paused'); show(Number(t.dataset.tab));
      clearTimeout(resume); resume = window.setTimeout(() => { root.classList.remove('is-paused'); start(); }, 15000);
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    start();
  });
</script>
