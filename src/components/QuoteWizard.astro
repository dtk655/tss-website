        { id: 'where', label: 'Where is the job or delivery?', type: 'text', ph: 'Town and state', w: 'half' },
        { id: 'when', label: 'When do you need it?', type: 'text', ph: 'A date, or "ASAP"', w: 'half' }
      ] }
    ]
  };
  const ABOUT = [
    { id: 'name', label: 'Your name', type: 'text', req: true, w: 'half', ac: 'name' },
    { id: 'company', label: 'Company or agency', type: 'text', w: 'half', ac: 'organization' },
    { id: 'email', label: 'Email', type: 'email', w: 'half', ph: 'you@company.com', ac: 'email' },
    { id: 'phone', label: 'Phone', type: 'tel', w: 'half', ph: '(908) 555-0123', ac: 'tel' },
    { id: 'role', label: 'Which best describes you?', type: 'chips', opts: ['Contractor', 'Municipality or agency', 'Utility', 'Event organizer', 'Other'] },
    { id: 'prefer', label: 'Best way to reach you', type: 'seg', opts: ['Call', 'Email', 'Text'] },
    { id: 'urgency', label: 'How soon do you need pricing?', type: 'chips', opts: ['Today', 'This week', 'Just planning ahead'] },
    { id: 'account', label: 'Do you have a TSS account?', type: 'chips', opts: ['Yes', 'No', 'No, but I want one'] },
    { id: 'extra', label: 'Anything else we should know?', type: 'textarea' }
  ];

  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const today = () => { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
  const fmtDate = (s) => { if (!s) return ''; const [y, m, d] = s.split('-').map(Number); return new Date(y, m - 1, d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); };
  const dayCount = (a, b) => { if (!a || !b) return 0; const n = Math.round((new Date(b) - new Date(a)) / 864e5) + 1; return n > 0 ? n : 0; };
  const KEY = 'tss_quote_draft_v2';

  let uid = 0;
  document.querySelectorAll('[data-qw]').forEach((root) => {
    const ns = 'qs' + uid++;
    const body = root.querySelector('[data-qw-body]');
