    s += `<rect x="92" y="${cy - 4.5}" width="18" height="9" rx="3" fill="#b60606"/><rect x="101" y="${cy - 3.5}" width="5" height="7" rx="1.5" fill="#f7d4d4"/>`;
    return s + '</svg>';
  }

