    /* ---------------- category popup ---------------- */
    const modal = document.createElement('div');
    modal.className = 'qs-modal'; modal.hidden = true;
    modal.innerHTML = `<div class="qs-modal__bg" data-qs-mclose></div><div class="qs-modal__panel" role="dialog" aria-modal="true" aria-labelledby="${ns}-mt"><header class="qs-modal__head" data-qs-mhead></header><div class="qs-modal__list" data-qs-mlist></div><footer class="qs-modal__foot"><span class="qs-modal__count" data-qs-mcount></span><button type="button" class="qs-btn" data-qs-mclose data-qs-mdone></button></footer></div>`;
    document.body.appendChild(modal);
    const mHead = modal.querySelector('[data-qs-mhead]'), mList = modal.querySelector('[data-qs-mlist]'), mCount = modal.querySelector('[data-qs-mcount]');
    let mctx = null, mOpener = null;
    const rowVar = {};
    const inCtx = (e) => (mctx.cat ? e.c === mctx.cat : e.h === mctx.prod);
    const rowSel = (h) => `[data-qs-pr="${CSS.escape(h)}"]`;
    function prodRow(h) {
      const p = CAT.prods[h];
      const mine = lines((e) => e.h === h);
      const cur = rowVar[h] ?? (mine[0]?.v || p.v[0] || '');
      rowVar[h] = cur;
      const q = state.job.sel[h + '::' + cur]?.q || 0;
      const chips = p.v.length > 1 ? mine.map((e) => `<button type="button" class="qs-vchip${e.v === cur ? ' is-cur' : ''}" data-qs-vsel="${esc(e.v)}">${p.vi ? `<img src="${varImg(h, e.v)}" alt="">` : ''}${esc(e.v)}<b>&times;${e.q}</b></button>`).join('') : '';
      const im = varImg(h, cur);
      const swap = lastImg[h] && lastImg[h] !== im; lastImg[h] = im;
      return `<div class="qs-pr${mine.length ? ' is-on' : ''}" data-qs-pr="${esc(h)}" data-t="${esc(p.t.toLowerCase())}">
        <span class="qs-pr__img">${im ? `<img src="${im}" alt=""${swap ? ' class="is-swap"' : ' loading="lazy"'}>` : ''}</span>
        <div class="qs-pr__main"><b>${esc(p.t)}</b>
          ${p.v.length > 1 && p.o ? optsHtml(p, cur) : ''}
          ${p.v.length > 1 && !p.o ? `<label class="qs-pr__varl"><span>${p.v.length} options</span><select class="qs-input qs-pr__var" data-qs-var aria-label="Option for ${esc(p.t)}">${p.v.map((v) => `<option${v === cur ? ' selected' : ''}>${esc(v)}</option>`).join('')}</select></label>` : ''}
          ${chips ? `<div class="qs-vchips">${chips}</div>` : ''}
        </div>
        <div class="qs-pr__ctl"><span class="qs-pr__qty">Quantity</span>${stepper(p.t, q)}</div></div>`;
    }
    const lastImg = {};
    const SWATCH = { orange: '#f26a1b', 'safety orange': '#f26a1b', lime: '#b8e02a', 'lime green': '#b8e02a', 'dark green': '#1f5e2e', green: '#2e7d32', 'navy blue': '#1f2f5c', navy: '#1f2f5c', blue: '#1e5bd8', 'sky blue': '#6ec6f0', 'light blue': '#6ec6f0', pink: '#f48fb1', red: '#c62828', white: '#ffffff', yellow: '#f5d000', black: '#16181b', silver: '#c4c8cc', gray: '#9aa0a6', grey: '#9aa0a6', purple: '#7b3fb0', brown: '#7a4b2a' };
    const swatch = (v) => SWATCH[v.toLowerCase()] || (CSS.supports('color', v) ? v : null);
    const cap = (t) => t.charAt(0).toUpperCase() + t.slice(1);
    const varIdx = (p, v) => Math.max(0, p.v.indexOf(v));
    const varImg = (h, v) => { const p = CAT.prods[h]; return (p.vi && p.vi[varIdx(p, v)]) || CUT[h] || p.i; };
    function optsHtml(p, curV) {
      const cur = p.vo[varIdx(p, curV)];
      return `<div class="qs-ogs">${p.o.map(([name, vals], k) => {
        if (vals.length < 2) return `<div class="qs-og"><span class="qs-og__l">${esc(cap(name))}: <b>${esc(vals[0])}</b></span></div>`;
        const isColor = /colou?r/i.test(name) && vals.filter((v) => swatch(v)).length >= vals.length / 2;
        const avail = (val) => p.vo.some((vo) => vo[k] === val && vo.every((x, j) => j === k || x === cur[j]));
        const btns = vals.map((val) => {
          const on = cur[k] === val, na = !avail(val);
          const a = `data-qs-opt="${k}" data-val="${esc(val)}" aria-pressed="${on}"`;
          return isColor
            ? `<button type="button" class="qs-sw${on ? ' is-on' : ''}${na ? ' is-na' : ''}" style="--sw:${swatch(val) || '#d9dcdf'}" ${a} title="${esc(val)}" aria-label="${esc(cap(name))}: ${esc(val)}"></button>`
            : `<button type="button" class="qs-ob${on ? ' is-on' : ''}${na ? ' is-na' : ''}" ${a}>${esc(val)}</button>`;
        }).join('');
        return `<div class="qs-og"><span class="qs-og__l">${esc(cap(name))}${isColor ? `: <b>${esc(cur[k])}</b>` : ''}</span><div class="qs-og__v${isColor ? ' is-sw' : ''}">${btns}</div></div>`;
      }).join('')}</div>`;
    }
    function rerow(h, focusSel) {
      const row = mList.querySelector(rowSel(h));
      if (!row) return;
      const hid = row.hidden;
      row.outerHTML = prodRow(h);
      const nr = mList.querySelector(rowSel(h)); nr.hidden = hid;
      if (focusSel) nr.querySelector(focusSel)?.focus();
      updateCount();
    }
    function setQ(h, q) {
      const p = CAT.prods[h], v = rowVar[h] || '';
      setSel(h + '::' + v, { h, v, t: p.t, i: varImg(h, v), c: mctx.cat || 'equip' }, q);
    }
    function updateCount() {
      const ls = lines(inCtx), units = ls.reduce((a, e) => a + e.q, 0);
      mCount.innerHTML = ls.length ? `<b>${ls.length} selected</b> &middot; ${units.toLocaleString()} unit${units > 1 ? 's' : ''}` : 'Set a quantity to add an item';
      const db = modal.querySelector('[data-qs-mdone]');
      const lbl = ls.length ? `Add ${ls.length} item${ls.length > 1 ? 's' : ''} to quote` : 'Close';
      if (db.dataset.lbl !== lbl) { db.dataset.lbl = lbl; db.innerHTML = lbl + (ls.length ? ICON.check : ''); db.classList.toggle('is-close', !ls.length); if (ls.length) { db.classList.remove('is-bump'); void db.offsetWidth; db.classList.add('is-bump'); } }
    }
    function openModal(ctx) {
      mctx = ctx; mOpener = document.activeElement;
      const hs = (ctx.cat ? CAT.cats[ctx.cat].p : [ctx.prod]).filter((h) => CAT.prods[h]);
      const meta = ctx.cat ? CATS[ctx.cat] : { t: short(CAT.prods[ctx.prod].t), img: CUT[ctx.prod] || CAT.prods[ctx.prod].i, tint: T.yellow };
      mHead.innerHTML = `<span class="qs-modal__art" style="--tint:${meta.tint}"><img src="${meta.img}" alt=""></span>
        <div class="qs-modal__ttl"><p class="qs-k">${state.type === 'rental' ? 'Rent' : 'Buy'}</p><h3 id="${ns}-mt">${esc(meta.t)}</h3><small>${hs.length} product${hs.length > 1 ? 's' : ''}. Pick options and exact quantities.</small></div>
        <button type="button" class="qs-modal__x" data-qs-mclose aria-label="Close">${ICON.x}</button>
        ${hs.length > 5 ? `<label class="qs-modal__search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg><input type="search" placeholder="Search ${esc(meta.t.toLowerCase())}" data-qs-msearch aria-label="Search ${esc(meta.t)}"></label>` : ''}`;
      mList.innerHTML = hs.map(prodRow).join('') + '<p class="qs-modal__none" hidden>No matches. You can add it under “Need something not shown?”</p>';
      mList.scrollTop = 0;
      updateCount();
      modal.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => modal.classList.add('is-open')));
      document.documentElement.style.overflow = 'hidden';
      { const c = document.getElementById('tss-chat-assistant'); if (c) c.style.visibility = 'hidden'; }
      setTimeout(() => modal.querySelector('.qs-modal__x')?.focus({ preventScroll: true }), 80);
    }
    function closeModal() {
      if (modal.hidden) return;
      modal.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      setTimeout(() => { modal.hidden = true; }, 320);
      { const c = document.getElementById('tss-chat-assistant'); if (c) c.style.visibility = ''; }
      refreshShop();
      const t = mctx.cat ? body.querySelector(`[data-qs-cat="${mctx.cat}"] .qs-ci__add`) : body.querySelector(`[data-qs-eq="${CSS.escape(mctx.prod)}"] .qs-ci__add`);
      (t || mOpener)?.focus?.({ preventScroll: true });
    }
    modal.addEventListener('click', (e) => {
      if (e.target.closest('[data-qs-mclose]')) return closeModal();
      const row = e.target.closest('[data-qs-pr]'); if (!row) return;
      const h = row.dataset.qsPr, cur = state.job.sel[h + '::' + (rowVar[h] || '')]?.q || 0;
      if (e.target.closest('[data-qs-padd]')) { setQ(h, 1); rerow(h, '[data-qs-qty]'); mList.querySelector(rowSel(h) + ' [data-qs-qty]')?.select(); }
      else if (e.target.closest('[data-qs-inc]')) { setQ(h, cur + 1); rerow(h, '[data-qs-inc]'); }
      else if (e.target.closest('[data-qs-dec]')) { setQ(h, cur - 1); rerow(h, cur - 1 > 0 ? '[data-qs-dec]' : '[data-qs-inc]'); }
      else if (e.target.closest('[data-qs-opt]')) {
        const ob = e.target.closest('[data-qs-opt]'), p = CAT.prods[h], k = +ob.dataset.qsOpt, val = ob.dataset.val;
        const want = [...p.vo[varIdx(p, rowVar[h])]]; want[k] = val;
        let i = p.vo.findIndex((vo) => vo.every((x, j) => x === want[j]));
        if (i < 0) i = p.vo.findIndex((vo) => vo[k] === val);
        rowVar[h] = p.v[i];
        rerow(h, `[data-qs-opt="${k}"][data-val="${CSS.escape(val)}"]`);
      }
      else { const vc = e.target.closest('[data-qs-vsel]'); if (vc) { rowVar[h] = vc.dataset.qsVsel; rerow(h, '.qs-og button.is-on, [data-qs-var]'); } }
    });
    modal.addEventListener('change', (e) => { const sv = e.target.closest('[data-qs-var]'); if (sv) { const h = sv.closest('[data-qs-pr]').dataset.qsPr; rowVar[h] = sv.value; rerow(h, '[data-qs-var]'); } });
    modal.addEventListener('input', (e) => {
      const qi = e.target.closest('[data-qs-qty]');
      if (qi && qi.value !== '') { const row = qi.closest('[data-qs-pr]'), h = row.dataset.qsPr; setQ(h, qi.value); const q = state.job.sel[h + '::' + (rowVar[h] || '')]?.q || 0; const sc = qi.closest('.qs-step-ctl'); sc.classList.toggle('is-zero', !q); sc.querySelector('[data-qs-dec]').disabled = !q; row.classList.toggle('is-on', !!q || lines((e) => e.h === h).length > 0); updateCount(); }
      const se = e.target.closest('[data-qs-msearch]');
      if (se) {
        const q = se.value.trim().toLowerCase(); let any = false;
        mList.querySelectorAll('[data-qs-pr]').forEach((r) => { const on = !q || q.split(/\s+/).every((w) => r.dataset.t.includes(w)); r.hidden = !on; any = any || on; });
        mList.querySelector('.qs-modal__none').hidden = any;
      }
    });
    modal.addEventListener('focusout', (e) => {
      const qi = e.target.closest && e.target.closest('[data-qs-qty]');
      if (!qi || modal.hidden) return;
      const h = qi.closest('[data-qs-pr]').dataset.qsPr;
      setQ(h, qi.value);
      setTimeout(() => { const a = document.activeElement; if (!a || !a.closest || !a.closest(rowSel(h))) rerow(h); else updateCount(); }, 0);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) closeModal(); });

    function sync(id) {
      flow().forEach((s) => s.fields.forEach((f) => { if (f.showIf) { const el = body.querySelector(`[data-qs-field="${f.id}"]`); if (el) el.hidden = !visible(f); } }));
      if (id === 'deliverDate' || id === 'startDate') { const end = body.querySelector(`[data-qs-f="${id === 'deliverDate' ? 'pickupDate' : 'endDate'}"]`); if (end) end.min = state.job[id] || today(); }
      const days = body.querySelector('[data-qs-days]');
      if (days) { const n = dayCount(state.job.deliverDate, state.job.pickupDate); days.innerHTML = n ? daysPill(n) : ''; }
    }
    function showErr(id, msg) {
      const p = body.querySelector(`[data-qs-err="${id}"]`), w = body.querySelector(`[data-qs-field="${id}"]`);
      if (p) { p.hidden = false; p.textContent = msg; }
      if (w) { w.classList.remove('is-err'); void w.offsetWidth; w.classList.add('is-err'); w.scrollIntoView({ block: 'center', behavior: 'smooth' }); w.querySelector('input:not([type=radio]):not([type=checkbox]), textarea')?.focus({ preventScroll: true }); }
      return false;
    }
    function clearErr(id) { const p = body.querySelector(`[data-qs-err="${id}"]`); if (p) p.hidden = true; body.querySelector(`[data-qs-field="${id}"]`)?.classList.remove('is-err'); }
    function validate(fs, scope) {
      for (const f of fs) {
        if (!f.req || !visible(f)) continue;
        const v = state[scope][f.id];
        if (f.type === 'catalog') { if (!allItems().length) return showErr('cat', 'Add at least one item, or describe it under “Need something not shown?”'); continue; }
        if (f.type === 'zip') {
          const j = state.job;
          if (!/^\d{5}$/.test(j.zip || '') && !(j.zipManual && j.town)) return showErr('zip', 'Enter the 5-digit ZIP code.');
          if (!j.town) return showErr('zip', j.zipManual ? 'Type the town and state.' : 'We couldn\u2019t find that ZIP. Check it, or type the town instead.');
          continue;
        }
        if (f.type === 'multi' || f.type === 'equip') { if (!Array.isArray(v) || !v.length) return showErr(f.id, 'Pick at least one.'); continue; }
        if (!v || !String(v).trim()) return showErr(f.id, f.type === 'date' ? 'Pick a date. A best guess is fine.' : f.type === 'pics' || f.type === 'seg' ? 'Pick one to continue.' : 'We need this one to price the job.');
      }
      return true;
    }

    // Phones: lift the Conner launcher above the sticky Back / Continue bar (same hook product pages use)
    // and hold its greeting bubble while the form is on screen so it doesn't cover fields.
    const mq = matchMedia('(max-width: 640px)');
    let inView = false;
    const lift = () => { const c = document.getElementById('tss-chat-assistant'); if (!c) return; c.toggleAttribute('data-lift', mq.matches && inView); c.toggleAttribute('data-quiet', mq.matches && inView); };
    if ('IntersectionObserver' in window) new IntersectionObserver(([en]) => { inView = en.isIntersecting; lift(); }).observe(root);
    mq.addEventListener?.('change', lift);
    [800, 2500, 6000].forEach((t) => setTimeout(lift, t));

    render();
  });
</script>
