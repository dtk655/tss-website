  function road(n, divided, shoulder) {
    const W = 140, H = 64, top = shoulder ? 10 : 6, bot = H - top, lh = (bot - top) / n;
    let s = `<svg class="qs-road" viewBox="0 0 ${W} ${H}" aria-hidden="true"><rect width="${W}" height="${H}" rx="10" fill="#e9ebe6"/><rect y="${top - 2}" width="${W}" height="${bot - top + 4}" fill="#2b2f34"/>`;
    s += `<path d="M0 ${top}H${W}M0 ${bot}H${W}" stroke="#f4f4f0" stroke-width="1.6"/>`;
    for (let i = 1; i < n; i++) {
      const y = top + lh * i;
      if (i === n / 2) s += divided ? `<rect y="${y - 3}" width="${W}" height="6" fill="#7b8a6c"/><path d="M0 ${y - 3}H${W}M0 ${y + 3}H${W}" stroke="#f5b800" stroke-width="1.2"/>` : `<path d="M0 ${y - 1.3}H${W}M0 ${y + 1.3}H${W}" stroke="#f5b800" stroke-width="1.3"/>`;
