---
// Quote builder: a visual five-step request flow with a live quote ticket.
// Props: preset = 'lane-closure' | 'rental' | 'products' | 'general', fromParam (reads ?type= and ?from=builder).
// Step and field definitions live in the script below so they're easy to edit.
// Posts { type, answers: { job, about }, summary, quoteList, page, submittedAt } to FORM_WEBHOOK.
import { PHONE, PHONE_TEL, EMAIL, FORM_WEBHOOK } from '../lib/config.js';
const { preset = 'general', fromParam = false } = Astro.props;
const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const photos = [
  ['lane-closure', '/fleet/lc-hero.webp', '58% 45%'],
  ['rental', '/fleet/tma-rear-2.jpg', '50% 40%'],
  ['products', CDN + 'thumbnail_IMG_0141_f25c7165-4733-4438-9391-0687acaa7c46.jpg', '50% 50%'],
  ['general', '/watercade/hero-poster.jpg', '60% 50%']
];
---
<section class="qs" data-qw data-preset={preset} data-from-param={fromParam ? '1' : ''} data-phone={PHONE} data-tel={PHONE_TEL} data-email={EMAIL} data-webhook={FORM_WEBHOOK}>
  <div class="qs__main">
    <ol class="qs__steps" data-qs-steps aria-label="Progress"></ol>
    <div class="qs__stage" data-qw-body aria-live="polite">
      <noscript>
        <p><strong>This form needs JavaScript.</strong> You can also call <a href={PHONE_TEL}>{PHONE}</a> or email <a href={`mailto:${EMAIL}`}>{EMAIL}</a> with what you need, where, and when.</p>
      </noscript>
    </div>
  </div>
  <aside class="qs__side" aria-label="Your quote so far">
    <div class="qs-tk">
      <div class="qs-tk__ph">
        {photos.map(([t, src, pos], i) => <img src={src} alt="" data-ph={t} style={`object-position:${pos}`} loading={i === 0 ? 'eager' : 'lazy'} />)}
        <div class="qs-tk__cap">
          <span class="qs-tk__k">Your quote</span>
          <b data-qs-tktitle>Start with what you need</b>
        </div>
      </div>
      <div class="qs-tk__body">
        <ul class="qs-tk__lines" data-qs-lines></ul>
        <div class="qs-tk__perf" aria-hidden="true"></div>
        <ul class="qs-tk__promise">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" /></svg>Priced by a real person, usually within 1 business day</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" /></svg>Free, and nothing is booked by asking</li>
        </ul>
      </div>
    </div>
    <a class="qs-call" href={PHONE_TEL}>
      <span class="qs-call__ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.6 1.6a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 3 6.2 2 2 0 0 1 5 4z" /></svg></span>
      <span><small>Rather talk it through?</small><b>Call {PHONE}</b></span>
    </a>
  </aside>
</section>

<style is:global>
  .qs { --qs-r: 22px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 390px); gap: clamp(22px, 3vw, 40px); align-items: start; }
  .qs__main { min-width: 0; background: #fff; border: 1px solid var(--line); border-radius: var(--qs-r); padding: clamp(20px, 3.4vw, 44px); box-shadow: 0 40px 80px -60px rgba(20, 23, 26, .45); }
  .qs__side { position: sticky; top: calc(var(--header-h, 72px) + 76px); display: grid; gap: 14px; }

  /* ---------- stepper ---------- */
  .qs__steps { list-style: none; margin: 0 0 clamp(26px, 3.4vw, 38px); padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .qs__steps li { position: relative; display: grid; gap: 9px; }
  .qs__steps .qs-bar { height: 4px; border-radius: 4px; background: var(--haze-2); overflow: hidden; }
  .qs__steps .qs-bar i { display: block; height: 100%; width: 0; background: var(--red); border-radius: 4px; transition: width .6s cubic-bezier(.2, .8, .2, 1); }
  .qs__steps li.is-done .qs-bar i, .qs__steps li.is-cur .qs-bar i { width: 100%; }
  .qs__steps button { display: flex; align-items: center; gap: 7px; padding: 0; border: 0; background: none; font: inherit; font-size: .84rem; color: var(--steel); font-variation-settings: 'wght' 560; text-align: left; cursor: default; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .qs__steps li.is-done button { cursor: pointer; color: var(--ink-2); }
  .qs__steps li.is-done button:hover { color: var(--red); }
  .qs__steps li.is-cur button { color: var(--ink); font-variation-settings: 'wght' 720; }
  .qs__steps .qs-n { flex: none; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; font-size: .72rem; background: var(--haze-2); color: var(--steel); font-variation-settings: 'wght' 700; transition: background .3s, color .3s; }
  .qs__steps li.is-cur .qs-n { background: var(--ink); color: #fff; }
  .qs__steps li.is-done .qs-n { background: var(--red); color: #fff; }
  .qs__steps .qs-n svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; }

  /* ---------- step head ---------- */
  .qs-step { display: grid; gap: clamp(22px, 2.6vw, 30px); }
  .qs-head { display: grid; gap: 8px; }
  .qs-k { display: inline-flex; align-items: center; gap: 10px; margin: 0; font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; color: var(--red); font-variation-settings: 'wght' 700; }
  .qs-k::before { content: ''; width: 22px; height: 2px; background: currentColor; }
  .qs-head h2 { margin: 0; font-size: clamp(1.7rem, 2.9vw, 2.45rem); line-height: 1.05; letter-spacing: -.035em; font-variation-settings: 'wght' 780; font-weight: 400; }
  .qs-head p { margin: 0; color: var(--steel); max-width: 60ch; }

  /* entrance animation for each block */
  .qs-in { animation: qsIn .6s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i, 0) * 55ms); }
  .qs-step.is-back .qs-in { animation-name: qsInBack; }
  @keyframes qsIn { from { opacity: 0; transform: translateX(26px); } to { opacity: 1; transform: none; } }
  @keyframes qsInBack { from { opacity: 0; transform: translateX(-26px); } to { opacity: 1; transform: none; } }

  /* ---------- service cards ---------- */
  .qs-svc { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .qs-svc label { position: relative; display: block; cursor: pointer; }
  .qs-svc input { position: absolute; opacity: 0; pointer-events: none; }
  .qs-svc__card { position: relative; display: grid; grid-template-rows: auto 1fr; height: 100%; border: 1.5px solid var(--line); border-radius: 18px; overflow: hidden; background: #fff; transition: border-color .25s, box-shadow .35s, transform .35s cubic-bezier(.2, .8, .2, 1); }
  .qs-svc label:hover .qs-svc__card { transform: translateY(-4px); border-color: var(--line-dark); box-shadow: 0 26px 46px -30px rgba(20, 23, 26, .5); }
  .qs-svc input:checked + .qs-svc__card { border-color: var(--red); box-shadow: 0 0 0 1.5px var(--red), 0 26px 46px -30px rgba(182, 6, 6, .55); }
  .qs-svc input:focus-visible + .qs-svc__card { outline: 3px solid rgba(182, 6, 6, .35); outline-offset: 3px; }
  .qs-svc__art { position: relative; height: clamp(130px, 12vw, 168px); background: linear-gradient(180deg, var(--tint, #ececea), #fff); overflow: hidden; }
  .qs-svc__art img { position: absolute; object-fit: contain; filter: drop-shadow(0 14px 12px rgba(20, 23, 26, .22)); transition: transform .6s cubic-bezier(.2, .8, .2, 1); }
  .qs-svc__art img.is-photo { inset: 0; width: 100%; height: 100%; object-fit: cover; filter: none; }
  .qs-svc__art.is-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, .35)); }
  .qs-svc label:hover .qs-svc__art img { transform: translateY(-4px) scale(1.04); }
  .qs-svc label:hover .qs-svc__art img.is-photo { transform: scale(1.06); }
  .qs-svc__txt { display: grid; gap: 4px; padding: 16px 52px 18px 18px; }
  .qs-svc__txt b { font-size: 1.14rem; letter-spacing: -.015em; font-variation-settings: 'wght' 740; }
  .qs-svc__txt small { color: var(--steel); font-size: .9rem; line-height: 1.4; }
  .qs-tick { position: absolute; right: 16px; bottom: 18px; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid var(--line-dark); background: #fff; transition: background .25s, border-color .25s, transform .3s cubic-bezier(.3, 1.6, .5, 1); }
  .qs-tick svg { width: 14px; height: 14px; fill: none; stroke: #fff; stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 24; stroke-dashoffset: 24; transition: stroke-dashoffset .35s .05s; }
  input:checked + .qs-svc__card .qs-tick, .qs-pic input:checked + span .qs-tick, .qs-eq input:checked + span .qs-tick { background: var(--red); border-color: var(--red); transform: scale(1.08); }
  input:checked + .qs-svc__card .qs-tick svg, .qs-pic input:checked + span .qs-tick svg, .qs-eq input:checked + span .qs-tick svg { stroke-dashoffset: 0; }

  /* ---------- fields ---------- */
  .qs-fields { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 22px 16px; }
  .qs-f { grid-column: span 6; display: grid; gap: 9px; align-content: start; min-width: 0; }
  .qs-f.is-half { grid-column: span 3; }
  .qs-f.is-third { grid-column: span 2; }
  .qs-f[hidden] { display: none; }
  .qs-lbl { font-size: .95rem; color: var(--ink); font-variation-settings: 'wght' 660; }
  .qs-lbl em { font-style: normal; color: var(--steel); font-variation-settings: 'wght' 450; font-size: .86rem; margin-left: 4px; }
  .qs-hint { margin: 0; font-size: .86rem; color: var(--steel); }
  .qs-err { margin: 0; font-size: .88rem; color: var(--red); font-variation-settings: 'wght' 640; display: flex; align-items: center; gap: 6px; }
  .qs-err[hidden] { display: none; }
  .qs-f.is-err { animation: qsShake .4s; }
  @keyframes qsShake { 20%, 60% { transform: translateX(-5px); } 40%, 80% { transform: translateX(5px); } }
  .qs-input { width: 100%; min-height: 54px; padding: 14px 16px; font: inherit; font-size: 1rem; color: var(--ink); background: #fff; border: 1.5px solid var(--line-dark); border-radius: 12px; transition: border-color .2s, box-shadow .2s; appearance: none; }
  textarea.qs-input { min-height: 116px; resize: vertical; line-height: 1.5; }
  .qs-input::placeholder { color: #9aa2a9; }
  .qs-input:hover { border-color: #b3bac1; }
  .qs-input:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 4px rgba(20, 23, 26, .07); }
  .qs-f.is-err .qs-input { border-color: var(--red); box-shadow: 0 0 0 4px rgba(182, 6, 6, .08); }

  /* chips */
  .qs-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .qs-chip { position: relative; }
  .qs-chip input { position: absolute; opacity: 0; pointer-events: none; }
  .qs-chip span { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; padding: 10px 17px; border: 1.5px solid var(--line-dark); border-radius: 999px; background: #fff; font-size: .95rem; font-variation-settings: 'wght' 560; cursor: pointer; transition: border-color .2s, background .2s, color .2s, transform .2s; user-select: none; }
  .qs-chip span:hover { border-color: var(--ink-2); }
  .qs-chip span svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .qs-chip input:checked + span { background: var(--ink); border-color: var(--ink); color: #fff; animation: qsPop .3s cubic-bezier(.3, 1.6, .5, 1); }
  .qs-chip input:focus-visible + span { outline: 3px solid rgba(182, 6, 6, .35); outline-offset: 2px; }
  @keyframes qsPop { 50% { transform: scale(1.06); } }

  /* segmented */
  .qs-seg { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); padding: 4px; gap: 4px; background: var(--haze); border: 1px solid var(--line); border-radius: 14px; }
  .qs-seg label { position: relative; }
  .qs-seg input { position: absolute; opacity: 0; pointer-events: none; }
  .qs-seg span { display: flex; align-items: center; justify-content: center; gap: 7px; min-height: 46px; padding: 8px 6px; border-radius: 10px; font-size: .95rem; font-variation-settings: 'wght' 600; color: var(--ink-2); cursor: pointer; transition: background .25s, color .25s, box-shadow .25s; white-space: nowrap; }
  .qs-seg span:hover { color: var(--ink); }
  .qs-seg span svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .qs-seg input:checked + span { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(20, 23, 26, .08), 0 6px 16px -8px rgba(20, 23, 26, .3); }
  .qs-seg input:checked + span svg { color: var(--red); }
  .qs-seg input:focus-visible + span { outline: 3px solid rgba(182, 6, 6, .35); }

  /* picture cards (road type, crew scope) */
  .qs-pics { display: grid; grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); gap: 10px; }
  .qs-pic { position: relative; }
  .qs-pic input { position: absolute; opacity: 0; pointer-events: none; }
  .qs-pic > span { position: relative; display: grid; gap: 10px; height: 100%; padding: 12px 12px 14px; border: 1.5px solid var(--line); border-radius: 16px; background: #fff; cursor: pointer; transition: border-color .2s, box-shadow .3s, transform .3s; }
  .qs-pic > span:hover { border-color: var(--line-dark); transform: translateY(-2px); }
  .qs-pic input:checked + span { border-color: var(--red); box-shadow: 0 0 0 1.5px var(--red); }
  .qs-pic input:focus-visible + span { outline: 3px solid rgba(182, 6, 6, .35); outline-offset: 2px; }
  .qs-pic b { font-size: .98rem; line-height: 1.2; font-variation-settings: 'wght' 700; padding-right: 26px; }
  .qs-pic small { color: var(--steel); font-size: .84rem; line-height: 1.35; margin-top: -6px; }
  .qs-pic .qs-tick { right: 10px; top: 10px; bottom: auto; width: 22px; height: 22px; }
  .qs-pic .qs-tick svg { width: 12px; height: 12px; }
  .qs-road { display: block; width: 100%; height: auto; border-radius: 10px; }
  .qs-road .dash { stroke-dasharray: 8 7; }
  .qs-pic input:checked + span .qs-road .dash, .qs-pic > span:hover .qs-road .dash { animation: qsRoad 1s linear infinite; }
  @keyframes qsRoad { to { stroke-dashoffset: -15; } }
  .qs-pic .qs-ico { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--haze); color: var(--ink); transition: background .25s, color .25s; }
  .qs-pic .qs-ico svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .qs-pic input:checked + span .qs-ico { background: var(--red-tint); color: var(--red); }

  /* equipment tiles (multi) */
  .qs-eqs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .qs-eq { position: relative; }
  .qs-eq input { position: absolute; opacity: 0; pointer-events: none; }
  .qs-eq > span { position: relative; display: grid; grid-template-rows: 64px auto; gap: 8px; height: 100%; padding: 10px 10px 12px; border: 1.5px solid var(--line); border-radius: 14px; background: linear-gradient(185deg, var(--tint, #ececea), #fff 80%); cursor: pointer; transition: border-color .2s, box-shadow .3s, transform .3s; }
  .qs-eq > span:hover { transform: translateY(-2px); border-color: var(--line-dark); }
  .qs-eq input:checked + span { border-color: var(--red); box-shadow: 0 0 0 1.5px var(--red); }
  .qs-eq input:focus-visible + span { outline: 3px solid rgba(182, 6, 6, .35); outline-offset: 2px; }
  .qs-eq img { width: 100%; height: 64px; object-fit: contain; filter: drop-shadow(0 8px 8px rgba(20, 23, 26, .18)); }
  .qs-eq .qs-noimg { display: grid; place-items: center; height: 64px; color: var(--steel); }
  .qs-eq .qs-noimg svg { width: 30px; height: 30px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .qs-eq b { font-size: .88rem; line-height: 1.2; font-variation-settings: 'wght' 680; }
  .qs-eq .qs-tick { right: 8px; top: 8px; bottom: auto; width: 22px; height: 22px; }
  .qs-eq .qs-tick svg { width: 12px; height: 12px; }

  /* catalog picker */
  .qs-cat { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .qs-ci { position: relative; display: grid; grid-template-rows: auto auto auto; border: 1.5px solid var(--line); border-radius: 18px; background: linear-gradient(185deg, var(--tint, #ececea) 0%, #fff 70%); overflow: hidden; transition: border-color .2s, box-shadow .3s, transform .35s cubic-bezier(.2, .8, .2, 1); }
  .qs-ci:hover { transform: translateY(-3px); border-color: var(--line-dark); box-shadow: 0 22px 40px -30px rgba(20, 23, 26, .5); }
  .qs-ci.is-on { border-color: var(--red); box-shadow: 0 0 0 1.5px var(--red), 0 22px 40px -30px rgba(182, 6, 6, .5); }
  .qs-ci__pick { display: grid; justify-items: center; gap: 8px; padding: 14px 10px 6px; border: 0; background: none; font: inherit; color: inherit; cursor: pointer; }
  .qs-ci__pick img { width: 100%; height: clamp(74px, 7vw, 92px); object-fit: contain; filter: drop-shadow(0 12px 10px rgba(20, 23, 26, .2)); transition: transform .45s cubic-bezier(.2, .8, .2, 1); }
  .qs-ci:hover .qs-ci__pick img { transform: translateY(-4px) scale(1.05); }
  .qs-ci__pick b { font-size: .92rem; line-height: 1.2; text-align: center; font-variation-settings: 'wght' 690; min-height: 2.4em; display: grid; place-items: center; }
  .qs-ci__ctl { padding: 4px 10px 12px; }
  .qs-ci__add { width: 100%; min-height: 40px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border: 1.5px solid var(--line-dark); border-radius: 999px; background: #fff; font: inherit; font-size: .88rem; font-variation-settings: 'wght' 640; color: var(--ink); cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .qs-ci__add:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
  .qs-ci__add svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; }
  .qs-step-ctl { display: grid; grid-template-columns: 40px minmax(0, 1fr) 40px; align-items: center; min-height: 40px; border-radius: 999px; background: var(--ink); color: #fff; animation: qsPop .3s cubic-bezier(.3, 1.6, .5, 1); }
  .qs-step-ctl button { height: 40px; border: 0; background: none; color: #fff; font-size: 1.2rem; line-height: 1; cursor: pointer; border-radius: 999px; transition: background .15s; }
  .qs-step-ctl button:hover { background: rgba(255, 255, 255, .14); }
  .qs-step-ctl input { width: 100%; min-width: 0; border: 0; background: none; color: #fff; text-align: center; font: inherit; font-size: .95rem; font-variation-settings: 'wght' 720; -moz-appearance: textfield; }
  .qs-step-ctl input::-webkit-outer-spin-button, .qs-step-ctl input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .qs-step-ctl input:focus { outline: none; }
  .qs-ci__badge { position: absolute; top: 10px; right: 10px; display: grid; place-items: center; min-width: 24px; height: 24px; padding: 0 7px; border-radius: 999px; background: var(--red); color: #fff; font-size: .74rem; font-variation-settings: 'wght' 760; opacity: 0; transform: scale(.4); transition: opacity .2s, transform .3s cubic-bezier(.3, 1.6, .5, 1); }
  .qs-ci.is-on .qs-ci__badge { opacity: 1; transform: none; }
  .qs-more { display: grid; gap: 10px; padding: 18px; border: 1.5px dashed var(--line-dark); border-radius: 18px; background: var(--haze); }
  .qs-more > p { margin: 0; font-size: .95rem; font-variation-settings: 'wght' 660; }
  .qs-rows { display: grid; gap: 8px; }
  .qs-row { display: grid; grid-template-columns: minmax(0, 1fr) 96px 46px; gap: 8px; animation: qsIn .35s cubic-bezier(.2, .8, .2, 1); }
  .qs-row .qs-input { min-height: 48px; padding: 11px 14px; }
  .qs-row button { border: 1.5px solid var(--line-dark); background: #fff; border-radius: 12px; color: var(--steel); cursor: pointer; display: grid; place-items: center; }
  .qs-row button:hover { color: var(--red); border-color: var(--red); }
  .qs-row button svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
  .qs-addrow { justify-self: start; display: inline-flex; align-items: center; gap: 8px; padding: 6px 2px; border: 0; background: none; font: inherit; font-size: .94rem; color: var(--red); font-variation-settings: 'wght' 680; cursor: pointer; }
  .qs-addrow svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
  .qs-addrow:hover { text-decoration: underline; text-underline-offset: 4px; }

  .qs-pill { display: inline-flex; align-items: center; gap: 8px; justify-self: start; padding: 8px 14px; border-radius: 999px; background: var(--red-tint); color: var(--red); font-size: .9rem; font-variation-settings: 'wght' 680; animation: qsPop .35s; }
  .qs-pill svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* banner (work zone plan, quote list) */
  .qs-note { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 16px; background: linear-gradient(90deg, var(--red-tint), #fff); border: 1px solid #f2d3d3; }
  .qs-note p { margin: 0; flex: 1; font-size: .95rem; }
  .qs-note button { flex: none; min-height: 40px; padding: 0 16px; border: 0; border-radius: 999px; background: var(--red); color: #fff; font: inherit; font-size: .9rem; font-variation-settings: 'wght' 680; cursor: pointer; }
  .qs-note button:hover { background: var(--red-press); }

  /* ---------- nav ---------- */
