        { id: 'crew', label: 'What should our crew handle?', type: 'pics', n: 4, opts: [
          { v: 'Flaggers only', s: 'Certified flaggers direct traffic', icon: ICON.flag }, { v: 'Full closure setup', s: 'We set and remove the closure', icon: ICON.cone }, { v: 'Closure plus maintenance', s: 'Crew stays on site all shift', icon: ICON.crew }, { v: 'Traffic control plan', s: 'Drawings for your permit', icon: ICON.plan }] },
        { id: 'equipment', label: 'Equipment you need from us', type: 'equip', opts: [
          { v: 'TMA crash truck', img: IMG.tma, tint: T.red }, { v: 'Arrow board', img: IMG.arrow, tint: T.yellow }, { v: 'Message board (VMS)', img: IMG.vms, tint: T.orange }, { v: 'Cones or drums', img: IMG.cones, tint: T.orange },
          { v: 'Barricades', img: IMG.barricades, tint: T.blue }, { v: 'Signs', img: IMG.signs, tint: T.red }, { v: 'Lights', img: IMG.tower, tint: T.yellow }, { v: 'We have our own', icon: ICON.box, tint: T.grey }] },
        { id: 'work', label: 'Describe the work', type: 'textarea', req: true, ph: 'e.g. Crane pick over the right lane for rooftop HVAC units. Lane and sidewalk need to close.' }
      ] },
      { name: 'Where and when', k: 'Location and schedule', title: 'Where and when is the job?', lead: 'An exact spot helps us plan the right setup and drive time.', fields: [
