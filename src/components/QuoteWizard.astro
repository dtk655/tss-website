        { id: 'state', label: 'State', type: 'seg', req: true, opts: STATES_LC, w: 'half', hint: 'Lane closures in NJ, NY, PA, CT and DE.' },
        { id: 'shift', label: 'When does the work happen?', type: 'seg', opts: [['Day work', ICON.sun], ['Night work', ICON.moon], ['24-hour', ICON.clock]] },
        { id: 'startDate', label: 'Start date', type: 'date', req: true, w: 'third', pair: 1 },
        { id: 'endDate', label: 'End date', type: 'date', w: 'third', pair: 1 },
        { id: 'startTime', label: 'Start time', type: 'time', w: 'third' },
        { id: 'recur', label: 'Is this a one-time job?', type: 'chips', opts: ['One-time', 'Recurring work'] },
        { id: 'permit', label: 'Police detail or permit arranged?', type: 'chips', opts: ['Yes', 'No', 'Not sure'] },
        { id: 'authority', label: 'Road authority, if you know it', type: 'chips', opts: ['NJDOT', 'NYSDOT', 'PennDOT', 'County', 'Town or city', 'Turnpike or parkway', 'Not sure'] }
      ] }
    ],
    rental: [
      { name: 'Equipment', k: 'Rental', title: 'What do you need to rent?', lead: 'Tap to add. Rough counts are fine, we’ll confirm everything.', fields: [
        { id: 'cat', label: '', type: 'catalog', req: true, cat: RENT_CAT },
        { id: 'setup', label: 'Should our crew set it up?', type: 'seg', opts: ['Deliver and set up', 'Just deliver', 'Not sure yet'] }
      ] },
      { name: 'Delivery', k: 'Delivery and dates', title: 'Where and when should it arrive?', lead: 'We deliver and pick up in NJ, NY, PA and CT.', fields: [
        { id: 'address', label: 'Delivery address', type: 'text', req: true, ph: 'Street address or jobsite' },
        { id: 'town', label: 'Town or city', type: 'text', req: true, w: 'half' },
        { id: 'state', label: 'State', type: 'seg', req: true, opts: STATES_R, w: 'half' },
        { id: 'deliverDate', label: 'Delivery date', type: 'date', req: true, w: 'half', pair: 1 },
        { id: 'pickupDate', label: 'Pickup date', type: 'date', w: 'half', pair: 1, hint: 'A guess is fine.' },
        { id: 'days', type: 'days' },
        { id: 'contact', label: 'On-site contact, name and phone', type: 'text', ph: 'Who meets the truck?' },
        { id: 'notes', label: 'Anything else about the job?', type: 'textarea', ph: 'Access, gate codes, placement, timing…' }
      ] }
    ],
    products: [
      { name: 'Products', k: 'Purchase', title: 'What do you need?', lead: 'Tap to add. Rough counts are fine, we’ll confirm sizes and options.', fields: [
        { id: 'cat', label: '', type: 'catalog', req: true, cat: BUY_CAT },
        { id: 'custom', label: 'Custom colors, stenciling or your logo?', type: 'seg', opts: ['No', 'Yes'], cls: 'is-2' },
        { id: 'customDesc', label: 'Describe the customization', type: 'textarea', ph: 'e.g. 200 orange cones stenciled "CITY OF NEWARK DPW", logo on both sides', showIf: { custom: 'Yes' } }
      ] },
      { name: 'Shipping', k: 'Shipping', title: 'Where should it ship?', lead: 'Products ship anywhere in the U.S.', fields: [
        { id: 'shipTo', label: 'Ship-to city and state', type: 'text', req: true, ph: 'e.g. Newark, NJ', w: 'half' },
        { id: 'needBy', label: 'Needed by', type: 'date', w: 'half' },
        { id: 'po', label: 'How are you buying?', type: 'chips', opts: ['Credit card', 'Purchase order', 'Net terms account', 'Not sure'] },
        { id: 'notes', label: 'Anything else?', type: 'textarea', ph: 'Sizes, colors, delivery details…' }
      ] }
    ],
    general: [
      { name: 'The job', k: 'Tell us more', title: 'What can we help with?', lead: 'Describe the job, the event or the problem. Plain words are perfect.', fields: [
        { id: 'what', label: 'What do you need?', type: 'textarea', req: true, ph: 'e.g. Closing a street for a block party in June, need barricades and signs, maybe a crew.' },
        { id: 'topics', label: 'Any of these involved?', type: 'multi', opts: ['Lane closure', 'Equipment rental', 'Buying products', 'WATERCADE barriers', 'Special event', 'Custom signs'] }
      ] },
      { name: 'Where and when', k: 'Location and timing', title: 'Where and when?', lead: 'Rough is fine.', fields: [
        { id: 'where', label: 'Where is the job or delivery?', type: 'text', ph: 'Town and state', w: 'half' },
        { id: 'when', label: 'When do you need it?', type: 'text', ph: 'A date, or "ASAP"', w: 'half' }
      ] }
    ]
  };
  const ABOUT = [
    { id: 'name', label: 'Your name', type: 'text', req: true, w: 'half', ac: 'name' },
    { id: 'company', label: 'Company or agency', type: 'text', w: 'half', ac: 'organization' },
    { id: 'email', label: 'Email', type: 'email', w: 'half', ph: 'you@company.com', ac: 'email' },
    { id: 'phone', label: 'Phone', type: 'tel', w: 'half', ph: '(908) 555-0123', ac: 'tel' },
    { id: 'role', label: 'Which best describes you?', type: 'chips', opts: ['Contractor', 'Municipality or agency', 'Utility', 'Event organizer', 'Other'] },
    { id: 'prefer', label: 'Best way to reach you', type: 'seg', opts: ['Call', 'Email', 'Text'] },
    { id: 'urgency', label: 'How soon do you need pricing?', type: 'chips', opts: ['Today', 'This week', 'Just planning ahead'] },
    { id: 'account', label: 'Do you have a TSS account?', type: 'chips', opts: ['Yes', 'No', 'No, but I want one'] },
    { id: 'extra', label: 'Anything else we should know?', type: 'textarea' }
  ];

  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const today = () => { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
  const fmtDate = (s) => { if (!s) return ''; const [y, m, d] = s.split('-').map(Number); return new Date(y, m - 1, d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); };
  const dayCount = (a, b) => { if (!a || !b) return 0; const n = Math.round((new Date(b) - new Date(a)) / 864e5) + 1; return n > 0 ? n : 0; };
  const KEY = 'tss_quote_draft_v2';

  let uid = 0;
  document.querySelectorAll('[data-qw]').forEach((root) => {
    const ns = 'qs' + uid++;
    const body = root.querySelector('[data-qw-body]');
    const stepsEl = root.querySelector('[data-qs-steps]');
    const linesEl = root.querySelector('[data-qs-lines]');
    const PHONE = root.dataset.phone, TEL = root.dataset.tel, EMAIL = root.dataset.email, HOOK = root.dataset.webhook;
    const preset = FLOW[root.dataset.preset] ? root.dataset.preset : 'general';
    let state = { type: preset, job: {}, about: {}, step: 0, planApplied: false, listApplied: false };
    try { const d = JSON.parse(sessionStorage.getItem(KEY) || 'null'); if (d && FLOW[d.type]) state = { ...state, ...d }; } catch {}
    const qp = new URLSearchParams(location.search);
    if (root.dataset.fromParam) {
      if (qp.get('from') === 'builder') { state.type = 'lane-closure'; state.step = 1; }
      const qt = qp.get('type'); if (qt && FLOW[qt]) { state.type = qt; if (state.step < 1) state.step = 1; }
    }
    if (preset !== 'general' && state.step < 1) { state.type = preset; state.step = 1; }
    state.job.cat = state.job.cat || {};
    let lastStep = state.step, seen = new Set();

    const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify(state)); } catch {} };
    const plan = (() => { try { return JSON.parse(sessionStorage.getItem('tss_workzone_plan') || 'null'); } catch { return null; } })();
    const flow = () => FLOW[state.type];
    const stepNames = () => ['Service', flow()[0].name, flow()[1].name, 'Your details', 'Review'];
    const catalog = () => (state.type === 'rental' ? RENT_CAT : state.type === 'products' ? BUY_CAT : []);
    const visible = (f) => !f.showIf || Object.entries(f.showIf).every(([k, v]) => state.job[k] === v);

    /* ---------------- field html ---------------- */
    const lbl = (f, forId) => f.label ? `<${forId ? `label for="${forId}"` : 'span'} class="qs-lbl" id="${ns}-${f.id}-l">${esc(f.label)}${f.req ? '' : '<em>Optional</em>'}</${forId ? 'label' : 'span'}>` : '';
    function field(f, scope, i) {
      const v = state[scope][f.id];
      const id = `${ns}-${f.id}`;
      const cls = ['qs-f', 'qs-in', f.w === 'half' && 'is-half', f.w === 'third' && 'is-third', f.pair && 'qs-pair'].filter(Boolean).join(' ');
      const tail = `${f.hint ? `<p class="qs-hint">${esc(f.hint)}</p>` : ''}<p class="qs-err" data-qs-err="${f.id}" hidden></p>`;
      const wrap = (inner, forId) => `<div class="${cls}" style="--i:${i}" data-qs-field="${f.id}"${visible(f) ? '' : ' hidden'}>${lbl(f, forId)}${inner}${tail}</div>`;
      const name = `${id}-g`;
      switch (f.type) {
        case 'text': case 'email': case 'tel': case 'date': case 'time': {
          let min = '';
          if (f.type === 'date') min = ` min="${f.id === 'pickupDate' || f.id === 'endDate' ? esc(state.job.deliverDate || state.job.startDate || today()) : today()}"`;
          return wrap(`<input class="qs-input" id="${id}" type="${f.type}" data-qs-f="${f.id}" value="${esc(v || '')}"${f.ph ? ` placeholder="${esc(f.ph)}"` : ''}${f.ac ? ` autocomplete="${f.ac}"` : ''}${f.type === 'email' ? ' inputmode="email"' : ''}${min} />`, id);
        }
        case 'textarea':
          return wrap(`<textarea class="qs-input" id="${id}" rows="4" data-qs-f="${f.id}"${f.ph ? ` placeholder="${esc(f.ph)}"` : ''}>${esc(v || '')}</textarea>`, id);
        case 'chips': case 'multi': {
          const multi = f.type === 'multi'; const vals = multi ? (Array.isArray(v) ? v : []) : v;
          return wrap(`<div class="qs-chips" role="group" aria-labelledby="${id}-l">${f.opts.map((o) => `<label class="qs-chip"><input type="${multi ? 'checkbox' : 'radio'}" name="${name}" value="${esc(o)}" data-qs-f="${f.id}"${multi ? ' data-qs-multi="1"' : ''}${(multi ? vals.includes(o) : vals === o) ? ' checked' : ''}><span>${multi ? ICON.check.replace('<svg', '<svg aria-hidden="true"') : ''}${esc(o)}</span></label>`).join('')}</div>`);
        }
        case 'seg':
          return wrap(`<div class="qs-seg ${f.cls || ''}" role="radiogroup" aria-labelledby="${id}-l">${f.opts.map((o) => { const [t, ic] = Array.isArray(o) ? o : [o, '']; return `<label><input type="radio" name="${name}" value="${esc(t)}" data-qs-f="${f.id}"${v === t ? ' checked' : ''}><span>${ic}${esc(t)}</span></label>`; }).join('')}</div>`);
        case 'pics':
          return wrap(`<div class="qs-pics" style="--n:${f.n || 4}" role="radiogroup" aria-labelledby="${id}-l">${f.opts.map((o) => `<label class="qs-pic"><input type="radio" name="${name}" value="${esc(o.v)}" data-qs-f="${f.id}"${v === o.v ? ' checked' : ''}><span>${o.art || `<span class="qs-ico">${o.icon}</span>`}<b>${esc(o.v)}</b>${o.s ? `<small>${esc(o.s)}</small>` : ''}<span class="qs-tick">${ICON.check}</span></span></label>`).join('')}</div>`);
        case 'equip': {
          const vals = Array.isArray(v) ? v : [];
          return wrap(`<div class="qs-eqs" role="group" aria-labelledby="${id}-l">${f.opts.map((o) => `<label class="qs-eq"><input type="checkbox" name="${name}" value="${esc(o.v)}" data-qs-f="${f.id}" data-qs-multi="1"${vals.includes(o.v) ? ' checked' : ''}><span style="--tint:${o.tint}">${o.img ? `<img src="${o.img}" alt="" loading="lazy">` : `<span class="qs-noimg">${o.icon}</span>`}<b>${esc(o.v)}</b><span class="qs-tick">${ICON.check}</span></span></label>`).join('')}</div>`);
        }
        case 'catalog': {
          const rows = Array.isArray(state.job.items) && state.job.items.length ? state.job.items : [];
          return wrap(`<div class="qs-cat">${f.cat.map((c, k) => catTile(c, k)).join('')}</div>
            <div class="qs-more"><p>Need something not shown?</p><div class="qs-rows" data-qs-rows>${rows.map(rowHtml).join('')}</div>
            <button type="button" class="qs-addrow" data-qs-addrow>${ICON.plus}Add an item</button></div>`);
        }
        case 'days': {
          const n = dayCount(state.job.deliverDate, state.job.pickupDate);
          return `<div class="qs-f qs-in" style="--i:${i}" data-qs-days>${n ? daysPill(n) : ''}</div>`;
        }
      }
      return '';
    }
    const daysPill = (n) => `<span class="qs-pill">${ICON.cal}${n} day${n > 1 ? 's' : ''} on rent${n >= 28 ? ', monthly rates apply' : n >= 7 ? ', weekly rates apply' : ''}</span>`;
    const catTile = (c) => {
      const q = +state.job.cat[c.id] || 0;
      return `<div class="qs-ci${q ? ' is-on' : ''}" style="--tint:${c.tint}" data-qs-ci="${c.id}">
        <span class="qs-ci__badge" aria-hidden="true">${q || ''}</span>
        <button type="button" class="qs-ci__pick" data-qs-pick aria-label="Add ${esc(c.t)}"><img src="${c.img}" alt="" loading="lazy"><b>${esc(c.t)}</b></button>
        <div class="qs-ci__ctl">${q ? stepper(c, q) : `<button type="button" class="qs-ci__add" data-qs-pick>${ICON.plus}Add</button>`}</div></div>`;
    };
    const stepper = (c, q) => `<div class="qs-step-ctl"><button type="button" data-qs-dec aria-label="Fewer ${esc(c.t)}">&minus;</button><input type="number" min="0" inputmode="numeric" value="${q}" data-qs-qty aria-label="${esc(c.t)} quantity"><button type="button" data-qs-inc aria-label="More ${esc(c.t)}">+</button></div>`;
    const rowHtml = (r) => `<div class="qs-row"><input class="qs-input" type="text" placeholder="Item, e.g. 36-inch cones with collars" value="${esc(r.desc || '')}" data-qs-rdesc aria-label="Item"><input class="qs-input" type="number" min="1" placeholder="Qty" value="${esc(r.qty || '')}" data-qs-rqty aria-label="Quantity"><button type="button" data-qs-rrm aria-label="Remove item">${ICON.x}</button></div>`;

    /* ---------------- items ---------------- */
    function allItems() {
      const cat = catalog().filter((c) => +state.job.cat[c.id] > 0).map((c) => ({ desc: c.t, qty: +state.job.cat[c.id], img: c.img }));
      const extra = (state.job.items || []).filter((r) => r.desc && r.desc.trim()).map((r) => ({ desc: r.desc.trim(), qty: +r.qty || 1 }));
      return [...cat, ...extra];
    }

    /* ---------------- stepper + ticket ---------------- */
    function renderSteps() {
      stepsEl.innerHTML = stepNames().map((n, i) => {
        const st = i < state.step ? 'is-done' : i === state.step ? 'is-cur' : '';
        return `<li class="${st}"><span class="qs-bar"><i></i></span><button type="button" data-qs-goto="${i}"${i < state.step ? '' : ' disabled'}${i === state.step ? ' aria-current="step"' : ''}><span class="qs-n">${i < state.step ? ICON.check : i + 1}</span><span class="qs-t">${esc(n)}</span></button></li>`;
      }).join('');
      stepsEl.querySelectorAll('[data-qs-goto]').forEach((b) => b.addEventListener('click', () => go(+b.dataset.qsGoto)));
    }
    function ticketLines() {
      const j = state.job, a = state.about, L = [];
      const svc = SVC.find((s) => s.id === state.type);
      if (state.step > 0 || state.touched) L.push(['svc', 'Service', esc(svc.b)]);
      if (state.type === 'lane-closure') {
        if (j.roadType) L.push(['road', 'Road', esc(j.roadType + (j.speed ? `, ${j.speed} mph` : ''))]);
        if (j.lanes?.length) L.push(['lanes', 'Closing', esc(j.lanes.join(', '))]);
        if (j.crew) L.push(['crew', 'Crew', esc(j.crew)]);
        if (j.equipment?.length) L.push(['eq', 'Equipment', esc(j.equipment.join(', '))]);
      }
      if (state.type === 'rental' || state.type === 'products') {
        const it = allItems();
        if (it.length) L.push(['items:' + it.map((x) => x.desc + x.qty).join('|'), `${it.length} item${it.length > 1 ? 's' : ''}`, `<span class="qs-tk__thumbs">${it.map((x) => `<span>${x.img ? `<img src="${x.img}" alt="">` : ''}${x.qty} &times; ${esc(x.desc)}</span>`).join('')}</span>`]);
        if (j.setup) L.push(['setup', 'Setup', esc(j.setup)]);
        if (j.custom === 'Yes') L.push(['custom', 'Custom', 'Colors, stenciling or logo']);
      }
      if (state.type === 'general' && j.what) L.push(['what', 'The job', esc(j.what.length > 90 ? j.what.slice(0, 90) + '…' : j.what)]);
      const place = [j.location || j.address, j.town, j.state, j.shipTo, j.where].filter(Boolean).join(', ');
      if (place) L.push(['place', state.type === 'products' ? 'Ships to' : 'Where', esc(place)]);
      const d1 = j.startDate || j.deliverDate || j.needBy, d2 = j.endDate || j.pickupDate;
      if (d1) L.push(['dates', state.type === 'products' ? 'Needed by' : 'Dates', esc(fmtDate(d1) + (d2 ? ` → ${fmtDate(d2)}` : '')) + (j.shift ? ` &middot; ${esc(j.shift)}` : '')]);
      else if (j.when) L.push(['when', 'When', esc(j.when)]);
      if (a.name) L.push(['who', 'For', esc([a.name, a.company].filter(Boolean).join(', '))]);
      return L;
    }
    function renderTicket() {
      const svc = SVC.find((s) => s.id === state.type);
      root.querySelectorAll('[data-ph]').forEach((im) => im.classList.toggle('is-on', im.dataset.ph === state.type));
      root.querySelector('[data-qs-tktitle]').textContent = state.step > 0 || state.touched ? svc.b : 'Start with what you need';
      const L = ticketLines();
      const ghosts = ['What you need', 'Where', 'When', 'Your details'].slice(Math.min(L.length, 4));
      linesEl.innerHTML = L.map(([k, t, v]) => `<li class="${seen.has(k) ? '' : 'is-new'}"><span class="qs-dot">${ICON.check}</span><div><small>${t}</small><span class="v">${v}</span></div></li>`).join('')
        + (L.length < 4 ? ghosts.map((g) => `<li class="is-ghost"><span class="qs-dot"></span><div><span class="v">${g}</span></div></li>`).join('') : '');
      seen = new Set(L.map((l) => l[0]));
    }

    /* ---------------- steps ---------------- */
    function go(n) { state.step = n; state.touched = true; save(); render(); const y = root.getBoundingClientRect().top + scrollY - 110; if (scrollY > y) scrollTo({ top: y, behavior: 'smooth' }); }
    const head = (k, title, lead) => `<div class="qs-head qs-in" style="--i:0"><p class="qs-k">${esc(k)}</p><h2>${esc(title)}</h2>${lead ? `<p>${esc(lead)}</p>` : ''}</div>`;
    const navHtml = (next = 'Continue', back = true) => `<div class="qs-nav">${back ? `<button type="button" class="qs-back" data-qs-back>${ICON.back}<span class="qs-t">Back</span></button>` : '<span class="qs-skip">Takes about 2 minutes</span>'}<button type="button" class="qs-btn" data-qs-next>${esc(next)}${ICON.arrow}</button></div>`;

    function render() {
      renderSteps(); renderTicket();
      const dir = state.step < lastStep ? ' is-back' : '';
      lastStep = state.step;
      if (state.step === 0) stepService(dir);
      else if (state.step === 1 || state.step === 2) stepJob(state.step - 1, dir);
      else if (state.step === 3) stepAbout(dir);
      else stepReview(dir);
      body.querySelector('[data-qs-back]')?.addEventListener('click', () => go(state.step - 1));
    }

    function stepService(dir) {
      body.innerHTML = `<div class="qs-step${dir}">${head('Get started', 'What can we quote for you?', 'Pick the closest fit. You can change it any time.')}
        <div class="qs-svc" role="radiogroup" aria-label="Service">${SVC.map((s, i) => `<label class="qs-in" style="--i:${i + 1}"><input type="radio" name="${ns}-svc" value="${s.id}"${state.touched && state.type === s.id ? ' checked' : ''}><span class="qs-svc__card"><span class="qs-svc__art${s.photo ? ' is-photo' : ''}" style="--tint:${s.tint || '#ececea'}">${s.photo ? `<img class="is-photo" src="${s.photo}" alt="" style="object-position:58% 45%">` : s.imgs.map(([src, st]) => `<img src="${src}" alt="" style="${st}">`).join('')}</span><span class="qs-svc__txt"><b>${esc(s.b)}</b><small>${esc(s.s)}</small></span><span class="qs-tick">${ICON.check}</span></span></label>`).join('')}</div>
        ${navHtml('Continue', false)}</div>`;
      body.querySelectorAll(`[name="${ns}-svc"]`).forEach((r) => r.addEventListener('change', () => {
        state.type = r.value; state.touched = true; save(); renderTicket();
        setTimeout(() => go(1), 380);
      }));
      body.querySelector('[data-qs-next]').addEventListener('click', () => {
        if (!state.touched) { const c = body.querySelector('.qs-svc'); c.classList.remove('is-err'); void c.offsetWidth; c.animate([{ transform: 'translateX(-6px)' }, { transform: 'translateX(6px)' }, { transform: 'none' }], { duration: 300 }); return; }
        go(1);
      });
    }

    function stepJob(k, dir) {
      const s = flow()[k];
      let banners = '';
      if (k === 0 && state.type === 'lane-closure' && plan && !state.planApplied) banners += `<div class="qs-note qs-in" style="--i:1"><p>You built a work zone plan. Use it to fill in this step?</p><button type="button" data-qs-useplan>Use my plan</button></div>`;
      const list = window.TSSQuote?.items?.() || [];
      if (k === 0 && state.type !== 'lane-closure' && list.length && !state.listApplied) banners += `<div class="qs-note qs-in" style="--i:1"><p>You have ${list.length} item${list.length > 1 ? 's' : ''} in your quote list.</p><button type="button" data-qs-uselist>Add them here</button></div>`;
      body.innerHTML = `<div class="qs-step${dir}">${head(s.k, s.title, s.lead)}${banners}
        <div class="qs-fields">${s.fields.map((f, i) => field(f, 'job', i + 2)).join('')}</div>${navHtml()}</div>`;
      wire('job');
      body.querySelector('[data-qs-useplan]')?.addEventListener('click', () => {
        const eq = (plan.equipment || []).map((e) => (typeof e === 'string' ? e : e.name || e.title || '')).join(' ');
        const map = [['TMA|attenuator', 'TMA crash truck'], ['arrow', 'Arrow board'], ['VMS|message', 'Message board (VMS)'], ['cone|drum', 'Cones or drums'], ['barricade', 'Barricades'], ['sign', 'Signs'], ['light', 'Lights']];
        const set = new Set(state.job.equipment || []);
        map.forEach(([re, v]) => { if (new RegExp(re, 'i').test(eq)) set.add(v); });
        state.job.equipment = [...set];
        if (plan.summary) state.job.work = ((state.job.work || '') + '\n\nWork zone plan: ' + plan.summary).trim();
        state.planApplied = true; save(); render();
      });
      body.querySelector('[data-qs-uselist]')?.addEventListener('click', () => {
        const rows = list.map((it) => ({ desc: `${it.title}${it.variant ? ` (${it.variant})` : ''}${it.mode ? `, ${it.mode}` : ''}${it.note ? `. ${it.note}` : ''}`, qty: it.qty || 1 }));
        if (state.type === 'general') state.job.what = ((state.job.what || '') + '\nQuote list: ' + rows.map((r) => `${r.qty} x ${r.desc}`).join('; ')).trim();
        else state.job.items = [...rows, ...(state.job.items || []).filter((r) => r.desc)];
        state.listApplied = true; save(); render();
      });
      body.querySelector('[data-qs-next]').addEventListener('click', () => { if (validate(s.fields, 'job')) go(state.step + 1); });
    }

    function stepAbout(dir) {
      body.innerHTML = `<div class="qs-step${dir}">${head('Your details', 'Who should the quote go to?', 'We only use this to send your price.')}
        <div class="qs-fields">${ABOUT.map((f, i) => field(f, 'about', i + 1)).join('')}</div>${navHtml('Review my request')}</div>`;
      wire('about');
      body.querySelector('[data-qs-next]').addEventListener('click', () => {
        if (!validate(ABOUT, 'about')) return;
        const a = state.about;
        if (!a.email && !a.phone) return showErr('email', 'Add an email or a phone number so the quote can reach you.');
        if (a.email && !/^\S+@\S+\.\S+$/.test(a.email)) return showErr('email', 'That email doesn’t look complete.');
        if (a.phone && a.phone.replace(/\D/g, '').length < 10) return showErr('phone', 'Add the full 10-digit number.');
        go(4);
      });
    }

    /* ---------------- review + send ---------------- */
    const fmtVal = (v) => Array.isArray(v) ? v.join(', ') : v;
    function pairs() {
      const job = [];
      flow().forEach((s) => s.fields.forEach((f) => {
        if (!visible(f) || f.type === 'catalog' || f.type === 'days') return;
        const v = state.job[f.id];
        if (v && String(fmtVal(v)).trim()) job.push([f.label, f.type === 'date' ? fmtDate(v) : fmtVal(v), f.type === 'textarea' || f.id === 'location' || f.type === 'equip' || f.type === 'multi']);
      }));
      const n = dayCount(state.job.deliverDate, state.job.pickupDate);
      if (state.type === 'rental' && n) job.push(['Rental length', `${n} day${n > 1 ? 's' : ''}`]);
      const about = ABOUT.filter((f) => state.about[f.id] && String(state.about[f.id]).trim()).map((f) => [f.label, state.about[f.id], f.type === 'textarea']);
      return { job, about };
    }
    function stepReview(dir) {
      const svc = SVC.find((s) => s.id === state.type);
      const { job, about } = pairs();
      const items = allItems();
      const dl = (ps) => `<dl>${ps.map(([k, v, wide]) => `<div${wide ? ' class="is-wide"' : ''}><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`).join('')}</dl>`;
      body.innerHTML = `<div class="qs-step${dir}">${head('Review', 'Look good?', 'Check the details, then send it over.')}
        <div class="qs-rv">
          <section class="qs-in" style="--i:1"><header><h3>${esc(svc.b)}</h3><button type="button" data-qs-goto2="0">Change</button></header>
            ${items.length ? `<div class="qs-rv__items">${items.map((x) => `<span>${x.img ? `<img src="${x.img}" alt="">` : ''}<b>${x.qty}</b>${esc(x.desc)}</span>`).join('')}</div>` : `<p class="qs-fine" style="margin:0">${esc(svc.s)}</p>`}
          </section>
          <section class="qs-in" style="--i:2"><header><h3>The job</h3><button type="button" data-qs-goto2="1">Edit</button></header>${job.length ? dl(job) : '<p class="qs-fine">Nothing added.</p>'}</section>
          <section class="qs-in" style="--i:3"><header><h3>Your details</h3><button type="button" data-qs-goto2="3">Edit</button></header>${dl(about)}</section>
        </div>
        <p class="qs-fine qs-in" style="--i:4">A TSS team member will reach out, usually within 1 business day. Nothing is booked or charged by sending this.</p>
        <div class="qs-fail" data-qs-fail hidden></div>
        <div class="qs-nav"><button type="button" class="qs-back" data-qs-back>${ICON.back}<span class="qs-t">Back</span></button><button type="button" class="qs-btn" data-qs-send>Send my request${ICON.arrow}</button></div></div>`;
      body.querySelectorAll('[data-qs-goto2]').forEach((b) => b.addEventListener('click', () => go(+b.dataset.qsGoto2)));
      body.querySelector('[data-qs-send]').addEventListener('click', submit);
    }
    function summaryText() {
      const svc = SVC.find((s) => s.id === state.type);
      const { job, about } = pairs();
      const items = allItems();
      return [`Quote request: ${svc.b}`, '', ...(items.length ? ['ITEMS', ...items.map((x) => `${x.qty} x ${x.desc}`), ''] : []), 'THE JOB', ...job.map(([k, v]) => `${k}: ${v}`), '', 'CONTACT', ...about.map(([k, v]) => `${k}: ${v}`)].join('\n');
    }
    async function submit() {
      const btn = body.querySelector('[data-qs-send]');
      btn.disabled = true; btn.classList.add('is-sending'); btn.innerHTML = `Sending<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9"/></svg>`;
      const items = allItems().map(({ desc, qty }) => ({ desc, qty }));
      const { cat, ...rest } = state.job;
      const payload = { type: state.type, answers: { job: { ...rest, items }, about: state.about }, summary: summaryText(), quoteList: window.TSSQuote?.items?.() || [], page: location.pathname, submittedAt: new Date().toISOString() };
      try {
        if (!HOOK) throw new Error('no webhook');
        const r = await fetch(HOOK, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        try { sessionStorage.removeItem(KEY); } catch {}
        window.TSSQuote?.clear?.();
        done();
      } catch (e) {
        const fail = body.querySelector('[data-qs-fail]');
        fail.hidden = false;
        fail.innerHTML = `<p><strong>That didn’t go through.</strong> Your answers are still here, nothing is lost.</p>
          <p><a href="mailto:${EMAIL}?subject=${encodeURIComponent('Quote request from the website')}&body=${encodeURIComponent(summaryText())}">Email this request instead</a>, try again in a minute, or call <a href="${TEL}"><strong>${PHONE}</strong></a>.</p>`;
        btn.disabled = false; btn.classList.remove('is-sending'); btn.innerHTML = `Try again${ICON.arrow}`;
      }
    }
    function done() {
      const ref = 'TSS-' + Date.now().toString(36).slice(-6).toUpperCase();
      stepsEl.querySelectorAll('li').forEach((li) => { li.className = 'is-done'; li.querySelector('.qs-n').innerHTML = ICON.check; li.querySelector('button').disabled = true; });
      body.innerHTML = `<div class="qs-done">
        <svg class="qs-done__check" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="44"/><path d="M31 51l13 13 26-28"/></svg>
        <h2 class="qs-in" style="--i:6">Request sent</h2>
        <p class="qs-in" style="--i:7">Thanks${state.about.name ? ', ' + esc(state.about.name.split(' ')[0]) : ''}. A TSS team member is on it.</p>
        <span class="qs-ref qs-in" style="--i:8">Reference <b>${ref}</b></span>
        <ol class="qs-next">
          <li class="qs-in" style="--i:9"><span>Now</span><b>We review it</b><small>A real person reads every request.</small></li>
          <li class="qs-in" style="--i:10"><span>Within 1 business day</span><b>You get pricing</b><small>By ${esc((state.about.prefer || 'email').toLowerCase())}, often sooner.</small></li>
          <li class="qs-in" style="--i:11"><span>When you're ready</span><b>We schedule it</b><small>Delivery, shipping or crews, locked in.</small></li>
        </ol>
        <div class="qs-done__acts qs-in" style="--i:12"><a class="qs-btn" href="/collections">Keep browsing${ICON.arrow}</a><a class="qs-back" href="${TEL}">Call ${esc(PHONE)}</a></div>
      </div>`;
      root.querySelector('[data-qs-tktitle]').textContent = 'Request sent';
      body.querySelector('.qs-done')?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }

    /* ---------------- wiring ---------------- */
    function wire(scope) {
      body.querySelectorAll('[data-qs-f]').forEach((el) => {
        el.addEventListener(el.matches('[type=radio], [type=checkbox], [type=date], [type=time]') ? 'change' : 'input', () => {
          const id = el.dataset.qsF;
          if (el.dataset.qsMulti) { const set = new Set(state[scope][id] || []); el.checked ? set.add(el.value) : set.delete(el.value); state[scope][id] = [...set]; }
          else state[scope][id] = el.value;
          save(); clearErr(id);
          if (scope === 'job') sync(id);
          renderTicket();
        });
      });
      // catalog tiles
      body.querySelectorAll('[data-qs-ci]').forEach((tile) => {
        const c = catalog().find((x) => x.id === tile.dataset.qsCi);
        const set = (q) => {
          q = Math.max(0, Math.min(99999, Math.round(+q || 0)));
          if (q) state.job.cat[c.id] = q; else delete state.job.cat[c.id];
          save(); clearErr('cat');
          const was = tile.classList.contains('is-on');
          tile.classList.toggle('is-on', !!q);
          tile.querySelector('.qs-ci__badge').textContent = q || '';
          const ctl = tile.querySelector('.qs-ci__ctl');
          if (!!q !== was) { ctl.innerHTML = q ? stepper(c, q) : `<button type="button" class="qs-ci__add" data-qs-pick>${ICON.plus}Add</button>`; bindTile(); }
          else { const inp = ctl.querySelector('[data-qs-qty]'); if (inp && document.activeElement !== inp) inp.value = q; }
          renderTicket();
        };
        const bindTile = () => {
          tile.querySelectorAll('[data-qs-pick]').forEach((b) => (b.onclick = () => set((+state.job.cat[c.id] || 0) + c.step)));
          const dec = tile.querySelector('[data-qs-dec]'), inc = tile.querySelector('[data-qs-inc]'), inp = tile.querySelector('[data-qs-qty]');
          if (dec) dec.onclick = () => set((+state.job.cat[c.id] || 0) - c.step);
          if (inc) inc.onclick = () => set((+state.job.cat[c.id] || 0) + c.step);
          if (inp) { inp.oninput = () => { if (inp.value !== '') set(inp.value); }; inp.onblur = () => set(inp.value); }
        };
        bindTile();
      });
      // custom rows
      const rowsEl = body.querySelector('[data-qs-rows]');
      if (rowsEl) {
        const syncRows = () => { state.job.items = [...rowsEl.querySelectorAll('.qs-row')].map((r) => ({ desc: r.querySelector('[data-qs-rdesc]').value, qty: r.querySelector('[data-qs-rqty]').value })); save(); clearErr('cat'); renderTicket(); };
        rowsEl.addEventListener('input', syncRows);
        rowsEl.addEventListener('click', (e) => { const b = e.target.closest('[data-qs-rrm]'); if (b) { b.closest('.qs-row').remove(); syncRows(); } });
        body.querySelector('[data-qs-addrow]').addEventListener('click', () => { rowsEl.insertAdjacentHTML('beforeend', rowHtml({})); rowsEl.lastElementChild.querySelector('input').focus(); });
      }
    }
    function sync(id) {
      flow().forEach((s) => s.fields.forEach((f) => { if (f.showIf) { const el = body.querySelector(`[data-qs-field="${f.id}"]`); if (el) el.hidden = !visible(f); } }));
      if (id === 'deliverDate' || id === 'startDate') { const end = body.querySelector(`[data-qs-f="${id === 'deliverDate' ? 'pickupDate' : 'endDate'}"]`); if (end) end.min = state.job[id] || today(); }
      const days = body.querySelector('[data-qs-days]');
      if (days) { const n = dayCount(state.job.deliverDate, state.job.pickupDate); days.innerHTML = n ? daysPill(n) : ''; }
    }
    function showErr(id, msg) {
      const p = body.querySelector(`[data-qs-err="${id}"]`), w = body.querySelector(`[data-qs-field="${id}"]`);
      if (p) { p.hidden = false; p.textContent = msg; }
      if (w) { w.classList.remove('is-err'); void w.offsetWidth; w.classList.add('is-err'); w.scrollIntoView({ block: 'center', behavior: 'smooth' }); w.querySelector('input:not([type=radio]):not([type=checkbox]), textarea')?.focus({ preventScroll: true }); }
      return false;
    }
    function clearErr(id) { const p = body.querySelector(`[data-qs-err="${id}"]`); if (p) p.hidden = true; body.querySelector(`[data-qs-field="${id}"]`)?.classList.remove('is-err'); }
    function validate(fs, scope) {
      for (const f of fs) {
        if (!f.req || !visible(f)) continue;
        const v = state[scope][f.id];
        if (f.type === 'catalog') { if (!allItems().length) return showErr('cat', 'Add at least one item, or describe it under “Need something not shown?”'); continue; }
        if (f.type === 'multi' || f.type === 'equip') { if (!Array.isArray(v) || !v.length) return showErr(f.id, 'Pick at least one.'); continue; }
        if (!v || !String(v).trim()) return showErr(f.id, f.type === 'date' ? 'Pick a date. A best guess is fine.' : f.type === 'pics' || f.type === 'seg' ? 'Pick one to continue.' : 'We need this one to price the job.');
      }
      return true;
    }

    render();
  });
</script>
