    const PHONE = root.dataset.phone, TEL = root.dataset.tel, EMAIL = root.dataset.email, HOOK = root.dataset.webhook;
    const preset = FLOW[root.dataset.preset] ? root.dataset.preset : 'general';
    let state = { type: preset, job: {}, about: {}, step: 0, planApplied: false, listApplied: false };
    try { const d = JSON.parse(sessionStorage.getItem(KEY) || 'null'); if (d && FLOW[d.type]) state = { ...state, ...d }; } catch {}
    const qp = new URLSearchParams(location.search);
    if (root.dataset.fromParam) {
      if (qp.get('from') === 'builder') { state.type = 'lane-closure'; state.step = 1; }
      const qt = qp.get('type'); if (qt && FLOW[qt]) { state.type = qt; if (state.step < 1) state.step = 1; }
    }
    if (preset !== 'general' && state.step < 1) { state.type = preset; state.step = 1; }
    delete state.job.cat; state.job.sel = state.job.sel || {};
    let lastStep = state.step, seen = new Set();
    const topEl = root.querySelector('[data-qs-top]'), rsBtn = root.querySelector('[data-qs-restart]'), rsTxt = root.querySelector('[data-qs-restart-t]');
    let rsTimer = 0;
    function restart() {
      clearTimeout(rsTimer); rsBtn.classList.remove('is-confirm'); rsTxt.textContent = 'Restart quote';
      try { sessionStorage.removeItem(KEY); } catch {}
      state = { type: 'general', job: { sel: {} }, about: {}, step: 0, planApplied: false, listApplied: false };
      Object.keys(rowVar).forEach((k) => delete rowVar[k]);
      seen = new Set(); lastStep = 1;
      if (location.search) history.replaceState(null, '', location.pathname);
      render(); toTop();
      body.querySelector('.qs-svc input')?.focus({ preventScroll: true });
    }
    rsBtn.addEventListener('click', () => {
      if (rsBtn.classList.contains('is-confirm') || body.querySelector('.qs-done')) return restart();
      rsBtn.classList.add('is-confirm'); rsTxt.textContent = 'Tap again to clear';
      clearTimeout(rsTimer);
      rsTimer = setTimeout(() => { rsBtn.classList.remove('is-confirm'); rsTxt.textContent = 'Restart quote'; }, 3500);
    });

    const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify(state)); } catch {} };
    const plan = (() => { try { return JSON.parse(sessionStorage.getItem('tss_workzone_plan') || 'null'); } catch { return null; } })();
    const flow = () => FLOW[state.type];
    const stepNames = () => ['Service', flow()[0].name, flow()[1].name, 'Your details', 'Review'];
    const visible = (f) => !f.showIf || Object.entries(f.showIf).every(([k, v]) => state.job[k] === v);

    /* ---------------- field html ---------------- */
    const lbl = (f, forId) => f.label ? `<${forId ? `label for="${forId}"` : 'span'} class="qs-lbl" id="${ns}-${f.id}-l">${esc(f.label)}${f.req ? '' : '<em>Optional</em>'}</${forId ? 'label' : 'span'}>` : '';
    function field(f, scope, i) {
      const v = state[scope][f.id];
      const id = `${ns}-${f.id}`;
      const cls = ['qs-f', 'qs-in', f.w === 'half' && 'is-half', f.w === 'third' && 'is-third', f.pair && 'qs-pair'].filter(Boolean).join(' ');
      const tail = `${f.hint ? `<p class="qs-hint">${esc(f.hint)}</p>` : ''}<p class="qs-err" data-qs-err="${f.id}" hidden></p>`;
      const wrap = (inner, forId) => `<div class="${cls}" style="--i:${i}" data-qs-field="${f.id}"${visible(f) ? '' : ' hidden'}>${lbl(f, forId)}${inner}${tail}</div>`;
      const name = `${id}-g`;
      switch (f.type) {
        case 'text': case 'email': case 'tel': case 'date': case 'time': {
          let min = '';
          if (f.type === 'date') min = ` min="${f.id === 'pickupDate' || f.id === 'endDate' ? esc(state.job.deliverDate || state.job.startDate || today()) : today()}"`;
          return wrap(`<input class="qs-input" id="${id}" type="${f.type}" data-qs-f="${f.id}" value="${esc(v || '')}"${f.ph ? ` placeholder="${esc(f.ph)}"` : ''}${f.ac ? ` autocomplete="${f.ac}"` : ''}${f.type === 'email' ? ' inputmode="email"' : ''}${min} />`, id);
        }
        case 'textarea':
          return wrap(`<textarea class="qs-input" id="${id}" rows="4" data-qs-f="${f.id}"${f.ph ? ` placeholder="${esc(f.ph)}"` : ''}>${esc(v || '')}</textarea>`, id);
        case 'chips': case 'multi': {
          const multi = f.type === 'multi'; const vals = multi ? (Array.isArray(v) ? v : []) : v;
          return wrap(`<div class="qs-chips" role="group" aria-labelledby="${id}-l">${f.opts.map((o) => `<label class="qs-chip"><input type="${multi ? 'checkbox' : 'radio'}" name="${name}" value="${esc(o)}" data-qs-f="${f.id}"${multi ? ' data-qs-multi="1"' : ''}${(multi ? vals.includes(o) : vals === o) ? ' checked' : ''}><span>${multi ? ICON.check.replace('<svg', '<svg aria-hidden="true"') : ''}${esc(o)}</span></label>`).join('')}</div>`);
        }
        case 'seg':
          return wrap(`<div class="qs-seg ${f.cls || ''}" role="radiogroup" aria-labelledby="${id}-l">${f.opts.map((o) => { const [t, ic] = Array.isArray(o) ? o : [o, '']; return `<label><input type="radio" name="${name}" value="${esc(t)}" data-qs-f="${f.id}"${v === t ? ' checked' : ''}><span>${ic}${esc(t)}</span></label>`; }).join('')}</div>`);
        case 'pics':
          return wrap(`<div class="qs-pics" style="--n:${f.n || 4}" role="radiogroup" aria-labelledby="${id}-l">${f.opts.map((o) => `<label class="qs-pic"><input type="radio" name="${name}" value="${esc(o.v)}" data-qs-f="${f.id}"${v === o.v ? ' checked' : ''}><span>${o.art || `<span class="qs-ico">${o.icon}</span>`}<b>${esc(o.v)}</b>${o.s ? `<small>${esc(o.s)}</small>` : ''}<span class="qs-tick">${ICON.check}</span></span></label>`).join('')}</div>`);
        case 'equip': {
          const vals = Array.isArray(v) ? v : [];
          return wrap(`<div class="qs-eqs" role="group" aria-labelledby="${id}-l">${f.opts.map((o) => `<label class="qs-eq"><input type="checkbox" name="${name}" value="${esc(o.v)}" data-qs-f="${f.id}" data-qs-multi="1"${vals.includes(o.v) ? ' checked' : ''}><span style="--tint:${o.tint}">${o.img ? `<img src="${o.img}" alt="" loading="lazy">` : `<span class="qs-noimg">${o.icon}</span>`}<b>${esc(o.v)}</b><span class="qs-tick">${ICON.check}</span></span></label>`).join('')}</div>`);
        }
        case 'catalog': {
          const rows = Array.isArray(state.job.items) && state.job.items.length ? state.job.items : [];
          curShop = f.shop;
          return wrap(`<div data-qs-shop>${shopHtml(f.shop)}</div>
            <div class="qs-more"><p>Need something not shown?</p><div class="qs-rows" data-qs-rows>${rows.map(rowHtml).join('')}</div>
            <button type="button" class="qs-addrow" data-qs-addrow>${ICON.plus}Add an item</button></div>`);
        }
        case 'zip': {
          return wrap(`<div class="qs-zip"><input class="qs-input qs-zip__in" id="${id}" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="5" placeholder="e.g. 07080" value="${esc(state.job.zip || '')}" data-qs-zip aria-describedby="${id}-out"><div class="qs-zip__out" id="${id}-out" data-qs-zipout aria-live="polite">${zipOut(f)}</div></div>
            <div class="qs-zip__man" data-qs-zipman${state.job.zipManual ? '' : ' hidden'}><input class="qs-input" type="text" placeholder="Town, state (e.g. West New York, NJ)" value="${esc(state.job.zipManual ? [state.job.town, state.job.state].filter(Boolean).join(', ') : '')}" data-qs-zipcity aria-label="Town and state"></div>`, id);
        }
        case 'days': {
          const n = dayCount(state.job.deliverDate, state.job.pickupDate);
          return `<div class="qs-f qs-in" style="--i:${i}" data-qs-days>${n ? daysPill(n) : ''}</div>`;
        }
      }
      return '';
    }
    const zipCache = {};
    const zipLookup = (z) => (zipCache[z.slice(0, 3)] ||= fetch(`/zip/${z.slice(0, 3)}.json`).then((r) => (r.ok ? r.json() : {})).catch(() => ({}))).then((d) => d[z] || null);
    const PIN = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/></svg>';
    function zipOut(f) {
      const j = state.job, z = j.zip || '';
      if (j.zipManual) return `<span class="qs-zip__hint">Using the town you typed.</span>`;
      if (z.length < 5) return `<span class="qs-zip__hint">City and state fill in automatically.</span>`;
      if (j.zipLook === 'busy') return `<span class="qs-zip__hint is-busy">Looking up ${esc(z)}\u2026</span>`;
      if (j.zipLook === 'miss' || !j.town) return `<span class="qs-zip__miss">We couldn\u2019t find that ZIP. <button type="button" data-qs-zipedit>Type the town instead</button></span>`;
      const out = f && f.area && j.state && !f.area.includes(j.state) ? `<p class="qs-zip__area">${esc(f.areaMsg)}</p>` : '';
      return `<span class="qs-zip__hit">${PIN}<span><b>${esc(j.town)}</b>, ${esc(j.state)}</span><button type="button" data-qs-zipedit>Change</button></span>${out}`;
    }
    const zipText = () => { const j = state.job; return [j.zip, [j.town, j.state].filter(Boolean).join(', ')].filter(Boolean).join(' \u00b7 '); };
    const daysPill = (n) => `<span class="qs-pill">${ICON.cal}${n} day${n > 1 ? 's' : ''} on rent${n >= 28 ? ', monthly rates apply' : n >= 7 ? ', weekly rates apply' : ''}</span>`;
    let curShop = null;
    const lines = (fn) => Object.values(state.job.sel).filter((e) => e.q > 0 && fn(e));
    const addBtn = (lbl = 'Add', attr = 'data-qs-pick') => `<button type="button" class="qs-ci__add" ${attr}>${ICON.plus}${lbl}</button>`;
    const stepper = (t, q) => `<div class="qs-step-ctl${q ? '' : ' is-zero'}"><button type="button" data-qs-dec aria-label="Fewer ${esc(t)}"${q ? '' : ' disabled'}>&minus;</button><input type="number" min="0" inputmode="numeric" value="${q}" data-qs-qty aria-label="${esc(t)} quantity" onfocus="this.select()"><button type="button" data-qs-inc aria-label="More ${esc(t)}">+</button></div>`;
    function shopHtml(cfg) {
      if (!CAT) return `<div class="qs-cat">${'<div class="qs-ci is-skel"></div>'.repeat(8)}</div>`;
      let h = '';
      if (cfg.equip) {
        const hs = [...new Set([...(CAT.cats['equipment-rentals']?.p || []), ...(CAT.cats['truck-rentals']?.p || [])])].filter((x) => CAT.prods[x]);
        h += `<p class="qs-sub">Equipment and fleet</p><div class="qs-cat">${hs.map(eqTile).join('')}</div><p class="qs-sub">Supplies</p>`;
      }
      return h + `<div class="qs-cat">${cfg.cats.filter((c) => CAT.cats[c]?.p.length).map(catTileHtml).join('')}</div>`;
    }
    function eqTile(hd, k) {
      const p = CAT.prods[hd], multi = p.v.length > 1;
      const n = multi ? lines((e) => e.h === hd).length : state.job.sel[hd + '::']?.q || 0;
      return `<div class="qs-ci${n ? ' is-on' : ''}" style="--tint:${EQ_TINTS[k % EQ_TINTS.length]}" data-qs-eq="${esc(hd)}">
        <span class="qs-ci__badge" aria-hidden="true">${n || ''}</span>
        <button type="button" class="qs-ci__pick" data-qs-pick aria-label="Add ${esc(p.t)}">${CUT[hd] ? `<img src="${CUT[hd]}" alt="" loading="lazy">` : p.i ? `<img class="is-blend" src="${p.i}" alt="" loading="lazy">` : ''}<b>${esc(short(p.t))}</b></button>
        <div class="qs-ci__ctl">${multi ? addBtn(n ? 'Edit' : 'Choose') : stepper(p.t, n)}</div></div>`;
    }
    function catTileHtml(c) {
      const m = CATS[c], cnt = CAT.cats[c].p.length, n = lines((e) => e.c === c).length;
      return `<div class="qs-ci qs-ci--cat${n ? ' is-on' : ''}" style="--tint:${m.tint}" data-qs-cat="${c}">
        <span class="qs-ci__badge" aria-hidden="true">${n || ''}</span>
        <button type="button" class="qs-ci__pick" data-qs-open aria-label="Browse ${esc(m.t)}"><img src="${m.img}" alt="" loading="lazy"><b>${esc(m.t)}</b></button>
        <div class="qs-ci__ctl"><button type="button" class="qs-ci__add${n ? ' is-sel' : ''}" data-qs-open>${n ? `${n} selected &middot; Edit` : `Browse ${cnt}`}${ICON.arrow}</button></div></div>`;
    }
    function setSel(key, base, q) {
      q = Math.max(0, Math.min(99999, Math.round(+q || 0)));
      if (q) state.job.sel[key] = { ...base, q }; else delete state.job.sel[key];
      save(); clearErr('cat'); renderTicket();
    }
    const rowHtml = (r) => `<div class="qs-row"><input class="qs-input" type="text" placeholder="Item, e.g. 36-inch cones with collars" value="${esc(r.desc || '')}" data-qs-rdesc aria-label="Item"><input class="qs-input" type="number" min="1" placeholder="Qty" value="${esc(r.qty || '')}" data-qs-rqty aria-label="Quantity"><button type="button" data-qs-rrm aria-label="Remove item">${ICON.x}</button></div>`;

    /* ---------------- items ---------------- */
    const rmBtn = (x) => `<button type="button" class="qs-rm" data-qs-rm-item="${esc(x.key)}" aria-label="Remove ${esc(x.desc)}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg></button>`;
    function removeItem(key) {
      if (key.startsWith('row:')) (state.job.items || []).splice(+key.slice(4), 1);
      else delete state.job.sel[key];
      save(); renderTicket();
      if (body.querySelector('[data-qs-shop]')) refreshShop();
      const rows = body.querySelector('[data-qs-rows]');
      if (rows) rows.innerHTML = (state.job.items || []).map(rowHtml).join('');
      if (state.step === 4 && body.querySelector('.qs-rv')) { lastStep = 4; render(); }
      if (!sheet.hidden) fillSheet();
    }
    root.addEventListener('click', (e) => { const b = e.target.closest('[data-qs-rm-item]'); if (b) { e.preventDefault(); removeItem(b.dataset.qsRmItem); } });
    function allItems() {
      const cat = Object.entries(state.job.sel || {}).filter(([, e]) => e.q > 0).map(([k, e]) => ({ desc: e.t + (e.v ? ` (${e.v})` : ''), qty: e.q, img: e.i, key: k }));
      const extra = (state.job.items || []).map((r, i) => ({ desc: (r.desc || '').trim(), qty: +r.qty || 1, key: 'row:' + i })).filter((r) => r.desc);
      return [...cat, ...extra];
    }

    /* ---------------- stepper + ticket ---------------- */
    function renderSteps() {
      stepsEl.innerHTML = stepNames().map((n, i) => {
        const st = i < state.step ? 'is-done' : i === state.step ? 'is-cur' : '';
        return `<li class="${st}"><span class="qs-bar"><i></i></span><button type="button" data-qs-goto="${i}"${i < state.step ? '' : ' disabled'}${i === state.step ? ' aria-current="step"' : ''}><span class="qs-n">${i < state.step ? ICON.check : i + 1}</span><span class="qs-t">${esc(n)}</span></button></li>`;
      }).join('');
      stepsEl.querySelectorAll('[data-qs-goto]').forEach((b) => b.addEventListener('click', () => go(+b.dataset.qsGoto)));
    }
    function ticketLines() {
      const j = state.job, a = state.about, L = [];
      const svc = SVC.find((s) => s.id === state.type);
      if (state.step > 0 || state.touched) L.push(['svc', 'Service', esc(svc.b)]);
      if (state.type === 'lane-closure') {
        if (j.roadType) L.push(['road', 'Road', esc(j.roadType + (j.speed ? `, ${j.speed} mph` : ''))]);
        if (j.lanes?.length) L.push(['lanes', 'Closing', esc(j.lanes.join(', '))]);
        if (j.crew) L.push(['crew', 'Crew', esc(j.crew)]);
        if (j.equipment?.length) L.push(['eq', 'Equipment', esc(j.equipment.join(', '))]);
      }
      if (state.type === 'rental' || state.type === 'products') {
        const it = allItems();
        if (it.length) L.push(['items:' + it.map((x) => x.desc + x.qty).join('|'), `${it.length} item${it.length > 1 ? 's' : ''}`, `<span class="qs-tk__thumbs">${it.map((x) => `<span>${x.img ? `<img src="${x.img}" alt="">` : ''}${x.qty} &times; ${esc(x.desc)}${rmBtn(x)}</span>`).join('')}</span>`]);
        if (j.setup) L.push(['setup', 'Setup', esc(j.setup)]);
        if (j.custom === 'Yes') L.push(['custom', 'Custom', 'Colors, stenciling or logo']);
      }
      if (state.type === 'general' && j.what) L.push(['what', 'The job', esc(j.what.length > 90 ? j.what.slice(0, 90) + '…' : j.what)]);
      const cityLine = j.town ? `${j.town}${j.state ? ', ' + j.state : ''}${j.zip && !j.zipManual ? ' ' + j.zip : ''}` : '';
      const place = [j.location || j.address, cityLine, !j.town && j.shipTo, j.where].filter(Boolean).join(', ');
      if (place) L.push(['place', state.type === 'products' ? 'Ships to' : 'Where', esc(place)]);
      const d1 = j.startDate || j.deliverDate || j.needBy, d2 = j.endDate || j.pickupDate;
      if (d1) L.push(['dates', state.type === 'products' ? 'Needed by' : 'Dates', esc(fmtDate(d1) + (d2 ? ` → ${fmtDate(d2)}` : '')) + (j.shift ? ` &middot; ${esc(j.shift)}` : '')]);
      else if (j.when) L.push(['when', 'When', esc(j.when)]);
