---
// "Recently viewed" strip, rendered client-side from localStorage.
// Shows only when 2+ items exist (excluding the current product).
const { exclude = '' } = Astro.props;
---
<section class="rv wrap" data-rv data-exclude={exclude} hidden aria-labelledby="rv-h">
  <div class="rv__head">
    <h2 id="rv-h">Recently viewed</h2>
  </div>
  <div class="rv__row" data-rv-row></div>
</section>
<script>
  document.querySelectorAll('[data-rv]').forEach((root) => {
    let list = [];
    try { list = JSON.parse(localStorage.getItem('tss_recent') || '[]'); } catch {}
    const ex = root.dataset.exclude;
    list = list.filter((it) => it && it.h && it.h !== ex);
    if (list.length < 2) return;
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    const fmt = (n) => Number(n).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
    root.querySelector('[data-rv-row]').innerHTML = list.slice(0, 8).map((it) => `
      <a class="rv__card" href="/products/${esc(it.h)}">
        <span class="rv__img">${it.i ? `<img src="${esc(it.i)}" alt="" loading="lazy">` : ''}</span>
        <span class="rv__t">${esc(it.t)}</span>
        <span class="rv__p">${it.r ? 'Rental' : it.p != null ? fmt(it.p) : ''}</span>
      </a>`).join('');
    root.hidden = false;
  });
</script>
<style is:global>
  .rv { margin-top: clamp(8px, 2vw, 24px); margin-bottom: clamp(48px, 6vw, 80px); }
  .rv__head { display: flex; justify-content: space-between; align-items: end; margin-bottom: 16px; }
  .rv__head h2 { font-size: var(--fs-3); }
  .rv__row { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(150px, 180px); gap: 12px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: thin; }
  .rv__card { display: grid; gap: 4px; text-decoration: none; background: #fff; border: 1px solid var(--line); border-radius: var(--r-m); padding: 12px 12px 14px; transition: border-color .15s, box-shadow .15s; }
  .rv__card:hover { border-color: var(--line-dark); box-shadow: var(--shadow-m); }
  .rv__img { aspect-ratio: 1; display: grid; place-items: center; }
  .rv__img img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .rv__t { font-variation-settings: 'wght' 620; font-size: .88rem; line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; min-height: 2.6em; }
  .rv__card:hover .rv__t { color: var(--red); }
  .rv__p { color: var(--steel); font-size: .85rem; }
</style>
