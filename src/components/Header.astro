---
import { loadCatalog, PRODUCT_COLLECTIONS, img } from '../lib/shopify.js';
const { colByHandle } = await loadCatalog();
const megaCats = PRODUCT_COLLECTIONS.map((h) => colByHandle.get(h)).filter(Boolean);
const nav = [
  { href: '/collections', label: 'Products', mega: true },
  { href: '/collections/equipment-rentals', label: 'Rentals' },
  { href: '/pages/lane-closure', label: 'Lane closures' },
  { href: '/watercade/', label: 'WATERCADE' },
  { href: '/tools', label: 'Planning tools' },
  { href: '/pages/custom-stenciling', label: 'Custom shop' },
  { href: '/pages/contact', label: 'Contact' }
];
const path = Astro.url.pathname.replace(/\.html$/, '');
const current = (href) => (href === '/collections' ? path === '/collections' || (path.startsWith('/collections/') && !path.includes('rentals')) || path.startsWith('/products/') : path.startsWith(href));
---
<header class="hdr">
  <div class="hdr__main">
    <div class="hdr__in wrap">
      <button class="icon-btn menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="mnav">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <a href="/" class="logo" aria-label="Traffic Safety Service home">
        <img class="logo__img" src="/brand/tss-logo-420.png" alt="TSS, Traffic Safety Service" width="420" height="210" />
      </a>
      <div class="search" data-search>
        <span class="search__coney" aria-hidden="true">
          <svg viewBox="0 0 100 116"><rect x="9" y="97" width="82" height="13" rx="4" fill="#1a1d21"/><path d="M44 9 Q50 3 56 9 L84 98 L16 98 Z" fill="#f26a1b"/><path d="M39.7 21 L60.3 21 L63 30 L37 30 Z" fill="#f4f6f8"/><path d="M22.7 80 L77.3 80 L80.3 90 L19.7 90 Z" fill="#f4f6f8"/><circle cx="40" cy="51" r="7" fill="#fff"/><circle cx="41" cy="52" r="3.8" fill="#1f2933"/><circle cx="60" cy="51" r="7" fill="#fff"/><circle cx="61" cy="52" r="3.8" fill="#1f2933"/><path d="M40.5 62 Q50 75 59.5 62 Z" fill="#5b1d06"/></svg>
        </span>
        <input type="search" placeholder="Ask Conner anything — products, prices, quotes…" aria-label="Ask Conner or search products" autocomplete="off" spellcheck="false" data-search-input role="combobox" aria-expanded="false" aria-controls="search-results" />
        <span class="search__ai" aria-hidden="true">AI</span>
        <button type="button" class="search__btn" data-ask-send aria-label="Ask Conner">
          <svg viewBox="0 0 24 24"><path d="M5 12h13 M12.5 5.5L19 12l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div class="search__panel" id="search-results" role="listbox" hidden data-search-panel></div>
      </div>
      <div class="hdr__act">
        <a class="hdr__phone" href="tel:+19085614800" aria-label="Call 908-561-4800">
          <span class="hdr__phonebadge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.6 1.6a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 3 6.2 2 2 0 0 1 5 4z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg></span>
          <span class="hdr__phonetxt"><small>Call us 24/7</small><b>908-561-4800</b></span>
        </a>
        <span class="hdr__sep" aria-hidden="true"></span>
        <button class="icon-btn" data-open-drawer="quote" aria-label="Quote list">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7z M14 3v5h5 M10 13h6 M10 17h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          <span class="badge" data-quote-count hidden>0</span>
        </button>
        <button class="icon-btn" data-open-drawer="cart" aria-label="Cart">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h3l2.4 11h10.2L21 7H7.2 M10 20a1 1 0 1 0 0-.01 M18 20a1 1 0 1 0 0-.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg>
          <span class="badge" data-cart-count hidden>0</span>
        </button>
        <a href="/pages/request-a-quote" class="btn hdr__cta">Request a quote</a>
      </div>
    </div>
    <div class="msearch" data-msearch>
      <div class="wrap"><div class="search search--mobile" data-search>
        <span class="search__coney" aria-hidden="true">
          <svg viewBox="0 0 100 116"><rect x="9" y="97" width="82" height="13" rx="4" fill="#1a1d21"/><path d="M44 9 Q50 3 56 9 L84 98 L16 98 Z" fill="#f26a1b"/><path d="M39.7 21 L60.3 21 L63 30 L37 30 Z" fill="#f4f6f8"/><path d="M22.7 80 L77.3 80 L80.3 90 L19.7 90 Z" fill="#f4f6f8"/><circle cx="40" cy="51" r="7" fill="#fff"/><circle cx="41" cy="52" r="3.8" fill="#1f2933"/><circle cx="60" cy="51" r="7" fill="#fff"/><circle cx="61" cy="52" r="3.8" fill="#1f2933"/><path d="M40.5 62 Q50 75 59.5 62 Z" fill="#5b1d06"/></svg>
        </span>
        <input type="search" placeholder="Ask Conner or search products…" aria-label="Ask Conner or search products" autocomplete="off" spellcheck="false" data-search-input role="combobox" aria-expanded="false" aria-controls="msearch-results" />
        <button type="button" class="search__btn" data-ask-send aria-label="Ask Conner">
          <svg viewBox="0 0 24 24"><path d="M5 12h13 M12.5 5.5L19 12l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div class="search__panel" id="msearch-results" role="listbox" hidden data-search-panel></div>
      </div></div>
    </div>
  </div>
  <div class="hdr__nav">
    <div class="wrap hdr__navin">
      <nav class="nav" aria-label="Main">
        {nav.map((n) => n.mega ? (
          <div class="nav__item nav__item--mega">
            <a href={n.href} aria-current={current(n.href) ? 'page' : undefined} aria-haspopup="true" aria-expanded="false">
              <span>{n.label}</span>
              <svg class="nav__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
        <div class="mega" role="region" aria-label="Product categories">
          <div class="wrap mega__in">
            <div class="mega__cats">
              {megaCats.map((c) => (
                <a href={`/collections/${c.handle}`} class="mega__cat">
                  <span class="mega__thumb">{c.cover && <img src={img(c.cover.url, 120)} alt="" loading="lazy" width="56" height="56" />}</span>
                  <span class="mega__txt"><b>{c.title}</b><small>{c.products.length} {c.products.length === 1 ? 'product' : 'products'}</small></span>
                </a>
              ))}
            </div>
            <div class="mega__side">
              <a href="/collections" class="mega__all">Browse all products
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <a href="/pages/custom-stenciling" class="mega__promo">
                <b>Custom branding</b>
                <span>Your colors, logo and stenciling on cones, drums and barriers.</span>
              </a>
              <a href="/tools/rent-vs-buy" class="mega__promo">
                <b>Rent or buy?</b>
                <span>Run your real numbers in the calculator.</span>
              </a>
            </div>
          </div>
        </div>
          </div>
        ) : (
          <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}><span>{n.label}</span></a>
        ))}
      </nav>
      <p class="hdr__tag">Ships nationwide · Rentals &amp; crews in NJ, NY, PA, CT</p>
    </div>
  </div>
  <nav id="mnav" class="mnav" aria-label="Mobile" hidden>
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <a href="/pages/request-a-quote" class="mnav__cta">Request a quote</a>
    <a href="tel:+19085614800">Call 908-561-4800 (24/7)</a>
  </nav>
</header>
<script>
  const btn = document.querySelector('.menu-btn');
  const m = document.getElementById('mnav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (m) m.hidden = open;
  });
  const hdr = document.querySelector('.hdr');
  const onScroll = () => hdr.classList.toggle('is-stuck', window.scrollY > 56);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();

  /* mega menu: hover intent + click + keyboard */
  const mi = document.querySelector('.nav__item--mega');
  if (mi) {
    const link = mi.querySelector('a');
    let t;
    const mega = mi.querySelector('.mega');
    const set = (open) => {
      if (open && mega) mega.style.top = document.querySelector('.hdr').getBoundingClientRect().bottom + 'px';
      mi.classList.toggle('is-open', open);
      link.setAttribute('aria-expanded', String(open));
    };
    mi.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { clearTimeout(t); set(true); } });
    mi.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { t = setTimeout(() => set(false), 160); } });
    mi.addEventListener('focusin', () => set(true));
    mi.addEventListener('focusout', (e) => { if (!mi.contains(e.relatedTarget)) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    document.addEventListener('click', (e) => { if (!mi.contains(e.target)) set(false); });
  }

  /* instant search */
  let idx = null, loading = null;
  const loadIdx = () => (loading ||= fetch('/search-index.json').then((r) => r.json()).then((d) => (idx = d)).catch(() => (idx = { cats: [], prods: [] })));
  const fmt = (n) => Number(n).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  const score = (t, q) => {
    t = t.toLowerCase();
    if (t.startsWith(q)) return 3;
    if (t.includes(' ' + q)) return 2;
    if (t.includes(q)) return 1;
    const toks = q.split(/\s+/).filter(Boolean);
    return toks.length > 1 && toks.every((w) => t.includes(w)) ? 1 : 0;
  };
  const mark = (t, q) => {
    const i = t.toLowerCase().indexOf(q);
    return i < 0 ? esc(t) : esc(t.slice(0, i)) + '<mark>' + esc(t.slice(i, i + q.length)) + '</mark>' + esc(t.slice(i + q.length));
  };
  document.querySelectorAll('[data-search]').forEach((root) => {
    const input = root.querySelector('[data-search-input]');
    const panel = root.querySelector('[data-search-panel]');
    let active = -1;
    const close = () => { panel.hidden = true; input.setAttribute('aria-expanded', 'false'); active = -1; };
    const ask = () => {
      const q = input.value.trim();
      close();
      if (window.TSSChat) { q ? window.TSSChat.ask(q) : window.TSSChat.open(); input.value = ''; }
      else location.href = '/pages/request-a-quote';
    };
    const go = (row) => { row.hasAttribute('data-ask-row') ? ask() : location.href = row.getAttribute('href'); };
    const render = () => {
      const q = input.value.trim().toLowerCase();
      if (!q || !idx) { close(); return; }
      const cats = idx.cats.map((c) => [score(c.t, q), c]).filter(([s]) => s).sort((a, b) => b[0] - a[0]).slice(0, 3);
      const prods = idx.prods.map((p) => [score(p.t, q), p]).filter(([s]) => s).sort((a, b) => b[0] - a[0]).slice(0, 6);
      let html = `<button type="button" class="search__row search__row--ask" data-ask-row role="option"><span class="search__askthumb"><svg viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z M18.5 15.5l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9z" fill="currentColor"/></svg></span><span>Ask Conner: “${esc(input.value.trim())}”</span><small>AI assistant</small></button>`;
      if (cats.length) html += '<p class="search__h">Categories</p>' + cats.map(([, c]) => `<a role="option" class="search__row search__row--cat" href="/collections/${c.h}"><span class="search__cathumb"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span><span>${mark(c.t, q)}</span><small>${c.n}</small></a>`).join('');
      if (prods.length) html += '<p class="search__h">Products</p>' + prods.map(([, p]) => `<a role="option" class="search__row" href="/products/${p.h}">${p.i ? `<img src="${p.i}" alt="" loading="lazy">` : '<span class="search__cathumb"></span>'}<span>${mark(p.t, q)}</span><small>${p.r ? 'Rental' : p.pr != null ? fmt(p.pr) : ''}</small></a>`).join('');
      if (!cats.length && !prods.length) html += '<div class="search__none">No product matches — Conner can still help, or <a href="/pages/request-a-quote">ask us for a quote</a> / call 908-561-4800.</div>';
      panel.innerHTML = html;
      panel.hidden = false; input.setAttribute('aria-expanded', 'true'); active = -1;
    };
    input.addEventListener('focus', () => { loadIdx().then(() => input.value.trim() && render()); });
    input.addEventListener('input', () => { loadIdx().then(render); });
    input.addEventListener('keydown', (e) => {
      const rows = [...panel.querySelectorAll('.search__row')];
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!rows.length) return;
        active = (active + (e.key === 'ArrowDown' ? 1 : -1) + rows.length) % rows.length;
        rows.forEach((r, i) => r.classList.toggle('is-active', i === active));
        rows[active].scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (!panel.hidden && active >= 0 && rows[active]) go(rows[active]);
        else ask();
      } else if (e.key === 'Escape') close();
    });
    panel.addEventListener('click', (e) => { const r = e.target.closest('[data-ask-row]'); if (r) ask(); });
    root.querySelector('[data-ask-send]')?.addEventListener('click', ask);
    document.addEventListener('click', (e) => { if (!root.contains(e.target)) close(); });
  });
</script>
<style>
  .hdr { position: sticky; top: 0; z-index: 40; background: #fff; }
  .hdr__main { position: relative; z-index: 2; background: rgba(255, 255, 255, .96); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); transition: box-shadow .25s ease; }
  .hdr.is-stuck .hdr__main { box-shadow: 0 12px 32px -20px rgba(20, 23, 26, .35); }
  .hdr__in { height: 92px; display: flex; align-items: center; gap: clamp(12px, 1.4vw, 24px); transition: height .25s ease; }
  .hdr.is-stuck .hdr__in { height: 72px; }
  .logo { flex: none; display: flex; }
  .logo__img { height: 80px; width: auto; transition: height .25s ease; }
  .hdr.is-stuck .logo__img { height: 60px; }

  /* ---------- mega panel ---------- */
  .mega { position: fixed; left: 0; right: 0; top: var(--megatop, 92px); background: #fff; border-bottom: 1px solid var(--line); box-shadow: 0 32px 60px -28px rgba(20, 23, 26, .35); opacity: 0; translate: 0 -8px; visibility: hidden; transition: opacity .22s ease, translate .22s ease, visibility .22s; z-index: 30; }
  .nav__item--mega.is-open .mega { opacity: 1; translate: 0 0; visibility: visible; }
  .mega__in { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 36px; padding-block: 28px 30px; }
  .mega__cats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px 16px; align-content: start; }
  .mega__cat { display: flex; align-items: center; gap: 12px; min-width: 0; text-decoration: none; padding: 9px 10px; border-radius: 10px; transition: background .12s; }
  .mega__cat:hover { background: var(--haze); }
  .mega__thumb { width: 52px; height: 52px; border-radius: 9px; border: 1px solid var(--haze-2); background: #fff; display: grid; place-items: center; overflow: hidden; flex: none; }
  .mega__thumb img { width: 42px; height: 42px; object-fit: contain; }
  .mega__txt { display: grid; line-height: 1.25; min-width: 0; }
  .mega__txt b { font-variation-settings: 'wght' 650; font-size: .97rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mega__cat:hover .mega__txt b { color: var(--red); }
  .mega__txt small { color: var(--steel); font-size: .82rem; }
  .mega__side { display: grid; gap: 10px; align-content: start; border-left: 1px solid var(--line); padding-left: 36px; }
  .mega__all { display: flex; align-items: center; gap: 7px; text-decoration: none; font-variation-settings: 'wght' 700; color: var(--red); padding: 4px 0 8px; }
  .mega__all svg { width: 15px; height: 15px; transition: translate .15s; }
  .mega__all:hover svg { translate: 3px 0; }
  .mega__promo { display: grid; gap: 3px; text-decoration: none; background: var(--haze); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; transition: border-color .15s; }
  .mega__promo:hover { border-color: var(--line-dark); }
  .mega__promo b { font-variation-settings: 'wght' 670; }
  .mega__promo span { color: var(--steel); font-size: .88rem; line-height: 1.4; }

  /* ---------- search bar (always visible, commerce-style) ---------- */
  .search { position: relative; flex: 1; min-width: 0; max-width: 720px; height: 50px; }
  .search input {
    width: 100%; height: 100%; padding: 12px 84px 11px 52px;
    border: 1.5px solid var(--line-dark); border-radius: 999px; background: var(--haze);
    font-size: .98rem; color: var(--ink);
    transition: background .15s, border-color .15s, box-shadow .15s;
  }
  .search input::placeholder { color: var(--steel); }
  .search input:hover { background: var(--haze-2); }
  .search input:focus { outline: none; background: #fff; border-color: var(--ink); box-shadow: var(--shadow-m); }
  .search input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .search__coney { position: absolute; left: 16px; top: 50%; translate: 0 -50%; width: 25px; height: 29px; pointer-events: none; }
  .search__coney svg { width: 100%; height: 100%; display: block; }
  .search__ai { position: absolute; right: 52px; top: 50%; translate: 0 -50%; padding: 3px 7px 2px; border-radius: 6px; background: var(--gold); color: #3a2c00; font-size: .68rem; letter-spacing: .06em; font-variation-settings: 'wght' 800; pointer-events: none; }
  .search__btn { position: absolute; right: 5px; top: 5px; bottom: 5px; aspect-ratio: 1; display: grid; place-items: center; border: 0; border-radius: 50%; background: var(--red); color: #fff; cursor: pointer; transition: background .15s, scale .15s; }
  .search__btn:hover { background: var(--red-press); scale: 1.06; }
  .search__btn svg { width: 18px; height: 18px; }
  .search__panel { position: absolute; top: calc(100% + 10px); left: 0; right: 0; max-height: min(66vh, 540px); overflow: auto; background: #fff; border: 1px solid var(--line); border-radius: var(--r-m); box-shadow: var(--shadow-l); padding: 8px; z-index: 59; }
  .msearch { display: none; border-top: 1px solid var(--line); padding-block: 10px; }
  .msearch .search { max-width: none; height: 46px; }

  /* ---------- right actions ---------- */
  .hdr__act { display: flex; align-items: center; gap: 5px; flex: none; }
  .hdr__phone { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .hdr__phonebadge { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--red-tint); color: var(--red); flex: none; transition: background .15s, color .15s; }
  .hdr__phonebadge svg { width: 19px; height: 19px; }
  .hdr__phone:hover .hdr__phonebadge { background: var(--red); color: #fff; }
  .hdr__phonetxt { display: grid; line-height: 1.2; }
  .hdr__phonetxt small { color: var(--steel); font-size: .78rem; }
  .hdr__phonetxt b { font-variation-settings: 'wght' 700; font-size: .98rem; white-space: nowrap; }
  .hdr__sep { width: 1px; height: 30px; background: var(--line); margin: 0 7px; }
  .icon-btn { position: relative; width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 0; border-radius: 10px; cursor: pointer; color: var(--ink); }
  .icon-btn:hover { background: var(--haze); }
  .icon-btn svg { width: 23px; height: 23px; }
  .badge[hidden] { display: none; }
  .badge { position: absolute; top: 2px; right: 1px; min-width: 18px; height: 18px; padding: 2px 5px 0; border-radius: 9px; background: var(--red); color: #fff; font-size: .7rem; font-variation-settings: 'wght' 700; display: grid; place-items: center; box-shadow: 0 0 0 2px #fff; }
  .hdr__cta { margin-left: 9px; min-height: 48px; padding: 13px 24px 12px; font-size: 1rem; white-space: nowrap; }
  .menu-btn { display: none; }

  /* ---------- nav row (second row) ---------- */
  .hdr__nav { position: relative; z-index: 1; background: #fff; border-top: 1px solid var(--haze-2); border-bottom: 1px solid var(--line); transition: translate .28s ease, opacity .22s ease; }
  .hdr.is-stuck .hdr__nav { position: absolute; left: 0; right: 0; translate: 0 -105%; opacity: 0; pointer-events: none; }
  .hdr__navin { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .nav { display: flex; gap: clamp(2px, .6vw, 14px); margin-left: -12px; }
  .nav__item { display: flex; }
  .nav > a, .nav__item > a { position: relative; display: flex; align-items: center; gap: 5px; text-decoration: none; font-variation-settings: 'wght' 620; font-size: .99rem; padding: 13px 12px 12px; color: var(--ink-2); white-space: nowrap; transition: color .14s; }
  .nav > a > span, .nav__item > a > span { position: relative; }
  .nav > a > span::after, .nav__item > a > span::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -13px; height: 2.5px; background: var(--red); transition: right .22s cubic-bezier(.4, 0, .2, 1); }
  .nav > a:hover, .nav__item > a:hover { color: var(--ink); }
  .nav > a:hover > span::after, .nav__item > a:hover > span::after { right: 0; }
  .nav > a[aria-current], .nav__item > a[aria-current] { color: var(--ink); font-variation-settings: 'wght' 700; }
  .nav > a[aria-current] > span::after, .nav__item > a[aria-current] > span::after { right: 0; }
