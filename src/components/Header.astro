---
const nav = [
  { href: '/collections', label: 'Shop' },
  { href: '/collections/equipment-rentals', label: 'Rentals' },
  { href: '/pages/lane-closure', label: 'Lane closures' },
  { href: '/pages/water-filled-barrier', label: 'WATERCADE' },
  { href: '/tools', label: 'Planning tools' }
];
const path = Astro.url.pathname;
---
<header class="hdr">
  <div class="hdr__in wrap">
    <a href="/" class="logo" aria-label="Traffic Safety Service home">
      <img class="logo__img" src="https://cdn.shopify.com/s/files/1/0587/7701/0241/files/TSS_LOGO_2000_x_250_px_2.svg" alt="Traffic Safety Service" width="2000" height="250" />
    </a>
    <nav class="nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="hdr__act">
      <a class="hdr__phone" href="tel:+19085614800"><span class="sr-only">Call </span>908-561-4800</a>
      <button class="icon-btn" data-open-drawer="quote" aria-label="Quote list">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7z M14 3v5h5 M10 13h6 M10 17h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        <span class="badge" data-quote-count hidden>0</span>
      </button>
      <button class="icon-btn" data-open-drawer="cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h3l2.4 11h10.2L21 7H7.2 M10 20a1 1 0 1 0 0-.01 M18 20a1 1 0 1 0 0-.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>
        <span class="badge" data-cart-count hidden>0</span>
      </button>
      <a href="/pages/request-a-quote" class="btn btn--sm hdr__cta">Get a quote</a>
      <button class="icon-btn menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="mnav">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  <nav id="mnav" class="mnav" aria-label="Mobile" hidden>
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <a href="/pages/request-a-quote">Get a quote</a>
    <a href="tel:+19085614800">Call 908-561-4800</a>
  </nav>
</header>
<script>
  const btn = document.querySelector('.menu-btn');
  const m = document.getElementById('mnav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (m) m.hidden = open;
  });
</script>
<style>
  .hdr { position: sticky; top: 0; z-index: 40; background: var(--asphalt); color: var(--white-line); border-bottom: 3px solid var(--yellow); }
  .hdr__in { height: var(--header-h); display: flex; align-items: center; gap: 28px; }
  .logo { display: flex; align-items: center; text-decoration: none; flex: none; }
  .logo__img { width: clamp(150px, 18vw, 210px); height: auto; }
  .nav { display: flex; gap: 4px; margin-right: auto; }
  .nav a { text-decoration: none; font-weight: 700; padding: 8px 12px 6px; border-radius: 8px; color: #dfe2e6; }
  .nav a:hover { background: var(--asphalt-line); color: #fff; }
  .nav a[aria-current] { color: #fff; box-shadow: inset 0 -3px 0 var(--orange); border-radius: 0; }
  .hdr__act { display: flex; align-items: center; gap: 6px; }
  .hdr__phone { font-weight: 800; text-decoration: none; margin-right: 8px; white-space: nowrap; }
  .icon-btn { position: relative; width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 0; border-radius: 8px; cursor: pointer; color: inherit; }
  .icon-btn:hover { background: var(--asphalt-line); }
  .icon-btn svg { width: 24px; height: 24px; }
  .badge[hidden] { display: none; }
  .badge { position: absolute; top: 3px; right: 2px; min-width: 19px; height: 19px; padding: 2px 5px 0; border-radius: 10px; background: var(--orange); color: var(--ink); font-size: .72rem; font-weight: 900; display: grid; place-items: center; }
  .hdr__cta { margin-left: 6px; }
  .menu-btn { display: none; }
  .mnav[hidden] { display: none; }
  .mnav { background: var(--asphalt-deep); padding: 8px var(--gutter) 18px; display: grid; }
  .mnav a { padding: 14px 0 12px; text-decoration: none; font-weight: 800; font-size: 1.15rem; border-bottom: 1px solid var(--asphalt-line); }
  @media (max-width: 1100px) { .hdr__phone { display: none; } }
  @media (max-width: 960px) {
    .nav, .hdr__cta { display: none; }
    .menu-btn { display: grid; }
    .hdr__act { margin-left: auto; }
  }
  @media (min-width: 961px) { .mnav { display: none !important; } }
</style>
