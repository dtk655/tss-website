---
import TmaTruck from '../../components/TmaTruck.astro';
import Layout from '../../layouts/Layout.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuickView from '../../components/QuickView.astro';
import RecentlyViewed from '../../components/RecentlyViewed.astro';
import CustomBuilder from '../../components/CustomBuilder.astro';
import { parseDescription, deriveSpecs, deriveBadges, deriveIncluded, USES, accessoriesFor } from '../../lib/productInfo.js';
import { PHONE, PHONE_TEL, EMAIL } from '../../lib/config.js';
import { loadCatalog, money, img } from '../../lib/shopify.js';
import { CATEGORY_META } from '../../lib/categories.js';

export async function getStaticPaths() {
  const { products } = await loadCatalog();
  return products.map((p) => ({ params: { handle: p.handle }, props: { handle: p.handle } }));
}
const { handle } = Astro.props;
const { byHandle, colByHandle } = await loadCatalog();
const p = byHandle.get(handle);

// Optional 3D viewer and WATERCADE planner (built separately); load only if present.
const viewerMods = import.meta.glob('../../components/tools/viewer3d/Viewer3D.astro', { eager: true });
const Viewer3D = Object.values(viewerMods)[0]?.default;
const plannerMods = import.meta.glob('../../components/tools/watercade/WatercadePlanner.astro', { eager: true });
const WatercadePlanner = handle === 'waterbarriertss590rparent' ? Object.values(plannerMods)[0]?.default : null;
const inCol = (h) => p.collections.includes(h);
const model =
  handle.includes('waterbarriertss590r') ? 'watercade' :
  handle === 'arrow-board' ? 'arrowboard' :
  inCol('cones') && /cone(18|28|36)/.test(handle) ? 'cone' :
  inCol('traffic-drums') && handle.startsWith('traffic-drum') ? 'drum' :
  handle.startsWith('type-iii') ? 'barricade' : null;

// Custom builders only where the Custom Shop has one: 18", 28" and 36" cones, A-frame rails and WATERCADE.
// Signs get a builder later (no sign product code yet).
const coneM = handle.match(/^cone(18|28|36)/);
const builder = coneM ? { kind: 'cone', size: `${coneM[1]}"`, noun: 'Cones', lede: 'Stencil your company, department or initials on every cone so your gear comes home. Build it live, then our team confirms the details and pricing before anything is made.' }
  : handle.startsWith('a-frame-plastic-rail') ? { kind: 'aframe', noun: 'Rails', lede: 'Print your name, department or message on the rails, from POLICE LINE to your company name. Build it live, then our team confirms the details and pricing before anything is made.' } : null;
const isWatercade = handle === 'waterbarriertss590rparent';
const customizable = !!builder || isWatercade;

const SWATCH = { orange: '#f26a1b', lime: '#c6e33b', 'dark green': '#1f5d3a', green: '#2e8b3d', 'navy blue': '#1f2f5c', navy: '#1f2f5c', blue: '#1f5fbf', 'sky blue': '#6cc4ee', pink: '#ff6fae', red: '#c8102e', white: '#f7f7f2', yellow: '#f6d10b', black: '#1d2024', silver: '#c0c4c8', gray: '#8a9097', grey: '#8a9097' };
const options = p.options.filter((o) => !(o.name === 'Title' && o.values[0] === 'Default Title'));
const isColor = (name) => /colou?r/i.test(name);
const variants = p.variants.map((v) => ({ id: v.id, title: v.title, price: +v.price.amount, compare: v.compareAtPrice ? +v.compareAtPrice.amount : null, available: v.availableForSale, opts: Object.fromEntries(v.selectedOptions.map((o) => [o.name, o.value])), image: v.image?.url || null }));
const first = variants.find((v) => v.available) || variants[0];
const viewerColors = model === 'cone' ? (options.find((o) => isColor(o.name))?.values || ['Orange']) : model === 'watercade' ? ['Orange', 'White'] : undefined;

// Related: same primary collection
const primary = ['cones', 'water-filled-barriers', 'barricades', 'traffic-drums', 'sign-shop', 'safety-gear', 'lights', 'reflectors', 'equipment-rentals', 'truck-rentals'].find(inCol);
const skipRel = new Set(accessoriesFor(handle, p.collections));
const related = primary ? colByHandle.get(primary)?.products.filter((x) => x.handle !== handle && !skipRel.has(x.handle)).slice(0, 4) || [] : [];
const crumbCol = primary ? colByHandle.get(primary) : null;
const desc = (p.seo?.description || p.description || '').slice(0, 155);
const firstImg = p.featuredImage?.url;
const sellable = p.isRental && p.collections.includes('equipment-rentals') && !p.collections.includes('truck-rentals');
// Theme bits: category tint, short intro line, at-a-glance specs drawn from real product data.
const meta = primary ? CATEGORY_META[primary] : null;
const tint = meta?.tint || '#ebebe8';
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const plain = (p.description || '').replace(/\s+/g, ' ').trim();
const intro = (() => {
  const src0 = (parseDescription(p.descriptionHtml || p.description).lead[0] || '');
  if (src0) { const c = src0.slice(0, 230); const e = Math.max(c.lastIndexOf('. '), c.lastIndexOf('! ')); return e > 60 ? c.slice(0, e + 1) : src0.length <= 230 ? src0 : c.replace(/\s+\S*$/, '') + '…'; }
  if (!plain) return '';
  const cut = plain.slice(0, 220);
  const end = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '));
  return end > 60 ? cut.slice(0, end + 1) : cut.length < plain.length ? cut.replace(/\s+\S*$/, '') + '…' : cut;
})();
const cap = (t) => t.charAt(0).toUpperCase() + t.slice(1);
const specs = [
  crumbCol && ['Category', crumbCol.title],
  ...options.map((o) => [cap(o.name), o.values.length > 6 ? `${o.values.length} options: ${o.values.slice(0, 5).join(', ')} and more` : o.values.join(', ')]),
  !p.isRental && ['Price', p.minPrice === p.maxPrice ? `${money(+p.minPrice)} each` : `${money(+p.minPrice)} to ${money(+p.maxPrice)} each`],
  p.isRental ? ['Rental area', 'NJ, NY, PA and CT'] : ['Shipping', 'Ships anywhere in the U.S.'],
  !p.isRental && ['Rent it', 'Available to rent in NJ, NY, PA and CT'],
  sellable && ['Buy it', 'Also available to buy new'],
  customizable && ['Customizing', builder?.kind === 'aframe' ? 'Your printed text, colors and logo' : builder ? 'Your stenciled name or logo' : 'Your colors, name and logo'],
  ['Ordering', p.isRental ? 'Daily, weekly, monthly or long-term' : 'Card, net terms or purchase order']
].filter(Boolean);
const perks0 = p.isRental ? [
  ['Delivered and picked up', 'Anywhere in NJ, NY, PA and CT', 'M2.5 7h11v9h-11z M13.5 10h4l3 3.5V16h-7z M6.5 19a1.7 1.7 0 1 0 0-.01 M16.5 19a1.7 1.7 0 1 0 0-.01'],
  ['Day, week or month', 'Rates that fit the job', 'M4 5h16v15H4z M4 9h16 M8 3v4M16 3v4'],
  ['Crews on call', 'We can set it up and run it', 'M12 3l7.5 3v5.5c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V6z M8.5 12l2.4 2.4 4.6-4.8']
] : [
  ['Ships nationwide', 'Fast from our NJ yard', 'M2.5 7h11v9h-11z M13.5 10h4l3 3.5V16h-7z M6.5 19a1.7 1.7 0 1 0 0-.01 M16.5 19a1.7 1.7 0 1 0 0-.01'],
  ['Net terms and POs', 'For agencies and contractors', 'M6 3h12v18l-3-2-3 2-3-2-3 2z M9 8h6M9 12h6M9 16h3'],
  ['Rent it too', 'In NJ, NY, PA and CT', 'M15 7a3 3 0 1 1-3 3 M12 10l-8 8 2 2 2-2 1 1 2-2-1-1 2-2']
];
const perks = (!p.isRental && /pick-?up only/i.test(p.descriptionHtml || p.description || '')) ? [['Customer Pick Up', '601 Hadley Road, South Plainfield, NJ', 'M12 21s-7-6.2-7-11.5a7 7 0 1 1 14 0C19 14.8 12 21 12 21z M12 7.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4z'], ...perks0.slice(1)] : perks0;
const inStock = !p.isRental && variants.some((v) => v.available);

// ---------- structured content from the product's own description ----------
const info = parseDescription(p.descriptionHtml || p.description);
const pickupOnly = info.pickupOnly && !p.isRental;
const parsedSpecs = deriveSpecs({ title: p.title, handle, text: info.text, options, specLines: info.specLines });
const badges = deriveBadges(`${p.title} ${info.text}`);
const included = deriveIncluded(info.text);
const uses = (info.uses.length ? info.uses : USES[primary] || []).slice(0, 6);
const accessories = accessoriesFor(handle, p.collections).map((h) => byHandle.get(h)).filter((x) => x && x.handle !== handle).slice(0, 4);
const keySpecs = parsedSpecs.filter(([, v]) => v.length <= 26).slice(0, 4);
// thin descriptions: a lone unlabeled line reads better as the lead, and the parsed specs stand in as features
const soloLine = !info.lead.length && info.features.length === 1 && !info.features[0].label ? info.features[0].text : '';
const leadText = soloLine ? [soloLine] : info.lead.slice(0, 2);
const factOnly = !info.lead.length && info.features.every((f0) => !f0.label) && parsedSpecs.length >= 2;
const features = (info.features.length && !soloLine && !factOnly ? info.features : parsedSpecs.map(([k, v]) => ({ label: k, text: v }))).slice(0, 8);
const kicker = info.kicker || (info.tagline[0] && info.tagline[0].length < 60 ? info.tagline[0] : '');
const chipsLine = info.tagline.filter((x) => x !== kicker).slice(0, 3);
const allSpecs = [
  ...parsedSpecs,
  ...specs.filter(([k]) => !parsedSpecs.some(([a]) => a.toLowerCase() === k.toLowerCase()))
].map(([k, v]) => (k === 'Shipping' && pickupOnly ? ['Fulfillment', 'Customer Pick Up at 601 Hadley Road, South Plainfield, NJ. Call for delivery.'] : [k, v]));
const wE = parsedSpecs.find(([k]) => k === 'Weight empty')?.[1], wF = parsedSpecs.find(([k]) => k === 'Weight filled')?.[1];
const faqs = [
  customizable && ['Can you add our company name or logo?', `Yes. ${builder ? 'Lay it out in the builder above' : 'Use the WATERCADE builder'} or send us your artwork. We confirm every detail and send a proof before anything is made.`],
  wE && wF && ['How heavy is it?', `${wE} empty and up to ${wF} once filled with water, so one person can place it and it stays put once it’s filled.`],
  !p.isRental && ['Do you offer bulk or agency pricing?', 'Yes. For larger quantities, municipalities, agencies and contractors, request a quote and our team will price the whole order.'],
  !p.isRental && (pickupOnly
    ? ['Can I get this delivered?', `Online orders for this item are Customer Pick Up at 601 Hadley Road, South Plainfield, NJ. For delivery, call ${PHONE} or request a quote and we’ll arrange it.`]
    : ['Where do you ship?', 'We ship anywhere in the U.S. You can also choose Customer Pick Up at 601 Hadley Road, South Plainfield, NJ.']),
  !p.isRental && ['Can I rent this instead of buying?', 'Yes. We rent what we sell, with delivery and pickup in NJ, NY, PA and CT.'],
  !p.isRental && ['How can I pay?', 'Pay by card at checkout, or open an account with us for net terms and purchase orders.'],
  p.isRental && ['Where do you deliver rentals?', 'We deliver, set up and pick up rentals anywhere in New Jersey, New York, Pennsylvania and Connecticut.'],
  p.isRental && ['How long can I rent it?', 'Daily, weekly, monthly or long-term. Tell us your dates and we’ll quote the best rate for the job.'],
  p.isRental && ['Can your crew set it up?', 'Yes. Our certified, experienced crews can deliver it, set it up and run it for you.'],
  sellable && ['Can I buy one instead?', 'Yes. It’s also available to buy new. Switch to Buy above and request a quote for pricing and lead time.']
].filter(Boolean);
const USE_IC = ['M12 3l9 16H3z M12 10v4 M12 17v.01', 'M3 10h18v9H3z M7 10V6h10v4', 'M5 21V5l7-2 7 2v16 M9 21v-5h6v5', 'M12 21s-7-6.2-7-11.5a7 7 0 1 1 14 0C19 14.8 12 21 12 21z M12 7.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4z', 'M4 17l5-5 4 4 7-8 M20 8v5 M20 8h-5', 'M12 3l7.5 3v5.5c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V6z'];
const SHIELD = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V6z M8.5 12l2.4 2.4 4.6-4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const nav = [['overview', 'Overview'], ['specs', 'Specs'], customizable && ['customize', 'Customize'], uses.length && ['uses', 'Uses'], accessories.length && ['pairs', 'Pairs With'], faqs.length && ['faq', 'FAQ']].filter(Boolean);
const relTitle = crumbCol ? crumbCol.title.toLowerCase() : 'products';
---
<Layout title={p.seo?.title || p.title} description={desc} image={firstImg}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Product', name: p.title, image: p.images.map((i) => i.url), description: p.description,
    brand: { '@type': 'Brand', name: 'Traffic Safety Service' },
    ...(p.isRental ? {} : { offers: { '@type': 'AggregateOffer', priceCurrency: 'USD', lowPrice: p.minPrice, highPrice: p.maxPrice, availability: 'https://schema.org/InStock' } })
  })} />

  <!-- ================= TOP: gallery + buy panel ================= -->
  <section class="px" style={`--tint:${tint}`}>
    <div class="px__bg" aria-hidden="true"></div>
    <div class="wrap">
      <nav class="px__crumbs" aria-label="Breadcrumb">
        <a href="/collections">Shop</a>
        {crumbCol && <><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg><a href={`/collections/${crumbCol.handle}`}>{crumbCol.title}</a></>}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg><span aria-current="page">{p.title}</span>
      </nav>

      <div class="px__grid">
        <div class="px__gal">
          <ProductGallery images={p.images} title={p.title} />
        </div>

        <div class="buy" data-product data-handle={p.handle} data-title={p.title} data-image={firstImg} data-minprice={p.isRental ? '' : p.minPrice} data-variants={JSON.stringify(variants)} data-rental={p.isRental ? '1' : ''}>
          <div class="buy__chips px__in" style="--d:0">
            {crumbCol && <a href={`/collections/${crumbCol.handle}`} class="chip chip--cat"><i></i>{crumbCol.title}</a>}
            {p.isRental ? <span class="chip chip--rent">Rental</span> : inStock ? <span class="chip chip--ok"><i></i>In stock</span> : <span class="chip">Made to order</span>}
            {pickupOnly && <span class="chip chip--pick">Customer Pick Up</span>}
            {customizable && <span class="chip">Customizable</span>}
          </div>

          {sellable && <div class="mode px__in" style="--d:1" role="tablist" aria-label="Rent or buy" data-mode-sw><i aria-hidden="true"></i><button type="button" role="tab" aria-selected="true" data-m="rent">Rent</button><button type="button" role="tab" aria-selected="false" data-m="buy">Buy</button></div>}

          <h1 class="buy__title"><span class="buy__ln"><span>{p.title}</span></span></h1>
          {badges.length > 0 && (
            <ul class="cert px__in" style="--d:1" aria-label="Standards">
              {badges.map((b) => <li title={b.d}><Fragment set:html={SHIELD} />{b.k}</li>)}
            </ul>
          )}

          {p.isRental ? (
            <p class="buy__price buy__price--q px__in" style="--d:2" data-mode-txt>Priced per job. Get a quote for daily, weekly or monthly rates.</p>
          ) : (
            <p class="buy__price px__in" style="--d:2"><strong data-price>{money(first.price)}</strong> <span class="buy__unit">each</span>{first.compare && first.compare > first.price && <s data-compare>{money(first.compare)}</s>}</p>
          )}
          {intro && <p class="buy__intro px__in" style="--d:3">{intro}</p>}
          {keySpecs.length > 1 && (
            <dl class="kspec px__in" style={`--d:3;--n:${keySpecs.length}`}>
              {keySpecs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            </dl>
          )}

          {options.map((o, oi) => (
            <fieldset class="opt px__in" style={`--d:${4 + oi}`} data-option={o.name}>
              <legend>{cap(o.name)} <span data-opt-val>{first.opts[o.name]}</span></legend>
              <div class={isColor(o.name) ? 'swatches' : 'pills'}>
                {o.values.map((val) => (
                  <label class={isColor(o.name) ? 'sw' : 'pill'} title={val}>
                    <input type="radio" name={`opt-${o.name}`} value={val} checked={first.opts[o.name] === val} />
                    {isColor(o.name) ? <span style={`--c:${SWATCH[val.toLowerCase()] || '#ccc'}`}><span class="sr-only">{val}</span></span> : <span>{val}</span>}
                  </label>
                ))}
              </div>
            </fieldset>
          ))}

          <div class="qty-row px__in" style={`--d:${4 + options.length}`}>
            <label class="qty">
              <span class="sr-only">Quantity</span>
              <button type="button" data-q="-1" aria-label="Decrease quantity">−</button>
              <input type="number" min="1" value="1" data-qty inputmode="numeric" />
              <button type="button" data-q="1" aria-label="Increase quantity">+</button>
            </label>
            {!p.isRental && <button class="buy__add" data-add-cart><span class="buy__addt">Add to cart</span><Fragment set:html={ARROW} /></button>}
            {p.isRental && <button class="buy__add" data-get-quote="rental" data-mode-btn><span class="buy__addt">Get a Quote</span><Fragment set:html={ARROW} /></button>}
          </div>
          {!p.isRental && <p class="bulk" data-bulk hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9-4 9 4-9 4z M3 12l9 4 9-4 M3 17l9 4 9-4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg><span>Ordering <b data-bulk-n>25</b> or more? We’ll price the whole order.</span><button type="button" data-get-quote="products">Get bulk pricing</button></p>}
          <p class="buy__unavail" data-unavail hidden>This combination is sold out online. Get a quote and we'll source it.</p>

          <div class="alt-actions px__in" style={`--d:${5 + options.length}`}>
            {!p.isRental && <button class="alt alt--quote" data-get-quote="products">Get a Quote<Fragment set:html={ARROW} /></button>}
            <button class="alt alt--ai" data-ask><span class="alt__ai">AI</span>Ask Conner about this</button>
          </div>

          <ul class="assure px__in" style={`--d:${6 + options.length}`}>
            {perks.map(([t, d, ic]) => (
              <li>
                <span class="assure__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ic} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <span><b>{t}</b><small>{d}</small></span>
              </li>
            ))}
          </ul>

          {customizable && (
            <a href="#customize" class="cz px__in" style={`--d:${7 + options.length}`}>
              <span class="cz__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18c1 0 1.6-.8 1.6-1.6 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-4-4-7.4-9-7.4z M7.5 11.5a1 1 0 1 0 0-.01 M10 7.5a1 1 0 1 0 0-.01 M14.5 7.5a1 1 0 1 0 0-.01"/></svg></span>
              <span class="cz__t"><strong>{builder?.kind === 'aframe' ? 'Print Your Own Rails' : builder ? 'Stencil Your Name Or Logo' : 'Brand It With Your Logo'}</strong><small>Design it live below. We confirm every detail before it’s made.</small></span>
              <svg class="cz__go" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v13M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  {/^truck-mounted-attenuator/.test(p.handle) && <TmaTruck />}

  <!-- ================= SECTION NAV ================= -->
  <nav class="pnav" aria-label="On this page" data-pnav>
    <div class="wrap pnav__in">
      <div class="pnav__links">
        {nav.map(([id, l]) => <a href={`#${id}`} data-pnav-a={id}>{l}</a>)}
      </div>
      <div class="pnav__acts">
        <button type="button" class="pnav__sheet" data-print><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Spec Sheet</button>
      </div>
    </div>
  </nav>

  <!-- ================= OVERVIEW ================= -->
  <section class="pov" id="overview" data-in>
    <div class="wrap pov__grid">
      <div class="pov__copy">
        <p class="eq-k"><span></span>Overview</p>
        <h2 class="pov__h">{kicker || (p.isRental ? 'Ready For Your Job.' : 'Built For Real Job Sites.')}</h2>
        {leadText.length ? leadText.map((l) => <p class="pov__lead">{l}</p>) : <p class="pov__lead">{meta?.sub || 'Built for work zones, job sites and events across the region.'}</p>}
        {chipsLine.length > 0 && <ul class="pov__tags">{chipsLine.map((c) => <li>{c}</li>)}</ul>}
        {included.length > 0 && (
          <div class="pov__box">
            <b><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9-4 9 4v10l-9 4-9-4z M3 7l9 4 9-4 M12 11v10" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg>Included</b>
            <ul>{included.map((x) => <li>{x}</li>)}</ul>
          </div>
        )}
      </div>
      {features.length > 0 ? (
        <ul class="pov__feat">
          {features.map((fe, i) => (
            <li style={`--i:${i}`}>
              <span class="pov__chk" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span>{fe.label && <b>{fe.label}</b>}<span>{fe.text}</span></span>
            </li>
          ))}
        </ul>
      ) : (
        <div class="pov__empty">
          <p>Need dimensions, weights or a spec sheet for a bid? Our team can send it over, usually the same day.</p>
          <a href={`/pages/request-a-quote?type=${p.isRental ? 'rental' : 'products'}`} class="eq-link">Request specs<Fragment set:html={ARROW} /></a>
        </div>
      )}
    </div>
  </section>

  <!-- ================= SPECS ================= -->
  <section class="pxd" id="specs" data-in>
    <div class="wrap">
      <div class="eq-head">
        <div>
          <p class="eq-k"><span></span>Specifications</p>
          <h2>Specs and <em>details.</em></h2>
        </div>
      </div>
    </div>
    <div class="wrap pxd__grid">
      <ul class="spec">
        {allSpecs.map(([k, v], i) => (
          <li style={`--i:${i}`}><span>{k}</span><b>{v}</b></li>
        ))}
      </ul>
      <aside class="pxs">
        {badges.length > 0 && (
          <div class="pxs__card">
            <p class="pxs__k">Standards</p>
            <ul class="pxs__std">
              {badges.map((b) => <li><span class="pxs__seal"><Fragment set:html={SHIELD} /></span><span><b>{b.k}</b><small>{b.d}</small></span></li>)}
            </ul>
          </div>
        )}
        <div class="pxs__card pxs__card--dark">
          <p class="pxs__k">For bids and submittals</p>
          <p class="pxs__p">Download a one-page spec sheet for this item, or ask our team for product data and certification documents.</p>
          <div class="pxs__acts">
            <button type="button" class="pxs__btn" data-print><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Download Spec Sheet</button>
            <a class="pxs__link" href={`/pages/request-a-quote?type=${p.isRental ? 'rental' : 'products'}`}>Request Documents<Fragment set:html={ARROW} /></a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {builder && (
    <div id="customize" class="pcz">
      <CustomBuilder kind={builder.kind} lock coneSize={builder.size || '28"'} id="customize-builder" kicker="Custom builder" title={`Make These ${builder.noun} <em>Yours.</em>`} lede={builder.lede} />
    </div>
  )}

  {isWatercade && (
    <section class="pwc" id="customize" data-in>
      <div class="wrap pwc__in">
        <div class="pwc__copy">
          <p class="eq-k eq-k--light"><span></span>WATERCADE builder</p>
          <h2>Brand Every Barrier. <em>See It In 3D.</em></h2>
          <p>Pick your color, add your logo and message, and see your WATERCADE before it’s made. Our team confirms every detail and price.</p>
          <div class="pwc__acts">
            <a href="/watercade/#customize" class="eq-pill eq-pill--red">Open The WATERCADE Builder<Fragment set:html={ARROW} /></a>
            <a href="#plan" class="eq-pill eq-pill--glass">Plan Your Layout</a>
          </div>
        </div>
        <a href="/watercade/#customize" class="pwc__art" aria-label="Open the WATERCADE builder">
          <img src="/custom/tpl/watercade-3.webp" alt="" loading="lazy" />
          <img src="/custom/police-barrier.webp" alt="" loading="lazy" class="pwc__ph" />
        </a>
      </div>
    </section>
  )}

  {model && Viewer3D && (
    <section class="px3" aria-labelledby="h3d">
      <div class="wrap">
        <div class="eq-head">
          <div>
            <p class="eq-k"><span></span>3D view</p>
            <h2 id="h3d">Turn it <em>around.</em></h2>
          </div>
          <p class="px3__lede">Drag to rotate, pinch or scroll to zoom.{isWatercade && ' Pick a color or add your logo to preview it.'}</p>
        </div>
        <div class="px3__frame">
          <Viewer3D model={model} colors={viewerColors} customize={isWatercade} controls="minimal" height="min(70vh, 560px)" />
        </div>
      </div>
    </section>
  )}

  {WatercadePlanner && (
    <section class="px3" id="plan" aria-labelledby="hplan">
      <div class="wrap">
        <div class="eq-head">
          <div>
            <p class="eq-k"><span></span>Layout planner</p>
            <h2 id="hplan">Plan your <em>layout.</em></h2>
          </div>
          <p class="px3__lede">See how many barriers your run or perimeter needs.</p>
        </div>
        <WatercadePlanner heading="" variants={p.variants.map((v) => ({ id: v.id, title: v.title, price: v.price }))} image={firstImg} />
      </div>
    </section>
  )}

  {uses.length > 0 && (
    <section class="puse" id="uses" data-in>
      <div class="wrap">
        <div class="eq-head">
          <div>
            <p class="eq-k"><span></span>Where it’s used</p>
            <h2>Made for <em>the job.</em></h2>
          </div>
          {!p.isRental && <p class="px3__lede">Not sure it fits your job? <a href="/pages/contact">Ask our team</a> or call <a href={PHONE_TEL}>{PHONE}</a>.</p>}
        </div>
        <ul class="puse__grid">
          {uses.map((u, i) => (
            <li style={`--i:${i}`}>
              <span class="puse__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={USE_IC[i % USE_IC.length]} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <b>{u}</b>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {accessories.length > 0 && (
    <section class="pxr pxr--pairs" id="pairs" aria-labelledby="hpairs" data-in>
      <div class="wrap">
        <div class="eq-head">
          <div>
            <p class="eq-k"><span></span>Complete the setup</p>
            <h2 id="hpairs">Pairs well <em>with.</em></h2>
          </div>
        </div>
        <ul class="pxr__grid">{accessories.map((r, i) => <li style={`--i:${i}`}><ProductCard p={r} /></li>)}</ul>
      </div>
    </section>
  )}

  {faqs.length > 0 && (
    <section class="pfaq" id="faq" data-in>
      <div class="wrap pfaq__grid">
        <div>
          <p class="eq-k"><span></span>FAQ</p>
          <h2 class="pfaq__h">Good <em>questions.</em></h2>
          <p class="pfaq__p">Can’t find your answer? Call <a href={PHONE_TEL}>{PHONE}</a> or <button type="button" class="pfaq__ai" data-ask-page>ask Conner</button>.</p>
        </div>
        <div class="pfaq__list">
          {faqs.map(([q, a], i) => (
            <details class="pfaq__it" open={i === 0}>
              <summary>{q}<span class="pfaq__pm" aria-hidden="true"></span></summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="pxr" aria-labelledby="hrel" data-in>
      <div class="wrap">
        <div class="eq-head">
          <div>
            <p class="eq-k"><span></span>Keep shopping</p>
            <h2 id="hrel">More <em>{relTitle}.</em></h2>
          </div>
          {crumbCol && <a href={`/collections/${crumbCol.handle}`} class="eq-link">See all {relTitle}<Fragment set:html={ARROW} /></a>}
        </div>
        <ul class="pxr__grid">{related.map((r, i) => <li style={`--i:${i}`}><ProductCard p={r} /></li>)}</ul>
      </div>
    </section>
  )}

  <section class="eqc" data-in>
    <div class="wrap eqc__in">
      <div>
        <p class="eq-k eq-k--light"><span></span>{p.isRental ? 'Rental quote' : 'Bulk and agency pricing'}</p>
        <h2>{p.isRental ? <>Need it on a job? <em>We’ll deliver it.</em></> : <>Buying in bulk? <em>Let’s talk pricing.</em></>}</h2>
      </div>
      <div class="eqc__acts">
        <a href={`/pages/request-a-quote?type=${p.isRental ? 'rental' : 'products'}`} class="eq-pill eq-pill--red">{p.isRental ? 'Get rental pricing' : 'Get bulk pricing'}<Fragment set:html={ARROW} /></a>
        <a href="/pages/contact" class="eq-pill eq-pill--glass">Talk to an expert</a>
      </div>
    </div>
  </section>

  <!-- printable one-page spec sheet -->
  <div class="sheet" aria-hidden="true">
    <div class="sheet__top"><img src="/brand/tss-logo.webp" alt="" width="200" /><span>Traffic Safety Service · South Plainfield, NJ · {PHONE} · {EMAIL}</span></div>
    <div class="sheet__main">
      {firstImg && <img class="sheet__img" src={img(firstImg, 700)} alt="" />}
      <div>
        <p class="sheet__cat">{crumbCol?.title || 'Product'}</p>
        <h2 class="sheet__h">{p.title}</h2>
        {badges.length > 0 && <p class="sheet__std">{badges.map((b) => b.k).join(' · ')}</p>}
        {intro && <p class="sheet__p">{intro}</p>}
      </div>
    </div>
    <table class="sheet__t"><tbody>{allSpecs.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}</tbody></table>
    {features.length > 0 && <ul class="sheet__f">{features.slice(0, 8).map((fe) => <li>{fe.label ? `${fe.label}: ` : ''}{fe.text}</li>)}</ul>}
    <p class="sheet__foot">trafficsafetyservice.com/products/{p.handle} · Specifications subject to change. Contact us to confirm before ordering.</p>
  </div>

  <RecentlyViewed exclude={p.handle} />
  <QuickView />

  <div class="buybar" data-buybar style={`--tint:${tint}`}>
    <div class="wrap buybar__in">
      {firstImg && <img class="buybar__img" src={img(firstImg, 160)} alt="" />}
      <div class="buybar__txt">
        <b>{p.title}</b>
        <span data-bar-price>{p.isRental ? 'Priced per job' : money(first.price)}</span>
      </div>
      <button type="button" class="btn buybar__btn" data-bar-add>{p.isRental ? 'Get a Quote' : 'Add to cart'}</button>
    </div>
  </div>
</Layout>

<script>
  const root = document.querySelector('[data-product]');
  if (root) {
    const variants = JSON.parse(root.dataset.variants);
    const qtyEl = root.querySelector('[data-qty]');
    const fmt = (n) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
    let logoData = '';

    const selected = () => {
      const o = {};
      root.querySelectorAll('[data-option]').forEach((fs) => { o[fs.dataset.option] = fs.querySelector('input:checked')?.value; });
      return variants.find((v) => Object.entries(o).every(([k, val]) => v.opts[k] === val)) || variants[0];
    };
    const update = () => {
      const v = selected();
      root.querySelectorAll('[data-option]').forEach((fs) => { fs.querySelector('[data-opt-val]').textContent = fs.querySelector('input:checked')?.value || ''; });
      const pr = root.querySelector('[data-price]');
      if (pr && pr.textContent !== fmt(v.price)) { pr.textContent = fmt(v.price); pr.classList.remove('is-flip'); void pr.offsetWidth; pr.classList.add('is-flip'); }
      const bp = document.querySelector('[data-bar-price]'); if (bp && !root.dataset.rental) bp.textContent = fmt(v.price);
      const add = root.querySelector('[data-add-cart]'); if (add) add.disabled = !v.available;
      root.querySelector('[data-unavail]').hidden = v.available;
      if (v.image) document.querySelector('[data-gallery]')?.tssGallery?.show(v.image);
      const viewer = document.querySelector('[data-viewer3d]');
      const color = v.opts.color || v.opts.Color;
      if (viewer && color) viewer.dispatchEvent(new CustomEvent('tss:viewer-colorname', { detail: { name: color } }));
    };
    root.addEventListener('change', (e) => { if (e.target.closest('[data-option]')) update(); });
    // bulk nudge: from 25 units, offer a quote for the whole order
    const bulk = root.querySelector('[data-bulk]');
    const checkBulk = () => { if (bulk) bulk.hidden = (parseInt(qtyEl.value, 10) || 1) < 25; };
    root.querySelectorAll('[data-q]').forEach((b) => b.addEventListener('click', () => { qtyEl.value = Math.max(1, (+qtyEl.value || 1) + +b.dataset.q); checkBulk(); }));
    qtyEl.addEventListener('input', checkBulk);
    const qty = () => Math.max(1, parseInt(qtyEl.value, 10) || 1);
    const vtitle = (v) => (v.title === 'Default Title' ? '' : v.title);

    // button feedback: label swaps to a check, then back
    const flash = (b, label) => {
      const t = b.querySelector('.buy__addt'); if (!t) return;
      const orig = b.dataset.label || t.textContent; b.dataset.label = orig;
      t.textContent = label; b.classList.add('is-done');
      clearTimeout(b._t); b._t = setTimeout(() => { t.textContent = b.dataset.label; b.classList.remove('is-done'); }, 1800);
    };
    root.querySelector('[data-add-cart]')?.addEventListener('click', async (e) => {
      const b = e.currentTarget; const t = b.querySelector('.buy__addt');
      b.disabled = true; b.dataset.label = b.dataset.label || t.textContent; t.textContent = 'Adding'; b.classList.add('is-busy');
      let ok = false;
      try { await window.TSSCart.add(selected().id, qty()); ok = true; } catch {} finally {
        b.disabled = false; b.classList.remove('is-busy'); t.textContent = b.dataset.label;
        if (ok) flash(b, 'Added to cart');
      }
    });
    // Get a Quote: opens the quote builder with this item already in it (purchase or rental)
    const toQuote = (type, note) => {
      const q = new URLSearchParams({ type, add: root.dataset.handle, v: vtitle(selected()), q: String(qty()), t: root.dataset.title });
      if (note) q.set('note', note);
      location.href = '/pages/request-a-quote?' + q.toString();
    };
    root.querySelectorAll('[data-get-quote]').forEach((b) => b.addEventListener('click', () => toQuote(b.dataset.getQuote)));
    root.querySelector('[data-ask]')?.addEventListener('click', () => {
      const v = selected();
      window.TSSChat?.ask(`I'm looking at ${root.dataset.title}${vtitle(v) ? ' (' + vtitle(v) + ')' : ''}. Can you tell me more about it${root.dataset.rental ? ' and how renting it works' : ', including rental and bulk options'}?`);
    });

    // Customization
    const viewer = () => document.querySelector('[data-viewer3d]');
    const colorEl = root.querySelector('[data-cc-color]');
    colorEl?.addEventListener('input', () => viewer()?.tssViewer?.setColor?.(colorEl.value));
    root.querySelector('[data-cc-logo]')?.addEventListener('change', (e) => {
      const f = e.target.files?.[0]; if (!f) return;
      if (f.size > 8e6) { window.TSSToast('That file is over 8 MB. Please use a smaller image.'); return; }
      const r = new FileReader();
      r.onload = () => {
        const im = new Image();
        im.onload = () => {
          // downscale for storage in the quote list
          const max = 800, k = Math.min(1, max / Math.max(im.width, im.height));
          const c = document.createElement('canvas'); c.width = Math.round(im.width * k) || 400; c.height = Math.round(im.height * k) || 400;
          c.getContext('2d').drawImage(im, 0, 0, c.width, c.height);
          logoData = c.toDataURL('image/png');
          root.querySelector('[data-cc-img]').src = logoData;
          root.querySelector('[data-cc-preview]').hidden = false;
          const vw = viewer(); vw?.tssViewer?.setLogo?.(logoData);
          vw?.dispatchEvent(new CustomEvent('tss:viewer-logo', { detail: { url: logoData } }));
        };
        im.src = r.result;
      };
      r.readAsDataURL(f);
    });
    root.querySelector('[data-cc-clear]')?.addEventListener('click', () => {
      logoData = ''; root.querySelector('[data-cc-preview]').hidden = true; root.querySelector('[data-cc-logo]').value = '';
      viewer()?.tssViewer?.setLogo?.(null);
    });
    // sticky buy bar: appears when the main buy controls scroll out of view
    const bar = document.querySelector('[data-buybar]');
    const qtyRow = root.querySelector('.qty-row');
    if (bar && qtyRow && 'IntersectionObserver' in window) {
      new IntersectionObserver(([en]) => {
        const on = !en.isIntersecting && en.boundingClientRect.top < 0;
        bar.classList.toggle('is-on', on);
        document.getElementById('tss-chat-assistant')?.toggleAttribute('data-lift', on);
      }, { threshold: 0 }).observe(qtyRow);
      bar.querySelector('[data-bar-add]').addEventListener('click', () => {
        (root.querySelector('[data-add-cart]') || root.querySelector('[data-mode-btn]'))?.click();
      });
    }

    // record for the "Recently viewed" strip
    try {
      const list = JSON.parse(localStorage.getItem('tss_recent') || '[]').filter((it) => it && it.h !== root.dataset.handle);
      list.unshift({ h: root.dataset.handle, t: root.dataset.title, i: root.dataset.image ? root.dataset.image.split('?')[0] + '?width=300' : '', p: root.dataset.minprice ? +root.dataset.minprice : null, r: root.dataset.rental ? 1 : 0 });
      localStorage.setItem('tss_recent', JSON.stringify(list.slice(0, 8)));
    } catch {}

    root.querySelector('[data-cc-add]')?.addEventListener('click', () => {
      const v = selected();
      const colorText = root.querySelector('[data-cc-colortext]').value.trim();
      const notes = root.querySelector('[data-cc-notes]').value.trim();
      const parts = [`Custom color: ${colorText || colorEl.value}`];
      if (logoData) parts.push('Logo attached');
      if (notes) parts.push(notes);
      if (logoData) parts[parts.indexOf('Logo attached')] = 'Has a logo to add (will email it)';
      toQuote('products', parts.join('. '));
    });
  }

  {
    // spec sheet: print just the one-page sheet
    document.querySelectorAll('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));
    document.querySelector('[data-ask-page]')?.addEventListener('click', () => {
      const r = document.querySelector('[data-product]');
      window.TSSChat?.ask(`I have a question about ${r?.dataset.title || 'this product'}.`);
    });
    // section nav: highlight the section in view
    const pnav = document.querySelector('[data-pnav]');
    if (pnav && 'IntersectionObserver' in window) {
      const links = [...pnav.querySelectorAll('[data-pnav-a]')];
      const set = (id) => links.forEach((a) => a.classList.toggle('is-on', a.dataset.pnavA === id));
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) set(e.target.id); }), { rootMargin: '-45% 0px -50% 0px' });
      links.forEach((a) => { const s = document.getElementById(a.dataset.pnavA); if (s) io.observe(s); });
    }
  }

  {
    // keep the sticky buy panel just under the site header, whatever its height
    const hdr = document.querySelector('header');
    const setTop = () => document.documentElement.style.setProperty('--hdr-h', `${Math.round(hdr.getBoundingClientRect().height)}px`);
    if (hdr) { setTop(); if ('ResizeObserver' in window) new ResizeObserver(setTop).observe(hdr); }
  }

  {
    // reveal sections as they scroll in
    const els = document.querySelectorAll('[data-in]');
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) els.forEach((e) => e.classList.add('is-in'));
    else {
      const io = new IntersectionObserver((ents) => ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } }), { threshold: 0.12 });
      els.forEach((e) => io.observe(e));
    }
  }

  {
    const sw = document.querySelector('[data-mode-sw]');
    if (sw) {
      const btn = document.querySelector('[data-mode-btn]');
      const txt = document.querySelector('[data-mode-txt]');
      const bar = document.querySelector('[data-bar-add]');
      const copy = { rent: ['Get a Quote', 'Priced per job. Get a quote for daily, weekly or monthly rates.'], buy: ['Get a Quote', 'Available to buy new. Get a quote for pricing and lead time.'] };
      sw.querySelectorAll('[data-m]').forEach((b) => b.addEventListener('click', () => {
        const m = b.dataset.m;
        sw.dataset.on = m;
        sw.querySelectorAll('[data-m]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
        if (btn) { btn.dataset.getQuote = m === 'buy' ? 'products' : 'rental'; btn.dataset.label = copy[m][0]; const t = btn.querySelector('.buy__addt'); if (t) t.textContent = copy[m][0]; }
        if (bar) bar.textContent = copy[m][0];
        if (txt) txt.textContent = copy[m][1];
      }));
    }
  }
</script>

<style>
  /* ---------- top band ---------- */
  .px { position: relative; padding: clamp(18px, 2.2vw, 28px) 0 clamp(44px, 5vw, 76px); isolation: isolate; overflow: clip; }
  .px__bg { position: absolute; inset: 0 0 auto; height: min(78%, 620px); z-index: -1; background: linear-gradient(180deg, var(--tint) 0%, color-mix(in srgb, var(--tint) 55%, #fff) 60%, #fff 100%); }
  .px__bg::after { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgba(20, 23, 26, .07) 1px, transparent 1.2px); background-size: 22px 22px; mask-image: linear-gradient(180deg, #000 0%, transparent 85%); -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 85%); }
  .px__crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; margin-bottom: clamp(14px, 1.8vw, 22px); font-size: .9rem; color: var(--ink-2); animation: pxUp .6s cubic-bezier(.2, .8, .2, 1) both; }
  .px__crumbs a { color: inherit; text-decoration: none; }
  .px__crumbs a:hover { color: var(--red); }
  .px__crumbs svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.2; opacity: .5; }
  .px__crumbs span { color: var(--steel); max-width: 40ch; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .px__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(22px, 3.6vw, 60px); align-items: start; }
  .px__gal { min-width: 0; animation: pxGal 1s cubic-bezier(.2, .8, .2, 1) both; }
  .px__gal :global(.gal__stage) { border-radius: 26px; border-color: rgba(20, 23, 26, .06); box-shadow: 0 50px 90px -60px rgba(20, 23, 26, .55), 0 2px 0 rgba(255, 255, 255, .8) inset; }
  .px__gal :global(.gal__slide img) { transition: transform .9s cubic-bezier(.2, .8, .2, 1); }
  .px__gal :global(.gal__stage:hover .gal__slide img) { transform: scale(1.035); }
  .px__gal :global(.gal__thumb) { border-radius: 14px; }
  .px__gal :global(.gal__zoom) { border-radius: 999px; }

  /* ---------- buy panel ---------- */
  .buy { position: sticky; top: calc(var(--hdr-h, 140px) + 20px); display: grid; gap: 18px; padding: clamp(20px, 2.4vw, 32px); border-radius: 26px; background: rgba(255, 255, 255, .86); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid rgba(20, 23, 26, .07); box-shadow: 0 50px 90px -64px rgba(20, 23, 26, .5); }
  .px__in { animation: pxUp .7s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(.18s + var(--d, 0) * 70ms); }
  @keyframes pxUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes pxGal { from { opacity: 0; transform: translateY(18px) scale(.97); } to { opacity: 1; transform: none; } }
  @keyframes pxRise { from { transform: translateY(105%); } to { transform: none; } }

  .buy__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; border-radius: 999px; background: var(--haze); color: var(--ink-2); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; font-variation-settings: 'wght' 680; text-decoration: none; }
  .chip i { width: 8px; height: 8px; border-radius: 50%; background: var(--steel); }
  .chip--cat { background: var(--tint); color: var(--ink); transition: background .2s; }
  .chip--cat i { background: var(--red); }
  .chip--cat:hover { background: color-mix(in srgb, var(--tint) 70%, #000 6%); }
  .chip--ok { background: #e7f3eb; color: #1c6b37; }
  .chip--ok i { background: #23a454; box-shadow: 0 0 0 0 rgba(35, 164, 84, .5); animation: pxPulse 2.2s ease-out infinite; }
  .chip--rent { background: var(--red); color: #fff; }
  @keyframes pxPulse { 0% { box-shadow: 0 0 0 0 rgba(35, 164, 84, .45); } 70%, 100% { box-shadow: 0 0 0 9px rgba(35, 164, 84, 0); } }

  .buy__title { margin: 0; font-size: clamp(1.9rem, 3.2vw, 3rem); line-height: 1.04; letter-spacing: -.035em; font-variation-settings: 'wght' 780; font-weight: 400; text-wrap: balance; }
  .buy__ln { display: block; overflow: hidden; padding-bottom: .06em; }
  .buy__ln > span { display: inline-block; animation: pxRise .9s .1s cubic-bezier(.2, .8, .2, 1) both; }
  .buy__price { margin: -4px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; }
  .buy__price strong { display: inline-block; font-size: clamp(1.8rem, 2.6vw, 2.3rem); letter-spacing: -.03em; font-variation-settings: 'wght' 780; color: var(--red); }
  .buy__price strong.is-flip { animation: pxFlip .45s cubic-bezier(.2, .8, .2, 1); }
  @keyframes pxFlip { from { opacity: 0; transform: translateY(-40%); filter: blur(3px); } to { opacity: 1; transform: none; filter: none; } }
  .buy__unit { color: var(--steel); font-size: .95rem; }
  .buy__price s { color: var(--steel); font-size: 1.1rem; }
  .buy__price--q { font-size: 1.05rem; color: var(--ink-2); line-height: 1.45; padding: 12px 14px; border-radius: 14px; background: var(--haze); }
  .buy__intro { margin: -2px 0 0; color: var(--ink-2); line-height: 1.55; font-size: 1rem; }

  .opt { border: 0; padding: 0; margin: 0; min-width: 0; }
  .opt legend { display: flex; gap: 8px; margin-bottom: 10px; padding: 0; font-size: .82rem; letter-spacing: .12em; text-transform: uppercase; color: var(--steel); font-variation-settings: 'wght' 700; }
  .opt legend span { color: var(--ink); letter-spacing: .02em; text-transform: none; font-size: .95rem; font-variation-settings: 'wght' 680; }
  .swatches, .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .sw, .pill { position: relative; }
  .sw input, .pill input { position: absolute; opacity: 0; inset: 0; cursor: pointer; margin: 0; }
  .sw > span { display: block; width: 40px; height: 40px; border-radius: 50%; background: var(--c); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .16); transition: transform .25s cubic-bezier(.2, .8, .2, 1), box-shadow .2s; }
  .sw:hover > span { transform: scale(1.08); }
  .sw input:checked + span { box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .16), 0 0 0 3px #fff, 0 0 0 5px var(--ink); }
  .sw input:focus-visible + span { box-shadow: 0 0 0 3px #fff, 0 0 0 5px var(--red); }
  .pill > span { display: block; padding: 10px 16px 9px; border: 1.5px solid var(--line-dark); border-radius: 999px; background: #fff; font-variation-settings: 'wght' 620; font-size: .95rem; cursor: pointer; transition: border-color .2s, background .2s, color .2s, transform .2s; }
  .pill > span:hover { border-color: var(--ink); }
  .pill input:active + span { transform: scale(.96); }
  .pill input:checked + span { border-color: var(--ink); background: var(--ink); color: #fff; }
  .pill input:focus-visible + span { outline: 3px solid rgba(182, 6, 6, .35); outline-offset: 2px; }

  .qty-row { display: flex; gap: 10px; }
  .qty { display: flex; align-items: stretch; border: 1.5px solid var(--line-dark); border-radius: 999px; background: #fff; overflow: hidden; flex: none; }
  .qty button { width: 46px; border: 0; background: none; font-size: 1.3rem; cursor: pointer; color: var(--steel); transition: background .15s, color .15s; }
  .qty button:hover { background: var(--haze); color: var(--ink); }
  .qty input { width: 52px; border: 0; text-align: center; font: inherit; font-variation-settings: 'wght' 700; font-size: 1.05rem; background: none; -moz-appearance: textfield; }
  .qty input::-webkit-inner-spin-button { -webkit-appearance: none; }
  .buy__add { position: relative; flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 22px; border: 0; border-radius: 999px; background: var(--red); color: #fff; font: inherit; font-size: 1.04rem; font-variation-settings: 'wght' 720; cursor: pointer; overflow: hidden; box-shadow: 0 18px 34px -18px rgba(182, 6, 6, .85); transition: background .2s, transform .15s, box-shadow .2s; }
  .buy__add::before { content: ''; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, .28) 50%, transparent 70%); transform: translateX(-120%); transition: transform .8s cubic-bezier(.2, .8, .2, 1); }
  .buy__add:hover { background: var(--red-press); }
  .buy__add:hover::before { transform: translateX(120%); }
  .buy__add:active { transform: scale(.98); }
  .buy__add :global(svg) { width: 18px; height: 18px; transition: transform .2s; }
  .buy__add:hover :global(svg) { transform: translateX(3px); }
  .buy__add[disabled] { opacity: .55; cursor: not-allowed; box-shadow: none; }
  .buy__add.is-busy { cursor: progress; opacity: 1; }
  .buy__add.is-done { background: #1c7a3e; box-shadow: 0 18px 34px -18px rgba(28, 122, 62, .8); }
  .buy__add.is-done :global(svg) { opacity: 0; }
  .buy__add.is-done .buy__addt::before { content: '✓'; display: inline-block; margin-right: 8px; animation: pxPop .4s cubic-bezier(.2, 1.4, .4, 1); }
  @keyframes pxPop { from { transform: scale(0); } to { transform: scale(1); } }
  .buy__add--dark { flex: none; width: 100%; background: var(--ink); box-shadow: none; }
  .buy__add--dark:hover { background: #000; }
  .buy__unavail { margin: 0; color: var(--red); font-variation-settings: 'wght' 680; }

  .alt-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .alt { display: inline-flex; align-items: center; gap: 8px; min-height: 42px; padding: 0 16px; border-radius: 999px; border: 1.5px solid var(--line-dark); background: #fff; color: var(--ink); font: inherit; font-size: .92rem; font-variation-settings: 'wght' 640; cursor: pointer; transition: border-color .2s, background .2s, color .2s; }
  .alt:hover { border-color: var(--ink); background: var(--ink); color: #fff; }
  .alt__ai { padding: 2px 6px; border-radius: 6px; background: var(--gold); color: var(--ink); font-size: .7rem; font-variation-settings: 'wght' 800; }

  .assure { list-style: none; margin: 2px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .assure li { display: grid; gap: 8px; align-content: start; }
  .assure__ic { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--red-tint); color: var(--red); }
  .assure__ic svg { width: 21px; height: 21px; }
  .assure b { display: block; font-size: .92rem; line-height: 1.25; font-variation-settings: 'wght' 720; }
  .assure small { display: block; margin-top: 2px; color: var(--steel); font-size: .82rem; line-height: 1.35; }

  .custom { border-radius: 20px; background: linear-gradient(135deg, #fff 0%, var(--haze) 100%); border: 1px solid var(--line); overflow: hidden; }
  .custom summary { list-style: none; display: grid; grid-template-columns: 42px minmax(0, 1fr) 20px; align-items: center; gap: 12px; padding: 14px 16px; cursor: pointer; }
  .custom summary::-webkit-details-marker { display: none; }
  .custom__ic { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: conic-gradient(from 200deg, #ff6a13, #ffcd00, #23a454, #0047bb, #c8102e, #ff6a13); }
  .custom__ic svg { width: 22px; height: 22px; fill: #fff; stroke: none; opacity: .95; }
  .custom__t { display: grid; gap: 2px; }
  .custom__t strong { font-variation-settings: 'wght' 720; }
  .custom__sub { color: var(--steel); font-size: .88rem; }
  .custom__chev { width: 20px; height: 20px; fill: none; stroke: var(--steel); stroke-width: 2.2; transition: rotate .3s cubic-bezier(.2, .8, .2, 1); }
  .custom[open] .custom__chev { rotate: 180deg; }
  .custom__body { padding: 4px 16px 18px; display: grid; gap: 16px; }
  .custom[open] .custom__body { animation: pxUp .45s cubic-bezier(.2, .8, .2, 1); }
  .custom label { display: block; margin-bottom: 6px; font-size: .92rem; font-variation-settings: 'wght' 660; }
  .custom__color { display: flex; gap: 8px; }
  .custom__color input[type=color] { width: 54px; min-height: 50px; padding: 4px; border-radius: 12px; border: 1.5px solid var(--line-dark); background: #fff; flex: none; cursor: pointer; }
  .custom input[type=text], .custom textarea { width: 100%; min-height: 50px; padding: 12px 14px; border-radius: 12px; border: 1.5px solid var(--line-dark); font: inherit; background: #fff; }
  .custom input[type=file] { color: var(--ink-2); font-size: .92rem; }
  .custom .hint { margin: 6px 0 0; color: var(--steel); font-size: .85rem; }
  .custom__preview { display: flex; align-items: center; gap: 12px; margin-top: 8px; }
  .custom__preview img { width: 72px; height: 72px; object-fit: contain; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 6px; }

  /* ---------- shared section heads ---------- */
  .eq-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 40px; margin-bottom: clamp(22px, 2.8vw, 36px); }
  .eq-k { display: flex; align-items: center; gap: 12px; margin: 0 0 14px; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; font-variation-settings: 'wght' 680; color: var(--steel); }
  .eq-k span { width: 34px; height: 3px; border-radius: 2px; background: var(--red); }
  .eq-k--light { color: rgba(255, 255, 255, .8); }
  .eq-head h2, .eqc h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.6rem); line-height: .98; letter-spacing: -.04em; font-variation-settings: 'wght' 780; font-weight: 400; text-wrap: balance; }
  .eq-head h2 em, .eqc h2 em { font-style: normal; color: var(--red); }
  .eq-link { display: inline-flex; align-items: center; gap: 10px; padding: 13px 22px 12px; border-radius: 999px; border: 1.5px solid var(--line-dark); color: var(--ink); font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, color .2s, border-color .2s; }
  .eq-link :global(svg) { width: 17px; height: 17px; transition: transform .2s; }
  .eq-link:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
  .eq-link:hover :global(svg) { transform: translateX(3px); }
  .eq-pill { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 14px 26px 13px; border-radius: 999px; font-size: 1.02rem; font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s; }
  .eq-pill :global(svg) { width: 18px; height: 18px; transition: transform .2s; }
  .eq-pill:hover :global(svg) { transform: translateX(3px); }
  .eq-pill--red { background: var(--red); color: #fff; }
  .eq-pill--red:hover { background: #d10a0a; }
  .eq-pill--glass { background: rgba(255, 255, 255, .08); color: #fff; border: 1.5px solid rgba(255, 255, 255, .4); }
  .eq-pill--glass:hover { background: rgba(255, 255, 255, .16); }
  [data-in] li { opacity: 0; transform: translateY(18px); transition: opacity .6s, transform .7s cubic-bezier(.2, .8, .2, 1); transition-delay: calc(var(--i, 0) * 60ms); }
  [data-in].is-in li { opacity: 1; transform: none; }

  /* ---------- specs + details ---------- */
  .pxd { padding: clamp(48px, 6vw, 90px) 0; background: var(--haze); }
  .pxd__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  .spec { list-style: none; margin: 0; padding: 0; border-radius: 22px; background: #fff; border: 1px solid var(--line); overflow: hidden; }
  .spec li { display: grid; grid-template-columns: minmax(110px, .7fr) minmax(0, 1.3fr); gap: 16px; padding: 16px 22px; border-top: 1px solid var(--line); transition: background .2s, opacity .6s, transform .7s cubic-bezier(.2, .8, .2, 1); }
  .spec li:first-child { border-top: 0; }
  .spec li:hover { background: #fafafb; }
  .spec span { color: var(--steel); font-size: .92rem; }
  .spec b { font-variation-settings: 'wght' 650; font-size: .98rem; overflow-wrap: anywhere; }
  .pxd__desc { padding: clamp(22px, 2.6vw, 34px); border-radius: 22px; background: #fff; border: 1px solid var(--line); }
  .pxd__desc--empty { display: grid; gap: 16px; justify-items: start; }
  .pxd__desc--empty p { margin: 0; font-size: 1.1rem; line-height: 1.55; color: var(--ink-2); }
  .rte { max-width: 70ch; color: var(--ink-2); line-height: 1.65; }
  .rte :global(> :first-child) { margin-top: 0; }
  .rte :global(> :last-child) { margin-bottom: 0; }
  .rte :global(h1), .rte :global(h2), .rte :global(h3), .rte :global(h4) { color: var(--ink); font-size: 1.2rem; letter-spacing: -.01em; margin: 1.3em 0 .5em; font-variation-settings: 'wght' 740; }
  .rte :global(ul) { padding-left: 1.1em; }
  .rte :global(li) { margin: .3em 0; }
  .rte :global(li::marker) { color: var(--red); }
  .rte :global(strong) { color: var(--ink); }
  .rte :global(img) { height: auto; max-width: 100%; border-radius: 12px; }
  .rte :global(table) { border-collapse: collapse; width: 100%; font-size: .95rem; }
  .rte :global(td), .rte :global(th) { border-bottom: 1px solid var(--line); padding: 10px 8px; text-align: left; }
  .rte :global(a) { color: var(--red); }

  /* ---------- 3D + planner ---------- */
  .px3 { padding: clamp(48px, 6vw, 90px) 0; background: #fff; }
  .px3__lede { margin: 0; max-width: 40ch; color: var(--steel); }
  .px3__frame { border-radius: 26px; overflow: hidden; border: 1px solid var(--line); background: radial-gradient(120% 90% at 50% 10%, #fff, var(--haze) 70%); }

  /* ---------- related ---------- */
  .pxr { padding: clamp(48px, 6vw, 90px) 0; background: #fff; }
  .pxd + .pxr, .px3 + .pxr { padding-top: clamp(24px, 3vw, 40px); }
  .pxr__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 20px); }
  .pxr__grid > li { display: grid; }

  /* ---------- CTA ---------- */
  .eqc { padding: clamp(56px, 7vw, 100px) 0; background: radial-gradient(120% 140% at 85% 0%, #3a0505 0%, #16181b 55%); color: #fff; }
  .eqc__in { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 26px 40px; }
  .eqc h2 { color: #fff; max-width: 16ch; }
  .eqc__acts { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .eqc .eq-k, .eqc h2 { transition: opacity .7s, transform .8s cubic-bezier(.2, .8, .2, 1); }
  .eqc:not(.is-in) .eq-k, .eqc:not(.is-in) h2 { opacity: 0; transform: translateY(16px); }

  /* ---------- sticky buy bar ---------- */
  .buybar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 35; background: rgba(255, 255, 255, .92); backdrop-filter: blur(16px) saturate(1.4); -webkit-backdrop-filter: blur(16px) saturate(1.4); border-top: 1px solid var(--line); box-shadow: 0 -20px 40px -30px rgba(20, 23, 26, .45); translate: 0 110%; transition: translate .4s cubic-bezier(.2, .8, .2, 1); }
  .buybar.is-on { translate: 0 0; }
  .buybar__in { display: flex; align-items: center; gap: 14px; padding-block: 10px; padding-right: clamp(88px, 9vw, 116px); }
  .buybar__img { width: 50px; height: 50px; object-fit: contain; border-radius: 12px; background: var(--tint, #fff); padding: 4px; flex: none; }
  .buybar__txt { display: grid; line-height: 1.25; min-width: 0; margin-right: auto; }
  .buybar__txt b { font-variation-settings: 'wght' 700; font-size: .98rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .buybar__txt span { color: var(--red); font-size: .95rem; font-variation-settings: 'wght' 700; }
  .buybar__btn { min-height: 48px; padding: 0 24px; border-radius: 999px; background: var(--red); color: #fff; border: 0; font: inherit; font-variation-settings: 'wght' 700; white-space: nowrap; cursor: pointer; transition: background .2s; }
  .buybar__btn:hover { background: var(--red-press); }

  /* ---------- rent / buy switch ---------- */
  .mode { position: relative; display: inline-grid; grid-template-columns: 1fr 1fr; width: 220px; padding: 5px; border-radius: 999px; background: var(--haze); border: 1px solid var(--line); }
  .mode i { position: absolute; top: 5px; bottom: 5px; left: 5px; width: calc(50% - 5px); border-radius: 999px; background: var(--red); transition: transform .45s cubic-bezier(.2, .8, .2, 1), background .3s; }
  .mode[data-on="buy"] i { transform: translateX(100%); background: var(--ink); }
  .mode button { all: unset; position: relative; z-index: 1; cursor: pointer; text-align: center; padding: 10px 0 9px; font-variation-settings: 'wght' 720; color: var(--steel); transition: color .3s; }
  .mode button[aria-selected="true"] { color: #fff; }
  .mode button:focus-visible { outline: 3px solid rgba(182, 6, 6, .35); outline-offset: 2px; border-radius: 999px; }

  /* ---------- responsive ---------- */
  @media (max-width: 1100px) {
    .pxr__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .pxr__grid > li:nth-child(4) { display: none; }
  }
  @media (max-width: 900px) {
    .px__grid, .pxd__grid { grid-template-columns: 1fr; }
    .buy { position: static; padding: 0; background: none; border: 0; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
    .pxd__desc { margin-top: 0; }
    .px__bg { height: 520px; }
  }
  @media (max-width: 640px) {
    .px { padding-top: 12px; }
    .px__crumbs span { max-width: 22ch; }
    .px__gal :global(.gal__stage) { border-radius: 20px; }
    .assure { grid-template-columns: 1fr; gap: 10px; }
    .assure li { grid-template-columns: 40px minmax(0, 1fr); align-items: center; gap: 12px; }
    .qty button { width: 40px; }
    .qty input { width: 40px; }
    .buy__add { padding: 0 16px; font-size: 1rem; }
    .eq-head { justify-content: center; text-align: center; }
    .eq-head .eq-k { justify-content: center; }
    .spec li { grid-template-columns: minmax(96px, .8fr) minmax(0, 1.2fr); gap: 12px; padding: 12px 16px; }
    .spec span { font-size: .86rem; }
    .spec b { font-size: .92rem; }
    .pxr__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pxr__grid > li:nth-child(4) { display: grid; }
    .eqc__in { justify-content: center; text-align: center; }
    .eqc h2 { margin-inline: auto; }
    .eqc__acts { justify-content: center; width: 100%; }
    .eqc__acts .eq-pill { width: 100%; }
    .buybar__img { display: none; }
    .buybar__btn { padding-inline: 16px; font-size: .95rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .px__crumbs, .px__gal, .px__in, .buy__ln > span, .chip--ok i, .buy__price strong.is-flip { animation: none; }
    [data-in] li, .eqc:not(.is-in) .eq-k, .eqc:not(.is-in) h2 { opacity: 1; transform: none; transition: none; }
    .buybar { transition: none; }
  }
  .alt--quote { background: var(--ink); border-color: var(--ink); color: #fff; }
  .alt--quote:hover { background: var(--red); border-color: var(--red); }
  .alt--quote :global(svg) { width: 16px; height: 16px; }

  /* ================= upgraded product page ================= */
  .chip--pick { background: #fff3cc; color: #6b4b00; }
  .cert { list-style: none; margin: -6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .cert li { display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px 5px 8px; border-radius: 999px; background: #eef5ff; color: #1b4f9c; font-size: .8rem; letter-spacing: .02em; font-variation-settings: 'wght' 720; }
  .cert li :global(svg) { width: 15px; height: 15px; }
  .kspec { display: grid; grid-template-columns: repeat(min(var(--n, 4), 4), minmax(0, 1fr)); gap: 1px; margin: 0; border-radius: 16px; overflow: hidden; background: var(--line); border: 1px solid var(--line); }
  .kspec > div { display: grid; gap: 3px; align-content: start; padding: 12px 14px; background: #fff; }
  .kspec dt { color: var(--steel); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; font-variation-settings: 'wght' 700; }
  .kspec dd { margin: 0; font-size: .98rem; line-height: 1.25; font-variation-settings: 'wght' 720; }
  .bulk { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin: -6px 0 0; padding: 12px 14px; border-radius: 14px; background: #fff7df; border: 1px solid #f5dc8c; color: #5c4300; font-size: .92rem; animation: pxUp .4s cubic-bezier(.2, .8, .2, 1); }
  .bulk[hidden] { display: none; }
  .bulk svg { width: 20px; height: 20px; flex: none; }
  .bulk span { flex: 1 1 200px; }
  .bulk button { border: 0; padding: 8px 14px; border-radius: 999px; background: var(--ink); color: #fff; font: inherit; font-size: .86rem; font-variation-settings: 'wght' 700; cursor: pointer; }
