---
import Layout from '../../layouts/Layout.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuickView from '../../components/QuickView.astro';
import RecentlyViewed from '../../components/RecentlyViewed.astro';
import { loadCatalog, money, img } from '../../lib/shopify.js';
import { CATEGORY_META } from '../../lib/categories.js';

export async function getStaticPaths() {
  const { products } = await loadCatalog();
  return products.map((p) => ({ params: { handle: p.handle }, props: { handle: p.handle } }));
}
const { handle } = Astro.props;
const { byHandle, colByHandle } = await loadCatalog();
const p = byHandle.get(handle);

// Optional 3D viewer and WATERCADE planner (built separately); load only if present.
const viewerMods = import.meta.glob('../../components/tools/viewer3d/Viewer3D.astro', { eager: true });
const Viewer3D = Object.values(viewerMods)[0]?.default;
const plannerMods = import.meta.glob('../../components/tools/watercade/WatercadePlanner.astro', { eager: true });
const WatercadePlanner = handle === 'waterbarriertss590rparent' ? Object.values(plannerMods)[0]?.default : null;
const inCol = (h) => p.collections.includes(h);
const model =
  handle.includes('waterbarriertss590r') ? 'watercade' :
  handle === 'arrow-board' ? 'arrowboard' :
  inCol('cones') && /cone(18|28|36)/.test(handle) ? 'cone' :
  inCol('traffic-drums') && handle.startsWith('traffic-drum') ? 'drum' :
  handle.startsWith('type-iii') ? 'barricade' : null;

const CUSTOM_COLS = ['cones', 'traffic-drums', 'water-filled-barriers', 'barricades', 'safety-gear', 'sign-shop', 'deliniators', 'a-frame-barricade', 'type-lll-barricades'];
const customizable = !p.isRental && CUSTOM_COLS.some(inCol);

const SWATCH = { orange: '#f26a1b', lime: '#c6e33b', 'dark green': '#1f5d3a', green: '#2e8b3d', 'navy blue': '#1f2f5c', navy: '#1f2f5c', blue: '#1f5fbf', 'sky blue': '#6cc4ee', pink: '#ff6fae', red: '#c8102e', white: '#f7f7f2', yellow: '#f6d10b', black: '#1d2024', silver: '#c0c4c8', gray: '#8a9097', grey: '#8a9097' };
const options = p.options.filter((o) => !(o.name === 'Title' && o.values[0] === 'Default Title'));
const isColor = (name) => /colou?r/i.test(name);
const variants = p.variants.map((v) => ({ id: v.id, title: v.title, price: +v.price.amount, compare: v.compareAtPrice ? +v.compareAtPrice.amount : null, available: v.availableForSale, opts: Object.fromEntries(v.selectedOptions.map((o) => [o.name, o.value])), image: v.image?.url || null }));
const first = variants.find((v) => v.available) || variants[0];
const viewerColors = model === 'cone' ? (options.find((o) => isColor(o.name))?.values || ['Orange']) : model === 'watercade' ? ['Orange', 'White'] : undefined;

// Related: same primary collection
const primary = ['cones', 'water-filled-barriers', 'barricades', 'traffic-drums', 'sign-shop', 'safety-gear', 'lights', 'reflectors', 'equipment-rentals', 'truck-rentals'].find(inCol);
const related = primary ? colByHandle.get(primary)?.products.filter((x) => x.handle !== handle).slice(0, 4) || [] : [];
const crumbCol = primary ? colByHandle.get(primary) : null;
const desc = (p.seo?.description || p.description || '').slice(0, 155);
const firstImg = p.featuredImage?.url;
const sellable = p.isRental && p.collections.includes('equipment-rentals') && !p.collections.includes('truck-rentals');
// Theme bits: category tint, short intro line, at-a-glance specs drawn from real product data.
const meta = primary ? CATEGORY_META[primary] : null;
const tint = meta?.tint || '#ebebe8';
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const plain = (p.description || '').replace(/\s+/g, ' ').trim();
const intro = (() => {
  if (!plain) return '';
  const cut = plain.slice(0, 220);
  const end = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '));
  return end > 60 ? cut.slice(0, end + 1) : cut.length < plain.length ? cut.replace(/\s+\S*$/, '') + '…' : cut;
})();
const cap = (t) => t.charAt(0).toUpperCase() + t.slice(1);
const specs = [
  crumbCol && ['Category', crumbCol.title],
  ...options.map((o) => [cap(o.name), o.values.length > 6 ? `${o.values.length} options: ${o.values.slice(0, 5).join(', ')} and more` : o.values.join(', ')]),
  !p.isRental && ['Price', p.minPrice === p.maxPrice ? `${money(+p.minPrice)} each` : `${money(+p.minPrice)} to ${money(+p.maxPrice)} each`],
  p.isRental ? ['Rental area', 'NJ, NY, PA and CT'] : ['Shipping', 'Ships anywhere in the U.S.'],
  !p.isRental && ['Rent it', 'Available to rent in NJ, NY, PA and CT'],
  sellable && ['Buy it', 'Also available to buy new'],
  customizable && ['Customizing', 'Your logo, colors or stenciling'],
  ['Ordering', p.isRental ? 'Daily, weekly, monthly or long-term' : 'Card, net terms or purchase order']
].filter(Boolean);
const perks = p.isRental ? [
  ['Delivered and picked up', 'Anywhere in NJ, NY, PA and CT', 'M2.5 7h11v9h-11z M13.5 10h4l3 3.5V16h-7z M6.5 19a1.7 1.7 0 1 0 0-.01 M16.5 19a1.7 1.7 0 1 0 0-.01'],
  ['Day, week or month', 'Rates that fit the job', 'M4 5h16v15H4z M4 9h16 M8 3v4M16 3v4'],
  ['Crews on call', 'We can set it up and run it', 'M12 3l7.5 3v5.5c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V6z M8.5 12l2.4 2.4 4.6-4.8']
] : [
  ['Ships nationwide', 'Fast from our NJ yard', 'M2.5 7h11v9h-11z M13.5 10h4l3 3.5V16h-7z M6.5 19a1.7 1.7 0 1 0 0-.01 M16.5 19a1.7 1.7 0 1 0 0-.01'],
  ['Net terms and POs', 'For agencies and contractors', 'M6 3h12v18l-3-2-3 2-3-2-3 2z M9 8h6M9 12h6M9 16h3'],
  ['Rent it too', 'In NJ, NY, PA and CT', 'M15 7a3 3 0 1 1-3 3 M12 10l-8 8 2 2 2-2 1 1 2-2-1-1 2-2']
];
const inStock = !p.isRental && variants.some((v) => v.available);
const relTitle = crumbCol ? crumbCol.title.toLowerCase() : 'products';
---
<Layout title={p.seo?.title || p.title} description={desc} image={firstImg}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Product', name: p.title, image: p.images.map((i) => i.url), description: p.description,
    brand: { '@type': 'Brand', name: 'Traffic Safety Service' },
    ...(p.isRental ? {} : { offers: { '@type': 'AggregateOffer', priceCurrency: 'USD', lowPrice: p.minPrice, highPrice: p.maxPrice, availability: 'https://schema.org/InStock' } })
  })} />

  <!-- ================= TOP: gallery + buy panel ================= -->
  <section class="px" style={`--tint:${tint}`}>
    <div class="px__bg" aria-hidden="true"></div>
    <div class="wrap">
      <nav class="px__crumbs" aria-label="Breadcrumb">
        <a href="/collections">Shop</a>
        {crumbCol && <><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg><a href={`/collections/${crumbCol.handle}`}>{crumbCol.title}</a></>}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg><span aria-current="page">{p.title}</span>
      </nav>

      <div class="px__grid">
        <div class="px__gal">
          <ProductGallery images={p.images} title={p.title} />
        </div>

        <div class="buy" data-product data-handle={p.handle} data-title={p.title} data-image={firstImg} data-minprice={p.isRental ? '' : p.minPrice} data-variants={JSON.stringify(variants)} data-rental={p.isRental ? '1' : ''}>
          <div class="buy__chips px__in" style="--d:0">
            {crumbCol && <a href={`/collections/${crumbCol.handle}`} class="chip chip--cat"><i></i>{crumbCol.title}</a>}
            {p.isRental ? <span class="chip chip--rent">Rental</span> : inStock ? <span class="chip chip--ok"><i></i>In stock</span> : <span class="chip">Made to order</span>}
            {customizable && <span class="chip">Customizable</span>}
          </div>

          {sellable && <div class="mode px__in" style="--d:1" role="tablist" aria-label="Rent or buy" data-mode-sw><i aria-hidden="true"></i><button type="button" role="tab" aria-selected="true" data-m="rent">Rent</button><button type="button" role="tab" aria-selected="false" data-m="buy">Buy</button></div>}

          <h1 class="buy__title"><span class="buy__ln"><span>{p.title}</span></span></h1>

          {p.isRental ? (
            <p class="buy__price buy__price--q px__in" style="--d:2" data-mode-txt>Priced per job. Request a quote for daily, weekly or monthly rates.</p>
          ) : (
            <p class="buy__price px__in" style="--d:2"><strong data-price>{money(first.price)}</strong> <span class="buy__unit">each</span>{first.compare && first.compare > first.price && <s data-compare>{money(first.compare)}</s>}</p>
          )}
          {intro && <p class="buy__intro px__in" style="--d:3">{intro}</p>}

          {options.map((o, oi) => (
            <fieldset class="opt px__in" style={`--d:${4 + oi}`} data-option={o.name}>
              <legend>{cap(o.name)} <span data-opt-val>{first.opts[o.name]}</span></legend>
              <div class={isColor(o.name) ? 'swatches' : 'pills'}>
                {o.values.map((val) => (
                  <label class={isColor(o.name) ? 'sw' : 'pill'} title={val}>
                    <input type="radio" name={`opt-${o.name}`} value={val} checked={first.opts[o.name] === val} />
                    {isColor(o.name) ? <span style={`--c:${SWATCH[val.toLowerCase()] || '#ccc'}`}><span class="sr-only">{val}</span></span> : <span>{val}</span>}
                  </label>
                ))}
              </div>
            </fieldset>
          ))}

          <div class="qty-row px__in" style={`--d:${4 + options.length}`}>
            <label class="qty">
              <span class="sr-only">Quantity</span>
              <button type="button" data-q="-1" aria-label="Decrease quantity">−</button>
              <input type="number" min="1" value="1" data-qty inputmode="numeric" />
              <button type="button" data-q="1" aria-label="Increase quantity">+</button>
            </label>
            {!p.isRental && <button class="buy__add" data-add-cart><span class="buy__addt">Add to cart</span><Fragment set:html={ARROW} /></button>}
            {p.isRental && <button class="buy__add" data-add-quote="rent" data-mode-btn><span class="buy__addt">Add to rental quote</span><Fragment set:html={ARROW} /></button>}
          </div>
          <p class="buy__unavail" data-unavail hidden>This combination is sold out online. Add it to your quote list and we'll source it.</p>

          <div class="alt-actions px__in" style={`--d:${5 + options.length}`}>
            {!p.isRental && <button class="alt" data-add-quote="rent">Rent this instead</button>}
            {!p.isRental && <button class="alt" data-add-quote="buy">Bulk or PO quote</button>}
            <button class="alt alt--ai" data-ask><span class="alt__ai">AI</span>Ask Conner about this</button>
          </div>

          <ul class="assure px__in" style={`--d:${6 + options.length}`}>
            {perks.map(([t, d, ic]) => (
              <li>
                <span class="assure__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ic} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <span><b>{t}</b><small>{d}</small></span>
              </li>
            ))}
          </ul>

          {customizable && (
            <details class="custom px__in" style={`--d:${7 + options.length}`} data-custom>
              <summary>
                <span class="custom__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18c1 0 1.6-.8 1.6-1.6 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-4-4-7.4-9-7.4z M7.5 11.5a1 1 0 1 0 0-.01 M10 7.5a1 1 0 1 0 0-.01 M14.5 7.5a1 1 0 1 0 0-.01"/></svg></span>
                <span class="custom__t"><strong>Make it yours</strong><span class="custom__sub">Custom colors, your logo, stenciling and bulk branding</span></span>
                <svg class="custom__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </summary>
              <div class="custom__body">
                <div class="field">
                  <label for="cc-color">Color you want</label>
                  <div class="custom__color">
                    <input type="color" id="cc-color" value="#f26a1b" data-cc-color />
                    <input type="text" placeholder="Or describe it, e.g. PMS 286 blue" data-cc-colortext aria-label="Describe the color" />
                  </div>
                </div>
                <div class="field">
                  <label for="cc-logo">Your logo</label>
                  <input type="file" id="cc-logo" accept="image/png,image/jpeg,image/svg+xml,image/webp" data-cc-logo />
                  <p class="hint">PNG, JPG or SVG. A transparent background works best. You'll approve a proof before production.</p>
                  <div class="custom__preview" data-cc-preview hidden>
                    <img data-cc-img alt="Your uploaded logo" />
                    <button type="button" class="line__rm" data-cc-clear>Remove logo</button>
                  </div>
                </div>
                <div class="field">
                  <label for="cc-notes">Placement, text or stenciling</label>
                  <textarea id="cc-notes" rows="3" placeholder="e.g. Logo on both sides, your company name stenciled on the base, 200 units" data-cc-notes></textarea>
                </div>
                <button type="button" class="buy__add buy__add--dark" data-cc-add><span class="buy__addt">Add custom order to quote list</span><Fragment set:html={ARROW} /></button>
                {model && <p class="hint">Preview your logo and color on the 3D model below.</p>}
              </div>
            </details>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SPECS + DETAILS ================= -->
  <section class="pxd" data-in>
    <div class="wrap">
      <div class="eq-head">
        <div>
          <p class="eq-k"><span></span>At a glance</p>
          <h2>Specs and <em>details.</em></h2>
        </div>
      </div>
    </div>
    <div class="wrap pxd__grid">
      <div>
        <ul class="spec">
          {specs.map(([k, v], i) => (
            <li style={`--i:${i}`}><span>{k}</span><b>{v}</b></li>
          ))}
        </ul>
      </div>
      {p.descriptionHtml ? (
        <div class="pxd__desc">
          <div class="rte" set:html={p.descriptionHtml} />
        </div>
      ) : (
        <div class="pxd__desc pxd__desc--empty">
          <p>Need dimensions, weights or a spec sheet for a bid? Our team can send it over, usually the same day.</p>
          <a href={`/pages/request-a-quote?type=${p.isRental ? 'rental' : 'products'}`} class="eq-link">Request specs<Fragment set:html={ARROW} /></a>
        </div>
      )}
    </div>
  </section>

  {model && Viewer3D && (
    <section class="px3" aria-labelledby="h3d">
      <div class="wrap">
        <div class="eq-head">
          <div>
            <p class="eq-k"><span></span>3D view</p>
            <h2 id="h3d">Turn it <em>around.</em></h2>
          </div>
          <p class="px3__lede">Drag to rotate, pinch or scroll to zoom.{customizable && ' Pick a color or upload your logo above to preview it.'}</p>
        </div>
        <div class="px3__frame">
          <Viewer3D model={model} colors={viewerColors} customize={customizable} controls="minimal" height="min(70vh, 560px)" />
        </div>
      </div>
    </section>
  )}

  {WatercadePlanner && (
    <section class="px3" aria-labelledby="hplan">
      <div class="wrap">
        <div class="eq-head">
          <div>
            <p class="eq-k"><span></span>Layout planner</p>
            <h2 id="hplan">Plan your <em>layout.</em></h2>
          </div>
          <p class="px3__lede">See how many barriers your run or perimeter needs.</p>
        </div>
        <WatercadePlanner heading="" variants={p.variants.map((v) => ({ id: v.id, title: v.title, price: v.price }))} image={firstImg} />
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="pxr" aria-labelledby="hrel" data-in>
      <div class="wrap">
        <div class="eq-head">
          <div>
            <p class="eq-k"><span></span>Keep shopping</p>
            <h2 id="hrel">More <em>{relTitle}.</em></h2>
          </div>
          {crumbCol && <a href={`/collections/${crumbCol.handle}`} class="eq-link">See all {relTitle}<Fragment set:html={ARROW} /></a>}
        </div>
        <ul class="pxr__grid">{related.map((r, i) => <li style={`--i:${i}`}><ProductCard p={r} /></li>)}</ul>
      </div>
    </section>
  )}

  <section class="eqc" data-in>
    <div class="wrap eqc__in">
      <div>
        <p class="eq-k eq-k--light"><span></span>{p.isRental ? 'Rental quote' : 'Bulk and agency pricing'}</p>
        <h2>{p.isRental ? <>Need it on a job? <em>We’ll deliver it.</em></> : <>Buying in bulk? <em>Let’s talk pricing.</em></>}</h2>
      </div>
      <div class="eqc__acts">
        <a href={`/pages/request-a-quote?type=${p.isRental ? 'rental' : 'products'}`} class="eq-pill eq-pill--red">{p.isRental ? 'Get rental pricing' : 'Get bulk pricing'}<Fragment set:html={ARROW} /></a>
        <a href="/pages/contact" class="eq-pill eq-pill--glass">Talk to an expert</a>
      </div>
    </div>
  </section>

  <RecentlyViewed exclude={p.handle} />
  <QuickView />

  <div class="buybar" data-buybar style={`--tint:${tint}`}>
    <div class="wrap buybar__in">
      {firstImg && <img class="buybar__img" src={img(firstImg, 160)} alt="" />}
      <div class="buybar__txt">
        <b>{p.title}</b>
        <span data-bar-price>{p.isRental ? 'Priced per job' : money(first.price)}</span>
      </div>
      <button type="button" class="btn buybar__btn" data-bar-add>{p.isRental ? 'Add to rental quote' : 'Add to cart'}</button>
    </div>
  </div>
</Layout>

<script>
  const root = document.querySelector('[data-product]');
  if (root) {
    const variants = JSON.parse(root.dataset.variants);
    const qtyEl = root.querySelector('[data-qty]');
    const fmt = (n) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
    let logoData = '';

    const selected = () => {
      const o = {};
      root.querySelectorAll('[data-option]').forEach((fs) => { o[fs.dataset.option] = fs.querySelector('input:checked')?.value; });
      return variants.find((v) => Object.entries(o).every(([k, val]) => v.opts[k] === val)) || variants[0];
    };
    const update = () => {
      const v = selected();
      root.querySelectorAll('[data-option]').forEach((fs) => { fs.querySelector('[data-opt-val]').textContent = fs.querySelector('input:checked')?.value || ''; });
      const pr = root.querySelector('[data-price]');
      if (pr && pr.textContent !== fmt(v.price)) { pr.textContent = fmt(v.price); pr.classList.remove('is-flip'); void pr.offsetWidth; pr.classList.add('is-flip'); }
      const bp = document.querySelector('[data-bar-price]'); if (bp && !root.dataset.rental) bp.textContent = fmt(v.price);
      const add = root.querySelector('[data-add-cart]'); if (add) add.disabled = !v.available;
      root.querySelector('[data-unavail]').hidden = v.available;
      if (v.image) document.querySelector('[data-gallery]')?.tssGallery?.show(v.image);
      const viewer = document.querySelector('[data-viewer3d]');
      const color = v.opts.color || v.opts.Color;
      if (viewer && color) viewer.dispatchEvent(new CustomEvent('tss:viewer-colorname', { detail: { name: color } }));
    };
    root.addEventListener('change', (e) => { if (e.target.closest('[data-option]')) update(); });
    root.querySelectorAll('[data-q]').forEach((b) => b.addEventListener('click', () => { qtyEl.value = Math.max(1, (+qtyEl.value || 1) + +b.dataset.q); }));
    const qty = () => Math.max(1, parseInt(qtyEl.value, 10) || 1);
    const vtitle = (v) => (v.title === 'Default Title' ? '' : v.title);

    // button feedback: label swaps to a check, then back
    const flash = (b, label) => {
      const t = b.querySelector('.buy__addt'); if (!t) return;
      const orig = b.dataset.label || t.textContent; b.dataset.label = orig;
      t.textContent = label; b.classList.add('is-done');
      clearTimeout(b._t); b._t = setTimeout(() => { t.textContent = b.dataset.label; b.classList.remove('is-done'); }, 1800);
    };
    root.querySelector('[data-add-cart]')?.addEventListener('click', async (e) => {
      const b = e.currentTarget; const t = b.querySelector('.buy__addt');
      b.disabled = true; b.dataset.label = b.dataset.label || t.textContent; t.textContent = 'Adding'; b.classList.add('is-busy');
      let ok = false;
      try { await window.TSSCart.add(selected().id, qty()); ok = true; } catch {} finally {
        b.disabled = false; b.classList.remove('is-busy'); t.textContent = b.dataset.label;
        if (ok) flash(b, 'Added to cart');
      }
    });
    root.querySelectorAll('[data-add-quote]').forEach((b) => b.addEventListener('click', () => {
      const v = selected();
      window.TSSQuote.add([{ title: root.dataset.title, handle: root.dataset.handle, image: root.dataset.image, variant: vtitle(v), qty: qty(), mode: b.dataset.addQuote }]);
      if (b.classList.contains('buy__add')) flash(b, 'Added to quote');
    }));
    root.querySelector('[data-ask]')?.addEventListener('click', () => {
      const v = selected();
      window.TSSChat?.ask(`I'm looking at ${root.dataset.title}${vtitle(v) ? ' (' + vtitle(v) + ')' : ''}. Can you tell me more about it${root.dataset.rental ? ' and how renting it works' : ', including rental and bulk options'}?`);
    });

    // Customization
    const viewer = () => document.querySelector('[data-viewer3d]');
    const colorEl = root.querySelector('[data-cc-color]');
    colorEl?.addEventListener('input', () => viewer()?.tssViewer?.setColor?.(colorEl.value));
    root.querySelector('[data-cc-logo]')?.addEventListener('change', (e) => {
      const f = e.target.files?.[0]; if (!f) return;
      if (f.size > 8e6) { window.TSSToast('That file is over 8 MB. Please use a smaller image.'); return; }
      const r = new FileReader();
      r.onload = () => {
        const im = new Image();
        im.onload = () => {
          // downscale for storage in the quote list
          const max = 800, k = Math.min(1, max / Math.max(im.width, im.height));
          const c = document.createElement('canvas'); c.width = Math.round(im.width * k) || 400; c.height = Math.round(im.height * k) || 400;
          c.getContext('2d').drawImage(im, 0, 0, c.width, c.height);
          logoData = c.toDataURL('image/png');
          root.querySelector('[data-cc-img]').src = logoData;
          root.querySelector('[data-cc-preview]').hidden = false;
          const vw = viewer(); vw?.tssViewer?.setLogo?.(logoData);
          vw?.dispatchEvent(new CustomEvent('tss:viewer-logo', { detail: { url: logoData } }));
        };
        im.src = r.result;
      };
      r.readAsDataURL(f);
    });
    root.querySelector('[data-cc-clear]')?.addEventListener('click', () => {
      logoData = ''; root.querySelector('[data-cc-preview]').hidden = true; root.querySelector('[data-cc-logo]').value = '';
      viewer()?.tssViewer?.setLogo?.(null);
    });
    // sticky buy bar: appears when the main buy controls scroll out of view
    const bar = document.querySelector('[data-buybar]');
    const qtyRow = root.querySelector('.qty-row');
    if (bar && qtyRow && 'IntersectionObserver' in window) {
      new IntersectionObserver(([en]) => {
        const on = !en.isIntersecting && en.boundingClientRect.top < 0;
        bar.classList.toggle('is-on', on);
        document.getElementById('tss-chat-assistant')?.toggleAttribute('data-lift', on);
      }, { threshold: 0 }).observe(qtyRow);
      bar.querySelector('[data-bar-add]').addEventListener('click', () => {
        (root.querySelector('[data-add-cart]') || root.querySelector('[data-mode-btn]') || root.querySelector('[data-add-quote="rent"]'))?.click();
      });
    }

    // record for the "Recently viewed" strip
    try {
      const list = JSON.parse(localStorage.getItem('tss_recent') || '[]').filter((it) => it && it.h !== root.dataset.handle);
      list.unshift({ h: root.dataset.handle, t: root.dataset.title, i: root.dataset.image ? root.dataset.image.split('?')[0] + '?width=300' : '', p: root.dataset.minprice ? +root.dataset.minprice : null, r: root.dataset.rental ? 1 : 0 });
      localStorage.setItem('tss_recent', JSON.stringify(list.slice(0, 8)));
    } catch {}

    root.querySelector('[data-cc-add]')?.addEventListener('click', () => {
      const v = selected();
      const colorText = root.querySelector('[data-cc-colortext]').value.trim();
      const notes = root.querySelector('[data-cc-notes]').value.trim();
      const parts = [`Custom color: ${colorText || colorEl.value}`];
      if (logoData) parts.push('Logo attached');
      if (notes) parts.push(notes);
      window.TSSQuote.add([{ title: root.dataset.title + ' (custom)', handle: root.dataset.handle, image: logoData || root.dataset.image, variant: vtitle(v), qty: qty(), mode: 'buy', note: parts.join('. '), logo: logoData }]);
