      const io = new IntersectionObserver((ents) => ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } }), { threshold: 0.12 });
      els.forEach((e) => io.observe(e));
    }
  }

  {
    const sw = document.querySelector('[data-mode-sw]');
    if (sw) {
      const btn = document.querySelector('[data-mode-btn]');
      const txt = document.querySelector('[data-mode-txt]');
      const bar = document.querySelector('[data-bar-add]');
      const copy = { rent: ['Add to rental quote', 'Priced per job. Request a quote for daily, weekly or monthly rates.'], buy: ['Add to purchase quote', 'Available to buy new. Add it to your quote list for pricing and lead time.'] };
      sw.querySelectorAll('[data-m]').forEach((b) => b.addEventListener('click', () => {
