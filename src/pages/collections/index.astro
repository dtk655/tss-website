---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuickView from '../../components/QuickView.astro';
import CategoryRails from '../../components/CategoryRails.astro';
import WatercadeBand from '../../components/WatercadeBand.astro';
import { loadCatalog } from '../../lib/shopify.js';
const { byHandle } = await loadCatalog();
const best = ['cone28inch', 'waterbarriertss590rparent', 'traffic-drum-4-6-hi-intensity-reflective-stripes-w-tire-ring', 'type-iii-breakaway-barricade-hi-intensity-left-stripes', 'class3safetyvest'].map((h) => byHandle.get(h)).filter(Boolean);
---
<Layout title="Products" description="Traffic cones, barricades, WATERCADE barriers, drums, signs, lights, reflectors and safety gear. Buy online with nationwide shipping, or rent in NJ, NY, PA and CT.">
  <section class="phero">
    <div class="wrap phero__in">
      <div class="phero__copy">
        <p class="phero__k">The TSS yard · South Plainfield, NJ</p>
        <h1>Everything your work zone needs.</h1>
        <p class="phero__lede">Buy it shipped nationwide, or rent it by the job in NJ, NY, PA and CT.</p>
        <div class="phero__cta">
          <a href="/collections/safety-products" class="phero__btn phero__btn--buy">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h3l2.4 11h10.2L21 7H7.2 M10 20a1 1 0 1 0 0-.01 M18 20a1 1 0 1 0 0-.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>
            Buy today
          </a>
          <a href="/pages/request-a-quote" class="phero__btn phero__btn--quote">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7z M14 3v5h5 M10 13h6 M10 17h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            Build a quote
          </a>
        </div>
      </div>
      <div class="phero__art" aria-hidden="true">
        <span class="phero__glow"></span>
        <div class="job">
          <div class="job__head">
            <div>
              <b>Job sheet — lane closure</b>
              <small>State highway · Monday 7:00 AM</small>
            </div>
            <span class="job__badge">TSS</span>
          </div>
          <div class="job__row">
            <span class="job__ico"><svg viewBox="0 0 24 24"><path d="M10.4 4.5 L13.6 4.5 L18 19.5 L6 19.5 Z M8.3 12.5 L15.7 12.5" /></svg></span>
            <span class="job__t">28" reflective cones</span>
            <b class="job__q">× 200</b>
            <span class="job__chk"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.6 4.5L19 7.5" /></svg></span>
          </div>
          <div class="job__row">
            <span class="job__ico"><svg viewBox="0 0 24 24"><path d="M5 7h14 M5 12h14 M5 17h14 M7.5 7v10 M16.5 7v10" /></svg></span>
            <span class="job__t">Type III barricades</span>
            <b class="job__q">× 12</b>
            <span class="job__chk"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.6 4.5L19 7.5" /></svg></span>
          </div>
          <div class="job__row">
            <span class="job__ico"><svg viewBox="0 0 24 24"><rect x="3.5" y="6" width="17" height="12" rx="1.5" /><path d="M8 12h7 M12.5 9.2L15.6 12l-3.1 2.8" /></svg></span>
            <span class="job__t">Arrow board rental</span>
            <b class="job__q">× 2</b>
            <span class="job__chk"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.6 4.5L19 7.5" /></svg></span>
          </div>
          <div class="job__row job__row--crew">
            <span class="job__ico"><svg viewBox="0 0 24 24"><path d="M8 4.5h8l2 4v11H6v-11z M8 4.5v6 M16 4.5v6 M10.5 13h3" /></svg></span>
            <span class="job__t">Union flagger crew</span>
            <b class="job__q">24/7</b>
            <span class="job__chk"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.6 4.5L19 7.5" /></svg></span>
          </div>
          <div class="job__stamp">Quote ready</div>
        </div>
      </div>
    </div>
  </section>

  <CategoryRails />

  <div class="perks" role="list">
    <div class="wrap perks__in">
      <p role="listitem"><svg viewBox="0 0 24 24"><rect x="2.5" y="6.5" width="13" height="11" rx="1.5"/><path d="M15.5 10h3.4l2.6 3.4v4.1h-6z M7 20.6a1.9 1.9 0 1 0 0-.01 M17.6 20.6a1.9 1.9 0 1 0 0-.01"/></svg><b>Ships nationwide</b><span>from South Plainfield, NJ</span></p>
      <p role="listitem"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4z M4 10h16 M8 15h5"/></svg><b>Net terms &amp; POs</b><span>for agencies and contractors</span></p>
      <p role="listitem"><svg viewBox="0 0 24 24"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z M12 12l8-4.5 M12 12v9 M12 12L4 7.5"/></svg><b>Bulk &amp; pallet pricing</b><span>ask for a volume quote</span></p>
      <p role="listitem"><svg viewBox="0 0 24 24"><path d="M3 17V7l4 3 5-6 5 6 4-3v10z M3 17h18v2.5H3z"/></svg><b>Everything rents too</b><span>in NJ, NY, PA and CT</span></p>
    </div>
  </div>

  <section class="wrap wcsec">
    <WatercadeBand />
  </section>

  <section class="wrap best">
    <div class="row-head reveal">
      <h2>Most ordered by crews</h2>
      <a class="textlink" href="/collections/safety-products">Shop all products</a>
    </div>
    <div class="grid best__grid">
      {best.map((p, i) => <div class="reveal" style={`--d:${i * 60}ms`}><ProductCard p={p} /></div>)}
    </div>
  </section>

  <section class="wrap brandsec">
    <a href="/pages/custom-stenciling" class="brand reveal">
      <span class="brand__body">
        <span class="brand__k">Custom shop</span>
        <span class="brand__t">Your logo on it</span>
        <span class="brand__d">Colors, logos and stenciling on cones, drums, barriers and signs — from our in-house sign shop. Preview yours in 3D.</span>
        <span class="brand__cta btn">Start a custom order</span>
      </span>
      <span class="brand__art" aria-hidden="true">
        <svg viewBox="0 0 160 190">
          <ellipse cx="80" cy="176" rx="62" ry="10" fill="#000" opacity=".25"/>
          <rect x="18" y="160" width="124" height="16" rx="5" fill="#2a2f34"/>
          <path d="M68 18 Q80 8 92 18 L128 162 L32 162 Z" fill="#f26a1b"/>
          <path d="M60.5 48 L99.5 48 L104 66 L56 66 Z" fill="#f4f6f8"/>
          <path d="M48 98 L112 98 L117 120 L43 120 Z" fill="#fff"/>
          <text x="80" y="114" text-anchor="middle" font-family="Archivo, sans-serif" font-size="15" font-weight="800" fill="#b60606">YOUR LOGO</text>
        </svg>
      </span>
    </a>
  </section>

  <section class="wrap xbands">
    <div class="xband reveal">
      <div>
        <h2>Need trucks or powered equipment?</h2>
        <p>Crash trucks, arrow boards, VMS boards, light towers and the rest of the fleet live under Rentals.</p>
      </div>
      <a class="btn btn--dark" href="/collections/equipment-rentals">See the rental fleet</a>
    </div>
    <div class="xband reveal" style="--d:80ms">
      <div>
        <h2>Not sure what the job calls for?</h2>
        <p>Tell Conner the road, speed and dates, or lay the whole zone out with the work zone builder.</p>
      </div>
      <div class="xband__cta">
        <button class="btn" data-ask-conner>Ask Conner</button>
        <a class="btn btn--ghost" href="/tools/work-zone-builder">Work zone builder</a>
      </div>
    </div>
  </section>
  <QuickView />
</Layout>
<script>
  document.querySelector('[data-ask-conner]')?.addEventListener('click', () => window.TSSChat?.ask('Can you help me figure out which traffic control products I need for my job?'));

  /* hero job sheet: requirements check themselves off on a loop */
  const allJobRows = [...document.querySelectorAll('.job__row')];
  let jobRows = allJobRows.filter((r) => r.offsetParent !== null);
  const jobStamp = document.querySelector('.job__stamp');
  if (jobRows.length && jobStamp) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      jobRows.forEach((r) => r.classList.add('is-done'));
      jobStamp.classList.add('is-on');
    } else {
      let i = 0;
      const tick = () => {
        if (i < jobRows.length) {
          jobRows[i++].classList.add('is-done');
          setTimeout(tick, 820);
        } else {
          jobStamp.classList.add('is-on');
          setTimeout(() => {
            allJobRows.forEach((r) => r.classList.remove('is-done'));
            jobStamp.classList.remove('is-on');
            jobRows = allJobRows.filter((r) => r.offsetParent !== null);
            i = 0;
            setTimeout(tick, 700);
          }, 2800);
        }
      };
      setTimeout(tick, 700);
    }
  }

</script>
<style>
  /* ---------------- hero ---------------- */
  .phero { position: relative; background: radial-gradient(120% 170% at 88% -30%, #e13a1a 0%, #b60606 42%, #8a0404 100%); color: #fff; overflow: hidden; }
  .phero__in { position: relative; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, .6fr); align-items: center; gap: clamp(20px, 4vw, 60px); padding-block: clamp(26px, 3vw, 44px) clamp(24px, 3vw, 40px); }
  .crumbs { display: flex; gap: 8px; font-size: .9rem; color: #f0b3b3; margin-bottom: 12px; }
  .crumbs a { color: inherit; }
  .phero__k { color: var(--gold); font-size: clamp(.95rem, 1.1vw, 1.15rem); letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 700; margin: 0 0 14px; }
  .phero h1 { text-wrap: balance; font-size: clamp(2.1rem, 3.55vw, 3.5rem); line-height: 1.02; letter-spacing: -.025em; font-variation-settings: 'wght' 780; margin: 0 0 18px; }
  .phero__lede { color: #fbd9d4; font-size: clamp(1.05rem, 1.45vw, 1.35rem); line-height: 1.5; max-width: 60ch; margin: 0 0 26px; }
  .phero__cta { display: flex; flex-wrap: wrap; gap: 14px; }
  .phero__btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 60px; padding: 17px 32px 16px; border-radius: 12px; font-size: 1.14rem; font-variation-settings: 'wght' 680; text-decoration: none; white-space: nowrap; transition: background .15s, color .15s, border-color .15s, translate .15s, box-shadow .15s; }
  .phero__btn svg { width: 22px; height: 22px; flex: none; }
  .phero__btn:hover { translate: 0 -2px; }
  .phero__btn--buy { background: #fff; color: var(--red); box-shadow: 0 14px 30px -14px rgba(0, 0, 0, .45); }
  .phero__btn--buy:hover { background: var(--haze); }
  .phero__btn--quote { border: 2px solid rgba(255, 255, 255, .7); color: #fff; }
  .phero__btn--quote:hover { background: rgba(255, 255, 255, .12); border-color: #fff; }
  .phero__art { position: relative; display: grid; place-items: center; min-height: 0; }
  .phero__glow { position: absolute; width: 135%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, rgba(245, 184, 0, .3), rgba(245, 184, 0, .07) 55%, transparent 72%); }

  /* animated job sheet */
  .job { position: relative; width: min(390px, 100%); background: #fff; border-radius: 16px; box-shadow: 0 40px 80px -24px rgba(0, 0, 0, .5); padding: 16px 20px 18px; rotate: -2deg; animation: jobbob 6s ease-in-out infinite; }
  @keyframes jobbob { 0%, 100% { translate: 0 0; rotate: -2deg; } 50% { translate: 0 -10px; rotate: -1.2deg; } }
  @keyframes jobbobm { 0%, 100% { translate: 0 0; } 50% { translate: 0 -5px; } }
  .job__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; border-bottom: 2px solid var(--haze-2); padding-bottom: 14px; margin-bottom: 8px; }
  .job__head b { display: block; color: var(--ink); font-size: 1.04rem; font-variation-settings: 'wght' 720; }
  .job__head small { color: var(--steel); font-size: .85rem; }
  .job__badge { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 10px; background: var(--red); color: #fff; font-variation-settings: 'wght' 800; letter-spacing: .02em; font-size: .92rem; }
  .job__row { display: flex; align-items: center; gap: 11px; padding: 8px 0; border-bottom: 1px solid var(--haze-2); opacity: .38; translate: 8px 0; transition: opacity .45s ease, translate .45s ease; }
  .job__row:last-of-type { border-bottom: 0; }
  .job__row.is-done { opacity: 1; translate: 0 0; }
  .job__ico { flex: none; width: 34px; height: 34px; border-radius: 9px; background: var(--haze); display: grid; place-items: center; color: var(--ink-2); }
  .job__ico svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
  .job__t { flex: 1; color: var(--ink); font-size: .96rem; font-variation-settings: 'wght' 620; }
  .job__q { color: var(--steel); font-size: .92rem; font-variation-settings: 'wght' 700; }
  .job__chk { flex: none; width: 26px; height: 26px; border-radius: 50%; background: var(--haze-2); display: grid; place-items: center; transition: background .3s ease; }
  .job__chk svg { width: 15px; height: 15px; fill: none; stroke: #fff; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 24; stroke-dashoffset: 24; transition: stroke-dashoffset .4s ease .1s; }
  .job__row.is-done .job__chk { background: #1d9e4b; }
  .job__row.is-done .job__chk svg { stroke-dashoffset: 0; }
  .job__stamp {
    position: absolute; right: 18px; bottom: -16px; rotate: -7deg;
    border: 3px solid var(--red); color: var(--red); background: #fff; border-radius: 10px;
    padding: 8px 16px 6px; font-size: 1.05rem; text-transform: uppercase; letter-spacing: .09em; font-variation-settings: 'wght' 800;
    box-shadow: var(--shadow-m); opacity: 0; scale: 1.6; transition: opacity .3s ease, scale .3s cubic-bezier(.2, .9, .3, 1.4);
  }
  .job__stamp.is-on { opacity: 1; scale: 1; }
  @media (prefers-reduced-motion: reduce) { .job { animation: none; } }

  /* ---------------- perks ---------------- */
  .perks { margin-top: clamp(36px, 4.5vw, 56px); border-block: 1px solid var(--line); background: var(--haze); }
  .perks__in { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding-block: 18px; }
  .perks p { margin: 0; display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: 12px; font-size: .9rem; color: var(--steel); line-height: 1.3; min-width: 0; }
  .perks svg { width: 27px; height: 27px; grid-row: span 2; fill: none; stroke: var(--red); stroke-width: 1.7; stroke-linejoin: round; stroke-linecap: round; }
  .perks b { color: var(--ink); font-variation-settings: 'wght' 680; white-space: nowrap; }

  /* ---------------- WATERCADE band ---------------- */
  .wcsec { padding-top: clamp(40px, 5vw, 64px); }

  /* ---------------- best sellers + brand + xbands ---------------- */
  .best { padding-block: clamp(48px, 6vw, 72px) 0; }
  .best__grid > :global(.reveal) { display: grid; }
  .row-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 26px; flex-wrap: wrap; }
  .row-head h2 { font-size: clamp(1.9rem, 2.8vw, 2.6rem); letter-spacing: -.02em; }
  .best__grid { grid-template-columns: repeat(5, 1fr); }

  .brandsec { padding-top: clamp(40px, 5vw, 64px); }
  .brand { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; background: linear-gradient(135deg, #1e2227, #15181c); color: #fff; border-radius: 18px; overflow: hidden; text-decoration: none; box-shadow: var(--shadow-m); transition: transform .15s ease, box-shadow .15s ease; }
  .brand:hover { transform: translateY(-2px); box-shadow: var(--shadow-l); }
  .brand__body { display: grid; gap: 9px; padding: 34px clamp(24px, 3.4vw, 48px); justify-items: start; }
  .brand__k { color: var(--gold); font-size: .88rem; font-variation-settings: 'wght' 700; letter-spacing: .1em; text-transform: uppercase; }
  .brand__t { font-size: clamp(1.7rem, 2.6vw, 2.4rem); font-variation-settings: 'wght' 760; letter-spacing: -.02em; }
  .brand__d { color: #b9c0c7; font-size: .98rem; line-height: 1.55; max-width: 52ch; }
  .brand__cta { margin-top: 8px; }
  .brand__art { padding: 18px 40px 0 0; }
  .brand__art svg { width: clamp(110px, 11vw, 160px); height: auto; }

  .xbands { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-block: clamp(48px, 6vw, 72px) clamp(64px, 8vw, 110px); }
  .xband { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; background: var(--haze); border: 1px solid var(--line); border-radius: var(--r-l); padding: 28px 30px; }
  .xband h2 { font-size: var(--fs-2); margin-bottom: 6px; }
  .xband p { margin: 0; color: var(--steel); font-size: .97rem; max-width: 44ch; }
  .xband__cta { display: flex; gap: 10px; flex-wrap: wrap; }

  /* ---------------- responsive ---------------- */
  @media (max-width: 1180px) {
    .best__grid { grid-template-columns: repeat(4, 1fr); }
    .perks__in { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 920px) {
    .phero__in { grid-template-columns: 1fr; padding-block: 24px 30px; gap: 18px; }
    .phero__copy { text-align: center; }
    .phero h1 { font-size: clamp(1.05rem, 5.6vw, 1.7rem); letter-spacing: -.03em; margin-bottom: 8px; }
    .job__row--crew { display: none; }
    .job__row:nth-last-of-type(3) { border-bottom: 0; }
    .phero__lede { margin-bottom: 0; margin-inline: auto; }
    .phero__k { margin-bottom: 8px; font-size: .8rem; }
    .crumbs { display: none; }
    .phero__cta { justify-content: center; gap: 10px; margin-top: 16px; }
    .phero__btn { flex: 1 1 0; min-height: 46px; padding: 11px 12px 10px; font-size: .95rem; }
    .phero__art { order: 2; min-height: 0; margin-top: 2px; }
    .phero__glow { width: 110%; }
    .job { rotate: 0deg; width: 100%; max-width: 420px; padding: 13px 16px 15px; justify-self: center; animation: jobbobm 6s ease-in-out infinite; }
    .job__head { padding-bottom: 9px; margin-bottom: 4px; }
    .job__head b { font-size: .9rem; }
    .job__head small { font-size: .76rem; }
    .job__badge { width: 36px; height: 36px; font-size: .8rem; }
    .job__row { padding: 6px 0; gap: 9px; }
    .job__ico { width: 28px; height: 28px; border-radius: 7px; }
    .job__ico svg { width: 17px; height: 17px; }
    .job__t { font-size: .84rem; }
    .job__q { font-size: .8rem; }
    .job__chk { width: 21px; height: 21px; }
    .job__chk svg { width: 12px; height: 12px; }
    .job__stamp { font-size: .85rem; padding: 6px 12px 5px; bottom: -15px; right: 14px; }
    .job { padding-bottom: 26px; }
    .phero__lede { text-wrap: balance; }
    .best__grid { grid-template-columns: repeat(3, 1fr); }
    .xbands { grid-template-columns: 1fr; }
    .brand { grid-template-columns: 1fr; }
    .brand__art { display: none; }
  }
  @media (max-width: 640px) {
    .best__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .perks__in { grid-template-columns: 1fr 1fr; gap: 10px; }
    .perks p > b + span { display: none; }
  }
</style>
