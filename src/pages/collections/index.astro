---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuickView from '../../components/QuickView.astro';
import { loadCatalog, PRODUCT_COLLECTIONS, img } from '../../lib/shopify.js';
const { colByHandle, byHandle } = await loadCatalog();
const col = (h) => colByHandle.get(h);
const blurbs = {
  cones: 'Reflective and plain, 18" to 36", nine colors',
  barricades: 'Type III, A-frame, urbanite and rails',
  'water-filled-barriers': 'WATERCADE and airport barriers',
  'traffic-drums': 'Engineer grade and hi-intensity',
  'sign-shop': 'Stock signs and custom work',
  lights: 'Barricade lights, flares and batons',
  reflectors: 'Side and top mount reflectors',
  'safety-gear': 'Vests, jackets and hard hats',
  'sign-stands': 'K-stands, tripods and Windmasters',
  deliniators: 'Ring-top, knob-top and bases'
};
const tints = { cones: '#fdf2e7', barricades: '#f2f6fa', 'water-filled-barriers': '#fdecec', 'traffic-drums': '#fdf2e7', 'sign-shop': '#fdecec', lights: '#fdf7e3', reflectors: '#f2f6fa', 'safety-gear': '#f2f8ee', 'sign-stands': '#f6f6f4', deliniators: '#fdf2e7' };
const feature = col('cones');
const coneLinks = ['cone18inchparent', 'cone28inch', 'cone36inch']
  .map((h) => byHandle.get(h))
  .filter(Boolean)
  .map((p) => ({ href: `/products/${p.handle}`, label: p.title.match(/^\d+"/) ? p.title.match(/^\d+"/)[0] + ' cones' : p.title }));
const rowA = ['barricades', 'water-filled-barriers'].map(col).filter(Boolean);
const rowB = ['traffic-drums', 'sign-shop'].map(col).filter(Boolean);
const rowC = ['lights', 'reflectors', 'safety-gear', 'sign-stands'].map(col).filter(Boolean);
const last = col('deliniators');
const best = ['cone28inch', 'waterbarriertss590rparent', 'traffic-drum-4-6-hi-intensity-reflective-stripes-w-tire-ring', 'type-iii-breakaway-barricade-hi-intensity-left-stripes', 'class3safetyvest'].map((h) => byHandle.get(h)).filter(Boolean);
const count = (c) => `${c.products.length} ${c.products.length === 1 ? 'product' : 'products'}`;
---
<Layout title="Products" description="Traffic cones, barricades, WATERCADE barriers, drums, signs, lights, reflectors and safety gear. Buy online with nationwide shipping, or rent in NJ, NY, PA and CT.">
  <section class="chead">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Products</span></nav>
      <h1>Products</h1>
      <p class="lede">Everything your work zone needs, straight from our yard.</p>
    </div>
  </section>

  <div class="perks" role="list">
    <div class="wrap perks__in">
      <p role="listitem"><svg viewBox="0 0 24 24"><rect x="2.5" y="6.5" width="13" height="11" rx="1.5"/><path d="M15.5 10h3.4l2.6 3.4v4.1h-6z M7 20.6a1.9 1.9 0 1 0 0-.01 M17.6 20.6a1.9 1.9 0 1 0 0-.01"/></svg><b>Ships nationwide</b><span>from South Plainfield, NJ</span></p>
      <p role="listitem"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4z M4 10h16 M8 15h5"/></svg><b>Net terms &amp; POs</b><span>for agencies and contractors</span></p>
      <p role="listitem"><svg viewBox="0 0 24 24"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z M12 12l8-4.5 M12 12v9 M12 12L4 7.5"/></svg><b>Bulk &amp; pallet pricing</b><span>ask for a volume quote</span></p>
      <p role="listitem"><svg viewBox="0 0 24 24"><path d="M3 17V7l4 3 5-6 5 6 4-3v10z M3 17h18v2.5H3z"/></svg><b>Everything rents too</b><span>in NJ, NY, PA and CT</span></p>
    </div>
  </div>

  <section class="wrap merch">
    <div class="bento">
      {feature && (
        <a href="/collections/cones" class="cat cat--feature reveal" style={`--tint:${tints.cones}`}>
          <span class="cat__img">{feature.cover && <img src={img(feature.cover.url, 760)} alt="" loading="eager" />}</span>
          <span class="cat__body">
            <span class="cat__t">Cones</span>
            <span class="cat__d">{blurbs.cones}. Custom colors and logos for towns, utilities and events.</span>
            <span class="cat__links">
              {coneLinks.map((l) => <span class="chip">{l.label}</span>)}
            </span>
            <span class="cat__n">{count(feature)}<svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </span>
        </a>
      )}
      {[...rowA, ...rowB].map((c, i) => (
        <a href={`/collections/${c.handle}`} class="cat reveal" style={`--tint:${tints[c.handle] || '#f6f6f4'};--d:${i * 60}ms`}>
          <span class="cat__img">{c.cover && <img src={img(c.cover.url, 440)} alt="" loading="eager" />}</span>
          <span class="cat__body">
            <span class="cat__t">{c.title}</span>
            <span class="cat__d">{blurbs[c.handle] || ''}</span>
            <span class="cat__n">{count(c)}<svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </span>
        </a>
      ))}

      <a href="/watercade/" class="wcband reveal">
        <img class="wcband__photo" data-parallax=".1" src={img('https://cdn.shopify.com/s/files/1/0587/7701/0241/files/Water-Filled-Barricades-In-Use-3-1.png', 1600)} alt="" loading="lazy" />
        <span class="wcband__shade" aria-hidden="true"></span>
        <span class="wcband__body">
          <img class="wcband__logo" src="/watercade/logo-white.png" alt="WATERCADE" width="1932" height="237" loading="lazy" />
          <span class="wcband__copy">Our own MASH TL-3 crash-tested water-filled barrier. Build yours in 3D, buy it, or rent it by the job.</span>
          <span class="wcband__cta btn btn--sm">Explore WATERCADE</span>
        </span>
        <span class="wcband__badge" aria-hidden="true">MASH TL-3<br /><small>crash tested</small></span>
      </a>

      {rowC.map((c, i) => (
        <a href={`/collections/${c.handle}`} class="cat reveal" style={`--tint:${tints[c.handle] || '#f6f6f4'};--d:${i * 60}ms`}>
          <span class="cat__img">{c.cover && <img src={img(c.cover.url, 440)} alt="" loading="lazy" />}</span>
          <span class="cat__body">
            <span class="cat__t">{c.title}</span>
            <span class="cat__d">{blurbs[c.handle] || ''}</span>
            <span class="cat__n">{count(c)}<svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </span>
        </a>
      ))}

      {last && (
        <a href={`/collections/${last.handle}`} class="cat reveal" style={`--tint:${tints.deliniators}`}>
          <span class="cat__img">{last.cover && <img src={img(last.cover.url, 440)} alt="" loading="lazy" />}</span>
          <span class="cat__body">
            <span class="cat__t">{last.title}</span>
            <span class="cat__d">{blurbs.deliniators}</span>
            <span class="cat__n">{count(last)}<svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </span>
        </a>
      )}

      <a href="/pages/custom-stenciling" class="brand reveal">
        <span class="brand__body">
          <span class="brand__k">Custom shop</span>
          <span class="brand__t">Your logo on it</span>
          <span class="brand__d">Colors, logos and stenciling on cones, drums, barriers and signs — from our in-house sign shop. Preview yours in 3D.</span>
          <span class="brand__cta btn btn--sm">Start a custom order</span>
        </span>
        <span class="brand__art" aria-hidden="true">
          <svg viewBox="0 0 160 190">
            <ellipse cx="80" cy="176" rx="62" ry="10" fill="#000" opacity=".25"/>
            <rect x="18" y="160" width="124" height="16" rx="5" fill="#2a2f34"/>
            <path d="M68 18 Q80 8 92 18 L128 162 L32 162 Z" fill="#f26a1b"/>
            <path d="M60.5 48 L99.5 48 L104 66 L56 66 Z" fill="#f4f6f8"/>
            <path d="M48 98 L112 98 L117 120 L43 120 Z" fill="#fff"/>
            <text x="80" y="114" text-anchor="middle" font-family="Archivo, sans-serif" font-size="15" font-weight="800" fill="#b60606">YOUR LOGO</text>
          </svg>
        </span>
      </a>
    </div>
  </section>

  <section class="wrap best">
    <div class="row-head reveal">
      <h2>Most ordered by crews</h2>
      <a class="textlink" href="/collections/safety-products">Shop all products</a>
    </div>
    <div class="grid best__grid">
      {best.map((p, i) => <div class="reveal" style={`--d:${i * 60}ms`}><ProductCard p={p} /></div>)}
    </div>
  </section>

  <section class="wrap xbands">
    <div class="xband reveal">
      <div>
        <h2>Need trucks or powered equipment?</h2>
        <p>Crash trucks, arrow boards, VMS boards, light towers and the rest of the fleet live under Rentals.</p>
      </div>
      <a class="btn btn--dark" href="/collections/equipment-rentals">See the rental fleet</a>
    </div>
    <div class="xband reveal" style="--d:80ms">
      <div>
        <h2>Not sure what the job calls for?</h2>
        <p>Tell Conner the road, speed and dates, or lay the whole zone out with the work zone builder.</p>
      </div>
      <div class="xband__cta">
        <button class="btn" data-ask-conner>Ask Conner</button>
        <a class="btn btn--ghost" href="/tools/work-zone-builder">Work zone builder</a>
      </div>
    </div>
  </section>
  <QuickView />
</Layout>
<script>
  document.querySelector('[data-ask-conner]')?.addEventListener('click', () => window.TSSChat?.ask('Can you help me figure out which traffic control products I need for my job?'));
</script>
<style>
  .chead { background: var(--haze); border-bottom: 1px solid var(--line); padding: 38px 0 42px; }
  .crumbs { display: flex; gap: 8px; font-size: .92rem; color: var(--steel); margin-bottom: 14px; }
  .crumbs a { color: inherit; }
  .chead .lede { margin: 10px 0 0; max-width: 60ch; }

  .perks { border-bottom: 1px solid var(--line); background: #fff; }
  .perks__in { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding-block: 16px; }
  .perks p { margin: 0; display: flex; align-items: center; gap: 11px; font-size: .88rem; color: var(--steel); line-height: 1.25; min-width: 0; }
  .perks svg { width: 26px; height: 26px; flex: none; fill: none; stroke: var(--red); stroke-width: 1.7; stroke-linejoin: round; stroke-linecap: round; }
  .perks b { color: var(--ink); font-variation-settings: 'wght' 670; display: block; white-space: nowrap; }
  .perks p > b + span { display: block; }
  .perks p { display: grid; grid-template-columns: auto 1fr; }
  .perks svg { grid-row: span 2; align-self: center; }

  .merch { padding-top: 34px; }
  .bento { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .cat { display: grid; grid-template-rows: auto 1fr; background: #fff; border: 1px solid var(--line); border-radius: var(--r-l); overflow: hidden; text-decoration: none; transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease; }
  .cat:hover { border-color: var(--line-dark); box-shadow: var(--shadow-m); transform: translateY(-2px); }
  .cat__img { position: relative; aspect-ratio: 10/7; background: radial-gradient(120% 120% at 50% 108%, var(--tint, #f6f6f4) 0%, #ffffff 78%); border-bottom: 1px solid var(--haze-2); }
  .cat__img img { position: absolute; inset: 18px; width: calc(100% - 36px); height: calc(100% - 36px); object-fit: contain; filter: drop-shadow(0 14px 12px rgba(20, 23, 26, .13)); transition: transform .25s ease; }
  .cat:hover .cat__img img { transform: scale(1.06) rotate(-.5deg); }
  .cat__body { display: grid; grid-template-rows: 1.5em 2.45em 1.6em; gap: 4px; padding: 15px 18px 13px; align-items: start; }
  .cat__t { font-variation-settings: 'wght' 700; font-size: 1.04rem; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cat:hover .cat__t { color: var(--red); }
  .cat__d { color: var(--steel); font-size: .88rem; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .cat__n { display: flex; align-items: center; align-self: end; gap: 5px; color: var(--steel); font-size: .85rem; font-variation-settings: 'wght' 600; }
  .cat__n svg { width: 13px; height: 13px; transition: translate .15s ease; }
  .cat:hover .cat__n { color: var(--red); }
  .cat:hover .cat__n svg { translate: 3px 0; }

  .cat--feature { grid-column: span 2; grid-row: span 2; }
  .cat--feature .cat__img { aspect-ratio: auto; min-height: 0; }
  .cat--feature { grid-template-rows: 1fr auto; }
  .cat--feature .cat__img img { inset: 26px; width: calc(100% - 52px); height: calc(100% - 52px); }
  .cat--feature .cat__body { grid-template-rows: auto auto auto 1.6em; padding: 18px 22px 15px; }
  .cat--feature .cat__t { font-size: 1.45rem; }
  .cat--feature .cat__d { font-size: .95rem; -webkit-line-clamp: 2; }
  .cat__links { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 2px; }
  .chip { display: inline-block; padding: 6px 11px 5px; border: 1px solid var(--line-dark); border-radius: 999px; font-size: .82rem; font-variation-settings: 'wght' 620; color: var(--ink-2); background: #fff; }
  .cat--feature:hover .chip { border-color: var(--ink-2); }

  /* WATERCADE photo banner */
  .wcband { position: relative; grid-column: 1 / -1; display: flex; align-items: center; min-height: 210px; border-radius: var(--r-l); overflow: hidden; text-decoration: none; color: #fff; box-shadow: var(--shadow-m); }
  .wcband__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; transition: transform .4s ease; }
  .wcband:hover .wcband__photo { transform: scale(1.03); }
  .wcband__shade { position: absolute; inset: 0; background: linear-gradient(92deg, rgba(8, 27, 61, .92) 0%, rgba(8, 27, 61, .62) 48%, rgba(8, 27, 61, .12) 100%); }
  .wcband__body { position: relative; display: grid; gap: 10px; padding: 28px clamp(22px, 3vw, 40px); max-width: 560px; justify-items: start; }
  .wcband__logo { width: clamp(190px, 22vw, 260px); height: auto; }
  .wcband__copy { font-size: .97rem; line-height: 1.5; color: #dde6f2; text-shadow: 0 1px 8px rgba(0, 0, 0, .4); }
  .wcband__badge { position: absolute; right: clamp(18px, 3vw, 36px); top: 50%; translate: 0 -50%; text-align: center; background: rgba(255, 255, 255, .12); border: 1px solid rgba(255, 255, 255, .35); backdrop-filter: blur(6px); border-radius: 12px; padding: 12px 18px 10px; font-variation-settings: 'wght' 740; letter-spacing: .02em; line-height: 1.2; }
  .wcband__badge small { font-variation-settings: 'wght' 500; font-size: .78rem; color: #dde6f2; }

  /* custom branding promo */
  .brand { grid-column: span 3; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; background: linear-gradient(135deg, #1e2227, #15181c); color: #fff; border-radius: var(--r-l); overflow: hidden; text-decoration: none; box-shadow: var(--shadow-m); transition: transform .15s ease, box-shadow .15s ease; }
  .brand:hover { transform: translateY(-2px); box-shadow: var(--shadow-l); }
  .brand__body { display: grid; gap: 8px; padding: 26px clamp(22px, 3vw, 36px); justify-items: start; }
  .brand__k { color: var(--gold); font-size: .85rem; font-variation-settings: 'wght' 700; letter-spacing: .03em; }
  .brand__t { font-size: var(--fs-3); font-variation-settings: 'wght' 740; letter-spacing: -.015em; }
  .brand__d { color: #b9c0c7; font-size: .93rem; line-height: 1.5; max-width: 46ch; }
  .brand__cta { margin-top: 6px; }
  .brand__art { padding: 14px 26px 0 0; }
  .brand__art svg { width: clamp(100px, 10vw, 140px); height: auto; }

  .best { padding-block: clamp(44px, 5.5vw, 64px) 0; }
  .best__grid > .reveal { display: grid; }
  .row-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 24px; flex-wrap: wrap; }
  .best__grid { grid-template-columns: repeat(5, 1fr); }

  .xbands { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-block: clamp(48px, 6vw, 72px) clamp(64px, 8vw, 110px); }
  .xband { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; background: var(--haze); border: 1px solid var(--line); border-radius: var(--r-l); padding: 28px 30px; }
  .xband h2 { font-size: var(--fs-2); margin-bottom: 6px; }
  .xband p { margin: 0; color: var(--steel); font-size: .97rem; max-width: 44ch; }
  .xband__cta { display: flex; gap: 10px; flex-wrap: wrap; }

  @media (max-width: 1180px) {
    .bento { grid-template-columns: repeat(3, 1fr); }
    .brand { grid-column: 1 / -1; }
    .best__grid { grid-template-columns: repeat(4, 1fr); }
    .perks__in { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 920px) {
    .bento { grid-template-columns: repeat(2, 1fr); }
    .best__grid { grid-template-columns: repeat(3, 1fr); }
    .xbands { grid-template-columns: 1fr; }
    .wcband__badge { display: none; }
  }
  @media (max-width: 640px) {
    .bento { gap: 12px; }
    .cat--feature { grid-column: span 2; }
    .best__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .cat__img img { inset: 14px; width: calc(100% - 28px); height: calc(100% - 28px); }
    .brand { grid-template-columns: 1fr; }
    .brand__art { display: none; }
    .perks__in { grid-template-columns: 1fr 1fr; gap: 10px; }
    .perks p > b + span { display: none; }
  }
</style>
