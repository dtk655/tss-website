---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuickView from '../../components/QuickView.astro';
import RecentlyViewed from '../../components/RecentlyViewed.astro';
import { loadCatalog, PRODUCT_COLLECTIONS, RENTAL_COLLECTIONS, money } from '../../lib/shopify.js';
import { CATEGORY_META } from '../../lib/categories.js';

export async function getStaticPaths() {
  const { collections } = await loadCatalog();
  return collections.map((c) => ({ params: { handle: c.handle }, props: { handle: c.handle } }));
}
const { handle } = Astro.props;
const { colByHandle, collections } = await loadCatalog();
const c = colByHandle.get(handle);
const rentalOnly = c.products.every((p) => p.isRental);
const hasRentals = c.products.some((p) => p.isRental);
const hasBuys = c.products.some((p) => !p.isRental);
const buys = c.products.filter((p) => !p.isRental);
const maxPrice = Math.ceil(Math.max(0, ...buys.map((p) => p.maxPrice)));
const navCols = PRODUCT_COLLECTIONS.map((h) => colByHandle.get(h)).filter(Boolean);
const rentalCols = RENTAL_COLLECTIONS.map((h) => colByHandle.get(h)).filter(Boolean);
const desc = c.description || (rentalOnly
  ? 'Delivered, set up and picked up across NJ, NY, PA and CT. Request a quote for daily, weekly or monthly rates.'
  : 'Buy online and we ship anywhere in the U.S., or rent in NJ, NY, PA and CT.');
const meta = CATEGORY_META[handle] || { tint: '#ececea', img: '', line: '', sub: '' };
const isRentalCol = RENTAL_COLLECTIONS.includes(handle);
const minPrice = buys.length ? Math.min(...buys.map((p) => p.minPrice)) : 0;
const facts = [
  `${c.products.length} ${c.products.length === 1 ? 'product' : 'products'}`,
  !rentalOnly && minPrice > 0 && `From ${money(minPrice)}`,
  !isRentalCol && 'Ships nationwide',
  'Rent in NJ, NY, PA, CT'
].filter(Boolean);
const allCols = [...PRODUCT_COLLECTIONS, ...RENTAL_COLLECTIONS].map((h) => colByHandle.get(h)).filter(Boolean);
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Layout title={c.title} description={`${c.title} from Traffic Safety Service. ${desc}`}>
  <section class="ch" style={`--tint:${meta.tint}`}>
    <div class="wrap ch__in">
      <div class="ch__copy">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={isRentalCol ? (meta.page || '/pages/equipment') : '/collections'}>{isRentalCol ? 'Rentals' : 'Products'}</a><span aria-hidden="true">/</span><span aria-current="page">{c.title}</span></nav>
        <h1><span class="ch__ln"><span>{c.title}</span></span>{meta.line && <span class="ch__ln ch__ln--sub"><span>{meta.line}</span></span>}</h1>
        <p class="ch__lede">{meta.sub ? `${meta.sub}. ` : ''}{desc}</p>
        <ul class="ch__facts">{facts.map((f) => <li>{f}</li>)}</ul>
        <div class="ch__acts">
          <a href="#shop" class="ch__btn ch__btn--solid">{rentalOnly ? 'See the lineup' : 'Shop ' + c.title.toLowerCase()}<Fragment set:html={ARROW} /></a>
          <a href={`/pages/request-a-quote?type=${rentalOnly ? 'rental' : 'products'}`} class="ch__btn ch__btn--line">{rentalOnly ? 'Get rental pricing' : 'Get bulk pricing'}</a>
          {meta.page && <a href={meta.page} class="ch__more">Learn more</a>}
        </div>
      </div>
      {meta.img && <div class="ch__art" aria-hidden="true"><span class="ch__glow"></span><img src={meta.img} alt="" /></div>}
    </div>
  </section>

  <nav class="cchips" aria-label="Categories">
    <div class="cchips__in">
      {allCols.map((n) => <a href={`/collections/${n.handle}`} aria-current={n.handle === handle ? 'page' : undefined}>{n.title}</a>)}
    </div>
  </nav>

  <div class="wrap shop" data-shop id="shop">
    <aside class="side">
      <nav class="side__nav" aria-label="Categories">
        <h2>Products</h2>
        {navCols.map((n) => <a href={`/collections/${n.handle}`} aria-current={n.handle === handle ? 'page' : undefined}>{n.title}<span>{n.products.length}</span></a>)}
        <h2 class="side__h2gap">Rentals</h2>
        {rentalCols.map((n) => <a href={`/collections/${n.handle}`} aria-current={n.handle === handle ? 'page' : undefined}>{n.title}<span>{n.products.length}</span></a>)}
      </nav>
      <details class="side__filters" open>
        <summary><h2>Filter</h2><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></summary>
        <div class="side__fbody">
          {hasBuys && hasRentals && (
            <fieldset class="f-group">
              <legend>Purchase type</legend>
              <label class="f-check"><input type="checkbox" data-f-buy checked /> <span>Buy online</span></label>
              <label class="f-check"><input type="checkbox" data-f-rent checked /> <span>Rental, by quote</span></label>
            </fieldset>
          )}
          {hasBuys && maxPrice > 0 && (
            <fieldset class="f-group">
              <legend>Price</legend>
              <div class="f-price">
                <label><span class="sr-only">Minimum price</span><input type="number" min="0" max={maxPrice} placeholder="0" data-f-min inputmode="numeric" /></label>
                <span aria-hidden="true">to</span>
                <label><span class="sr-only">Maximum price</span><input type="number" min="0" max={maxPrice} placeholder={String(maxPrice)} data-f-max inputmode="numeric" /></label>
              </div>
              <p class="hint">Up to {money(maxPrice)} in this category</p>
            </fieldset>
          )}
          <button class="btn btn--ghost btn--sm" data-f-clear hidden>Clear filters</button>
        </div>
      </details>
      {!rentalOnly && (
        <div class="side__note">
          <p><strong>Need it for one job?</strong> Everything here can be rented in NJ, NY, PA and CT.</p>
          <a class="textlink" href="/tools/rent-vs-buy">Compare renting and buying</a>
        </div>
      )}
    </aside>

    <div class="main">
      <div class="toolbar__sentinel" data-tb-sentinel aria-hidden="true"></div>
      <div class="toolbar" data-toolbar>
        <p class="toolbar__count" aria-live="polite"><span data-count>{c.products.length}</span> {c.products.length === 1 ? 'product' : 'products'}</p>
        <div class="toolbar__right">
          <label class="sort">Sort
            <select data-sort>
              <option value="featured">Featured</option>
              <option value="price-asc">Price, low to high</option>
              <option value="price-desc">Price, high to low</option>
              <option value="title">Name, A to Z</option>
            </select>
          </label>
          <div class="density" role="group" aria-label="Grid size">
            <button data-cols="3" aria-pressed="false" aria-label="Larger tiles"><svg viewBox="0 0 24 24"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg></button>
            <button data-cols="4" aria-pressed="true" aria-label="Smaller tiles"><svg viewBox="0 0 24 24"><path d="M4 4h4.5v4.5H4zM9.75 4h4.5v4.5h-4.5zM15.5 4H20v4.5h-4.5zM4 9.75h4.5v4.5H4zM9.75 9.75h4.5v4.5h-4.5zM15.5 9.75H20v4.5h-4.5zM4 15.5h4.5V20H4zM9.75 15.5h4.5V20h-4.5zM15.5 15.5H20V20h-4.5z"/></svg></button>
          </div>
        </div>
      </div>
      <div class="grid grid--cols4" data-grid>
        {c.products.map((p, i) => <div class="cell" data-i={i} style={`--d:${(i % 8) * 45}ms`}><ProductCard p={p} /></div>)}
      </div>
      <p class="noresults" data-noresults hidden>No products match these filters. <button class="textlink" data-f-clear2>Clear the filters</button> or <a class="textlink" href="/pages/request-a-quote">ask us for a quote</a>.</p>
    </div>
  </div>
  <RecentlyViewed />
  <QuickView />
</Layout>

<script>
  const root = document.querySelector('[data-shop]');
  const grid = root.querySelector('[data-grid]');
  const cells = [...grid.children];
  const countEl = root.querySelector('[data-count]');
  const noRes = root.querySelector('[data-noresults]');
  const fBuy = root.querySelector('[data-f-buy]');
  const fRent = root.querySelector('[data-f-rent]');
  const fMin = root.querySelector('[data-f-min]');
  const fMax = root.querySelector('[data-f-max]');
  const clearBtns = [root.querySelector('[data-f-clear]'), root.querySelector('[data-f-clear2]')].filter(Boolean);

  const card = (cell) => cell.querySelector('.pcard');
  const apply = () => {
    const min = parseFloat(fMin?.value) || 0;
    const max = parseFloat(fMax?.value) || Infinity;
    let n = 0;
    for (const cell of cells) {
      const pc = card(cell);
      const rental = pc.dataset.rental === '1';
      const price = parseFloat(pc.dataset.price);
      let ok = true;
      if (fBuy && fRent) {
        if (rental && !fRent.checked) ok = false;
        if (!rental && !fBuy.checked) ok = false;
      }
      if (ok && !rental && (price < min || price > max)) ok = false;
      cell.hidden = !ok;
      if (ok) n++;
    }
    countEl.textContent = n;
    noRes.hidden = n > 0;
    const active = (fBuy && !fBuy.checked) || (fRent && !fRent.checked) || fMin?.value || fMax?.value;
    clearBtns.forEach((b) => { if (b.dataset.fClear !== undefined || b === clearBtns[0]) b.hidden = !active; });
  };
  [fBuy, fRent].forEach((el) => el?.addEventListener('change', apply));
  [fMin, fMax].forEach((el) => el?.addEventListener('input', () => { clearTimeout(el._t); el._t = setTimeout(apply, 250); }));
  clearBtns.forEach((b) => b.addEventListener('click', () => {
    if (fBuy) fBuy.checked = true; if (fRent) fRent.checked = true;
    if (fMin) fMin.value = ''; if (fMax) fMax.value = '';
    apply();
  }));

  root.querySelector('[data-sort]')?.addEventListener('change', (e) => {
    const v = e.target.value;
    const key = {
      featured: (a, b) => a.dataset.i - b.dataset.i,
      'price-asc': (a, b) => (parseFloat(card(a).dataset.price) || 9e9) - (parseFloat(card(b).dataset.price) || 9e9),
      'price-desc': (a, b) => (parseFloat(card(b).dataset.price) || 0) - (parseFloat(card(a).dataset.price) || 0),
      title: (a, b) => card(a).dataset.title.localeCompare(card(b).dataset.title)
    }[v];
    [...cells].sort(key).forEach((el) => grid.appendChild(el));
  });

  root.querySelectorAll('[data-cols]').forEach((b) => b.addEventListener('click', () => {
    grid.classList.toggle('grid--cols3', b.dataset.cols === '3');
    grid.classList.toggle('grid--cols4', b.dataset.cols === '4');
    root.querySelectorAll('[data-cols]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  }));

  // phones: start with the filters collapsed so products show first
  if (matchMedia('(max-width: 920px)').matches) root.querySelector('.side__filters')?.removeAttribute('open');

  // frosted sticky state for the toolbar
  const tb = root.querySelector('[data-toolbar]');
  const sentinel = root.querySelector('[data-tb-sentinel]');
  if (tb && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => tb.classList.toggle('is-stuck', !e.isIntersecting), { rootMargin: '-80px 0px 0px 0px' }).observe(sentinel);
  }
</script>

<style>
  /* ---------- category header ---------- */
  .ch { position: relative; overflow: hidden; background: linear-gradient(180deg, var(--tint) 0%, color-mix(in srgb, var(--tint) 45%, #fff) 100%); border-bottom: 1px solid var(--line); }
  .ch__in { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); align-items: center; gap: clamp(20px, 4vw, 60px); min-height: clamp(300px, 26vw, 400px); padding-block: clamp(26px, 3vw, 44px); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: .9rem; color: var(--ink-2); margin: 0 0 18px; }
  .crumbs a { color: inherit; text-underline-offset: 3px; }
  .ch h1 { margin: 0 0 14px; font-size: clamp(2.6rem, 5.4vw, 5rem); line-height: .98; letter-spacing: -.045em; font-variation-settings: 'wght' 790; font-weight: 400; }
  .ch__ln { display: block; overflow: hidden; padding-bottom: .06em; }
  .ch__ln > span { display: inline-block; animation: chRise .9s cubic-bezier(.2, .8, .2, 1) backwards; }
  .ch__ln--sub { font-size: .52em; letter-spacing: -.03em; margin-top: .12em; }
  .ch__ln--sub > span { color: var(--red); animation-delay: .1s; }
  .ch__lede { margin: 0 0 18px; max-width: 58ch; color: var(--ink-2); font-size: clamp(1rem, 1.15vw, 1.12rem); line-height: 1.55; animation: chUp .8s .3s cubic-bezier(.2, .8, .2, 1) backwards; }
  .ch__facts { list-style: none; margin: 0 0 22px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; animation: chUp .8s .4s cubic-bezier(.2, .8, .2, 1) backwards; }
  .ch__facts li { padding: 7px 13px 6px; border-radius: 999px; background: rgba(255, 255, 255, .78); border: 1px solid rgba(20, 23, 26, .08); font-size: .86rem; font-variation-settings: 'wght' 640; color: var(--ink); }
  .ch__acts { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; animation: chUp .8s .5s cubic-bezier(.2, .8, .2, 1) backwards; }
  .ch__btn { display: inline-flex; align-items: center; gap: 10px; min-height: 50px; padding: 0 24px; border-radius: 999px; font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, border-color .2s, color .2s; }
  .ch__btn :global(svg) { width: 17px; height: 17px; transition: transform .2s; }
  .ch__btn:hover :global(svg) { transform: translateX(3px); }
  .ch__btn--solid { background: var(--red); color: #fff; }
  .ch__btn--solid:hover { background: #d10a0a; }
  .ch__btn--line { border: 1.5px solid rgba(20, 23, 26, .25); color: var(--ink); background: rgba(255, 255, 255, .5); }
  .ch__btn--line:hover { border-color: var(--ink); background: #fff; }
  .ch__more { color: var(--ink); font-variation-settings: 'wght' 680; text-underline-offset: 3px; }
  .ch__art { position: relative; display: grid; place-items: center; height: 100%; min-height: 240px; }
  .ch__glow { position: absolute; width: 78%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, rgba(255, 255, 255, .95), rgba(255, 255, 255, 0)); }
  .ch__art img { position: relative; display: block; width: 100%; max-width: 380px; height: clamp(200px, 20vw, 320px); object-fit: contain; filter: drop-shadow(0 26px 22px rgba(20, 23, 26, .25)); animation: chArt 1s .15s cubic-bezier(.2, .8, .2, 1) backwards; }
  @keyframes chRise { from { transform: translateY(105%); } }
  @keyframes chUp { from { opacity: 0; transform: translateY(12px); } }
  @keyframes chArt { from { opacity: 0; transform: translateY(24px) scale(.94); } }
  @media (prefers-reduced-motion: reduce) { .ch__ln > span, .ch__lede, .ch__facts, .ch__acts, .ch__art img { animation: none; } }

  /* category chips (shown where the sidebar list is hidden) */
  .cchips { display: none; border-bottom: 1px solid var(--line); background: #fff; }
  .cchips__in { display: flex; gap: 8px; overflow-x: auto; padding: 12px var(--gutter); scrollbar-width: none; }
  .cchips__in::-webkit-scrollbar { display: none; }
  .cchips a { flex: none; padding: 9px 15px 8px; border-radius: 999px; border: 1.5px solid var(--line-dark); color: var(--ink-2); font-size: .9rem; font-variation-settings: 'wght' 620; text-decoration: none; white-space: nowrap; }
  .cchips a[aria-current] { background: var(--ink); border-color: var(--ink); color: #fff; }

  /* even cards: every tile in a row is the same height */
  .cell { display: grid; }
  .cell :global(.pcard) { height: 100%; }
  .cell :global(.pcard__media) { aspect-ratio: 5 / 4; padding: 14px; }
  .cell :global(.pcard__title) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.64em; }
  .shop { display: grid; grid-template-columns: 236px minmax(0, 1fr); gap: clamp(24px, 3vw, 44px); padding-block: 28px 80px; align-items: start; scroll-margin-top: 90px; }
  .side { position: sticky; top: calc(var(--header-h) + 18px); display: grid; gap: 22px; }
  .side h2 { font-size: 1.02rem; font-variation-settings: 'wght' 700; }
  .side__nav { display: grid; gap: 2px; }
  .side__nav h2 { margin-bottom: 8px; }
  .side__h2gap { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); }
  .side__nav a { display: flex; justify-content: space-between; gap: 10px; text-decoration: none; padding: 8px 10px 7px; border-radius: 7px; color: var(--ink-2); font-size: .96rem; }
  .side__nav a span { color: var(--steel); font-size: .85rem; }
  .side__nav a:hover { background: var(--haze); color: var(--ink); }
  .side__nav a[aria-current] { background: var(--haze); color: var(--ink); font-variation-settings: 'wght' 680; box-shadow: inset 3px 0 0 var(--red); }
  .side__filters { border-top: 1px solid var(--line); padding-top: 16px; }
  .side__filters summary { list-style: none; display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
  .side__filters summary::-webkit-details-marker { display: none; }
  .side__filters summary svg { width: 18px; height: 18px; transition: rotate .15s; }
  .side__filters[open] summary svg { rotate: 180deg; }
  .side__fbody { display: grid; gap: 18px; padding-top: 14px; }
  .f-group { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }
  .f-group legend { font-variation-settings: 'wght' 640; font-size: .92rem; color: var(--steel); margin-bottom: 4px; }
  .f-check { display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: .97rem; }
  .f-check input { width: 18px; height: 18px; accent-color: var(--red); }
  .f-price { display: flex; align-items: center; gap: 8px; color: var(--steel); font-size: .9rem; }
  .f-price input { width: 100%; min-height: 42px; padding: 8px 10px; border: 1.5px solid var(--line-dark); border-radius: 7px; }
  .f-price input:focus { outline: none; border-color: var(--ink); }
  .hint { font-size: .85rem; color: var(--steel); margin: 0; }
  .side__note { border-top: 1px solid var(--line); padding-top: 16px; font-size: .95rem; }
  .side__note p { margin: 0 0 6px; color: var(--steel); }
  .side__note strong { color: var(--ink); }

  .toolbar__sentinel { height: 1px; }
  .toolbar { position: sticky; top: 74px; z-index: 6; display: flex; justify-content: space-between; align-items: center; gap: 16px; margin: 0 -10px 20px; padding: 10px; border-radius: var(--r-s); flex-wrap: wrap; transition: box-shadow .2s ease, background .2s ease; }
  .toolbar.is-stuck { background: rgba(255, 255, 255, .92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: 0 1px 0 var(--line), 0 14px 28px -22px rgba(20, 23, 26, .3); }
  .toolbar__count { margin: 0; color: var(--steel); font-size: .95rem; }
  .toolbar__right { display: flex; align-items: center; gap: 14px; }
  .sort { display: flex; align-items: center; gap: 10px; font-variation-settings: 'wght' 600; font-size: .95rem; }
  .sort select { min-height: 42px; padding: 8px 10px; border-radius: 7px; border: 1.5px solid var(--line-dark); background: #fff; }
  .density { display: flex; border: 1.5px solid var(--line-dark); border-radius: 7px; overflow: hidden; }
  .density button { width: 40px; height: 40px; display: grid; place-items: center; background: #fff; border: 0; cursor: pointer; color: var(--steel); }
  .density button[aria-pressed=true] { background: var(--ink); color: #fff; }
  .density svg { width: 17px; height: 17px; fill: currentColor; }
  .grid--cols3 { grid-template-columns: repeat(3, 1fr); }
  .grid--cols4 { grid-template-columns: repeat(4, 1fr); }
  @media (min-width: 1900px) { .grid--cols4 { grid-template-columns: repeat(5, 1fr); } }
  @media (min-width: 2400px) { .grid--cols4 { grid-template-columns: repeat(6, 1fr); } }
  .cell[hidden], .side [hidden] { display: none !important; }
  .noresults { margin: 48px 0; color: var(--steel); }
  .noresults button { background: none; border: 0; cursor: pointer; padding: 0; font: inherit; }

  @media (max-width: 1100px) { .grid--cols4 { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 920px) {
    .cchips { display: block; }
    .ch__in { grid-template-columns: minmax(0, 1fr) minmax(0, .6fr); }
    .shop { grid-template-columns: 1fr; }
    .side { position: static; grid-template-columns: 1fr 1fr; align-items: start; }
    .side__nav { display: none; }
    .side__filters { border-top: 0; padding-top: 0; }
    .side__filters:not([open]) { padding-bottom: 0; }
    .side__note { display: none; }
    .side__filters { border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
    .side__filters[open] { padding-bottom: 16px; }
  }
  @media (max-width: 720px) { .grid--cols4, .grid--cols3 { grid-template-columns: repeat(2, 1fr); gap: 12px; } .side { grid-template-columns: 1fr; } .density { display: none; } }
  @media (max-width: 640px) {
    .ch__in { grid-template-columns: 1fr; min-height: 0; gap: 0; padding-block: 18px 26px; }
    .ch__art { order: -1; min-height: 0; margin-bottom: 4px; }
    .ch__art img { height: 150px; }
    .crumbs { position: absolute; top: 14px; left: var(--gutter); margin: 0; font-size: .82rem; }
    .ch__in { padding-top: 44px; text-align: center; }
    .ch h1 { font-size: clamp(2.2rem, 11vw, 2.8rem); }
    .ch__lede { margin-inline: auto; font-size: .96rem; }
    .ch__facts, .ch__acts { justify-content: center; }
    .ch__btn { flex: 1 1 auto; justify-content: center; }
    .cell :global(.pcard__body) { padding: 12px 12px 14px; }
    .cell :global(.pcard__title) { font-size: .9rem; }
  }
</style>
