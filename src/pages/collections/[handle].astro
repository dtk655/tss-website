---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuickView from '../../components/QuickView.astro';
import RecentlyViewed from '../../components/RecentlyViewed.astro';
import { loadCatalog, PRODUCT_COLLECTIONS, RENTAL_COLLECTIONS, money } from '../../lib/shopify.js';
import { CATEGORY_META } from '../../lib/categories.js';

export async function getStaticPaths() {
  const { collections } = await loadCatalog();
  return collections.map((c) => ({ params: { handle: c.handle }, props: { handle: c.handle } }));
}
const { handle } = Astro.props;
const { colByHandle, collections } = await loadCatalog();
const c = colByHandle.get(handle);
const rentalOnly = c.products.every((p) => p.isRental);
const buys = c.products.filter((p) => !p.isRental);
const navCols = PRODUCT_COLLECTIONS.map((h) => colByHandle.get(h)).filter(Boolean);
const rentalCols = RENTAL_COLLECTIONS.map((h) => colByHandle.get(h)).filter(Boolean);
const desc = c.description || (rentalOnly
  ? 'Delivered, set up and picked up across NJ, NY, PA and CT. Request a quote for daily, weekly or monthly rates.'
  : 'Buy online and we ship anywhere in the U.S., or rent in NJ, NY, PA and CT.');
const meta = CATEGORY_META[handle] || { tint: '#ececea', img: '', line: '', sub: '' };
const isRentalCol = RENTAL_COLLECTIONS.includes(handle);
const minPrice = buys.length ? Math.min(...buys.map((p) => p.minPrice)) : 0;
const allCols = [...PRODUCT_COLLECTIONS, ...RENTAL_COLLECTIONS].map((h) => colByHandle.get(h)).filter(Boolean);
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Layout title={c.title} description={`${c.title} from Traffic Safety Service. ${desc}`}>
  <section class="ch" style={`--tint:${meta.tint}`}>
    <div class="wrap ch__in">
      <div class="ch__copy">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={isRentalCol ? (meta.page || '/pages/equipment') : '/collections'}>{isRentalCol ? 'Rentals' : 'Products'}</a><span aria-hidden="true">/</span><span aria-current="page">{c.title}</span></nav>
        <h1><span class="ch__ln"><span>{c.title}</span></span>{meta.line && <span class="ch__ln ch__ln--sub"><span>{meta.line}</span></span>}</h1>
        {meta.sub && <p class="ch__lede">{meta.sub}</p>}
        <div class="ch__acts">
          <a href="#shop" class="ch__btn ch__btn--solid">{rentalOnly ? 'See the lineup' : 'Shop ' + c.title.toLowerCase()}<Fragment set:html={ARROW} /></a>
          <a href={`/pages/request-a-quote?type=${rentalOnly ? 'rental' : 'products'}`} class="ch__btn ch__btn--line">{rentalOnly ? 'Get rental pricing' : 'Get bulk pricing'}</a>
          {meta.page && <a href={meta.page} class="ch__more">Learn more</a>}
        </div>
      </div>
      {meta.img && <div class="ch__art" aria-hidden="true"><span class="ch__glow"></span><img src={meta.img} alt="" /></div>}
    </div>
  </section>



  <div class="wrap shop" data-shop id="shop">
    <aside class="side">
      <nav class="side__nav" aria-label="Categories">
        <h2>Products</h2>
        {navCols.map((n) => <a href={`/collections/${n.handle}`} aria-current={n.handle === handle ? 'page' : undefined}>{n.title}<span>{n.products.length}</span></a>)}
        <h2 class="side__h2gap">Rentals</h2>
        {rentalCols.map((n) => <a href={`/collections/${n.handle}`} aria-current={n.handle === handle ? 'page' : undefined}>{n.title}<span>{n.products.length}</span></a>)}
      </nav>
      {!rentalOnly && (
        <div class="side__note">
          <p><strong>Need it for one job?</strong> Everything here can be rented in NJ, NY, PA and CT.</p>
          <a class="textlink" href="/tools/rent-vs-buy">Compare renting and buying</a>
        </div>
      )}
    </aside>

    <div class="main">
      <div class="toolbar__sentinel" data-tb-sentinel aria-hidden="true"></div>
      <div class="toolbar" data-toolbar>
        <button type="button" class="catbtn" data-catopen aria-haspopup="dialog">
          <span class="catbtn__img" style={`--tint:${meta.tint}`}>{meta.img && <img src={meta.img} alt="" />}</span>
          <span class="catbtn__t"><small>Category</small><b>{c.title}</b></span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <p class="toolbar__count" aria-live="polite"><span data-count>{c.products.length}</span> {c.products.length === 1 ? 'product' : 'products'}</p>
        <div class="toolbar__right">
          <label class="sort">Sort
            <select data-sort>
              <option value="featured">Featured</option>
              <option value="price-asc">Price, low to high</option>
              <option value="price-desc">Price, high to low</option>
              <option value="title">Name, A to Z</option>
            </select>
          </label>
          <div class="density" role="group" aria-label="Grid size">
            <button data-cols="3" aria-pressed="false" aria-label="Larger tiles"><svg viewBox="0 0 24 24"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg></button>
            <button data-cols="4" aria-pressed="true" aria-label="Smaller tiles"><svg viewBox="0 0 24 24"><path d="M4 4h4.5v4.5H4zM9.75 4h4.5v4.5h-4.5zM15.5 4H20v4.5h-4.5zM4 9.75h4.5v4.5H4zM9.75 9.75h4.5v4.5h-4.5zM15.5 9.75H20v4.5h-4.5zM4 15.5h4.5V20H4zM9.75 15.5h4.5V20h-4.5zM15.5 15.5H20V20h-4.5z"/></svg></button>
          </div>
        </div>
      </div>
      <div class="grid grid--cols4" data-grid>
        {c.products.map((p, i) => <div class="cell" data-i={i} style={`--d:${(i % 8) * 45}ms`}><ProductCard p={p} /></div>)}
        <div class="cell cell--ask" data-ask-tile>
          <a href="/pages/request-a-quote?type=general" class="ask">
            <span class="ask__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 16l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M9.3 9.4a1.9 1.9 0 1 1 2.6 1.8c-.6.3-.9.7-.9 1.3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="11" cy="14.3" r=".9" fill="currentColor"/></svg></span>
            <b>Don’t see what you’re looking for?</b>
            <span class="ask__d">Not everything we carry is listed online. Send us an inquiry and we’ll see if we can get it for you.</span>
            <span class="ask__btn">Send an inquiry<Fragment set:html={ARROW} /></span>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="csheet" hidden data-csheet>
    <div class="csheet__bg" data-catclose></div>
    <div class="csheet__panel" role="dialog" aria-modal="true" aria-label="Browse categories">
      <div class="csheet__head"><b>Browse categories</b><button type="button" class="csheet__x" data-catclose aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button></div>
      <div class="csheet__body">
        {[['Products', navCols], ['Rentals', rentalCols]].map(([lbl, list]) => (
          <>
            <p class="csheet__k">{lbl}</p>
            <div class="csheet__grid">
              {list.map((n) => {
                const m = CATEGORY_META[n.handle] || { tint: '#ececea', img: '' };
                return (
                  <a href={`/collections/${n.handle}`} class="csheet__tile" style={`--tint:${m.tint}`} aria-current={n.handle === handle ? 'page' : undefined}>
                    <span class="csheet__img">{m.img && <img src={m.img} alt="" loading="lazy" />}</span>
                    <b>{n.title}</b><small>{n.products.length} {n.products.length === 1 ? 'product' : 'products'}</small>
                  </a>
                );
              })}
            </div>
          </>
        ))}
      </div>
    </div>
  </div>
  <RecentlyViewed />
  <QuickView />
</Layout>

<script>
  const root = document.querySelector('[data-shop]');
  const grid = root.querySelector('[data-grid]');
  const cells = [...grid.children].filter((el) => !el.hasAttribute('data-ask-tile'));
  const card = (cell) => cell.querySelector('.pcard');

  root.querySelector('[data-sort]')?.addEventListener('change', (e) => {
    const v = e.target.value;
    const key = {
      featured: (a, b) => a.dataset.i - b.dataset.i,
      'price-asc': (a, b) => (parseFloat(card(a).dataset.price) || 9e9) - (parseFloat(card(b).dataset.price) || 9e9),
      'price-desc': (a, b) => (parseFloat(card(b).dataset.price) || 0) - (parseFloat(card(a).dataset.price) || 0),
      title: (a, b) => card(a).dataset.title.localeCompare(card(b).dataset.title)
    }[v];
    [...cells].sort(key).forEach((el) => grid.appendChild(el));
    const ask = grid.querySelector('[data-ask-tile]'); if (ask) grid.appendChild(ask);
  });

  root.querySelectorAll('[data-cols]').forEach((b) => b.addEventListener('click', () => {
    grid.classList.toggle('grid--cols3', b.dataset.cols === '3');
    grid.classList.toggle('grid--cols4', b.dataset.cols === '4');
    root.querySelectorAll('[data-cols]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  }));

  // phones: category sheet
  const sheet = document.querySelector('[data-csheet]');
  const openBtn = root.querySelector('[data-catopen]');
  const openSheet = () => { sheet.hidden = false; requestAnimationFrame(() => requestAnimationFrame(() => sheet.classList.add('is-open'))); document.documentElement.style.overflow = 'hidden'; const ch = document.getElementById('tss-chat-assistant'); if (ch) ch.style.visibility = 'hidden'; sheet.querySelector('[aria-current]')?.scrollIntoView({ block: 'center' }); sheet.querySelector('.csheet__x').focus({ preventScroll: true }); };
  const closeSheet = () => { if (sheet.hidden) return; sheet.classList.remove('is-open'); document.documentElement.style.overflow = ''; const ch = document.getElementById('tss-chat-assistant'); if (ch) ch.style.visibility = ''; setTimeout(() => { sheet.hidden = true; }, 300); openBtn?.focus({ preventScroll: true }); };
  openBtn?.addEventListener('click', openSheet);
  sheet.querySelectorAll('[data-catclose]').forEach((b) => b.addEventListener('click', closeSheet));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSheet(); });

  // keep the sticky toolbar just under the site header, whatever its height
  const hdr = document.querySelector('header');
  const setTop = () => root.style.setProperty('--tb-top', `${Math.round(hdr.getBoundingClientRect().height)}px`);
  if (hdr) { setTop(); if ('ResizeObserver' in window) new ResizeObserver(setTop).observe(hdr); addEventListener('resize', setTop); }

  // frosted sticky state for the toolbar
  const tb = root.querySelector('[data-toolbar]');
  const sentinel = root.querySelector('[data-tb-sentinel]');
  if (tb && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => tb.classList.toggle('is-stuck', !e.isIntersecting), { rootMargin: '-80px 0px 0px 0px' }).observe(sentinel);
  }
</script>

<style>
  /* ---------- category header ---------- */
  .ch { position: relative; overflow: hidden; background: linear-gradient(180deg, var(--tint) 0%, color-mix(in srgb, var(--tint) 45%, #fff) 100%); border-bottom: 1px solid var(--line); }
  .ch__in { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); align-items: center; gap: clamp(20px, 4vw, 60px); min-height: 0; padding-block: clamp(18px, 2vw, 28px); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: .88rem; color: var(--ink-2); margin: 0 0 10px; }
  .crumbs a { color: inherit; text-underline-offset: 3px; }
  .ch h1 { margin: 0 0 16px; font-size: clamp(2.3rem, 4.2vw, 3.9rem); line-height: .98; letter-spacing: -.045em; font-variation-settings: 'wght' 790; font-weight: 400; }
  .ch__ln { display: block; overflow: hidden; padding-bottom: .06em; }
  .ch__ln > span { display: inline-block; animation: chRise .9s cubic-bezier(.2, .8, .2, 1) backwards; }
  .ch__ln--sub { font-size: .52em; letter-spacing: -.03em; margin-top: .12em; }
  .ch__ln--sub > span { color: var(--red); animation-delay: .1s; }
  .ch__lede { margin: -4px 0 16px; max-width: 52ch; color: var(--ink-2); font-size: clamp(.98rem, 1.1vw, 1.08rem); line-height: 1.45; animation: chUp .8s .3s cubic-bezier(.2, .8, .2, 1) backwards; }
  @keyframes chUp { from { opacity: 0; transform: translateY(10px); } }
  .ch__acts { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; animation: chUp .8s .5s cubic-bezier(.2, .8, .2, 1) backwards; }
  .ch__btn { display: inline-flex; align-items: center; gap: 10px; min-height: 46px; padding: 0 22px; border-radius: 999px; font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, border-color .2s, color .2s; }
  .ch__btn :global(svg) { width: 17px; height: 17px; transition: transform .2s; }
  .ch__btn:hover :global(svg) { transform: translateX(3px); }
  .ch__btn--solid { background: var(--red); color: #fff; }
  .ch__btn--solid:hover { background: #d10a0a; }
  .ch__btn--line { border: 1.5px solid rgba(20, 23, 26, .25); color: var(--ink); background: rgba(255, 255, 255, .5); }
  .ch__btn--line:hover { border-color: var(--ink); background: #fff; }
  .ch__more { color: var(--ink); font-variation-settings: 'wght' 680; text-underline-offset: 3px; }
  .ch__art { position: relative; display: grid; place-items: center; height: 100%; }
  .ch__glow { position: absolute; width: 78%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, rgba(255, 255, 255, .95), rgba(255, 255, 255, 0)); }
  .ch__art img { position: relative; display: block; width: 100%; max-width: 380px; height: clamp(140px, 13vw, 200px); object-fit: contain; filter: drop-shadow(0 26px 22px rgba(20, 23, 26, .25)); animation: chArt 1s .15s cubic-bezier(.2, .8, .2, 1) backwards; }
  @keyframes chRise { from { transform: translateY(105%); } }
  @keyframes chUp { from { opacity: 0; transform: translateY(12px); } }
  @keyframes chArt { from { opacity: 0; transform: translateY(24px) scale(.94); } }
  @media (prefers-reduced-motion: reduce) { .ch__ln > span, .ch__acts, .ch__art img { animation: none; } }
  @media (max-width: 360px) { .ch__acts { flex-wrap: wrap !important; } }


  /* even cards: every tile in a row is the same height */
  .cell { display: grid; }
  .cell :global(.pcard) { height: 100%; }
  .cell :global(.pcard__media) { aspect-ratio: 5 / 4; padding: 14px; }
  .cell :global(.pcard__title) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.64em; }
  .shop { display: grid; grid-template-columns: 236px minmax(0, 1fr); gap: clamp(24px, 3vw, 44px); padding-block: 28px 80px; align-items: start; scroll-margin-top: 90px; }
  .side { position: sticky; top: calc(var(--header-h) + 18px); display: grid; gap: 22px; }
  .side h2 { font-size: 1.02rem; font-variation-settings: 'wght' 700; }
  .side__nav { display: grid; gap: 2px; }
  .side__nav h2 { margin-bottom: 8px; }
  .side__h2gap { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); }
  .side__nav a { display: flex; justify-content: space-between; gap: 10px; text-decoration: none; padding: 8px 10px 7px; border-radius: 7px; color: var(--ink-2); font-size: .96rem; }
  .side__nav a span { color: var(--steel); font-size: .85rem; }
  .side__nav a:hover { background: var(--haze); color: var(--ink); }
  .side__nav a[aria-current] { background: var(--haze); color: var(--ink); font-variation-settings: 'wght' 680; box-shadow: inset 3px 0 0 var(--red); }
  .side__note { border-top: 1px solid var(--line); padding-top: 16px; font-size: .95rem; }
  .side__note p { margin: 0 0 6px; color: var(--steel); }
  .side__note strong { color: var(--ink); }

  .toolbar__sentinel { height: 1px; }
  .toolbar { position: sticky; top: var(--tb-top, 74px); z-index: 6; display: flex; justify-content: space-between; align-items: center; gap: 16px; margin: 0 -10px 20px; padding: 10px; border-radius: var(--r-s); flex-wrap: wrap; transition: box-shadow .2s ease, background .2s ease; }
  .toolbar.is-stuck { background: rgba(255, 255, 255, .92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: 0 1px 0 var(--line), 0 14px 28px -22px rgba(20, 23, 26, .3); }
  .catbtn { display: none; align-items: center; gap: 10px; min-width: 0; flex: 1; padding: 6px 12px 6px 6px; border: 1.5px solid var(--line-dark); border-radius: 14px; background: #fff; font: inherit; color: var(--ink); cursor: pointer; text-align: left; }
  .catbtn__img { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: linear-gradient(185deg, var(--tint), #fff); }
  .catbtn__img img { width: 32px; height: 32px; object-fit: contain; }
  .catbtn__t { display: grid; min-width: 0; line-height: 1.15; }
  .catbtn__t small { font-size: .72rem; color: var(--steel); letter-spacing: .06em; text-transform: uppercase; font-variation-settings: 'wght' 650; }
  .catbtn__t b { font-size: 1rem; font-variation-settings: 'wght' 720; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .catbtn svg { flex: none; width: 18px; height: 18px; margin-left: auto; }
  .csheet { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: end stretch; }
  .csheet[hidden] { display: none; }
  .csheet__bg { position: absolute; inset: 0; background: rgba(12, 13, 15, .55); backdrop-filter: blur(6px); opacity: 0; transition: opacity .3s; }
  .csheet__panel { position: relative; max-height: 86svh; display: grid; grid-template-rows: auto minmax(0, 1fr); background: #fff; border-radius: 22px 22px 0 0; transform: translateY(100%); transition: transform .4s cubic-bezier(.2, .8, .2, 1); }
  .csheet.is-open .csheet__bg { opacity: 1; }
  .csheet.is-open .csheet__panel { transform: none; }
  .csheet__head { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 20px 18px 12px; border-bottom: 1px solid var(--line); }
  .csheet__head::before { content: ''; position: absolute; top: 7px; left: 50%; translate: -50% 0; width: 40px; height: 4px; border-radius: 4px; background: var(--line-dark); }
  .csheet__head b { font-size: 1.15rem; font-variation-settings: 'wght' 760; }
  .csheet__x { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: #fff; color: var(--ink); cursor: pointer; }
  .csheet__x svg { width: 18px; height: 18px; }
  .csheet__body { overflow-y: auto; overscroll-behavior: contain; padding: 6px 16px calc(20px + env(safe-area-inset-bottom)); }
  .csheet__k { margin: 14px 0 8px; font-size: .74rem; letter-spacing: .16em; text-transform: uppercase; color: var(--steel); font-variation-settings: 'wght' 700; }
  .csheet__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .csheet__tile { display: grid; gap: 2px; padding: 10px 12px 12px; border-radius: 14px; border: 1.5px solid transparent; background: linear-gradient(185deg, var(--tint), #fff 80%) border-box; text-decoration: none; color: var(--ink); }
  .csheet__tile[aria-current] { border-color: var(--red); }
  .csheet__img { display: grid; place-items: center; height: 70px; margin-bottom: 4px; }
  .csheet__img img { width: 100%; height: 66px; object-fit: contain; filter: drop-shadow(0 6px 6px rgba(20, 23, 26, .16)); }
  .csheet__tile b { font-size: .95rem; line-height: 1.2; font-variation-settings: 'wght' 700; }
  .csheet__tile small { color: var(--steel); font-size: .8rem; }
  .toolbar__count { margin: 0; color: var(--steel); font-size: .95rem; }
  .toolbar__right { display: flex; align-items: center; gap: 14px; }
  .sort { display: flex; align-items: center; gap: 10px; font-variation-settings: 'wght' 600; font-size: .95rem; }
  .sort select { min-height: 42px; padding: 8px 10px; border-radius: 7px; border: 1.5px solid var(--line-dark); background: #fff; }
  .density { display: flex; border: 1.5px solid var(--line-dark); border-radius: 7px; overflow: hidden; }
  .density button { width: 40px; height: 40px; display: grid; place-items: center; background: #fff; border: 0; cursor: pointer; color: var(--steel); }
  .density button[aria-pressed=true] { background: var(--ink); color: #fff; }
  .density svg { width: 17px; height: 17px; fill: currentColor; }
  .grid--cols3 { grid-template-columns: repeat(3, 1fr); }
  .grid--cols4 { grid-template-columns: repeat(4, 1fr); }
  @media (min-width: 1900px) { .grid--cols4 { grid-template-columns: repeat(5, 1fr); } }
  @media (min-width: 2400px) { .grid--cols4 { grid-template-columns: repeat(6, 1fr); } }
  .cell[hidden], .side [hidden] { display: none !important; }
  .cell--ask { position: relative; }
  .ask { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 10px; height: 100%; min-height: 260px; padding: clamp(18px, 2vw, 26px); border: 1.5px dashed var(--line-dark); border-radius: var(--r-m); background: linear-gradient(185deg, #f6f7f8, #fff 70%); color: var(--ink); text-decoration: none; transition: border-color .2s, background .2s, transform .3s cubic-bezier(.2, .8, .2, 1); }
  .ask:hover { border-color: var(--red); background: linear-gradient(185deg, var(--red-tint), #fff 75%); transform: translateY(-3px); }
  .ask__ic { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: var(--red-tint); color: var(--red); }
  .ask__ic svg { width: 24px; height: 24px; }
  .ask b { font-size: clamp(1.05rem, 1.25vw, 1.2rem); line-height: 1.2; letter-spacing: -.015em; font-variation-settings: 'wght' 750; }
  .ask__d { color: var(--steel); font-size: .9rem; line-height: 1.45; }
  .ask__btn { display: inline-flex; align-items: center; gap: 8px; margin-top: 4px; padding: 10px 16px; border-radius: 999px; background: var(--red); color: #fff; font-size: .9rem; font-variation-settings: 'wght' 700; }
