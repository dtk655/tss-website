---
// Contractor and municipal account application, in the shared landing-page theme.
import Layout from '../../layouts/Layout.astro';
import { PHONE, PHONE_TEL, EMAIL, FORM_WEBHOOK } from '../../lib/config.js';
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const CHECK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const ADDRESS = '601 Hadley Road, South Plainfield, NJ 07080';
const MAPS = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('Traffic Safety Service, ' + ADDRESS);
const perks = [
  ['Purchase orders', 'Send POs by email, no card needed', 'M6 3h12v18l-3-2-3 2-3-2-3 2z M9 8h6M9 12h6M9 16h3'],
  ['NET30 and NET60', 'Terms for approved accounts and agencies', 'M4 5h16v15H4z M4 9h16 M8 3v4M16 3v4 M8 13h3M8 16h6'],
  ['Contractor pricing', 'Volume, contract and bid pricing', 'M20 12l-8 8-9-9V3h8z M7.5 7.5a1 1 0 1 0 0-.01'],
  ['Your own TSS rep', 'One person who knows your jobs', 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4 21a8 8 0 0 1 16 0']
];
const benefits = ['Place orders faster', 'Work directly with a TSS rep for all orders and questions', 'Use purchase orders', 'Apply for NET terms', 'Save billing and shipping info', 'Access contractor and municipal pricing', 'Cost-effective shipping rates'];
const need = ['Company contact info', 'Company address', 'Preferred ordering and payment terms', 'Tax exempt form (if applicable)'];
const interests = ['Safety products', 'Equipment rentals', 'Truck fleet', 'Lane closure crews', 'Signs and custom work', 'WATERCADE barriers'];
const terms = ['Credit card', 'Purchase orders', 'NET30', 'NET60', 'Not sure yet'];
const orgs = ['Contractor', 'Municipality or agency', 'Utility', 'Event or venue', 'Other'];
const faq = [
  ['Is there a cost to open an account?', '<p>No. Opening an account is completely free. It gives your team and ours a quicker, more efficient sales and delivery process.</p>'],
  ['How do I place orders after my account is created?', '<p>Once you submit your details, a team member finalizes your account and reaches out with confirmation and any questions about your payment terms. Then you can:</p><ul><li>Call in orders to our sales team and speak with any rep you’d like</li><li>Email orders and quote requests</li><li>Submit POs by email</li></ul>'],
  ['Do you offer NET terms?', '<p>Yes. We offer NET30 and NET60 terms depending on your credit application, or if you are a government agency.</p>'],
  ['What is the difference in pricing?', '<p>Approved accounts may receive:</p><ul><li>Volume pricing</li><li>Contract pricing</li><li>Bid and project quotes</li></ul>'],
  ['Do you offer project-based pricing?', '<p>Yes. We provide quotes for:</p><ul><li>Traffic control setups</li><li>Long-term rentals</li><li>Large material orders</li></ul>'],
  ['Can multiple people from my company use the same account?', '<p>Yes. Anyone from your team can use the account to place orders.</p>']
];
---
<Layout title="Open an account" description={`Free contractor and municipal accounts at Traffic Safety Service: purchase orders, NET30 and NET60 terms, contractor pricing and a dedicated rep. Apply in under 2 minutes or call ${PHONE}.`}>
  <!-- ================= HERO ================= -->
  <section class="eqh">
    <div class="wrap eqh__in">
      <p class="eqh__k">Contractor and municipal accounts</p>
      <h1><span class="eqh__ln"><span>Open A Free Account.</span></span> <span class="eqh__ln"><span>Order Faster All Year.</span></span></h1>
      <p class="eqh__lede">For contractors, municipalities, utilities and agencies. Purchase orders, NET terms and contractor pricing, with one rep who knows your jobs.</p>
      <div class="eqh__ways">
        <a href="#apply" class="eway eway--solid">
          <span class="eway__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18H6z M9 8h6M9 12h6M9 16h3" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span class="eway__t"><b>Apply now</b><small>Takes less than 2 minutes</small></span>
          <Fragment set:html={ARROW.replace('<svg', '<svg class="eway__go"')} />
        </a>
        <a href={PHONE_TEL} class="eway eway--line">
          <span class="eway__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.6 1.6a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 3 6.2 2 2 0 0 1 5 4z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg></span>
          <span class="eway__t"><b>Call {PHONE}</b><small>Set it up by phone</small></span>
          <Fragment set:html={ARROW.replace('<svg', '<svg class="eway__go"')} />
        </a>
      </div>
    </div>
  </section>

  <section class="eqp" data-in>
    <div class="wrap">
      <ul class="eqp__list">
        {perks.map(([t, d, ic], i) => (
          <li style={`--i:${i}`}>
            <span class="eqp__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ic} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span><b>{t}</b><small>{d}</small></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= APPLICATION ================= -->
  <section class="ac" id="apply">
    <div class="wrap">
      <div class="eq-head">
        <div>
          <p class="eq-k"><span></span>Account application</p>
          <h2>Two minutes now. <em>Faster orders forever.</em></h2>
        </div>
        <p class="ac__note">A team member finalizes your account and confirms your payment terms by email, usually the same business day.</p>
      </div>

      <div class="ac__grid">
        <form class="acf" data-account-form novalidate>
          <div class="acf__prog" aria-hidden="true"><i data-prog></i></div>

          <fieldset class="acf__grp">
            <legend><span>1</span>Your company</legend>
            <div class="acf__chips" role="radiogroup" aria-label="Organization type">
              {orgs.map((o, i) => <label class="chip"><input type="radio" name="orgType" value={o} checked={i === 0} /><span>{o}</span></label>)}
            </div>
            <label class="acf__f"><span>Company or agency name</span><input class="acf__in" name="company" required autocomplete="organization" /></label>
            <div class="acf__row">
              <label class="acf__f"><span>Contact name</span><input class="acf__in" name="name" required autocomplete="name" /></label>
              <label class="acf__f"><span>Your role <em>Optional</em></span><input class="acf__in" name="role" placeholder="Project manager, purchasing" /></label>
            </div>
            <div class="acf__row">
              <label class="acf__f"><span>Work email</span><input class="acf__in" name="email" type="email" required autocomplete="email" /></label>
              <label class="acf__f"><span>Phone</span><input class="acf__in" name="phone" type="tel" required autocomplete="tel" /></label>
            </div>
          </fieldset>

          <fieldset class="acf__grp">
            <legend><span>2</span>Company address</legend>
            <label class="acf__f"><span>Street address</span><input class="acf__in" name="address" required autocomplete="street-address" /></label>
            <div class="acf__row acf__row--3">
              <label class="acf__f"><span>ZIP code</span><input class="acf__in" name="zip" required inputmode="numeric" maxlength="5" autocomplete="postal-code" data-zip /></label>
              <label class="acf__f"><span>City</span><input class="acf__in" name="city" required autocomplete="address-level2" data-city /></label>
              <label class="acf__f"><span>State</span><input class="acf__in" name="state" required maxlength="2" autocomplete="address-level1" data-state /></label>
            </div>
          </fieldset>

          <fieldset class="acf__grp">
            <legend><span>3</span>How you’ll order</legend>
            <p class="acf__lab">What will you mostly buy or rent?</p>
            <div class="acf__chips">
              {interests.map((v) => <label class="chip chip--check"><input type="checkbox" name="interests" value={v} /><span><Fragment set:html={CHECK} />{v}</span></label>)}
            </div>
            <p class="acf__lab">Preferred payment terms</p>
            <div class="acf__chips" role="radiogroup" aria-label="Preferred payment terms">
              {terms.map((v) => <label class="chip"><input type="radio" name="terms" value={v} required /><span>{v}</span></label>)}
            </div>
            <p class="acf__lab">Are you tax exempt?</p>
            <div class="acf__chips" role="radiogroup" aria-label="Tax exempt">
              <label class="chip"><input type="radio" name="taxExempt" value="Yes" data-tax /><span>Yes</span></label>
              <label class="chip"><input type="radio" name="taxExempt" value="No" checked data-tax /><span>No</span></label>
            </div>
            <p class="acf__hint" data-taxnote hidden>Great. After you submit, email your tax exempt form to <a href={`mailto:${EMAIL}?subject=${encodeURIComponent('Tax exempt form')}`}>{EMAIL}</a> and we’ll attach it to your account.</p>
            <label class="acf__f"><span>How did you hear about us? <em>Optional</em></span><input class="acf__in" name="heard" /></label>
          </fieldset>

          <button class="acf__send" type="submit" data-submit><span data-label>Submit application</span><Fragment set:html={ARROW} /></button>
          <div class="acf__done" data-ok hidden>
            <span class="acf__tick"><Fragment set:html={CHECK} /></span>
            <div><b>Application received.</b><p>A TSS team member will finalize your account and reach out to confirm your payment terms, usually the same business day.</p></div>
          </div>
          <p class="acf__msg" data-err hidden>That didn’t go through. Your email app should have opened with your application instead, or call us at {PHONE}.</p>
        </form>

        <aside class="acs">
          <div class="acs__card acs__card--dark">
            <p class="acs__k">What you’ll need</p>
            <ul class="acs__need">{need.map((n) => <li><Fragment set:html={CHECK} />{n}</li>)}</ul>
            <p class="acs__time"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>Takes less than 2 minutes</p>
          </div>
          <div class="acs__card">
            <p class="acs__k acs__k--red">An account lets you</p>
            <ul class="acs__list">{benefits.map((b) => <li><span><Fragment set:html={CHECK} /></span>{b}</li>)}</ul>
          </div>
          <div class="acs__card">
            <p class="acs__k acs__k--red">TSS contact information</p>
            <a class="acs__row" href={MAPS} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z M12 7.6a2.4 2.4 0 1 0 0 .01" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg><span>601 Hadley Road<br />South Plainfield, NJ 07080</span></a>
            <a class="acs__row" href={PHONE_TEL}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.6 1.6a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 3 6.2 2 2 0 0 1 5 4z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg><span>{PHONE}</span></a>
            <a class="acs__row" href={`mailto:${EMAIL}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6h17v12h-17z M3.5 6.5l8.5 6.5 8.5-6.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg><span>{EMAIL}</span></a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ================= FAQ ================= -->
  <section class="aq" data-in>
    <div class="wrap aq__grid">
      <div class="eq-head">
        <div>
          <p class="eq-k"><span></span>Questions</p>
          <h2>Before you <em>apply.</em></h2>
        </div>
        <a href="/pages/contact" class="eq-link">Ask us anything<Fragment set:html={ARROW} /></a>
      </div>
      <ul class="aq__list">
        {faq.map(([q, a], i) => (
          <li style={`--i:${i}`}>
            <details class="aq__item" open={i === 0}>
              <summary><span>{q}</span><i aria-hidden="true"></i></summary>
              <div class="aq__a" set:html={a} />
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="eqc" data-in>
    <div class="wrap eqc__in">
      <div>
        <p class="eq-k eq-k--light"><span></span>Free account</p>
        <h2>One rep. <em>Every job.</em></h2>
      </div>
      <div class="eqc__acts">
        <a href="#apply" class="eq-pill eq-pill--red">Apply now<Fragment set:html={ARROW} /></a>
        <a href={PHONE_TEL} class="eq-pill eq-pill--glass">Call {PHONE}</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ FORM_WEBHOOK, EMAIL }}>
  (() => {
    const form = document.querySelector('[data-account-form]');
    if (!form) return;
    const prog = form.querySelector('[data-prog]');
    const req = [...form.querySelectorAll('[required]')];
    const names = [...new Set(req.map((e) => e.name))];
    const progress = () => {
      const done = names.filter((n) => { const els = form.elements[n]; return els instanceof RadioNodeList ? !!els.value : !!els.value.trim() && els.checkValidity(); }).length;
      prog.style.transform = `scaleX(${done / names.length})`;
    };
    const hdr = document.querySelector('header');
    const setTop = () => document.documentElement.style.setProperty('--hdr-h', `${Math.round(hdr.getBoundingClientRect().height)}px`);
    if (hdr) { setTop(); if ('ResizeObserver' in window) new ResizeObserver(setTop).observe(hdr); }
    form.addEventListener('input', progress); form.addEventListener('change', progress); progress();

    // tax exempt note
    form.querySelectorAll('[data-tax]').forEach((r) => r.addEventListener('change', () => { form.querySelector('[data-taxnote]').hidden = form.elements.taxExempt.value !== 'Yes'; }));

    // ZIP fills city and state (same data the quote builder uses)
    const zip = form.querySelector('[data-zip]');
    zip.addEventListener('input', async () => {
      zip.value = zip.value.replace(/\D/g, '').slice(0, 5);
      if (zip.value.length !== 5) return;
      try {
        const r = await fetch(`/zip/${zip.value.slice(0, 3)}.json`);
        if (!r.ok) return;
        const d = await r.json();
        const hit = d[zip.value];
        if (!hit) return;
        const [city, state] = Array.isArray(hit) ? hit : [hit.c || hit.city, hit.s || hit.state];
        if (city) form.querySelector('[data-city]').value = city;
        if (state) form.querySelector('[data-state]').value = state;
        progress();
      } catch {}
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const btn = form.querySelector('[data-submit]');
      const lab = btn.querySelector('[data-label]');
      const ok = form.querySelector('[data-ok]');
      const err = form.querySelector('[data-err]');
      ok.hidden = true; err.hidden = true;
      const answers = {};
      for (const [k, v] of new FormData(form).entries()) {
        if (k === 'interests') (answers.interests ||= []).push(v); else answers[k] = v;
      }
      btn.disabled = true; lab.textContent = 'Submitting';
      try {
        if (!FORM_WEBHOOK) throw new Error('no webhook');
        const r = await fetch(FORM_WEBHOOK, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'account', page: location.pathname, submittedAt: new Date().toISOString(), answers })
        });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        ok.hidden = false;
        btn.hidden = true;
        form.querySelectorAll('.acf__grp').forEach((g) => g.classList.add('is-sent'));
        ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        const lines = Object.entries(answers).map(([k, v]) => `${k}: ${Array.isArray(v) ? v.join(', ') : v}`).join('\n');
        location.href = `mailto:${EMAIL}?subject=${encodeURIComponent('Account application: ' + (answers.company || ''))}&body=${encodeURIComponent(lines)}`;
        err.hidden = false;
      } finally {
        btn.disabled = false; lab.textContent = 'Submit application';
      }
    });
  })();
</script>


<script>
  // Reveal sections (and stagger their lists) as they scroll into view.
  const els = document.querySelectorAll('[data-in]');
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) els.forEach((e) => e.classList.add('is-in'));
  else {
    const io = new IntersectionObserver((ents) => ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } }), { threshold: 0.12 });
    els.forEach((e) => io.observe(e));
  }
</script>

<style>
  /* ---------- shared section language (matches the homepage) ---------- */
  .eq-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 40px; margin-bottom: clamp(24px, 3vw, 40px); }
  .eq-head--center { justify-content: center; text-align: center; }
  .eq-head--center .eq-k { justify-content: center; }
  .eq-k { display: flex; align-items: center; gap: 12px; margin: 0 0 14px; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; font-variation-settings: 'wght' 680; color: var(--steel); }
  .eq-k span { width: 34px; height: 3px; border-radius: 2px; background: var(--red); }
  .eq-k--light { color: rgba(255, 255, 255, .8); }
  .eq-head h2, .eqc h2 { margin: 0; font-size: clamp(2.2rem, 4.6vw, 4.2rem); line-height: .98; letter-spacing: -.04em; font-variation-settings: 'wght' 780; font-weight: 400; text-wrap: balance; }
  .eq-head h2 em, .eqc h2 em { font-style: normal; color: var(--red); }
  .eq-link { display: inline-flex; align-items: center; gap: 10px; padding: 13px 22px 12px; border-radius: 999px; border: 1.5px solid var(--line-dark); color: var(--ink); font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, color .2s, border-color .2s; }
  .eq-link :global(svg) { width: 17px; height: 17px; transition: transform .2s; }
  .eq-link:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
  .eq-link:hover :global(svg) { transform: translateX(3px); }
  .eq-link--light { color: #fff; border-color: rgba(255, 255, 255, .35); }
  .eq-link--light:hover { background: #fff; color: var(--ink); border-color: #fff; }
  .eq-pill { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 14px 26px 13px; border-radius: 999px; font-size: 1.02rem; font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, transform .2s; }
  .eq-pill :global(svg) { width: 18px; height: 18px; transition: transform .2s; }
  .eq-pill:hover :global(svg) { transform: translateX(3px); }
  .eq-pill--red { background: var(--red); color: #fff; }
  .eq-pill--red:hover { background: #d10a0a; }
  .eq-pill--white { background: #fff; color: var(--ink); }
  .eq-pill--white:hover { background: #f1f2f3; }
  .eq-pill--glass { background: rgba(255, 255, 255, .08); color: #fff; border: 1.5px solid rgba(255, 255, 255, .4); }
  .eq-pill--glass:hover { background: rgba(255, 255, 255, .16); }
  [data-in] li { opacity: 0; transform: translateY(18px); transition: opacity .6s, transform .7s cubic-bezier(.2, .8, .2, 1); transition-delay: calc(var(--i, 0) * 60ms); }
  [data-in].is-in li { opacity: 1; transform: none; }

  /* ---------- hero ---------- */
  .eqh { position: relative; color: #fff; overflow: hidden; background: #14171a; isolation: isolate; }
  .eqh::before { content: ''; position: absolute; inset: 0; z-index: -2; background: url('/fleet/fleet-sunset.webp') 60% 55% / cover no-repeat; transform: scale(1.06); animation: eqZoom 18s ease-out forwards; }
  .eqh::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(12, 13, 15, .94) 0%, rgba(12, 13, 15, .82) 34%, rgba(12, 13, 15, .35) 62%, rgba(12, 13, 15, .1) 82%), linear-gradient(0deg, rgba(10, 10, 12, .5), transparent 45%); }
  @keyframes eqZoom { to { transform: scale(1); } }
  .eqh__in { display: grid; align-content: center; justify-items: start; min-height: clamp(440px, 46vw, 640px); padding-block: clamp(40px, 5vw, 76px); }
  .eqh__in > * { max-width: 760px; }
  .eqh__in > h1 { max-width: 1100px; }
  .eqh__k { margin: 0 0 12px; color: var(--gold); font-size: clamp(.92rem, 1.05vw, 1.05rem); letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 700; opacity: 0; animation: eqFade .8s .2s ease forwards; }
  .eqh h1 { margin: 0 0 16px; font-size: clamp(2.4rem, 5vw, 4.8rem); line-height: 1.02; letter-spacing: -.03em; font-variation-settings: 'wght' 790; font-weight: 400; color: #fff; }
  .eqh__ln { display: block; overflow: hidden; padding-bottom: .05em; }
  .eqh__ln > span { display: inline-block; transform: translateY(105%); animation: eqRise 1s cubic-bezier(.2, .8, .2, 1) forwards; }
  .eqh__ln + .eqh__ln > span { animation-delay: .12s; color: var(--gold); }
  .eqh__lede { margin: 0 0 26px; max-width: 48ch; color: #e6e8ea; font-size: clamp(1.05rem, 1.35vw, 1.24rem); line-height: 1.5; text-wrap: balance; opacity: 0; transform: translateY(12px); animation: eqUp .8s .55s cubic-bezier(.2, .8, .2, 1) forwards; }
  .eqh__ways { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; width: 100%; max-width: 700px; }
  .eqh__ways .eway { opacity: 0; translate: 0 16px; animation: eqUpT .8s .65s cubic-bezier(.2, .8, .2, 1) forwards; }
  .eqh__ways .eway + .eway { animation-delay: .77s; }
  .eqh__call { margin: 14px 0 0; color: #cfd3d7; font-size: .95rem; opacity: 0; animation: eqFade .8s .9s ease forwards; }
  .eqh__call a { color: #fff; font-variation-settings: 'wght' 700; text-decoration: underline; text-underline-offset: 3px; }
  @keyframes eqRise { to { transform: none; } }
  @keyframes eqFade { to { opacity: 1; } }
  @keyframes eqUp { to { opacity: 1; transform: none; } }
  @keyframes eqUpT { to { opacity: 1; translate: 0 0; } }
  .eway { display: grid; grid-template-columns: 38px 1fr 18px; align-items: center; gap: 10px; padding: 14px; border-radius: 14px; text-decoration: none; transition: transform .2s, background .15s, border-color .15s, box-shadow .2s; }
  .eway:hover { transform: translateY(-2px); }
  .eway--solid { background: #fff; color: var(--ink); box-shadow: 0 18px 34px -18px rgba(0, 0, 0, .6); }
  .eway--line { border: 1.5px solid rgba(255, 255, 255, .55); color: #fff; background: rgba(255, 255, 255, .06); }
  .eway--line:hover { background: rgba(255, 255, 255, .12); border-color: #fff; }
  .eway__ic { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; background: var(--red); color: #fff; }
  .eway--line .eway__ic { background: rgba(255, 255, 255, .14); }
  .eway__ic svg { width: 22px; height: 22px; }
  .eway__t b { display: block; font-size: .98rem; line-height: 1.2; white-space: nowrap; font-variation-settings: 'wght' 720; }
  .eway__t small { display: block; margin-top: 3px; font-size: .84rem; line-height: 1.3; opacity: .75; }
  .eway--solid .eway__t b { color: var(--red); }
  .eway :global(.eway__go) { width: 18px; height: 18px; transition: transform .2s; }
  .eway:hover :global(.eway__go) { transform: translateX(3px); }

  /* ---------- perks ---------- */
  .eqp { background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .eqp__list { list-style: none; margin: 0; padding: clamp(22px, 2.6vw, 34px) 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2vw, 32px); }
  .eqp__list li { display: grid; grid-template-columns: 46px minmax(0, 1fr); gap: 14px; align-items: start; }
  .eqp__ic { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: var(--red-tint); color: var(--red); }
  .eqp__ic svg { width: 24px; height: 24px; }
  .eqp b { display: block; font-size: 1.04rem; font-variation-settings: 'wght' 720; margin: 2px 0 3px; }
  .eqp small { display: block; color: var(--steel); font-size: .9rem; line-height: 1.45; }

  /* ---------- lineup ---------- */
  .eql { padding: clamp(56px, 7vw, 100px) 0; background: #fff; }
  .eql__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); gap: clamp(10px, 1.2vw, 16px); }
  .eqt { position: relative; display: grid; grid-template-rows: auto 1fr; height: 100%; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; text-decoration: none; color: var(--ink); background: linear-gradient(185deg, var(--tint) 0%, #fff 72%); transition: transform .45s cubic-bezier(.2, .8, .2, 1), box-shadow .45s, border-color .3s; }
  .eqt:hover { transform: translateY(-6px); border-color: var(--line-dark); box-shadow: 0 28px 50px -30px rgba(20, 23, 26, .5); }
  .eqt__img { display: grid; place-items: center; padding: 18px 18px 6px; overflow: hidden; }
  .eqt__img img { display: block; width: 100%; height: clamp(150px, 12.5vw, 210px); object-fit: contain; filter: drop-shadow(0 16px 14px rgba(20, 23, 26, .2)); transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
  .eqt__img img.is-blend { mix-blend-mode: multiply; filter: none; }
  .eqt:hover .eqt__img img { transform: translateY(-6px) scale(1.05); }
  .eqt__txt { display: grid; align-content: start; gap: 6px; padding: 8px 20px 20px; }
  .eqt__txt b { font-size: clamp(1.08rem, 1.25vw, 1.25rem); line-height: 1.15; letter-spacing: -.015em; font-variation-settings: 'wght' 750; }
  .eqt__txt small { color: var(--steel); font-size: .9rem; line-height: 1.4; }
  .eqt__mode { display: inline-flex; align-items: center; gap: 4px; margin-top: 6px; color: var(--red); font-size: .88rem; font-variation-settings: 'wght' 700; }
  .eqt__mode :global(svg) { width: 14px; height: 14px; transition: transform .2s; }
  .eqt:hover .eqt__mode :global(svg) { transform: translateX(3px); }
  .eqt:hover .eqt__txt b { color: var(--red); }

  /* ---------- rent or buy ---------- */
  .eqr { padding: clamp(56px, 7vw, 100px) 0; background: var(--haze); }
  .eqr__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px); }
  .eqr__card { display: grid; align-content: start; gap: 14px; padding: clamp(24px, 3vw, 44px); border-radius: 24px; background: #fff; border: 1px solid var(--line); }
  .eqr__card--dark { background: linear-gradient(160deg, #1d2126, #121417); color: #fff; border-color: #1d2126; }
  .eqr__tag { justify-self: start; margin: 0; padding: 5px 14px; border-radius: 999px; background: var(--red-tint); color: var(--red); font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 760; }
  .eqr__card--dark .eqr__tag { background: rgba(255, 255, 255, .1); color: var(--gold); }
  .eqr h3 { margin: 0; font-size: clamp(1.5rem, 2.2vw, 2.1rem); line-height: 1.08; letter-spacing: -.03em; font-variation-settings: 'wght' 760; font-weight: 400; }
  .eqr ul { list-style: none; margin: 4px 0 10px; padding: 0; display: grid; gap: 12px; }
  .eqr li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; font-size: 1rem; line-height: 1.45; color: var(--ink-2); opacity: 1; transform: none; }
  .eqr__card--dark li { color: #d6d9dc; }
  .eqr li :global(svg) { width: 22px; height: 22px; color: var(--red); }
  .eqr__card--dark li :global(svg) { color: var(--gold); }
  .eqr__card .eq-pill { justify-self: start; }
  .eqr__calc { margin: 22px 0 0; text-align: center; color: var(--steel); }
  .eqr__calc a { color: var(--red); font-variation-settings: 'wght' 700; text-underline-offset: 3px; }

  /* ---------- fleet ---------- */
  .eqf { padding: clamp(56px, 7vw, 100px) 0; background: linear-gradient(180deg, #15181c, #1d2126); color: #fff; }
  .eqf__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: clamp(10px, 1.2vw, 16px); }
  .eqft { display: grid; gap: 6px; height: 100%; padding: 18px 20px 20px; border-radius: 20px; text-decoration: none; color: #fff; background: rgba(255, 255, 255, .05); border: 1px solid rgba(255, 255, 255, .1); transition: background .3s, border-color .3s, transform .45s cubic-bezier(.2, .8, .2, 1); }
  .eqft:hover { background: rgba(255, 255, 255, .09); border-color: rgba(255, 255, 255, .25); transform: translateY(-5px); }
  .eqft__img { display: grid; place-items: center; padding: 12px; margin-bottom: 6px; border-radius: 14px; overflow: hidden; background: radial-gradient(closest-side, rgba(255, 255, 255, .95), rgba(255, 255, 255, .82)); }
  .eqft__img img { display: block; width: 100%; height: clamp(110px, 9.5vw, 160px); object-fit: contain; filter: drop-shadow(0 12px 12px rgba(0, 0, 0, .25)); transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
  .eqft__img img.is-blend { mix-blend-mode: multiply; filter: none; }
  .eqft:hover .eqft__img img { transform: translateY(-4px) scale(1.05); }
  .eqft b { font-size: 1.1rem; line-height: 1.2; font-variation-settings: 'wght' 740; }
  .eqft small { color: #b9bfc6; font-size: .9rem; line-height: 1.4; }
  .eqft__mode { display: inline-flex; align-items: center; gap: 4px; margin-top: 4px; color: var(--gold); font-size: .88rem; font-variation-settings: 'wght' 700; }
  .eqft__mode :global(svg) { width: 14px; height: 14px; transition: transform .2s; }
  .eqft:hover .eqft__mode :global(svg) { transform: translateX(3px); }

  /* ---------- steps ---------- */
  .eqs { padding: clamp(56px, 7vw, 100px) 0; background: #fff; }
  .eqs__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px); counter-reset: s; }
  .eqs__list li { position: relative; display: grid; align-content: start; gap: 8px; padding: 26px 24px 28px; border-radius: 20px; border: 1px solid var(--line); background: #fff; }
  .eqs__list li::after { content: ''; position: absolute; top: 44px; right: calc(-1 * clamp(12px, 1.6vw, 22px)); width: clamp(12px, 1.6vw, 22px); height: 2px; background: var(--line-dark); }
  .eqs__list li:last-child::after { display: none; }
  .eqs__n { display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 6px; border-radius: 50%; background: var(--red); color: #fff; font-size: .9rem; letter-spacing: .04em; font-variation-settings: 'wght' 760; }
  .eqs b { font-size: 1.15rem; font-variation-settings: 'wght' 740; }
  .eqs small { color: var(--steel); font-size: .95rem; line-height: 1.45; }

  /* ---------- final CTA ---------- */
  .eqc { padding: clamp(56px, 7vw, 100px) 0; background: radial-gradient(120% 140% at 85% 0%, #3a0505 0%, #16181b 55%); color: #fff; }
  .eqc__in { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 26px 40px; }
  .eqc h2 { color: #fff; max-width: 16ch; }
  .eqc__acts { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .eqc__call { color: #cfd3d7; text-decoration: underline; text-underline-offset: 3px; margin-left: 4px; }
  .eqc__call:hover { color: #fff; }

  /* ---------- responsive ---------- */
  @media (max-width: 1100px) {
    .eqp__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .eqs__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .eqs__list li::after { display: none; }
    .eqh::after { background: linear-gradient(180deg, rgba(12, 13, 15, .9) 0%, rgba(12, 13, 15, .72) 45%, rgba(12, 13, 15, .4) 100%); }
  }
  @media (max-width: 720px) {
    .eqr__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .eqh__in { min-height: 0; padding-block: 34px 36px; justify-items: center; text-align: center; }
    .eqh__k { font-size: .78rem; margin-bottom: 8px; }
    .eqh h1 { font-size: clamp(1.9rem, 8.6vw, 2.4rem); margin-bottom: 10px; }
    .eqh__lede { font-size: 1rem; margin: 0 auto 20px; }
    .eqh__ways { grid-template-columns: 1fr; text-align: left; }
    .eqp__list { grid-template-columns: 1fr; gap: 16px; }
    .eql__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .eqt { border-radius: 16px; }
    .eqt__img { padding: 12px 10px 4px; }
    .eqt__img img { height: 110px; }
    .eqt__txt { padding: 6px 12px 14px; }
    .eqt__txt b { font-size: .98rem; }
    .eqt__txt small { display: none; }
    .eqf__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .eqft { padding: 12px 12px 14px; border-radius: 16px; }
    .eqft__img img { height: 90px; }
    .eqft b { font-size: .98rem; }
    .eqft small { display: none; }
    .eqs__list { grid-template-columns: 1fr; }
    .eq-head { justify-content: center; text-align: center; }
    .eq-head .eq-k { justify-content: center; }
    .eqc__in { justify-content: center; text-align: center; }
    .eqc h2 { margin-inline: auto; }
    .eqc__acts { justify-content: center; width: 100%; }
    .eqc__acts .eq-pill { width: 100%; }
    .eqr__card .eq-pill { justify-self: stretch; }
  }
  @media (prefers-reduced-motion: reduce) {
    .eqh::before, .eqh__k, .eqh__ln > span, .eqh__lede, .eqh__call, .eqh__ways .eway { animation: none; opacity: 1; transform: none; translate: none; }
    [data-in] li { opacity: 1; transform: none; transition: none; }
  }

  /* ---------- application ---------- */
  .ac { padding: clamp(48px, 6vw, 96px) 0; background: var(--haze); scroll-margin-top: 90px; }
  .ac__note { max-width: 40ch; margin: 0; color: var(--steel); }
  .ac__grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, .85fr); gap: clamp(18px, 2.6vw, 36px); align-items: start; }
  .acf { position: relative; display: grid; gap: 14px; }
  .acf__prog { position: sticky; top: calc(var(--hdr-h, 130px) + 8px); z-index: 2; height: 6px; border-radius: 99px; background: rgba(20, 23, 26, .08); overflow: hidden; }
  .acf__prog i { display: block; height: 100%; background: linear-gradient(90deg, var(--red), #e5391b); transform-origin: left; transform: scaleX(0); transition: transform .5s cubic-bezier(.2, .8, .2, 1); border-radius: inherit; }
  .acf__grp { display: grid; gap: 14px; margin: 0; padding: clamp(18px, 2.2vw, 28px); border-radius: 22px; background: #fff; border: 1px solid var(--line); min-width: 0; transition: opacity .4s; }
  .acf__grp.is-sent { opacity: .5; pointer-events: none; }
  .acf__grp legend { float: left; width: 100%; display: flex; align-items: center; gap: 10px; margin: 0 0 2px; padding: 0; font-size: 1.15rem; letter-spacing: -.01em; font-variation-settings: 'wght' 740; }
  .acf__grp legend + * { clear: both; }
  .acf__grp legend span { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--red); color: #fff; font-size: .86rem; }
  .acf__row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .acf__row--3 { grid-template-columns: .8fr 1.4fr .6fr; }
  .acf__f { display: grid; gap: 7px; }
  .acf__f > span, .acf__lab { font-size: .93rem; font-variation-settings: 'wght' 650; }
  .acf__lab { margin: 4px 0 -4px; }
  .acf__f > span em { font-style: normal; color: var(--steel); font-size: .84rem; font-variation-settings: 'wght' 450; margin-left: 4px; }
  .acf__in { width: 100%; min-height: 52px; padding: 13px 15px; font: inherit; font-size: 1rem; color: var(--ink); background: #fff; border: 1.5px solid var(--line-dark); border-radius: 12px; transition: border-color .2s, box-shadow .2s; }
  .acf__in:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 4px rgba(20, 23, 26, .07); }
  .acf__in:not(:placeholder-shown):valid { border-color: #9fcdb0; }
  .acf__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span { display: inline-flex; align-items: center; gap: 0; min-height: 44px; padding: 0 17px; border-radius: 999px; border: 1.5px solid var(--line-dark); background: #fff; font-size: .95rem; font-variation-settings: 'wght' 600; cursor: pointer; transition: background .2s, border-color .2s, color .2s, gap .25s, padding .25s; }
  .chip span:hover { border-color: var(--ink); }
  .chip input:checked + span { background: var(--ink); border-color: var(--ink); color: #fff; }
  .chip input:focus-visible + span { outline: 3px solid rgba(182, 6, 6, .35); outline-offset: 2px; }
  .chip--check span :global(svg) { width: 0; height: 16px; opacity: 0; transition: width .25s, opacity .2s; }
  .chip--check input:checked + span { gap: 7px; padding-left: 13px; }
  .chip--check input:checked + span :global(svg) { width: 16px; opacity: 1; }
  .acf__hint { margin: -4px 0 0; padding: 12px 14px; border-radius: 12px; background: #fff7df; color: #6b4e00; font-size: .93rem; }
  .acf__hint a { color: inherit; font-variation-settings: 'wght' 700; }
  .acf__hint:not([hidden]) { animation: acIn .4s cubic-bezier(.2, .8, .2, 1); }
  .acf__send { position: relative; justify-self: start; display: inline-flex; align-items: center; gap: 10px; min-height: 58px; padding: 0 30px; border: 0; border-radius: 999px; background: var(--red); color: #fff; font: inherit; font-size: 1.05rem; font-variation-settings: 'wght' 720; cursor: pointer; overflow: hidden; box-shadow: 0 18px 34px -16px rgba(182, 6, 6, .8); transition: background .2s, transform .15s; }
  .acf__send::before { content: ''; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, .28) 50%, transparent 70%); transform: translateX(-120%); transition: transform .8s cubic-bezier(.2, .8, .2, 1); }
  .acf__send:hover { background: var(--red-press); }
  .acf__send:hover::before { transform: translateX(120%); }
  .acf__send:active { transform: scale(.98); }
  .acf__send :global(svg) { width: 18px; height: 18px; }
  .acf__send[disabled] { opacity: .7; cursor: progress; }
  .acf__send[hidden] { display: none; }
  .acf__done { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 16px; align-items: center; padding: 20px 22px; border-radius: 20px; background: #e7f3eb; color: #1c4f2e; animation: acIn .5s cubic-bezier(.2, .8, .2, 1); }
  .acf__done[hidden] { display: none; }
  .acf__done b { font-size: 1.1rem; font-variation-settings: 'wght' 740; }
  .acf__done p { margin: 4px 0 0; }
  .acf__tick { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: #1c7a3e; color: #fff; animation: acPop .5s .1s cubic-bezier(.2, 1.4, .4, 1) both; }
  .acf__tick :global(svg) { width: 26px; height: 26px; stroke-dasharray: 30; stroke-dashoffset: 30; animation: acDraw .5s .35s ease forwards; }
  .acf__msg { margin: 0; padding: 14px 16px; border-radius: 14px; background: var(--red-tint); color: var(--red); font-variation-settings: 'wght' 600; }
  .acf__msg[hidden] { display: none; }
  @keyframes acIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes acPop { from { transform: scale(0); } to { transform: scale(1); } }
  @keyframes acDraw { to { stroke-dashoffset: 0; } }

  .acs { position: sticky; top: calc(var(--hdr-h, 130px) + 20px); display: grid; gap: 14px; }
  .acs__card { padding: clamp(18px, 2vw, 26px); border-radius: 22px; background: #fff; border: 1px solid var(--line); }
  .acs__card--dark { background: radial-gradient(120% 140% at 100% 0%, #3a0505 0%, #16181b 60%); color: #fff; border-color: transparent; }
  .acs__k { margin: 0 0 14px; font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; font-variation-settings: 'wght' 700; color: var(--gold); }
  .acs__k--red { color: var(--red); }
  .acs__need { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .acs__need li { display: flex; align-items: center; gap: 10px; color: #e7e9eb; }
  .acs__need :global(svg) { width: 18px; height: 18px; color: var(--gold); flex: none; }
  .acs__time { display: flex; align-items: center; gap: 8px; margin: 16px 0 0; padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, .12); font-variation-settings: 'wght' 680; }
  .acs__time svg { width: 18px; height: 18px; color: var(--gold); }
  .acs__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .acs__list li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 10px; align-items: start; color: var(--ink-2); line-height: 1.4; }
  .acs__list li span { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--red-tint); color: var(--red); }
  .acs__list :global(svg) { width: 13px; height: 13px; }
  .acs__row { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 12px; align-items: start; padding: 10px 0; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; line-height: 1.4; overflow-wrap: anywhere; transition: color .2s; }
  .acs__row:first-of-type { border-top: 0; padding-top: 0; }
  .acs__row:hover { color: var(--red); }
  .acs__row svg { width: 20px; height: 20px; color: var(--red); margin-top: 1px; }

  /* ---------- FAQ ---------- */
  .aq { padding: clamp(48px, 6vw, 96px) 0; background: #fff; }
  .aq__grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(20px, 4vw, 64px); align-items: start; }
  .aq__grid .eq-head { flex-direction: column; align-items: flex-start; position: sticky; top: calc(var(--hdr-h, 130px) + 24px); }
  .aq__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .aq__item { border-radius: 18px; border: 1px solid var(--line); background: #fff; transition: border-color .2s, box-shadow .3s; }
  .aq__item[open] { border-color: var(--line-dark); box-shadow: 0 24px 44px -34px rgba(20, 23, 26, .5); }
  .aq__item summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; cursor: pointer; font-size: 1.05rem; font-variation-settings: 'wght' 680; }
  .aq__item summary::-webkit-details-marker { display: none; }
  .aq__item summary:hover { color: var(--red); }
  .aq__item summary i { position: relative; flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--haze); transition: background .25s, transform .35s cubic-bezier(.2, .8, .2, 1); }
  .aq__item summary i::before, .aq__item summary i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; margin: -1px 0 0 -6px; border-radius: 2px; background: var(--ink); transition: transform .35s cubic-bezier(.2, .8, .2, 1), background .25s; }
  .aq__item summary i::after { transform: rotate(90deg); }
  .aq__item[open] summary i { background: var(--red); transform: rotate(180deg); }
  .aq__item[open] summary i::before, .aq__item[open] summary i::after { background: #fff; }
  .aq__item[open] summary i::after { transform: rotate(0deg); }
  .aq__a { padding: 0 20px 18px; color: var(--ink-2); line-height: 1.6; }
  .aq__item[open] .aq__a { animation: acIn .4s cubic-bezier(.2, .8, .2, 1); }
  .aq__a :global(p) { margin: 0 0 8px; }
  .aq__a :global(ul) { margin: 0; padding-left: 1.1em; }
  .aq__a :global(li::marker) { color: var(--red); }

  @media (max-width: 1000px) {
    .ac__grid, .aq__grid { grid-template-columns: 1fr; }
    .acs { position: static; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .aq__grid .eq-head { position: static; }
