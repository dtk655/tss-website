---
import Layout from '../../layouts/Layout.astro';
import QuoteWizard from '../../components/QuoteWizard.astro';
import { PHONE, YEARS } from '../../lib/config.js';
---
<Layout title="Request a quote" description={`Free quotes on traffic control products, equipment rentals and lane closure crews. A TSS team member replies within 1 business day. Call ${PHONE}.`}>
  <section class="rq">
    <div class="rq__glow" aria-hidden="true"></div>
    <div class="wrap">
      <header class="rq__head">
        <p class="rq__k"><span></span>Free quote</p>
        <h1>Get your price in <em>two minutes.</em></h1>
        <ul class="rq__trust">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Reply within 1 business day</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V6z"/><path d="M8.5 12l2.4 2.4 4.6-4.8"/></svg>No obligation</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V9l8-5 8 5v11"/><path d="M9 20v-6h6v6"/></svg>{YEARS} years in business</li>
        </ul>
      </header>
      <QuoteWizard preset="general" fromParam={true} />
    </div>
  </section>
</Layout>
<style>
  .rq { position: relative; padding: clamp(36px, 5vw, 72px) 0 clamp(64px, 8vw, 120px); background: linear-gradient(180deg, #f3f4f5 0%, #f7f7f8 420px, #fff 100%); overflow: clip; }
  .rq__glow { position: absolute; top: -260px; right: -200px; width: 720px; height: 720px; border-radius: 50%; background: radial-gradient(circle, rgba(182, 6, 6, .1), transparent 65%); pointer-events: none; }
  .rq .wrap { position: relative; }
  .rq__head { display: grid; gap: 14px; margin-bottom: clamp(26px, 3.4vw, 40px); }
  .rq__k { display: inline-flex; align-items: center; gap: 12px; margin: 0; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; color: var(--red); font-variation-settings: 'wght' 700; }
  .rq__k span { width: 26px; height: 2px; background: currentColor; }
  .rq h1 { margin: 0; font-size: clamp(2.3rem, 5vw, 4.3rem); line-height: 1; letter-spacing: -.045em; font-variation-settings: 'wght' 790; font-weight: 400; animation: rqUp .8s cubic-bezier(.2, .8, .2, 1) both; }
  .rq h1 em { font-style: normal; color: var(--red); }
  .rq__trust { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; animation: rqUp .8s .12s cubic-bezier(.2, .8, .2, 1) both; }
  .rq__trust li { display: inline-flex; align-items: center; gap: 8px; font-size: .95rem; color: var(--ink-2); font-variation-settings: 'wght' 580; }
  .rq__trust svg { width: 19px; height: 19px; fill: none; stroke: var(--red); stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  @keyframes rqUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @media (max-width: 640px) {
    .rq { padding-top: 26px; }
    .rq__trust { gap: 6px 14px; }
    .rq__trust li { font-size: .86rem; }
  }
  @media (prefers-reduced-motion: reduce) { .rq h1, .rq__trust { animation: none; } }
</style>
