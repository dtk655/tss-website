---
import Layout from '../../layouts/Layout.astro';
import TmaTruck from '../../components/TmaTruck.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import FreePlanBand from '../../components/FreePlanBand.astro';
import LaneAtAGlance from '../../components/LaneAtAGlance.astro';
import { PHONE, PHONE_TEL, YEARS } from '../../lib/config.js';

const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const photos = {
  job: CDN + 'thumbnail_IMG_0308.jpg',
  fleet: CDN + 'tss.jpg',
  tma: CDN + 'TMA_192_Rear.jpg',
  team: CDN + 'thumbnail_Safety_Day_Team_Photo.jpg',
  roadClosure: CDN + 'Road_Closures_1.svg'
};
const services = [
  ['Lane and road closures', 'Single lane to full detours, set up to MUTCD and each state’s standards.'],
  ['Flagging operations', 'ATSSA-certified flaggers who keep traffic and your crew moving safely.'],
  ['Emergency response', 'Water main breaks, downed lines, incidents. Around-the-clock dispatch for our account customers.'],
  ['Sign and barricade installs', 'Delivered, installed and maintained for the life of the project.'],
  ['Traffic control plans', 'Drawings and permits-ready plans prepared by certified traffic experts.'],
  ['Special events', 'Parades, festivals, races and game days, planned and staffed.'],
  ['Equipment sales and rentals', 'Cones to crash trucks from our own yard, on the same invoice.']
];
const certs = [
  ['OSHA Trained & Certified', 'Untitled_design_14.png', 'Every crew member completes OSHA safety training before they work a closure.'],
  ['ATSSA Flagger Certified', 'Untitled_design_18.png', 'Flaggers certified through the American Traffic Safety Services Association.'],
  ['Rutgers-Certified TCCs', 'Untitled_design_16.png', 'Each crew is led by a Rutgers-certified Traffic Control Captain.'],
  ['S.W.A.C. Clearance', 'Untitled_design_15.png', 'Our lane closure division holds S.W.A.C. clearance.'],
  ['MUTCD Compliant', 'Untitled_design_17.png', 'Every setup follows the MUTCD and each state’s own regulations.'],
  ['MASH Tested Equipment', 'Untitled_design_22.png', 'Crash trucks and barriers tested to MASH crash standards.']
].map(([t, f, d]) => [t, CDN + f, d]);
const agencies = [
  ['NJ Turnpike Authority', 'Untitled_design_26.png'],
  ['Garden State Parkway', 'Untitled_design_23.png'],
  ['NJDOT', 'Untitled_design_27.png'],
  ['NYS Thruway Authority', 'Untitled_design_24.png'],
  ['NYSDOT', 'Untitled_design_29.png'],
  ['Port Authority of NY & NJ', 'Untitled_design_28.png'],
  ['PennDOT', 'Untitled_design_30.png']
].map(([t, f]) => [t, CDN + f]);
---
<Layout title="Lane closure services" description={`MUTCD-compliant lane closures with certified, experienced crews and ATSSA-certified flaggers in NJ, NY, PA, CT and DE. 25,000+ closures since ${2026 - YEARS}. Free closure plans and quotes.`} image="/fleet/lc-hero.jpg">
  <section class="lch">
    <div class="wrap lch__in">
      <div class="lch__copy">
        <p class="lch__k">Lane closure division</p>
        <h1>25,000+ closures. Zero shortcuts.</h1>
        <p class="lch__lede">Certified, experienced crews setting up MUTCD-compliant work zones across NJ, NY, PA, CT and DE.</p>
        <div class="lch__ways">
          <a href="/tools/lane-closure-plan" class="lway lway--solid">
            <span class="lway__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3" fill="none" stroke="currentColor" stroke-width="2"/><rect x="9" y="2.5" width="6" height="4" rx="1.2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8.5 13l2.3 2.3L15.5 11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="lway__t"><b>Get a free closure plan</b><small>Not sure what you need?</small></span>
            <svg class="lway__go" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/pages/request-a-quote?type=lane-closure" class="lway lway--line">
            <span class="lway__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z M8.5 12l2.4 2.4L15.5 9.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg></span>
            <span class="lway__t"><b>Reserve a certified crew</b><small>Know the job? Get a quote</small></span>
            <svg class="lway__go" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <p class="lch__call">Rather talk? Call <a href={PHONE_TEL}>{PHONE}</a></p>
      </div>

    </div>

  </section>

  <LaneAtAGlance />

  <FreePlanBand />



  <TmaTruck />


<CoverageMap />
</Layout>


<style>
  /* ================= HERO ================= */
  .lch { position: relative; color: #fff; overflow: hidden; background: #14171a; isolation: isolate; }
  .lch::before { content: ''; position: absolute; inset: 0; z-index: -2; background: url('/fleet/lc-hero.webp') 60% 46% / cover no-repeat; transform: scale(1.06); animation: lchZoom 18s ease-out forwards; }
  .lch::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(122,4,4,.92) 0%, rgba(140,5,5,.78) 32%, rgba(90,4,4,.35) 55%, rgba(12,12,14,.12) 78%), linear-gradient(0deg, rgba(10,10,12,.5), transparent 45%); }
  @keyframes lchZoom { to { transform: scale(1); } }
  .lch__in { position: relative; display: grid; grid-template-columns: minmax(0, 720px); align-items: center; min-height: clamp(420px, 44vw, 600px); padding-block: clamp(40px, 5vw, 76px); }
  .lch__k { color: var(--gold); font-size: clamp(.92rem, 1.05vw, 1.05rem); letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 700; margin: 0 0 12px; }
  .lch h1 { font-size: clamp(2.4rem, 5vw, 4.8rem); line-height: 1.02; letter-spacing: -.03em; font-variation-settings: 'wght' 790; margin: 0 0 16px; text-wrap: balance; color: #fff; }
  .lch__lede { color: #fde0db; font-size: clamp(1.05rem, 1.35vw, 1.24rem); line-height: 1.5; max-width: 46ch; margin: 0 0 26px; text-wrap: balance; }

  .lch__ways { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-width: 700px; }
  .lway { display: grid; grid-template-columns: 38px 1fr 18px; align-items: center; gap: 10px; padding: 14px 14px; border-radius: 14px; text-decoration: none; transition: transform .2s, background .15s, border-color .15s, box-shadow .2s; }
  .lway:hover { transform: translateY(-2px); }
  .lway--solid { background: #fff; color: var(--ink); box-shadow: 0 18px 34px -18px rgba(0,0,0,.6); }
  .lway--solid:hover { box-shadow: 0 22px 40px -18px rgba(0,0,0,.7); }
  .lway--line { border: 1.5px solid rgba(255,255,255,.55); color: #fff; background: rgba(255,255,255,.06); }
  .lway--line:hover { background: rgba(255,255,255,.12); border-color: #fff; }
  .lway__ic { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; background: var(--red); color: #fff; }
  .lway--line .lway__ic { background: rgba(255,255,255,.14); }
  .lway__ic svg { width: 22px; height: 22px; }
  .lway__t b { display: block; font-size: .98rem; white-space: nowrap; line-height: 1.2; font-variation-settings: 'wght' 720; }
  .lway__t small { display: block; margin-top: 3px; font-size: .84rem; line-height: 1.3; opacity: .75; }
  .lway--solid .lway__t b { color: var(--red); }
  .lway__go { width: 18px; height: 18px; transition: transform .2s; }
  .lway:hover .lway__go { transform: translateX(3px); }
  .lch__call { margin: 14px 0 0; font-size: .95rem; color: #fbd2cc; }
  .lch__call a { color: #fff; font-variation-settings: 'wght' 700; text-decoration: underline; text-underline-offset: 3px; }

  @keyframes lchPop { from { opacity: 0; transform: scale(.5); } to { opacity: 1; transform: none; } }




  @media (max-width: 1100px) {
    .lch__in { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .lch__in { padding-block: 26px 30px; gap: 26px; }
    .lch__in { display: flex; flex-direction: column; text-align: center; }
    .lch__copy { display: contents; }
    .lch__k, .lch h1, .lch__lede { order: 1; }
    .lch__ways, .lch__call { order: 2; width: 100%; }
    .lch__in > * { margin-top: 0; margin-bottom: 0; }
    .lch__in { gap: 14px; }
    .lch__lede { margin-bottom: 6px !important; }
    .lch__k { font-size: .78rem; margin-bottom: 8px; }
    .lch h1 { font-size: clamp(1.9rem, 8.6vw, 2.4rem); margin-bottom: 10px; }
    .lch__lede { font-size: 1rem; margin: 0 auto 18px; }
    .lch__ways { grid-template-columns: 1fr; text-align: left; }
  }
  


  @media (max-width: 1100px) { .lch::after { background: linear-gradient(180deg, rgba(120,4,4,.88) 0%, rgba(120,4,4,.7) 40%, rgba(20,10,10,.35) 100%); } }
  @media (max-width: 640px) { .lch::before { background-image: url('/fleet/lc-hero-m.webp'); } }
  @media (prefers-reduced-motion: reduce) { .lch::before { animation: none; transform: none; } }
  @media (max-width: 640px) { .lch :global(.jb) { order: 3; margin-top: 10px !important; } }
</style>
