---
import Layout from '../../layouts/Layout.astro';
import TmaTruck from '../../components/TmaTruck.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import FreePlanBand from '../../components/FreePlanBand.astro';
import { PHONE, PHONE_TEL, YEARS } from '../../lib/config.js';

const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const photos = {
  job: CDN + 'thumbnail_IMG_0308.jpg',
  fleet: CDN + 'tss.jpg',
  tma: CDN + 'TMA_192_Rear.jpg',
  team: CDN + 'thumbnail_Safety_Day_Team_Photo.jpg',
  roadClosure: CDN + 'Road_Closures_1.svg'
};
const services = [
  ['Lane and road closures', 'Single lane to full detours, set up to MUTCD and each state’s standards.'],
  ['Flagging operations', 'ATSSA-certified flaggers who keep traffic and your crew moving safely.'],
  ['Emergency response', 'Water main breaks, downed lines, incidents. Around-the-clock dispatch for our account customers.'],
  ['Sign and barricade installs', 'Delivered, installed and maintained for the life of the project.'],
  ['Traffic control plans', 'Drawings and permits-ready plans prepared by certified traffic experts.'],
  ['Special events', 'Parades, festivals, races and game days, planned and staffed.'],
  ['Equipment sales and rentals', 'Cones to crash trucks from our own yard, on the same invoice.']
];
const certs = [
  ['OSHA Trained & Certified', 'Untitled_design_14.png', 'Every crew member completes OSHA safety training before they work a closure.'],
  ['ATSSA Flagger Certified', 'Untitled_design_18.png', 'Flaggers certified through the American Traffic Safety Services Association.'],
  ['Rutgers-Certified TCCs', 'Untitled_design_16.png', 'Each crew is led by a Rutgers-certified Traffic Control Captain.'],
  ['S.W.A.C. Clearance', 'Untitled_design_15.png', 'Our lane closure division holds S.W.A.C. clearance.'],
  ['MUTCD Compliant', 'Untitled_design_17.png', 'Every setup follows the MUTCD and each state’s own regulations.'],
  ['MASH Tested Equipment', 'Untitled_design_22.png', 'Crash trucks and barriers tested to MASH crash standards.']
].map(([t, f, d]) => [t, CDN + f, d]);
---
<Layout title="Lane closure services" description={`MUTCD-compliant lane closures with certified, experienced crews and ATSSA-certified flaggers in NJ, NY, PA, CT and DE. 10,000+ closures since ${2026 - YEARS}. Free closure plans and quotes.`} image={photos.job}>
  <section class="lch">
    <div class="wrap lch__in">
      <div class="lch__copy">
        <p class="lch__k">Lane closure division</p>
        <h1>10,000+ closures. Zero shortcuts.</h1>
        <p class="lch__lede">Certified, experienced crews setting up MUTCD-compliant work zones across NJ, NY, PA, CT and DE.</p>
        <div class="lch__ways">
          <a href="/tools/lane-closure-plan" class="lway lway--solid">
            <span class="lway__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3" fill="none" stroke="currentColor" stroke-width="2"/><rect x="9" y="2.5" width="6" height="4" rx="1.2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8.5 13l2.3 2.3L15.5 11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="lway__t"><b>Get a free closure plan</b><small>Not sure what you need?</small></span>
            <svg class="lway__go" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/pages/request-a-quote?type=lane-closure" class="lway lway--line">
            <span class="lway__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z M8.5 12l2.4 2.4L15.5 9.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg></span>
            <span class="lway__t"><b>Reserve a certified crew</b><small>Know the job? Get a quote</small></span>
            <svg class="lway__go" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <p class="lch__call">Rather talk? Call <a href={PHONE_TEL}>{PHONE}</a></p>
        <div class="lch__certs">
          <ul>{certs.map(([t, src]) => <li title={t}><img src={src} alt={t} width="56" height="56" /></li>)}</ul>
          <p><b>Rutgers-certified captain</b> on every crew. OSHA-trained laborers, ATSSA-certified flaggers.</p>
        </div>
      </div>

      <div class="lch__stage" aria-hidden="true">
        <div class="ab">
          <svg viewBox="0 0 260 150"><rect x="4" y="4" width="252" height="142" rx="10" fill="#111315" stroke="#2c3036" stroke-width="3"/><g fill="#3a3220"><circle cx="56" cy="30" r="4.6"/><circle cx="63" cy="39" r="4.6"/><circle cx="70" cy="48" r="4.6"/><circle cx="77" cy="57" r="4.6"/><circle cx="84" cy="66" r="4.6"/><circle cx="77" cy="75" r="4.6"/><circle cx="70" cy="84" r="4.6"/><circle cx="63" cy="93" r="4.6"/><circle cx="56" cy="102" r="4.6"/><circle cx="116" cy="30" r="4.6"/><circle cx="123" cy="39" r="4.6"/><circle cx="130" cy="48" r="4.6"/><circle cx="137" cy="57" r="4.6"/><circle cx="144" cy="66" r="4.6"/><circle cx="137" cy="75" r="4.6"/><circle cx="130" cy="84" r="4.6"/><circle cx="123" cy="93" r="4.6"/><circle cx="116" cy="102" r="4.6"/><circle cx="176" cy="30" r="4.6"/><circle cx="183" cy="39" r="4.6"/><circle cx="190" cy="48" r="4.6"/><circle cx="197" cy="57" r="4.6"/><circle cx="204" cy="66" r="4.6"/><circle cx="197" cy="75" r="4.6"/><circle cx="190" cy="84" r="4.6"/><circle cx="183" cy="93" r="4.6"/><circle cx="176" cy="102" r="4.6"/></g><g fill="#ffb300" class="ab__lit"><g class="ab__c" style="--n:0"><circle cx="56" cy="30" r="4.6"/><circle cx="63" cy="39" r="4.6"/><circle cx="70" cy="48" r="4.6"/><circle cx="77" cy="57" r="4.6"/><circle cx="84" cy="66" r="4.6"/><circle cx="77" cy="75" r="4.6"/><circle cx="70" cy="84" r="4.6"/><circle cx="63" cy="93" r="4.6"/><circle cx="56" cy="102" r="4.6"/></g><g class="ab__c" style="--n:1"><circle cx="116" cy="30" r="4.6"/><circle cx="123" cy="39" r="4.6"/><circle cx="130" cy="48" r="4.6"/><circle cx="137" cy="57" r="4.6"/><circle cx="144" cy="66" r="4.6"/><circle cx="137" cy="75" r="4.6"/><circle cx="130" cy="84" r="4.6"/><circle cx="123" cy="93" r="4.6"/><circle cx="116" cy="102" r="4.6"/></g><g class="ab__c" style="--n:2"><circle cx="176" cy="30" r="4.6"/><circle cx="183" cy="39" r="4.6"/><circle cx="190" cy="48" r="4.6"/><circle cx="197" cy="57" r="4.6"/><circle cx="204" cy="66" r="4.6"/><circle cx="197" cy="75" r="4.6"/><circle cx="190" cy="84" r="4.6"/><circle cx="183" cy="93" r="4.6"/><circle cx="176" cy="102" r="4.6"/></g></g></svg>
          <span class="ab__post"></span>
        </div>
        <div class="lch__truck">
          <img src="/fleet/tma-side.webp" alt="" width="962" height="621" fetchpriority="high" />
        </div>
        <span class="lch__tag"><i></i>Truck 199 · crash truck with arrow board and TMA</span>
      </div>
    </div>

    <div class="lch__band">
      <ul class="wrap lch__stats">
        <li><b><span data-countup>25</span>+</b><span>years running lane closures</span></li>
        <li><b><span data-countup>10,000</span>+</b><span>closures completed</span></li>
        <li><b>7</b><span>state agencies &amp; authorities</span></li>
        <li><b>5</b><span>states covered</span></li>
      </ul>
    </div>
  </section>

  <FreePlanBand />

  <section class="section">
    <div class="wrap">
      <h2>What our crews handle</h2>
      <ul class="lc-services">
        {services.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>


  <TmaTruck />

  <section class="section section--haze">
    <div class="wrap">
      <h2>Our certifications</h2>
      <p class="lede">Every crew is led by a Rutgers-Certified Traffic Control Captain.</p>
      <ul class="lc-badges">
        {certs.map(([t, src]) => <li><img src={src} alt="" loading="lazy" width="160" height="160" /><span>{t}</span></li>)}
      </ul>
    </div>
  </section>

<CoverageMap />
</Layout>

<style>
  /* ================= HERO ================= */
  .lch { position: relative; color: #fff; overflow: hidden; background: radial-gradient(120% 170% at 88% -30%, #e13a1a, #b60606 42%, #8a0404); }
  .lch::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(-45deg, rgba(255,255,255,.035) 0 18px, transparent 18px 36px); pointer-events: none; }
  .lch__in { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: center; gap: clamp(28px, 4vw, 64px); padding-block: clamp(36px, 4.6vw, 68px); }
  .lch__k { color: var(--gold); font-size: clamp(.92rem, 1.05vw, 1.05rem); letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 700; margin: 0 0 12px; }
  .lch h1 { font-size: clamp(2.2rem, 4vw, 4rem); line-height: 1.02; letter-spacing: -.03em; font-variation-settings: 'wght' 790; margin: 0 0 16px; text-wrap: balance; color: #fff; }
  .lch__lede { color: #fde0db; font-size: clamp(1.05rem, 1.35vw, 1.24rem); line-height: 1.5; max-width: 46ch; margin: 0 0 26px; text-wrap: balance; }

  .lch__ways { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-width: 700px; }
  .lway { display: grid; grid-template-columns: 38px 1fr 18px; align-items: center; gap: 10px; padding: 14px 14px; border-radius: 14px; text-decoration: none; transition: transform .2s, background .15s, border-color .15s, box-shadow .2s; }
  .lway:hover { transform: translateY(-2px); }
  .lway--solid { background: #fff; color: var(--ink); box-shadow: 0 18px 34px -18px rgba(0,0,0,.6); }
  .lway--solid:hover { box-shadow: 0 22px 40px -18px rgba(0,0,0,.7); }
  .lway--line { border: 1.5px solid rgba(255,255,255,.55); color: #fff; background: rgba(255,255,255,.06); }
  .lway--line:hover { background: rgba(255,255,255,.12); border-color: #fff; }
  .lway__ic { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; background: var(--red); color: #fff; }
  .lway--line .lway__ic { background: rgba(255,255,255,.14); }
  .lway__ic svg { width: 22px; height: 22px; }
  .lway__t b { display: block; font-size: .98rem; white-space: nowrap; line-height: 1.2; font-variation-settings: 'wght' 720; }
  .lway__t small { display: block; margin-top: 3px; font-size: .84rem; line-height: 1.3; opacity: .75; }
  .lway--solid .lway__t b { color: var(--red); }
  .lway__go { width: 18px; height: 18px; transition: transform .2s; }
  .lway:hover .lway__go { transform: translateX(3px); }
  .lch__call { margin: 14px 0 0; font-size: .95rem; color: #fbd2cc; }
  .lch__call a { color: #fff; font-variation-settings: 'wght' 700; text-decoration: underline; text-underline-offset: 3px; }

  .lch__certs { display: flex; align-items: center; gap: 16px; margin-top: 28px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.18); max-width: 700px; }
  .lch__certs ul { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; flex: none; }
  .lch__certs li { width: 48px; height: 48px; border-radius: 12px; background: #fff; display: grid; place-items: center; padding: 4px; box-sizing: border-box; box-shadow: 0 8px 18px -10px rgba(0,0,0,.5); animation: lchPop .5s cubic-bezier(.2,.8,.2,1.4) both; }
  .lch__certs li:nth-child(2) { animation-delay: .08s; } .lch__certs li:nth-child(3) { animation-delay: .16s; } .lch__certs li:nth-child(4) { animation-delay: .24s; } .lch__certs li:nth-child(5) { animation-delay: .32s; } .lch__certs li:nth-child(6) { animation-delay: .4s; }
  @keyframes lchPop { from { opacity: 0; transform: scale(.5); } to { opacity: 1; transform: none; } }
  .lch__certs img { width: 100%; height: 100%; object-fit: contain; }
  .lch__certs p { margin: 0; font-size: .88rem; line-height: 1.45; color: #fbd2cc; }
  .lch__certs p b { color: #fff; }

  .lch__stage { position: relative; border-radius: 26px; padding: clamp(70px, 7vw, 96px) clamp(16px, 2vw, 28px) 48px; background: radial-gradient(90% 75% at 50% 70%, #fff 0, #f3f4f6 62%, #e3e6e9 100%); box-shadow: 0 40px 70px -40px rgba(0,0,0,.65); }
  .lch__stage::after { content: ''; position: absolute; left: 10%; right: 10%; bottom: 40px; height: 26px; border-radius: 50%; background: radial-gradient(closest-side, rgba(20,23,26,.3), transparent); }
  .lch__truck { position: relative; z-index: 1; animation: lchDrive 1.1s cubic-bezier(.2,.8,.2,1) both .1s; }
  .lch__truck img { display: block; width: 100%; height: auto; }
  @keyframes lchDrive { from { opacity: 0; transform: translateX(-60px); } to { opacity: 1; transform: none; } }
  .lch__tag { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; font-size: .8rem; color: var(--steel); font-variation-settings: 'wght' 620; }
  .lch__tag i { width: 8px; height: 8px; border-radius: 50%; background: #1d9e4b; box-shadow: 0 0 0 3px rgba(29,158,75,.18); }

  .ab { position: absolute; z-index: 2; top: -26px; right: clamp(14px, 3vw, 34px); width: clamp(150px, 15vw, 210px); filter: drop-shadow(0 18px 24px rgba(0,0,0,.45)); animation: lchPop .6s cubic-bezier(.2,.8,.2,1.3) both .5s; }
  .ab svg { display: block; width: 100%; height: auto; }
  .ab__post { display: block; width: 10px; height: 26px; margin: -2px auto 0; background: linear-gradient(90deg, #2a2e33, #4a5058, #2a2e33); border-radius: 0 0 3px 3px; }
  .ab__c { opacity: 0; animation: abSeq0 1.6s steps(1, end) infinite; }
  .ab__c[style*="--n:1"] { animation-name: abSeq1; }
  .ab__c[style*="--n:2"] { animation-name: abSeq2; }
  .ab__lit { filter: drop-shadow(0 0 4px rgba(255,179,0,.9)); }
  @keyframes abSeq0 { 0%, 72% { opacity: 1; } 73%, 100% { opacity: 0; } }
  @keyframes abSeq1 { 0%, 17% { opacity: 0; } 18%, 72% { opacity: 1; } 73%, 100% { opacity: 0; } }
  @keyframes abSeq2 { 0%, 35% { opacity: 0; } 36%, 72% { opacity: 1; } 73%, 100% { opacity: 0; } }

  .lch__band { position: relative; border-top: 1px solid rgba(255, 255, 255, .18); background: rgba(60, 0, 0, .35); }
  .lch__stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; list-style: none; margin: 0 auto; padding-block: 20px; }
  .lch__stats li { display: grid; gap: 2px; padding-left: 18px; border-left: 2px solid rgba(245, 184, 0, .8); }
  .lch__stats b { font-size: clamp(1.6rem, 2.3vw, 2.3rem); line-height: 1.05; font-variation-settings: 'wght' 780; letter-spacing: -.02em; }
  .lch__stats li > span { color: #fbd2cc; font-size: .9rem; }

  @media (max-width: 1100px) {
    .lch__in { grid-template-columns: 1fr; }
    .lch__stage { max-width: 720px; width: 100%; justify-self: center; box-sizing: border-box; }
  }
  @media (max-width: 640px) {
    .lch__in { padding-block: 26px 30px; gap: 26px; }
    .lch__in { display: flex; flex-direction: column; text-align: center; }
    .lch__copy { display: contents; }
    .lch__k, .lch h1, .lch__lede { order: 1; }
    .lch__ways, .lch__call { order: 2; width: 100%; }
    .lch__stage { order: 3; }
    .lch__certs { order: 4; width: 100%; }
    .lch__in > * { margin-top: 0; margin-bottom: 0; }
    .lch__in { gap: 14px; }
    .lch__lede { margin-bottom: 6px !important; }
    .lch__k { font-size: .78rem; margin-bottom: 8px; }
    .lch h1 { font-size: clamp(1.9rem, 8.6vw, 2.4rem); margin-bottom: 10px; }
    .lch__lede { font-size: 1rem; margin: 0 auto 18px; }
    .lch__ways { grid-template-columns: 1fr; text-align: left; }
    .lch__certs { flex-direction: column; gap: 12px; padding-top: 18px; }
    .lch__certs ul { gap: 6px; }
    .lch__certs li { width: 44px; height: 44px; }
    .lch__stage { padding: 46px 10px 36px; border-radius: 20px; margin-top: 18px !important; }
    .lch__stage::after { bottom: 30px; }
    .ab { width: 120px; top: -18px; right: 14px; }
    .lch__tag { font-size: .72rem; bottom: 10px; }
    .lch__stats { grid-template-columns: repeat(2, 1fr); padding-block: 16px; row-gap: 14px; }
    .lch__stats li { padding-left: 12px; }
    .lch__stats b { font-size: 1.5rem; }
    .lch__stats li > span { font-size: .8rem; }
  }
  @media (prefers-reduced-motion: reduce) { .lch__truck, .ab, .lch__certs li { animation: none; } .ab__c { animation: none; opacity: 1; } }

  .lc-services { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0 32px; border-top: 3px solid var(--asphalt); }
  .lc-services li { padding: 18px 0 16px; border-bottom: 1px solid var(--concrete-dark); }
  .lc-services h3 { font-size: 1.2rem; margin-bottom: 4px; position: relative; padding-left: 16px; }
  .lc-services h3::before { content: ''; position: absolute; left: 0; top: .18em; bottom: .18em; width: 5px; border-radius: 3px; background: var(--red); }
  .lc-services p { margin: 0; color: var(--ink-soft); font-size: .98rem; }

  .lc-badges { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(165px, 1fr)); gap: 14px; }
  .lc-badges li { display: grid; gap: 12px; justify-items: center; text-align: center; background: #fff; border: 1px solid var(--line); border-radius: var(--r-m); padding: 22px 14px 18px; }
  .lc-badges img { width: 96px; height: 96px; object-fit: contain; }
  .lc-badges span { font-variation-settings: 'wght' 640; font-size: .92rem; line-height: 1.35; }
</style>
