---
import Layout from '../../layouts/Layout.astro';
import QuoteWizard from '../../components/QuoteWizard.astro';
import { PHONE, PHONE_TEL, YEARS } from '../../lib/config.js';

const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const photos = {
  job: CDN + 'thumbnail_IMG_0308.jpg',
  fleet: CDN + 'tss.jpg',
  tma: CDN + 'TMA_192_Rear.jpg',
  team: CDN + 'thumbnail_Safety_Day_Team_Photo.jpg',
  roadClosure: CDN + 'Road_Closures_1.svg'
};
const services = [
  ['Lane and road closures', 'Single lane to full detours, set up to MUTCD and each state’s standards.'],
  ['Flagging operations', 'ATSSA-certified flaggers who keep traffic and your crew moving safely.'],
  ['24/7 emergency response', 'Water main breaks, downed lines, incidents. We dispatch around the clock.'],
  ['Sign and barricade installs', 'Delivered, installed and maintained for the life of the project.'],
  ['Traffic control plans', 'Drawings and permits-ready plans prepared by certified traffic experts.'],
  ['Special events', 'Parades, festivals, races and game days, planned and staffed.'],
  ['Equipment sales and rentals', 'Cones to crash trucks from our own yard, on the same invoice.']
];
const certs = [
  ['OSHA Trained & Certified', 'Untitled_design_14.png', 'Every crew member completes OSHA safety training before they work a closure.'],
  ['ATSSA Flagger Certified', 'Untitled_design_18.png', 'Flaggers certified through the American Traffic Safety Services Association.'],
  ['Rutgers-Certified TCCs', 'Untitled_design_16.png', 'Each crew is led by a Rutgers-certified Traffic Control Captain.'],
  ['S.W.A.C. Clearance', 'Untitled_design_15.png', 'Our lane closure division holds S.W.A.C. clearance.'],
  ['MUTCD Compliant', 'Untitled_design_17.png', 'Every setup follows the MUTCD and each state’s own regulations.'],
  ['MASH Tested Equipment', 'Untitled_design_22.png', 'Crash trucks and barriers tested to MASH crash standards.']
].map(([t, f, d]) => [t, CDN + f, d]);
const agencies = [
  ['NJ Garden State Parkway', 'Untitled_design_23.png', 'Garden State Pkwy'],
  ['Port Authority of NY & NJ', 'Untitled_design_28.png', 'Port Authority'],
  ['PennDOT Roadways & Interstates', 'Untitled_design_30.png', 'PennDOT'],
  ['New York State Thruway Authority', 'Untitled_design_24.png', 'NYS Thruway'],
  ['NJ DOT Roadways & Interstates', 'Untitled_design_27.png', 'NJDOT'],
  ['NY DOT Roadways & Interstates', 'Untitled_design_29.png', 'NYSDOT'],
  ['NJ Turnpike Authority', 'Untitled_design_26.png', 'NJ Turnpike']
].map(([t, f, k]) => [t, CDN + f, k]);
const faq = [
  ['What is the furthest TSS will go for a job?', 'We complete lane closures within the states of New Jersey, New York, Pennsylvania, Connecticut, Delaware, and other surrounding areas. If you are located elsewhere, please call or submit an inquiry and we can discuss further.'],
  ['What size crews does TSS offer?', 'We provide crews of all sizes depending on the job and needs of our customer.'],
  ['How can I book a job?', `Either call our team at ${PHONE} or use the form above to submit an inquiry with a description of what your job entails. We typically get back to you within 24 hours.`],
  ['Does TSS supply traffic control devices?', 'Yes. We are a full service provider offering sales and rentals on all traffic control devices for your next job. These devices include traffic cones, crash trucks, arrow boards, water barriers, signs, and much more.'],
  ['What certifications does TSS have?', 'Each crew is led by a Rutgers-Certified Traffic Control Captain (TCC) and all crew members are OSHA trained. We follow all guidelines enlisted by the MUTCD and remain compliant with each state’s regulations. In addition, our lane closure division has S.W.A.C clearance.'],
  ['What type of experience does TSS have?', 'We have had extensive work on all major roadways and interstates including the NJDOT, NJTA, GSP, PANYNJ, NYSDOT, NYSTA, and PennDOT. In addition, we have performed closures on many local roads and special venues for concerts and sporting events.']
];
---
<Layout title="Lane closure services" description={`MUTCD-compliant lane closures, ATSSA-certified flaggers and 24/7 emergency response in NJ, NY, PA, CT and DE. 10,000+ closures since ${2026 - YEARS}. Free quotes within 1 business day.`} image={photos.job}>
  <section class="lch">
    <img class="lch__photo" src={photos.job} alt="" fetchpriority="high" />
    <span class="lch__scrim" aria-hidden="true"></span>
    <div class="wrap lch__in">
      <div class="lch__copy">
        <p class="lch__k">Lane closure division</p>
        <h1>10,000+ closures. Zero shortcuts.</h1>
        <p class="lch__lede">Certified, experienced crews setting up MUTCD-compliant work zones across NJ, NY, PA, CT and DE. 24/7.</p>
        <div class="lch__cta">
          <a href="#quote-form" class="lbtn lbtn--solid">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z M8.5 12l2.4 2.4L15.5 9.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>
            Reserve a certified crew
          </a>
          <a href={PHONE_TEL} class="lbtn lbtn--line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.6 1.6a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 3 6.2 2 2 0 0 1 5 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            Call {PHONE}
          </a>
        </div>
      </div>

      <div class="cred" data-cred>
        <div class="cred__tabs" role="tablist" aria-label="Credentials">
          <button type="button" role="tab" class="cred__tab is-on" aria-selected="true" data-tab="0">Certifications</button>
          <button type="button" role="tab" class="cred__tab" aria-selected="false" data-tab="1">Experience</button>
          <span class="cred__ink" aria-hidden="true"></span>
        </div>

        <div class="cred__views">
          <div class="cred__view is-on" data-view="0" role="tabpanel">
            <div class="cred__feat">
              {certs.map(([t, src, d], i) => (
                <div class={`cred__slide${i === 0 ? ' is-on' : ''}`} data-slide={i}>
                  <span class="cred__badge"><img src={src} alt="" width="120" height="120" loading={i < 2 ? 'eager' : 'lazy'} /></span>
                  <span class="cred__txt">
                    <span class="cred__n">{String(i + 1).padStart(2, '0')} / {String(certs.length).padStart(2, '0')}</span>
                    <b>{t}</b>
                    <span>{d}</span>
                  </span>
                </div>
              ))}
            </div>
            <div class="cred__timer" aria-hidden="true"><i data-timer></i></div>
            <ul class="cred__chips">
              {certs.map(([t, src], i) => (
                <li><button type="button" class="cred__chip" data-chip={i} aria-label={t}>
                  <img src={src} alt="" width="48" height="48" loading="lazy" />
                  <span class="cred__ck" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.6 4.5L19 7.5"/></svg></span>
                </button></li>
              ))}
            </ul>
            <p class="cred__note">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4.5h8l2 4v11H6v-11z M8 4.5v6 M16 4.5v6 M10.5 13h3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
              <span><b>Every crew:</b> a Rutgers-certified captain in charge, experienced OSHA-trained laborers, ATSSA-certified flaggers.</span>
            </p>
          </div>

          <div class="cred__view" data-view="1" role="tabpanel">
            <div class="cred__exphead">
              <b><span data-cnt="10000">10,000</span>+</b>
              <span>lane closures completed for state agencies, authorities, towns and venues</span>
            </div>
            <ul class="cred__ag">
              {agencies.map(([t, src, k], i) => (
                <li style={`--i:${i}`} title={t}>
                  <span class="cred__agimg"><img src={src} alt="" width="64" height="64" loading="lazy" /></span>
                  <span class="cred__agk">{k}</span>
                </li>
              ))}
              <li class="cred__agmore" style={`--i:${agencies.length}`}><b>+</b><span>Local roads, concerts &amp; game days</span></li>
            </ul>
            <p class="cred__route"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" fill="none" stroke="currentColor" stroke-width="1.9"/></svg>From the Garden State Parkway to the G.W. Bridge</p>
          </div>
        </div>

        <div class="cred__foot">
          <span class="cred__status" data-status><i></i><span data-status-txt>Verifying crew credentials</span></span>
          <span class="cred__every">Every crew · every job</span>
        </div>
      </div>
    </div>

    <div class="lch__band">
      <ul class="wrap lch__stats">
        <li><b><span data-countup>25</span>+</b><span>years running lane closures</span></li>
        <li><b><span data-countup>10,000</span>+</b><span>closures completed</span></li>
        <li><b>7</b><span>state agencies &amp; authorities</span></li>
        <li><b>5</b><span>states covered</span></li>
        <li><b>24/7</b><span>emergency response</span></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What our crews handle</h2>
      <ul class="lc-services">
        {services.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--dark lc-anim" data-lc-anim>
    <div class="wrap">
      <h2>How a closure goes in</h2>
      <p class="lede">Every setup follows the same discipline: warn traffic early, move it over gradually, protect the crew, and close it all out clean.</p>
    </div>
    <div class="lc-roadwrap"><svg class="lc-road" viewBox="0 0 1500 320" role="img" aria-label="Top-down diagram of a right lane closure: advance warning signs, a taper of cones guiding traffic left, an arrow board, a crash truck buffer, then the protected work area.">
      <defs>
        <pattern id="lcHatch" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="14" height="14" fill="#33383e" /><rect width="6" height="14" fill="#3d434a" />
        </pattern>
        <g id="lcCone"><circle r="8" fill="#f26a1b" /><circle r="4.6" fill="#fff" /><circle r="2.6" fill="#f26a1b" /></g>
      </defs>
      <rect width="1500" height="320" fill="#24282d" />
      <rect y="60" width="1500" height="200" fill="#2e3338" />
      <line x1="0" y1="60" x2="1500" y2="60" stroke="#f5b800" stroke-width="5" />
      <line x1="0" y1="260" x2="1500" y2="260" stroke="#f7f7f2" stroke-width="5" />
      <line x1="0" y1="160" x2="1500" y2="160" stroke="#f7f7f2" stroke-width="4" stroke-dasharray="44 66" opacity=".9" />
      <!-- stage 1: advance warning signs on the shoulder -->
      {[90, 240, 390].map((x, i) => (
        <g transform={`translate(${x} 288)`}><g class="lc-s lc-s1" style={`--d:${i * 120}ms`}>
          <rect x="-15" y="-15" width="30" height="30" transform="rotate(45)" fill="#f26a1b" stroke="#16181b" stroke-width="2" />
          <rect x="-2.5" y="14" width="5" height="16" fill="#c5c9cf" />
        </g></g>
      ))}
      <!-- stage 2: taper -->
      {Array.from({ length: 12 }, (_, i) => (
        <use href="#lcCone" class="lc-s lc-s2" style={`--d:${360 + i * 70}ms`} x={520 + i * 26} y={252 - i * 7.6} />
      ))}
      <g transform="translate(805 200)"><g class="lc-s lc-s2" style="--d:1200ms">
        <rect width="64" height="48" rx="4" fill="#16181b" />
        <path class="lc-chev" d="M12 24h30M34 13l11 11-11 11" stroke="#f5b800" stroke-width="5.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      </g></g>
      <!-- stage 3: buffer + TMA -->
      {Array.from({ length: 5 }, (_, i) => (
        <use href="#lcCone" class="lc-s lc-s3" style={`--d:${1300 + i * 70}ms`} x={880 + i * 44} y={164} />
      ))}
      <g transform="translate(1065 180)"><g class="lc-s lc-s3" style="--d:1600ms">
        <rect width="92" height="52" rx="5" fill="#f7f7f2" />
        <rect x="64" y="6" width="24" height="40" rx="3" fill="#d9d7d0" />
        <rect x="-22" y="4" width="24" height="44" rx="3" fill="#16181b" />
        <path d="M-22 10h24v7h-24zM-22 26h24v7h-24zM-22 42h24v6h-24z" fill="#f5b800" />
      </g></g>
      <!-- stage 4: work area -->
      <g class="lc-s lc-s4" style="--d:1800ms">
        <rect x="1190" y="170" width="280" height="76" fill="url(#lcHatch)" />
        {Array.from({ length: 6 }, (_, i) => <use href="#lcCone" x={1200 + i * 52} y={164} />)}
        <g transform="translate(1270 190)"><rect width="110" height="40" rx="5" fill="#f26a1b" /><rect x="78" y="4" width="28" height="32" rx="3" fill="#d9d7d0" /></g>
      </g>
      <!-- stage labels -->
      <g class="lc-lbl" font-family="Archivo Variable, Archivo, sans-serif" font-size="19" font-weight="600" fill="#c3c8cd">
        <text x="240" y="40" text-anchor="middle">1. Advance warning</text>
        <text x="670" y="40" text-anchor="middle">2. Taper and arrow board</text>
        <text x="990" y="40" text-anchor="middle">3. Buffer and crash truck</text>
        <text x="1330" y="40" text-anchor="middle">4. Protected work area</text>
      </g>
    </svg></div>
    <div class="wrap lc-anim__foot">
      <p>Want this planned for your road? <a class="textlink" href="/tools/work-zone-builder">Try the work zone builder</a> or <button type="button" class="lc-coney" data-lc-ask="How does TSS set up a lane closure, and what equipment comes with a crew?">ask Conner a question about closures</button>.</p>
    </div>
  </section>

  <section class="section section--haze">
    <div class="wrap">
      <h2>Our certifications</h2>
      <p class="lede">Every crew is led by a Rutgers-Certified Traffic Control Captain.</p>
      <ul class="lc-badges">
        {certs.map(([t, src]) => <li><img src={src} alt="" loading="lazy" width="160" height="160" /><span>{t}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <h2>Where we've worked</h2>
      <p class="lede">From the Garden State Parkway to the G.W. Bridge, we have been tested in all areas.</p>
      <ul class="lc-badges lc-badges--agency">
        {agencies.map(([t, src]) => <li><img src={src} alt="" loading="lazy" width="150" height="150" /><span>{t}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap lc-rows">
      <article class="lc-row">
        <div class="lc-row__txt">
          <h2>On the road, experience matters</h2>
          <p>For the last 25 years, our lane closure division has been dedicated to providing reliable and professional services in traffic control management. With a focus on safety and efficiency, our highly trained crews ensure that each project is handled with precision. We take pride in our team's expertise and are proud to say we have Rutgers-Certified TCCs and S.W.A.C clearance.</p>
          <p>Over the years, we've built a reputation for excellence, prioritizing the well-being of both our workers and the public. Our commitment to safety and operational compliance with the MUTCD remains at the core of everything we do.</p>
        </div>
        <img src={photos.team} alt="The TSS crew at a company Safety Day" loading="lazy" />
      </article>
      <article class="lc-row lc-row--flip">
        <div class="lc-row__txt">
          <h2>A modern fleet of equipment and vehicles</h2>
          <p>With state-of-the-art truck mounted attenuators (TMA) and a variety of new, efficient lane closure equipment, we ensure an effective job.</p>
          <a class="btn btn--dark" href="/collections/equipment-rentals">Explore our certified fleet</a>
        </div>
        <img src={photos.fleet} alt="TSS trucks lined up in the yard" loading="lazy" />
      </article>
      <article class="lc-row">
        <div class="lc-row__txt">
          <h2>25+ years. 10,000+ closures. Zero excuses.</h2>
          <p>Over the last 25 years, we have completed upwards of 10,000 lane closure jobs across the tri-state and other surrounding areas. From the Garden State Parkway to the G.W. Bridge, we have been tested in all areas.</p>
        </div>
        <img src={photos.job} alt="A TSS lane closure in place on an active roadway" loading="lazy" />
      </article>
      <article class="lc-row lc-row--flip">
        <div class="lc-row__txt">
          <h2>Start planning your next project with certified traffic experts</h2>
          <p>We offer free quotes and you can expect to receive feedback on your inquiry within 1 business day of submittal. We handle both large and small projects for all types of businesses.</p>
          <a class="btn" href="#quote-form">Reserve a certified crew</a>
        </div>
        <img src={photos.tma} alt="Rear of a TSS truck mounted attenuator crash truck" loading="lazy" />
      </article>
      <article class="lc-row">
        <div class="lc-row__txt">
          <h2>Rather talk it through? Call now</h2>
          <p>Get in touch with one of our specialists to discuss your next job and its requirements. We offer a quote after the conclusion of the call.</p>
          <a class="btn btn--dark" href={PHONE_TEL}>Talk to a safety coordinator</a>
        </div>
        <img src={photos.roadClosure} alt="Illustration of a road closure layout" loading="lazy" />
      </article>
    </div>
  </section>

  <section class="section lc-form" id="quote-form">
    <div class="wrap lc-form__in">
      <QuoteWizard preset="lane-closure" heading="Reserve a crew" />
      <aside class="lc-form__aside">
        <div class="sign sign--dark">
          <h3>Emergency right now?</h3>
          <p>We dispatch 24/7 for incidents, main breaks and downed lines.</p>
          <a class="btn" href={PHONE_TEL}>Call {PHONE}</a>
        </div>
        <div class="sign">
          <h3>What happens after you send it</h3>
          <p>A coordinator reviews the job, calls with any questions, and sends a formal quote, usually within 1 business day. Agencies and contractors can pay by PO or Net terms.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap lc-faq">
      <h2>Lane closure questions, answered</h2>
      <div class="lc-faq__list">
        {faq.map(([q, a]) => (
          <details class="lc-q">
            <summary><span>{q}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
      <p>Something we didn't cover? <button type="button" class="lc-coney" data-lc-ask="I have a question about lane closure services.">Ask Conner</button> or call <a class="textlink" href={PHONE_TEL}>{PHONE}</a>.</p>
    </div>
  </section>

  <div class="lc-sticky" data-lc-sticky hidden>
    <a href="#quote-form" class="btn">Need a quote? Tap here</a>
  </div>
</Layout>

<script>
  /* hero credentials panel: certifications walk-through, then experience */
  const cred = document.querySelector('[data-cred]');
  if (cred) {
    const tabs = [...cred.querySelectorAll('[data-tab]')];
    const views = [...cred.querySelectorAll('[data-view]')];
    const slides = [...cred.querySelectorAll('[data-slide]')];
    const chips = [...cred.querySelectorAll('[data-chip]')];
    const timer = cred.querySelector('[data-timer]');
    const status = cred.querySelector('[data-status]');
    const statusTxt = cred.querySelector('[data-status-txt]');
    const cnt = cred.querySelector('[data-cnt]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SLIDE_MS = 2600, EXP_MS = 6200;
    let tab = 0, slide = 0, t = 0, auto = !reduce, hovering = false;

    const setTab = (n) => {
      tab = n;
      tabs.forEach((b, i) => { b.classList.toggle('is-on', i === n); b.setAttribute('aria-selected', String(i === n)); });
      views.forEach((v, i) => v.classList.toggle('is-on', i === n));
      cred.style.setProperty('--tab', String(n));
      if (n === 1) {
        status.classList.add('is-ok');
        statusTxt.textContent = 'Tested on every major road in the region';
        countTo();
      } else {
        statusTxt.textContent = slide === slides.length - 1 && chips.every((c) => c.classList.contains('is-done')) ? 'Fully certified crew' : 'Verifying crew credentials';
      }
    };
    const setSlide = (n, mark = true) => {
      slide = n;
      slides.forEach((el, i) => el.classList.toggle('is-on', i === n));
      chips.forEach((c, i) => c.classList.toggle('is-cur', i === n));
      if (mark) for (let i = 0; i <= n; i++) chips[i].classList.add('is-done');
      const all = chips.every((c) => c.classList.contains('is-done'));
      status.classList.toggle('is-ok', all);
      statusTxt.textContent = all ? 'Fully certified crew' : 'Verifying crew credentials';
      if (timer) { timer.style.transition = 'none'; timer.style.width = '0%'; void timer.offsetWidth; if (auto) { timer.style.transition = `width ${SLIDE_MS}ms linear`; timer.style.width = '100%'; } }
    };
    const countTo = () => {
      if (!cnt) return;
      if (reduce) { cnt.textContent = '10,000'; return; }
      const end = +cnt.dataset.cnt, t0 = performance.now(), D = 1500;
      const step = (now) => {
        const p = Math.min(1, (now - t0) / D);
        cnt.textContent = Math.round(end * (1 - Math.pow(1 - p, 3))).toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const reset = () => { chips.forEach((c) => c.classList.remove('is-done')); status.classList.remove('is-ok'); };
    const next = () => {
      clearTimeout(t);
      if (!auto) return;
      if (hovering) { t = setTimeout(next, 600); return; }
      if (tab === 0) {
        if (slide < slides.length - 1) { setSlide(slide + 1); t = setTimeout(next, SLIDE_MS); }
        else { t = setTimeout(() => { setTab(1); t = setTimeout(next, EXP_MS); }, 1200); }
      } else {
        reset(); setTab(0); setSlide(0); t = setTimeout(next, SLIDE_MS);
      }
    };
    const stopAuto = () => { auto = false; clearTimeout(t); if (timer) { timer.style.transition = 'none'; timer.style.width = '100%'; } };

    tabs.forEach((b, i) => b.addEventListener('click', () => { stopAuto(); setTab(i); }));
    chips.forEach((c, i) => c.addEventListener('click', () => { stopAuto(); setTab(0); setSlide(i); }));
    cred.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hovering = true; });
    cred.addEventListener('pointerleave', () => { hovering = false; });

    if (reduce) { chips.forEach((c) => c.classList.add('is-done')); setSlide(0, false); status.classList.add('is-ok'); statusTxt.textContent = 'Fully certified crew'; }
    else {
      // start when the panel is on screen
      const go = () => { setSlide(0); t = setTimeout(next, SLIDE_MS); };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(([en]) => { if (en.isIntersecting) { io.disconnect(); go(); } }, { threshold: 0.3 });
        io.observe(cred);
      } else go();
    }
  }

  // One orchestrated reveal of the closure diagram when it scrolls into view.
  const anim = document.querySelector('[data-lc-anim]');
  if (anim && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    anim.classList.add('lc-wait');
    new IntersectionObserver((es, io) => {
      es.forEach((e) => { if (e.isIntersecting) { anim.classList.add('lc-go'); io.disconnect(); } });
    }, { threshold: 0.3 }).observe(anim.querySelector('.lc-road'));
  }
  // Conner buttons
  document.querySelectorAll('[data-lc-ask]').forEach((b) => b.addEventListener('click', () => window.TSSChat?.ask(b.dataset.lcAsk)));
  // Sticky mobile CTA: show after the hero, hide while the form is on screen.
  const sticky = document.querySelector('[data-lc-sticky]');
  const form = document.getElementById('quote-form');
  if (sticky && form) {
    let pastHero = false, formVisible = false;
    const apply = () => { sticky.hidden = !(pastHero && !formVisible); };
    new IntersectionObserver((es) => { es.forEach((e) => { formVisible = e.isIntersecting; apply(); }); }, { rootMargin: '0px 0px -30% 0px' }).observe(form);
    addEventListener('scroll', () => { pastHero = scrollY > 420; apply(); }, { passive: true });
  }
</script>

