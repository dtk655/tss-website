---
import Layout from '../../layouts/Layout.astro';
import TmaTruck from '../../components/TmaTruck.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import FreePlanBand from '../../components/FreePlanBand.astro';
import LaneAtAGlance from '../../components/LaneAtAGlance.astro';
import LaneScene from '../../components/LaneScene.astro';
import LaneWork from '../../components/LaneWork.astro';
import CredsRoads from '../../components/CredsRoads.astro';
import { PHONE, PHONE_TEL, YEARS } from '../../lib/config.js';

const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const photos = {
  job: CDN + 'thumbnail_IMG_0308.jpg',
  fleet: CDN + 'tss.jpg',
  tma: CDN + 'TMA_192_Rear.jpg',
  team: '/fleet/team-photo.webp',
  roadClosure: CDN + 'Road_Closures_1.svg'
};
const services = [
  ['Lane and road closures', 'Single lane to full detours, set up to MUTCD and each state’s standards.'],
  ['Flagging operations', 'ATSSA-certified flaggers who keep traffic and your crew moving safely.'],
  ['Emergency response', 'Water main breaks, downed lines, incidents. Around-the-clock dispatch for our account customers.'],
  ['Sign and barricade installs', 'Delivered, installed and maintained for the life of the project.'],
  ['Traffic control plans', 'Drawings and permits-ready plans prepared by certified traffic experts.'],
  ['Special events', 'Parades, festivals, races and game days, planned and staffed.'],
  ['Equipment sales and rentals', 'Cones to crash trucks from our own yard, on the same invoice.']
];
const certs = [
  ['OSHA Trained & Certified', 'Untitled_design_14.png', 'Every crew member completes OSHA safety training before they work a closure.'],
  ['ATSSA Flagger Certified', 'Untitled_design_18.png', 'Flaggers certified through the American Traffic Safety Services Association.'],
  ['Rutgers-Certified TCCs', 'Untitled_design_16.png', 'Each crew is led by a Rutgers-certified Traffic Control Captain.'],
  ['S.W.A.C. Clearance', 'Untitled_design_15.png', 'Our lane closure division holds S.W.A.C. clearance.'],
  ['MUTCD Compliant', 'Untitled_design_17.png', 'Every setup follows the MUTCD and each state’s own regulations.'],
  ['MASH Tested Equipment', 'Untitled_design_22.png', 'Crash trucks and barriers tested to MASH crash standards.']
].map(([t, f, d]) => [t, CDN + f, d]);
const agencies = [
  ['NJ Turnpike Authority', 'Untitled_design_26.png'],
  ['Garden State Parkway', 'Untitled_design_23.png'],
  ['NJDOT', 'Untitled_design_27.png'],
  ['NYS Thruway Authority', 'Untitled_design_24.png'],
  ['NYSDOT', 'Untitled_design_29.png'],
  ['Port Authority of NY & NJ', 'Untitled_design_28.png'],
  ['PennDOT', 'Untitled_design_30.png']
].map(([t, f]) => [t, CDN + f]);
---
<Layout title="Lane closure services" description={`MUTCD-compliant lane closures with certified, experienced crews and ATSSA-certified flaggers in NJ, NY, PA, CT and DE. 25,000+ closures since ${2026 - YEARS}. Free closure plans and quotes.`} image="/fleet/lc-hero.jpg">
  <section class="lch">
    <div class="wrap lch__in">
      <div class="lch__copy">
        <p class="lch__k">25,000+ closures and counting</p>
        <h1><span class="lch__ln"><span>Traffic Safety Service</span></span> <span class="lch__ln lch__ln--gold"><span>Lane Closure Division</span></span></h1>
        <p class="lch__lede">Certified, experienced crews setting up MUTCD-compliant work zones across NJ, NY, PA, CT and DE.</p>
        <div class="lch__ways">
          <a href="/pages/request-a-quote?type=lane-closure" class="lway lway--solid">
            <span class="lway__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3" fill="none" stroke="currentColor" stroke-width="2"/><rect x="9" y="2.5" width="6" height="4" rx="1.2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8.5 13l2.3 2.3L15.5 11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="lway__t"><b>Get A Quote</b><small>Build it in about two minutes</small></span>
            <svg class="lway__go" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#services" class="lway lway--line">
            <span class="lway__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.6" fill="none" stroke="currentColor" stroke-width="2"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6" fill="none" stroke="currentColor" stroke-width="2"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6" fill="none" stroke="currentColor" stroke-width="2"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6" fill="none" stroke="currentColor" stroke-width="2"/></svg></span>
            <span class="lway__t"><b>See Our Services</b><small>Closures, flagging, TMA and more</small></span>
            <svg class="lway__go lway__go--down" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v13M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <p class="lch__call">Rather talk? Call <a href={PHONE_TEL}>{PHONE}</a></p>
      </div>

    </div>

    <!-- Proof bar: certifications and the roads our crews work on -->
    <div class="wrap lch__proof">
      <div class="lpf">
        <div class="lpf__grp">
          <p class="lpf__k"><span>Certified</span><b>{certs.length} credentials</b></p>
          <ul class="lpf__logos">
            {certs.map(([t, src], i) => (
              <li style={`--i:${i}`} title={t}><span class="lpf__chip"><img src={src} alt={t} loading="lazy" width="56" height="56" /></span><small>{t.replace(/ (Trained & Certified|Flagger Certified|Clearance|Compliant|Tested Equipment)$/, '').replace('Rutgers-Certified TCCs', 'Rutgers TCC')}</small></li>
            ))}
          </ul>
        </div>
        <span class="lpf__div" aria-hidden="true"></span>
        <div class="lpf__grp">
          <p class="lpf__k"><span>Trusted On</span><b>The region’s toughest roads</b></p>
          <ul class="lpf__logos">
            {agencies.map(([t, src], i) => (
              <li style={`--i:${i + certs.length}`} title={t} class={t === 'NYS Thruway Authority' ? 'lpf__mhide' : undefined}><span class="lpf__chip"><img src={src} alt={t} loading="lazy" width="56" height="56" /></span><small>{({ 'NJ Turnpike Authority': 'NJ Turnpike', 'Garden State Parkway': 'GS Parkway', 'NYS Thruway Authority': 'NYS Thruway', 'Port Authority of NY & NJ': 'Port Authority' })[t] || t}</small></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

  </section>

  <div id="services" class="lc-anchor"></div>
  <LaneWork />

  <CredsRoads />

  <FreePlanBand />



  <TmaTruck />


<CoverageMap />
</Layout>


<style>
  /* ================= HERO ================= */
  .lch { position: relative; color: #fff; overflow: hidden; background: #14171a; isolation: isolate; }
  .lch::before { content: ''; position: absolute; inset: 0; z-index: -2; background: url('/fleet/lc-hero.webp') 60% 46% / cover no-repeat; transform: scale(1.06); animation: lchZoom 18s ease-out forwards; }
  .lch::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(122,4,4,.92) 0%, rgba(140,5,5,.78) 32%, rgba(90,4,4,.35) 55%, rgba(12,12,14,.12) 78%), linear-gradient(0deg, rgba(10,10,12,.5), transparent 45%); }
  @keyframes lchZoom { to { transform: scale(1); } }
  .lch__in { position: relative; display: grid; grid-template-columns: minmax(0, 720px); align-items: center; min-height: clamp(420px, 44vw, 600px); padding-block: clamp(40px, 5vw, 76px); }
  .lch__k { color: var(--gold); font-size: clamp(.92rem, 1.05vw, 1.05rem); letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 700; margin: 0 0 12px; }
  .lch h1 { font-size: clamp(2.4rem, 5vw, 4.8rem); line-height: 1.02; letter-spacing: -.03em; font-variation-settings: 'wght' 790; margin: 0 0 16px; text-wrap: balance; color: #fff; }
  .lch__lede { color: #fde0db; font-size: clamp(1.05rem, 1.35vw, 1.24rem); line-height: 1.5; max-width: 46ch; margin: 0 0 26px; text-wrap: balance; }

  /* load-in animation (matches homepage header) */
  .lch__k { opacity: 0; animation: lchFade .8s .2s ease forwards; }
  .lch__ln { display: block; overflow: hidden; padding-bottom: .05em; }
  .lch__ln > span { display: inline-block; transform: translateY(105%); animation: lchRise 1s cubic-bezier(.2,.8,.2,1) forwards; }
  .lch__ln + .lch__ln > span { animation-delay: .12s; }
  .lch__lede, .lch__call { opacity: 0; transform: translateY(12px); animation: lchUp .8s .55s cubic-bezier(.2,.8,.2,1) forwards; }
  .lch__call { animation-delay: .85s; }
  .lch__ways .lway { opacity: 0; translate: 0 16px; animation: lchUpT .8s cubic-bezier(.2,.8,.2,1) forwards; animation-delay: .65s; }
  .lch__ways .lway + .lway { animation-delay: .77s; }
  @keyframes lchRise { to { transform: none; } }
  @keyframes lchFade { to { opacity: 1; } }
  @keyframes lchUp { to { opacity: 1; transform: none; } }
  @keyframes lchUpT { to { opacity: 1; translate: 0 0; } }
  @media (prefers-reduced-motion: reduce) { .lch__k, .lch__ln > span, .lch__lede, .lch__call, .lch__ways .lway { animation: none; opacity: 1; transform: none; translate: none; } }
  .lch__ways { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-width: 700px; }
  .lway { display: grid; grid-template-columns: 38px 1fr 18px; align-items: center; gap: 10px; padding: 14px 14px; border-radius: 14px; text-decoration: none; transition: transform .2s, background .15s, border-color .15s, box-shadow .2s; }
  .lway:hover { transform: translateY(-2px); }
  .lway--solid { background: #fff; color: var(--ink); box-shadow: 0 18px 34px -18px rgba(0,0,0,.6); }
  .lway--solid:hover { box-shadow: 0 22px 40px -18px rgba(0,0,0,.7); }
  .lway--line { border: 1.5px solid rgba(255,255,255,.55); color: #fff; background: rgba(255,255,255,.06); }
  .lway--line:hover { background: rgba(255,255,255,.12); border-color: #fff; }
  .lway__ic { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; background: var(--red); color: #fff; }
  .lway--line .lway__ic { background: rgba(255,255,255,.14); }
  .lway__ic svg { width: 22px; height: 22px; }
  .lway__t b { display: block; font-size: .98rem; white-space: nowrap; line-height: 1.2; font-variation-settings: 'wght' 720; }
  .lway__t small { display: block; margin-top: 3px; font-size: .84rem; line-height: 1.3; opacity: .75; }
  .lway--solid .lway__t b { color: var(--red); }
  .lway__go { width: 18px; height: 18px; transition: transform .2s; }
  .lway:hover .lway__go { transform: translateX(3px); }
  .lch__call { margin: 14px 0 0; font-size: .95rem; color: #fbd2cc; }
  .lch__call a { color: #fff; font-variation-settings: 'wght' 700; text-decoration: underline; text-underline-offset: 3px; }

  @keyframes lchPop { from { opacity: 0; transform: scale(.5); } to { opacity: 1; transform: none; } }




  @media (max-width: 1100px) {
    .lch__in { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .lch__in { padding-block: 26px 30px; gap: 26px; }
    .lch__in { display: flex; flex-direction: column; text-align: center; }
    .lch__copy { display: contents; }
    .lch__k, .lch h1, .lch__lede { order: 1; }
    .lch__ways, .lch__call { order: 2; width: 100%; }
    .lch__in > * { margin-top: 0; margin-bottom: 0; }
    .lch__in { gap: 14px; }
    .lch__lede { margin-bottom: 6px !important; }
    .lch__k { font-size: .78rem; margin-bottom: 8px; }
    .lch h1 { font-size: clamp(1.9rem, 8.6vw, 2.4rem); margin-bottom: 10px; }
    .lch__lede { font-size: 1rem; margin: 0 auto 18px; }
    .lch__ways { grid-template-columns: 1fr; text-align: left; }
  }
  


  @media (max-width: 1100px) { .lch::after { background: linear-gradient(180deg, rgba(120,4,4,.88) 0%, rgba(120,4,4,.7) 40%, rgba(20,10,10,.35) 100%); } }
  @media (max-width: 640px) { .lch::before { background-image: url('/fleet/lc-hero-m.webp'); } }
  @media (prefers-reduced-motion: reduce) { .lch::before { animation: none; transform: none; } }
  @media (max-width: 640px) { .lch :global(.jb) { order: 3; margin-top: 10px !important; } }
  /* Proof bar: certification seals + road owners, glass panel along the bottom of the header. */
  .lch__proof { position: relative; padding-bottom: clamp(22px, 2.6vw, 40px); margin-top: calc(-1 * clamp(8px, 1.4vw, 30px)); }
  .lpf { display: grid; grid-template-columns: auto 1px minmax(0, 1fr); align-items: center; gap: clamp(18px, 2.4vw, 36px); padding: clamp(14px, 1.4vw, 20px) clamp(18px, 2vw, 30px); border-radius: 20px; background: rgba(14, 15, 17, .55); border: 1px solid rgba(255, 255, 255, .14); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2); box-shadow: 0 24px 60px -30px rgba(0, 0, 0, .8); opacity: 0; translate: 0 18px; animation: lchUpT .9s .95s cubic-bezier(.2, .8, .2, 1) forwards; }
  .lpf__grp { display: grid; gap: 10px; min-width: 0; }
  .lpf__div { align-self: stretch; background: linear-gradient(180deg, transparent, rgba(255, 255, 255, .22), transparent); }
  .lpf__k { display: flex; align-items: baseline; gap: 10px; margin: 0; }
  .lpf__k span { color: var(--gold); font-size: .74rem; letter-spacing: .16em; text-transform: uppercase; font-variation-settings: 'wght' 760; }
  .lpf__k b { color: rgba(255, 255, 255, .7); font-size: .8rem; font-weight: 400; font-variation-settings: 'wght' 520; }
  .lpf__logos { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(8px, 1vw, 16px); }
  .lpf__logos li { display: grid; justify-items: center; gap: 6px; width: clamp(54px, 4.6vw, 70px); opacity: 0; transform: translateY(8px) scale(.92); animation: lpfIn .6s cubic-bezier(.2, .8, .2, 1) forwards; animation-delay: calc(1.15s + var(--i) * .05s); }
  .lpf__chip { display: grid; place-items: center; width: clamp(46px, 3.8vw, 56px); aspect-ratio: 1; border-radius: 50%; background: #fff; box-shadow: 0 0 0 3px rgba(255, 255, 255, .08), 0 8px 18px -8px rgba(0, 0, 0, .7); transition: transform .35s cubic-bezier(.2, .8, .2, 1), box-shadow .35s; }
  .lpf__chip img { width: 82%; height: 82%; object-fit: contain; }
  .lpf__logos li:hover .lpf__chip { transform: translateY(-3px) scale(1.06); box-shadow: 0 0 0 3px rgba(245, 184, 0, .55), 0 12px 22px -8px rgba(0, 0, 0, .8); }
  .lpf__logos small { max-width: 100%; color: rgba(255, 255, 255, .82); font-size: .66rem; line-height: 1.15; text-align: center; letter-spacing: .01em; font-variation-settings: 'wght' 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @keyframes lpfIn { to { opacity: 1; transform: none; } }
  @media (max-width: 1100px) {
    .lpf { grid-template-columns: 1fr; }
    .lpf__div { height: 1px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .22), transparent); }
  }
  @media (max-width: 640px) {
    .lch__proof { margin-top: 0; padding-bottom: 22px; }
    .lpf { padding: 14px 0 14px 14px; gap: 14px; border-radius: 16px; }
    .lpf__k { justify-content: flex-start; padding-right: 14px; }
    .lpf__logos { overflow-x: auto; scrollbar-width: none; padding-right: 14px; scroll-snap-type: x proximity; }
    .lpf__logos::-webkit-scrollbar { display: none; }
    .lpf__logos li { flex: none; width: 58px; scroll-snap-align: start; }
    .lpf__chip { width: 48px; }
  }
  @media (prefers-reduced-motion: reduce) { .lpf, .lpf__logos li { animation: none; opacity: 1; transform: none; translate: none; } }
  .lpf__logos { justify-content: space-between; }
  .lpf__logos li { width: auto; min-width: clamp(54px, 4.6vw, 70px); }
  .lpf__logos small { overflow: visible; }
  @media (min-width: 1101px) { .lch__in { min-height: clamp(400px, 38vw, 540px); padding-block: clamp(34px, 4vw, 60px) clamp(28px, 3vw, 48px); } }
  @media (min-width: 1101px) and (max-height: 820px) { .lch__in { min-height: 0; padding-block: 28px 24px; } .lch h1 { font-size: clamp(2.4rem, 4.2vw, 4rem); } .lch__lede { margin-bottom: 20px; } }
  .lch__ln--gold > span { color: var(--gold); }
  .lch h1 { white-space: nowrap; }
  .lc-anchor { scroll-margin-top: 110px; }
  html { scroll-behavior: smooth; }
  .lway:hover .lway__go--down { transform: translateY(3px); }
  @media (max-width: 640px) { .lch h1 { white-space: normal; } }
  /* Phone: tighter header that fits the first screen. */
  @media (max-width: 640px) {
    .lch__in { padding-block: 20px 14px; gap: 10px; min-height: 0 !important; }
    .lch__ways { width: 100%; }
    .lch__ways .lway { min-width: 0; width: 100%; box-sizing: border-box; display: flex; align-items: center; }
    .lch__ways .lway__t { min-width: 0; text-align: left; }
    .lch__k { font-size: .7rem; margin-bottom: 4px !important; }
    .lch h1 { font-size: clamp(1.7rem, 7.4vw, 2rem); line-height: 1.06; margin-bottom: 4px !important; }
    .lch__lede { font-size: .92rem; line-height: 1.45; margin: 0 auto 6px !important; max-width: 32ch; }
    .lch__ways { grid-template-columns: 1fr 1fr; gap: 8px; }
    .lch__ways .lway { min-height: 0; padding: 10px 10px; gap: 8px; border-radius: 14px; }
    .lch__ways .lway__ic { width: 32px; height: 32px; border-radius: 9px; flex: none; }
    .lch__ways .lway__ic svg { width: 18px; height: 18px; }
    .lch__ways .lway__t b { font-size: .88rem; line-height: 1.15; }
    .lch__ways .lway__t small, .lch__ways .lway__go { display: none; }
    .lch__call { font-size: .84rem; margin-top: 2px !important; }
    .lch__proof { padding-bottom: 16px; }
    .lpf { padding: 12px 0 12px 12px; gap: 10px; border-radius: 14px; }
    .lpf__k { gap: 8px; }
    .lpf__k span { font-size: .64rem; }
    .lpf__k b { font-size: .7rem; }
    .lpf__grp { gap: 8px; }
    .lpf__logos { gap: 6px; -webkit-mask-image: linear-gradient(90deg, #000 82%, transparent); mask-image: linear-gradient(90deg, #000 82%, transparent); padding-right: 28px; }
    .lpf__logos li { width: 52px; min-width: 52px; gap: 4px; }
    .lpf__chip { width: 40px; }
    .lpf__logos small { font-size: .56rem; }
  }
  /* Phone: both logo rows fit without scrolling (NYS Thruway hidden here only). */
  @media (max-width: 640px) {
    .lpf { padding: 12px; }
    .lpf__mhide { display: none !important; }
    .lpf__logos { overflow: visible; gap: 4px; padding-right: 0; justify-content: space-between; -webkit-mask-image: none; mask-image: none; }
    .lpf__logos li { flex: 1 1 0; width: auto; min-width: 0; }
    .lpf__chip { width: min(40px, 100%); }
    .lpf__logos small { font-size: .54rem; letter-spacing: 0; white-space: normal; overflow: visible; text-wrap: balance; }
    .lpf__logos li { align-content: start; }
  }
</style>
