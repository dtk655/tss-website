---
// Equipment and fleet landing page: what we rent and sell, how renting works, the fleet.
import Layout from '../../layouts/Layout.astro';
import TmaTruck from '../../components/TmaTruck.astro';
import { loadCatalog, img } from '../../lib/shopify.js';
import { cutouts } from '../../lib/cutouts.js';
import { PHONE, PHONE_TEL } from '../../lib/config.js';

const { colByHandle } = await loadCatalog();
const fleetCol = colByHandle.get('truck-rentals');
const equipCol = colByHandle.get('equipment-rentals');
const fleetHandles = new Set((fleetCol?.products || []).map((p) => p.handle));

// Short, plain-language lines for the tiles (products without one just show the title).
const blurbs = {
  'variable-message-sign-vms-board': 'Programmable sign for detours, delays and alerts.',
  'arrow-board': 'Flashing arrow panel that steers traffic out of a closed lane.',
  'light-tower': 'Lights up night work zones and staging areas.',
  'portable-traffic-light': 'Runs one-lane, two-way traffic through a work zone.',
  'speed-limit-trailer': 'Shows drivers their speed as they approach the zone.',
  'concrete-barrier': 'Positive protection for long-term work zones.',
  'concrete-barrier-lifter': 'Sets and moves concrete barrier quickly.',
  'sand-drum-lifter': 'Lifts and places sand-filled crash barrels.',
  'ground-mount-attenuator-gma': 'Crash cushion for fixed hazards and barrier ends.',
  'truck-mounted-attenuator-tma': 'Crash truck that protects crews from behind.',
  'scorpion-trailer-with-arrow-board': 'Trailer-mounted crash cushion with an arrow board.',
  'bucket-truck': 'Aerial work at 45, 60 and 85 feet.',
  'bucket-van': 'Compact 30 ft aerial van for tight streets.',
  'basket-truck': 'The cone truck: sets and picks up cones fast.',
  'flatbed-truck': 'Hauls barrier, drums and equipment to the job.'
};
const tints = ['#fff1c9', '#ffe7d2', '#e2edf8', '#e3f3d8', '#ffdede', '#ebebe8'];
const toTile = (p, i) => ({
  href: `/products/${p.handle}`,
  title: p.title.replace(/\s*\(.*?\)\s*/g, ' ').trim(),
  blurb: blurbs[p.handle] || '',
  img: cutouts[p.handle] || (p.featuredImage ? img(p.featuredImage.url, 500) : ''),
  cut: !!cutouts[p.handle],
  tint: tints[i % tints.length]
});
const equipment = (equipCol?.products || []).filter((p) => !fleetHandles.has(p.handle)).map(toTile);
const fleet = (fleetCol?.products || []).map((p, i) => toTile(p, i + 2));

const xp = [
  ['Delivered, Set Up And Picked Up', 'We drop it, place it and take it away when the job is done.', 'M4 6h16v14H4z M4 10.5h16 M8.5 3.5v4 M15.5 3.5v4 M8 14.5h2.5 M13.5 14.5H16'],
  ['Programmed For Your Job', 'Messages and arrow patterns set to your closure.', 'M2.5 7h11v9h-11z M13.5 10h4l3 3.5V16h-7z M6.5 19a1.7 1.7 0 1 0 0-.01 M16.5 19a1.7 1.7 0 1 0 0-.01'],
  ['Seen Day And Night', 'Bright LED boards and light towers for night shifts.', 'M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z M8.5 12l2.4 2.4L15.5 9.8'],
  ['Serving the Tri\u2011State Since 1971', 'Over five decades on the region’s roads.', 'M12 14.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11z M8.6 13.6L7 21l5-2.6 5 2.6-1.6-7.4 M12 6.6v2.6l1.6 1']
];
// equipment the AI Equipment Expert checks a project against
const roster = ['VMS message boards', 'Arrow boards', 'Light towers', 'Speed trailers', 'Portable traffic lights', 'Water-filled barrier', 'Barricades and drums'];
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const CHECK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const perks = [
  ['Rent or buy', 'Most equipment can be rented by the job or bought outright.', 'M4 7h16M4 12h10M4 17h7 M17 14l3 3-3 3'],
  ['Delivered and picked up', 'We drop it at your site and haul it back, across NJ, NY, PA and CT.', 'M2.5 7h11v9h-11z M13.5 10h4l3 3.5V16h-7z M6.5 19a1.7 1.7 0 1 0 0-.01 M16.5 19a1.7 1.7 0 1 0 0-.01'],
  ['Set up by our crews', 'Certified, experienced crews can place it, run it and take it down.', 'M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z M8.5 12l2.4 2.4L15.5 9.8'],
  ['One invoice', 'Equipment, supplies and crews on the same bill.', 'M6 3h12v18l-3-2-3 2-3-2-3 2z M9 8h6M9 12h6M9 16h3']
];
const steps = [
  ['Pick your equipment', 'Choose from the lineup or tell us the job and we’ll recommend it.'],
  ['Get pricing', 'A real person prices it, usually within 1 business day.'],
  ['We deliver it', 'On your date, placed where you need it. Setup available.'],
  ['We pick it up', 'When the job wraps, we haul it back. Extend any time.']
];
import Showroom from '../../components/Showroom.astro';
---
<Layout title="Equipment and fleet" description={`Rent or buy VMS boards, arrow boards, light towers, portable traffic lights, crash trucks and more. Delivered and picked up in NJ, NY, PA and CT. Call ${PHONE}.`} image="/fleet/vms-yard.webp">
  <!-- ================= HERO ================= -->
  <section class="eqh">
    <div class="wrap eqh__in">
      <h1><span class="eqh__ln"><span>All The Equipment You Need.</span></span> <span class="eqh__ln"><span>Ready When You Are.</span></span></h1>
      <Showroom set="equipment" night animate tall band duo class="eqh__sr" />
      <p class="eqh__sub">Rented by the day or the job across NJ, NY, PA and CT.</p>
      <p class="eqh__lede">VMS boards, arrow boards and light towers, rented by the day or the job across NJ, NY, PA and CT.</p>
      <div class="eqh__ways">
        <a href="/collections/equipment-rentals" class="eway eway--solid">
          <span class="eway__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 7h11v9h-11z M13.5 10h4l3 3.5V16h-7z M6.5 19a1.7 1.7 0 1 0 0-.01 M16.5 19a1.7 1.7 0 1 0 0-.01" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg></span>
          <span class="eway__t"><b>See Our Equipment Options</b><small>Browse everything we rent</small></span>
          <Fragment set:html={ARROW.replace('<svg', '<svg class="eway__go"')} />
        </a>
        <a href="/pages/request-a-quote?type=rental" class="eway eway--line">
          <span class="eway__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.5h9l3.5 3.5v13.5H6z M9.5 11h6 M9.5 14.5h6 M9.5 7.5h3" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round"/></svg></span>
          <span class="eway__t"><b>Get equipment pricing</b><small>Rent it or buy it</small></span>
          <Fragment set:html={ARROW.replace('<svg', '<svg class="eway__go"')} />
        </a>
      </div>
      <p class="eqh__call">Rather talk? Call <a href={PHONE_TEL}>{PHONE}</a></p>
      <form class="eqv" data-eqv autocomplete="off">
        <label for="eqv-in"><span class="eqv__dot"></span>Program the board</label>
        <div class="eqv__row">
          <input id="eqv-in" maxlength="36" placeholder="Type a message for the board" data-eqv-in />
          <button type="button" class="eqv__clr" data-eqv-clr aria-label="Clear message" hidden>×</button>
        </div>
      </form>
    </div>
    <div class="eqh__xp" aria-label="Why rent equipment from us">
      <div class="wrap">
        <ul>
          {xp.map(([label, sub, d], i) => (
            <li style={`--i:${i}`}>
              <span class="eqh__xi"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={d} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span class="eqh__xt"><b>{label}</b><small>{sub}</small></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= LINEUP ================= -->
  <section class="eql" data-in id="lineup">
    <div class="wrap">
      <div class="eq-head">
        <div>
          <p class="eq-k"><span></span>The lineup</p>
          <h2>Everything to run <em>the work zone.</em></h2>
        </div>
        <a href="/collections/equipment-rentals" class="eq-link">Shop all equipment<Fragment set:html={ARROW} /></a>
      </div>
      <ul class="eql__grid">
        {equipment.map((e, i) => (
          <li style={`--i:${i}`}>
            <a href={e.href} class="eqt" style={`--tint:${e.tint}`}>
              <span class="eqt__img"><img src={e.img} alt="" loading="lazy" data-fit class={e.cut ? '' : 'is-blend'} /></span>
              <span class="eqt__txt">
                <b>{e.title}</b>
                {e.blurb && <small>{e.blurb}</small>}
                <span class="eqt__mode">Buy or rent<Fragment set:html={ARROW} /></span>
              </span>
            </a>
          </li>
        ))}
        <li style={`--i:${equipment.length}`}>
          <a href="/pages/fleet" class="eqx eqx--fleet">
            <span class="eqx__img"><img src="/fleet/tma-side.png" alt="" loading="lazy" /></span>
            <span class="eqx__txt">
              <b>Need A Work Vehicle For Your Job?</b>
              <small>TMA crash trucks, bucket trucks and more, ready to roll.</small>
              <span class="eqx__btn">See Our Fleet<Fragment set:html={ARROW} /></span>
            </span>
          </a>
        </li>
        <li style={`--i:${equipment.length + 1}`}>
          <a href="/pages/contact" class="eqx eqx--ask">
            <span class="eqx__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 16l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M9.3 9.4a1.9 1.9 0 1 1 2.6 1.8c-.6.3-.9.7-.9 1.3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="11" cy="14.3" r=".9" fill="currentColor"/></svg></span>
            <span class="eqx__txt">
              <b>Don’t See What You’re Looking For?</b>
              <small>Not everything we have available is on our website. Contact us and we’ll see if we can get what you need.</small>
              <span class="eqx__btn">Contact Us<Fragment set:html={ARROW} /></span>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ================= AI EQUIPMENT EXPERT: RIGHT EQUIPMENT ================= -->
  <section class="eqa" data-in>
    <div class="wrap">
      <div class="eqa__shell">
      <div class="eqa__card">
        <span class="eqa__grid" aria-hidden="true"></span>
        <span class="eqa__glow eqa__glow--a" aria-hidden="true"></span>
        <span class="eqa__glow eqa__glow--b" aria-hidden="true"></span>
        <div class="eqa__copy">
          <div class="eqa__who">
            <span class="eqa__av" aria-hidden="true"><i></i><i></i><b class="eqa__avt">AI</b></span>
            <span class="eqa__name"><b>Equipment Expert</b><small><span class="eqa__dot"></span>Online · trained on our equipment</small></span>
          </div>
          <h2>Find Out If We Have The <em>Right Equipment For Your Job.</em></h2>
          <p class="eqa__lede eqa__lede--short">Describe the job. We’ll tell you what equipment fits.</p>
          <p class="eqa__lede eqa__lede--long">Describe the work in your own words. Our AI Equipment Expert reads your project, checks it against every board, tower and trailer in our yard and tells you what fits, or if nothing does.</p>
          <ol class="eqa__how">
            <li><span>1</span>Describe the job</li>
            <li><span>2</span>We check our equipment</li>
            <li><span>3</span>Get a recommendation</li>
          </ol>
        </div>
        <form class="eqa__form" data-eqa>
          <label class="eqa__lab" for="eqa-q">Tell us about the project</label>
          <div class="eqa__box">
            <div class="eqa__field">
              <textarea id="eqa-q" rows="3" data-eqa-q aria-describedby="eqa-note"></textarea>
              <span class="eqa__type" aria-hidden="true" data-eqa-type></span>
            </div>
            <div class="eqa__bar">
              <span class="eqa__scan" data-eqa-scan>
                <span class="eqa__scan-l">Checks against</span>
                <span class="eqa__roster"><span class="eqa__track">{[...roster, ...roster].map((r, i) => <span style={`--i:${i % roster.length}`} aria-hidden={i >= roster.length ? 'true' : undefined}>{r}</span>)}</span></span>
              </span>
              <button type="submit" class="eqa__send" data-eqa-send><span data-eqa-lab>Find My Equipment</span><Fragment set:html={ARROW} /></button>
            </div>
            <span class="eqa__beam" aria-hidden="true"></span>
          </div>
          <div class="eqa__chips" aria-label="Try an example">
            <span class="eqa__try">Try:</span>
            {['Warn drivers of a lane closure', 'Light up a night paving job', 'Detour signs for a road closure', 'Slow traffic near a school zone'].map((t) => <button type="button" data-eqa-chip>{t}</button>)}
          </div>
          <p class="eqa__note eqa__note--short">AI can make mistakes. For a firm answer call <a href={PHONE_TEL}>{PHONE}</a>.</p>
          <p class="eqa__note eqa__note--long" id="eqa-note">The Equipment Expert is an AI assistant and can make mistakes. For a firm answer and pricing, <a href="/pages/request-a-quote?type=rental">get equipment pricing</a> or call <a href={PHONE_TEL}>{PHONE}</a>.</p>
        </form>
      </div>
      </div>
    </div>
  </section>

  <!-- ================= PERKS ================= -->
  <section class="eqp" data-in>
    <div class="wrap">
      <ul class="eqp__list">
        {perks.map(([t, d, ic], i) => (
          <li style={`--i:${i}`}>
            <span class="eqp__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ic} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span><b>{t}</b><small>{d}</small></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= RENT OR BUY ================= -->
  <section class="eqr" data-in>
    <div class="wrap">
      <div class="eq-head eq-head--center">
        <div>
          <p class="eq-k"><span></span>Rent or buy<span></span></p>
          <h2>Two ways to <em>get it on site.</em></h2>
        </div>
      </div>
      <div class="eqr__grid">
        <article class="eqr__card">
          <p class="eqr__tag">Rent</p>
          <h3>For the job in front of you</h3>
          <ul>
            <li><Fragment set:html={CHECK} />Short jobs, seasonal peaks and one-off events</li>
            <li><Fragment set:html={CHECK} />Delivered, placed and picked up by our team</li>
            <li><Fragment set:html={CHECK} />Add setup by our certified, experienced crews</li>
            <li><Fragment set:html={CHECK} />NJ, NY, PA and CT</li>
          </ul>
          <a href="/pages/request-a-quote?type=rental" class="eq-pill eq-pill--red">Get rental pricing<Fragment set:html={ARROW} /></a>
        </article>
        <article class="eqr__card eqr__card--dark">
          <p class="eqr__tag">Buy</p>
          <h3>For the equipment you use all year</h3>
          <ul>
            <li><Fragment set:html={CHECK} />Own boards, lights and barrier outright</li>
            <li><Fragment set:html={CHECK} />Pays off when you’d rent it again and again</li>
            <li><Fragment set:html={CHECK} />Purchase orders and net terms accounts welcome</li>
            <li><Fragment set:html={CHECK} />Not sure? Ask for both prices on one quote</li>
          </ul>
          <a href="/pages/request-a-quote?type=products" class="eq-pill eq-pill--white">Get purchase pricing<Fragment set:html={ARROW} /></a>
        </article>
      </div>
      <p class="eqr__calc">Weighing it up? <a href="/tools/rent-vs-buy">Run the numbers with our rent vs. buy calculator</a></p>
    </div>
  </section>

  <!-- ================= FLEET ================= -->
  <section class="eqf" data-in id="fleet">
    <div class="wrap">
      <div class="eq-head">
        <div>
          <p class="eq-k eq-k--light"><span></span>The fleet</p>
          <h2>Trucks and trailers, <em>ready to roll.</em></h2>
        </div>
        <a href="/pages/fleet" class="eq-link eq-link--light">See the fleet<Fragment set:html={ARROW} /></a>
      </div>
      <ul class="eqf__grid">
        {fleet.map((e, i) => (
          <li style={`--i:${i}`}>
            <a href={e.href} class="eqft">
              <span class="eqft__img"><img src={e.img} alt="" loading="lazy" data-fit class={e.cut ? '' : 'is-blend'} /></span>
              <b>{e.title}</b>
              {e.blurb && <small>{e.blurb}</small>}
              <span class="eqft__mode">Rent<Fragment set:html={ARROW} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <TmaTruck />

  <!-- ================= HOW IT WORKS ================= -->
  <section class="eqs" data-in>
    <div class="wrap">
      <div class="eq-head eq-head--center">
        <div>
          <p class="eq-k"><span></span>How renting works<span></span></p>
          <h2>From quote to <em>pickup.</em></h2>
        </div>
      </div>
      <ol class="eqs__list">
        {steps.map(([t, d], i) => (
          <li style={`--i:${i}`}>
            <span class="eqs__n">{String(i + 1).padStart(2, '0')}</span>
            <b>{t}</b>
            <small>{d}</small>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="eqc" data-in>
    <div class="wrap eqc__in">
      <div>
        <p class="eq-k eq-k--light"><span></span>Free quote</p>
        <h2>Tell us the job. <em>We’ll bring the gear.</em></h2>
      </div>
      <div class="eqc__acts">
        <a href="/pages/request-a-quote?type=rental" class="eq-pill eq-pill--red">Get rental pricing<Fragment set:html={ARROW} /></a>
        <a href="/pages/request-a-quote?type=products" class="eq-pill eq-pill--glass">Get purchase pricing</a>
        <a href={PHONE_TEL} class="eqc__call">or call {PHONE}</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Desktop: if the strip under the hero would run past the bottom of the screen, compact it so the whole hero fits.
  {
    const h = document.querySelector('.eqh'), s = h && h.querySelector('.eqh__xp > *');
    const fit = () => {
      if (!h || !s) return;
      h.classList.remove('is-short', 'is-tight');
      if (innerWidth >= 1200) {
        const over = () => h.getBoundingClientRect().bottom + scrollY > innerHeight + 1;
        if (over()) { h.classList.add('is-short'); if (over()) h.classList.add('is-tight'); }
      }
      dispatchEvent(new Event('eqh-fit'));
    };
    fit(); addEventListener('resize', fit); addEventListener('load', fit);
    if (document.fonts) document.fonts.ready.then(fit);
  }
</script>
<script>
  // Program the board: what the visitor types shows on the VMS in the hero.
  {
    const f = document.querySelector('[data-eqv]');
    if (f) {
      const inp = f.querySelector('[data-eqv-in]'), clr = f.querySelector('[data-eqv-clr]');
      // Desktop: centre the box in the gap between the scene's bottom edge and the strip panel.
      const place = () => {
        const sr = document.querySelector('.eqh__sr'), pn = document.querySelector('.eqh__xp > *'), op = f.offsetParent;
        if (!sr || !pn || !op || getComputedStyle(f).position !== 'absolute') { f.style.removeProperty('--eqv-top'); return; }
        const a = sr.getBoundingClientRect().bottom, z = pn.getBoundingClientRect().top, o = op.getBoundingClientRect().top;
        f.style.setProperty('--eqv-top', Math.round((a + z) / 2 - f.offsetHeight / 2 - o) + 'px');
      };
      place(); addEventListener('resize', place); addEventListener('load', place); addEventListener('eqh-fit', place);
      const upd = () => { if (window.TSSVms) window.TSSVms.set(inp.value); clr.hidden = !inp.value; };
      inp.addEventListener('input', upd);
      clr.addEventListener('click', () => { inp.value = ''; upd(); inp.focus(); });
      f.addEventListener('submit', (e) => e.preventDefault());
    }
  }
  // AI Equipment Expert: which equipment fits: typed example placeholder, a short "checking our equipment" state, then the chat assistant answers.
  {
    const f = document.querySelector('[data-eqa]');
    if (f) {
      const q = f.querySelector('[data-eqa-q]'), ty = f.querySelector('[data-eqa-type]'), lab = f.querySelector('[data-eqa-lab]'), card = f.closest('.eqa__card');
      const ex = ['Closing the right lane of a highway for two weeks, need drivers warned a mile ahead', 'Overnight milling and paving, need the work area lit', 'Full road closure with a detour through town', 'Utility work near a school, want to slow traffic down'];
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let ei = 0, ci = 0, del = false, tmr;
      const tick = () => {
        if (q.value || document.activeElement === q) { ty.textContent = ''; tmr = setTimeout(tick, 600); return; }
        const t = ex[ei];
        if (!del) { ci++; ty.textContent = t.slice(0, ci); if (ci >= t.length) { del = true; tmr = setTimeout(tick, 2200); return; } tmr = setTimeout(tick, 34 + Math.random() * 40); }
        else { ci -= 3; ty.textContent = t.slice(0, Math.max(0, ci)); if (ci <= 0) { del = false; ci = 0; ei = (ei + 1) % ex.length; tmr = setTimeout(tick, 400); return; } tmr = setTimeout(tick, 14); }
      };
      if (reduce) ty.textContent = ex[0]; else {
        const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { tick(); io.disconnect(); } }); io.observe(f);
      }
      q.addEventListener('input', () => { ty.hidden = !!q.value; });
      let busy = false;
      const ask = () => {
        const t = q.value.trim(); if (!t) { q.focus(); return; }
        if (busy) return; busy = true;
        card.classList.add('is-think'); lab.textContent = 'Checking our equipment';
        setTimeout(() => {
          const msg = 'Do you have the right equipment (VMS boards, arrow boards, light towers and more) for this job? Project: ' + t;
          if (window.TSSChat) window.TSSChat.ask(msg); else location.href = '/pages/request-a-quote?type=rental';
          card.classList.remove('is-think'); lab.textContent = 'Find My Equipment'; busy = false;
        }, reduce ? 0 : 1500);
      };
      f.addEventListener('submit', (e) => { e.preventDefault(); ask(); });
      q.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); ask(); } });
      f.querySelectorAll('[data-eqa-chip]').forEach((b) => b.addEventListener('click', () => { q.value = b.textContent; ty.hidden = true; ask(); }));
    }
  }
  // Phone hero: fill the screen below the header, leaving room for iPhone Safari's floating toolbar.
  {
    const hero = document.querySelector('.eqh'), box = hero?.querySelector('.eqh__in');
