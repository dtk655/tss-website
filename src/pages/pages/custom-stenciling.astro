---
// Custom shop: in-house sign builder plus stenciled cones, branded water-filled barriers and A-frame rails.
import Layout from '../../layouts/Layout.astro';
import { PHONE, PHONE_TEL, EMAIL, FORM_WEBHOOK } from '../../lib/config.js';
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const perks = [
  ['Made in our shop', 'Printed and built in South Plainfield, NJ', 'M3 21V9l9-6 9 6v12 M9 21v-7h6v7'],
  ['Any size or legend', 'Your wording, colors and layout', 'M4 4h16v16H4z M8 9h8M8 13h5'],
  ['Reflective sheeting', 'Engineer grade to diamond grade', 'M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.5 6.7 19.4l1.2-6L3.4 9.3l6-.7z'],
  ['Ships nationwide', 'Or pick up at our yard', 'M2.5 7h11v9h-11z M13.5 10h4l3 3.5V16h-7z M6.5 19a1.7 1.7 0 1 0 0-.01 M16.5 19a1.7 1.7 0 1 0 0-.01']
];
const more = [
  { t: 'Stenciled Cones', d: 'Your department, company or initials stenciled on every cone, so your gear comes home.', img: '/custom/stenciled-cones.webp', alt: 'Orange traffic cones stenciled with department initials', pos: '50% 50%' },
  { t: 'Branded Water-Filled Barriers', d: 'Reflective wraps with your name, logo and message on WATERCADE and other barriers.', img: '/custom/police-barrier.webp', alt: 'White water-filled barrier with a blue and white police wrap', pos: '50% 50%' },
  { t: 'A-Frame Rails', d: 'Custom printed rails for A-frame barricades, from POLICE LINE to your company name.', img: '/custom/police-rail.webp', alt: 'White A-frame barricade with custom police rails', pos: '50% 55%' }
];
const steps = [
  ['Design it or describe it', 'Build a sign below, or send us your artwork and specs.'],
  ['We confirm and price it', 'Our team checks sizes, sheeting and quantities, then sends your quote.'],
  ['Made in our shop', 'Printed, cut and assembled in-house in South Plainfield, NJ.'],
  ['Pick up or ship', 'Grab it at our yard or we ship it to your job, anywhere in the U.S.']
];
const COLORS = [
  ['White', '#ffffff'], ['Yellow', '#ffcd00'], ['Fluorescent Orange', '#ff6a13'], ['Red', '#c8102e'], ['Green', '#006747'],
  ['Blue', '#0047bb'], ['Brown', '#6b4226'], ['Black', '#141414'], ['Fluorescent Yellow-Green', '#c4d600']
];
const SIZES = [[12, 18], [18, 24], [24, 24], [24, 30], [30, 30], [36, 36], [48, 48], [48, 24]];
const SHAPES = [
  ['rect', 'Rectangle', '<rect x="3" y="5" width="18" height="14" rx="2"/>'],
  ['diamond', 'Diamond', '<path d="M12 2.5 21.5 12 12 21.5 2.5 12z"/>'],
  ['octagon', 'Octagon', '<path d="M8.3 3h7.4L21 8.3v7.4L15.7 21H8.3L3 15.7V8.3z"/>'],
  ['circle', 'Circle', '<circle cx="12" cy="12" r="9"/>']
];
const ARROWS = [['none', 'None'], ['left', '←'], ['up-left', '↖'], ['up', '↑'], ['up-right', '↗'], ['right', '→']];
---
<Layout title="Custom shop" description="Custom signs in any size, color and legend, made in our South Plainfield, NJ sign shop. Plus stenciled cones, branded water-filled barriers and custom A-frame rails. Design your sign online and get a quote." image="/custom/sign-shop.webp">
  <!-- ================= HERO: live shop showcase ================= -->
  <section class="csx" data-csx>
    <div class="csx__grid-bg" aria-hidden="true"></div>
    <div class="wrap csx__in">
      <div class="csx__copy">
        <p class="csx__k"><span></span>The TSS custom shop</p>
        <h1><span class="eqh__ln"><span>Your Legend. Your Colors.</span></span> <span class="eqh__ln"><span>Made In Our Shop.</span></span></h1>
        <p class="csx__lede">48" × 48" road work signs, stenciled cones, barrier wraps and custom rails, printed and built in-house in South Plainfield, NJ.</p>
        <div class="csx__ways">
          <a href="#builder" class="csx__btn csx__btn--solid">Design a sign<Fragment set:html={ARROW} /></a>
          <a href="#more" class="csx__btn csx__btn--line">Cones, rails and barriers</a>
        </div>
        <p class="csx__call">Rather talk it through? Call <a href={PHONE_TEL}>{PHONE}</a></p>
      </div>

      <div class="csx__show">
        <div class="csx__tabs" role="tablist" aria-label="Custom shop showcase">
          <button type="button" role="tab" class="csx__tab is-on" data-csx-tab="0" aria-selected="true"><span>Signs</span><i><b></b></i></button>
          <button type="button" role="tab" class="csx__tab" data-csx-tab="1" aria-selected="false"><span>Cones</span><i><b></b></i></button>
          <button type="button" role="tab" class="csx__tab" data-csx-tab="2" aria-selected="false"><span>Barriers</span><i><b></b></i></button>
        </div>
        <div class="csx__stage">
          <span class="csx__rule csx__rule--x" aria-hidden="true"></span>
          <span class="csx__rule csx__rule--y" aria-hidden="true"></span>

          <!-- Scene 1: 48x48 road work sign (real sign blank) -->
          <figure class="sc sc--sign is-on" data-sc="0" aria-label="A 48 by 48 inch fluorescent orange ROAD WORK AHEAD sign with a black border being made">
            <svg viewBox="0 0 440 440" aria-hidden="true">
              <defs>
                <linearGradient id="alu" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e8eaec"/><stop offset=".5" stop-color="#b9bec4"/><stop offset="1" stop-color="#dfe2e5"/></linearGradient>
                <linearGradient id="glint" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".6"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
                <clipPath id="diaClip"><path d="M220 30 L408 220 L220 410 L32 220 Z"/></clipPath>
                <filter id="ink"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="1.2"/></filter>
              </defs>
              <ellipse cx="220" cy="428" rx="150" ry="8" fill="#000" opacity=".35"/>
              <g class="sg__dims">
                <path class="sg__dim" d="M232 12 L426 206" />
                <path class="sg__tick" d="M226 18 l12 -12 M420 212 l12 -12" />
                <text class="sg__dimt" x="341" y="96" transform="rotate(45 341 96)">48 in</text>
                <path class="sg__dim" d="M14 206 L208 12" />
                <path class="sg__tick" d="M8 200 l12 12 M202 6 l12 12" />
                <text class="sg__dimt" x="99" y="96" transform="rotate(-45 99 96)">48 in</text>
              </g>
              <g class="sg__blank"><path d="M220 30 L408 220 L220 410 L32 220 Z" fill="url(#alu)" stroke="#9aa0a6" stroke-width="8" stroke-linejoin="round"/></g>
              <image class="sg__photo" href="/custom/tpl/sign-diamond-orange.webp" x="18" y="16" width="404" height="407" preserveAspectRatio="xMidYMid meet" />
              <rect class="sg__squeegee" x="30" y="24" width="380" height="12" rx="6" />
              <g class="sg__legend" font-family="'Archivo Variable', Arial, sans-serif" text-anchor="middle" filter="url(#ink)">
                <text class="sg__l sg__l1" x="220" y="180">ROAD</text>
                <text class="sg__l sg__l2" x="220" y="228">WORK</text>
                <text class="sg__l sg__l3" x="220" y="276">AHEAD</text>
              </g>
              <g class="sg__head"><circle r="9" fill="none" stroke="#ffcd00" stroke-width="2.5"/><path d="M-15 0h8M7 0h8M0 -15v8M0 7v8" stroke="#ffcd00" stroke-width="2.5"/></g>
              <g clip-path="url(#diaClip)"><rect class="sg__glint" x="-160" y="0" width="120" height="440" fill="url(#glint)" transform="skewX(-18)"/></g>
            </svg>
            <figcaption class="sc__chips">
              <span style="--k:0"><b>48" × 48"</b></span>
              <span style="--k:1"><i style="--c:#ff6a13"></i>Fluorescent orange</span>
              <span style="--k:2"><i style="--c:#141414"></i>Black border</span>
              <span style="--k:3">Diamond grade</span>
            </figcaption>
          </figure>

          <!-- Scene 2: real reflective cone being stenciled -->
          <figure class="sc sc--cone" data-sc="1" aria-label="A reflective traffic cone being stenciled with a company name">
            <svg viewBox="0 0 440 440" aria-hidden="true">
              <defs>
                <mask id="stencilHoles"><rect x="150" y="284" width="140" height="44" rx="7" fill="#fff"/><text x="220" y="318" text-anchor="middle" font-family="'Archivo Variable', Arial, sans-serif" font-size="33" font-weight="800" style="font-variation-settings:'wght' 860" fill="#000" textLength="70" lengthAdjust="spacingAndGlyphs">TSS</text></mask>
                <filter id="spray"><feTurbulence type="fractalNoise" baseFrequency="1.6" numOctaves="1" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="1.6"/></filter>
              </defs>
              <ellipse cx="220" cy="426" rx="110" ry="9" fill="#000" opacity=".4"/>
              <image href="/custom/tpl/cone-reflective.webp" x="120" y="14" width="200" height="420" preserveAspectRatio="xMidYMid meet" />
              <text class="cn__paint" x="220" y="318" text-anchor="middle" font-family="'Archivo Variable', Arial, sans-serif" font-size="33" font-weight="800" style="font-variation-settings:'wght' 860; mix-blend-mode:multiply" fill="#141414" filter="url(#spray)" textLength="70" lengthAdjust="spacingAndGlyphs">TSS</text>
              <g class="cn__plate"><rect x="150" y="284" width="140" height="44" rx="7" fill="#9aa3ab" mask="url(#stencilHoles)"/><rect x="150" y="284" width="140" height="44" rx="7" fill="none" stroke="#6f7881" stroke-width="2" mask="url(#stencilHoles)"/></g>
              <g class="cn__mist">
                {Array.from({ length: 16 }).map((_, i) => <circle cx={160 + (i * 11) % 120} cy={290 + (i * 13) % 34} r={1.6 + (i % 3) * .8} style={`--m:${i}`} />)}
              </g>
              <g class="cn__can"><rect x="-14" y="-50" width="28" height="46" rx="5" fill="#141414"/><rect x="-9" y="-59" width="18" height="10" rx="3" fill="#3a3f45"/><rect x="-14" y="-38" width="28" height="10" fill="#ff6a13"/><path d="M0 -4 v9" stroke="#3a3f45" stroke-width="4"/></g>
            </svg>
            <figcaption class="sc__chips">
              <span style="--k:0"><b>Stenciled cones</b></span>
              <span style="--k:1">Your name, initials or logo</span>
              <span style="--k:2">Any size, any quantity</span>
            </figcaption>
          </figure>

          <!-- Scene 3: WATERCADE, captured from the real 3D customizer so striping and panels line up exactly -->
          <figure class="sc sc--rail" data-sc="2" aria-label="A white WATERCADE barrier getting navy and white striping and a company name on its panels">
            <svg viewBox="0 0 440 440" aria-hidden="true">
              <defs>
                <linearGradient id="scan" x1="0" x2="1"><stop offset="0" stop-color="#ffcd00" stop-opacity="0"/><stop offset=".5" stop-color="#ffcd00" stop-opacity=".95"/><stop offset="1" stop-color="#ffcd00" stop-opacity="0"/></linearGradient>
              </defs>
              <image href="/custom/tpl/watercade-0.webp" x="-40" y="76" width="520" height="267" preserveAspectRatio="xMidYMid meet" />
              <image class="wc__lay wc__lay--1" href="/custom/tpl/watercade-1.webp" x="-40" y="76" width="520" height="267" preserveAspectRatio="xMidYMid meet" />
              <image class="wc__lay wc__lay--2" href="/custom/tpl/watercade-2.webp" x="-40" y="76" width="520" height="267" preserveAspectRatio="xMidYMid meet" />
              <image class="wc__lay wc__lay--3" href="/custom/tpl/watercade-3.webp" x="-40" y="76" width="520" height="267" preserveAspectRatio="xMidYMid meet" />
              <rect class="wc__scan wc__scan--1" x="-5" y="104" width="10" height="60" rx="5" fill="url(#scan)" />
              <rect class="wc__scan wc__scan--2" x="-5" y="236" width="10" height="36" rx="5" fill="url(#scan)" />
              <rect class="wc__scan wc__scan--3" x="-5" y="274" width="10" height="36" rx="5" fill="url(#scan)" />
            </svg>
            <figcaption class="sc__chips">
              <span style="--k:0"><b>WATERCADE</b></span>
              <span style="--k:1"><i style="--c:#1f3f93"></i>Reflective striping</span>
              <span style="--k:2">Your name on the panels</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <div class="csx__ribbon" aria-hidden="true"><div class="csx__track">
    {Array.from({ length: 2 }).map(() => <span>48" × 48" Road Work Signs <i>◆</i> Stenciled Cones <i>◆</i> Barrier Wraps <i>◆</i> A-Frame Rails <i>◆</i> Fluorescent Orange <i>◆</i> Diamond Grade <i>◆</i> Any Legend <i>◆</i> Any Size <i>◆</i> </span>)}
  </div></div>

  <section class="eqp" data-in>
    <div class="wrap">
      <ul class="eqp__list">
        {perks.map(([t, d, ic], i) => (
          <li style={`--i:${i}`}>
            <span class="eqp__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ic} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span><b>{t}</b><small>{d}</small></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= SIGN BUILDER ================= -->
  <section class="sb" id="builder">
    <div class="wrap">
      <div class="eq-head">
        <div>
          <p class="eq-k"><span></span>Sign builder</p>
          <h2>Design your sign. <em>See it live.</em></h2>
        </div>
        <p class="sb__note">Pick a shape, size, colors and legend. We’ll confirm every detail before anything is made.</p>
      </div>

      <div class="sb__grid" data-sb data-webhook={FORM_WEBHOOK} data-email={EMAIL} data-phone={PHONE}>
        <!-- preview -->
        <div class="sb__stage">
          <div class="sb__canvas">
            <svg class="sb__svg" data-svg viewBox="0 0 400 300" role="img" aria-label="Preview of your custom sign"></svg>
          </div>
          <div class="sb__meta">
            <span class="sb__dims" data-dims>24" × 30"</span>
            <span class="sb__spec" data-spec>Rectangle · Blue / White · High intensity</span>
          </div>
          <button type="button" class="sb__dl" data-download>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Download preview
          </button>
        </div>

        <!-- controls -->
        <form class="sb__panel" data-form novalidate>
          <fieldset class="sb__grp">
            <legend><span>1</span>Shape and size</legend>
            <div class="sb__shapes">
              {SHAPES.map(([v, l, ic], i) => (
                <label class="sb__shape"><input type="radio" name="shape" value={v} checked={i === 0} /><span><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic} />{l}</span></label>
              ))}
            </div>
            <div class="sb__sizes" data-sizes>
              {SIZES.map(([w, h]) => <button type="button" class="sb__chip" data-size={`${w}x${h}`}>{w}" × {h}"</button>)}
            </div>
            <div class="sb__wh">
              <label><span>Width (in.)</span><input class="sb__in" type="number" name="w" min="6" max="144" value="24" inputmode="numeric" /></label>
              <span class="sb__x" aria-hidden="true">×</span>
              <label><span>Height (in.)</span><input class="sb__in" type="number" name="h" min="6" max="144" value="30" inputmode="numeric" /></label>
            </div>
          </fieldset>

          <fieldset class="sb__grp">
            <legend><span>2</span>Colors</legend>
            <p class="sb__lab">Background <b data-bgname>Blue</b></p>
            <div class="sb__sw" data-sw="bg">
              {COLORS.map(([n, c]) => <button type="button" class="sb__dot" style={`--c:${c}`} data-c={c} data-n={n} aria-label={n} title={n}></button>)}
              <label class="sb__pick" title="Custom color"><input type="color" value="#0047bb" data-custom="bg" aria-label="Custom background color" /><span>Custom</span></label>
            </div>
            <p class="sb__lab">Legend and border <b data-fgname>White</b></p>
            <div class="sb__sw" data-sw="fg">
              {COLORS.map(([n, c]) => <button type="button" class="sb__dot" style={`--c:${c}`} data-c={c} data-n={n} aria-label={n} title={n}></button>)}
              <label class="sb__pick" title="Custom color"><input type="color" value="#ffffff" data-custom="fg" aria-label="Custom legend color" /><span>Custom</span></label>
            </div>
            <label class="sb__tog"><input type="checkbox" name="border" checked /><span></span>Border</label>
          </fieldset>

          <fieldset class="sb__grp">
            <legend><span>3</span>Legend</legend>
            <label class="sb__f"><span>Text <em>One line per row, up to 5 rows</em></span><textarea class="sb__in" name="legend" rows="3" maxlength="140">SERVICE
AREA</textarea></label>
            <p class="sb__lab">Arrow</p>
            <div class="sb__arrows">
              {ARROWS.map(([v, l], i) => <label class="sb__chip sb__chip--r"><input type="radio" name="arrow" value={v} checked={v === 'up-right'} /><span>{l}</span></label>)}
            </div>
            <label class="sb__tog"><input type="checkbox" name="artwork" /><span></span>I have a logo or artwork to add</label>
          </fieldset>

          <fieldset class="sb__grp">
            <legend><span>4</span>Material and quantity</legend>
            <div class="sb__row2">
              <label class="sb__f"><span>Sheeting</span>
                <select class="sb__in" name="sheeting">
                  <option>Engineer grade</option><option selected>High intensity prismatic</option><option>Diamond grade</option><option>Not sure, recommend one</option>
                </select>
              </label>
              <label class="sb__f"><span>Material</span>
                <select class="sb__in" name="substrate">
                  <option selected>Aluminum</option><option>Corrugated plastic</option><option>Roll-up / flexible</option><option>Not sure, recommend one</option>
                </select>
              </label>
            </div>
            <div class="sb__qty">
              <span>Quantity</span>
              <div class="sb__step"><button type="button" data-q="-1" aria-label="Fewer">−</button><input class="sb__in" type="number" name="qty" min="1" value="1" inputmode="numeric" aria-label="Quantity" /><button type="button" data-q="1" aria-label="More">+</button></div>
            </div>
          </fieldset>

          <fieldset class="sb__grp">
            <legend><span>5</span>Where should we send the quote?</legend>
            <div class="sb__row2">
              <label class="sb__f"><span>Your name</span><input class="sb__in" name="name" required autocomplete="name" /></label>
              <label class="sb__f"><span>Company <em>Optional</em></span><input class="sb__in" name="company" autocomplete="organization" /></label>
            </div>
            <div class="sb__row2">
              <label class="sb__f"><span>Email</span><input class="sb__in" name="email" type="email" required autocomplete="email" /></label>
              <label class="sb__f"><span>Phone <em>Optional</em></span><input class="sb__in" name="phone" type="tel" autocomplete="tel" /></label>
            </div>
            <label class="sb__f"><span>Notes <em>Optional</em></span><textarea class="sb__in" name="notes" rows="2" placeholder="Deadline, mounting, reflective needs, anything else"></textarea></label>
          </fieldset>

          <button type="submit" class="sb__send" data-submit>Get a quote for this sign<Fragment set:html={ARROW} /></button>
          <p class="sb__msg sb__msg--ok" data-ok hidden>Got it. Our team will reply with pricing within 1 business day. If you checked artwork, email it to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
          <p class="sb__msg sb__msg--err" data-err hidden>That didn’t go through. Your email app should have opened with the details instead, or call us at {PHONE}.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- ================= MORE CUSTOM WORK ================= -->
  <section class="cm" id="more" data-in>
    <div class="wrap">
      <div class="eq-head">
        <div>
          <p class="eq-k"><span></span>Beyond signs</p>
          <h2>Your name on <em>every piece.</em></h2>
        </div>
        <a href="/tools/3d-showroom" class="eq-link">Try your logo in 3D<Fragment set:html={ARROW} /></a>
      </div>
      <ul class="cm__grid">
        {more.map((m, i) => (
          <li style={`--i:${i}`}>
            <article class="cm__card">
              <div class="cm__img"><img src={m.img} alt={m.alt} loading="lazy" style={`object-position:${m.pos}`} /></div>
              <div class="cm__body">
                <h3>{m.t}</h3>
                <p>{m.d}</p>
                <a href="/pages/request-a-quote?type=products" class="cm__go">Get a quote<Fragment set:html={ARROW} /></a>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="eqs" data-in>
    <div class="wrap">
      <div class="eq-head eq-head--center">
        <div>
          <p class="eq-k"><span></span>How custom work goes<span></span></p>
          <h2>From idea to <em>install.</em></h2>
        </div>
      </div>
      <ol class="eqs__list">
        {steps.map(([t, d], i) => (
          <li style={`--i:${i}`}>
            <span class="eqs__n">{String(i + 1).padStart(2, '0')}</span>
            <b>{t}</b>
            <small>{d}</small>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="eqc" data-in>
    <div class="wrap eqc__in">
      <div>
        <p class="eq-k eq-k--light"><span></span>Have artwork?</p>
        <h2>Send it over. <em>We’ll make it real.</em></h2>
      </div>
      <div class="eqc__acts">
        <a href="/pages/request-a-quote?type=products" class="eq-pill eq-pill--red">Request custom work<Fragment set:html={ARROW} /></a>
        <a href={`mailto:${EMAIL}?subject=${encodeURIComponent('Custom work artwork')}`} class="eq-pill eq-pill--glass">Email your artwork</a>
        <a href={PHONE_TEL} class="eqc__call">or call {PHONE}</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    // Custom shop showcase: plays each scene, then moves to the next. Tabs jump between scenes.
    const root = document.querySelector('[data-csx]');
    if (!root) return;
    const scenes = [...root.querySelectorAll('[data-sc]')];
    const tabs = [...root.querySelectorAll('[data-csx-tab]')];
    const DUR = [8200, 6600, 6000];
    let cur = 0, timer = 0, visible = true, started = 0, left = DUR[0];
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) root.setAttribute('data-static', '');
    const isStatic = () => root.hasAttribute('data-static');
    const show = (i) => {
      clearTimeout(timer);
      cur = i;
      scenes.forEach((s, k) => { s.classList.toggle('is-on', k === i); s.classList.remove('is-play'); });
      tabs.forEach((t, k) => { t.classList.toggle('is-on', k === i); t.classList.toggle('is-done', k < i); t.setAttribute('aria-selected', String(k === i)); t.style.setProperty('--dur', DUR[k] + 'ms'); const b = t.querySelector('b'); b.style.animation = 'none'; void b.offsetWidth; b.style.animation = ''; });
