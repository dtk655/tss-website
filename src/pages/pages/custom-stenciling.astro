    }
    show(0);
  })();
</script>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-sb]');
    if (!root) return;
    const form = root.querySelector('[data-form]');
    const svg = root.querySelector('[data-svg]');
    const NS = 'http://www.w3.org/2000/svg';
    const SHAPE_NAMES = { rect: 'Rectangle', diamond: 'Diamond', octagon: 'Octagon', circle: 'Circle' };
    const SQUARE = new Set(['diamond', 'octagon', 'circle']);
    const st = { bg: '#0047bb', bgName: 'Blue', fg: '#ffffff', fgName: 'White' };
    const $ = (n) => form.elements[n];
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const lum = (hex) => {
      const n = parseInt(hex.slice(1), 16);
      const c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => { v /= 255; return v <= .03928 ? v / 12.92 : ((v + .055) / 1.055) ** 2.4; });
      return .2126 * c[0] + .7152 * c[1] + .0722 * c[2];
    };
    const contrast = (a, b) => { const x = lum(a), y = lum(b); return (Math.max(x, y) + .05) / (Math.min(x, y) + .05); };
    const el = (tag, attrs, parent) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); parent && parent.appendChild(e); return e; };

    const read = () => {
      const shape = form.querySelector('[name=shape]:checked').value;
      let w = clamp(+$('w').value || 24, 6, 144);
      let h = clamp(+$('h').value || 30, 6, 144);
      if (SQUARE.has(shape)) h = w;
      return {
        shape, w, h,
        border: $('border').checked,
        legend: $('legend').value.split('\n').map((s) => s.trim()).filter(Boolean).slice(0, 5),
        arrow: form.querySelector('[name=arrow]:checked').value,
        sheeting: $('sheeting').value, substrate: $('substrate').value,
        qty: Math.max(1, Math.round(+$('qty').value || 1))
      };
    };

    // Polygon points for a shape that fills the box (x, y, w, h), scaled by k about the center.
    const outline = (shape, cx, cy, w, h, k) => {
      if (shape === 'diamond') { const r = (w / 2) * k; return `M${cx} ${cy - r}L${cx + r} ${cy}L${cx} ${cy + r}L${cx - r} ${cy}Z`; }
      if (shape === 'octagon') {
        const r = (w / 2) * k, a = r * Math.tan(Math.PI / 8);
        return `M${cx - a} ${cy - r}H${cx + a}L${cx + r} ${cy - a}V${cy + a}L${cx + a} ${cy + r}H${cx - a}L${cx - r} ${cy + a}V${cy - a}Z`;
      }
      return null;
    };

    const draw = () => {
      const s = read();
      const U = 10;
      const sw = s.w * U, sh = s.h * U;
      const diag = s.shape === 'diamond' ? sw * Math.SQRT2 : 0;
      const bw = diag || sw, bh = diag || sh;
      const pad = Math.max(bw, bh) * .05;
      const VW = bw + pad * 2, VH = bh + pad * 2;
      const cx = VW / 2, cy = VH / 2;
      svg.setAttribute('viewBox', `0 0 ${VW} ${VH}`);
      svg.innerHTML = '';
      const minD = Math.min(sw, sh);
      el('defs', {}, svg).innerHTML = `<filter id="sbSh" x="-10%" y="-10%" width="120%" height="130%"><feDropShadow dx="0" dy="${minD * .02}" stdDeviation="${minD * .025}" flood-color="#000" flood-opacity=".28"/></filter>`;
      const g = el('g', { filter: 'url(#sbSh)' }, svg);
      const edge = { stroke: 'rgba(0,0,0,.18)', 'stroke-width': minD * .006 };
      // sign face
      if (s.shape === 'rect') {
        const r = minD * .06;
        el('rect', { x: cx - sw / 2, y: cy - sh / 2, width: sw, height: sh, rx: r, fill: st.bg, ...edge }, g);
      } else if (s.shape === 'circle') {
        el('circle', { cx, cy, r: sw / 2, fill: st.bg, ...edge }, g);
      } else {
        const span = s.shape === 'diamond' ? diag : sw;
        el('path', { d: outline(s.shape, cx, cy, span, span, 1), fill: st.bg, 'stroke-linejoin': 'round', ...edge }, g);
      }
      // border
      if (s.border) {
        const bwid = minD * .022, inset = minD * .035;
        const common = { fill: 'none', stroke: st.fg, 'stroke-width': bwid, 'stroke-linejoin': 'round' };
        if (s.shape === 'rect') {
          const r = Math.max(0, minD * .06 - inset * .6);
          el('rect', { x: cx - sw / 2 + inset, y: cy - sh / 2 + inset, width: sw - inset * 2, height: sh - inset * 2, rx: r, ...common }, svg);
        } else if (s.shape === 'circle') {
          el('circle', { cx, cy, r: sw / 2 - inset, ...common }, svg);
        } else {
          const span = s.shape === 'diamond' ? diag : sw;
          const k = 1 - (inset * (s.shape === 'diamond' ? Math.SQRT2 : 1.08)) / (span / 2);
          el('path', { d: outline(s.shape, cx, cy, span, span, k), ...common }, svg);
        }
      }
      // content box
      const f = { rect: [.84, .8], diamond: [.62, .62], octagon: [.8, .62], circle: [.7, .62] }[s.shape];
      const boxW = sw * f[0], boxH = sh * f[1];
      const top = cy - boxH / 2;
      const hasArrow = s.arrow !== 'none';
      const textH = hasArrow ? (s.legend.length ? boxH * .58 : 0) : boxH;
      const arrowH = boxH - textH;
      // legend
      if (s.legend.length) {
        const n = s.legend.length;
        const lh = 1.08;
        let fs = Math.min(textH / (n * lh), boxW * .42);
        const tg = el('g', { fill: st.fg, 'font-family': "'Archivo Variable', 'Arial Narrow', Arial, sans-serif", 'font-weight': 800, style: "font-variation-settings: 'wght' 800", 'text-anchor': 'middle' }, svg);
        const nodes = s.legend.map((line) => { const t = el('text', { x: cx, 'font-size': fs }, tg); t.textContent = line; return t; });
        const widest = Math.max(...nodes.map((t) => t.getComputedTextLength() || 1));
        if (widest > boxW) fs *= boxW / widest;
        const block = n * fs * lh;
        const y0 = top + (textH - block) / 2;
        nodes.forEach((t, i) => {
          t.setAttribute('font-size', fs);
          t.setAttribute('y', y0 + fs * (i * lh + .86));
          const len = t.getComputedTextLength();
          if (len) { t.setAttribute('textLength', len); t.setAttribute('lengthAdjust', 'spacingAndGlyphs'); }
        });
      }
      // arrow
      if (hasArrow) {
        const size = Math.min(arrowH * .92, boxW * .7, s.legend.length ? Infinity : boxH * .9);
        const ax = cx, ay = top + textH + arrowH / 2;
        const rot = { up: 0, 'up-right': 45, right: 90, left: -90, 'up-left': -45 }[s.arrow];
        const u = size / 100;
        const d = `M0 ${-50 * u}L${38 * u} ${-8 * u}H${14 * u}V${50 * u}H${-14 * u}V${-8 * u}H${-38 * u}Z`;
        el('path', { d, fill: st.fg, 'stroke-linejoin': 'round', transform: `translate(${ax} ${ay}) rotate(${rot})` }, svg);
      }
      // labels
      root.querySelector('[data-dims]').textContent = `${s.w}" × ${s.h}"`;
      root.querySelector('[data-spec]').textContent = `${SHAPE_NAMES[s.shape]} · ${st.bgName} / ${st.fgName} · ${s.sheeting.replace(', recommend one', '')}`;
      root.querySelector('[data-bgname]').textContent = st.bgName;
      root.querySelector('[data-fgname]').textContent = st.fgName;
      root.querySelectorAll('[data-sw=bg] .sb__dot').forEach((b) => b.classList.toggle('is-on', b.dataset.c === st.bg));
      root.querySelectorAll('[data-sw=fg] .sb__dot').forEach((b) => b.classList.toggle('is-on', b.dataset.c === st.fg));
      const sq = SQUARE.has(s.shape);
      $('h').disabled = sq;
      if (sq) $('h').value = s.w;
      root.querySelectorAll('[data-size]').forEach((b) => {
        const [w, h] = b.dataset.size.split('x').map(Number);
        b.hidden = sq && w !== h;
        b.classList.toggle('is-on', w === s.w && h === s.h);
      });
    };

    // swatches
    root.querySelectorAll('[data-sw]').forEach((wrap) => {
      const key = wrap.dataset.sw;
      wrap.addEventListener('click', (e) => {
        const b = e.target.closest('.sb__dot'); if (!b) return;
        st[key] = b.dataset.c; st[key + 'Name'] = b.dataset.n;
        if (key === 'bg' && contrast(st.bg, st.fg) < 2.2) {
          const alt = contrast(st.bg, '#141414') > contrast(st.bg, '#ffffff') ? ['#141414', 'Black'] : ['#ffffff', 'White'];
          st.fg = alt[0]; st.fgName = alt[1];
        }
        draw();
      });
      wrap.querySelector('[data-custom]').addEventListener('input', (e) => { st[key] = e.target.value; st[key + 'Name'] = 'Custom ' + e.target.value.toUpperCase(); draw(); });
    });
    root.querySelectorAll('[data-size]').forEach((b) => b.addEventListener('click', () => {
      const [w, h] = b.dataset.size.split('x'); $('w').value = w; $('h').value = h; draw();
    }));
    root.querySelectorAll('[data-q]').forEach((b) => b.addEventListener('click', () => {
      $('qty').value = Math.max(1, (+$('qty').value || 1) + +b.dataset.q); draw();
    }));
    form.addEventListener('input', draw);
    form.addEventListener('change', draw);
    document.fonts?.ready.then(draw);
    draw();

    // keep the sticky preview just under the site header
    const hdr = document.querySelector('header');
    const setTop = () => root.style.setProperty('--hdr-h', `${Math.round(hdr.getBoundingClientRect().height)}px`);
    if (hdr) { setTop(); if ('ResizeObserver' in window) new ResizeObserver(setTop).observe(hdr); }

    // download preview as PNG
    root.querySelector('[data-download]').addEventListener('click', () => {
      const vb = svg.viewBox.baseVal;
      const scale = 1400 / Math.max(vb.width, vb.height);
      const clone = svg.cloneNode(true);
      clone.setAttribute('xmlns', NS);
      clone.setAttribute('width', Math.round(vb.width * scale));
      clone.setAttribute('height', Math.round(vb.height * scale));
      const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(clone)], { type: 'image/svg+xml' }));
      const img = new Image();
      img.onload = () => {
        const c = document.createElement('canvas');
        c.width = img.width; c.height = img.height;
        const ctx = c.getContext('2d');
        ctx.fillStyle = '#f3f4f5'; ctx.fillRect(0, 0, c.width, c.height);
        ctx.drawImage(img, 0, 0);
        URL.revokeObjectURL(url);
        const a = document.createElement('a');
        a.download = 'tss-custom-sign.png'; a.href = c.toDataURL('image/png'); a.click();
      };
      img.src = url;
    });

    // submit
    const ARR = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const s = read();
      const btn = form.querySelector('[data-submit]');
      const ok = form.querySelector('[data-ok]'), err = form.querySelector('[data-err]');
      ok.hidden = err.hidden = true;
      const answers = {
        product: 'Custom sign', shape: SHAPE_NAMES[s.shape], size: `${s.w}" x ${s.h}"`,
        background: `${st.bgName} (${st.bg})`, legendColor: `${st.fgName} (${st.fg})`, border: s.border ? 'Yes' : 'No',
        legend: s.legend.join(' / '), arrow: s.arrow, hasArtwork: $('artwork').checked ? 'Yes' : 'No',
        sheeting: s.sheeting, material: s.substrate, quantity: s.qty,
        name: $('name').value, company: $('company').value, email: $('email').value, phone: $('phone').value, notes: $('notes').value
      };
      btn.disabled = true; btn.textContent = 'Sending';
      try {
        const hook = root.dataset.webhook;
        if (!hook) throw new Error('no webhook');
        const r = await fetch(hook, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'custom-sign', page: location.pathname, submittedAt: new Date().toISOString(), answers, previewSvg: svg.outerHTML.slice(0, 60000) })
        });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        ok.hidden = false;
      } catch {
        const body = Object.entries(answers).map(([k, v]) => `${k}: ${v}`).join('\n');
        location.href = `mailto:${root.dataset.email}?subject=${encodeURIComponent('Custom sign quote: ' + answers.size)}&body=${encodeURIComponent(body)}`;
        err.hidden = false;
      } finally {
        btn.disabled = false; btn.innerHTML = 'Get a quote for this sign' + ARR;
      }
    });
  })();
</script>


<script>
  // Reveal sections (and stagger their lists) as they scroll into view.
  const els = document.querySelectorAll('[data-in]');
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) els.forEach((e) => e.classList.add('is-in'));
  else {
    const io = new IntersectionObserver((ents) => ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } }), { threshold: 0.12 });
    els.forEach((e) => io.observe(e));
  }
</script>

