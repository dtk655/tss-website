---
// Custom shop: in-house sign builder plus stenciled cones, branded water-filled barriers and A-frame rails.
import Layout from '../../layouts/Layout.astro';
import CustomBuilder from '../../components/CustomBuilder.astro';
import { PHONE, PHONE_TEL, EMAIL, FORM_WEBHOOK } from '../../lib/config.js';
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const perks = [
  ['Made in our shop', 'Printed and built in South Plainfield, NJ', 'M3 21V9l9-6 9 6v12 M9 21v-7h6v7'],
  ['Any size or legend', 'Your wording, colors and layout', 'M4 4h16v16H4z M8 9h8M8 13h5'],
  ['Reflective sheeting', 'Engineer grade to diamond grade', 'M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.5 6.7 19.4l1.2-6L3.4 9.3l6-.7z'],
  ['Ships nationwide', 'Or pick up at our yard', 'M2.5 7h11v9h-11z M13.5 10h4l3 3.5V16h-7z M6.5 19a1.7 1.7 0 1 0 0-.01 M16.5 19a1.7 1.7 0 1 0 0-.01']
];
const more = [
  { go: 'cone', t: 'Stenciled Cones', d: 'Your department, company or initials stenciled on every cone, so your gear comes home.', img: '/custom/stenciled-cones.webp', alt: 'Orange traffic cones stenciled with department initials', pos: '50% 50%' },
  { t: 'Branded Water-Filled Barriers', d: 'Reflective wraps with your name, logo and message on WATERCADE and other barriers.', img: '/custom/police-barrier.webp', alt: 'White water-filled barrier with a blue and white police wrap', pos: '50% 50%' },
  { go: 'aframe', t: 'A-Frame Rails', d: 'Custom printed rails for A-frame barricades, from POLICE LINE to your company name.', img: '/custom/police-rail.webp', alt: 'White A-frame barricade with custom police rails', pos: '50% 55%' }
];
const steps = [
  ['Design it or describe it', 'Build a sign below, or send us your artwork and specs.'],
  ['We confirm and price it', 'Our team checks sizes, sheeting and quantities, then sends your quote.'],
  ['Made in our shop', 'Printed, cut and assembled in-house in South Plainfield, NJ.'],
  ['Pick up or ship', 'Grab it at our yard or we ship it to your job, anywhere in the U.S.']
];
const COLORS = [
  ['White', '#ffffff'], ['Yellow', '#ffcd00'], ['Fluorescent Orange', '#ff6a13'], ['Red', '#c8102e'], ['Green', '#006747'],
  ['Blue', '#0047bb'], ['Brown', '#6b4226'], ['Black', '#141414'], ['Fluorescent Yellow-Green', '#c4d600']
];
const SIZES = [[12, 18], [18, 24], [24, 24], [24, 30], [30, 30], [36, 36], [48, 48], [48, 24]];
const SHAPES = [
  ['rect', 'Rectangle', '<rect x="3" y="5" width="18" height="14" rx="2"/>'],
  ['diamond', 'Diamond', '<path d="M12 2.5 21.5 12 12 21.5 2.5 12z"/>'],
  ['octagon', 'Octagon', '<path d="M8.3 3h7.4L21 8.3v7.4L15.7 21H8.3L3 15.7V8.3z"/>'],
  ['circle', 'Circle', '<circle cx="12" cy="12" r="9"/>']
];
const ARROWS = [['none', 'None'], ['left', '←'], ['up-left', '↖'], ['up', '↑'], ['up-right', '↗'], ['right', '→']];
---
<Layout title="Custom shop" description="Custom signs in any size, color and legend, made in our South Plainfield, NJ sign shop. Plus stenciled cones, branded water-filled barriers and custom A-frame rails. Design your sign online and get a quote." image="/custom/sign-shop.webp">
  <!-- ================= HERO: live shop showcase ================= -->
  <section class="csx" data-csx>
    <div class="csx__grid-bg" aria-hidden="true"></div>
    <div class="wrap csx__in">
      <div class="csx__copy">
        <p class="csx__k"><span></span>The TSS custom shop</p>
        <h1><span class="eqh__ln"><span>Your Legend. Your Colors.</span></span> <span class="eqh__ln"><span>Made In Our Shop.</span></span></h1>
        <p class="csx__lede">48" × 48" road work signs, stenciled cones, barrier wraps and custom rails, printed and built in-house in South Plainfield, NJ.</p>
        <div class="csx__ways">
          <a href="#builder" class="csx__btn csx__btn--solid">Design a sign<Fragment set:html={ARROW} /></a>
          <a href="#more" class="csx__btn csx__btn--line">Cones, rails and barriers</a>
        </div>
        <p class="csx__call">Rather talk it through? Call <a href={PHONE_TEL}>{PHONE}</a></p>
      </div>

      <div class="csx__show">
        <div class="csx__tabs" role="tablist" aria-label="Custom shop showcase">
          <button type="button" role="tab" class="csx__tab is-on" data-csx-tab="0" aria-selected="true"><span>Signs</span><i><b></b></i></button>
          <button type="button" role="tab" class="csx__tab" data-csx-tab="1" aria-selected="false"><span>Cones</span><i><b></b></i></button>
          <button type="button" role="tab" class="csx__tab" data-csx-tab="2" aria-selected="false"><span>Barriers</span><i><b></b></i></button>
        </div>
        <div class="csx__stage">
          <span class="csx__rule csx__rule--x" aria-hidden="true"></span>
          <span class="csx__rule csx__rule--y" aria-hidden="true"></span>

          <!-- Scene 1: 48x48 road work sign (real sign blank) -->
          <figure class="sc sc--sign is-on" data-sc="0" aria-label="A 48 by 48 inch fluorescent orange ROAD WORK AHEAD sign with a black border being made">
            <svg viewBox="0 0 440 440" aria-hidden="true">
              <defs>
                <linearGradient id="alu" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e8eaec"/><stop offset=".5" stop-color="#b9bec4"/><stop offset="1" stop-color="#dfe2e5"/></linearGradient>
                <linearGradient id="glint" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".6"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
                <clipPath id="diaClip"><path d="M220 30 L408 220 L220 410 L32 220 Z"/></clipPath>
                <filter id="ink"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="1.2"/></filter>
              </defs>
              <ellipse cx="220" cy="428" rx="150" ry="8" fill="#000" opacity=".35"/>
              <g class="sg__dims">
                <path class="sg__dim" d="M232 12 L426 206" />
                <path class="sg__tick" d="M226 18 l12 -12 M420 212 l12 -12" />
                <text class="sg__dimt" x="341" y="96" transform="rotate(45 341 96)">48 in</text>
                <path class="sg__dim" d="M14 206 L208 12" />
                <path class="sg__tick" d="M8 200 l12 12 M202 6 l12 12" />
                <text class="sg__dimt" x="99" y="96" transform="rotate(-45 99 96)">48 in</text>
              </g>
              <g class="sg__blank"><path d="M220 30 L408 220 L220 410 L32 220 Z" fill="url(#alu)" stroke="#9aa0a6" stroke-width="8" stroke-linejoin="round"/></g>
              <image class="sg__photo" href="/custom/tpl/sign-diamond-orange.webp" x="18" y="16" width="404" height="407" preserveAspectRatio="xMidYMid meet" />
              <rect class="sg__squeegee" x="30" y="24" width="380" height="12" rx="6" />
              <g class="sg__legend" font-family="'Archivo Variable', Arial, sans-serif" text-anchor="middle" filter="url(#ink)">
                <text class="sg__l sg__l1" x="220" y="180">ROAD</text>
                <text class="sg__l sg__l2" x="220" y="228">WORK</text>
                <text class="sg__l sg__l3" x="220" y="276">AHEAD</text>
              </g>
              <g class="sg__head"><circle r="9" fill="none" stroke="#ffcd00" stroke-width="2.5"/><path d="M-15 0h8M7 0h8M0 -15v8M0 7v8" stroke="#ffcd00" stroke-width="2.5"/></g>
              <g clip-path="url(#diaClip)"><rect class="sg__glint" x="-160" y="0" width="120" height="440" fill="url(#glint)" transform="skewX(-18)"/></g>
            </svg>
            <figcaption class="sc__chips">
              <span style="--k:0"><b>48" × 48"</b></span>
              <span style="--k:1"><i style="--c:#ff6a13"></i>Fluorescent orange</span>
              <span style="--k:2"><i style="--c:#141414"></i>Black border</span>
              <span style="--k:3">Diamond grade</span>
            </figcaption>
          </figure>

          <!-- Scene 2: real reflective cone being stenciled -->
          <figure class="sc sc--cone" data-sc="1" aria-label="A reflective traffic cone being stenciled with a company name">
            <svg viewBox="0 0 440 440" aria-hidden="true">
              <defs>
                <mask id="stencilHoles"><rect x="150" y="284" width="140" height="44" rx="7" fill="#fff"/><text x="220" y="318" text-anchor="middle" font-family="'Archivo Variable', Arial, sans-serif" font-size="33" font-weight="800" style="font-variation-settings:'wght' 860" fill="#000" textLength="70" lengthAdjust="spacingAndGlyphs">TSS</text></mask>
                <filter id="spray"><feTurbulence type="fractalNoise" baseFrequency="1.6" numOctaves="1" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="1.6"/></filter>
              </defs>
              <ellipse cx="220" cy="426" rx="110" ry="9" fill="#000" opacity=".4"/>
              <image href="/custom/tpl/cone-reflective.webp" x="120" y="14" width="200" height="420" preserveAspectRatio="xMidYMid meet" />
              <text class="cn__paint" x="220" y="318" text-anchor="middle" font-family="'Archivo Variable', Arial, sans-serif" font-size="33" font-weight="800" style="font-variation-settings:'wght' 860; mix-blend-mode:multiply" fill="#141414" filter="url(#spray)" textLength="70" lengthAdjust="spacingAndGlyphs">TSS</text>
              <g class="cn__plate"><rect x="150" y="284" width="140" height="44" rx="7" fill="#9aa3ab" mask="url(#stencilHoles)"/><rect x="150" y="284" width="140" height="44" rx="7" fill="none" stroke="#6f7881" stroke-width="2" mask="url(#stencilHoles)"/></g>
              <g class="cn__mist">
                {Array.from({ length: 16 }).map((_, i) => <circle cx={160 + (i * 11) % 120} cy={290 + (i * 13) % 34} r={1.6 + (i % 3) * .8} style={`--m:${i}`} />)}
              </g>
              <g class="cn__can"><rect x="-14" y="-50" width="28" height="46" rx="5" fill="#141414"/><rect x="-9" y="-59" width="18" height="10" rx="3" fill="#3a3f45"/><rect x="-14" y="-38" width="28" height="10" fill="#ff6a13"/><path d="M0 -4 v9" stroke="#3a3f45" stroke-width="4"/></g>
            </svg>
            <figcaption class="sc__chips">
              <span style="--k:0"><b>Stenciled cones</b></span>
              <span style="--k:1">Your name, initials or logo</span>
              <span style="--k:2">Any size, any quantity</span>
            </figcaption>
          </figure>

          <!-- Scene 3: WATERCADE, captured from the real 3D customizer so striping and panels line up exactly -->
          <figure class="sc sc--rail" data-sc="2" aria-label="A white WATERCADE barrier getting navy and white striping and a company name on its panels">
            <svg viewBox="0 0 440 440" aria-hidden="true">
              <defs>
                <linearGradient id="scan" x1="0" x2="1"><stop offset="0" stop-color="#ffcd00" stop-opacity="0"/><stop offset=".5" stop-color="#ffcd00" stop-opacity=".95"/><stop offset="1" stop-color="#ffcd00" stop-opacity="0"/></linearGradient>
              </defs>
              <image href="/custom/tpl/watercade-0.webp" x="-40" y="76" width="520" height="267" preserveAspectRatio="xMidYMid meet" />
              <image class="wc__lay wc__lay--1" href="/custom/tpl/watercade-1.webp" x="-40" y="76" width="520" height="267" preserveAspectRatio="xMidYMid meet" />
              <image class="wc__lay wc__lay--2" href="/custom/tpl/watercade-2.webp" x="-40" y="76" width="520" height="267" preserveAspectRatio="xMidYMid meet" />
              <image class="wc__lay wc__lay--3" href="/custom/tpl/watercade-3.webp" x="-40" y="76" width="520" height="267" preserveAspectRatio="xMidYMid meet" />
              <rect class="wc__scan wc__scan--1" x="-5" y="104" width="10" height="60" rx="5" fill="url(#scan)" />
              <rect class="wc__scan wc__scan--2" x="-5" y="236" width="10" height="36" rx="5" fill="url(#scan)" />
              <rect class="wc__scan wc__scan--3" x="-5" y="274" width="10" height="36" rx="5" fill="url(#scan)" />
            </svg>
            <figcaption class="sc__chips">
              <span style="--k:0"><b>WATERCADE</b></span>
              <span style="--k:1"><i style="--c:#1f3f93"></i>Reflective striping</span>
              <span style="--k:2">Your name on the panels</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <div class="csx__rw">
  <div class="csx__ribbon" aria-hidden="true"><div class="csx__track">
    {Array.from({ length: 2 }).map(() => <span>48" × 48" Road Work Signs <i>◆</i> Stenciled Cones <i>◆</i> Barrier Wraps <i>◆</i> A-Frame Rails <i>◆</i> Fluorescent Orange <i>◆</i> Diamond Grade <i>◆</i> Any Legend <i>◆</i> Any Size <i>◆</i> </span>)}
  </div></div>
  </div>

  <section class="eqp" data-in>
    <div class="wrap">
      <ul class="eqp__list">
        {perks.map(([t, d, ic], i) => (
          <li style={`--i:${i}`}>
            <span class="eqp__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ic} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span><b>{t}</b><small>{d}</small></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= SIGN BUILDER ================= -->
  <CustomBuilder />

  <!-- ================= MORE CUSTOM WORK ================= -->
  <section class="cm" id="more" data-in>
    <div class="wrap">
      <div class="eq-head">
        <div>
          <p class="eq-k"><span></span>Beyond signs</p>
          <h2>Your name on <em>every piece.</em></h2>
        </div>
        <a href="/tools/3d-showroom" class="eq-link">Try your logo in 3D<Fragment set:html={ARROW} /></a>
      </div>
      <ul class="cm__grid">
        {more.map((m, i) => (
          <li style={`--i:${i}`}>
            <article class="cm__card">
              <div class="cm__img"><img src={m.img} alt={m.alt} loading="lazy" style={`object-position:${m.pos}`} /></div>
              <div class="cm__body">
                <h3>{m.t}</h3>
                <p>{m.d}</p>
                {m.go ? <a href="#builder" class="cm__go" data-kind-go={m.go}>Customize it<Fragment set:html={ARROW} /></a> : <a href="/watercade/#customize" class="cm__go">Open the WATERCADE builder<Fragment set:html={ARROW} /></a>}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="eqs" data-in>
    <div class="wrap">
      <div class="eq-head eq-head--center">
        <div>
          <p class="eq-k"><span></span>How custom work goes<span></span></p>
          <h2>From idea to <em>install.</em></h2>
        </div>
      </div>
      <ol class="eqs__list">
        {steps.map(([t, d], i) => (
          <li style={`--i:${i}`}>
            <span class="eqs__n">{String(i + 1).padStart(2, '0')}</span>
            <b>{t}</b>
            <small>{d}</small>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="eqc" data-in>
    <div class="wrap eqc__in">
      <div>
        <p class="eq-k eq-k--light"><span></span>Have artwork?</p>
        <h2>Send it over. <em>We’ll make it real.</em></h2>
      </div>
      <div class="eqc__acts">
        <a href="/pages/request-a-quote?type=products" class="eq-pill eq-pill--red">Request custom work<Fragment set:html={ARROW} /></a>
        <a href={`mailto:${EMAIL}?subject=${encodeURIComponent('Custom work artwork')}`} class="eq-pill eq-pill--glass">Email your artwork</a>
        <a href={PHONE_TEL} class="eqc__call">or call {PHONE}</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    // Custom shop showcase: plays each scene, then moves to the next. Tabs jump between scenes.
    const root = document.querySelector('[data-csx]');
    if (!root) return;
    const scenes = [...root.querySelectorAll('[data-sc]')];
    const tabs = [...root.querySelectorAll('[data-csx-tab]')];
    const DUR = [3650, 3750, 3750];
    let cur = 0, timer = 0, visible = true, started = 0, left = DUR[0];
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) root.setAttribute('data-static', '');
    const isStatic = () => root.hasAttribute('data-static');
    const show = (i) => {
      clearTimeout(timer);
      cur = i;
      scenes.forEach((s, k) => { s.classList.toggle('is-on', k === i); s.classList.remove('is-play'); });
      tabs.forEach((t, k) => { t.classList.toggle('is-on', k === i); t.classList.toggle('is-done', k < i); t.setAttribute('aria-selected', String(k === i)); t.style.setProperty('--dur', DUR[k] + 'ms'); const b = t.querySelector('b'); b.style.animation = 'none'; void b.offsetWidth; b.style.animation = ''; });
      if (isStatic()) return;
      void scenes[i].offsetWidth;
      scenes[i].classList.add('is-play');
      left = DUR[i]; started = performance.now();
      if (visible) timer = setTimeout(() => show((i + 1) % scenes.length), left);
    };
    tabs.forEach((t, k) => t.addEventListener('click', () => show(k)));
    // pause the timeline while the hero is off screen
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([en]) => {
        if (isStatic()) return;
        visible = en.isIntersecting;
        if (!visible) { clearTimeout(timer); left -= performance.now() - started; root.setAttribute('data-paused', ''); scenes[cur].style.animationPlayState = 'paused'; scenes[cur].querySelectorAll('*').forEach((n) => (n.style.animationPlayState = 'paused')); }
        else if (root.hasAttribute('data-paused')) { root.removeAttribute('data-paused'); scenes[cur].querySelectorAll('*').forEach((n) => (n.style.animationPlayState = '')); started = performance.now(); timer = setTimeout(() => show((cur + 1) % scenes.length), Math.max(400, left)); }
      }, { threshold: 0.2 }).observe(root);
    }
    show(0);
  })();
</script>



<script>
  // Reveal sections (and stagger their lists) as they scroll into view.
  const els = document.querySelectorAll('[data-in]');
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) els.forEach((e) => e.classList.add('is-in'));
  else {
    const io = new IntersectionObserver((ents) => ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } }), { threshold: 0.12 });
    els.forEach((e) => io.observe(e));
  }
</script>

<style>
  /* ---------- shared section language (matches the homepage) ---------- */
  .eq-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 40px; margin-bottom: clamp(24px, 3vw, 40px); }
  .eq-head--center { justify-content: center; text-align: center; }
  .eq-head--center .eq-k { justify-content: center; }
  .eq-k { display: flex; align-items: center; gap: 12px; margin: 0 0 14px; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; font-variation-settings: 'wght' 680; color: var(--steel); }
  .eq-k span { width: 34px; height: 3px; border-radius: 2px; background: var(--red); }
  .eq-k--light { color: rgba(255, 255, 255, .8); }
  .eq-head h2, .eqc h2 { margin: 0; font-size: clamp(2.2rem, 4.6vw, 4.2rem); line-height: .98; letter-spacing: -.04em; font-variation-settings: 'wght' 780; font-weight: 400; text-wrap: balance; }
  .eq-head h2 em, .eqc h2 em { font-style: normal; color: var(--red); }
  .eq-link { display: inline-flex; align-items: center; gap: 10px; padding: 13px 22px 12px; border-radius: 999px; border: 1.5px solid var(--line-dark); color: var(--ink); font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, color .2s, border-color .2s; }
  .eq-link :global(svg) { width: 17px; height: 17px; transition: transform .2s; }
  .eq-link:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
  .eq-link:hover :global(svg) { transform: translateX(3px); }
  .eq-link--light { color: #fff; border-color: rgba(255, 255, 255, .35); }
  .eq-link--light:hover { background: #fff; color: var(--ink); border-color: #fff; }
  .eq-pill { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 14px 26px 13px; border-radius: 999px; font-size: 1.02rem; font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, transform .2s; }
  .eq-pill :global(svg) { width: 18px; height: 18px; transition: transform .2s; }
  .eq-pill:hover :global(svg) { transform: translateX(3px); }
  .eq-pill--red { background: var(--red); color: #fff; }
  .eq-pill--red:hover { background: #d10a0a; }
  .eq-pill--white { background: #fff; color: var(--ink); }
  .eq-pill--white:hover { background: #f1f2f3; }
  .eq-pill--glass { background: rgba(255, 255, 255, .08); color: #fff; border: 1.5px solid rgba(255, 255, 255, .4); }
  .eq-pill--glass:hover { background: rgba(255, 255, 255, .16); }
  [data-in] li { opacity: 0; transform: translateY(18px); transition: opacity .6s, transform .7s cubic-bezier(.2, .8, .2, 1); transition-delay: calc(var(--i, 0) * 60ms); }
  [data-in].is-in li { opacity: 1; transform: none; }

  /* ---------- hero ---------- */
  .eqh { position: relative; color: #fff; overflow: hidden; background: #14171a; isolation: isolate; }
  .eqh::before { content: ''; position: absolute; inset: 0; z-index: -2; background: url('/custom/sign-shop.webp') 70% 40% / cover no-repeat; transform: scale(1.06); animation: eqZoom 18s ease-out forwards; }
  .eqh::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(12, 13, 15, .94) 0%, rgba(12, 13, 15, .82) 34%, rgba(12, 13, 15, .35) 62%, rgba(12, 13, 15, .1) 82%), linear-gradient(0deg, rgba(10, 10, 12, .5), transparent 45%); }
  @keyframes eqZoom { to { transform: scale(1); } }
  .eqh__in { display: grid; align-content: center; justify-items: start; min-height: clamp(440px, 46vw, 640px); padding-block: clamp(40px, 5vw, 76px); }
  .eqh__in > * { max-width: 760px; }
  .eqh__in > h1 { max-width: 1100px; }
  .eqh__k { margin: 0 0 12px; color: var(--gold); font-size: clamp(.92rem, 1.05vw, 1.05rem); letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 700; opacity: 0; animation: eqFade .8s .2s ease forwards; }
  .eqh h1 { margin: 0 0 16px; font-size: clamp(2.4rem, 5vw, 4.8rem); line-height: 1.02; letter-spacing: -.03em; font-variation-settings: 'wght' 790; font-weight: 400; color: #fff; }
  .eqh__ln { display: block; overflow: hidden; padding-bottom: .05em; }
  .eqh__ln > span { display: inline-block; transform: translateY(105%); animation: eqRise 1s cubic-bezier(.2, .8, .2, 1) forwards; }
  .eqh__ln + .eqh__ln > span { animation-delay: .12s; color: var(--gold); }
  .eqh__lede { margin: 0 0 26px; max-width: 48ch; color: #e6e8ea; font-size: clamp(1.05rem, 1.35vw, 1.24rem); line-height: 1.5; text-wrap: balance; opacity: 0; transform: translateY(12px); animation: eqUp .8s .55s cubic-bezier(.2, .8, .2, 1) forwards; }
  .eqh__ways { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; width: 100%; max-width: 700px; }
  .eqh__ways .eway { opacity: 0; translate: 0 16px; animation: eqUpT .8s .65s cubic-bezier(.2, .8, .2, 1) forwards; }
  .eqh__ways .eway + .eway { animation-delay: .77s; }
  .eqh__call { margin: 14px 0 0; color: #cfd3d7; font-size: .95rem; opacity: 0; animation: eqFade .8s .9s ease forwards; }
  .eqh__call a { color: #fff; font-variation-settings: 'wght' 700; text-decoration: underline; text-underline-offset: 3px; }
  @keyframes eqRise { to { transform: none; } }
  @keyframes eqFade { to { opacity: 1; } }
  @keyframes eqUp { to { opacity: 1; transform: none; } }
  @keyframes eqUpT { to { opacity: 1; translate: 0 0; } }
  .eway { display: grid; grid-template-columns: 38px 1fr 18px; align-items: center; gap: 10px; padding: 14px; border-radius: 14px; text-decoration: none; transition: transform .2s, background .15s, border-color .15s, box-shadow .2s; }
  .eway:hover { transform: translateY(-2px); }
  .eway--solid { background: #fff; color: var(--ink); box-shadow: 0 18px 34px -18px rgba(0, 0, 0, .6); }
  .eway--line { border: 1.5px solid rgba(255, 255, 255, .55); color: #fff; background: rgba(255, 255, 255, .06); }
  .eway--line:hover { background: rgba(255, 255, 255, .12); border-color: #fff; }
  .eway__ic { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; background: var(--red); color: #fff; }
  .eway--line .eway__ic { background: rgba(255, 255, 255, .14); }
  .eway__ic svg { width: 22px; height: 22px; }
  .eway__t b { display: block; font-size: .98rem; line-height: 1.2; white-space: nowrap; font-variation-settings: 'wght' 720; }
  .eway__t small { display: block; margin-top: 3px; font-size: .84rem; line-height: 1.3; opacity: .75; }
  .eway--solid .eway__t b { color: var(--red); }
  .eway :global(.eway__go) { width: 18px; height: 18px; transition: transform .2s; }
  .eway:hover :global(.eway__go) { transform: translateX(3px); }

  /* ---------- perks ---------- */
  .eqp { background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .eqp__list { list-style: none; margin: 0; padding: clamp(22px, 2.6vw, 34px) 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2vw, 32px); }
  .eqp__list li { display: grid; grid-template-columns: 46px minmax(0, 1fr); gap: 14px; align-items: start; }
  .eqp__ic { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: var(--red-tint); color: var(--red); }
  .eqp__ic svg { width: 24px; height: 24px; }
  .eqp b { display: block; font-size: 1.04rem; font-variation-settings: 'wght' 720; margin: 2px 0 3px; }
  .eqp small { display: block; color: var(--steel); font-size: .9rem; line-height: 1.45; }

  /* ---------- lineup ---------- */
  .eql { padding: clamp(56px, 7vw, 100px) 0; background: #fff; }
  .eql__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); gap: clamp(10px, 1.2vw, 16px); }
  .eqt { position: relative; display: grid; grid-template-rows: auto 1fr; height: 100%; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; text-decoration: none; color: var(--ink); background: linear-gradient(185deg, var(--tint) 0%, #fff 72%); transition: transform .45s cubic-bezier(.2, .8, .2, 1), box-shadow .45s, border-color .3s; }
  .eqt:hover { transform: translateY(-6px); border-color: var(--line-dark); box-shadow: 0 28px 50px -30px rgba(20, 23, 26, .5); }
  .eqt__img { display: grid; place-items: center; padding: 18px 18px 6px; overflow: hidden; }
  .eqt__img img { display: block; width: 100%; height: clamp(150px, 12.5vw, 210px); object-fit: contain; filter: drop-shadow(0 16px 14px rgba(20, 23, 26, .2)); transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
  .eqt__img img.is-blend { mix-blend-mode: multiply; filter: none; }
  .eqt:hover .eqt__img img { transform: translateY(-6px) scale(1.05); }
  .eqt__txt { display: grid; align-content: start; gap: 6px; padding: 8px 20px 20px; }
  .eqt__txt b { font-size: clamp(1.08rem, 1.25vw, 1.25rem); line-height: 1.15; letter-spacing: -.015em; font-variation-settings: 'wght' 750; }
  .eqt__txt small { color: var(--steel); font-size: .9rem; line-height: 1.4; }
  .eqt__mode { display: inline-flex; align-items: center; gap: 4px; margin-top: 6px; color: var(--red); font-size: .88rem; font-variation-settings: 'wght' 700; }
  .eqt__mode :global(svg) { width: 14px; height: 14px; transition: transform .2s; }
  .eqt:hover .eqt__mode :global(svg) { transform: translateX(3px); }
  .eqt:hover .eqt__txt b { color: var(--red); }

  /* ---------- rent or buy ---------- */
  .eqr { padding: clamp(56px, 7vw, 100px) 0; background: var(--haze); }
  .eqr__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px); }
  .eqr__card { display: grid; align-content: start; gap: 14px; padding: clamp(24px, 3vw, 44px); border-radius: 24px; background: #fff; border: 1px solid var(--line); }
  .eqr__card--dark { background: linear-gradient(160deg, #1d2126, #121417); color: #fff; border-color: #1d2126; }
  .eqr__tag { justify-self: start; margin: 0; padding: 5px 14px; border-radius: 999px; background: var(--red-tint); color: var(--red); font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 760; }
  .eqr__card--dark .eqr__tag { background: rgba(255, 255, 255, .1); color: var(--gold); }
  .eqr h3 { margin: 0; font-size: clamp(1.5rem, 2.2vw, 2.1rem); line-height: 1.08; letter-spacing: -.03em; font-variation-settings: 'wght' 760; font-weight: 400; }
  .eqr ul { list-style: none; margin: 4px 0 10px; padding: 0; display: grid; gap: 12px; }
  .eqr li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; font-size: 1rem; line-height: 1.45; color: var(--ink-2); opacity: 1; transform: none; }
  .eqr__card--dark li { color: #d6d9dc; }
  .eqr li :global(svg) { width: 22px; height: 22px; color: var(--red); }
  .eqr__card--dark li :global(svg) { color: var(--gold); }
  .eqr__card .eq-pill { justify-self: start; }
  .eqr__calc { margin: 22px 0 0; text-align: center; color: var(--steel); }
  .eqr__calc a { color: var(--red); font-variation-settings: 'wght' 700; text-underline-offset: 3px; }

  /* ---------- fleet ---------- */
  .eqf { padding: clamp(56px, 7vw, 100px) 0; background: linear-gradient(180deg, #15181c, #1d2126); color: #fff; }
  .eqf__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: clamp(10px, 1.2vw, 16px); }
  .eqft { display: grid; gap: 6px; height: 100%; padding: 18px 20px 20px; border-radius: 20px; text-decoration: none; color: #fff; background: rgba(255, 255, 255, .05); border: 1px solid rgba(255, 255, 255, .1); transition: background .3s, border-color .3s, transform .45s cubic-bezier(.2, .8, .2, 1); }
  .eqft:hover { background: rgba(255, 255, 255, .09); border-color: rgba(255, 255, 255, .25); transform: translateY(-5px); }
  .eqft__img { display: grid; place-items: center; padding: 12px; margin-bottom: 6px; border-radius: 14px; overflow: hidden; background: radial-gradient(closest-side, rgba(255, 255, 255, .95), rgba(255, 255, 255, .82)); }
  .eqft__img img { display: block; width: 100%; height: clamp(110px, 9.5vw, 160px); object-fit: contain; filter: drop-shadow(0 12px 12px rgba(0, 0, 0, .25)); transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
  .eqft__img img.is-blend { mix-blend-mode: multiply; filter: none; }
  .eqft:hover .eqft__img img { transform: translateY(-4px) scale(1.05); }
  .eqft b { font-size: 1.1rem; line-height: 1.2; font-variation-settings: 'wght' 740; }
  .eqft small { color: #b9bfc6; font-size: .9rem; line-height: 1.4; }
  .eqft__mode { display: inline-flex; align-items: center; gap: 4px; margin-top: 4px; color: var(--gold); font-size: .88rem; font-variation-settings: 'wght' 700; }
  .eqft__mode :global(svg) { width: 14px; height: 14px; transition: transform .2s; }
  .eqft:hover .eqft__mode :global(svg) { transform: translateX(3px); }

  /* ---------- steps ---------- */
  .eqs { padding: clamp(56px, 7vw, 100px) 0; background: #fff; }
  .eqs__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px); counter-reset: s; }
  .eqs__list li { position: relative; display: grid; align-content: start; gap: 8px; padding: 26px 24px 28px; border-radius: 20px; border: 1px solid var(--line); background: #fff; }
  .eqs__list li::after { content: ''; position: absolute; top: 44px; right: calc(-1 * clamp(12px, 1.6vw, 22px)); width: clamp(12px, 1.6vw, 22px); height: 2px; background: var(--line-dark); }
  .eqs__list li:last-child::after { display: none; }
  .eqs__n { display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 6px; border-radius: 50%; background: var(--red); color: #fff; font-size: .9rem; letter-spacing: .04em; font-variation-settings: 'wght' 760; }
  .eqs b { font-size: 1.15rem; font-variation-settings: 'wght' 740; }
  .eqs small { color: var(--steel); font-size: .95rem; line-height: 1.45; }

  /* ---------- final CTA ---------- */
  .eqc { padding: clamp(56px, 7vw, 100px) 0; background: radial-gradient(120% 140% at 85% 0%, #3a0505 0%, #16181b 55%); color: #fff; }
  .eqc__in { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 26px 40px; }
  .eqc h2 { color: #fff; max-width: 16ch; }
  .eqc__acts { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .eqc__call { color: #cfd3d7; text-decoration: underline; text-underline-offset: 3px; margin-left: 4px; }
  .eqc__call:hover { color: #fff; }

  /* ---------- responsive ---------- */
  @media (max-width: 1100px) {
    .eqp__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .eqs__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .eqs__list li::after { display: none; }
    .eqh::after { background: linear-gradient(180deg, rgba(12, 13, 15, .9) 0%, rgba(12, 13, 15, .72) 45%, rgba(12, 13, 15, .4) 100%); }
  }
  @media (max-width: 720px) {
    .eqr__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .eqh__in { min-height: 0; padding-block: 34px 36px; justify-items: center; text-align: center; }
    .eqh__k { font-size: .78rem; margin-bottom: 8px; }
    .eqh h1 { font-size: clamp(1.9rem, 8.6vw, 2.4rem); margin-bottom: 10px; }
    .eqh__lede { font-size: 1rem; margin: 0 auto 20px; }
    .eqh__ways { grid-template-columns: 1fr; text-align: left; }
    .eqp__list { grid-template-columns: 1fr; gap: 16px; }
    .eql__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .eqt { border-radius: 16px; }
    .eqt__img { padding: 12px 10px 4px; }
    .eqt__img img { height: 110px; }
    .eqt__txt { padding: 6px 12px 14px; }
    .eqt__txt b { font-size: .98rem; }
    .eqt__txt small { display: none; }
    .eqf__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .eqft { padding: 12px 12px 14px; border-radius: 16px; }
    .eqft__img img { height: 90px; }
    .eqft b { font-size: .98rem; }
    .eqft small { display: none; }
    .eqs__list { grid-template-columns: 1fr; }
    .eq-head { justify-content: center; text-align: center; }
    .eq-head .eq-k { justify-content: center; }
    .eqc__in { justify-content: center; text-align: center; }
    .eqc h2 { margin-inline: auto; }
    .eqc__acts { justify-content: center; width: 100%; }
    .eqc__acts .eq-pill { width: 100%; }
    .eqr__card .eq-pill { justify-self: stretch; }
  }
  @media (prefers-reduced-motion: reduce) {
    .eqh::before, .eqh__k, .eqh__ln > span, .eqh__lede, .eqh__call, .eqh__ways .eway { animation: none; opacity: 1; transform: none; translate: none; }
    [data-in] li { opacity: 1; transform: none; transition: none; }
  }


  /* ---------- more custom work ---------- */
  .cm { padding: clamp(48px, 6vw, 96px) 0; background: #fff; scroll-margin-top: 90px; }
  .cm__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px); }
  .cm__card { display: grid; grid-template-rows: auto 1fr; height: 100%; border-radius: 22px; overflow: hidden; border: 1px solid var(--line); background: #fff; transition: transform .4s cubic-bezier(.2, .8, .2, 1), box-shadow .4s; }
  .cm__card:hover { transform: translateY(-4px); box-shadow: 0 30px 50px -34px rgba(20, 23, 26, .55); }
  .cm__img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--haze); }
  .cm__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s cubic-bezier(.2, .8, .2, 1); }
  .cm__card:hover .cm__img img { transform: scale(1.04); }
  .cm__body { display: grid; align-content: start; gap: 8px; padding: 20px 22px 22px; }
  .cm__body h3 { margin: 0; font-size: 1.25rem; letter-spacing: -.02em; font-variation-settings: 'wght' 760; font-weight: 400; }
  .cm__body p { margin: 0; color: var(--steel); line-height: 1.5; }
  .cm__go { display: inline-flex; align-items: center; gap: 6px; margin-top: 6px; color: var(--red); text-decoration: none; font-variation-settings: 'wght' 700; }
  .cm__go :global(svg) { width: 16px; height: 16px; transition: transform .2s; }
  .cm__go:hover :global(svg) { transform: translateX(3px); }

  @media (max-width: 1000px) {
    .cm__grid { grid-template-columns: 1fr; }
    .cm__card { grid-template-rows: auto; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); }
    .cm__img { aspect-ratio: auto; height: 100%; min-height: 200px; }
  }
  @media (max-width: 560px) {
    .cm__card { grid-template-columns: 1fr; }
    .cm__img { aspect-ratio: 16 / 10; min-height: 0; }
  }

  /* ================= creative hero: live shop showcase ================= */
  .csx { position: relative; overflow: hidden; isolation: isolate; background: radial-gradient(70% 90% at 78% 40%, rgba(255, 106, 19, .22), transparent 60%), radial-gradient(60% 80% at 0% 100%, rgba(182, 6, 6, .25), transparent 60%), #111315; color: #fff; padding: clamp(36px, 5vw, 76px) 0 clamp(40px, 5vw, 80px); }
  .csx__grid-bg { position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(rgba(255, 255, 255, .045) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .045) 1px, transparent 1px), linear-gradient(rgba(255, 255, 255, .02) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .02) 1px, transparent 1px); background-size: 96px 96px, 96px 96px, 24px 24px, 24px 24px; mask-image: radial-gradient(90% 90% at 60% 45%, #000 40%, transparent 100%); -webkit-mask-image: radial-gradient(90% 90% at 60% 45%, #000 40%, transparent 100%); }
  .csx__in { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(26px, 4vw, 70px); align-items: center; }
  .csx__k { display: inline-flex; align-items: center; gap: 12px; margin: 0 0 18px; font-size: .8rem; letter-spacing: .2em; text-transform: uppercase; color: #ffb37f; font-variation-settings: 'wght' 700; animation: csxUp .7s .05s cubic-bezier(.2, .8, .2, 1) both; }
  .csx__k span { width: 30px; height: 10px; border-radius: 2px; background: repeating-linear-gradient(-45deg, #ff6a13 0 6px, #141414 6px 12px); }
  .csx h1 { margin: 0; font-size: clamp(2.5rem, 5.2vw, 5rem); line-height: .98; letter-spacing: -.045em; font-variation-settings: 'wght' 800; font-weight: 400; }
  .csx .eqh__ln { display: block; overflow: hidden; padding-bottom: .06em; }
  .csx .eqh__ln > span { display: inline-block; animation: csxRise 1s cubic-bezier(.2, .8, .2, 1) both; }
  .csx .eqh__ln + .eqh__ln > span { animation-delay: .12s; color: #ff6a13; }
  .csx__lede { margin: 22px 0 0; max-width: 46ch; color: #c8cdd2; font-size: clamp(1rem, 1.25vw, 1.15rem); line-height: 1.6; animation: csxUp .8s .3s cubic-bezier(.2, .8, .2, 1) both; }
  .csx__ways { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; animation: csxUp .8s .42s cubic-bezier(.2, .8, .2, 1) both; }
  .csx__btn { display: inline-flex; align-items: center; gap: 10px; min-height: 56px; padding: 0 26px; border-radius: 999px; font-size: 1.02rem; font-variation-settings: 'wght' 720; text-decoration: none; transition: background .2s, border-color .2s, transform .15s; }
  .csx__btn :global(svg) { width: 18px; height: 18px; transition: transform .2s; }
  .csx__btn:hover :global(svg) { transform: translateX(3px); }
  .csx__btn--solid { background: #ff6a13; color: #141414; box-shadow: 0 18px 40px -18px rgba(255, 106, 19, .9); }
  .csx__btn--solid:hover { background: #ff8238; }
  .csx__btn--line { border: 1.5px solid rgba(255, 255, 255, .35); color: #fff; }
  .csx__btn--line:hover { background: rgba(255, 255, 255, .08); border-color: #fff; }
  .csx__call { margin: 18px 0 0; color: #9aa3ab; font-size: .95rem; animation: csxUp .8s .5s cubic-bezier(.2, .8, .2, 1) both; }
  .csx__call a { color: #fff; font-variation-settings: 'wght' 700; text-decoration: none; border-bottom: 1px solid rgba(255, 255, 255, .3); }

  .csx__show { display: grid; gap: 12px; animation: csxStage 1s .15s cubic-bezier(.2, .8, .2, 1) both; }
  .csx__tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .csx__tab { display: grid; gap: 8px; padding: 10px 4px 0; border: 0; background: none; color: #8d969e; font: inherit; font-size: .82rem; letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 700; text-align: left; cursor: pointer; transition: color .2s; }
  .csx__tab:hover, .csx__tab.is-on { color: #fff; }
  .csx__tab i { display: block; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, .14); overflow: hidden; }
  .csx__tab b { display: block; height: 100%; width: 100%; background: #ff6a13; transform-origin: left; transform: scaleX(0); }
  .csx__tab.is-done b { transform: scaleX(1); }
  .csx__tab.is-on b { animation: csxBar var(--dur, 8s) linear forwards; }
  .csx[data-paused] .csx__tab.is-on b { animation-play-state: paused; }
  .csx__stage { position: relative; aspect-ratio: 1 / .92; border-radius: 26px; overflow: hidden; background: radial-gradient(80% 70% at 50% 42%, #2a2f35 0%, #1a1d21 70%), #1a1d21; border: 1px solid rgba(255, 255, 255, .09); box-shadow: 0 60px 120px -60px rgba(0, 0, 0, .9), inset 0 1px 0 rgba(255, 255, 255, .06); }
  .csx__stage::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255, 255, 255, .05) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .05) 1px, transparent 1px); background-size: 32px 32px; mask-image: radial-gradient(70% 70% at 50% 45%, #000, transparent); -webkit-mask-image: radial-gradient(70% 70% at 50% 45%, #000, transparent); }
  .csx__rule { position: absolute; z-index: 2; pointer-events: none; }
  .csx__rule--x { top: 0; left: 26px; right: 0; height: 18px; background: repeating-linear-gradient(90deg, rgba(255, 255, 255, .35) 0 1px, transparent 1px 8px), repeating-linear-gradient(90deg, rgba(255, 255, 255, .55) 0 1px, transparent 1px 40px); background-size: auto 7px, auto 13px; background-repeat: repeat-x; background-color: rgba(0, 0, 0, .25); }
  .csx__rule--y { top: 18px; left: 0; bottom: 0; width: 18px; background: repeating-linear-gradient(0deg, rgba(255, 255, 255, .35) 0 1px, transparent 1px 8px), repeating-linear-gradient(0deg, rgba(255, 255, 255, .55) 0 1px, transparent 1px 40px); background-size: 7px auto, 13px auto; background-repeat: repeat-y; background-color: rgba(0, 0, 0, .25); }

  .sc { position: absolute; inset: 0; margin: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; padding: 30px 22px 18px 34px; opacity: 0; visibility: hidden; transition: opacity .5s, visibility 0s .5s; }
