  /* ---------- lineup ---------- */
  .eql { padding: clamp(56px, 7vw, 100px) 0; background: #fff; }
  .eql__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); gap: clamp(10px, 1.2vw, 16px); }
  .eqt { position: relative; display: grid; grid-template-rows: auto 1fr; height: 100%; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; text-decoration: none; color: var(--ink); background: linear-gradient(185deg, var(--tint) 0%, #fff 72%); transition: transform .45s cubic-bezier(.2, .8, .2, 1), box-shadow .45s, border-color .3s; }
  .eqt:hover { transform: translateY(-6px); border-color: var(--line-dark); box-shadow: 0 28px 50px -30px rgba(20, 23, 26, .5); }
  .eqt__img { display: grid; place-items: center; padding: 18px 18px 6px; overflow: hidden; }
  .eqt__img img { display: block; width: 100%; height: clamp(150px, 12.5vw, 210px); object-fit: contain; filter: drop-shadow(0 16px 14px rgba(20, 23, 26, .2)); transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
  .eqt__img img.is-blend { mix-blend-mode: multiply; filter: none; }
  .eqt:hover .eqt__img img { transform: translateY(-6px) scale(1.05); }
  .eqt__txt { display: grid; align-content: start; gap: 6px; padding: 8px 20px 20px; }
  .eqt__txt b { font-size: clamp(1.08rem, 1.25vw, 1.25rem); line-height: 1.15; letter-spacing: -.015em; font-variation-settings: 'wght' 750; }
  .eqt__txt small { color: var(--steel); font-size: .9rem; line-height: 1.4; }
  .eqt__mode { display: inline-flex; align-items: center; gap: 4px; margin-top: 6px; color: var(--red); font-size: .88rem; font-variation-settings: 'wght' 700; }
  .eqt__mode :global(svg) { width: 14px; height: 14px; transition: transform .2s; }
  .eqt:hover .eqt__mode :global(svg) { transform: translateX(3px); }
  .eqt:hover .eqt__txt b { color: var(--red); }

  /* ---------- rent or buy ---------- */
  .eqr { padding: clamp(56px, 7vw, 100px) 0; background: var(--haze); }
  .eqr__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px); }
  .eqr__card { display: grid; align-content: start; gap: 14px; padding: clamp(24px, 3vw, 44px); border-radius: 24px; background: #fff; border: 1px solid var(--line); }
  .eqr__card--dark { background: linear-gradient(160deg, #1d2126, #121417); color: #fff; border-color: #1d2126; }
  .eqr__tag { justify-self: start; margin: 0; padding: 5px 14px; border-radius: 999px; background: var(--red-tint); color: var(--red); font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 760; }
  .eqr__card--dark .eqr__tag { background: rgba(255, 255, 255, .1); color: var(--gold); }
  .eqr h3 { margin: 0; font-size: clamp(1.5rem, 2.2vw, 2.1rem); line-height: 1.08; letter-spacing: -.03em; font-variation-settings: 'wght' 760; font-weight: 400; }
  .eqr ul { list-style: none; margin: 4px 0 10px; padding: 0; display: grid; gap: 12px; }
  .eqr li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; font-size: 1rem; line-height: 1.45; color: var(--ink-2); opacity: 1; transform: none; }
  .eqr__card--dark li { color: #d6d9dc; }
  .eqr li :global(svg) { width: 22px; height: 22px; color: var(--red); }
  .eqr__card--dark li :global(svg) { color: var(--gold); }
  .eqr__card .eq-pill { justify-self: start; }
  .eqr__calc { margin: 22px 0 0; text-align: center; color: var(--steel); }
  .eqr__calc a { color: var(--red); font-variation-settings: 'wght' 700; text-underline-offset: 3px; }

  /* ---------- fleet ---------- */
  .eqf { padding: clamp(56px, 7vw, 100px) 0; background: linear-gradient(180deg, #15181c, #1d2126); color: #fff; }
  .eqf__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: clamp(10px, 1.2vw, 16px); }
  .eqft { display: grid; gap: 6px; height: 100%; padding: 18px 20px 20px; border-radius: 20px; text-decoration: none; color: #fff; background: rgba(255, 255, 255, .05); border: 1px solid rgba(255, 255, 255, .1); transition: background .3s, border-color .3s, transform .45s cubic-bezier(.2, .8, .2, 1); }
  .eqft:hover { background: rgba(255, 255, 255, .09); border-color: rgba(255, 255, 255, .25); transform: translateY(-5px); }
  .eqft__img { display: grid; place-items: center; padding: 12px; margin-bottom: 6px; border-radius: 14px; overflow: hidden; background: radial-gradient(closest-side, rgba(255, 255, 255, .95), rgba(255, 255, 255, .82)); }
  .eqft__img img { display: block; width: 100%; height: clamp(110px, 9.5vw, 160px); object-fit: contain; filter: drop-shadow(0 12px 12px rgba(0, 0, 0, .25)); transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
  .eqft__img img.is-blend { mix-blend-mode: multiply; filter: none; }
  .eqft:hover .eqft__img img { transform: translateY(-4px) scale(1.05); }
  .eqft b { font-size: 1.1rem; line-height: 1.2; font-variation-settings: 'wght' 740; }
  .eqft small { color: #b9bfc6; font-size: .9rem; line-height: 1.4; }
  .eqft__mode { display: inline-flex; align-items: center; gap: 4px; margin-top: 4px; color: var(--gold); font-size: .88rem; font-variation-settings: 'wght' 700; }
  .eqft__mode :global(svg) { width: 14px; height: 14px; transition: transform .2s; }
  .eqft:hover .eqft__mode :global(svg) { transform: translateX(3px); }

  /* ---------- steps ---------- */
  .eqs { padding: clamp(56px, 7vw, 100px) 0; background: #fff; }
  .eqs__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px); counter-reset: s; }
  .eqs__list li { position: relative; display: grid; align-content: start; gap: 8px; padding: 26px 24px 28px; border-radius: 20px; border: 1px solid var(--line); background: #fff; }
  .eqs__list li::after { content: ''; position: absolute; top: 44px; right: calc(-1 * clamp(12px, 1.6vw, 22px)); width: clamp(12px, 1.6vw, 22px); height: 2px; background: var(--line-dark); }
  .eqs__list li:last-child::after { display: none; }
  .eqs__n { display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 6px; border-radius: 50%; background: var(--red); color: #fff; font-size: .9rem; letter-spacing: .04em; font-variation-settings: 'wght' 760; }
  .eqs b { font-size: 1.15rem; font-variation-settings: 'wght' 740; }
  .eqs small { color: var(--steel); font-size: .95rem; line-height: 1.45; }

  /* ---------- final CTA ---------- */
  .eqc { padding: clamp(56px, 7vw, 100px) 0; background: radial-gradient(120% 140% at 85% 0%, #3a0505 0%, #16181b 55%); color: #fff; }
  .eqc__in { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 26px 40px; }
  .eqc h2 { color: #fff; max-width: 16ch; }
  .eqc__acts { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .eqc__call { color: #cfd3d7; text-decoration: underline; text-underline-offset: 3px; margin-left: 4px; }
  .eqc__call:hover { color: #fff; }

  /* ---------- responsive ---------- */
  @media (max-width: 1100px) {
    .eqp__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .eqs__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .eqs__list li::after { display: none; }
    .eqh::after { background: linear-gradient(180deg, rgba(12, 13, 15, .9) 0%, rgba(12, 13, 15, .72) 45%, rgba(12, 13, 15, .4) 100%); }
  }
  @media (max-width: 720px) {
    .eqr__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .eqh__in { min-height: 0; padding-block: 34px 36px; justify-items: center; text-align: center; }
    .eqh__k { font-size: .78rem; margin-bottom: 8px; }
    .eqh h1 { font-size: clamp(1.9rem, 8.6vw, 2.4rem); margin-bottom: 10px; }
    .eqh__lede { font-size: 1rem; margin: 0 auto 20px; }
    .eqh__ways { grid-template-columns: 1fr; text-align: left; }
    .eqp__list { grid-template-columns: 1fr; gap: 16px; }
    .eql__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .eqt { border-radius: 16px; }
    .eqt__img { padding: 12px 10px 4px; }
    .eqt__img img { height: 110px; }
    .eqt__txt { padding: 6px 12px 14px; }
    .eqt__txt b { font-size: .98rem; }
    .eqt__txt small { display: none; }
    .eqf__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .eqft { padding: 12px 12px 14px; border-radius: 16px; }
    .eqft__img img { height: 90px; }
    .eqft b { font-size: .98rem; }
    .eqft small { display: none; }
    .eqs__list { grid-template-columns: 1fr; }
    .eq-head { justify-content: center; text-align: center; }
    .eq-head .eq-k { justify-content: center; }
    .eqc__in { justify-content: center; text-align: center; }
    .eqc h2 { margin-inline: auto; }
    .eqc__acts { justify-content: center; width: 100%; }
    .eqc__acts .eq-pill { width: 100%; }
    .eqr__card .eq-pill { justify-self: stretch; }
  }
  @media (prefers-reduced-motion: reduce) {
    .eqh::before, .eqh__k, .eqh__ln > span, .eqh__lede, .eqh__call, .eqh__ways .eway { animation: none; opacity: 1; transform: none; translate: none; }
    [data-in] li { opacity: 1; transform: none; transition: none; }
  }

  /* ---------- sign builder ---------- */
  .sb { padding: clamp(48px, 6vw, 96px) 0; background: var(--haze); scroll-margin-top: 90px; }
  .sb__note { max-width: 40ch; margin: 0; color: var(--steel); }
  .sb__grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(18px, 2.6vw, 36px); align-items: start; }
  .sb__stage { position: sticky; top: calc(var(--hdr-h, 140px) + 16px); display: grid; gap: 14px; padding: clamp(16px, 2vw, 26px); border-radius: 24px; background: #fff; border: 1px solid var(--line); box-shadow: 0 40px 80px -60px rgba(20, 23, 26, .45); }
  .sb__canvas { display: grid; place-items: center; aspect-ratio: 4 / 3.4; padding: clamp(12px, 2vw, 24px); border-radius: 18px; background: radial-gradient(120% 90% at 50% 15%, #fbfbfc, #e9ebee 70%), #eceef0; background-image: radial-gradient(120% 90% at 50% 15%, rgba(255,255,255,.9), rgba(233,235,238,.6) 70%), repeating-linear-gradient(0deg, rgba(20,23,26,.035) 0 1px, transparent 1px 28px), repeating-linear-gradient(90deg, rgba(20,23,26,.035) 0 1px, transparent 1px 28px); overflow: hidden; }
  .sb__svg { width: 100%; height: 100%; max-height: 100%; }
  .sb__meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 14px; }
  .sb__dims { font-size: 1.3rem; letter-spacing: -.02em; font-variation-settings: 'wght' 780; }
  .sb__spec { color: var(--steel); font-size: .92rem; }
  .sb__dl { justify-self: start; display: inline-flex; align-items: center; gap: 8px; min-height: 42px; padding: 0 16px; border-radius: 999px; border: 1.5px solid var(--line-dark); background: #fff; color: var(--ink); font: inherit; font-size: .92rem; font-variation-settings: 'wght' 640; cursor: pointer; transition: border-color .2s, background .2s; }
  .sb__dl:hover { border-color: var(--ink); }
  .sb__dl svg { width: 17px; height: 17px; }

  .sb__panel { display: grid; gap: 14px; }
  .sb__grp { display: grid; gap: 12px; margin: 0; padding: clamp(18px, 2vw, 24px); border-radius: 20px; background: #fff; border: 1px solid var(--line); min-width: 0; }
  .sb__grp legend { float: left; width: 100%; display: flex; align-items: center; gap: 10px; margin: 0 0 4px; padding: 0; font-size: 1.08rem; letter-spacing: -.01em; font-variation-settings: 'wght' 740; }
  .sb__grp legend + * { clear: both; }
  .sb__grp legend span { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--red); color: #fff; font-size: .85rem; }
  .sb__lab { margin: 2px 0 -4px; font-size: .9rem; color: var(--steel); }
  .sb__lab b { color: var(--ink); font-variation-settings: 'wght' 660; }
  .sb__shapes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .sb__shape input, .sb__chip--r input { position: absolute; opacity: 0; pointer-events: none; }
  .sb__shape span { display: grid; justify-items: center; gap: 6px; padding: 12px 6px 10px; border-radius: 14px; border: 1.5px solid var(--line-dark); font-size: .84rem; font-variation-settings: 'wght' 600; cursor: pointer; transition: border-color .2s, background .2s, color .2s; }
  .sb__shape svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
  .sb__shape input:checked + span { border-color: var(--ink); background: var(--ink); color: #fff; }
  .sb__shape input:focus-visible + span, .sb__chip--r input:focus-visible + span { outline: 3px solid rgba(182, 6, 6, .35); outline-offset: 2px; }
  .sb__sizes, .sb__arrows { display: flex; flex-wrap: wrap; gap: 8px; }
  .sb__chip { position: relative; display: inline-flex; }
  button.sb__chip, .sb__chip span { align-items: center; justify-content: center; min-height: 40px; min-width: 44px; padding: 0 14px; border-radius: 999px; border: 1.5px solid var(--line-dark); background: #fff; color: var(--ink); font: inherit; font-size: .9rem; font-variation-settings: 'wght' 600; cursor: pointer; transition: border-color .2s, background .2s, color .2s; }
  .sb__chip span { display: inline-flex; font-size: 1.05rem; }
  button.sb__chip.is-on, .sb__chip input:checked + span { background: var(--ink); border-color: var(--ink); color: #fff; }
  button.sb__chip[hidden] { display: none; }
  .sb__wh { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 10px; }
  .sb__wh label, .sb__f { display: grid; gap: 7px; }
  .sb__wh label span, .sb__f > span, .sb__qty > span { font-size: .92rem; font-variation-settings: 'wght' 640; }
  .sb__f > span em { font-style: normal; color: var(--steel); font-size: .84rem; font-variation-settings: 'wght' 450; margin-left: 4px; }
  .sb__x { padding-bottom: 14px; color: var(--steel); font-size: 1.2rem; }
  .sb__in { width: 100%; min-height: 50px; padding: 12px 14px; font: inherit; font-size: 1rem; color: var(--ink); background: #fff; border: 1.5px solid var(--line-dark); border-radius: 12px; transition: border-color .2s, box-shadow .2s; }
  .sb__in:disabled { background: var(--haze); color: var(--steel); }
  textarea.sb__in { resize: vertical; line-height: 1.45; }
  textarea[name=legend] { font-variation-settings: 'wght' 700; text-transform: none; letter-spacing: .02em; }
  .sb__in:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 4px rgba(20, 23, 26, .07); }
  .sb__sw { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .sb__dot { position: relative; width: 38px; height: 38px; border-radius: 50%; border: 0; background: var(--c); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .18); cursor: pointer; transition: transform .2s; }
  .sb__dot:hover { transform: scale(1.08); }
  .sb__dot.is-on { box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .18), 0 0 0 3px #fff, 0 0 0 5px var(--ink); }
  .sb__pick { position: relative; display: inline-flex; align-items: center; gap: 6px; min-height: 38px; padding: 0 12px 0 6px; border-radius: 999px; border: 1.5px dashed var(--line-dark); font-size: .86rem; font-variation-settings: 'wght' 600; cursor: pointer; }
  .sb__pick input { width: 26px; height: 26px; padding: 0; border: 0; border-radius: 50%; background: none; cursor: pointer; }
  .sb__pick input::-webkit-color-swatch-wrapper { padding: 0; }
  .sb__pick input::-webkit-color-swatch { border: 0; border-radius: 50%; }
  .sb__tog { display: inline-flex; align-items: center; gap: 10px; font-size: .95rem; font-variation-settings: 'wght' 580; cursor: pointer; justify-self: start; }
  .sb__tog input { position: absolute; opacity: 0; }
  .sb__tog span { position: relative; width: 42px; height: 24px; border-radius: 999px; background: var(--line-dark); transition: background .2s; flex: none; }
  .sb__tog span::after { content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.25); transition: transform .2s; }
  .sb__tog input:checked + span { background: var(--red); }
  .sb__tog input:checked + span::after { transform: translateX(18px); }
  .sb__tog input:focus-visible + span { outline: 3px solid rgba(182, 6, 6, .35); outline-offset: 2px; }
  .sb__row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .sb__qty { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .sb__step { display: grid; grid-template-columns: 46px 80px 46px; border: 1.5px solid var(--line-dark); border-radius: 12px; overflow: hidden; }
  .sb__step button { border: 0; background: var(--haze); font: inherit; font-size: 1.3rem; cursor: pointer; }
  .sb__step button:hover { background: var(--line); }
  .sb__step .sb__in { border: 0; border-radius: 0; text-align: center; min-height: 46px; padding: 0 4px; -moz-appearance: textfield; }
  .sb__step .sb__in::-webkit-inner-spin-button { -webkit-appearance: none; }
  .sb__send { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 58px; padding: 0 28px; border: 0; border-radius: 999px; background: var(--red); color: #fff; font: inherit; font-size: 1.05rem; font-variation-settings: 'wght' 720; cursor: pointer; box-shadow: 0 16px 34px -16px rgba(182, 6, 6, .8); transition: background .2s; }
  .sb__send:hover { background: var(--red-press); }
  .sb__send :global(svg) { width: 18px; height: 18px; }
  .sb__send[disabled] { opacity: .7; cursor: progress; }
  .sb__msg { margin: 0; padding: 14px 16px; border-radius: 14px; font-variation-settings: 'wght' 600; }
  .sb__msg--ok { background: #e7f3eb; color: #1c6b37; }
  .sb__msg--err { background: var(--red-tint); color: var(--red); }
  .sb__msg[hidden] { display: none; }

  /* ---------- more custom work ---------- */
  .cm { padding: clamp(48px, 6vw, 96px) 0; background: #fff; scroll-margin-top: 90px; }
  .cm__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px); }
  .cm__card { display: grid; grid-template-rows: auto 1fr; height: 100%; border-radius: 22px; overflow: hidden; border: 1px solid var(--line); background: #fff; transition: transform .4s cubic-bezier(.2, .8, .2, 1), box-shadow .4s; }
  .cm__card:hover { transform: translateY(-4px); box-shadow: 0 30px 50px -34px rgba(20, 23, 26, .55); }
  .cm__img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--haze); }
  .cm__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s cubic-bezier(.2, .8, .2, 1); }
  .cm__card:hover .cm__img img { transform: scale(1.04); }
  .cm__body { display: grid; align-content: start; gap: 8px; padding: 20px 22px 22px; }
  .cm__body h3 { margin: 0; font-size: 1.25rem; letter-spacing: -.02em; font-variation-settings: 'wght' 760; font-weight: 400; }
  .cm__body p { margin: 0; color: var(--steel); line-height: 1.5; }
  .cm__go { display: inline-flex; align-items: center; gap: 6px; margin-top: 6px; color: var(--red); text-decoration: none; font-variation-settings: 'wght' 700; }
  .cm__go :global(svg) { width: 16px; height: 16px; transition: transform .2s; }
  .cm__go:hover :global(svg) { transform: translateX(3px); }

  @media (max-width: 1000px) {
    .sb__grid { grid-template-columns: 1fr; }
    .sb__stage { position: sticky; top: var(--hdr-h, 120px); z-index: 3; padding: 10px; gap: 6px; border-radius: 18px; box-shadow: 0 18px 40px -26px rgba(20, 23, 26, .6); }
    .sb__canvas { aspect-ratio: auto; height: clamp(170px, 30vh, 280px); padding: 8px; border-radius: 12px; }
    .sb__meta { padding: 0 4px; }
    .sb__dims { font-size: 1.05rem; }
    .sb__spec { font-size: .82rem; }
    .sb__dl { display: none; }
    .cm__grid { grid-template-columns: 1fr; }
    .cm__card { grid-template-rows: auto; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); }
    .cm__img { aspect-ratio: auto; height: 100%; min-height: 200px; }
  }
  @media (max-width: 560px) {
    .sb__shapes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sb__shape span { grid-auto-flow: column; justify-content: start; padding: 10px 12px; }
    .sb__row2 { grid-template-columns: 1fr; }
    .sb__send { width: 100%; }
    .cm__card { grid-template-columns: 1fr; }
    .cm__img { aspect-ratio: 16 / 10; min-height: 0; }
  }

  /* ================= creative hero: live shop showcase ================= */
