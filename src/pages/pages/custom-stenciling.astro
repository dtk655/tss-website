        else if (root.hasAttribute('data-paused')) { root.removeAttribute('data-paused'); scenes[cur].querySelectorAll('*').forEach((n) => (n.style.animationPlayState = '')); started = performance.now(); timer = setTimeout(() => show((cur + 1) % scenes.length), Math.max(400, left)); }
