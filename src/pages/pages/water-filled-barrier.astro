---
import Layout from '../../layouts/Layout.astro';
import { PHONE, PHONE_TEL, WATERCADE_LOGO } from '../../lib/config.js';

const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const rows = [
  {
    heading: 'MASH approved',
    body: [
      'Our WATERCADE™ barriers are MASH crash tested to Test Level 3 (TL-3) for longitudinal barricade applications and are approved for use on the National Highway System in accordance with this standard.',
      'These water-filled barriers can replace many traditional traffic control devices, providing added protection in active work zones. They may also substitute for concrete barriers in certain applications.',
      'Please consult our sales team for guidance on specific use limitations and project requirements.'
    ],
    image: CDN + 'WATERCADE_MASH.svg',
    alt: 'WATERCADE barrier with MASH TL-3 crash test approval'
  },
  {
    heading: '90° swivel pin technology',
    body: [
      'Every WATERCADE™ barrier includes our integrated 90° swivel pin, allowing each unit to securely interlock with the next while maintaining the flexibility to follow curves, corners, and changing road alignments. This built-in connection system lets you quickly create straight runs, angles, or fully enclosed work zones without special hardware — delivering continuous protection for virtually any roadway or project layout.'
    ],
    image: CDN + 'WATERCADE_CUSTOMS_5.svg',
    alt: 'Two WATERCADE barriers interlocked with the 90 degree swivel pin'
  },
  {
    heading: 'Custom options',
    body: [
      'Make WATERCADE™ your own with high-visibility custom options built for the jobsite. Choose from multiple color configurations, add your company name or logo for clear identification, and utilize the dual lower panels for project information, safety messaging, or branding. For maximum visibility day or night, we offer premium 3M reflective striping in Engineer Grade or High-Intensity sheeting.'
    ],
    image: CDN + 'WATERCADE_CUSTOMS_1.svg',
    alt: 'WATERCADE barrier with a custom color and company logo'
  },
  {
    heading: 'Dimensions and weight',
    body: [
      "The WATERCADE™ barrier is engineered for easy transport, fast deployment, and maximum on-site performance. Measuring 5 feet in length and 3 feet in height, each unit weighs approximately 50 lbs empty for efficient handling and positioning. Once filled, the barrier reaches up to 650 lbs, providing the mass needed for reliable longitudinal channelization and work-zone protection. A large top fill cap allows quick filling, while the integrated drain plug ensures fast, controlled emptying when it's time to move."
    ],
    image: CDN + 'WATERCADE_CUSTOMS_4.svg',
    alt: 'WATERCADE barrier dimension diagram, 5 feet long and 3 feet high'
  },
  {
    heading: 'Fence panel attachment',
    body: [
      'Turn your WATERCADE™ barrier into a complete perimeter system with the fence panel attachment. Standard fence posts install directly into the swivel pin connection point, allowing you to mount fence panels of virtually any height for added jobsite security and pedestrian control. Swing gates can also be integrated to create controlled access points for crews, equipment, and deliveries without breaking the barrier line.'
    ],
    image: CDN + 'WATERCADE_ORANGE_1.svg',
    alt: 'Orange WATERCADE barrier ready for a fence panel attachment'
  },
  {
    heading: 'Full truck delivery',
    body: [
      'WATERCADE™ barriers are engineered for maximum freight efficiency, allowing full truckload quantities to ship safely and economically to your jobsite or yard. Their stackable design minimizes transportation costs, speeds up loading and unloading, and ensures you receive large volumes ready for rapid deployment. Whether supplying a major project or stocking your fleet, our full truck delivery option keeps your operation on schedule.'
    ],
    image: CDN + 'WATERCADE_TRUCK.svg',
    alt: 'Truckload of stacked WATERCADE barriers'
  }
];
const specs = [
  ['Length', '5 ft'],
  ['Height', '3 ft'],
  ['Empty weight', 'About 50 lbs — one person can place it'],
  ['Filled weight', 'Up to 650 lbs'],
  ['Connection', 'Integrated 90° swivel pin, included'],
  ['Fill and drain', 'Large top fill cap, integrated drain plug'],
  ['Crash rating', 'MASH TL-3, approved for the National Highway System'],
  ['Colors', 'Orange or white, custom colors available'],
  ['Branding', 'Company name, logo, dual lower message panels'],
  ['Striping', '3M reflective, Engineer Grade or High-Intensity'],
  ['Attachments', 'Fence panels and swing gates'],
  ['Shipping', 'Stackable for full truckload delivery']
];
---
<Layout
  title="WATERCADE water-filled barrier"
  description="WATERCADE is TSS's MASH TL-3 crash-tested water-filled barrier. 5 ft long, 50 lbs empty, up to 650 lbs filled, with 90° swivel pin connections. Buy nationwide or rent in NJ, NY, PA and CT."
  dark
>
  <section class="wc-hero">
    <div class="wrap wc-hero__in">
      <div class="wc-hero__copy">
        <img class="wc-hero__logo" src={WATERCADE_LOGO} alt="WATERCADE" width="900" height="130" />
        <h1>The nation's premier water-filled barrier</h1>
        <p class="lede">Designed, sold and rented by Traffic Safety Service. MASH TL-3 crash tested, one-person handling when empty, and 650 lbs of stability once filled.</p>
        <div class="wc-hero__cta">
          <a class="btn" href="/products/waterbarriertss590rparent">Shop WATERCADE</a>
          <a class="btn btn--ghost" href="/tools/watercade-planner">Plan your layout</a>
        </div>
        <p class="wc-hero__note">Ships nationwide. Rentals, delivery and setup in NJ, NY, PA and CT.</p>
      </div>
      <div class="wc-hero__img"><img src={CDN + 'SHOPIFY_WATERCADE_ORANGE_1.svg'} alt="Orange WATERCADE water-filled barrier" width="900" height="1000" /></div>
    </div>
  </section>

  <section class="section wc-rows">
    <div class="wrap">
      <h2 class="wc-rows__h">What to know about WATERCADE™</h2>
      {rows.map((r, i) => (
        <article class={`wcrow ${i % 2 ? 'wcrow--flip' : ''}`}>
          <div class="wcrow__img"><img src={r.image} alt={r.alt} loading="lazy" /></div>
          <div class="wcrow__copy">
            <h3>{r.heading}</h3>
            {r.body.map((p) => <p>{p}</p>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--dark wc-specs">
    <div class="wrap wc-specs__in">
      <div>
        <h2>Specs at a glance</h2>
        <p class="lede">Every number a spec sheet or project engineer will ask for.</p>
        <div class="wc-specs__cta">
          <a class="btn" href="/pages/request-a-quote">Request a quote</a>
          <a class="btn btn--ghost" href={PHONE_TEL}>Call {PHONE}</a>
        </div>
      </div>
      <table class="wc-table">
        <caption class="sr-only">WATERCADE barrier specifications</caption>
        <tbody>
          {specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="wrap wc-next sign sign--orange">
      <div>
        <h2>See it before you order it</h2>
        <p>Lay out your run, corner or full enclosure in the planner and get a barrier count, water volume and price. Or spin the barrier in 3D with your own logo on the side.</p>
      </div>
      <div class="wc-next__cta">
        <a class="btn btn--dark" href="/tools/watercade-planner">Open the planner</a>
        <a class="btn btn--ghost" href="/tools/3d-showroom">View in 3D</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .wc-hero { background: var(--haze); border-bottom: 3px solid #28a1ce; }
  .wc-hero__in { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(28px, 4vw, 64px); align-items: center; padding-top: clamp(44px, 6vw, 80px); padding-bottom: clamp(44px, 6vw, 80px); }
  .wc-hero__copy { display: grid; justify-items: start; gap: 20px; }
  .wc-hero__logo { width: min(400px, 80vw); height: auto; border-radius: 8px; }
  .wc-hero h1 { max-width: 16ch; }
  .wc-hero .lede { max-width: 52ch; margin: 0; }
  .wc-hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .wc-hero__note { margin: 0; color: var(--steel); font-size: .95rem; }
  .wc-hero__img img { width: 100%; max-height: 420px; object-fit: contain; filter: drop-shadow(0 26px 24px rgba(20, 23, 26, .18)); }

  .wc-rows__h { margin-bottom: clamp(28px, 4vw, 48px); max-width: 18ch; }
  .wcrow { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(24px, 4vw, 64px); align-items: center; padding: clamp(24px, 3.5vw, 44px) 0; border-top: 1px solid var(--concrete-dark); }
  .wcrow--flip .wcrow__img { order: 2; }
  .wcrow__img { background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-m); padding: clamp(16px, 2.5vw, 32px); display: grid; place-items: center; }
  .wcrow__img img { max-height: 300px; width: 100%; object-fit: contain; }
  .wcrow__copy h3 { margin-bottom: 12px; }
  .wcrow__copy p { margin-bottom: .8em; }
  .wcrow__copy p:last-child { margin-bottom: 0; }

  .wc-specs__in { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .wc-specs__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .wc-table { width: 100%; border-collapse: collapse; }
  .wc-table th, .wc-table td { text-align: left; padding: 12px 14px 10px; border-bottom: 1px solid var(--asphalt-line); vertical-align: top; }
  .wc-table th { white-space: nowrap; padding-right: 24px; color: #fff; font-variation-settings: 'wght' 640; }
  .wc-table td { color: #c3c8cd; }

  .wc-next { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding: 36px clamp(24px, 4vw, 44px); }
  .wc-next h2 { font-size: var(--fs-4); margin-bottom: 8px; }
  .wc-next p { margin: 0; max-width: 54ch; }
  .wc-next__cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .wc-next .btn--ghost { color: var(--ink); }

  @media (max-width: 880px) {
    .wc-hero__in, .wcrow, .wc-specs__in { grid-template-columns: 1fr; }
    .wcrow--flip .wcrow__img { order: 0; }
    .wc-hero__img img { max-height: 280px; }
  }
</style>
