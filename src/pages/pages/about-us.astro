---
// About page: same theme as the rest of the site, but told as a story. Split hero with the team photo
// and a scroll-driven road timeline instead of the usual photo hero and feature rows.
import Layout from '../../layouts/Layout.astro';
import { PHONE, PHONE_TEL, YEARS } from '../../lib/config.js';

const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const HERO = '/fleet/team-photo.webp';
const stats = [
  { n: YEARS, label: 'Years in business', suf: '' },
  { n: 25000, label: 'Lane closures completed', suf: '+' },
  { n: 35000, label: 'Customers served', suf: '+' },
  { n: 3100000, label: 'Cones sold', suf: '+', m: true }
];
const rows = [
  {
    when: '1971', k: 'Where it started', h: 'Started with cones. <em>Built on trust.</em>',
    body: [
      'Traffic Safety Service was founded in 1971 in South Plainfield, NJ as a small, family-owned business supplying traffic control products to local towns and contractors.'
    ],
    img: CDN + 'thumbnail_IMG_1125.jpg', alt: 'Traffic Safety Service equipment in the yard'
  },
  {
    when: 'Growth', k: 'Growing with the region', h: 'From cones <em>to full service.</em>',
    body: [
      'From basic cones and barricades we grew into a full-service company: message boards, crash trucks, work zone devices, rentals and certified, experienced crews across New Jersey, New York and the surrounding region.',
      'Our reputation for dependable service and fair pricing has made us a go-to for municipalities, agencies and contractors throughout the region.'
    ],
    img: '/fleet/vms-yard.webp', alt: 'TSS message boards ready for rental'
  },
  {
    when: 'Today', k: 'Our goal', h: 'A partner, <em>not just a supplier.</em>',
    body: [
      'Whether you’re running a highway project, planning an event or keeping a town’s roads maintained, our team helps you build a safer work zone for workers, drivers and pedestrians.',
      'Every job gets a solution sized to it, from a pallet of cones to a full closure with crews and crash trucks.'
    ],
    img: '/fleet/fleet-sunset.webp', alt: 'TSS crash trucks lined up at sunset'
  },
  {
    when: 'Ahead', k: 'Our mission', h: 'Protect everyone <em>on the road.</em>',
    body: [
      'We keep growing, but the mission stays the same: innovative, dependable and cost-effective traffic safety that protects everyone on the road.'
    ],
    img: CDN + 'thumbnail_IMG_1180.jpg', alt: 'TSS equipment set up in the field'
  }
];
const what = [
  ['Products', 'Cones, barricades, signs and drums', 'Shipped nationwide, with custom branding.', '/collections', CDN + 'thumbnail_IMG_0141_f25c7165-4733-4438-9391-0687acaa7c46.jpg'],
  ['Equipment and fleet', 'VMS boards to TMA trucks', 'Rent it delivered in NJ, NY, PA and CT, or buy it.', '/pages/equipment', '/fleet/fleet-hero.webp'],
  ['Lane closures', '25,000+ closures', 'Certified, experienced crews in NJ, NY, PA, CT and DE.', '/pages/lane-closure', '/fleet/lc-hero.webp']
];
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Layout title="About us" description={`Traffic Safety Service has been a family-run traffic control company in South Plainfield, NJ since 1971. ${YEARS} years, 25,000+ lane closures and 35,000+ customers served.`}>
  <!-- ================= HERO ================= -->
  <section class="abh">
    <span class="abh__year" aria-hidden="true">1971</span>
    <div class="wrap abh__in">
      <div class="abh__copy">
        <p class="abh__k"><span></span>Our story</p>
        <h1><span class="eqh__ln"><span>Family-Run Since 1971.</span></span> <span class="eqh__ln"><span>Trusted On Every Road.</span></span></h1>
        <p class="abh__lede">{YEARS} years of putting work zones up right, from our yard in South Plainfield, NJ to roadways across the Northeast.</p>
        <a href="#story" class="abh__scroll"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v13M6 12l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Follow the road</a>
      </div>
      <figure class="abh__photo">
        <img src={HERO} alt="The Traffic Safety Service team with the fleet" width="1600" height="1203" fetchpriority="high" />
        <figcaption><b>The TSS team</b><span>South Plainfield, NJ</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <section class="abs" data-in aria-label="TSS by the numbers">
    <div class="wrap">
      <ul class="abs__list" data-stats>
        {stats.map((s, i) => (
          <li style={`--i:${i}`}>
            <span class="abs__n" data-count={s.n} data-suf={s.suf} data-m={s.m ? '1' : undefined}>{s.m ? (s.n / 1e6).toFixed(1) + 'M' : s.n.toLocaleString('en-US')}{s.suf}</span>
            <span class="abs__l">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= STORY: the road ================= -->
  <section class="rd" id="story" data-road>
    <div class="wrap">
      <div class="eq-head eq-head--center">
        <div>
          <p class="eq-k"><span></span>The road so far<span></span></p>
          <h2>{YEARS} years, <em>one mile at a time.</em></h2>
        </div>
      </div>
      <div class="rd__track">
        <div class="rd__lane" aria-hidden="true"><i data-road-fill></i><b class="rd__truck" data-road-truck><svg viewBox="0 0 24 24"><path d="M12 2 22 12 12 22 2 12z"/></svg></b></div>
        {rows.map((r, i) => (
          <article class={`ms${i % 2 ? ' ms--flip' : ''}`} data-ms>
            <div class="ms__mark" aria-hidden="true"><span>{r.when}</span></div>
            <div class="ms__img"><img src={r.img} alt={r.alt} loading="lazy" /></div>
            <div class="ms__copy">
              <p class="eq-k"><span></span>{r.k}</p>
              <h3 set:html={r.h} />
              {r.body.map((p) => <p>{p}</p>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= WHAT WE DO ================= -->
  <section class="abw" data-in>
    <div class="wrap">
      <div class="eq-head eq-head--center">
        <div>
          <p class="eq-k"><span></span>What we do<span></span></p>
          <h2>One company for <em>the whole work zone.</em></h2>
        </div>
      </div>
      <ul class="abw__grid">
        {what.map(([k, b, d, h, im], i) => (
          <li style={`--i:${i}`}>
            <a href={h} class="abw__card">
              <img src={im} alt="" loading="lazy" />
              <small>{k}</small>
              <b>{b}</b>
              <span>{d}</span>
              <span class="abw__go">Explore<Fragment set:html={ARROW} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="eqc" data-in>
    <div class="wrap eqc__in">
      <div>
        <p class="eq-k eq-k--light"><span></span>Work with us</p>
        <h2>Put {YEARS} years of work zones <em>on your next job.</em></h2>
      </div>
      <div class="eqc__acts">
        <a href="/pages/request-a-quote" class="eq-pill eq-pill--red">Request a quote<Fragment set:html={ARROW} /></a>
        <a href={PHONE_TEL} class="eq-pill eq-pill--glass">Call {PHONE}</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Count the stats up when they come into view.
  const sw = document.querySelector('[data-stats]');
  if (sw && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((en) => {
      if (!en.some((e) => e.isIntersecting)) return;
      io.disconnect();
      sw.querySelectorAll('[data-count]').forEach((el) => {
        const target = +el.dataset.count, suf = el.dataset.suf || '', t0 = performance.now(), dur = 1500;
        const fmt = (v) => (el.dataset.m ? (v / 1e6).toFixed(1) + 'M' : Math.round(v).toLocaleString('en-US')) + suf;
        const tick = (t) => { const p = Math.min(1, (t - t0) / dur); el.textContent = fmt(target * (1 - Math.pow(1 - p, 3))); if (p < 1) requestAnimationFrame(tick); };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });
    io.observe(sw);
  }
</script>
<script>
  // Reveal sections (and stagger their lists) as they scroll into view.
  const els = document.querySelectorAll('[data-in]');
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) els.forEach((e) => e.classList.add('is-in'));
  else {
    const io = new IntersectionObserver((ents) => ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } }), { threshold: 0.12 });
    els.forEach((e) => io.observe(e));
  }
</script>

<script>
  {
    // road timeline: the lane fills and the marker travels as you scroll; milestones light up as it reaches them
    const road = document.querySelector('[data-road]');
    const track = road?.querySelector('.rd__track');
    const ms = [...(road?.querySelectorAll('[data-ms]') || [])];
    if (track) {
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let tick = false;
      const upd = () => {
        tick = false;
        const r = track.getBoundingClientRect();
        const p = still ? 1 : Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / r.height));
        track.style.setProperty('--p', p.toFixed(4));
        const y = r.top + r.height * p;
        ms.forEach((m) => { const mr = m.getBoundingClientRect(); m.classList.toggle('is-on', still || mr.top + Math.min(90, mr.height / 2) < y + 4); });
      };
      addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(upd); } }, { passive: true });
      addEventListener('resize', upd);
      upd();
    }
  }
</script>

<style>
  /* ---------- shared section language (matches the homepage) ---------- */
  .eq-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 40px; margin-bottom: clamp(24px, 3vw, 40px); }
  .eq-head--center { justify-content: center; text-align: center; }
  .eq-head--center .eq-k { justify-content: center; }
  .eq-k { display: flex; align-items: center; gap: 12px; margin: 0 0 14px; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; font-variation-settings: 'wght' 680; color: var(--steel); }
  .eq-k span { width: 34px; height: 3px; border-radius: 2px; background: var(--red); }
  .eq-k--light { color: rgba(255, 255, 255, .8); }
  .eq-head h2, .eqc h2 { margin: 0; font-size: clamp(2.2rem, 4.6vw, 4.2rem); line-height: .98; letter-spacing: -.04em; font-variation-settings: 'wght' 780; font-weight: 400; text-wrap: balance; }
  .eq-head h2 em, .eqc h2 em { font-style: normal; color: var(--red); }
  .eq-link { display: inline-flex; align-items: center; gap: 10px; padding: 13px 22px 12px; border-radius: 999px; border: 1.5px solid var(--line-dark); color: var(--ink); font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, color .2s, border-color .2s; }
  .eq-link :global(svg) { width: 17px; height: 17px; transition: transform .2s; }
  .eq-link:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
  .eq-link:hover :global(svg) { transform: translateX(3px); }
  .eq-link--light { color: #fff; border-color: rgba(255, 255, 255, .35); }
  .eq-link--light:hover { background: #fff; color: var(--ink); border-color: #fff; }
  .eq-pill { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 14px 26px 13px; border-radius: 999px; font-size: 1.02rem; font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, transform .2s; }
  .eq-pill :global(svg) { width: 18px; height: 18px; transition: transform .2s; }
  .eq-pill:hover :global(svg) { transform: translateX(3px); }
  .eq-pill--red { background: var(--red); color: #fff; }
  .eq-pill--red:hover { background: #d10a0a; }
  .eq-pill--white { background: #fff; color: var(--ink); }
  .eq-pill--white:hover { background: #f1f2f3; }
  .eq-pill--glass { background: rgba(255, 255, 255, .08); color: #fff; border: 1.5px solid rgba(255, 255, 255, .4); }
  .eq-pill--glass:hover { background: rgba(255, 255, 255, .16); }
  [data-in] li { opacity: 0; transform: translateY(18px); transition: opacity .6s, transform .7s cubic-bezier(.2, .8, .2, 1); transition-delay: calc(var(--i, 0) * 60ms); }
  [data-in].is-in li { opacity: 1; transform: none; }

  /* ---------- hero ---------- */
  .eqh { position: relative; color: #fff; overflow: hidden; background: #14171a; isolation: isolate; }
  .eqh::before { content: ''; position: absolute; inset: 0; z-index: -2; background: var(--hero) 50% 35% / cover no-repeat; transform: scale(1.06); animation: eqZoom 18s ease-out forwards; }
  .eqh::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(12, 13, 15, .94) 0%, rgba(12, 13, 15, .82) 34%, rgba(12, 13, 15, .35) 62%, rgba(12, 13, 15, .1) 82%), linear-gradient(0deg, rgba(10, 10, 12, .5), transparent 45%); }
  @keyframes eqZoom { to { transform: scale(1); } }
  .eqh__in { display: grid; align-content: center; justify-items: start; min-height: clamp(440px, 46vw, 640px); padding-block: clamp(40px, 5vw, 76px); }
  .eqh__in > * { max-width: 760px; }
  .eqh__in > h1 { max-width: 1100px; }
  .eqh__k { margin: 0 0 12px; color: var(--gold); font-size: clamp(.92rem, 1.05vw, 1.05rem); letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 700; opacity: 0; animation: eqFade .8s .2s ease forwards; }
  .eqh h1 { margin: 0 0 16px; font-size: clamp(2.4rem, 5vw, 4.8rem); line-height: 1.02; letter-spacing: -.03em; font-variation-settings: 'wght' 790; font-weight: 400; color: #fff; }
  .eqh__ln { display: block; overflow: hidden; padding-bottom: .05em; }
  .eqh__ln > span { display: inline-block; transform: translateY(105%); animation: eqRise 1s cubic-bezier(.2, .8, .2, 1) forwards; }
  .eqh__ln + .eqh__ln > span { animation-delay: .12s; color: var(--gold); }
  .eqh__lede { margin: 0 0 26px; max-width: 48ch; color: #e6e8ea; font-size: clamp(1.05rem, 1.35vw, 1.24rem); line-height: 1.5; text-wrap: balance; opacity: 0; transform: translateY(12px); animation: eqUp .8s .55s cubic-bezier(.2, .8, .2, 1) forwards; }
  .eqh__ways { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; width: 100%; max-width: 700px; }
  .eqh__ways .eway { opacity: 0; translate: 0 16px; animation: eqUpT .8s .65s cubic-bezier(.2, .8, .2, 1) forwards; }
  .eqh__ways .eway + .eway { animation-delay: .77s; }
  .eqh__call { margin: 14px 0 0; color: #cfd3d7; font-size: .95rem; opacity: 0; animation: eqFade .8s .9s ease forwards; }
  .eqh__call a { color: #fff; font-variation-settings: 'wght' 700; text-decoration: underline; text-underline-offset: 3px; }
  @keyframes eqRise { to { transform: none; } }
  @keyframes eqFade { to { opacity: 1; } }
  @keyframes eqUp { to { opacity: 1; transform: none; } }
  @keyframes eqUpT { to { opacity: 1; translate: 0 0; } }
  .eway { display: grid; grid-template-columns: 38px 1fr 18px; align-items: center; gap: 10px; padding: 14px; border-radius: 14px; text-decoration: none; transition: transform .2s, background .15s, border-color .15s, box-shadow .2s; }
  .eway:hover { transform: translateY(-2px); }
  .eway--solid { background: #fff; color: var(--ink); box-shadow: 0 18px 34px -18px rgba(0, 0, 0, .6); }
  .eway--line { border: 1.5px solid rgba(255, 255, 255, .55); color: #fff; background: rgba(255, 255, 255, .06); }
  .eway--line:hover { background: rgba(255, 255, 255, .12); border-color: #fff; }
  .eway__ic { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; background: var(--red); color: #fff; }
  .eway--line .eway__ic { background: rgba(255, 255, 255, .14); }
  .eway__ic svg { width: 22px; height: 22px; }
  .eway__t b { display: block; font-size: .98rem; line-height: 1.2; white-space: nowrap; font-variation-settings: 'wght' 720; }
  .eway__t small { display: block; margin-top: 3px; font-size: .84rem; line-height: 1.3; opacity: .75; }
  .eway--solid .eway__t b { color: var(--red); }
  .eway :global(.eway__go) { width: 18px; height: 18px; transition: transform .2s; }
  .eway:hover :global(.eway__go) { transform: translateX(3px); }

  /* ---------- perks ---------- */
  .eqp { background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .eqp__list { list-style: none; margin: 0; padding: clamp(22px, 2.6vw, 34px) 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2vw, 32px); }
  .eqp__list li { display: grid; grid-template-columns: 46px minmax(0, 1fr); gap: 14px; align-items: start; }
  .eqp__ic { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: var(--red-tint); color: var(--red); }
  .eqp__ic svg { width: 24px; height: 24px; }
  .eqp b { display: block; font-size: 1.04rem; font-variation-settings: 'wght' 720; margin: 2px 0 3px; }
  .eqp small { display: block; color: var(--steel); font-size: .9rem; line-height: 1.45; }

  /* ---------- lineup ---------- */
  .eql { padding: clamp(56px, 7vw, 100px) 0; background: #fff; }
  .eql__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); gap: clamp(10px, 1.2vw, 16px); }
  .eqt { position: relative; display: grid; grid-template-rows: auto 1fr; height: 100%; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; text-decoration: none; color: var(--ink); background: linear-gradient(185deg, var(--tint) 0%, #fff 72%); transition: transform .45s cubic-bezier(.2, .8, .2, 1), box-shadow .45s, border-color .3s; }
  .eqt:hover { transform: translateY(-6px); border-color: var(--line-dark); box-shadow: 0 28px 50px -30px rgba(20, 23, 26, .5); }
  .eqt__img { display: grid; place-items: center; padding: 18px 18px 6px; overflow: hidden; }
  .eqt__img img { display: block; width: 100%; height: clamp(150px, 12.5vw, 210px); object-fit: contain; filter: drop-shadow(0 16px 14px rgba(20, 23, 26, .2)); transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
  .eqt__img img.is-blend { mix-blend-mode: multiply; filter: none; }
  .eqt:hover .eqt__img img { transform: translateY(-6px) scale(1.05); }
  .eqt__txt { display: grid; align-content: start; gap: 6px; padding: 8px 20px 20px; }
  .eqt__txt b { font-size: clamp(1.08rem, 1.25vw, 1.25rem); line-height: 1.15; letter-spacing: -.015em; font-variation-settings: 'wght' 750; }
  .eqt__txt small { color: var(--steel); font-size: .9rem; line-height: 1.4; }
  .eqt__mode { display: inline-flex; align-items: center; gap: 4px; margin-top: 6px; color: var(--red); font-size: .88rem; font-variation-settings: 'wght' 700; }
  .eqt__mode :global(svg) { width: 14px; height: 14px; transition: transform .2s; }
  .eqt:hover .eqt__mode :global(svg) { transform: translateX(3px); }
  .eqt:hover .eqt__txt b { color: var(--red); }

  /* ---------- rent or buy ---------- */
  .eqr { padding: clamp(56px, 7vw, 100px) 0; background: var(--haze); }
  .eqr__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px); }
  .eqr__card { display: grid; align-content: start; gap: 14px; padding: clamp(24px, 3vw, 44px); border-radius: 24px; background: #fff; border: 1px solid var(--line); }
  .eqr__card--dark { background: linear-gradient(160deg, #1d2126, #121417); color: #fff; border-color: #1d2126; }
  .eqr__tag { justify-self: start; margin: 0; padding: 5px 14px; border-radius: 999px; background: var(--red-tint); color: var(--red); font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 760; }
  .eqr__card--dark .eqr__tag { background: rgba(255, 255, 255, .1); color: var(--gold); }
  .eqr h3 { margin: 0; font-size: clamp(1.5rem, 2.2vw, 2.1rem); line-height: 1.08; letter-spacing: -.03em; font-variation-settings: 'wght' 760; font-weight: 400; }
  .eqr ul { list-style: none; margin: 4px 0 10px; padding: 0; display: grid; gap: 12px; }
  .eqr li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; font-size: 1rem; line-height: 1.45; color: var(--ink-2); opacity: 1; transform: none; }
  .eqr__card--dark li { color: #d6d9dc; }
  .eqr li :global(svg) { width: 22px; height: 22px; color: var(--red); }
  .eqr__card--dark li :global(svg) { color: var(--gold); }
  .eqr__card .eq-pill { justify-self: start; }
  .eqr__calc { margin: 22px 0 0; text-align: center; color: var(--steel); }
  .eqr__calc a { color: var(--red); font-variation-settings: 'wght' 700; text-underline-offset: 3px; }

  /* ---------- fleet ---------- */
  .eqf { padding: clamp(56px, 7vw, 100px) 0; background: linear-gradient(180deg, #15181c, #1d2126); color: #fff; }
  .eqf__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: clamp(10px, 1.2vw, 16px); }
  .eqft { display: grid; gap: 6px; height: 100%; padding: 18px 20px 20px; border-radius: 20px; text-decoration: none; color: #fff; background: rgba(255, 255, 255, .05); border: 1px solid rgba(255, 255, 255, .1); transition: background .3s, border-color .3s, transform .45s cubic-bezier(.2, .8, .2, 1); }
  .eqft:hover { background: rgba(255, 255, 255, .09); border-color: rgba(255, 255, 255, .25); transform: translateY(-5px); }
  .eqft__img { display: grid; place-items: center; padding: 12px; margin-bottom: 6px; border-radius: 14px; overflow: hidden; background: radial-gradient(closest-side, rgba(255, 255, 255, .95), rgba(255, 255, 255, .82)); }
