---
// Truck fleet landing page: what we rent, which truck fits the job, the TMA explorer, how renting works.
import Layout from '../../layouts/Layout.astro';
import Showroom from '../../components/Showroom.astro';
import TmaTruck from '../../components/TmaTruck.astro';
import { loadCatalog, img } from '../../lib/shopify.js';
import { cutouts } from '../../lib/cutouts.js';
import { PHONE, PHONE_TEL } from '../../lib/config.js';

const { colByHandle } = await loadCatalog();
const fleetCol = colByHandle.get('truck-rentals');
const blurbs = {
  'truck-mounted-attenuator-tma': 'Crash truck with an arrow board that protects crews from behind. Book it with a certified operator.',
  'scorpion-trailer-with-arrow-board': 'Trailer-mounted crash cushion with an arrow board, towed behind your own truck.',
  'bucket-truck': 'Aerial work at 45, 60 and 85 feet for signals, signs and overhead lines.',
  'bucket-van': 'Compact 30 ft aerial van for tight streets and quick hits.',
  'basket-truck': 'The cone truck: crews set and pick up cones fast and safely.',
  'flatbed-truck': 'Hauls barrier, drums and equipment to the job.'
};
const tints = ['#ffdede', '#fff1c9', '#e2edf8', '#ffe7d2', '#e3f3d8', '#ebebe8'];
const fleet = (fleetCol?.products || []).map((p, i) => ({
  handle: p.handle,
  href: `/products/${p.handle}`,
  title: p.title.replace(/\s*\(.*?\)\s*/g, ' ').trim(),
  blurb: blurbs[p.handle] || '',
  img: cutouts[p.handle] || (p.featuredImage ? img(p.featuredImage.url, 600) : ''),
  cut: !!cutouts[p.handle],
  tint: tints[i % tints.length]
}));
const byHandle = Object.fromEntries(fleet.map((f) => [f.handle, f]));
// "Which truck do I need?" guide; each card only shows if that truck is in the fleet collection.
const guide = [
  ['Protecting a crew on the highway', 'TMA crash truck', 'truck-mounted-attenuator-tma', 'Sits behind the work zone and takes the hit, so your crew doesn’t.'],
  ['Working up high', 'Bucket truck', 'bucket-truck', 'Signals, signs, lighting and overhead work up to 85 feet.'],
  ['Setting a lot of cones', 'Basket (cone) truck', 'basket-truck', 'Crews place and pick up cones from the basket, off the road.'],
  ['Moving barrier and gear', 'Flatbed truck', 'flatbed-truck', 'Gets barrier, drums and equipment where the job needs them.']
].filter((g) => byHandle[g[2]]).map(([q, t, h, d], i) => ({ q, t, d, href: byHandle[h].href, img: byHandle[h].img, tint: tints[i % tints.length] }));

const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const perks = [
  ['For the day or the job', 'Rent a truck for one shift or for the whole project.', 'M3.5 5h17v15.5h-17z M3.5 10h17 M8 3v4 M16 3v4'],
  ['Certified TMA operators', 'Book a crash truck with a trained operator in the seat.', 'M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z M8.5 12l2.4 2.4L15.5 9.8'],
  ['Pairs with our crews', 'Add flaggers or a full lane closure on the same order.', 'M9 7.5a3 3 0 1 0 0-.01 M3.5 20a5.5 5.5 0 0 1 11 0 M17 9a2.4 2.4 0 1 0 0-.01 M15.5 14.4A4.5 4.5 0 0 1 21 18.6'],
  ['NJ, NY, PA and CT', 'Trucks out of our own yard, across the region.', 'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z M12 7.6a2.4 2.4 0 1 0 0 .01']
];
// experience strip under the showroom (desktop)
const xp = [
  ['Daily, Weekly and Monthly Rentals', 'Keep a truck for one shift or the whole job.', 'M4 6h16v14H4z M4 10.5h16 M8.5 3.5v4 M15.5 3.5v4 M8 14.5h2.5 M13.5 14.5H16'],
  ['Pickup and Delivery Options', 'Customer Pick Up at our yard, or we deliver to the job.', 'M2.5 7h11v9h-11z M13.5 10h4l3 3.5V16h-7z M6.5 19a1.7 1.7 0 1 0 0-.01 M16.5 19a1.7 1.7 0 1 0 0-.01'],
  ['MUTCD Compliant and Certified', 'Every truck is equipped to MUTCD standards.', 'M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z M8.5 12l2.4 2.4L15.5 9.8'],
  ['Serving the Tri\u2011State Since 1971', 'Over five decades on the region’s roads.', 'M12 14.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11z M8.6 13.6L7 21l5-2.6 5 2.6-1.6-7.4 M12 6.6v2.6l1.6 1']
];
const steps = [
  ['Pick your truck', 'Choose from the fleet, or tell us the job and we’ll match the truck.'],
  ['Get pricing', 'A real person prices it, usually within 1 business day.'],
  ['We bring it out', 'On your date, with a certified operator when you need one.'],
  ['Done when you are', 'Keep it for the shift or the season. Extend any time.']
];
---
<Layout title="Truck fleet" description={`Rent TMA crash trucks, bucket trucks, cone trucks and flatbeds in NJ, NY, PA and CT. TMAs available with certified operators. Call ${PHONE}.`} image="/fleet/fleet-sunset.webp">
  <!-- ================= HERO ================= -->
  <section class="eqh">
    <div class="wrap eqh__in">
      <h1><span class="eqh__ln"><span>A Truck For Every Job.</span></span> <span class="eqh__ln"><span>No Matter The Scope.</span></span></h1>
      <Showroom animate tall band duo class="eqh__sr" />
      <p class="eqh__lede">Crash trucks, bucket trucks, cone trucks and flatbeds, rented by the day or the job across NJ, NY, PA and CT.</p>
      <div class="eqh__ways">
        <a href="/collections/truck-rentals" class="eway eway--solid">
          <span class="eway__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 7h11v9h-11z M13.5 10h4l3 3.5V16h-7z M6.5 19a1.7 1.7 0 1 0 0-.01 M16.5 19a1.7 1.7 0 1 0 0-.01" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg></span>
          <span class="eway__t"><b>See Our Fleet Options</b><small>Browse every truck we rent</small></span>
          <Fragment set:html={ARROW.replace('<svg', '<svg class="eway__go"')} />
        </a>
        <a href="/pages/request-a-quote?type=rental" class="eway eway--line">
          <span class="eway__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.5h9l3.5 3.5v13.5H6z M9.5 11h6 M9.5 14.5h6 M9.5 7.5h3" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round"/></svg></span>
          <span class="eway__t"><b>Get fleet pricing</b><small>By the day or the job</small></span>
          <Fragment set:html={ARROW.replace('<svg', '<svg class="eway__go"')} />
        </a>
      </div>
      <p class="eqh__call">Rather talk? Call <a href={PHONE_TEL}>{PHONE}</a></p>
    </div>
    <div class="eqh__xp" aria-label="Why rent from us">
      <div class="wrap">
        <ul>
          {xp.map(([label, sub, d], i) => (
            <li style={`--i:${i}`}>
              <span class="eqh__xi"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={d} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span class="eqh__xt"><b>{label}</b><small>{sub}</small></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>


  <!-- ================= THE FLEET ================= -->
  <section class="eql" data-in id="fleet">
    <div class="wrap">
      <div class="eq-head">
        <div>
          <p class="eq-k"><span></span>The fleet</p>
          <h2>See Our <em>Fleet Lineup.</em></h2>
        </div>
        <a href="/collections/truck-rentals" class="eq-link">Shop the fleet<Fragment set:html={ARROW} /></a>
      </div>
      <ul class="eql__grid eql__grid--big">
        {fleet.map((e, i) => (
          <li style={`--i:${i}`}>
            <div class="eqt" style={`--tint:${e.tint}`}>
              <a href={e.href} class="eqt__img" tabindex="-1" aria-hidden="true"><img src={e.img} alt="" loading="lazy" class={e.cut ? '' : 'is-blend'} /></a>
              <div class="eqt__txt">
                <b><a href={e.href}>{e.title}</a></b>
                {e.blurb && <small>{e.blurb}</small>}
                <div class="eqt__acts">
                  <a href={`/pages/request-a-quote?type=rental&add=${e.handle}&q=1`} class="eqt__btn eqt__btn--solid">Get a Quote</a>
                  <a href={e.href} class="eqt__btn eqt__btn--line">Learn More<Fragment set:html={ARROW} /></a>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= PERKS ================= -->
  <section class="eqp" data-in>
    <div class="wrap">
      <ul class="eqp__list">
        {perks.map(([t, d, ic], i) => (
          <li style={`--i:${i}`}>
            <span class="eqp__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ic} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span><b>{t}</b><small>{d}</small></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= WHICH TRUCK ================= -->
  {guide.length > 0 && (
    <section class="eqg" data-in>
      <div class="wrap">
        <div class="eq-head eq-head--center">
          <div>
            <p class="eq-k"><span></span>Which truck do I need?<span></span></p>
            <h2>Start with <em>the job.</em></h2>
          </div>
        </div>
        <ul class="eqg__grid">
          {guide.map((g, i) => (
            <li style={`--i:${i}`}>
              <a href={g.href} class="eqg__card">
                <p class="eqg__q">{g.q}</p>
                <span class="eqg__img" style={`--tint:${g.tint}`}><img src={g.img} alt="" loading="lazy" /></span>
                <h3>{g.t}</h3>
                <small>{g.d}</small>
                <span class="eqg__a">See the truck<Fragment set:html={ARROW} /></span>
              </a>
            </li>
          ))}
        </ul>
        <p class="eqr__calc">Not sure? <a href="/pages/request-a-quote?type=general">Describe the job and we’ll recommend the truck</a></p>
      </div>
    </section>
  )}

  <TmaTruck />

  <!-- ================= HOW IT WORKS ================= -->
  <section class="eqs" data-in>
    <div class="wrap">
      <div class="eq-head eq-head--center">
        <div>
          <p class="eq-k"><span></span>How renting works<span></span></p>
          <h2>From quote to <em>on site.</em></h2>
        </div>
      </div>
      <ol class="eqs__list">
        {steps.map(([t, d], i) => (
          <li style={`--i:${i}`}>
            <span class="eqs__n">{String(i + 1).padStart(2, '0')}</span>
            <b>{t}</b>
            <small>{d}</small>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="eqc" data-in>
    <div class="wrap eqc__in">
      <div>
        <p class="eq-k eq-k--light"><span></span>Free quote</p>
        <h2>Tell us the job. <em>We’ll bring the truck.</em></h2>
      </div>
      <div class="eqc__acts">
        <a href="/pages/request-a-quote?type=rental" class="eq-pill eq-pill--red">Get fleet pricing<Fragment set:html={ARROW} /></a>
        <a href="/pages/equipment" class="eq-pill eq-pill--glass">See equipment</a>
        <a href={PHONE_TEL} class="eqc__call">or call {PHONE}</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Phone hero: fill the screen below the header, leaving room for iPhone Safari's floating toolbar.
  {
    const hero = document.querySelector('.eqh'), box = hero?.querySelector('.eqh__in');
    const ios = /iP(hone|od)/.test(navigator.userAgent) || (navigator.maxTouchPoints > 1 && /Mac/.test(navigator.userAgent));
    let lastW = 0;
    const fit = () => {
      if (!box || innerWidth > 640) { box?.style.removeProperty('--fit-h'); return; }
      if (innerWidth === lastW && box.style.getPropertyValue('--fit-h')) return; // ignore toolbar show/hide resizes
      lastW = innerWidth;
      const top = hero.getBoundingClientRect().top + scrollY;
      const vh = window.visualViewport ? visualViewport.height : innerHeight;
      box.style.setProperty('--fit-h', Math.max(420, Math.round(vh - top - (ios ? 70 : 10))) + 'px');
    };
    fit(); document.fonts?.ready.then(() => { lastW = 0; fit(); }); addEventListener('resize', fit);
  }
  // Desktop hero: the stacked buttons match the width of the headline.
  {
    const box = document.querySelector('.eqh__in'), h1 = box?.querySelector('h1');
    const fit = () => { const w = Math.max(...[...h1.querySelectorAll('.eqh__ln > span')].map((e) => e.getBoundingClientRect().width)); if (w > 0) box.style.setProperty('--hw', Math.ceil(w) + 'px'); };
    if (h1) { fit(); document.fonts?.ready.then(fit); addEventListener('resize', fit); setTimeout(fit, 600); if ('ResizeObserver' in window) new ResizeObserver(fit).observe(h1); }
  }
</script>
<script>
  // Reveal sections (and stagger their lists) as they scroll into view.
  const els = document.querySelectorAll('[data-in]');
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) els.forEach((e) => e.classList.add('is-in'));
  else {
    const io = new IntersectionObserver((ents) => ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } }), { threshold: 0.12 });
    els.forEach((e) => io.observe(e));
  }
</script>

<style>
  /* ---------- shared section language (matches the homepage) ---------- */
  .eq-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 40px; margin-bottom: clamp(24px, 3vw, 40px); }
  .eq-head--center { justify-content: center; text-align: center; }
  .eq-head--center .eq-k { justify-content: center; }
  .eq-k { display: flex; align-items: center; gap: 12px; margin: 0 0 14px; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; font-variation-settings: 'wght' 680; color: var(--steel); }
  .eq-k span { width: 34px; height: 3px; border-radius: 2px; background: var(--red); }
  .eq-k--light { color: rgba(255, 255, 255, .8); }
  .eq-head h2, .eqc h2 { margin: 0; font-size: clamp(2.2rem, 4.6vw, 4.2rem); line-height: .98; letter-spacing: -.04em; font-variation-settings: 'wght' 780; font-weight: 400; text-wrap: balance; }
  .eq-head h2 em, .eqc h2 em { font-style: normal; color: var(--red); }
  .eq-link { display: inline-flex; align-items: center; gap: 10px; padding: 13px 22px 12px; border-radius: 999px; border: 1.5px solid var(--line-dark); color: var(--ink); font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, color .2s, border-color .2s; }
  .eq-link :global(svg) { width: 17px; height: 17px; transition: transform .2s; }
  .eq-link:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
  .eq-link:hover :global(svg) { transform: translateX(3px); }
  .eq-link--light { color: #fff; border-color: rgba(255, 255, 255, .35); }
  .eq-link--light:hover { background: #fff; color: var(--ink); border-color: #fff; }
  .eq-pill { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 14px 26px 13px; border-radius: 999px; font-size: 1.02rem; font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, transform .2s; }
  .eq-pill :global(svg) { width: 18px; height: 18px; transition: transform .2s; }
  .eq-pill:hover :global(svg) { transform: translateX(3px); }
  .eq-pill--red { background: var(--red); color: #fff; }
  .eq-pill--red:hover { background: #d10a0a; }
  .eq-pill--white { background: #fff; color: var(--ink); }
  .eq-pill--white:hover { background: #f1f2f3; }
  .eq-pill--glass { background: rgba(255, 255, 255, .08); color: #fff; border: 1.5px solid rgba(255, 255, 255, .4); }
  .eq-pill--glass:hover { background: rgba(255, 255, 255, .16); }
  [data-in] li { opacity: 0; transform: translateY(18px); transition: opacity .6s, transform .7s cubic-bezier(.2, .8, .2, 1); transition-delay: calc(var(--i, 0) * 60ms); }
  [data-in].is-in li { opacity: 1; transform: none; }

  /* ---------- hero ---------- */
  .eqh { position: relative; color: #fff; overflow: hidden; background: #14171a; isolation: isolate; }
  .eqh::before { content: none; }
  .eqh { background: #121416; }
  .eqh__xp { display: none; }
  @media (min-width: 1200px) {
    /* the hero fills the screen: showroom on top at its own size, experience strip in the space under it */
    .eqh { display: flex; flex-direction: column; min-height: min(calc(100svh - var(--hdr-full, 140px)), calc(100vw * 760 / 3000 + 340px)); }
    .eqh__xp { flex: 1; display: grid; align-content: center; padding: clamp(14px, 1.6vw, 28px) 0 clamp(22px, 2.4vw, 40px); background: linear-gradient(180deg, #121416, #0c0d0f); }
    .eqh__xp ul { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border: 1px solid rgba(255, 255, 255, .1); border-radius: 20px; background: linear-gradient(180deg, rgba(255, 255, 255, .06), rgba(255, 255, 255, .02)); box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .8), inset 0 1px 0 rgba(255, 255, 255, .08); overflow: hidden; opacity: 0; transform: translateY(16px); animation: eqUp .9s .8s cubic-bezier(.2, .8, .2, 1) forwards; }
    .eqh__xp ul::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: linear-gradient(90deg, transparent, #e0201c 20%, #e0201c 80%, transparent); opacity: .85; }
    .eqh__xp li { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: clamp(12px, 1.1vw, 18px); padding: clamp(18px, 1.9vw, 30px) clamp(16px, 1.7vw, 28px); border-left: 1px solid rgba(255, 255, 255, .08); transition: background .3s; }
    .eqh__xp li:first-child { border-left: 0; }
    .eqh__xp li:hover { background: rgba(255, 255, 255, .04); }
    .eqh__xi { display: grid; place-items: center; width: clamp(40px, 3.3vw, 50px); aspect-ratio: 1; border-radius: 13px; color: #ff6a5f; background: rgba(224, 32, 28, .14); border: 1px solid rgba(255, 90, 80, .28); }
    .eqh__xi svg { width: 56%; height: 56%; }
    .eqh__xt { display: grid; gap: 6px; }
    .eqh__xp b { font-size: clamp(1rem, 1.18vw, 1.26rem); line-height: 1.22; letter-spacing: -.012em; font-variation-settings: 'wght' 700; font-weight: 400; color: #fff; text-wrap: balance; }
    .eqh__xp small { font-size: clamp(.84rem, .92vw, .98rem); line-height: 1.45; color: rgba(255, 255, 255, .62); text-wrap: pretty; }
  }
  /* Wide screens: a short hero like the catalog one. Compact text on the left, trucks along the right. */
  @media (min-width: 1200px) {
    .eqh :global(.eqh__sr) { position: absolute; inset: 0 0 auto 0; height: calc(100vw * 760 / 3000); z-index: -1; }
    .eqh .eqh__in { width: 100%; height: calc(100vw * 760 / 3000); min-height: 0; flex: none; padding-block: clamp(22px, 2.2vw, 40px); }
    .eqh .eqh__in > * { max-width: 36%; }
    /* headline on top; two stacked buttons as wide as the headline, centered in the space down to the panel */
    .eqh .eqh__in { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; align-content: stretch; padding-block: clamp(26px, 2.9vw, 56px) 0; }
    .eqh .eqh__in > h1 { max-width: 38%; font-size: clamp(2rem, 3.1vw, 3.6rem); line-height: 1.04; margin-bottom: 0; }
    .eqh .eqh__lede, .eqh .eqh__call { display: none; }
    .eqh .eqh__in > .eqh__ways { display: grid; grid-template-columns: 1fr; gap: clamp(10px, .9vw, 14px); width: var(--hw, 34%); max-width: 38%; align-self: center; }
    .eqh .eway { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 0 clamp(18px, 1.7vw, 26px); min-height: clamp(46px, 3.8vw, 60px); border-radius: 999px; }
    .eqh .eway__ic, .eqh .eway__t small { display: none; }
    .eqh .eway__t b { font-size: clamp(.95rem, 1.12vw, 1.18rem); }
  }
  /* Narrower screens: headline, then the trucks as a full width strip, then the description and buttons. */
  @media (max-width: 1199px) {
    .eqh .eqh__in { min-height: 0; padding-block: 30px 30px; }
    /* the showroom wall runs from the top of the section, behind the headline, down to the trucks */
    .eqh .eqh__in { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto calc(100vw * 700 / 1870); --pt: 30px; }
    .eqh .eqh__in > * { grid-column: 1; }
    .eqh .eqh__in > h1 { grid-row: 1; position: relative; z-index: 1; }
    .eqh .eqh__in > :global(.eqh__sr) { grid-row: 1 / 3; grid-column: 1; max-width: none; width: 100vw; height: auto; aspect-ratio: auto; align-self: stretch; justify-self: start; margin: calc(var(--pt) * -1) 0 18px calc(50% - 50vw); }
    .eqh .eqh__lede { grid-row: 3; } .eqh .eqh__in > .eqh__ways { grid-row: 4; } .eqh .eqh__call { grid-row: 5; }
  }
  @media (min-width: 900px) {
    .eql .eq-head h2 { font-size: clamp(2rem, 3.4vw, 3.4rem); }
    section.eql { padding-top: clamp(40px, 4.4vw, 68px); }
  }
  @media (max-width: 899px) { .eql .eq-head h2 { font-size: clamp(1.7rem, 7.4vw, 2.4rem); white-space: nowrap; } section.eql { padding-top: 36px; } }
  /* short phone screens: slimmer buttons so the whole hero fits the first screen */
  /* very short phone screens: drop the call line (the menu has the phone number), then the description */
  @media (max-width: 640px) and (max-height: 700px) { section.eqh .eqh__in > .eqh__call { display: none; } }
  @media (max-width: 640px) and (max-height: 620px) { section.eqh .eqh__in > .eqh__lede { display: none; } }
  @media (max-width: 640px) and (max-height: 760px) {
    section.eqh .eqh__in .eway { padding: 7px 12px; grid-template-columns: 32px 1fr 18px; }
    section.eqh .eqh__in .eway__ic { width: 32px; height: 32px; border-radius: 9px; }
