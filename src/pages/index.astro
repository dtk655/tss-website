---
import Layout from '../layouts/Layout.astro';
import RoadHero from '../components/RoadHero.astro';
import ProductCard from '../components/ProductCard.astro';
import { loadCatalog, img } from '../lib/shopify.js';
import { YEARS } from '../lib/config.js';

const { byHandle, colByHandle } = await loadCatalog();
const pick = (hs) => hs.map((h) => byHandle.get(h)).filter(Boolean);
const featured = pick(['waterbarriertss590rparent', 'cone28inch', 'cone36inch', 'type-iii-breakaway-barricade-hi-intensity-left-stripes', 'traffic-drum-4-6-hi-intensity-reflective-stripes-w-tire-ring', 'class3safetyvest', 'sign-30x30-silver-red-hi-intensity-prismatic-080-alum-stop-sign', 'typea-c2006']);
const fleet = pick(['truck-mounted-attenuator-tma', 'arrow-board', 'variable-message-sign-vms-board', 'light-tower', 'portable-traffic-light', 'bucket-truck']);
const cats = ['cones', 'barricades', 'water-filled-barriers', 'traffic-drums', 'sign-shop', 'safety-gear'].map((h) => colByHandle.get(h)).filter(Boolean);
const wc = byHandle.get('waterbarriertss590rparent');
const agencies = ['NJDOT', 'NJ Turnpike Authority', 'Garden State Parkway', 'Port Authority of NY & NJ', 'NYSDOT', 'NYS Thruway', 'PennDOT'];
---
<Layout title="Traffic Safety Service: traffic control products, rentals and lane closures">
  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__copy">
        <h1 class="hero__h">Work zones, set up right<span class="dot">.</span></h1>
        <p class="hero__sub">Traffic control products shipped nationwide. Equipment rentals and union lane closure crews across New Jersey, New York, Pennsylvania and Connecticut, since 1971.</p>
        <div class="hero__cta">
          <a href="/pages/request-a-quote" class="btn">Request a quote</a>
          <a href="/collections" class="btn btn--ghost">Shop products</a>
        </div>
        <ul class="hero__proof" aria-label="Credentials">
          <li><strong>10,000+</strong> lane closures</li>
          <li><strong>{YEARS}</strong> years in business</li>
          <li><strong>24/7</strong> emergency response</li>
          <li><strong>ATSSA</strong>-certified flaggers</li>
        </ul>
      </div>
      <figure class="hero__panel reveal">
        <div class="hero__road"><RoadHero /></div>
        <figcaption>
          <span>A right-lane closure at MUTCD spacing, drawn by our free work zone builder.</span>
          <a class="textlink" href="/tools/work-zone-builder">Plan yours</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <div class="askbar">
    <form class="wrap askbar__in" data-hero-ask>
      <span class="askbar__cone" aria-hidden="true">
        <svg viewBox="0 0 100 116"><rect x="9" y="97" width="82" height="13" rx="4" fill="#1a1d21"/><path d="M44 9 Q50 3 56 9 L84 98 L16 98 Z" fill="#f26a1b"/><path d="M39.7 21 L60.3 21 L63 30 L37 30 Z" fill="#f4f6f8"/><path d="M22.7 80 L77.3 80 L80.3 90 L19.7 90 Z" fill="#f4f6f8"/><circle cx="40" cy="51" r="7" fill="#fff"/><circle cx="41" cy="52" r="3.8" fill="#1f2933"/><circle cx="60" cy="51" r="7" fill="#fff"/><circle cx="61" cy="52" r="3.8" fill="#1f2933"/><path d="M40.5 62 Q50 75 59.5 62 Z" fill="#5b1d06"/></svg>
      </span>
      <label for="hero-q"><strong>Ask Coney, our AI assistant</strong><span>Products, rentals, quotes — answered in seconds</span></label>
      <div class="askbar__row">
        <input id="hero-q" name="q" autocomplete="off" placeholder="I need 200 cones and 10 drums in Newark next week" />
        <button class="btn btn--sm" type="submit">Ask</button>
      </div>
    </form>
  </div>

  <section class="paths wrap" aria-label="What we do">
    <a class="path sign reveal" href="/collections">
      <h2>Buy products</h2>
      <p>Cones, drums, barricades, signs and safety gear. Custom colors and logos. Net terms for agencies and contractors.</p>
      <span class="path__go">Shop products</span>
    </a>
    <a class="path sign reveal" href="/collections/equipment-rentals" style="--d:80ms">
      <h2>Rent equipment</h2>
      <p>Crash trucks, arrow boards, message boards, light towers and everything we sell. Daily, weekly and monthly in NJ, NY, PA and CT.</p>
      <span class="path__go">See rentals</span>
    </a>
    <a class="path sign reveal" href="/pages/lane-closure" style="--d:160ms">
      <h2>Book a crew</h2>
      <p>MUTCD-compliant lane closures with ATSSA-certified flaggers, union labor and 24/7 emergency response.</p>
      <span class="path__go">Lane closure services</span>
    </a>
  </section>

  <div class="wrap">
    <p class="agencies reveal"><span>Experience with:</span> {agencies.join(' / ')}</p>
  </div>

  <section class="section section--haze">
    <div class="wrap">
      <div class="tools__head reveal">
        <div>
          <p class="kicker">Free planning tools</p>
          <h2>Plan the job before you call</h2>
        </div>
        <p class="lede">Built from how our crews actually set up work zones. Each tool ends in an equipment list you can send straight to us.</p>
      </div>
      <div class="tools__grid">
        <a href="/tools/work-zone-builder" class="tool tool--big reveal">
          <svg viewBox="0 0 400 150" aria-hidden="true" class="tool__art">
            <rect width="400" height="150" rx="8" fill="#1a1d21"/><line x1="0" y1="20" x2="400" y2="20" stroke="#f5b800" stroke-width="3"/><line x1="0" y1="130" x2="400" y2="130" stroke="#f7f7f2" stroke-width="3"/><line x1="0" y1="75" x2="400" y2="75" stroke="#f7f7f2" stroke-width="3" stroke-dasharray="24 30" opacity=".8"/>
            {[0,1,2,3,4,5,6,7].map((i) => <circle cx={150 + i * 16} cy={126 - i * 6.5} r="5" fill="#f26a1b"/>)}
            {[0,1,2,3,4].map((i) => <circle cx={280 + i * 24} cy={79} r="5" fill="#f26a1b"/>)}
            <rect x="268" y="95" width="30" height="22" rx="3" fill="#f5b800"/>
          </svg>
          <h3>Work zone builder</h3>
          <p>Pick the road, speed and lanes. See the taper, buffer and signs laid out to MUTCD spacing, with a full equipment count.</p>
          <span class="tool__go textlink">Open the builder</span>
        </a>
        <a href="/tools/watercade-planner" class="tool reveal" style="--d:80ms">
          <h3>WATERCADE planner</h3>
          <p>Lay out a barrier run or event perimeter and get the count, weight and water needed.</p>
        </a>
        <a href="/tools/3d-showroom" class="tool reveal" style="--d:160ms">
          <h3>3D showroom</h3>
          <p>Spin our cones, drums, barricades and barriers. Try your colors and logo.</p>
        </a>
        <a href="/tools/rent-vs-buy" class="tool reveal" style="--d:240ms">
          <h3>Rent or buy calculator</h3>
          <p>See where buying starts beating renting for your crew's real usage.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row-head reveal">
        <h2>Shop by category</h2>
        <a class="textlink" href="/collections">All categories</a>
      </div>
      <div class="cats">
        {cats.map((c, i) => (
          <a href={`/collections/${c.handle}`} class="cat reveal" style={`--d:${i * 50}ms`}>
            <span class="cat__img">{c.cover && <img src={img(c.cover.url, 420)} alt="" loading="lazy" />}</span>
            <span class="cat__t">{c.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="row-head reveal">
        <h2>Contractor favorites</h2>
        <a class="textlink" href="/collections/safety-products">Shop all products</a>
      </div>
      <div class="grid">{featured.map((p) => <ProductCard p={p} />)}</div>
    </div>
  </section>

  {wc && (
    <section class="section section--haze">
      <div class="wrap wcband__in">
        <div class="reveal">
          <p class="kicker">Our own barrier</p>
          <h2>WATERCADE<span class="tm">™</span></h2>
          <p class="lede">The 5-foot water-filled barrier we put our name on. 50 lbs empty so one person can place it, 650 lbs once filled. MASH TL-3 crash tested, interlocking ends, turn pins included.</p>
          <p>Used by highway contractors, police departments, DPWs, stadiums and festival crews. Orange or white, with custom colors, logos and 3M reflective striping available.</p>
          <div class="hero__cta">
            <a href={`/products/${wc.handle}`} class="btn">Shop WATERCADE</a>
            <a href="/tools/watercade-planner" class="btn btn--ghost">Plan a layout</a>
          </div>
        </div>
        <div class="wcband__img reveal" style="--d:100ms">{wc.featuredImage && <img src={img(wc.featuredImage.url, 900)} alt="WATERCADE water-filled barrier in orange" loading="lazy" />}</div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="row-head reveal">
        <h2>Rental fleet</h2>
        <a class="textlink" href="/collections/equipment-rentals">All rentals</a>
      </div>
      <div class="fleet">
        {fleet.map((p, i) => (
          <a href={`/products/${p.handle}`} class="fleet__i reveal" style={`--d:${i * 50}ms`}>
            <span class="fleet__img">{p.featuredImage && <img src={img(p.featuredImage.url, 500)} alt="" loading="lazy" />}</span>
            <span class="fleet__t">{p.title}</span>
            <span class="fleet__r">Daily, weekly or monthly</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark stats">
    <div class="wrap">
      <div class="stats__grid">
        <div class="reveal"><strong>{YEARS}</strong><span>years in business</span></div>
        <div class="reveal" style="--d:70ms"><strong>10,578</strong><span>lane closures completed</span></div>
        <div class="reveal" style="--d:140ms"><strong>35,017</strong><span>customers served</span></div>
        <div class="reveal" style="--d:210ms"><strong>3.1M</strong><span>cones sold</span></div>
      </div>
      <div class="why">
        <dl>
          <div class="reveal"><dt>Union crews</dt><dd>Trained, ATSSA-certified flaggers and laborers on every job.</dd></div>
          <div class="reveal" style="--d:60ms"><dt>24/7 response</dt><dd>Emergency closures for utilities, water main breaks and incidents.</dd></div>
          <div class="reveal" style="--d:120ms"><dt>Net terms</dt><dd>Purchase orders and accounts for municipalities, agencies and contractors.</dd></div>
          <div class="reveal" style="--d:180ms"><dt>One call</dt><dd>Products, rentals and crews from the same yard, on one invoice.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="final">
    <div class="wrap final__in reveal">
      <div>
        <h2>Tell us about the job</h2>
        <p>Products, rentals or a full crew. A real person replies, usually the same business day.</p>
      </div>
      <div class="final__cta">
        <a href="/pages/request-a-quote" class="btn">Request a quote</a>
        <a href="tel:+19085614800" class="btn btn--ghost">Call 908-561-4800</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const f = document.querySelector('[data-hero-ask]');
  const ask = (q) => { if (q && window.TSSChat) window.TSSChat.ask(q); };
  f?.addEventListener('submit', (e) => { e.preventDefault(); const q = f.q.value.trim(); ask(q); f.q.value = ''; });
</script>

<style>
  /* ---------------- hero ---------------- */
  .hero { background: #fff; }
  .hero__in { display: grid; grid-template-columns: 1.02fr 1fr; gap: clamp(36px, 5vw, 72px); align-items: center; padding-top: clamp(52px, 6.5vw, 96px); padding-bottom: clamp(40px, 5vw, 72px); }
  .hero__h { font-size: clamp(2.7rem, 4.6vw, 4.3rem); letter-spacing: -0.028em; text-wrap: balance; max-width: 13ch; }
  .dot { color: var(--red); }
  .hero__sub { font-size: var(--fs-2); color: var(--steel); margin: 22px 0 28px; max-width: 46ch; line-height: 1.5; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__proof { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 36px; margin: 34px 0 0; padding: 22px 0 0; border-top: 1px solid var(--line); color: var(--steel); font-size: .95rem; }
  .hero__proof strong { color: var(--ink); font-variation-settings: 'wght' 720; }
  .hero__panel { margin: 0; border: 1px solid var(--line); border-radius: var(--r-l); overflow: hidden; box-shadow: var(--shadow-l); background: #1a1d21; }
  .hero__road :global(.road) { height: clamp(200px, 22vw, 300px); }
  .hero__panel figcaption { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 18px 13px; background: #fff; border-top: 1px solid var(--line); font-size: .92rem; color: var(--steel); }
  .hero__panel figcaption a { white-space: nowrap; }

  /* ---------------- ask bar ---------------- */
  .askbar { border-block: 1px solid var(--line); background: var(--haze); }
  .askbar__in { display: flex; align-items: center; gap: 18px; padding-block: 14px; }
  .askbar__cone { width: 34px; height: 39px; flex: none; }
  .askbar__in label { display: grid; line-height: 1.3; cursor: pointer; flex: none; }
  .askbar__in label strong { font-variation-settings: 'wght' 660; font-size: .98rem; }
  .askbar__in label span { color: var(--steel); font-size: .85rem; }
  .askbar__row { display: flex; gap: 8px; flex: 1; }
  .askbar__row input { flex: 1; min-width: 0; min-height: 44px; padding: 10px 14px 9px; border-radius: var(--r-s); border: 1.5px solid var(--line-dark); background: #fff; }
  .askbar__row input:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3.5px rgba(20, 23, 26, .08); }
  @media (max-width: 860px) { .askbar__in { flex-wrap: wrap; gap: 10px 14px; } .askbar__row { flex-basis: 100%; } }

  /* ---------------- paths ---------------- */
  .paths { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: clamp(44px, 5.5vw, 72px); }
  .path { display: flex; flex-direction: column; gap: 10px; padding: 30px 30px 26px; text-decoration: none; min-height: 230px; border-top: 3px solid var(--red); transition: border-color .15s ease, box-shadow .15s ease; }
  .path:hover { box-shadow: var(--shadow-m); border-color: var(--line-dark); border-top-color: var(--red); }
  .path h2 { font-size: var(--fs-3); }
  .path p { margin: 0; line-height: 1.55; color: var(--steel); }
  .path__go { margin-top: auto; padding-top: 16px; font-variation-settings: 'wght' 650; color: var(--red); }

  .agencies { margin: clamp(40px, 5vw, 64px) 0 0; padding-top: 18px; border-top: 1px solid var(--line); color: var(--steel); font-size: .92rem; line-height: 2; }
  .agencies span { color: var(--ink); font-variation-settings: 'wght' 660; margin-right: 6px; }

  /* ---------------- tools ---------------- */
  .tools__head { display: grid; grid-template-columns: 1.1fr 1fr; gap: 32px; align-items: end; margin-bottom: 34px; }
  .tools__head .lede { margin: 0; }
  .tools__grid { display: grid; grid-template-columns: 1.45fr 1fr 1fr; grid-template-rows: auto auto auto; gap: 16px; }
  .tool { background: #fff; border: 1px solid var(--line); border-radius: var(--r-m); padding: 24px; text-decoration: none; display: flex; flex-direction: column; gap: 8px; transition: border-color .15s ease, box-shadow .15s ease; }
  .tool:hover { border-color: var(--line-dark); box-shadow: var(--shadow-m); }
  .tool h3 { font-size: var(--fs-2); }
  .tool p { margin: 0; color: var(--steel); line-height: 1.5; font-size: .98rem; }
  .tool--big { grid-row: span 3; }
  .tool--big h3 { font-size: var(--fs-3); }
  .tool__art { width: 100%; height: auto; margin-bottom: 12px; }
  .tool__go { margin-top: auto; padding-top: 14px; }
  .tools__grid .tool:not(.tool--big) { grid-column: 2 / span 2; }

  /* ---------------- shared rows ---------------- */
  .row-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 28px; flex-wrap: wrap; }
  .cats { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .cat { background: #fff; border: 1px solid var(--line); border-radius: var(--r-m); padding: 16px 14px 14px; text-decoration: none; display: grid; gap: 8px; text-align: center; transition: border-color .15s ease, box-shadow .15s ease; }
  .cat:hover { border-color: var(--line-dark); box-shadow: var(--shadow-m); }
  .cat__img { aspect-ratio: 1; display: grid; place-items: center; }
  .cat__img img { width: 100%; height: 100%; object-fit: contain; transition: transform .2s ease; }
  .cat:hover .cat__img img { transform: scale(1.05); }
  .cat__t { font-variation-settings: 'wght' 640; font-size: .96rem; }

  .wcband__in { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  .wcband__in h2 { font-size: clamp(2.2rem, 4vw, 3.4rem); margin-bottom: 4px; }
  .tm { font-size: .45em; vertical-align: super; }
  .wcband__img img { width: 100%; max-height: 440px; object-fit: contain; filter: drop-shadow(0 26px 24px rgba(20, 23, 26, .18)); }

  .fleet { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 16px; }
  .fleet__i { background: #fff; border: 1px solid var(--line); border-radius: var(--r-m); padding: 14px 14px 16px; text-decoration: none; display: grid; gap: 10px; transition: border-color .15s ease, box-shadow .15s ease; }
  .fleet__i:hover { border-color: var(--line-dark); box-shadow: var(--shadow-m); }
  .fleet__img { aspect-ratio: 4/3; display: grid; place-items: center; overflow: hidden; }
  .fleet__img img { width: 100%; height: 100%; object-fit: contain; }
  .fleet__t { font-variation-settings: 'wght' 640; line-height: 1.3; font-size: .97rem; }
  .fleet__r { color: var(--steel); font-size: .85rem; }

  /* ---------------- stats + why ---------------- */
  .stats__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; padding-bottom: 46px; margin-bottom: 46px; border-bottom: 1px solid var(--asphalt-line); }
  .stats__grid div { display: grid; gap: 4px; }
  .stats__grid strong { font-size: clamp(2.4rem, 4vw, 3.6rem); font-variation-settings: 'wght' 740; letter-spacing: -0.02em; line-height: 1; }
  .stats__grid span { color: #9aa1a8; font-size: .95rem; }
  .why dl { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; margin: 0; }
  .why dt { font-variation-settings: 'wght' 700; font-size: var(--fs-2); margin-bottom: 6px; }
  .why dd { margin: 0; color: #9aa1a8; line-height: 1.55; font-size: .97rem; }

  .final { padding: clamp(56px, 7vw, 96px) 0; }
  .final__in { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding: 44px clamp(26px, 4vw, 52px); background: var(--haze); border: 1px solid var(--line); border-radius: var(--r-l); }
  .final h2 { margin-bottom: 6px; }
  .final p { margin: 0; color: var(--steel); }
  .final__cta { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 1020px) {
    .hero__in, .tools__head, .wcband__in { grid-template-columns: 1fr; }
    .paths { grid-template-columns: 1fr; }
    .path { min-height: 0; }
    .tools__grid { grid-template-columns: 1fr; }
    .tool--big { grid-row: auto; }
    .tools__grid .tool:not(.tool--big) { grid-column: auto; }
    .cats { grid-template-columns: repeat(3, 1fr); }
    .stats__grid, .why dl { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) { .cats { grid-template-columns: repeat(2, 1fr); } .why dl { grid-template-columns: 1fr; } }
</style>
