---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeCategories from '../components/HomeCategories.astro';
import BuyOrRent from '../components/BuyOrRent.astro';
import { YEARS } from '../lib/config.js';

const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const ARROW = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const CHK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const fleet = [
  { t: 'Arrow boards', s: 'Solar, 15 and 25 lamp', img: '/fleet/cut/arrow-board.png', href: '/products/arrow-board' },
  { t: 'Message boards', s: 'Full-matrix VMS', img: '/fleet/cut/vms.png', href: '/products/variable-message-sign-vms-board' },
  { t: 'Light towers', s: 'LED night work', img: '/fleet/cut/light-tower.png', href: '/products/light-tower' },
  { t: 'Portable signals', s: 'Solar traffic lights', img: '/fleet/cut/traffic-light.png', href: '/products/portable-traffic-light' },
  { t: 'Bucket vans', s: '30 ft reach', img: '/fleet/cut/bucket-van.png', href: '/products/bucket-van', wide: true }
];
const agencies = [
  ['NJ Turnpike Authority', 'Untitled_design_26.png'], ['Garden State Parkway', 'Untitled_design_23.png'], ['NJDOT', 'Untitled_design_27.png'],
  ['Port Authority of NY & NJ', 'Untitled_design_28.png'], ['NYS Thruway', 'Untitled_design_24.png'], ['NYSDOT', 'Untitled_design_29.png'], ['PennDOT', 'Untitled_design_30.png']
];
const reasons = [
  ['Certified, experienced crews', 'Rutgers-certified captains, ATSSA flaggers and OSHA-trained laborers on every job.'],
  ['Built in-house', 'Our sign shop and yard make custom signs, stenciled cones and branded gear.'],
  ['Accounts and net terms', 'Purchase orders and terms for agencies, towns and contractors.'],
  ['One yard, one invoice', 'Products, rentals and crews from the same place, billed together.']
];
const prompts = ['I need 200 cones in Newark next week', 'Price a lane closure on a state highway', 'Rent an arrow board for 3 days'];
---
<Layout title="Traffic Safety Service: Traffic Control Products, Rentals And Lane Closures">
  <HomeHero />

  <HomeCategories />

  <BuyOrRent />

  <!-- ============ RENTAL FLEET ============ -->
  <section class="fl" data-in>
    <div class="wrap">
      <div class="hs-head">
        <div>
          <p class="hs-k"><span></span>Rental fleet</p>
          <h2>Trucks and equipment. <em>Ready to roll.</em></h2>
        </div>
        <a href="/collections/equipment-rentals" class="hs-link">All rentals<Fragment set:html={ARROW} /></a>
      </div>
      <div class="fl__grid">
        <a href="/products/truck-mounted-attenuator-tma" class="fl__hero">
          <img src={CDN + 'thumbnail_IMG_1133_c2839bba-db54-470f-80d2-804e82e3fd23.jpg'} alt="TSS truck-mounted attenuator truck 199" loading="lazy" />
          <span class="fl__shade" aria-hidden="true"></span>
          <span class="fl__card">
            <span class="fl__tag">Featured</span>
            <b>TMA crash trucks</b>
            <span class="fl__p">Truck-mounted attenuators with arrow boards, run by certified operators.</span>
            <span class="fl__cta">Book a TMA<Fragment set:html={ARROW} /></span>
          </span>
        </a>
        {fleet.map((f, i) => (
          <a href={f.href} class:list={['fl__tile', f.wide && 'fl__tile--wide']} style={`--i:${i}`}>
            <span class="fl__img"><img src={f.img} alt="" loading="lazy" /></span>
            <span class="fl__txt"><b>{f.t}</b><small>{f.s}</small></span>
            <span class="fl__go" set:html={ARROW} />
          </a>
        ))}
      </div>
      <p class="fl__note"><span>Daily, weekly or monthly</span><span>Delivered across NJ, NY, PA and CT</span><span>Serviced in our own yard</span></p>
    </div>
  </section>

  <!-- ============ LANE CLOSURES ============ -->
  <section class="lc" data-in>
    <img class="lc__bg" src="/fleet/lc-hero.webp" alt="" loading="lazy" />
    <span class="lc__shade" aria-hidden="true"></span>
    <div class="wrap lc__in">
      <div class="lc__copy">
        <p class="hs-k hs-k--light"><span></span>Lane closure division</p>
        <h2>Lane closures, <em>set up right.</em></h2>
        <p class="lc__lede">Certified, experienced crews running MUTCD-compliant work zones on the region's busiest roads.</p>
        <div class="lc__cta">
          <a href="/pages/request-a-quote?type=lane-closure" class="pill pill--red">Book a crew<Fragment set:html={ARROW} /></a>
          <a href="/tools/lane-closure-plan" class="pill pill--glass">Get a free closure plan</a>
        </div>
      </div>
      <ul class="lc__stats">
        <li><b><span data-countup>25,000</span>+</b><span>closures completed</span></li>
        <li><b>5</b><span>states: NJ, NY, PA, CT, DE</span></li>
        <li><b>8</b><span>closure services, one call</span></li>
      </ul>
    </div>
  </section>

  <!-- ============ WATERCADE ============ -->
  <section class="wc" data-in>
    <div class="wrap">
      <a href="/watercade/" class="wc__band">
        <video class="wc__vid" autoplay muted loop playsinline preload="none" poster="/watercade/hero-poster.jpg" aria-hidden="true">
          <source src="/watercade/hero-1280.mp4" type="video/mp4" />
        </video>
        <span class="wc__shade" aria-hidden="true"></span>
        <span class="wc__body">
          <img class="wc__logo" src="/watercade/logo-white.png" alt="WATERCADE" width="1932" height="237" loading="lazy" />
          <span class="wc__h">Our own crash-tested barrier.</span>
          <span class="wc__p">Designed and built by TSS. Buy it, rent it by the job, or customize it with your colors and logo.</span>
          <span class="wc__chips"><i>MASH TL-3</i><i>50 lbs empty</i><i>650 lbs filled</i><i>90° swivel pin</i></span>
          <span class="wc__cta">Explore WATERCADE<Fragment set:html={ARROW} /></span>
        </span>
      </a>
    </div>
  </section>

  <!-- ============ WHY TSS ============ -->
  <section class="why" data-in>
    <div class="wrap">
      <div class="hs-head">
        <div>
          <p class="hs-k"><span></span>Why TSS</p>
          <h2>Trusted on the region's <em>toughest roads.</em></h2>
        </div>
      </div>
      <ul class="why__stats">
        <li><b><span data-countup>{YEARS}</span></b><span>years in business</span></li>
        <li><b><span data-countup>25,000</span>+</b><span>lane closures</span></li>
        <li><b><span data-countup>35,000</span>+</b><span>customers served</span></li>
        <li><b><span data-countup>3.1</span>M</b><span>cones sold</span></li>
      </ul>
      <div class="why__grid">
        <ol class="why__list">
          {reasons.map(([t, d], i) => (
            <li style={`--i:${i}`}><span class="why__n">0{i + 1}</span><span><b>{t}</b><small>{d}</small></span></li>
          ))}
        </ol>
        <div class="why__ag">
          <p>Approved and experienced with</p>
          <ul>{agencies.map(([t, f], i) => <li style={`--i:${i}`} title={t}><img src={CDN + f} alt={t} loading="lazy" width="72" height="72" /><span>{t}</span></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="fin" data-in>
    <div class="wrap">
      <div class="fin__card">
        <div class="fin__main">
          <p class="hs-k hs-k--light"><span></span>Start here</p>
          <h2>Tell us about the job.</h2>
          <p class="fin__lede">Products, rentals or a full crew. A real person replies, usually the same business day.</p>
          <div class="fin__cta">
            <a href="/pages/request-a-quote" class="pill pill--red">Request a quote<Fragment set:html={ARROW} /></a>
            <a href="tel:+19085614800" class="pill pill--glass">Call 908-561-4800</a>
          </div>
        </div>
        <div class="fin__ask">
          <p class="fin__askk"><span class="fin__ai">AI</span>Or just ask Conner</p>
          {prompts.map((q, i) => (
            <button type="button" class="fin__q" data-ask={q} style={`--i:${i}`}>
              <span>“{q}”</span><Fragment set:html={ARROW} />
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('[data-ask]').forEach((b) => b.addEventListener('click', () => (window as any).TSSChat?.ask(b.getAttribute('data-ask'))));
  const els = document.querySelectorAll<HTMLElement>('[data-in]');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) els.forEach((e) => e.classList.add('is-in'));
  else {
    const io = new IntersectionObserver((ents) => ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } }), { threshold: 0.12 });
    els.forEach((e) => io.observe(e));
  }
</script>

<style is:global>
  /* shared homepage section language: red-dash kicker, tight display headline, pill link */
  .hs-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 40px; margin-bottom: clamp(24px, 3vw, 40px); }
  .hs-k { display: flex; align-items: center; gap: 12px; margin: 0 0 14px; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; font-variation-settings: 'wght' 680; color: var(--steel); }
  .hs-k span { width: 34px; height: 3px; border-radius: 2px; background: var(--red); }
  .hs-k--light { color: rgba(255,255,255,.8); }
  .hs-head h2, .lc h2, .fin h2 { margin: 0; font-size: clamp(2.2rem, 4.6vw, 4.2rem); line-height: .98; letter-spacing: -.04em; font-variation-settings: 'wght' 780; text-wrap: balance; }
  .hs-head h2 em, .lc h2 em { font-style: normal; color: var(--red); }
  .hs-link { display: inline-flex; align-items: center; gap: 10px; padding: 13px 22px 12px; border-radius: 999px; border: 1.5px solid var(--line-dark); color: var(--ink); font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, color .2s, border-color .2s; }
  .hs-link svg { width: 17px; height: 17px; transition: transform .2s; }
  .hs-link:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
  .hs-link:hover svg { transform: translateX(3px); }
  .pill { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 15px 28px 14px; border-radius: 999px; font-size: 1.04rem; font-variation-settings: 'wght' 700; text-decoration: none; white-space: nowrap; transition: background .2s, border-color .2s, transform .2s; }
  .pill svg { width: 18px; height: 18px; transition: transform .2s; }
  .pill:hover svg { transform: translateX(3px); }
  .pill--red { background: var(--red); color: #fff; }
  .pill--red:hover { background: #d10a0a; }
  .pill--glass { color: #fff; border: 1px solid rgba(255,255,255,.45); background: rgba(255,255,255,.08); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .pill--glass:hover { background: rgba(255,255,255,.16); border-color: #fff; }
  @media (max-width: 640px) {
    .hs-head { flex-direction: column; align-items: center; text-align: center; }
    .hs-k { justify-content: center; }
    .hs-head h2, .lc h2, .fin h2 { font-size: 2rem; }
    .hs-link { padding: 11px 18px 10px; font-size: .92rem; }
    .pill { min-height: 52px; font-size: .98rem; padding-inline: 20px; }
  }
</style>

<style>
  /* =================== FLEET =================== */
  .fl { padding: clamp(56px, 7vw, 100px) 0; background: var(--haze); }
  .fl__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: clamp(10px, 1.2vw, 16px); min-height: clamp(460px, 40vw, 600px); }
  .fl__hero { grid-row: 1 / 3; position: relative; overflow: hidden; border-radius: 24px; color: #fff; text-decoration: none; background: #111; isolation: isolate; opacity: 0; transform: translateY(20px); transition: opacity .8s, transform .9s cubic-bezier(.2,.8,.2,1); }
  .fl.is-in .fl__hero { opacity: 1; transform: none; }
  .fl__hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 30% 50%; z-index: -2; transition: transform 1.4s cubic-bezier(.2,.8,.2,1); }
  .fl__hero:hover img { transform: scale(1.05); }
  .fl__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(8,9,11,0) 40%, rgba(8,9,11,.82) 100%); }
  .fl__card { position: absolute; left: 18px; right: 18px; bottom: 18px; display: grid; gap: 6px; padding: 22px; border-radius: 18px; background: rgba(12,13,15,.45); border: 1px solid rgba(255,255,255,.18); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  .fl__tag { width: fit-content; padding: 4px 10px 3px; border-radius: 999px; background: var(--red); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; font-variation-settings: 'wght' 760; }
  .fl__card b { font-size: clamp(1.5rem, 2.2vw, 2rem); line-height: 1.05; letter-spacing: -.03em; font-variation-settings: 'wght' 780; }
  .fl__p { font-size: .95rem; line-height: 1.45; color: rgba(255,255,255,.82); }
  .fl__cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-variation-settings: 'wght' 700; }
  .fl__cta :global(svg) { width: 18px; height: 18px; transition: transform .2s; }
  .fl__hero:hover .fl__cta :global(svg) { transform: translateX(4px); }

  .fl__tile { position: relative; display: grid; grid-template-rows: 1fr auto; padding: 16px 18px 18px; border-radius: 20px; background: #fff; border: 1px solid var(--line); color: var(--ink); text-decoration: none; overflow: hidden; opacity: 0; transform: translateY(20px); transition: opacity .7s, transform .8s cubic-bezier(.2,.8,.2,1), box-shadow .4s, border-color .3s; transition-delay: calc(.1s + var(--i) * 70ms); }
  .fl.is-in .fl__tile { opacity: 1; transform: none; }
  .fl__tile:hover { transform: translateY(-6px); box-shadow: 0 28px 50px -30px rgba(20,23,26,.5); border-color: var(--line-dark); transition-delay: 0s; }
  .fl__tile--wide { grid-column: span 2; }
  .fl__img { display: grid; place-items: center; min-height: 0; padding-bottom: 10px; background: radial-gradient(60% 50% at 50% 85%, rgba(20,23,26,.08), transparent 70%); }
  .fl__img img { max-width: 86%; max-height: clamp(110px, 11vw, 170px); object-fit: contain; filter: drop-shadow(0 16px 14px rgba(20,23,26,.18)); transition: transform .5s cubic-bezier(.2,.8,.2,1); }
  .fl__tile:hover .fl__img img { transform: translateY(-6px) scale(1.04); }
  .fl__txt { display: grid; gap: 2px; padding-right: 40px; }
  .fl__txt b { font-size: 1.15rem; letter-spacing: -.015em; font-variation-settings: 'wght' 750; }
  .fl__txt small { font-size: .85rem; color: var(--steel); }
  .fl__go { position: absolute; right: 16px; bottom: 18px; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line-dark); transition: background .3s, color .3s, border-color .3s; }
  .fl__go :global(svg) { width: 15px; height: 15px; }
  .fl__tile:hover .fl__go { background: var(--red); border-color: var(--red); color: #fff; }
  .fl__tile:hover .fl__txt b { color: var(--red); }
  .fl__note { display: flex; flex-wrap: wrap; gap: 8px 32px; margin: 22px 0 0; font-size: .9rem; color: var(--steel); }
  .fl__note span { white-space: nowrap; display: inline-flex; align-items: center; gap: 10px; }
  .fl__note span::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--red); }

  /* =================== LANE CLOSURES BAND =================== */
  .lc { position: relative; overflow: hidden; color: #fff; background: #0b0c0e; isolation: isolate; }
  .lc__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 45%; z-index: -2; transform: scale(1.08); transition: transform 2.4s cubic-bezier(.2,.8,.2,1); }
  .lc.is-in .lc__bg { transform: scale(1); }
  .lc__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(8,9,11,.88) 0%, rgba(8,9,11,.6) 45%, rgba(8,9,11,.15) 100%), linear-gradient(0deg, rgba(8,9,11,.6), transparent 50%); }
  .lc__in { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 32px 56px; align-items: end; min-height: clamp(480px, 46vw, 640px); padding-block: clamp(56px, 7vw, 100px); }
  .lc h2 { color: #fff; }
  .lc h2 em { color: #ff4a3d; }
  .lc__copy > * { opacity: 0; transform: translateY(16px); transition: opacity .7s, transform .8s cubic-bezier(.2,.8,.2,1); }
  .lc.is-in .lc__copy > * { opacity: 1; transform: none; }
  .lc.is-in .lc__copy > :nth-child(2) { transition-delay: .1s; } .lc.is-in .lc__copy > :nth-child(3) { transition-delay: .2s; } .lc.is-in .lc__copy > :nth-child(4) { transition-delay: .3s; }
  .lc__lede { margin: 18px 0 0; max-width: 46ch; font-size: clamp(1.05rem, 1.35vw, 1.25rem); line-height: 1.55; color: rgba(255,255,255,.85); }
  .lc__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .lc__stats { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .lc__stats li { display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 16px; padding: 18px 22px; border-radius: 16px; background: rgba(12,13,15,.42); border: 1px solid rgba(255,255,255,.16); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); opacity: 0; transform: translateX(20px); transition: opacity .7s, transform .8s cubic-bezier(.2,.8,.2,1); }
  .lc.is-in .lc__stats li { opacity: 1; transform: none; }
  .lc.is-in .lc__stats li:nth-child(2) { transition-delay: .12s; } .lc.is-in .lc__stats li:nth-child(3) { transition-delay: .24s; }
  .lc__stats b { font-size: clamp(1.8rem, 2.6vw, 2.5rem); line-height: 1; letter-spacing: -.03em; font-variation-settings: 'wght' 800; }
  .lc__stats li > span { font-size: .95rem; color: rgba(255,255,255,.78); }

  /* =================== WATERCADE =================== */
  .wc { padding: clamp(56px, 7vw, 100px) 0 0; background: #fff; }
  .wc__band { position: relative; display: flex; align-items: center; min-height: clamp(400px, 38vw, 560px); border-radius: 28px; overflow: hidden; isolation: isolate; color: #fff; text-decoration: none; background: #0b1b3d; opacity: 0; transform: translateY(24px) scale(.985); transition: opacity .9s, transform 1s cubic-bezier(.2,.8,.2,1); }
  .wc.is-in .wc__band { opacity: 1; transform: none; }
  .wc__vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 60%; z-index: -2; transition: transform 1.4s cubic-bezier(.2,.8,.2,1); }
  .wc__band:hover .wc__vid { transform: scale(1.03); }
  .wc__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(6,22,52,.94) 0%, rgba(6,22,52,.72) 40%, rgba(6,22,52,.1) 75%); }
  .wc__body { display: grid; gap: 14px; justify-items: start; max-width: 560px; padding: clamp(28px, 4vw, 64px); }
  .wc__logo { width: clamp(220px, 24vw, 330px); height: auto; }
  .wc__h { font-size: clamp(1.8rem, 3.2vw, 3rem); line-height: 1; letter-spacing: -.035em; font-variation-settings: 'wght' 780; }
  .wc__p { font-size: clamp(1rem, 1.2vw, 1.12rem); line-height: 1.55; color: rgba(225,234,246,.9); }
  .wc__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .wc__chips i { font-style: normal; font-size: .84rem; font-variation-settings: 'wght' 680; padding: 7px 13px 6px; border-radius: 999px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.28); backdrop-filter: blur(8px); white-space: nowrap; }
  .wc__cta { display: inline-flex; align-items: center; gap: 10px; margin-top: 6px; padding: 15px 26px 14px; border-radius: 999px; background: #fff; color: #0b2a5b; font-variation-settings: 'wght' 720; transition: background .2s, color .2s; }
  .wc__cta :global(svg) { width: 18px; height: 18px; transition: transform .2s; }
  .wc__band:hover .wc__cta { background: #1a8fd8; color: #fff; }
  .wc__band:hover .wc__cta :global(svg) { transform: translateX(4px); }

  /* =================== WHY =================== */
  .why { padding: clamp(56px, 7vw, 100px) 0; background: #fff; }
  .why__stats { list-style: none; margin: 0 0 clamp(28px, 3.4vw, 48px); padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .why__stats li { display: grid; gap: 6px; padding: clamp(20px, 2.4vw, 32px) clamp(14px, 2vw, 28px); }
  .why__stats li + li { border-left: 1px solid var(--line); }
  .why__stats b { font-size: clamp(2.4rem, 4.6vw, 4.4rem); line-height: .95; letter-spacing: -.045em; font-variation-settings: 'wght' 800; }
  .why__stats li:nth-child(2) b { color: var(--red); }
  .why__stats li > span { font-size: .95rem; color: var(--steel); }
  .why__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  .why__list { list-style: none; margin: 0; padding: 0; }
  .why__list li { display: grid; grid-template-columns: 44px 1fr; gap: 10px; padding: 18px 0; border-bottom: 1px solid var(--line); opacity: 0; transform: translateY(14px); transition: opacity .6s, transform .7s cubic-bezier(.2,.8,.2,1); transition-delay: calc(var(--i) * 80ms); }
  .why__list li:first-child { border-top: 1px solid var(--line); }
  .why.is-in .why__list li { opacity: 1; transform: none; }
  .why__n { font-size: .8rem; letter-spacing: .1em; font-variation-settings: 'wght' 760; color: var(--red); padding-top: 5px; }
