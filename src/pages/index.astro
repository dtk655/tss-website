---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import QuickView from '../components/QuickView.astro';
import CategoryRails from '../components/CategoryRails.astro';
import WatercadeBand from '../components/WatercadeBand.astro';
import { loadCatalog, img } from '../lib/shopify.js';
import { YEARS } from '../lib/config.js';

const { byHandle } = await loadCatalog();
const pick = (hs) => hs.map((h) => byHandle.get(h)).filter(Boolean);
const favorites = pick(['cone28inch', 'waterbarriertss590rparent', 'type-iii-breakaway-barricade-hi-intensity-left-stripes', 'traffic-drum-4-6-hi-intensity-reflective-stripes-w-tire-ring', 'class3safetyvest']);
const fleet = pick(['truck-mounted-attenuator-tma', 'arrow-board', 'variable-message-sign-vms-board', 'light-tower', 'portable-traffic-light', 'bucket-van']);
const fleetTints = ['#ffe7d2', '#fff1c9', '#e2edf8', '#ebebe8', '#e3f3d8', '#ffdede'];
const agencies = ['NJDOT', 'NJ Turnpike Authority', 'Garden State Parkway', 'Port Authority of NY & NJ', 'NYSDOT', 'NYS Thruway', 'PennDOT'];
const CDN = 'https://cdn.shopify.com/s/files/1/0587/7701/0241/files/';
const prompts = ['I need 200 cones in Newark next week', 'Price a lane closure on a state highway', 'Rent an arrow board for 3 days'];
---
<Layout title="Traffic Safety Service: traffic control products, rentals and lane closures">
  <!-- ============ HERO ============ -->
  <section class="hhero">
    <img class="hhero__photo" src={img(CDN + 'tss.jpg', 2200)} alt="" fetchpriority="high" />
    <span class="hhero__scrim" aria-hidden="true"></span>
    <div class="wrap hhero__in">
      <div class="hhero__copy">
        <p class="hhero__k">Traffic Safety Service · New Jersey</p>
        <h1>Work zones, set up right.</h1>
        <p class="hhero__lede">Products, rentals and certified lane closure crews. One call, one yard, since 1971.</p>
        <div class="hhero__cta">
          <a href="/pages/request-a-quote" class="hbtn hbtn--solid">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7z M14 3v5h5 M10 13h6 M10 17h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            Build a quote
          </a>
          <a href="/collections" class="hbtn hbtn--line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h3l2.4 11h10.2L21 7H7.2 M10 20a1 1 0 1 0 0-.01 M18 20a1 1 0 1 0 0-.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>
            Shop products
          </a>
        </div>
      </div>

      <nav class="svt" aria-label="What we do" data-svt>
        <a href="/collections" class="svt__tile">
          <span class="svt__img"><img src="/cats/cones.svg" alt="" /></span>
          <span class="svt__txt"><b>Products</b><small>Cones, drums, barricades, signs</small></span>
        </a>
        <a href="/collections/equipment-rentals" class="svt__tile">
          <span class="svt__img"><img src="/cats/hero-rentals.png" alt="" /></span>
          <span class="svt__txt"><b>Rentals</b><small>Message boards, arrow boards, trucks</small></span>
        </a>
        <a href="/pages/lane-closure" class="svt__tile">
          <span class="svt__img">
            <svg viewBox="0 0 80 110" aria-hidden="true"><rect x="37" y="58" width="6" height="50" rx="2" fill="#5b6670"/><path d="M23 6h34l17 17v34L57 74H23L6 57V23z" fill="#c8102e" stroke="#fff" stroke-width="3"/><text x="40" y="47" text-anchor="middle" font-family="Archivo, Arial, sans-serif" font-size="19" font-weight="800" fill="#fff">STOP</text></svg>
          </span>
          <span class="svt__txt"><b>Lane closures</b><small>Certified flaggers, 24/7 crews</small></span>
        </a>
        <a href="/watercade/" class="svt__tile">
          <span class="svt__img"><img src="/cats/water-filled-barriers.png" alt="" /></span>
          <span class="svt__txt"><b>WATERCADE</b><small>Crash-tested water barriers</small></span>
        </a>
      </nav>
    </div>
  </section>


  <!-- ============ SERVICES ============ -->
  <section class="wrap svc">
    <div class="shead reveal">
      <div><p class="kicker">What we do</p><h2>One call covers the whole job</h2></div>
      <p class="shead__lede">Buy it, rent it, or have our certified, experienced crews set it up for you. Same yard, same invoice.</p>
    </div>
    <div class="svc__grid">
      {[
        { href: '/collections', photo: 'thumbnail_IMG_0141_f25c7165-4733-4438-9391-0687acaa7c46.jpg', k: 'Buy', h: 'Products', p: 'Cones, drums, barricades, signs and safety gear. Custom colors, logos and net terms.', cta: 'Shop products' },
        { href: '/collections/equipment-rentals', photo: 'TMA_192_Rear.jpg', k: 'Rent', h: 'Equipment', p: 'Crash trucks, arrow boards, message boards and light towers. Daily, weekly or monthly.', cta: 'See rentals' },
        { href: '/pages/lane-closure', photo: 'thumbnail_IMG_0308.jpg', k: 'Book', h: 'Lane closures', p: 'MUTCD-compliant closures with certified, experienced flaggers and 24/7 response.', cta: 'Book a crew' }
      ].map((t, i) => (
        <a class="svc__card reveal" href={t.href} style={`--d:${i * 80}ms`}>
          <img class="svc__photo" src={img(CDN + t.photo, 900)} alt="" loading="lazy" />
          <span class="svc__shade" aria-hidden="true"></span>
          <span class="svc__num" aria-hidden="true">{t.k}</span>
          <span class="svc__body">
            <span class="svc__h">{t.h}</span>
            <span class="svc__p">{t.p}</span>
            <span class="svc__go">{t.cta}
              <svg viewBox="0 0 24 24"><path d="M5 12h13 M12.5 5.5L19 12l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </span>
        </a>
      ))}
    </div>
    <div class="trust reveal">
      <span class="trust__k">Experience with</span>
      <ul class="trust__list">{agencies.map((a) => <li>{a}</li>)}</ul>
    </div>
  </section>

  <!-- ============ CATEGORY RAILS (shared with Products) ============ -->
  <CategoryRails />

  <!-- ============ PLANNING TOOLS ============ -->
  <section class="tools">
    <div class="wrap">
      <div class="shead reveal">
        <div><p class="kicker">Free planning tools</p><h2>Plan the job before you call</h2></div>
        <p class="shead__lede">Built from how our crews set up real work zones. Every tool ends in an equipment list you can send straight to us.</p>
      </div>
      <div class="tools__grid">
        <a href="/tools/work-zone-builder" class="tool reveal">
          <span class="tool__art tool__art--road" aria-hidden="true">
            <svg viewBox="0 0 320 170" preserveAspectRatio="xMidYMid slice">
              <rect width="320" height="170" fill="#22262b"/>
              <line x1="0" y1="26" x2="320" y2="26" stroke="#f5b800" stroke-width="3"/>
              <line x1="0" y1="144" x2="320" y2="144" stroke="#eef0f2" stroke-width="3"/>
              <line class="tool__lane" x1="-40" y1="85" x2="360" y2="85" stroke="#eef0f2" stroke-width="3" stroke-dasharray="22 26" opacity=".7"/>
              {[0, 1, 2, 3, 4, 5, 6].map((i) => <g class="tool__cone" style={`--i:${i}`}><path d={`M${96 + i * 18} ${136 - i * 7.6} l5 -14 l5 14 z`} fill="#f26a1b"/><rect x={`${94 + i * 18}`} y={`${135 - i * 7.6}`} width="14" height="3" rx="1" fill="#1a1d21"/></g>)}
              {[0, 1, 2, 3, 4].map((i) => <g class="tool__cone" style={`--i:${i + 7}`}><path d={`M${222 + i * 20} 90 l5 -14 l5 14 z`} fill="#f26a1b"/><rect x={`${220 + i * 20}`} y="89" width="14" height="3" rx="1" fill="#1a1d21"/></g>)}
              <g class="tool__sign"><rect x="34" y="96" width="34" height="34" rx="3" transform="rotate(45 51 113)" fill="#f26a1b"/><text x="51" y="117" text-anchor="middle" font-size="9" font-weight="800" fill="#1a1d21" font-family="Archivo, sans-serif">WORK</text></g>
            </svg>
          </span>
          <span class="tool__body">
            <span class="tool__h">Work zone builder</span>
            <span class="tool__p">Pick the road, speed and lanes. See the taper, buffer and signs laid out to MUTCD spacing.</span>
            <span class="tool__go">Open the builder →</span>
          </span>
        </a>
        <a href="/tools/watercade-planner" class="tool reveal" style="--d:80ms">
          <span class="tool__art tool__art--wc" aria-hidden="true">
            <svg viewBox="0 0 320 170" preserveAspectRatio="xMidYMid meet">
              <rect width="320" height="170" fill="#eaf1fb"/>
              <path d="M30 140 Q160 20 290 140" fill="none" stroke="#c7d7ee" stroke-width="2" stroke-dasharray="6 8"/>
              {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => {
                const t = i / 8, x = 30 + 260 * t, y = 140 - 4 * 120 * t * (1 - t) * 0.83;
                const ang = Math.atan2(-(1 - 2 * t) * 4 * 120 * 0.83, 260) * 180 / Math.PI;
                return <rect class="tool__blk" style={`--i:${i}`} x={x - 13} y={y - 8} width="26" height="16" rx="3" fill={i % 2 ? '#ffffff' : '#f26a1b'} stroke="#d4561a" stroke-width="1.2" transform={`rotate(${ang.toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)})`} />;
              })}
              <rect x="112" y="118" width="96" height="30" rx="15" fill="#0b2a5b"/>
              <text x="160" y="138" text-anchor="middle" font-size="13" font-weight="800" fill="#fff" font-family="Archivo, sans-serif">× 60 · 39,000 lb</text>
            </svg>
          </span>
          <span class="tool__body">
            <span class="tool__h">WATERCADE planner</span>
            <span class="tool__p">Lay out a barrier run or event perimeter. Get the count, weight and water needed.</span>
            <span class="tool__go">Plan a layout →</span>
          </span>
        </a>
        <a href="/tools/3d-showroom" class="tool reveal" style="--d:160ms">
          <span class="tool__art tool__art--3d" aria-hidden="true">
            <span class="tool__orbit"></span>
            <img class="tool__spin" src="/cats/cones.svg" alt="" loading="lazy" />
            <span class="tool__sw"><i style="--c:#f26a1b"></i><i style="--c:#9be22d"></i><i style="--c:#2d6be2"></i><i style="--c:#f5b800"></i></span>
          </span>
          <span class="tool__body">
            <span class="tool__h">3D showroom</span>
            <span class="tool__p">Spin our cones, drums, barricades and barriers. Try your colors and your logo.</span>
            <span class="tool__go">Open the showroom →</span>
          </span>
        </a>
        <a href="/tools/rent-vs-buy" class="tool reveal" style="--d:240ms">
          <span class="tool__art tool__art--rvb" aria-hidden="true">
            <svg viewBox="0 0 320 170" preserveAspectRatio="xMidYMid meet">
              <rect width="320" height="170" fill="#fff6e0"/>
              {[0, 1, 2, 3].map((i) => <line x1="34" x2="300" y1={40 + i * 30} y2={40 + i * 30} stroke="#f1e2bd" stroke-width="1"/>)}
              <path class="tool__line tool__line--rent" d="M34 140 L300 30" fill="none" stroke="#b60606" stroke-width="4" stroke-linecap="round"/>
              <path class="tool__line tool__line--buy" d="M34 92 L300 72" fill="none" stroke="#1a1d21" stroke-width="4" stroke-linecap="round"/>
              <circle class="tool__be" cx="156" cy="83" r="8" fill="#f5b800" stroke="#fff" stroke-width="3"/>
              <rect class="tool__be" x="120" y="44" width="74" height="24" rx="12" fill="#1a1d21"/>
              <text class="tool__be" x="157" y="60" text-anchor="middle" font-size="11" font-weight="800" fill="#fff" font-family="Archivo, sans-serif">Break-even</text>
              <text x="296" y="24" text-anchor="end" font-size="11" font-weight="700" fill="#b60606" font-family="Archivo, sans-serif">Rent</text>
              <text x="296" y="64" text-anchor="end" font-size="11" font-weight="700" fill="#1a1d21" font-family="Archivo, sans-serif">Buy</text>
            </svg>
          </span>
          <span class="tool__body">
            <span class="tool__h">Rent or buy calculator</span>
            <span class="tool__p">See exactly when buying starts beating renting for your crew's real usage.</span>
            <span class="tool__go">Run the numbers →</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ WATERCADE ============ -->
  <section class="wrap wcsec">
    <WatercadeBand />
  </section>

  <!-- ============ FAVORITES ============ -->
  <section class="wrap favs">
    <div class="shead shead--row reveal">
      <div><p class="kicker">Ready to ship</p><h2>Contractor favorites</h2></div>
      <a class="textlink" href="/collections/safety-products">Shop all products</a>
    </div>
    <div class="grid favs__grid">
      {favorites.map((p, i) => <div class="reveal" style={`--d:${i * 60}ms`}><ProductCard p={p} /></div>)}
    </div>
  </section>

  <!-- ============ FLEET ============ -->
  <section class="wrap fleetsec">
    <div class="shead shead--row reveal">
      <div><p class="kicker">Rental fleet</p><h2>Trucks and equipment, ready to roll</h2></div>
      <a class="textlink" href="/collections/equipment-rentals">All rentals</a>
    </div>
    <div class="fleet">
      {fleet.map((p, i) => (
        <a href={`/products/${p.handle}`} class="fleet__card reveal" style={`--d:${i * 50}ms;--tint:${fleetTints[i % fleetTints.length]}`}>
          <span class="fleet__img">{p.featuredImage && <img src={img(p.featuredImage.url, 500)} alt="" loading="lazy" />}</span>
          <span class="fleet__t">{p.title}</span>
          <span class="fleet__r">Daily · weekly · monthly
            <svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ WHY TSS ============ -->
  <section class="why">
    <div class="wrap why__in">
      <div class="why__head reveal">
        <p class="why__k">Why crews choose TSS</p>
        <h2>The yard, the fleet and the crew. One call.</h2>
      </div>
      <ul class="hstats">
        <li><b><span data-countup>{YEARS}</span></b><span class="hstats__l">years in business</span></li>
        <li><b><span data-countup>10,578</span></b><span class="hstats__l">lane closures completed</span></li>
        <li><b><span data-countup>35,017</span></b><span class="hstats__l">customers served</span></li>
        <li><b><span data-countup>3.1</span>M</b><span class="hstats__l">cones sold</span></li>
      </ul>
      <ul class="why__grid">
        {[
          { h: 'Certified crews', p: 'Experienced, ATSSA-certified flaggers and OSHA-trained crews on every job.', ico: 'M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z M8.5 12l2.4 2.4L15.5 9.8' },
          { h: '24/7 response', p: 'Emergency closures for utilities, water main breaks and incidents.', ico: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 7v5l3 2' },
          { h: 'Net terms', p: 'Purchase orders and accounts for municipalities, agencies and contractors.', ico: 'M4 5h16v14H4z M4 10h16 M8 15h5' },
          { h: 'One invoice', p: 'Products, rentals and crews from the same yard, billed together.', ico: 'M7 3h7l5 5v13H7z M14 3v5h5 M10 13h6 M10 17h6' }
        ].map((w, i) => (
          <li class="reveal" style={`--d:${i * 70}ms`}>
            <span class="why__ico"><svg viewBox="0 0 24 24"><path d={w.ico}/></svg></span>
            <b>{w.h}</b>
            <span>{w.p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="wrap final">
    <div class="final__card reveal">
      <div class="final__main">
        <h2>Tell us about the job</h2>
        <p>Products, rentals or a full crew. A real person replies, usually the same business day.</p>
        <div class="final__cta">
          <a href="/pages/request-a-quote" class="hbtn hbtn--red">Build a quote</a>
          <a href="tel:+19085614800" class="hbtn hbtn--outline">Call 908-561-4800</a>
        </div>
      </div>
      <div class="final__ask">
        <p class="final__askk">
          <svg viewBox="0 0 100 116" aria-hidden="true"><rect x="9" y="97" width="82" height="13" rx="4" fill="#1a1d21"/><path d="M44 9 Q50 3 56 9 L84 98 L16 98 Z" fill="#f26a1b"/><path d="M39.7 21 L60.3 21 L63 30 L37 30 Z" fill="#f4f6f8"/><path d="M22.7 80 L77.3 80 L80.3 90 L19.7 90 Z" fill="#f4f6f8"/><circle cx="40" cy="51" r="7" fill="#fff"/><circle cx="41" cy="52" r="3.8" fill="#1f2933"/><circle cx="60" cy="51" r="7" fill="#fff"/><circle cx="61" cy="52" r="3.8" fill="#1f2933"/><path d="M40.5 62 Q50 75 59.5 62 Z" fill="#5b1d06"/></svg>
          Or just ask Conner
        </p>
        {prompts.map((q) => (
          <button type="button" class="final__q" data-ask={q}>
            <span>“{q}”</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13 M12.5 5.5L19 12l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        ))}
      </div>
    </div>
  </section>
  <QuickView />
</Layout>

<script>
  /* Conner prompt chips */
  document.querySelectorAll('[data-ask]').forEach((b) => b.addEventListener('click', () => window.TSSChat?.ask(b.getAttribute('data-ask'))));

  /* hero service tiles: highlight steps through what we do */
  const svt = document.querySelector('[data-svt]');
  if (svt && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const tiles = [...svt.querySelectorAll('.svt__tile')];
    let i = 0, paused = false;
    const show = () => { tiles.forEach((t, k) => t.classList.toggle('is-on', k === i)); };
    show();
    setInterval(() => { if (!paused) { i = (i + 1) % tiles.length; show(); } }, 2200);
    svt.addEventListener('pointerenter', () => { paused = true; tiles.forEach((t) => t.classList.remove('is-on')); });
    svt.addEventListener('pointerleave', () => { paused = false; show(); });
  }
</script>

<style>
  /* =================== HERO =================== */
  .hhero { position: relative; color: #fff; overflow: hidden; background: #8a0404; }
  .hhero__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 45%; }
  .hhero__scrim { position: absolute; inset: 0; background:
    linear-gradient(90deg, rgba(122, 3, 3, .93) 0%, rgba(150, 5, 5, .74) 36%, rgba(120, 4, 4, .28) 62%, rgba(40, 0, 0, .25) 100%),
    linear-gradient(0deg, rgba(40, 0, 0, .45) 0%, transparent 35%); }
  .hhero__in { position: relative; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: center; gap: clamp(24px, 5vw, 90px); min-height: min(640px, calc(100vh - 200px)); padding-block: clamp(48px, 6vw, 88px); }
  .hhero__k { color: var(--gold); font-size: clamp(.95rem, 1.1vw, 1.12rem); letter-spacing: .14em; text-transform: uppercase; font-variation-settings: 'wght' 700; margin: 0 0 14px; }
  .hhero h1 { font-size: clamp(2.3rem, 4.4vw, 4.4rem); line-height: 1; letter-spacing: -.03em; font-variation-settings: 'wght' 790; margin: 0 0 18px; text-wrap: balance; }
  .hhero__lede { color: #fde0db; font-size: clamp(1.05rem, 1.45vw, 1.32rem); line-height: 1.5; max-width: 44ch; margin: 0 0 28px; text-wrap: balance; }
  .hhero__cta { display: flex; flex-wrap: wrap; gap: 14px; }

  .hbtn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 58px; padding: 16px 30px 15px; border-radius: 12px; font-size: 1.1rem; font-variation-settings: 'wght' 680; text-decoration: none; white-space: nowrap; transition: background .15s, color .15s, border-color .15s, translate .15s, box-shadow .15s; }
  .hbtn svg { width: 21px; height: 21px; flex: none; }
  .hbtn:hover { translate: 0 -2px; }
  .hbtn--solid { background: #fff; color: var(--red); box-shadow: 0 14px 30px -14px rgba(0, 0, 0, .5); }
  .hbtn--solid:hover { background: var(--haze); }
  .hbtn--line { border: 2px solid rgba(255, 255, 255, .7); color: #fff; }
  .hbtn--line:hover { background: rgba(255, 255, 255, .12); border-color: #fff; }
  .hbtn--red { background: var(--red); color: #fff; box-shadow: 0 14px 30px -16px rgba(182, 6, 6, .7); }
  .hbtn--red:hover { background: var(--red-press); }
  .hbtn--outline { border: 2px solid var(--line-dark); color: var(--ink); background: #fff; }
  .hbtn--outline:hover { border-color: var(--ink); }

  /* service tiles */
  .svt { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-self: center; justify-self: end; width: min(100%, 500px); }
  .svt__tile { display: grid; grid-template-rows: 96px auto; gap: 8px; padding: 14px 16px 16px; border-radius: 18px; text-decoration: none; color: #fff; background: rgba(255, 255, 255, .12); border: 1px solid rgba(255, 255, 255, .28); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: background .35s ease, color .35s ease, translate .35s ease, box-shadow .35s ease, border-color .35s ease; }
  .svt__img { display: grid; place-items: center; }
  .svt__img img, .svt__img svg { max-height: 88px; max-width: 88%; object-fit: contain; filter: drop-shadow(0 12px 12px rgba(0, 0, 0, .3)); transition: scale .35s ease; }
  .svt__txt { display: grid; gap: 2px; }
  .svt__txt b { font-size: 1.12rem; font-variation-settings: 'wght' 760; letter-spacing: -.01em; }
  .svt__txt small { font-size: .84rem; line-height: 1.35; color: #fde0db; transition: color .35s ease; }
  .svt__tile.is-on, .svt__tile:hover { background: #fff; color: var(--ink); border-color: #fff; translate: 0 -6px; box-shadow: 0 30px 60px -24px rgba(0, 0, 0, .55); }
  .svt__tile.is-on small, .svt__tile:hover small { color: var(--steel); }
  .svt__tile.is-on b, .svt__tile:hover b { color: var(--red); }
  .svt__tile.is-on .svt__img img, .svt__tile.is-on .svt__img svg, .svt__tile:hover .svt__img img, .svt__tile:hover .svt__img svg { scale: 1.08; }

  /* stats (now in the why band) */
