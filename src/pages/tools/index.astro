---
import Layout from '../../layouts/Layout.astro';

const tools = [
  {
    href: '/tools/lane-closure-plan',
    title: 'Free lane closure plan',
    text: 'Answer a few questions about the road, the work and the timing. Get the MUTCD typical application, sign spacing, taper, equipment and crew, plus what the Turnpike, Parkway, NJDOT, NYSDOT or PennDOT typically require.',
    best: 'Best when you are not sure what closure or crew the job needs.'
  },
  {
    href: '/tools/work-zone-builder',
    title: 'Work zone builder',
    text: 'Set the road type, speed and lanes to close. Watch the taper, buffer and advance signs lay themselves out to MUTCD spacing, then take the full equipment count.',
    best: 'Best before booking a lane closure or renting closure equipment.'
  },
  {
    href: '/tools/watercade-planner',
    title: 'WATERCADE planner',
    text: 'Draw a straight run, corner, U or full enclosure and get the barrier count, pins, filled weight, water volume and price for your exact dimensions.',
    best: 'Best for events, perimeters and work zone protection.'
  },
  {
    href: '/tools/3d-showroom',
    title: '3D showroom',
    text: 'Spin our cones, drums, barricades, WATERCADE barriers and arrow boards. Change colors and drop your own logo on them to preview custom branding.',
    best: 'Best for custom color and logo orders.'
  },
  {
    href: '/tools/rent-vs-buy',
    title: 'Rent or buy calculator',
    text: 'Build an equipment list, set your job length and how often you run similar jobs, and see the break-even point between renting and owning.',
    best: 'Best when you keep renting the same gear and wonder if you should own it.'
  }
];
---
<Layout
  title="Planning tools"
  description="Free interactive tools from Traffic Safety Service: lay out a work zone to MUTCD spacing, plan a WATERCADE barrier run, preview custom branding in 3D, and compare renting against buying.">
  <section class="chead">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Planning tools</span></nav>
      <h1>Plan the job before you call</h1>
      <p class="lede">Five free tools built from how our crews actually set up work zones. Every one of them ends in an equipment list you can send straight to TSS for a quote.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap tl-grid">
      {tools.map((t) => (
        <a class:list={["tl-card sign", { "tl-card--hero": t.href.endsWith("lane-closure-plan") }]} href={t.href}>
          {t.href.endsWith('lane-closure-plan') && <span class="tl-card__new">New · Free</span>}
          <h2>{t.title}</h2>
          <p>{t.text}</p>
          <p class="tl-card__best">{t.best}</p>
          <span class="tl-card__go">{t.href.endsWith('lane-closure-plan') ? 'Start my free plan' : 'Open the tool'}</span>
        </a>
      ))}
    </div>
    <div class="wrap">
      <aside class="tl-note">
        <div>
          <h2>Rather just tell someone the job?</h2>
          <p>Skip the tools. Describe the work in the quote form, or ask Conner, and our team takes it from there.</p>
        </div>
        <div class="tl-note__btns">
          <a class="btn" href="/pages/request-a-quote">Request a quote</a>
          <button class="btn btn--ghost" type="button" data-coney>Ask Conner</button>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  document.querySelector('[data-coney]')?.addEventListener('click', () => {
    window.TSSChat?.ask('Can you help me figure out what equipment I need for my job?');
  });
</script>

<style>
  .chead { background: var(--haze); border-bottom: 1px solid var(--line); padding: 36px 0 44px; }
  .crumbs { display: flex; gap: 8px; font-size: .92rem; color: var(--steel); margin-bottom: 14px; }
  .crumbs a { color: inherit; }
  .chead .lede { margin: 12px 0 0; max-width: 60ch; }
  .tl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 28px; }
  .tl-card { display: flex; flex-direction: column; gap: 10px; padding: 30px 30px 26px; text-decoration: none; transition: border-color .15s ease, box-shadow .15s ease; }
  .tl-card:hover { border-color: var(--line-dark); box-shadow: var(--shadow-m); }
  .tl-card h2 { font-size: var(--fs-3); }
  .tl-card:hover h2 { color: var(--red); }
  .tl-card p { margin: 0; color: var(--ink-2); line-height: 1.55; }
  .tl-card__best { color: var(--steel); font-size: .95rem; }
  .tl-card__go { margin-top: auto; padding-top: 14px; font-variation-settings: 'wght' 650; color: var(--red); }
  .tl-note { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding: 36px clamp(24px, 3.5vw, 44px); background: var(--haze); border: 1px solid var(--line); border-radius: var(--r-l); }
  .tl-note h2 { font-size: var(--fs-4); margin-bottom: 6px; }
  .tl-note p { margin: 0; color: var(--steel); max-width: 54ch; }
  .tl-note__btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .tl-card--hero { grid-column: 1 / -1; color: #fff; border-color: transparent; background: radial-gradient(120% 170% at 88% -30%, #e13a1a, #b60606 42%, #8a0404); }
  .tl-card--hero h2, .tl-card--hero:hover h2 { color: #fff; }
  .tl-card--hero p { color: rgba(255,255,255,.9); max-width: 80ch; }
  .tl-card--hero .tl-card__best { color: rgba(255,255,255,.78); }
  .tl-card--hero .tl-card__go { align-self: flex-start; margin-top: 8px; padding: 12px 20px; border-radius: 12px; background: #fff; color: var(--red); }
  .tl-card__new { align-self: flex-start; padding: 5px 11px 4px; border-radius: 999px; background: var(--gold); color: var(--ink); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; font-variation-settings: 'wght' 760; }
  @media (max-width: 760px) { .tl-grid { grid-template-columns: 1fr; } }
</style>
