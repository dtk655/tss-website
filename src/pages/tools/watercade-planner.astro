---
import Layout from '../../layouts/Layout.astro';
import WatercadePlanner from '../../components/tools/watercade/WatercadePlanner.astro';
import { loadCatalog, img } from '../../lib/shopify.js';

const cat = await loadCatalog();
const product = cat.byHandle.get('waterbarriertss590rparent');
const pinProduct = cat.byHandle.get('waterbarrierpin');
const variants = (product?.variants || []).map((v) => ({ id: v.id, title: v.title, price: v.price }));
const pin = pinProduct?.variants?.[0] ? { id: pinProduct.variants[0].id, title: pinProduct.title, price: pinProduct.variants[0].price } : null;
const image = product?.featuredImage?.url ? img(product.featuredImage.url, 200) : '';
---
<Layout title="WATERCADE planner" description="Plan a WATERCADE water-filled barrier layout. See how many barriers you need, the filled weight, water and fill time, then buy online or request a rental.">
  <section class="chead">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/tools">Planning tools</a><span aria-hidden="true">/</span><span>WATERCADE planner</span></nav>
      <h1>WATERCADE planner</h1>
      <p class="lede">Pick a layout and enter your dimensions. You'll see exactly how the barriers link up, how many you need, and how much water it takes to fill them.</p>
      <dl class="wcp-facts">
        <div><dt>Empty</dt><dd>50 lbs</dd><p>One person can carry and place it.</p></div>
        <div><dt>Filled</dt><dd>650 lbs</dd><p>About 72 gallons of water anchors each barrier.</p></div>
        <div><dt>Length</dt><dd>5 ft</dd><p>Interlocking ends, with a 90° pin for corners.</p></div>
        <div><dt>More</dt><dd class="wcp-facts__link"><a class="textlink" href="/products/waterbarriertss590rparent">Product page</a></dd><p>Specs, colors and custom branding.</p></div>
      </dl>
    </div>
  </section>

  <section class="section--tight section">
    <div class="wrap">
      {product
        ? <WatercadePlanner variants={variants} image={image} pin={pin} heading="" />
        : <p>The WATERCADE planner is unavailable right now. Call <a href="tel:+19085614800">908-561-4800</a> for help sizing your layout.</p>}
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap wcp-uses">
      <h2>Where crews use WATERCADE</h2>
      <ul>
        <li><strong>Events and festivals.</strong> Crowd lines, vendor rows and VIP areas that stay put once filled.</li>
        <li><strong>Stadiums and venues.</strong> Fast perimeters on game day that drain and stack after.</li>
        <li><strong>Police and municipal.</strong> Checkpoints, parade routes and road closures.</li>
        <li><strong>Work zones.</strong> Separating crews and equipment from traffic on heavy highway jobs.</li>
      </ul>
      <p>We sell WATERCADE nationwide and rent it with delivery and setup in New Jersey, New York, Pennsylvania and Connecticut.</p>
    </div>
  </section>
</Layout>

<style>
  .chead { background: var(--haze); border-bottom: 1px solid var(--line); padding: 36px 0 44px; }
  .crumbs { display: flex; gap: 8px; font-size: .92rem; color: var(--steel); margin-bottom: 14px; }
  .crumbs a { color: inherit; }
  .chead .lede { margin: 12px 0 0; max-width: 64ch; }
  .wcp-facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; margin: 30px 0 0; border-top: 1px solid var(--line-dark); padding-top: 20px; max-width: 880px; }
  .wcp-facts dt { font-size: .9rem; color: var(--steel); }
  .wcp-facts dd { margin: 2px 0 0; font-variation-settings: 'wght' 740; font-size: var(--fs-3); letter-spacing: -0.015em; }
  .wcp-facts__link { font-size: var(--fs-1); }
  .wcp-facts p { margin: 4px 0 0; font-size: .9rem; color: var(--steel); }
  .wcp-uses { display: grid; gap: 18px; }
  .wcp-uses ul { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; }
  .wcp-uses li { border-top: 1px solid var(--line-dark); padding-top: 14px; color: var(--steel); line-height: 1.55; }
  .wcp-uses li strong { color: var(--ink); display: block; margin-bottom: 2px; }
  @media (max-width: 760px) { .wcp-facts { grid-template-columns: 1fr 1fr; gap: 18px; } }
</style>
