---
import Layout from '../../layouts/Layout.astro';
import RentBuy from '../../components/tools/rentbuy/RentBuy.astro';
---
<Layout title="Rent or buy calculator" description="Compare the cost of renting versus buying cones, drums, barricades, signs and WATERCADE barriers for your jobs. See the break-even point, then get a quote or buy online.">
  <section class="chead">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/tools">Planning tools</a><span aria-hidden="true">/</span><span>Rent or buy calculator</span></nav>
      <h1>Rent or buy?</h1>
      <p class="lede">Put in the equipment you need and how often you use it. You'll see what each option costs over a job and over a year, and the point where owning starts to pay off.</p>
    </div>
  </section>
  <section class="rbp__body">
    <div class="wrap">
      <RentBuy />
    </div>
  </section>
</Layout>
<style>
  .chead { background: var(--haze); border-bottom: 1px solid var(--line); padding: 36px 0 44px; }
  .crumbs { display: flex; gap: 8px; font-size: .92rem; color: var(--steel); margin-bottom: 14px; }
  .crumbs a { color: inherit; }
  .chead .lede { margin: 12px 0 0; max-width: 64ch; }
  .rbp__body { padding: clamp(28px, 4vw, 44px) 0 clamp(56px, 8vw, 96px); }
</style>
