---
import Layout from '../../layouts/Layout.astro';
import RentBuy from '../../components/tools/rentbuy/RentBuy.astro';
---
<Layout title="Rent or buy calculator" description="Compare the cost of renting versus buying cones, drums, barricades, signs and WATERCADE barriers for your jobs. See the break-even point, then get a quote or buy online.">
  <section class="rbp__head">
    <div class="wrap">
      <p class="rbp__crumb"><a href="/tools">Planning tools</a></p>
      <h1>Rent or buy?</h1>
      <p class="lede">Put in the equipment you need and how often you use it. You'll see what each option costs over a job and over a year, and the point where owning starts to pay off.</p>
    </div>
  </section>
  <section class="rbp__body">
    <div class="wrap">
      <RentBuy />
    </div>
  </section>
</Layout>
<style>
  .rbp__head { background: var(--asphalt); color: var(--white-line); padding: clamp(40px, 6vw, 72px) 0 clamp(36px, 5vw, 56px); border-bottom: 6px solid transparent; border-image: repeating-linear-gradient(90deg, var(--white-line) 0 48px, transparent 48px 96px) 6; }
  .rbp__head h1 { font-size: var(--fs-5); margin-bottom: 14px; }
  .rbp__head .lede { color: #c5c9cf; margin: 0; }
  .rbp__crumb { margin: 0 0 10px; font-weight: 700; }
  .rbp__crumb a { color: #c5c9cf; }
  .rbp__body { padding: 32px 0 clamp(56px, 8vw, 96px); }
</style>
