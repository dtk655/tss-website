---
import '@fontsource-variable/archivo';
import '@fontsource/archivo-black';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Drawer from '../components/Drawer.astro';
import { STOREFRONT_TOKEN, ENDPOINT } from '../lib/shopify.js';

interface Props { title: string; description?: string; image?: string; dark?: boolean }
const { title, description = 'Traffic control products, equipment rentals and lane closure crews from Traffic Safety Service. Serving NJ, NY, PA and CT since 1971. Products ship nationwide.', image, dark = false } = Astro.props;
const fullTitle = title.includes('Traffic Safety Service') ? title : `${title} | Traffic Safety Service`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), 'https://trafficsafetyservice.com');
// Link previews (texts, Slack, social): the TSS logo card everywhere; product pages keep their product photo.
const origin = (process.env.URL || 'https://trafficsafetyservice.com').replace(/\/$/, '');
const isProduct = Astro.url.pathname.startsWith('/products/');
const abs = (u) => (/^https?:/.test(u) ? u : origin + u);
const ogImage = isProduct && image ? abs(image) : origin + '/og-share.png';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Traffic Safety Service" />
  <meta property="og:url" content={origin + Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/')} />
  <meta property="og:image" content={ogImage} />
  {!(isProduct && image) && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Traffic Safety Service. Rentals - Sales - Service. Since 1971." /></>}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#2a2e33" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://cdn.shopify.com" />
  <script is:inline define:vars={{ STOREFRONT_TOKEN, ENDPOINT }}>window.TSS_SF = { token: STOREFRONT_TOKEN, endpoint: ENDPOINT };</script>
  <slot name="head" />
</head>
<body class={dark ? 'page-dark' : ''}>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <Drawer />
  <script src="../scripts/store.js"></script>
  <script is:inline src="/coney.js" defer></script>
  <script is:inline>
    (function () {
      var els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach(function (el) { el.classList.add('is-in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
  <script is:inline>
    (() => {
      // Keep each hero slogan line on a single line: shrink the h1 font just enough to fit.
      const SEL = '.eqh__ln, .lch__ln, .ch__ln, .cx__h > span';
      const fit = () => {
        const heads = new Set([...document.querySelectorAll(SEL)].map((l) => l.closest('h1')).filter(Boolean));
        heads.forEach((h) => {
          const lines = [...h.querySelectorAll(SEL)];
          h.style.fontSize = '';
          lines.forEach((ln) => { ln.style.fontSize = ''; });
          const need = (ln) => {
            const cs = getComputedStyle(ln);
            const room = ln.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
            const inner = ln.firstElementChild || ln;
            const w = inner.offsetWidth || inner.scrollWidth;
            return w > room && room > 0 ? room / w : 1;
          };
          if (h.querySelector('.ch__ln')) {
            // Catalog headers: title and tagline have their own sizes, so fit each line on its own.
            lines.forEach((ln) => {
              const r = need(ln);
              if (r < 1) ln.style.fontSize = Math.floor(parseFloat(getComputedStyle(ln).fontSize) * r * 0.98 * 10) / 10 + 'px';
            });
            return;
          }
          const base = parseFloat(getComputedStyle(h).fontSize);
          const ratio = Math.min(1, ...lines.map(need));
          if (ratio < 1) h.style.fontSize = Math.floor(base * ratio * 0.98 * 10) / 10 + 'px';
        });
      };
      let t;
      const run = () => { cancelAnimationFrame(t); t = requestAnimationFrame(fit); };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
      document.fonts?.ready.then(run);
      addEventListener('resize', run);
    })();
  </script>
  <script is:inline>
    (() => {
      // Expose the header's resting height so first-screen sections can size themselves to the space under it.
      const h = document.querySelector('header');
      if (!h) return;
      const set = () => { if (scrollY < 4) document.documentElement.style.setProperty('--hdr-full', Math.round(h.getBoundingClientRect().height) + 'px'); };
      set(); addEventListener('resize', set); document.fonts?.ready.then(set);
    })();
  </script>
</body>
</html>
<style is:global>
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; background: #fff; padding: 10px 14px; border-radius: 8px; }
  .skip:focus { left: 8px; }
</style>
